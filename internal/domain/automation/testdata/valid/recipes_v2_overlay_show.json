{
  "version": 1,
  "trigger": {
    "type": "command",
    "params": {
      "name": "!show"
    }
  },
  "conditions": [],
  "actions": [
    {
      "type": "overlay_show",
      "params": {
        "kind": "text",
        "content": "Thanks {user}!",
        "seconds": 5,
        "position": "top"
      }
    },
    {
      "type": "overlay_show",
      "params": {
        "kind": "image",
        "content": "https://cdn.example.com/{arg:name}.png",
        "seconds": 60,
        "position": "center"
      }
    },
    {
      "type": "overlay_show",
      "params": {
        "kind": "video",
        "content": "{local:clip}",
        "seconds": 1,
        "position": "bottom"
      }
    }
  ]
}
