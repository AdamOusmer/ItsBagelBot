{
  "version": 1,
  "trigger": {
    "type": "command",
    "params": {
      "name": "!hi"
    }
  },
  "conditions": [
    {
      "type": "perm",
      "params": {
        "level": "lead_mod"
      }
    }
  ],
  "actions": [
    {
      "type": "chat",
      "params": {
        "text": "line one\nline two"
      }
    },
    {
      "type": "announce",
      "params": {
        "text": "big news",
        "color": "purple"
      }
    },
    {
      "type": "reply",
      "params": {
        "text": "ok"
      }
    },
    {
      "type": "timeout",
      "params": {
        "login": "{user}",
        "seconds": 60,
        "reason": ""
      }
    },
    {
      "type": "ban",
      "params": {
        "login": "{user}",
        "reason": "bye"
      }
    },
    {
      "type": "warn",
      "params": {
        "login": "{user}",
        "reason": "calm down"
      }
    },
    {
      "type": "shield",
      "params": {
        "on": true
      }
    },
    {
      "type": "shoutout",
      "params": {
        "login": "{args}"
      }
    },
    {
      "type": "clip",
      "params": {}
    },
    {
      "type": "marker",
      "params": {
        "description": "highlight"
      }
    },
    {
      "type": "set_title",
      "params": {
        "title": "new title"
      }
    },
    {
      "type": "set_game",
      "params": {
        "game": "Just Chatting"
      }
    },
    {
      "type": "set_tags",
      "params": {
        "tags": "english,chill"
      }
    },
    {
      "type": "commercial",
      "params": {
        "seconds": 90
      }
    }
  ]
}
