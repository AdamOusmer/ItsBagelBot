{
  "role": {
    "label": "Niveau utilisateur",
    "summary": "Vérifier le rôle du viewer",
    "warning": "Les rôles sont connus seulement pour le chat et les comptes à rebours. Ici, tout le monde compte comme viewer.",
    "remove": "Retirer cette condition",
    "field": {
      "level": {
        "label": "Au moins",
        "option": {
          "everyone": "Tout le monde",
          "sub": "Abonné",
          "vip": "VIP",
          "mod": "Modérateur",
          "lead_mod": "Modérateur principal",
          "broadcaster": "Diffuseur"
        }
      }
    },
    "out": {
      "yes": "Autorisé",
      "no": "Bloqué"
    }
  },
  "user": {
    "label": "Utilisateur spécifique",
    "summary": "Seul ce viewer passe",
    "field": {
      "login": {
        "label": "Nom d’utilisateur",
        "placeholder": "itsbagelbot"
      }
    },
    "out": {
      "yes": "Cet utilisateur",
      "no": "Tout autre utilisateur"
    }
  },
  "cooldown": {
    "label": "Délai de recharge",
    "summary": "Lancer une fois toutes les quelques secondes",
    "field": {
      "seconds": {
        "label": "Délai de recharge",
        "range": "Utilisez de 1 seconde à {days} jours."
      },
      "perUser": {
        "label": "Par viewer"
      },
      "name": {
        "label": "Nom",
        "placeholder": "subathon",
        "hint": "Lui donner un nom le redémarre s’il est en cours. Les étapes d’ajout de temps de n’importe quelle recette peuvent ensuite le prolonger. Non disponible par viewer."
      },
      "leftCommand": {
        "label": "Commande de temps restant",
        "placeholder": "!tempsrestant"
      },
      "leftReply": {
        "label": "Réponse pendant l’attente",
        "placeholder": "{user}, encore {cooldown:left} avant de pouvoir réutiliser ceci."
      },
      "readyReply": {
        "label": "Réponse quand c’est prêt",
        "placeholder": "{user}, c’est prêt à être utilisé."
      }
    },
    "out": {
      "yes": "Prêt",
      "no": "En recharge"
    }
  },
  "compare": {
    "label": "Comparer une valeur",
    "summary": "Comparer deux nombres ou textes",
    "field": {
      "left": {
        "label": "Valeur",
        "placeholder": "{bits}"
      },
      "op": {
        "label": "Est",
        "option": {
          "gte": "au moins",
          "lt": "inférieur à",
          "eq": "égal à",
          "contains": "contient"
        }
      },
      "right": {
        "label": "Cette valeur",
        "placeholder": "1000"
      }
    },
    "out": {
      "yes": "Oui",
      "no": "Non"
    }
  },
  "chance": {
    "label": "Chance aléatoire",
    "summary": "Passe une partie du temps",
    "field": {
      "percent": {
        "label": "Chance",
        "unit": "%"
      }
    },
    "out": {
      "yes": "Succès",
      "no": "Échec"
    }
  },
  "var": {
    "label": "Vérifier une variable",
    "summary": "Passe quand une valeur conservée correspond",
    "field": {
      "scope": { "label": "Conservé pour", "option": { "channel": "La chaîne", "viewer": "Ce viewer" } },
      "name": { "label": "Nom", "placeholder": "morts" },
      "op": {
        "label": "Est",
        "option": {
          "eq": "égal à",
          "ne": "différent de",
          "gt": "supérieur à",
          "gte": "au moins",
          "lt": "inférieur à",
          "lte": "au plus",
          "contains": "contient",
          "exists": "défini (n’importe quelle valeur)"
        }
      },
      "value": { "label": "Valeur", "placeholder": "10" }
    },
    "out": { "yes": "Oui", "no": "Non" }
  },
  "points": {
    "label": "Points du spectateur",
    "summary": "Vérifier le solde de points du spectateur qui a déclenché la recette",
    "field": {
      "op": {
        "label": "Est"
      },
      "value": {
        "label": "Points",
        "unit": "points"
      }
    },
    "out": {
      "yes": "Oui",
      "no": "Non"
    },
    "line": {
      "eq": "Le spectateur a exactement {value} points",
      "ne": "Le solde du spectateur est différent de {value} points",
      "gt": "Le spectateur a plus de {value} points",
      "gte": "Le spectateur a au moins {value} points",
      "lt": "Le spectateur a moins de {value} points",
      "lte": "Le spectateur a au plus {value} points"
    }
  },
  "counter": {
    "label": "Valeur du compteur",
    "summary": "Vérifier la valeur actuelle d’un compteur nommé",
    "field": {
      "counter": {
        "label": "Compteur"
      },
      "op": {
        "label": "Est"
      },
      "value": {
        "label": "Valeur"
      }
    },
    "out": {
      "yes": "Oui",
      "no": "Non"
    }
  }
}
