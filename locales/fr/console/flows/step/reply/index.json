      "remove": "Retirer les droits de modération : {who}"
    },
    "field": {
      "change": {
        "label": "Changement",
        "option": { "add": "Ajouter", "remove": "Retirer" }
      }
    }
  },
  "vip": {
    "label": "Rôle VIP",
    "summary": "Ajouter ou retirer un VIP",
