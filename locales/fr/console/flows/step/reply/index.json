{
  "chat": {
    "label": "Envoyer un message dans le chat",
    "summary": "Le bot répond dans le chat",
    "field": {
      "message": {
        "label": "Message",
        "placeholder": "Merci {user} !"
      }
    }
  },
  "points": {
    "label": "Donner des points de fidélité",
    "summary": "Ajouter ou retirer des points",
    "field": {
      "amount": {
        "label": "Montant",
        "unit": "points"
      }
    }
  },
  "counter": {
    "label": "Incrémenter le compteur",
    "summary": "Augmenter un compteur",
    "field": {
      "counter": {
        "label": "Compteur"
      }
    }
  },
  "lights": {
    "label": "Régler les lumières",
    "summary": "Définir une couleur ou une scène Govee",
    "field": {
      "device": {
        "label": "Lumière"
      },
      "mode": {
        "label": "Définir",
        "option": {
          "color": "Couleur",
          "scene": "Scène"
        }
      },
      "color": {
        "label": "Couleur"
      },
      "scene": {
        "label": "Scène"
      },
      "liveOnly": {
        "label": "Seulement en direct"
      }
    }
  },
  "wait": {
    "label": "Attendre",
    "summary": "Pause avant l’étape suivante",
    "field": {
      "seconds": {
        "label": "Délai",
        "unit": "secondes, max {max}"
      }
    }
  },
  "loop": {
    "label": "Répéter des étapes",
    "summary": "Exécuter un chemin jusqu’à 100 fois",
    "field": {
      "times": {
        "label": "Nombre de fois",
        "placeholder": "3"
      }
    },
    "out": {
      "body": "À chaque fois",
      "done": "Une fois terminé"
    }
  },
  "varSet": {
    "label": "Définir une variable",
    "summary": "Conserver une valeur pour plus tard",
    "field": {
      "scope": {
        "label": "Conservé pour",
        "option": {
          "channel": "La chaîne",
          "viewer": "Ce viewer"
        }
      },
      "name": {
        "label": "Nom",
        "placeholder": "morts"
      },
      "value": {
        "label": "Valeur",
        "placeholder": "{user}"
      }
    }
  },
  "varAdd": {
    "label": "Ajouter à une variable",
    "summary": "Augmenter ou diminuer",
    "field": {
      "scope": {
        "label": "Conservé pour",
        "option": {
          "channel": "La chaîne",
          "viewer": "Ce viewer"
        }
      },
      "name": {
        "label": "Nom",
        "placeholder": "morts"
      },
      "amount": {
        "label": "Montant"
      }
    }
  },
  "varDelete": {
    "label": "Supprimer une variable",
    "summary": "Oublier une valeur",
    "field": {
      "scope": {
        "label": "Conservé pour",
        "option": {
          "channel": "La chaîne",
          "viewer": "Ce viewer"
        }
      },
      "name": {
        "label": "Nom",
        "placeholder": "morts"
      }
    }
  },
  "math": {
    "label": "Faire un calcul",
    "summary": "Calculer un nombre",
    "field": {
      "expression": {
        "label": "Expression",
        "placeholder": "({bits} / 100) + 1"
      },
      "saveAs": {
        "label": "Enregistrer sous",
        "placeholder": "total"
      }
    }
  },
  "cooldownAdd": {
    "label": "Ajouter du temps à un délai de récupération",
    "summary": "Prolonger un minuteur nommé pendant qu’il est en cours",
    "line": "Ajouter {seconds} à {name}",
    "field": {
      "name": {
        "label": "Minuteur"
      },
      "seconds": {
        "label": "Ajouter",
        "range": "Utilisez de 1 seconde à {days} jours."
      },
      "per": {
        "label": "Par",
        "hint": "Ajoute le temps ci-dessus pour chaque montant complet. Mettez 100 dans une recette de bits pour compter tous les 100 bits. Laissez vide pour l’ajouter une fois par événement."
      }
    }
  },
  "countdownAdd": {
    "label": "Ajouter du temps au compte à rebours",
    "summary": "Prolonger un compte à rebours en cours",
    "line": "Ajouter {seconds} à {name}",
    "field": {
      "name": {
        "label": "Compte à rebours"
      },
      "seconds": {
        "label": "Ajouter",
        "range": "Utilisez de 1 seconde à {days} jours."
      },
      "per": {
        "label": "Par tranche de",
        "hint": "Ajoute cette durée pour chaque tranche complète. Laissez vide pour l’ajouter une fois par événement."
      }
    }
  },
  "poll": {
    "label": "Lancer un sondage",
    "summary": "Laisser les spectateurs voter sur une question",
    "line": "Sondage : {title}",
    "field": {
      "title": {
        "label": "Titre"
      },
      "choices": {
        "label": "Choix (un par ligne)"
      },
      "seconds": {
        "label": "Durée (secondes)"
      }
    }
  },
  "pollEnd": {
    "label": "Terminer un sondage",
    "summary": "Arrêter le vote ou archiver les résultats",
    "line": {
      "terminate": "Clore le sondage et afficher les résultats",
      "archive": "Archiver le sondage"
    },
    "field": {
      "status": {
        "label": "Action",
        "option": {
          "terminate": "Arrêter les votes",
          "archive": "Archiver"
        }
      }
    }
  },
  "prediction": {
    "label": "Lancer une prédiction",
    "summary": "Laisser les spectateurs miser des points sur un résultat",
    "line": "Prédiction : {title}",
    "field": {
      "title": {
        "label": "Titre"
      },
      "outcomes": {
        "label": "Résultats (un par ligne)"
      },
      "seconds": {
        "label": "Durée (secondes)"
      }
    }
  },
  "predictionEnd": {
    "label": "Terminer une prédiction",
    "summary": "Fermer les paris, rembourser ou choisir un gagnant",
    "line": {
      "lock": "Clore les paris",
      "cancel": "Annuler et rendre les points",
      "resolve": "Résultat gagnant : {winner}"
    },
    "field": {
      "status": {
        "label": "Action",
        "option": {
          "lock": "Verrouiller les votes",
          "cancel": "Annuler et rembourser",
          "resolve": "Choisir un gagnant"
        }
      },
      "winner": {
        "label": "Numéro du résultat gagnant"
      }
    }
  },
