      "readyReply": {
        "label": "Réponse du temps restant à la fin",
        "placeholder": "Le compte à rebours est terminé !"
      }
    }
  },
    "countdownAdd": {
    "label": "Ajouter du temps au compte à rebours",
    "summary": "Prolonger un compte à rebours en cours",
    "field": {
      "name": {
        "label": "Compte à rebours"
      },
      "seconds": {
        "label": "Ajouter",
        "range": "Utilisez de 1 seconde à {days} jours."
      },
      "per": {
        "label": "Par tranche de",
        "hint": "Ajoute cette durée pour chaque tranche complète. Laissez vide pour l’ajouter une fois par événement."
      }
    }
  },
