{
  "role": {
    "label": "Nivel de usuario",
    "summary": "Solo pasan ciertos espectadores",
    "field": {
      "level": {
        "label": "Al menos",
        "option": {
          "everyone": "Todos",
          "sub": "Suscriptor",
          "vip": "VIP",
          "mod": "Moderador",
          "lead_mod": "Moderador principal",
          "broadcaster": "Streamer"
        }
      }
    },
    "out": {
      "yes": "Permitido",
      "no": "Bloqueado"
    }
  },
  "user": {
    "label": "Usuario específico",
    "summary": "Solo pasa este espectador",
    "field": {
      "login": {
        "label": "Nombre de usuario",
        "placeholder": "itsbagelbot"
      }
    },
    "out": {
      "yes": "Este usuario",
      "no": "Cualquier otro"
    }
  },
  "cooldown": {
    "label": "Tiempo de espera",
    "summary": "Espera entre ejecuciones",
    "field": {
      "seconds": {
        "label": "Tiempo de espera",
        "range": "Usa de 1 segundo a {days} días."
      },
      "perUser": {
        "label": "Por espectador"
      }
    },
    "out": {
      "yes": "Listo",
      "no": "En espera"
    }
  },
  "compare": {
    "label": "Comparar valor",
    "summary": "Comprueba una variable",
    "field": {
      "left": {
        "label": "Valor",
        "placeholder": "{bits}"
      },
      "op": {
        "label": "Es",
        "option": {
          "gte": "al menos",
          "lt": "menor que",
          "eq": "igual a",
          "contains": "contiene"
        }
      },
      "right": {
        "label": "Este valor",
        "placeholder": "1000"
      }
    },
    "out": {
      "yes": "Sí",
      "no": "No"
    }
  },
  "chance": {
    "label": "Probabilidad aleatoria",
    "summary": "Pasa algunas veces",
    "field": {
      "percent": {
        "label": "Probabilidad",
        "unit": "%"
      }
    },
    "out": {
      "yes": "Acierto",
      "no": "Fallo"
    }
  },
  "var": {
    "label": "Comprobar una variable",
    "summary": "Pasa si coincide un valor guardado",
    "field": {
      "scope": { "label": "Guardado para", "option": { "channel": "El canal", "viewer": "Este espectador" } },
      "name": { "label": "Nombre", "placeholder": "muertes" },
      "op": {
        "label": "Es",
        "option": {
          "eq": "igual a",
          "ne": "no es igual a",
          "gt": "mayor que",
          "gte": "al menos",
          "lt": "menor que",
          "lte": "como máximo",
          "contains": "contiene",
          "exists": "tiene cualquier valor"
        }
      },
      "value": { "label": "Valor", "placeholder": "10" }
    },
    "out": { "yes": "Sí", "no": "No" }
  }
}
