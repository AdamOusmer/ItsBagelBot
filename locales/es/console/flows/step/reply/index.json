{
  "chat": {
    "label": "Enviar mensaje de chat",
    "summary": "El bot responde en el chat",
    "field": {
      "message": {
        "label": "Mensaje",
        "placeholder": "¡Gracias, {user}!"
      }
    }
  },
  "points": {
    "label": "Dar puntos de fidelidad",
    "summary": "Añadir o quitar puntos",
    "field": {
      "amount": {
        "label": "Cantidad",
        "unit": "puntos"
      }
    }
  },
  "counter": {
    "label": "Aumentar contador",
    "summary": "Aumentar un contador",
    "field": {
      "counter": {
        "label": "Contador"
      }
    }
  },
  "lights": {
    "label": "Ajustar luces",
    "summary": "Ajustar un color o escena de Govee",
    "field": {
      "device": {
        "label": "Luz"
      },
      "mode": {
        "label": "Ajustar",
        "option": {
          "color": "Color",
          "scene": "Escena"
        }
      },
      "color": {
        "label": "Color"
      },
      "scene": {
        "label": "Escena"
      },
      "liveOnly": {
        "label": "Solo en directo"
      }
    }
  },
  "wait": {
    "label": "Esperar",
    "summary": "Pausar antes del siguiente paso",
    "field": {
      "seconds": {
        "label": "Esperar durante",
        "unit": "segundos, máximo {max}",
        "hint": "En cada ejecución, todas las esperas suman como máximo 60 segundos."
      }
    }
  },
  "loop": {
    "label": "Repetir pasos",
    "summary": "Ejecutar una ruta hasta 100 veces",
    "field": {
      "times": {
        "label": "Cuántas veces",
        "placeholder": "3",
        "hint": "De 1 a 100. También puedes usar una variable, como {args}."
      }
    },
    "out": {
      "body": "Cada vez",
      "done": "Al terminar"
    }
  },
  "varSet": {
    "label": "Fijar una variable",
    "summary": "Guardar un valor para después",
    "field": {
      "scope": {
        "label": "Guardado para",
        "option": {
          "channel": "El canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nombre",
        "placeholder": "muertes"
      },
      "value": {
        "label": "Valor",
        "placeholder": "{user}"
      }
    }
  },
  "varAdd": {
    "label": "Sumar a una variable",
    "summary": "Sumar o restar",
    "field": {
      "scope": {
        "label": "Guardado para",
        "option": {
          "channel": "El canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nombre",
        "placeholder": "muertes"
      },
      "amount": {
        "label": "Cantidad"
      }
    }
  },
  "varDelete": {
    "label": "Eliminar una variable",
    "summary": "Olvidar un valor",
    "field": {
      "scope": {
        "label": "Guardado para",
        "option": {
          "channel": "El canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nombre",
        "placeholder": "muertes"
      }
    }
  },
  "math": {
    "label": "Hacer cálculos",
    "summary": "Calcular un número",
    "field": {
      "expression": {
        "label": "Expresión",
        "placeholder": "random(1, 6) * 10",
        "hint": "Usa + - * / % ^ y las funciones round, floor, ceil, abs, min, max y random(a, b)."
      },
      "saveAs": {
        "label": "Guardar como",
        "placeholder": "total"
      }
    }
  },
  "cooldownAdd": {
    "label": "Añadir tiempo a un enfriamiento",
    "summary": "Extender un temporizador con nombre mientras se ejecuta",
    "line": "Añadir {seconds} a {name}",
    "field": {
      "name": {
        "label": "Temporizador"
      },
      "seconds": {
        "label": "Añadir",
        "range": "Usa de 1 segundo a {days} días."
      },
      "per": {
        "label": "Por",
        "hint": "Añade el tiempo de arriba por cada cantidad completa. Pon 100 en una receta de bits para contar cada 100 bits. Déjalo vacío para añadirlo una vez por evento."
      }
    }
  },
  "countdownAdd": {
    "label": "Añadir tiempo a la cuenta atrás",
    "summary": "Ampliar una cuenta atrás activa",
    "line": "Añadir {seconds} a {name}",
    "field": {
      "name": {
        "label": "Cuenta atrás"
      },
      "seconds": {
        "label": "Añadir",
        "range": "Usa entre 1 segundo y {days} días."
      },
      "per": {
        "label": "Por cada",
        "hint": "Añade este tiempo por cada cantidad completa. Déjalo vacío para añadirlo una vez por evento."
      }
    }
  },
  "poll": {
    "label": "Iniciar una encuesta",
    "summary": "Deja que los espectadores voten una pregunta",
    "line": "Encuesta: {title}",
    "field": {
      "title": {
        "label": "Título"
      },
      "choices": {
        "label": "Opciones (una por línea)"
      },
      "seconds": {
        "label": "Duración (segundos)"
      }
    }
  },
  "pollEnd": {
    "label": "Finalizar una encuesta",
    "summary": "Detén la votación o archiva los resultados",
    "line": {
      "terminate": "Cerrar la encuesta y mostrar los resultados",
      "archive": "Archivar la encuesta"
    },
    "field": {
      "status": {
        "label": "Acción",
        "option": {
          "terminate": "Detener la votación",
          "archive": "Archivar"
        }
      }
    }
  },
  "prediction": {
    "label": "Iniciar una predicción",
    "summary": "Deja que apuesten puntos por un resultado",
    "line": "Predicción: {title}",
    "field": {
      "title": {
        "label": "Título"
      },
      "outcomes": {
        "label": "Resultados (uno por línea)"
      },
      "seconds": {
        "label": "Duración (segundos)"
      }
    }
  },
  "predictionEnd": {
    "label": "Finalizar una predicción",
    "summary": "Cierra apuestas, devuelve puntos o elige ganador",
    "line": {
      "lock": "Cerrar las apuestas",
      "cancel": "Cancelar y devolver los puntos",
      "resolve": "Resultado ganador: {winner}"
    },
    "field": {
      "status": {
        "label": "Acción",
        "option": {
          "lock": "Bloquear la votación",
          "cancel": "Cancelar y reembolsar",
          "resolve": "Elegir un ganador"
        }
      },
      "winner": {
        "label": "Número del resultado ganador"
      }
    }
  },
  "raidStart": {
    "label": "Iniciar una incursión",
    "summary": "Envía a tus espectadores a otro canal",
    "line": "Iniciar una incursión a {target}",
    "field": {
      "target": {
        "label": "Nombre de canal o espectador"
      }
    }
  },
  "raidCancel": {
    "label": "Cancelar una incursión",
    "summary": "Detén la raid antes de que salgan los espectadores"
  },
  "mod": {
    "label": "Cambiar el rol de moderador",
    "summary": "Da o quita permisos de moderador",
    "line": {
      "on": "Dar el rol de moderador a {target}",
      "off": "Quitar el rol de moderador a {target}"
    },
    "field": {
      "target": {
        "label": "Nombre de canal o espectador"
      },
      "on": {
        "label": "Activado"
      }
    }
  },
  "vip": {
    "label": "Cambiar el rol VIP",
    "summary": "Da o quita la insignia VIP de un espectador",
    "line": {
      "on": "Dar el rol VIP a {target}",
      "off": "Quitar el rol VIP a {target}"
    },
    "field": {
      "target": {
        "label": "Nombre de canal o espectador"
      },
      "on": {
        "label": "Activado"
      }
    }
  },
  "clearChat": {
    "label": "Borrar el chat",
    "summary": "Elimina todos los mensajes del chat"
  },
  "adSnooze": {
    "label": "Posponer el próximo anuncio",
    "summary": "Retrasa la próxima pausa publicitaria"
  },
  "whisper": {
    "label": "Enviar un susurro",
    "summary": "Envía un mensaje privado a un espectador",
    "line": "Susurro a {target}: {text}",
    "field": {
      "target": {
        "label": "Nombre de canal o espectador"
      },
      "text": {
        "label": "Mensaje"
      }
    }
  },
  "unbanResolve": {
    "label": "Resolver la solicitud de desbloqueo",
    "summary": "Aprueba o rechaza la apelación de un espectador",
    "field": {
      "status": {
        "label": "Acción",
        "option": {
          "approve": "Aprobar",
          "deny": "Rechazar"
        }
      },
      "resolution": {
        "label": "Mensaje de resolución (opcional)"
      }
    }
  },
  "brandedContent": {
    "label": "Indicar contenido de marca",
    "summary": "Muestra u oculta el aviso de promoción pagada",
    "field": {
      "on": {
        "label": "Activado"
      }
    }
  },
  "stop": {
    "label": "Detener aquí",
    "summary": "Termina la ejecución aquí",
    "keywords": "fin terminar salir detener",
    "line": "Termina la ejecución aquí",
    "note": "En rutas paralelas, solo termina esa ruta."
  },
  "random": {
    "label": "Elegir una ruta al azar",
    "summary": "Elige una ruta según las probabilidades configuradas",
    "keywords": "dados azar mezclar ponderado",
    "path": "Ruta {path}",
    "pathPercent": "{label} ({percent} %)",
    "field": {
      "paths": {
        "label": "Rutas",
        "option": {
          "2": "2",
          "3": "3",
          "4": "4",
          "5": "5"
        }
      },
      "weight1": {
        "label": "Probabilidad de la ruta 1",
        "unit": "partes"
      },
      "weight2": {
        "label": "Probabilidad de la ruta 2",
        "unit": "partes"
      },
      "weight3": {
        "label": "Probabilidad de la ruta 3",
        "unit": "partes"
      },
      "weight4": {
        "label": "Probabilidad de la ruta 4",
        "unit": "partes"
      },
      "weight5": {
        "label": "Probabilidad de la ruta 5",
        "unit": "partes"
      }
    }
  },
  "run": {
    "label": "Ejecutar otra receta",
    "summary": "Inicia otra receta de este canal",
    "keywords": "llamar activar encadenar",
    "line": "Ejecutar {name}",
    "note": "Una receta puede llamar a otras con hasta 2 niveles de profundidad.",
    "field": {
      "automationId": {
        "label": "Receta",
        "hint": "Se siguen aplicando sus propias comprobaciones. Empieza con los valores de esta receta y conserva sus cambios por separado."
      }
    }
  }
}
