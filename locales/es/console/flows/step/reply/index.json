{
  "chat": {
    "label": "Enviar mensaje",
    "summary": "Publica un mensaje en el chat",
    "field": {
      "message": {
        "label": "Mensaje",
        "placeholder": "¡Gracias, {user}!"
      }
    }
  },
  "points": {
    "label": "Cambiar puntos",
    "summary": "Añadir o quitar puntos",
    "field": {
      "amount": {
        "label": "Cantidad",
        "unit": "puntos"
      },
      "change": { "label": "Cambio", "option": { "add": "Añadir", "take": "Quitar" } }
    },
    "line": { "add": "Dar {amount}", "take": "Quitar {amount}" }
  },
  "counter": {
    "label": "Cambiar contador",
    "summary": "Aumentar, reducir o fijar un contador con nombre",
    "field": {
      "counter": {
        "label": "Contador"
      },
      "change": { "label": "Cambio", "option": { "add": "Añadir", "set": "Fijar" } },
      "amount": { "label": "Cantidad", "hint": "Usa un número negativo para restar" },
      "value": { "label": "Valor" }
    },
    "line": { "add": "Añadir {amount} a {counter}", "take": "Quitar {amount} de {counter}", "set": "Fijar {counter} en {value}" }
  },
  "lights": {
    "label": "Ajustar luces",
    "summary": "Color, escena, blanco, encendido o apagado de luces Govee",
    "field": {
      "device": {
        "label": "Luz"
      },
      "mode": {
        "label": "Ajustar",
        "option": {
          "color": "Color",
          "scene": "Escena",
          "white": "Blanco",
          "on": "Encender",
          "off": "Apagar"
        }
      },
      "color": {
        "label": "Color"
      },
      "scene": {
        "label": "Escena",
        "hint": "Usa la lista de escenas de la primera luz."
      },
      "liveOnly": {
        "label": "Solo en directo"
      },
      "kelvin": {
        "label": "Temperatura de color"
      },
      "brightness": {
        "label": "Brillo",
        "placeholder": "Mantener",
        "unit": "%"
      },
      "holdS": {
        "label": "Volver después de",
        "hint": "Las luces vuelven a su estado anterior. Si había una escena, se recupera su último color.",
        "range": "Usa de 0 a {max} segundos."
      }
    },
    "noColors": "Esta luz no admite colores",
    "noWarmth": "Esta luz no permite ajustar el blanco",
    "noLights": "No se encontraron luces Govee que puedas controlar.",
    "noLightsBody": "Añade una luz a tu cuenta de Govee desde la aplicación."
  },
  "wait": {
    "label": "Esperar",
    "summary": "Pausar antes del siguiente paso",
    "field": {
      "seconds": {
        "label": "Esperar durante",
        "unit": "segundos, máximo {max}",
        "hint": "En cada ejecución, todas las esperas suman como máximo 60 segundos."
      }
    }
  },
  "loop": {
    "label": "Repetir pasos",
    "summary": "Ejecutar una ruta hasta 100 veces",
    "field": {
      "times": {
        "label": "Cuántas veces",
        "placeholder": "3",
        "hint": "De 1 a 100. También puedes usar una variable, como {args}."
      }
    },
    "out": {
      "body": "Cada vez",
      "done": "Al terminar"
    }
  },
  "varSet": {
    "label": "Fijar una variable",
    "summary": "Guardar un valor para después",
    "field": {
      "scope": {
        "label": "Guardado para",
        "option": {
          "channel": "El canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nombre",
        "placeholder": "muertes"
      },
      "value": {
        "label": "Valor",
        "placeholder": "{user}"
      }
    }
  },
  "varAdd": {
    "label": "Sumar a una variable",
    "summary": "Sumar o restar",
    "field": {
      "scope": {
        "label": "Guardado para",
        "option": {
          "channel": "El canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nombre",
        "placeholder": "muertes"
      },
      "amount": {
        "label": "Cantidad"
      }
    }
  },
  "varDelete": {
    "label": "Eliminar una variable",
    "summary": "Olvidar un valor",
    "field": {
      "scope": {
        "label": "Guardado para",
        "option": {
          "channel": "El canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nombre",
        "placeholder": "muertes"
      }
    }
  },
  "math": {
    "label": "Hacer cálculos",
    "summary": "Calcular un número",
    "field": {
      "expression": {
        "label": "Expresión",
        "placeholder": "random(1, 6) * 10",
        "hint": "Usa + - * / % ^ y las funciones round, floor, ceil, abs, min, max y random(a, b)."
      },
      "saveAs": {
        "label": "Guardar como",
        "placeholder": "total"
      }
    }
  },
  "cooldownAdd": {
    "label": "Añadir tiempo a un enfriamiento",
    "summary": "Extender un temporizador con nombre mientras se ejecuta",
    "line": "Añadir {seconds} a {name}",
    "field": {
      "name": {
        "label": "Temporizador"
      },
      "seconds": {
        "label": "Añadir",
        "range": "Usa de 1 segundo a {days} días."
      },
      "per": {
        "label": "Por cada",
        "hint": "Solo con Cheers y suscripciones regaladas. Déjalo vacío para añadir tiempo una vez."
      }
    }
  },
  "countdownAdd": {
    "label": "Añadir tiempo a la cuenta atrás",
    "summary": "Ampliar una cuenta atrás activa",
    "line": "Añadir {seconds} a {name}",
    "field": {
      "name": {
        "label": "Cuenta atrás"
      },
      "seconds": {
        "label": "Añadir",
        "range": "Usa entre 1 segundo y {days} días."
      },
      "per": {
        "label": "Por cada",
        "hint": "Solo con Cheers y suscripciones regaladas. Déjalo vacío para añadir tiempo una vez."
      }
    }
  },
  "poll": {
    "label": "Iniciar una encuesta",
    "summary": "Deja que los espectadores voten una pregunta",
    "line": "Encuesta: {title}",
    "field": {
      "title": {
        "label": "Título"
      },
      "choices": {
        "label": "Opciones (una por línea)"
      },
      "seconds": {
        "label": "Duración (segundos)"
      },
      "extraVotes": {
        "label": "Votos extra con Puntos del canal"
      },
      "pointsPerVote": {
        "label": "Puntos por voto"
      }
    }
  },
  "pollEnd": {
    "label": "Finalizar una encuesta",
    "summary": "Detén la votación o archiva los resultados",
    "line": {
      "terminate": "Finalizar encuesta y mostrar resultados",
      "archive": "Finalizar encuesta y ocultar resultados"
    },
    "field": {
      "status": {
        "label": "Acción",
        "option": {
          "terminate": "Finalizar y mostrar resultados",
          "archive": "Finalizar y ocultar resultados"
        }
      }
    }
  },
  "prediction": {
    "label": "Iniciar una predicción",
    "summary": "Deja que apuesten puntos por un resultado",
    "line": "Predicción: {title}",
    "field": {
      "title": {
        "label": "Título"
      },
      "outcomes": {
        "label": "Resultados (uno por línea)"
      },
      "seconds": {
        "label": "Duración (segundos)"
      }
    }
  },
  "predictionEnd": {
    "label": "Finalizar una predicción",
    "summary": "Cierra apuestas, devuelve puntos o elige ganador",
    "line": {
      "lock": "Cerrar las apuestas",
      "cancel": "Cancelar y devolver los puntos",
      "resolve": "Ganador: {outcome}"
    },
    "field": {
      "status": {
        "label": "Acción",
        "option": {
          "lock": "Cerrar las apuestas",
          "cancel": "Cancelar y devolver los puntos",
          "resolve": "Elegir un ganador"
        }
      },
      "outcome": {
        "label": "Resultado ganador",
        "hint": "Un número o el nombre del resultado"
      }
    }
  },
  "raidStart": {
    "label": "Iniciar una incursión",
    "summary": "Envía a tus espectadores a otro canal",
    "line": "Iniciar una incursión a {target}",
    "field": {
      "target": {
        "label": "Canal de destino de la incursión",
        "placeholder": "nombre del canal"
      }
    }
  },
  "raidCancel": {
    "label": "Cancelar una incursión",
    "summary": "Detén la raid antes de que salgan los espectadores"
  },
  "mod": {
    "label": "Rol de moderador",
    "summary": "Añade o quita a un moderador",
    "line": {
      "add": "Dar el rol de moderador: {who}",
      "remove": "Quitar el rol de moderador: {who}"
    },
    "field": {
      "change": {
        "label": "Cambio",
        "option": { "add": "Añadir", "remove": "Quitar" }
      }
    }
  },
  "vip": {
    "label": "Rol VIP",
    "summary": "Añade o quita a un VIP",
    "line": {
      "add": "Dar el rol VIP: {who}",
      "remove": "Quitar el rol VIP: {who}"
    },
    "field": {
      "change": {
        "label": "Cambio",
        "option": { "add": "Añadir", "remove": "Quitar" }
      }
    }
  },
  "clearChat": {
    "label": "Borrar el chat",
    "summary": "Elimina todos los mensajes del chat",
    "line": "Limpiar todo el chat"
  },
  "adSnooze": {
    "label": "Posponer el próximo anuncio",
    "summary": "Retrasa la próxima pausa publicitaria"
  },
  "whisper": {
    "label": "Enviar un susurro",
    "summary": "Envía un mensaje privado a un espectador",
    "line": "Susurro a {target}: {text}",
    "field": {
      "target": {
        "label": "Nombre de canal o espectador"
      },
      "text": {
        "label": "Mensaje",
        "hint": "Se envía desde la cuenta del bot."
      }
    }
  },
  "unbanResolve": {
    "label": "Responder a la solicitud de desbloqueo",
    "summary": "Aprueba o rechaza una apelación",
    "line": {
      "approve": "Aprobar la solicitud de desbloqueo",
      "deny": "Rechazar la solicitud de desbloqueo"
    },
    "field": {
      "status": {
        "label": "Respuesta",
        "option": {
          "approve": "Aprobar",
          "deny": "Rechazar"
        }
      },
      "resolution": {
        "label": "Mensaje al espectador (opcional)"
      }
    }
  },
  "stop": {
    "label": "Detener aquí",
    "summary": "Termina la ejecución aquí",
    "keywords": "fin terminar salir detener",
    "line": "Termina la ejecución aquí",
    "note": "En rutas paralelas, solo termina esa ruta."
  },
  "random": {
    "label": "Elegir una ruta al azar",
    "summary": "Elige una ruta según las probabilidades configuradas",
    "keywords": "dados azar mezclar ponderado",
    "path": "Ruta {path}",
    "pathPercent": "{label} ({percent} %)",
    "field": {
      "paths": {
        "label": "Rutas",
        "option": {
          "2": "2",
          "3": "3",
          "4": "4",
          "5": "5"
        }
      },
      "weight1": {
        "label": "Probabilidad de la ruta 1",
        "unit": "partes"
      },
      "weight2": {
        "label": "Probabilidad de la ruta 2",
        "unit": "partes"
      },
      "weight3": {
        "label": "Probabilidad de la ruta 3",
        "unit": "partes"
      },
      "weight4": {
        "label": "Probabilidad de la ruta 4",
        "unit": "partes"
      },
      "weight5": {
        "label": "Probabilidad de la ruta 5",
        "unit": "partes"
      }
    }
  },
  "run": {
    "label": "Ejecutar otra receta",
    "summary": "Inicia otra receta de este canal",
    "keywords": "llamar activar encadenar",
    "line": "Ejecutar {name}",
    "note": "Una receta puede llamar a otras con hasta 2 niveles de profundidad.",
    "field": {
      "automationId": {
        "label": "Receta",
        "hint": "Se siguen aplicando sus propias comprobaciones. Empieza con los valores de esta receta y conserva sus cambios por separado."
      }
    }
  },
  "redemption": {
    "label": "Completar canje",
    "summary": "Completa el canje de una recompensa o devuelve sus puntos",
    "field": {
      "result": {
        "label": "Resultado"
      }
    },
    "line": {
      "fulfill": "Marcar como completada",
      "cancel": "Devolver los puntos"
    }
  },
  "pointsSpend": {
    "label": "Gastar puntos",
    "summary": "Descuenta puntos si el espectador tiene suficientes",
    "line": "Gastar {amount}",
    "field": {
      "amount": {
        "label": "Cantidad",
        "unit": "puntos"
      }
    },
    "out": {
      "enough": "Suficientes",
      "notEnough": "Insuficientes"
    }
  },
  "countdownStop": {
    "label": "Detener la cuenta atrás",
    "summary": "Termina antes de tiempo una cuenta atrás activa",
    "line": "Detener {name}",
    "field": {
      "name": {
        "label": "Cuenta atrás"
      }
    }
  },
  "cooldownReset": {
    "label": "Restablecer el tiempo de espera",
    "summary": "Elimina la espera de un intervalo con nombre",
    "line": "Restablecer {name}",
    "field": {
      "name": {
        "label": "Tiempo de espera"
      }
    }
  }
}
