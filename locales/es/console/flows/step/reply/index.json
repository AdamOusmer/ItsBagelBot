{
  "chat": {
    "label": "Enviar mensaje",
    "summary": "Publica un mensaje en el chat",
    "field": {
      "message": {
        "label": "Mensaje",
        "placeholder": "¡Gracias, {user}!"
      }
    }
  },
  "points": {
    "label": "Dar puntos de fidelidad",
    "summary": "Añadir o quitar puntos",
    "field": {
      "amount": {
        "label": "Cantidad",
        "unit": "puntos"
      }
    }
  },
  "counter": {
    "label": "Aumentar contador",
    "summary": "Aumentar un contador",
    "field": {
      "counter": {
        "label": "Contador"
      }
    }
  },
  "lights": {
    "label": "Ajustar luces",
    "summary": "Ajustar un color o escena de Govee",
    "field": {
      "device": {
        "label": "Luz"
      },
      "mode": {
        "label": "Ajustar",
        "option": {
          "color": "Color",
          "scene": "Escena"
        }
      },
      "color": {
        "label": "Color"
      },
      "scene": {
        "label": "Escena"
      },
      "liveOnly": {
        "label": "Solo en directo"
      }
    }
  },
  "wait": {
    "label": "Esperar",
    "summary": "Pausar antes del siguiente paso",
    "field": {
      "seconds": {
        "label": "Retardo",
        "unit": "segundos, máximo {max}"
      }
    }
  },
  "loop": {
    "label": "Repetir pasos",
    "summary": "Ejecutar una ruta hasta 100 veces",
    "field": {
      "times": {
        "label": "Cuántas veces",
        "placeholder": "3"
      }
    },
    "out": {
      "body": "Cada vez",
      "done": "Al terminar"
    }
  },
  "varSet": {
    "label": "Fijar una variable",
    "summary": "Guardar un valor para después",
    "field": {
      "scope": {
        "label": "Guardado para",
        "option": {
          "channel": "El canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nombre",
        "placeholder": "muertes"
      },
      "value": {
        "label": "Valor",
        "placeholder": "{user}"
      }
    }
  },
  "varAdd": {
    "label": "Sumar a una variable",
    "summary": "Sumar o restar",
    "field": {
      "scope": {
        "label": "Guardado para",
        "option": {
          "channel": "El canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nombre",
        "placeholder": "muertes"
      },
      "amount": {
        "label": "Cantidad"
      }
    }
  },
  "varDelete": {
    "label": "Eliminar una variable",
    "summary": "Olvidar un valor",
    "field": {
      "scope": {
        "label": "Guardado para",
        "option": {
          "channel": "El canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nombre",
        "placeholder": "muertes"
      }
    }
  },
  "math": {
    "label": "Hacer cálculos",
    "summary": "Calcular un número",
    "field": {
      "expression": {
        "label": "Expresión",
        "placeholder": "({bits} / 100) + 1"
      },
      "saveAs": {
        "label": "Guardar como",
        "placeholder": "total"
      }
    }
  },
  "cooldownAdd": {
    "label": "Añadir tiempo a un enfriamiento",
    "summary": "Extender un temporizador con nombre mientras se ejecuta",
    "line": "Añadir {seconds} a {name}",
    "field": {
      "name": {
        "label": "Temporizador"
      },
      "seconds": {
        "label": "Añadir",
        "range": "Usa de 1 segundo a {days} días."
      },
      "per": {
        "label": "Por",
        "hint": "Añade el tiempo de arriba por cada cantidad completa. Pon 100 en una receta de bits para contar cada 100 bits. Déjalo vacío para añadirlo una vez por evento."
      }
    }
  },
  "countdownAdd": {
    "label": "Añadir tiempo a la cuenta atrás",
    "summary": "Ampliar una cuenta atrás activa",
    "line": "Añadir {seconds} a {name}",
    "field": {
      "name": {
        "label": "Cuenta atrás"
      },
      "seconds": {
        "label": "Añadir",
        "range": "Usa entre 1 segundo y {days} días."
      },
      "per": {
        "label": "Por cada",
        "hint": "Añade este tiempo por cada cantidad completa. Déjalo vacío para añadirlo una vez por evento."
      }
    }
  },
  "poll": {
    "label": "Iniciar una encuesta",
    "summary": "Deja que los espectadores voten una pregunta",
    "line": "Encuesta: {title}",
    "field": {
      "title": {
        "label": "Título"
      },
      "choices": {
        "label": "Opciones (una por línea)"
      },
      "seconds": {
        "label": "Duración (segundos)"
      },
      "extraVotes": {
        "label": "Votos extra con Puntos del canal"
      },
      "pointsPerVote": {
        "label": "Puntos por voto"
      }
    }
  },
  "pollEnd": {
    "label": "Finalizar una encuesta",
    "summary": "Detén la votación o archiva los resultados",
    "line": {
      "terminate": "Finalizar encuesta y mostrar resultados",
      "archive": "Finalizar encuesta y ocultar resultados"
    },
    "field": {
      "status": {
        "label": "Acción",
        "option": {
          "terminate": "Finalizar y mostrar resultados",
          "archive": "Finalizar y ocultar resultados"
        }
      }
    }
  },
  "prediction": {
    "label": "Iniciar una predicción",
    "summary": "Deja que apuesten puntos por un resultado",
    "line": "Predicción: {title}",
    "field": {
      "title": {
        "label": "Título"
      },
      "outcomes": {
        "label": "Resultados (uno por línea)"
      },
      "seconds": {
        "label": "Duración (segundos)"
      }
    }
  },
  "predictionEnd": {
    "label": "Finalizar una predicción",
    "summary": "Cierra apuestas, devuelve puntos o elige ganador",
    "line": {
      "lock": "Cerrar las apuestas",
      "cancel": "Cancelar y devolver los puntos",
      "resolve": "Ganador: {outcome}"
    },
    "field": {
      "status": {
        "label": "Acción",
        "option": {
          "lock": "Cerrar las apuestas",
          "cancel": "Cancelar y devolver los puntos",
          "resolve": "Elegir un ganador"
        }
      },
      "outcome": {
        "label": "Resultado ganador",
        "hint": "Un número o el nombre del resultado"
      }
    }
  },
  "raidStart": {
    "label": "Iniciar una incursión",
    "summary": "Envía a tus espectadores a otro canal",
    "line": "Iniciar una incursión a {target}",
    "field": {
      "target": {
        "label": "Nombre de canal o espectador"
      }
    }
  },
  "raidCancel": {
    "label": "Cancelar una incursión",
    "summary": "Detén la raid antes de que salgan los espectadores"
  },
  "mod": {
    "label": "Cambiar el rol de moderador",
    "summary": "Da o quita permisos de moderador",
    "line": {
      "on": "Dar el rol de moderador a {target}",
      "off": "Quitar el rol de moderador a {target}"
    },
    "field": {
      "target": {
        "label": "Nombre de canal o espectador"
      },
      "on": {
        "label": "Activado"
      }
    }
  },
  "vip": {
    "label": "Cambiar el rol VIP",
    "summary": "Da o quita la insignia VIP de un espectador",
    "line": {
      "on": "Dar el rol VIP a {target}",
      "off": "Quitar el rol VIP a {target}"
    },
    "field": {
      "target": {
        "label": "Nombre de canal o espectador"
      },
      "on": {
        "label": "Activado"
      }
    }
  },
  "clearChat": {
    "label": "Borrar el chat",
    "summary": "Elimina todos los mensajes del chat",
    "line": "Limpiar todo el chat"
  },
  "adSnooze": {
    "label": "Posponer el próximo anuncio",
