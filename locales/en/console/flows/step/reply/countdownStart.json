{
  "label": "Start countdown",
  "summary": "Start or restart a named countdown",
  "field": {
    "name": {
      "label": "Name",
      "placeholder": "subathon"
    },
    "seconds": {
      "label": "Duration",
      "range": "Use 1 second to {days} days."
    },
    "leftCommand": {
      "label": "Time left command",
      "placeholder": "!timeleft"
    },
    "leftReply": {
      "label": "Time left reply",
      "placeholder": "{countdown:left} left"
    },
    "readyReply": {
      "label": "Time left reply when finished",
      "placeholder": "The countdown has finished!"
    }
  }
}
