{
  "chat": {
    "label": "Send message",
    "summary": "Post a message in chat",
    "field": {
      "message": {
        "label": "Message",
        "placeholder": "Thanks {user}!"
      }
    }
  },
  "points": {
    "label": "Change points",
    "summary": "Add or remove points",
    "field": {
      "amount": {
        "label": "Amount",
        "unit": "points"
      },
      "change": { "label": "Change", "option": { "add": "Add", "take": "Take" } }
    },
    "line": { "add": "Give {amount}", "take": "Take {amount}" }
  },
  "counter": {
    "label": "Change counter",
    "summary": "Add to, subtract from or set a named counter",
    "field": {
      "counter": {
        "label": "Counter"
      },
      "change": { "label": "Change", "option": { "add": "Add", "set": "Set" } },
      "amount": { "label": "Amount", "hint": "Use a minus number to take away" },
      "value": { "label": "Value" }
    },
    "line": { "add": "Add {amount} to {counter}", "take": "Take {amount} from {counter}", "set": "Set {counter} to {value}" }
  },
  "lights": {
    "label": "Set lights",
    "summary": "Color, scene, white, on or off on Govee lights",
    "field": {
      "device": {
        "label": "Light"
      },
      "mode": {
        "label": "Set",
        "option": {
          "color": "Color",
          "scene": "Scene",
          "white": "White",
          "on": "On",
          "off": "Off"
        }
      },
      "color": {
        "label": "Color"
      },
      "scene": {
        "label": "Scene",
        "hint": "Plays on the first light's scene list."
      },
      "liveOnly": {
        "label": "Only while live"
      },
      "kelvin": {
        "label": "Warmth"
      },
      "brightness": {
        "label": "Brightness",
        "placeholder": "Keep",
        "unit": "%"
      },
      "holdS": {
        "label": "Go back after",
        "hint": "Lights return to how they were. Scenes come back as their last color.",
        "range": "Use 0 to {max} seconds."
      }
    },
    "noColors": "This light has no colors",
    "noWarmth": "This light has no white warmth",
    "noLights": "No controllable Govee lights found.",
    "noLightsBody": "Add a light to your Govee account in the Govee app."
  },
  "wait": {
    "label": "Wait",
    "summary": "Pause before the next step",
    "field": {
      "seconds": {
        "label": "Wait for",
        "unit": "seconds, max {max}",
        "hint": "All waits in one run add up to 60 seconds at most."
      }
    }
  },
  "loop": {
    "label": "Repeat steps",
    "summary": "Run a path up to 100 times",
    "field": {
      "times": {
        "label": "How many times",
        "placeholder": "3",
        "hint": "1 to 100. A variable works too, like {args}."
      }
    },
    "out": {
      "body": "Each time",
      "done": "When done"
    }
  },
  "varSet": {
    "label": "Set a variable",
    "summary": "Keep a value for later",
    "field": {
      "scope": {
        "label": "Kept for",
        "option": {
          "channel": "The channel",
          "viewer": "This viewer"
        }
      },
      "name": {
        "label": "Name",
        "placeholder": "deaths"
      },
      "value": {
        "label": "Value",
        "placeholder": "{user}"
      }
    }
  },
  "varAdd": {
    "label": "Add to a variable",
    "summary": "Count up or down",
    "field": {
      "scope": {
        "label": "Kept for",
        "option": {
          "channel": "The channel",
          "viewer": "This viewer"
        }
      },
      "name": {
        "label": "Name",
        "placeholder": "deaths"
      },
      "amount": {
        "label": "Amount"
      }
    }
  },
  "varDelete": {
    "label": "Delete a variable",
    "summary": "Forget a value",
    "field": {
      "scope": {
        "label": "Kept for",
        "option": {
          "channel": "The channel",
          "viewer": "This viewer"
        }
      },
      "name": {
        "label": "Name",
        "placeholder": "deaths"
      }
    }
  },
  "math": {
    "label": "Do math",
    "summary": "Work out a number",
    "field": {
      "expression": {
        "label": "Expression",
        "placeholder": "random(1, 6) * 10",
        "hint": "Use + - * / % ^ and round, floor, ceil, abs, min, max, random(a, b)."
      },
      "saveAs": {
        "label": "Save as",
        "placeholder": "total"
      }
    }
  },
  "cooldownAdd": {
    "label": "Add time to a cooldown",
    "summary": "Extend a named timer while it runs",
    "line": "Add {seconds} to {name}",
    "field": {
      "name": {
        "label": "Timer"
      },
      "seconds": {
        "label": "Add",
        "range": "Use 1 second to {days} days."
      },
      "per": {
        "label": "For every",
        "hint": "Only on cheer and gift sub triggers. Leave empty to add time once."
      }
    }
  },
  "countdownAdd": {
    "label": "Add time to countdown",
    "summary": "Extend a running countdown",
    "line": "Add {seconds} to {name}",
    "field": {
      "name": {
        "label": "Countdown"
      },
      "seconds": {
        "label": "Add",
        "range": "Use 1 second to {days} days."
      },
      "per": {
        "label": "For every",
        "hint": "Only on cheer and gift sub triggers. Leave empty to add time once."
      }
    }
  },
  "poll": {
    "label": "Start a poll",
    "summary": "Let viewers vote on a question",
    "line": "Poll: {title}",
    "field": {
      "title": {
        "label": "Title"
      },
      "choices": {
        "label": "Choices (one per line)"
      },
      "seconds": {
        "label": "Duration (seconds)"
      },
      "extraVotes": {
        "label": "Extra votes with Channel Points"
      },
      "pointsPerVote": {
        "label": "Points per vote"
      }
    }
  },
  "pollEnd": {
    "label": "End a poll",
    "summary": "Stop voting or archive the results",
    "line": {
      "terminate": "End poll and show results",
      "archive": "End poll and hide results"
    },
    "field": {
      "status": {
        "label": "Action",
        "option": {
          "terminate": "End and show results",
          "archive": "End and hide results"
        }
      }
    }
  },
  "prediction": {
    "label": "Start a prediction",
    "summary": "Let viewers bet points on an outcome",
    "line": "Prediction: {title}",
    "field": {
      "title": {
        "label": "Title"
      },
      "outcomes": {
        "label": "Outcomes (one per line)"
      },
      "seconds": {
        "label": "Duration (seconds)"
      }
    }
  },
  "predictionEnd": {
    "label": "End a prediction",
    "summary": "Lock bets, refund points or pick a winner",
    "line": {
      "lock": "Lock bets",
      "cancel": "Cancel and refund",
      "resolve": "Winner: {outcome}"
    },
    "field": {
      "status": {
        "label": "Action",
        "option": {
          "lock": "Lock bets",
          "cancel": "Cancel and refund",
          "resolve": "Pick a winner"
        }
      },
      "outcome": {
        "label": "Winning outcome",
        "hint": "A number or the outcome name"
      }
    }
  },
  "raidStart": {
    "label": "Start a raid",
    "summary": "Send your viewers to another channel",
    "line": "Raid {target}",
    "field": {
      "target": {
        "label": "Channel to raid",
        "placeholder": "channel name"
      }
    }
  },
  "raidCancel": {
    "label": "Cancel a raid",
    "summary": "Stop the raid before viewers leave"
  },
  "mod": {
    "label": "Moderator role",
    "summary": "Add or remove a moderator",
    "line": {
      "add": "Make {who} a moderator",
      "remove": "Remove {who} as moderator"
    },
    "field": {
      "change": {
        "label": "Change",
        "option": { "add": "Add", "remove": "Remove" }
      }
    }
  },
  "vip": {
    "label": "VIP role",
    "summary": "Add or remove a VIP",
    "line": {
      "add": "Make {who} a VIP",
      "remove": "Remove {who} as VIP"
    },
    "field": {
      "change": {
        "label": "Change",
        "option": { "add": "Add", "remove": "Remove" }
      }
    }
  },
  "clearChat": {
    "label": "Clear chat",
    "summary": "Remove all messages from chat",
    "line": "Clear all chat"
  },
  "adSnooze": {
    "label": "Snooze the next ad",
    "summary": "Push back the next ad break"
  },
  "whisper": {
    "label": "Send a whisper",
    "summary": "Send a private message to one viewer",
    "line": "Whisper {target}: {text}",
    "field": {
      "target": {
        "label": "Channel or viewer login"
      },
      "text": {
        "label": "Message",
        "hint": "Sent from the bot account."
      }
    }
  },
  "unbanResolve": {
    "label": "Answer unban request",
    "summary": "Approve or deny an appeal",
    "line": {
      "approve": "Approve the unban request",
      "deny": "Deny the unban request"
    },
    "field": {
      "status": {
        "label": "Answer",
        "option": {
          "approve": "Approve",
          "deny": "Deny"
        }
      },
      "resolution": {
        "label": "Message to the viewer (optional)"
      }
    }
  },
  "stop": {
    "label": "Stop here",
    "summary": "End the run here",
    "keywords": "end exit quit",
    "line": "End the run here",
    "note": "Inside parallel paths it ends only that path."
  },
  "random": {
    "label": "Pick a random path",
    "summary": "Choose a path using the chances you set",
    "keywords": "dice chance shuffle weighted",
    "path": "Path {path}",
    "pathPercent": "{label} ({percent}%)",
    "field": {
      "paths": {
        "label": "Paths",
        "option": {
          "2": "2",
          "3": "3",
          "4": "4",
          "5": "5"
        }
      },
      "weight1": {
        "label": "Path 1 chance",
        "unit": "parts"
      },
      "weight2": {
        "label": "Path 2 chance",
        "unit": "parts"
      },
      "weight3": {
        "label": "Path 3 chance",
        "unit": "parts"
      },
      "weight4": {
        "label": "Path 4 chance",
        "unit": "parts"
      },
      "weight5": {
        "label": "Path 5 chance",
        "unit": "parts"
      }
    }
  },
  "run": {
    "label": "Run another recipe",
    "summary": "Start another recipe in this channel",
    "keywords": "call trigger chain",
    "line": "Run {name}",
    "note": "A recipe can call at most 2 levels deep.",
    "field": {
      "automationId": {
        "label": "Recipe",
        "hint": "Its own checks still apply. It starts with this recipe's values; its changes stay with it."
      }
    }
  },
  "redemption": {
    "label": "Complete redemption",
    "summary": "Fulfill a reward redemption or refund its points",
    "field": {
      "result": {
        "label": "Result"
      }
    },
    "line": {
      "fulfill": "Mark fulfilled",
      "cancel": "Refund the points"
    }
  },
  "pointsSpend": {
    "label": "Spend points",
    "summary": "Deduct points when the viewer has enough",
    "line": "Spend {amount}",
    "field": {
      "amount": {
        "label": "Amount",
        "unit": "points"
      }
    },
    "out": {
      "enough": "Enough",
      "notEnough": "Not enough"
    }
  },
  "countdownStop": {
    "label": "Stop countdown",
    "summary": "End a running countdown early",
    "line": "Stop {name}",
    "field": {
      "name": {
        "label": "Countdown"
      }
    }
  },
  "cooldownReset": {
    "label": "Reset cooldown",
    "summary": "Clear a named cooldown",
    "line": "Reset {name}",
    "field": {
      "name": {
        "label": "Cooldown"
      }
    }
  }
}
