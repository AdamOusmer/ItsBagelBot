  "cooldownAdd": {
    "label": "Add time to a cooldown",
    "summary": "Extend a named timer while it runs",
    "field": {
      "name": {
        "label": "Timer"
      },
      "seconds": {
        "label": "Add",
        "range": "Use 1 second to {days} days."
      },
      "per": {
        "label": "Per",
        "hint": "Adds the time above for each full amount. Put 100 on a bits recipe to count every 100 bits. Leave empty to add it once per event."
      }
    }
  },
  "countdownAdd": {
    "label": "Add time to countdown",
