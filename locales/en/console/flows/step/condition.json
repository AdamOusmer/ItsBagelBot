{
  "op": {
    "eq": "is equal to",
    "ne": "is not equal to",
    "gt": "is more than",
    "gte": "is at least",
    "lt": "is less than",
    "lte": "is at most",
    "contains": "contains",
    "starts": "starts with",
    "exists": "is set to anything",
    "not_exists": "is not set"
  },
  "role": {
    "label": "User level",
    "summary": "Check the viewer's role",
    "warning": "Roles are known only for chat triggers and countdowns. On this trigger everyone counts as a viewer.",
    "remove": "Remove check, keep Allowed steps",
    "everyoneNote": "Everyone passes, so this check never blocks.",
    "field": {
      "level": {
        "label": "At least",
        "option": {
          "everyone": "Everyone",
          "sub": "Subscriber",
          "vip": "VIP",
          "mod": "Moderator",
          "lead_mod": "Lead moderator",
          "broadcaster": "Broadcaster"
        }
      }
    },
    "out": { "yes": "Allowed", "no": "Blocked" }
  },
  "user": {
    "label": "Specific user",
    "summary": "Only this viewer passes",
    "field": {
      "login": { "label": "Username", "placeholder": "itsbagelbot" }
    },
    "out": { "yes": "This user", "no": "Anyone else" }
  },
  "cooldown": {
    "label": "Cooldown",
    "summary": "Let it run once every few seconds",
    "field": {
      "channelSeconds": { "label": "Channel wait", "range": "Use 0 seconds to {days} days." },
      "viewerSeconds": { "label": "Viewer wait", "range": "Use 0 seconds to {days} days." },
      "name": { "label": "Name", "placeholder": "subathon", "hint": "A named cooldown can be extended by Add time steps in any recipe. Channel wait only." },
      "leftCommand": { "label": "Time left command", "placeholder": "!timeleft" },
      "leftReply": { "label": "Reply while waiting", "placeholder": "{user}, {cooldown:left} left before you can use this again." },
      "readyReply": { "label": "Reply when ready", "placeholder": "{user}, this is ready to use." }
    },
    "out": { "yes": "Ready", "no": "Cooling down" }
  },
  "compare": {
    "label": "Compare value",
    "summary": "Compare two numbers or bits of text",
    "field": {
      "left": { "label": "Value", "placeholder": "{bits}" },
      "op": {
        "label": "Is",
        "option": { "gte": "at least", "lt": "less than", "eq": "equal to", "contains": "contains" }
      },
      "right": { "label": "This value", "placeholder": "1000" },
      "matchCase": { "label": "Match case" }
    },
    "out": { "yes": "Yes", "no": "No" }
  },
  "chance": {
    "alwaysNote": "Always passes.",
    "label": "Random chance",
    "summary": "Pass some of the time",
    "field": {
      "percent": { "label": "Chance", "unit": "%" }
    },
    "out": { "yes": "Hit", "no": "Miss" }
  },
  "var": {
    "label": "Check a variable",
    "summary": "Pass when a kept value matches",
    "field": {
      "scope": { "label": "Kept for", "option": { "channel": "The channel", "viewer": "This viewer" } },
      "name": { "label": "Name", "placeholder": "deaths" },
      "op": {
        "label": "Is",
        "option": {
          "eq": "equal to",
          "ne": "not equal to",
          "gt": "more than",
          "gte": "at least",
          "lt": "less than",
          "lte": "at most",
          "contains": "containing",
          "exists": "set to anything"
        }
      },
      "value": { "label": "Value", "placeholder": "10" }
    },
    "out": { "yes": "Yes", "no": "No" }
  }
}
