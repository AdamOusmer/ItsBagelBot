{
  "role": {
    "label": "User level",
    "summary": "Only certain viewers pass",
    "field": {
      "level": {
        "label": "At least",
        "option": {
          "everyone": "Everyone",
          "sub": "Subscriber",
          "vip": "VIP",
          "mod": "Moderator",
          "lead_mod": "Lead moderator",
          "broadcaster": "Broadcaster"
        }
      }
    },
    "out": { "yes": "Allowed", "no": "Blocked" }
  },
  "user": {
    "label": "Specific user",
    "summary": "Only this viewer passes",
    "field": {
      "login": { "label": "Username", "placeholder": "itsbagelbot" }
    },
    "out": { "yes": "This user", "no": "Anyone else" }
  },
  "cooldown": {
    "label": "Cooldown",
    "summary": "Wait between runs",
    "field": {
      "seconds": { "label": "Cooldown", "range": "Use 1 second to {days} days." },
      "perUser": { "label": "Per viewer" },
      "leftCommand": { "label": "Time left command", "placeholder": "!timeleft" },
      "leftReply": { "label": "Reply while waiting", "placeholder": "{user}, {cooldown:left} left before you can use this again." },
      "readyReply": { "label": "Reply when ready", "placeholder": "{user}, this is ready to use." }
    },
    "out": { "yes": "Ready", "no": "Cooling down" }
  },
  "compare": {
    "label": "Compare value",
    "summary": "Check a variable",
    "field": {
      "left": { "label": "Value", "placeholder": "{bits}" },
      "op": {
        "label": "Is",
        "option": { "gte": "at least", "lt": "less than", "eq": "equal to", "contains": "contains" }
      },
      "right": { "label": "This value", "placeholder": "1000" }
    },
    "out": { "yes": "Yes", "no": "No" }
  },
  "chance": {
    "label": "Random chance",
    "summary": "Pass some of the time",
    "field": {
      "percent": { "label": "Chance", "unit": "%" }
    },
    "out": { "yes": "Hit", "no": "Miss" }
  },
  "var": {
    "label": "Check a variable",
    "summary": "Pass when a kept value matches",
    "field": {
      "scope": { "label": "Kept for", "option": { "channel": "The channel", "viewer": "This viewer" } },
      "name": { "label": "Name", "placeholder": "deaths" },
      "op": {
        "label": "Is",
        "option": {
          "eq": "equal to",
          "ne": "not equal to",
          "gt": "more than",
          "gte": "at least",
          "lt": "less than",
          "lte": "at most",
          "contains": "containing",
          "exists": "set to anything"
        }
      },
      "value": { "label": "Value", "placeholder": "10" }
    },
    "out": { "yes": "Yes", "no": "No" }
  }
}
