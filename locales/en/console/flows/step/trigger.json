{
  "chatCommand": {
    "label": "Chat command",
    "summary": "Someone types a command in chat",
    "field": {
      "trigger": { "label": "Command", "placeholder": "!hug" },
      "aliases": { "label": "Other names", "placeholder": "!cuddle, !squeeze" },
      "match": {
        "label": "Match",
        "option": { "start": "Starts the message", "exact": "Whole message" }
      },
      "caseSensitive": { "label": "Match case" },
      "subMessages": { "label": "Also in resub messages" }
    }
  },
  "chatWord": {
    "label": "Chat word",
    "summary": "Someone says a word in chat",
    "field": {
      "word": {
        "label": "Word",
        "placeholder": "bagel",
        "pattern": { "label": "Pattern", "placeholder": "\\bbagel(s)?\\b" }
      },
      "match": {
        "label": "Match",
        "option": { "word": "Whole word", "anywhere": "Anywhere", "pattern": "Pattern" }
      },
      "caseSensitive": { "label": "Match case" },
      "subMessages": { "label": "Also in resub messages" }
    }
  },
  "follow": {
    "label": "New follower",
    "summary": "Someone follows the channel"
  },
  "sub": {
    "label": "Subscription",
    "summary": "New sub, resub or gift",
    "field": {
      "variant": {
        "label": "Kind",
        "option": { "any": "New or gifted", "new": "New, paid", "resub": "Resub", "gifted": "Gifted to them" }
      },
      "tier": {
        "label": "Tier",
        "option": { "1000": "Tier 1", "2000": "Tier 2", "3000": "Tier 3", "any": "Any tier" }
      },
      "minMonths": { "label": "Minimum months", "unit": "months" },
      "minStreak": { "label": "Minimum streak", "unit": "months" }
    }
  },
  "subGift": {
    "label": "Gift subs",
    "summary": "Someone gifts subs to the community",
    "field": {
      "minGifts": { "label": "Minimum gifts", "unit": "subs" },
      "tier": {
        "label": "Tier",
        "option": { "1000": "Tier 1", "2000": "Tier 2", "3000": "Tier 3", "any": "Any tier" }
      },
      "gifter": {
        "label": "Gifter",
        "option": { "anyone": "Anyone", "named": "Named only", "anonymous": "Anonymous only" }
      }
    }
  },
  "cheer": {
    "label": "Cheer",
    "summary": "Bits are cheered",
    "field": {
      "minBits": { "label": "Minimum bits", "unit": "bits" },
      "cheerer": {
        "label": "Cheerer",
        "option": { "anyone": "Anyone", "named": "Named only", "anonymous": "Anonymous only" }
      }
    }
  },
  "raid": {
    "label": "Raid",
    "summary": "Another channel raids you",
    "field": {
      "minViewers": { "label": "Minimum viewers", "unit": "viewers" }
    }
  },
  "reward": {
    "label": "Channel point reward",
    "summary": "A reward is redeemed",
    "field": {
      "reward": { "label": "Reward" }
    }
  },
  "streamOnline": {
    "label": "Stream goes live",
    "summary": "Your stream starts"
  },
    "countdownFinished": {
    "label": "Countdown finished",
    "summary": "A named countdown reaches zero",
    "line": "When {name} reaches zero",
    "field": {
      "name": {
        "label": "Countdown"
      }
    }
  },
  "adBreak": {
    "label": "Ad break starts",
    "summary": "An ad break begins on your stream",
    "field": {
      "startedBy": {
        "label": "Started by",
        "option": { "any": "Any", "automatic": "Automatic", "manual": "Manual" }
      },
      "minLength": { "label": "Minimum length", "range": "Use 30 seconds to 3 minutes." }
    }
  },
  "channelUpdate": {
    "label": "Title or category changes",
    "summary": "Your stream title or category changes",
    "field": {
      "category": { "label": "Category", "placeholder": "Just Chatting", "hint": "Leave blank to match any category." }
    }
  },
  "timer": {
    "label": "Every few minutes",
    "summary": "Runs on a repeating timer",
    "field": {
      "every": { "label": "Every", "range": "Use 1 minute to 24 hours." },
      "jitter": { "label": "Random extra", "range": "Use 0 seconds to 1 hour." },
      "chatLines": { "label": "Chat lines since last run", "hint": "Use 0 to run regardless of chat activity." },
      "offline": { "label": "Also while offline" }
    }
  },
  "manual": {
    "label": "Run by hand",
    "summary": "Runs from the Run now button or another tool by this recipe's name"
  },
  "unbanRequest": {
    "label": "Unban request",
    "summary": "A viewer asks to be unbanned"
  }
}
