      "add": "{who} zum Moderator machen",
      "remove": "{who} aus dem Moderatorenteam entfernen"
    },
    "field": {
      "change": {
        "label": "Änderung",
        "option": { "add": "Hinzufügen", "remove": "Entfernen" }
      }
    }
  },
  "vip": {
    "label": "VIP-Rolle",
    "summary": "Einen VIP hinzufügen oder entfernen",
    "line": {
      "add": "{who} zum VIP machen",
      "remove": "{who} aus der VIP-Liste entfernen"
    },
    "field": {
      "change": {
        "label": "Änderung",
        "option": { "add": "Hinzufügen", "remove": "Entfernen" }
      }
    }
  },
  "clearChat": {
    "label": "Chat leeren",
    "summary": "Alle Nachrichten aus dem Chat entfernen",
