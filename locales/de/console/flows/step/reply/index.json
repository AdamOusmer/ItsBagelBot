{
  "chat": {
    "label": "Nachricht senden",
    "summary": "Eine Nachricht im Chat posten",
    "field": {
      "message": {
        "label": "Nachricht",
        "placeholder": "Danke {user}!"
      }
    }
  },
  "points": {
    "label": "Punkte ändern",
    "summary": "Punkte hinzufügen oder abziehen",
    "field": {
      "amount": {
        "label": "Menge",
        "unit": "Punkte"
      },
      "change": { "label": "Änderung", "option": { "add": "Hinzufügen", "take": "Abziehen" } }
    },
    "line": { "add": "Gib {amount}", "take": "Ziehe {amount} ab" }
  },
  "counter": {
    "label": "Zähler ändern",
    "summary": "Einen benannten Zähler erhöhen, verringern oder setzen",
    "field": {
      "counter": {
        "label": "Zähler"
      },
      "change": { "label": "Änderung", "option": { "add": "Hinzufügen", "set": "Setzen" } },
      "amount": { "label": "Menge", "hint": "Gib zum Abziehen eine negative Zahl ein" },
      "value": { "label": "Wert" }
    },
    "line": { "add": "{counter} um {amount} erhöhen", "take": "{counter} um {amount} verringern", "set": "{counter} auf {value} setzen" }
  },
  "lights": {
    "label": "Lichter einstellen",
    "summary": "Farbe, Szene, Weiß oder Ein und Aus für Govee-Lichter",
    "field": {
      "device": {
        "label": "Licht"
      },
      "mode": {
        "label": "Einstellen",
        "option": {
          "color": "Farbe",
          "scene": "Szene",
          "white": "Weiß",
          "on": "Ein",
          "off": "Aus"
        }
      },
      "color": {
        "label": "Farbe"
      },
      "scene": {
        "label": "Szene",
        "hint": "Verwendet die Szenenliste des ersten Lichts."
      },
      "liveOnly": {
        "label": "Nur während des Streams"
      },
      "kelvin": {
        "label": "Farbtemperatur"
      },
      "brightness": {
        "label": "Helligkeit",
        "placeholder": "Beibehalten",
        "unit": "%"
      },
      "holdS": {
        "label": "Zurück nach",
        "hint": "Die Lichter kehren zu ihrem vorherigen Zustand zurück. Bei Szenen wird die letzte Farbe wiederhergestellt.",
        "range": "Wähle 0 bis {max} Sekunden."
      }
    },
    "noColors": "Dieses Licht unterstützt keine Farben",
    "noWarmth": "Dieses Licht hat kein einstellbares Weiß",
    "noLights": "Keine steuerbaren Govee-Lichter gefunden.",
    "noLightsBody": "Füge deinem Govee-Konto in der Govee-App ein Licht hinzu."
  },
  "wait": {
    "label": "Warten",
    "summary": "Pause vor dem nächsten Schritt",
    "field": {
      "seconds": {
        "label": "Wartezeit",
        "unit": "Sekunden, max. {max}",
        "hint": "Alle Wartezeiten pro Durchlauf ergeben zusammen höchstens 60 Sekunden."
      }
    }
  },
  "loop": {
    "label": "Schritte wiederholen",
    "summary": "Einen Pfad bis zu 100-mal ausführen",
    "field": {
      "times": {
        "label": "Wie oft",
        "placeholder": "3",
        "hint": "1 bis 100. Eine Variable wie {args} geht auch."
      }
    },
    "out": {
      "body": "Jedes Mal",
      "done": "Wenn fertig"
    }
  },
  "varSet": {
    "label": "Variable setzen",
    "summary": "Einen Wert für später speichern",
    "field": {
      "scope": {
        "label": "Gespeichert für",
        "option": {
          "channel": "Der Kanal",
          "viewer": "Dieser Zuschauer"
        }
      },
      "name": {
        "label": "Name",
        "placeholder": "tode"
      },
      "value": {
        "label": "Wert",
        "placeholder": "{user}"
      }
    }
  },
  "varAdd": {
    "label": "Zu Variable hinzufügen",
    "summary": "Hoch- oder herunterzählen",
    "field": {
      "scope": {
        "label": "Gespeichert für",
        "option": {
          "channel": "Der Kanal",
          "viewer": "Dieser Zuschauer"
        }
      },
      "name": {
        "label": "Name",
        "placeholder": "tode"
      },
      "amount": {
        "label": "Menge"
      }
    }
  },
  "varDelete": {
    "label": "Variable löschen",
    "summary": "Einen Wert vergessen",
    "field": {
      "scope": {
        "label": "Gespeichert für",
        "option": {
          "channel": "Der Kanal",
          "viewer": "Dieser Zuschauer"
        }
      },
      "name": {
        "label": "Name",
        "placeholder": "tode"
      }
    }
  },
  "math": {
    "label": "Berechnen",
    "summary": "Eine Zahl berechnen",
    "field": {
      "expression": {
        "label": "Ausdruck",
        "placeholder": "random(1, 6) * 10",
        "hint": "Verwende + - * / % ^ sowie round, floor, ceil, abs, min, max und random(a, b)."
      },
      "saveAs": {
        "label": "Speichern als",
        "placeholder": "summe"
      }
    }
  },
  "cooldownAdd": {
    "label": "Zeit zu einem Cooldown hinzufügen",
    "summary": "Einen benannten Timer verlängern, während er läuft",
    "line": "{name} um {seconds} verlängern",
    "field": {
      "name": {
        "label": "Timer"
      },
      "seconds": {
        "label": "Hinzufügen",
        "range": "Verwende 1 Sekunde bis {days} Tage."
      },
      "per": {
        "label": "Für je",
        "hint": "Nur bei Cheers und geschenkten Abos. Leer lassen, um einmal Zeit hinzuzufügen."
      }
    }
  },
  "countdownAdd": {
    "label": "Zeit zum Countdown hinzufügen",
    "summary": "Einen laufenden Countdown verlängern",
    "line": "{name} um {seconds} verlängern",
    "field": {
      "name": {
        "label": "Countdown"
      },
      "seconds": {
        "label": "Hinzufügen",
        "range": "1 Sekunde bis {days} Tage eingeben."
      },
      "per": {
        "label": "Für je",
        "hint": "Nur bei Cheers und geschenkten Abos. Leer lassen, um einmal Zeit hinzuzufügen."
      }
    }
  },
  "poll": {
    "label": "Umfrage starten",
    "summary": "Zuschauer über eine Frage abstimmen lassen",
    "line": "Umfrage: {title}",
    "field": {
      "title": {
        "label": "Titel"
      },
      "choices": {
        "label": "Antworten (eine pro Zeile)"
      },
      "seconds": {
        "label": "Dauer (Sekunden)"
      },
      "extraVotes": {
        "label": "Zusatzstimmen mit Kanalpunkten"
      },
      "pointsPerVote": {
        "label": "Punkte pro Stimme"
      }
    }
  },
  "pollEnd": {
    "label": "Umfrage beenden",
    "summary": "Abstimmung stoppen oder Ergebnisse archivieren",
    "line": {
      "terminate": "Umfrage beenden und Ergebnisse anzeigen",
      "archive": "Umfrage beenden und Ergebnisse ausblenden"
    },
    "field": {
      "status": {
        "label": "Aktion",
        "option": {
          "terminate": "Beenden und Ergebnisse anzeigen",
          "archive": "Beenden und Ergebnisse ausblenden"
        }
      }
    }
  },
  "prediction": {
    "label": "Vorhersage starten",
    "summary": "Zuschauer mit Punkten auf ein Ergebnis wetten lassen",
    "line": "Vorhersage: {title}",
    "field": {
      "title": {
        "label": "Titel"
      },
      "outcomes": {
        "label": "Ergebnisse (eines pro Zeile)"
      },
      "seconds": {
        "label": "Dauer (Sekunden)"
      }
    }
  },
  "predictionEnd": {
    "label": "Vorhersage beenden",
    "summary": "Wetten sperren, Punkte erstatten oder Gewinner wählen",
    "line": {
      "lock": "Wetten schließen",
      "cancel": "Abbrechen und Punkte erstatten",
      "resolve": "Gewinner: {outcome}"
    },
    "field": {
      "status": {
        "label": "Aktion",
        "option": {
          "lock": "Wetten schließen",
          "cancel": "Abbrechen und Punkte erstatten",
          "resolve": "Gewinner auswählen"
        }
      },
      "outcome": {
        "label": "Gewinnergebnis",
        "hint": "Eine Zahl oder der Name des Ergebnisses"
      }
    }
  },
  "raidStart": {
    "label": "Raid starten",
    "summary": "Deine Zuschauer zu einem anderen Kanal schicken",
    "line": "Raid zu {target} starten",
    "field": {
      "target": {
        "label": "Kanal für den Raid",
        "placeholder": "Kanalname"
      }
    }
  },
  "raidCancel": {
    "label": "Raid abbrechen",
    "summary": "Den Raid vor dem Kanalwechsel stoppen"
  },
  "mod": {
    "label": "Moderatorrolle",
    "summary": "Einen Moderator hinzufügen oder entfernen",
    "line": {
      "add": "{who} zum Moderator machen",
      "remove": "{who} aus dem Moderatorenteam entfernen"
    },
    "field": {
      "change": {
        "label": "Änderung",
        "option": { "add": "Hinzufügen", "remove": "Entfernen" }
      }
    }
  },
  "vip": {
    "label": "VIP-Rolle",
    "summary": "Einen VIP hinzufügen oder entfernen",
    "line": {
      "add": "{who} zum VIP machen",
      "remove": "{who} aus der VIP-Liste entfernen"
    },
    "field": {
      "change": {
        "label": "Änderung",
        "option": { "add": "Hinzufügen", "remove": "Entfernen" }
      }
    }
  },
  "clearChat": {
    "label": "Chat leeren",
    "summary": "Alle Nachrichten aus dem Chat entfernen",
    "line": "Gesamten Chat leeren"
  },
  "adSnooze": {
    "label": "Nächste Werbung verschieben",
    "summary": "Die nächste Werbepause später starten"
  },
  "whisper": {
    "label": "Flüsternachricht senden",
    "summary": "Einem Zuschauer eine private Nachricht schicken",
    "line": "Flüstern an {target}: {text}",
    "field": {
      "target": {
        "label": "Kanal- oder Zuschauername"
      },
      "text": {
        "label": "Nachricht",
        "hint": "Wird vom Bot-Konto gesendet."
      }
    }
  },
  "unbanResolve": {
    "label": "Entsperrantrag beantworten",
    "summary": "Einen Einspruch annehmen oder ablehnen",
    "line": {
      "approve": "Den Entsperrantrag genehmigen",
      "deny": "Den Entsperrantrag ablehnen"
    },
    "field": {
      "status": {
        "label": "Antwort",
        "option": {
          "approve": "Genehmigen",
          "deny": "Ablehnen"
        }
      },
      "resolution": {
        "label": "Nachricht an den Zuschauer (optional)"
      }
    }
  },
  "stop": {
    "label": "Hier beenden",
    "summary": "Den Durchlauf hier beenden",
    "keywords": "ende abbrechen verlassen stoppen",
    "line": "Den Durchlauf hier beenden",
    "note": "In parallelen Pfaden wird nur dieser Pfad beendet."
  },
  "random": {
    "label": "Zufälligen Pfad wählen",
    "summary": "Einen Pfad nach den eingestellten Chancen wählen",
    "keywords": "würfel zufall mischen gewichtet",
    "path": "Pfad {path}",
    "pathPercent": "{label} ({percent} %)",
    "field": {
      "paths": {
        "label": "Pfade",
        "option": {
          "2": "2",
          "3": "3",
          "4": "4",
          "5": "5"
        }
      },
      "weight1": {
        "label": "Chance für Pfad 1",
        "unit": "Teile"
      },
      "weight2": {
        "label": "Chance für Pfad 2",
        "unit": "Teile"
      },
      "weight3": {
        "label": "Chance für Pfad 3",
        "unit": "Teile"
      },
      "weight4": {
        "label": "Chance für Pfad 4",
        "unit": "Teile"
      },
      "weight5": {
        "label": "Chance für Pfad 5",
        "unit": "Teile"
      }
    }
  },
  "run": {
    "label": "Anderes Rezept ausführen",
    "summary": "Ein anderes Rezept in diesem Kanal starten",
    "keywords": "aufrufen auslösen verketten",
    "line": "{name} ausführen",
    "note": "Rezepte können bis zu 2 Ebenen tief aufgerufen werden.",
    "field": {
      "automationId": {
        "label": "Rezept",
        "hint": "Die eigenen Prüfungen gelten weiterhin. Das andere Rezept startet mit den Werten dieses Rezepts. Seine Änderungen bleiben auf dieses Rezept beschränkt."
      }
    }
  },
  "redemption": {
    "label": "Einlösung abschließen",
    "summary": "Eine Prämieneinlösung erfüllen oder die Punkte erstatten",
    "field": {
      "result": {
        "label": "Ergebnis"
      }
    },
    "line": {
      "fulfill": "Als erfüllt markieren",
      "cancel": "Punkte zurückgeben"
    }
  },
  "pointsSpend": {
    "label": "Punkte ausgeben",
    "summary": "Ziehe Punkte ab, wenn der Zuschauer genug hat",
    "line": "{amount} ausgeben",
    "field": {
      "amount": {
        "label": "Menge",
        "unit": "Punkte"
      }
    },
    "out": {
      "enough": "Genug",
      "notEnough": "Nicht genug"
    }
  },
  "countdownStop": {
    "label": "Countdown stoppen",
    "summary": "Beende einen laufenden Countdown vorzeitig",
    "line": "{name} stoppen",
    "field": {
      "name": {
        "label": "Countdown"
      }
    }
  },
  "cooldownReset": {
    "label": "Cooldown zurücksetzen",
    "summary": "Hebe die Wartezeit für einen benannten Cooldown auf",
