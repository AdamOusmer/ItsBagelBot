{
  "chat": {
    "label": "Nachricht senden",
    "summary": "Eine Nachricht im Chat posten",
    "field": {
      "message": {
        "label": "Nachricht",
        "placeholder": "Danke {user}!"
      }
    }
  },
  "points": {
    "label": "Treuepunkte vergeben",
    "summary": "Punkte hinzufügen oder abziehen",
    "field": {
      "amount": {
        "label": "Menge",
        "unit": "Punkte"
      }
    }
  },
  "counter": {
    "label": "Zähler erhöhen",
    "summary": "Einen Zähler erhöhen",
    "field": {
      "counter": {
        "label": "Zähler"
      }
    }
  },
  "lights": {
    "label": "Lichter einstellen",
    "summary": "Farbe, Szene, Weiß oder Ein und Aus für Govee-Lichter",
    "field": {
      "device": {
        "label": "Licht"
      },
      "mode": {
        "label": "Einstellen",
        "option": {
          "color": "Farbe",
          "scene": "Szene",
          "white": "Weiß",
          "on": "Ein",
          "off": "Aus"
        }
      },
      "color": {
        "label": "Farbe"
      },
      "scene": {
        "label": "Szene",
        "hint": "Verwendet die Szenenliste des ersten Lichts."
      },
      "liveOnly": {
        "label": "Nur während des Streams"
      },
      "kelvin": {
        "label": "Farbtemperatur"
      },
      "brightness": {
        "label": "Helligkeit",
        "placeholder": "Beibehalten",
        "unit": "%"
      },
      "holdS": {
        "label": "Zurück nach",
        "hint": "Die Lichter kehren zu ihrem vorherigen Zustand zurück. Bei Szenen wird die letzte Farbe wiederhergestellt.",
        "range": "Wähle 0 bis {max} Sekunden."
      }
    },
    "noColors": "Dieses Licht unterstützt keine Farben",
    "noWarmth": "Dieses Licht hat kein einstellbares Weiß",
    "noLights": "Keine steuerbaren Govee-Lichter gefunden.",
    "noLightsBody": "Füge deinem Govee-Konto in der Govee-App ein Licht hinzu."
  },
  "wait": {
    "label": "Warten",
    "summary": "Pause vor dem nächsten Schritt",
    "field": {
      "seconds": {
        "label": "Verzögerung",
        "unit": "Sekunden, max. {max}"
      }
    }
  },
  "loop": {
    "label": "Schritte wiederholen",
    "summary": "Einen Pfad bis zu 100-mal ausführen",
    "field": {
      "times": {
        "label": "Wie oft",
        "placeholder": "3"
      }
    },
    "out": {
      "body": "Jedes Mal",
      "done": "Wenn fertig"
    }
  },
  "varSet": {
    "label": "Variable setzen",
    "summary": "Einen Wert für später speichern",
    "field": {
      "scope": {
        "label": "Gespeichert für",
        "option": {
          "channel": "Der Kanal",
          "viewer": "Dieser Zuschauer"
        }
      },
      "name": {
        "label": "Name",
        "placeholder": "tode"
      },
      "value": {
        "label": "Wert",
        "placeholder": "{user}"
      }
    }
  },
  "varAdd": {
    "label": "Zu Variable hinzufügen",
    "summary": "Hoch- oder herunterzählen",
    "field": {
      "scope": {
        "label": "Gespeichert für",
        "option": {
          "channel": "Der Kanal",
          "viewer": "Dieser Zuschauer"
        }
      },
      "name": {
        "label": "Name",
        "placeholder": "tode"
      },
      "amount": {
        "label": "Menge"
      }
    }
  },
  "varDelete": {
    "label": "Variable löschen",
    "summary": "Einen Wert vergessen",
    "field": {
      "scope": {
        "label": "Gespeichert für",
        "option": {
          "channel": "Der Kanal",
          "viewer": "Dieser Zuschauer"
        }
      },
      "name": {
        "label": "Name",
        "placeholder": "tode"
      }
    }
  },
  "math": {
    "label": "Berechnen",
    "summary": "Eine Zahl berechnen",
    "field": {
      "expression": {
        "label": "Ausdruck",
        "placeholder": "({bits} / 100) + 1"
      },
      "saveAs": {
        "label": "Speichern als",
        "placeholder": "summe"
      }
    }
  },
  "cooldownAdd": {
    "label": "Zeit zu einem Cooldown hinzufügen",
    "summary": "Einen benannten Timer verlängern, während er läuft",
    "line": "{name} um {seconds} verlängern",
    "field": {
      "name": {
        "label": "Timer"
      },
      "seconds": {
        "label": "Hinzufügen",
        "range": "Verwende 1 Sekunde bis {days} Tage."
      },
      "per": {
        "label": "Pro",
        "hint": "Fügt die Zeit oben für jeden vollen Betrag hinzu. Trage in einem Bits-Rezept 100 ein, um je 100 Bits zu zählen. Leer lassen, um sie einmal pro Ereignis hinzuzufügen."
      }
    }
  },
  "countdownAdd": {
    "label": "Zeit zum Countdown hinzufügen",
    "summary": "Einen laufenden Countdown verlängern",
    "line": "{name} um {seconds} verlängern",
    "field": {
      "name": {
        "label": "Countdown"
      },
      "seconds": {
        "label": "Hinzufügen",
        "range": "1 Sekunde bis {days} Tage eingeben."
      },
      "per": {
        "label": "Pro",
        "hint": "Diese Zeit für jeden vollen Betrag hinzufügen. Leer lassen, um sie einmal pro Ereignis hinzuzufügen."
      }
    }
  },
  "poll": {
    "label": "Umfrage starten",
    "summary": "Zuschauer über eine Frage abstimmen lassen",
    "line": "Umfrage: {title}",
    "field": {
      "title": {
        "label": "Titel"
      },
      "choices": {
        "label": "Antworten (eine pro Zeile)"
      },
      "seconds": {
        "label": "Dauer (Sekunden)"
      },
      "extraVotes": {
        "label": "Zusatzstimmen mit Kanalpunkten"
      },
      "pointsPerVote": {
        "label": "Punkte pro Stimme"
      }
    }
  },
  "pollEnd": {
    "label": "Umfrage beenden",
    "summary": "Abstimmung stoppen oder Ergebnisse archivieren",
    "line": {
      "terminate": "Umfrage beenden und Ergebnisse anzeigen",
      "archive": "Umfrage beenden und Ergebnisse ausblenden"
    },
    "field": {
      "status": {
        "label": "Aktion",
        "option": {
          "terminate": "Beenden und Ergebnisse anzeigen",
          "archive": "Beenden und Ergebnisse ausblenden"
        }
      }
    }
  },
  "prediction": {
    "label": "Vorhersage starten",
    "summary": "Zuschauer mit Punkten auf ein Ergebnis wetten lassen",
    "line": "Vorhersage: {title}",
    "field": {
      "title": {
        "label": "Titel"
      },
      "outcomes": {
        "label": "Ergebnisse (eines pro Zeile)"
      },
      "seconds": {
        "label": "Dauer (Sekunden)"
      }
    }
  },
  "predictionEnd": {
    "label": "Vorhersage beenden",
    "summary": "Wetten sperren, Punkte erstatten oder Gewinner wählen",
    "line": {
      "lock": "Wetten schließen",
      "cancel": "Abbrechen und Punkte erstatten",
      "resolve": "Gewinner: {outcome}"
    },
    "field": {
      "status": {
        "label": "Aktion",
        "option": {
          "lock": "Wetten schließen",
          "cancel": "Abbrechen und Punkte erstatten",
          "resolve": "Gewinner auswählen"
        }
      },
      "outcome": {
        "label": "Gewinnergebnis",
        "hint": "Eine Zahl oder der Name des Ergebnisses"
      }
    }
  },
  "raidStart": {
    "label": "Raid starten",
    "summary": "Deine Zuschauer zu einem anderen Kanal schicken",
    "line": "Raid zu {target} starten",
    "field": {
      "target": {
        "label": "Kanal für den Raid",
        "placeholder": "Kanalname"
      }
    }
  },
  "raidCancel": {
    "label": "Raid abbrechen",
    "summary": "Den Raid vor dem Kanalwechsel stoppen"
  },
  "mod": {
    "label": "Moderatorrolle",
    "summary": "Einen Moderator hinzufügen oder entfernen",
