{
  "chat": {
    "label": "Chatnachricht senden",
    "summary": "Bot antwortet im Chat",
    "field": {
      "message": {
        "label": "Nachricht",
        "placeholder": "Danke {user}!"
      }
    }
  },
  "points": {
    "label": "Treuepunkte vergeben",
    "summary": "Punkte hinzufügen oder abziehen",
    "field": {
      "amount": {
        "label": "Menge",
        "unit": "Punkte"
      }
    }
  },
  "counter": {
    "label": "Zähler erhöhen",
    "summary": "Einen Zähler erhöhen",
    "field": {
      "counter": {
        "label": "Zähler"
      }
    }
  },
  "lights": {
    "label": "Lichter einstellen",
    "summary": "Eine Govee-Farbe oder -Szene einstellen",
    "field": {
      "device": {
        "label": "Licht"
      },
      "mode": {
        "label": "Einstellen",
        "option": {
          "color": "Farbe",
          "scene": "Szene"
        }
      },
      "color": {
        "label": "Farbe"
      },
      "scene": {
        "label": "Szene"
      },
      "liveOnly": {
        "label": "Nur während des Streams"
      }
    }
  },
  "wait": {
    "label": "Warten",
    "summary": "Pause vor dem nächsten Schritt",
    "field": {
      "seconds": {
        "label": "Wartezeit",
        "unit": "Sekunden, max. {max}",
        "hint": "Alle Wartezeiten pro Durchlauf ergeben zusammen höchstens 60 Sekunden."
      }
    }
  },
  "loop": {
    "label": "Schritte wiederholen",
    "summary": "Einen Pfad bis zu 100-mal ausführen",
    "field": {
      "times": {
        "label": "Wie oft",
        "placeholder": "3",
        "hint": "1 bis 100. Eine Variable wie {args} geht auch."
      }
    },
    "out": {
      "body": "Jedes Mal",
      "done": "Wenn fertig"
    }
  },
  "varSet": {
    "label": "Variable setzen",
    "summary": "Einen Wert für später speichern",
    "field": {
      "scope": {
        "label": "Gespeichert für",
        "option": {
          "channel": "Der Kanal",
          "viewer": "Dieser Zuschauer"
        }
      },
      "name": {
        "label": "Name",
        "placeholder": "tode"
      },
      "value": {
        "label": "Wert",
        "placeholder": "{user}"
      }
    }
  },
  "varAdd": {
    "label": "Zu Variable hinzufügen",
    "summary": "Hoch- oder herunterzählen",
    "field": {
      "scope": {
        "label": "Gespeichert für",
        "option": {
          "channel": "Der Kanal",
          "viewer": "Dieser Zuschauer"
        }
      },
      "name": {
        "label": "Name",
        "placeholder": "tode"
      },
      "amount": {
        "label": "Menge"
      }
    }
  },
  "varDelete": {
    "label": "Variable löschen",
    "summary": "Einen Wert vergessen",
    "field": {
      "scope": {
        "label": "Gespeichert für",
        "option": {
          "channel": "Der Kanal",
          "viewer": "Dieser Zuschauer"
        }
      },
      "name": {
        "label": "Name",
        "placeholder": "tode"
      }
    }
  },
  "math": {
    "label": "Berechnen",
    "summary": "Eine Zahl berechnen",
    "field": {
      "expression": {
        "label": "Ausdruck",
        "placeholder": "random(1, 6) * 10",
        "hint": "Verwende + - * / % ^ sowie round, floor, ceil, abs, min, max und random(a, b)."
      },
      "saveAs": {
        "label": "Speichern als",
        "placeholder": "summe"
      }
    }
  },
  "cooldownAdd": {
    "label": "Zeit zu einem Cooldown hinzufügen",
    "summary": "Einen benannten Timer verlängern, während er läuft",
    "line": "{name} um {seconds} verlängern",
    "field": {
      "name": {
        "label": "Timer"
      },
      "seconds": {
        "label": "Hinzufügen",
        "range": "Verwende 1 Sekunde bis {days} Tage."
      },
      "per": {
        "label": "Pro",
        "hint": "Fügt die Zeit oben für jeden vollen Betrag hinzu. Trage in einem Bits-Rezept 100 ein, um je 100 Bits zu zählen. Leer lassen, um sie einmal pro Ereignis hinzuzufügen."
      }
    }
  },
  "countdownAdd": {
    "label": "Zeit zum Countdown hinzufügen",
    "summary": "Einen laufenden Countdown verlängern",
    "line": "{name} um {seconds} verlängern",
    "field": {
      "name": {
        "label": "Countdown"
      },
      "seconds": {
        "label": "Hinzufügen",
        "range": "1 Sekunde bis {days} Tage eingeben."
      },
      "per": {
        "label": "Pro",
        "hint": "Diese Zeit für jeden vollen Betrag hinzufügen. Leer lassen, um sie einmal pro Ereignis hinzuzufügen."
      }
    }
  },
  "poll": {
    "label": "Umfrage starten",
    "summary": "Zuschauer über eine Frage abstimmen lassen",
    "line": "Umfrage: {title}",
    "field": {
      "title": {
        "label": "Titel"
      },
      "choices": {
        "label": "Antworten (eine pro Zeile)"
      },
      "seconds": {
        "label": "Dauer (Sekunden)"
      }
    }
  },
  "pollEnd": {
    "label": "Umfrage beenden",
    "summary": "Abstimmung stoppen oder Ergebnisse archivieren",
    "line": {
      "terminate": "Umfrage beenden und Ergebnisse anzeigen",
      "archive": "Umfrage archivieren"
    },
    "field": {
      "status": {
        "label": "Aktion",
        "option": {
          "terminate": "Abstimmung stoppen",
          "archive": "Archivieren"
        }
      }
    }
  },
  "prediction": {
    "label": "Vorhersage starten",
    "summary": "Zuschauer mit Punkten auf ein Ergebnis wetten lassen",
    "line": "Vorhersage: {title}",
    "field": {
      "title": {
        "label": "Titel"
      },
      "outcomes": {
        "label": "Ergebnisse (eines pro Zeile)"
      },
      "seconds": {
        "label": "Dauer (Sekunden)"
      }
    }
  },
  "predictionEnd": {
    "label": "Vorhersage beenden",
    "summary": "Wetten sperren, Punkte erstatten oder Gewinner wählen",
    "line": {
      "lock": "Wetten sperren",
      "cancel": "Abbrechen und Punkte erstatten",
      "resolve": "Gewinnergebnis: {winner}"
    },
    "field": {
      "status": {
        "label": "Aktion",
        "option": {
          "lock": "Abstimmung sperren",
          "cancel": "Abbrechen und erstatten",
          "resolve": "Gewinner wählen"
        }
      },
      "winner": {
        "label": "Nummer des Gewinnergebnisses"
      }
    }
  },
  "raidStart": {
    "label": "Raid starten",
    "summary": "Deine Zuschauer zu einem anderen Kanal schicken",
    "line": "Raid zu {target} starten",
    "field": {
      "target": {
        "label": "Kanal- oder Zuschauername"
      }
    }
  },
  "raidCancel": {
    "label": "Raid abbrechen",
    "summary": "Den Raid vor dem Kanalwechsel stoppen"
  },
  "mod": {
    "label": "Moderatorrolle ändern",
    "summary": "Moderatorrechte geben oder entziehen",
    "line": {
      "on": "{target} zum Mod machen",
      "off": "{target} die Mod-Rechte entziehen"
    },
    "field": {
      "target": {
        "label": "Kanal- oder Zuschauername"
      },
      "on": {
        "label": "Aktiviert"
      }
    }
  },
  "vip": {
    "label": "VIP-Rolle ändern",
    "summary": "Einem Zuschauer das VIP-Abzeichen geben oder nehmen",
    "line": {
      "on": "{target} zum VIP machen",
      "off": "{target} den VIP-Status entziehen"
    },
    "field": {
      "target": {
        "label": "Kanal- oder Zuschauername"
      },
      "on": {
        "label": "Aktiviert"
      }
    }
  },
  "clearChat": {
    "label": "Chat leeren",
    "summary": "Alle Nachrichten aus dem Chat entfernen"
  },
  "adSnooze": {
    "label": "Nächste Werbung verschieben",
    "summary": "Die nächste Werbepause später starten"
  },
  "whisper": {
    "label": "Flüsternachricht senden",
    "summary": "Einem Zuschauer eine private Nachricht schicken",
    "line": "An {target} flüstern: {text}",
    "field": {
      "target": {
        "label": "Kanal- oder Zuschauername"
      },
      "text": {
        "label": "Nachricht"
      }
    }
  },
  "unbanResolve": {
    "label": "Entbannungsantrag bearbeiten",
    "summary": "Den Einspruch eines Zuschauers annehmen oder ablehnen",
    "field": {
      "status": {
        "label": "Aktion",
        "option": {
          "approve": "Genehmigen",
          "deny": "Ablehnen"
        }
      },
      "resolution": {
        "label": "Entscheidungsnachricht (optional)"
      }
    }
  },
  "brandedContent": {
    "label": "Markeninhalte kennzeichnen",
    "summary": "Den Hinweis auf bezahlte Werbung einblenden oder ausblenden",
    "field": {
      "on": {
        "label": "Aktiviert"
      }
    }
  },
  "stop": {
    "label": "Hier beenden",
    "summary": "Den Durchlauf hier beenden",
    "keywords": "ende abbrechen verlassen stoppen",
    "line": "Den Durchlauf hier beenden",
    "note": "In parallelen Pfaden wird nur dieser Pfad beendet."
  },
  "random": {
    "label": "Zufälligen Pfad wählen",
    "summary": "Einen Pfad nach den eingestellten Chancen wählen",
    "keywords": "würfel zufall mischen gewichtet",
    "path": "Pfad {path}",
    "pathPercent": "{label} ({percent} %)",
    "field": {
      "paths": {
        "label": "Pfade",
        "option": {
          "2": "2",
          "3": "3",
          "4": "4",
          "5": "5"
        }
      },
      "weight1": {
        "label": "Chance für Pfad 1",
        "unit": "Teile"
      },
      "weight2": {
        "label": "Chance für Pfad 2",
        "unit": "Teile"
      },
      "weight3": {
        "label": "Chance für Pfad 3",
        "unit": "Teile"
      },
      "weight4": {
        "label": "Chance für Pfad 4",
        "unit": "Teile"
      },
      "weight5": {
        "label": "Chance für Pfad 5",
        "unit": "Teile"
      }
    }
  },
  "run": {
    "label": "Anderes Rezept ausführen",
    "summary": "Ein anderes Rezept in diesem Kanal starten",
    "keywords": "aufrufen auslösen verketten",
    "line": "{name} ausführen",
    "note": "Rezepte können bis zu 2 Ebenen tief aufgerufen werden.",
    "field": {
      "automationId": {
        "label": "Rezept",
        "hint": "Die eigenen Prüfungen gelten weiterhin. Das andere Rezept startet mit den Werten dieses Rezepts. Seine Änderungen bleiben auf dieses Rezept beschränkt."
      }
    }
  }
}
