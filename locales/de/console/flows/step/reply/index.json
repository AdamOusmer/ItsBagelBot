    "label": "Berechnen",
    "summary": "Eine Zahl berechnen",
    "field": {
      "expression": {
        "label": "Ausdruck",
        "placeholder": "({bits} / 100) + 1"
      },
      "saveAs": {
        "label": "Speichern als",
        "placeholder": "summe"
      }
    }
  },
  "cooldownAdd": {
    "label": "Zeit zu einem Cooldown hinzufügen",
    "summary": "Einen benannten Timer verlängern, während er läuft",
    "field": {
      "name": {
        "label": "Timer"
      },
      "seconds": {
        "label": "Hinzufügen",
        "range": "Verwende 1 Sekunde bis {days} Tage."
      },
      "per": {
        "label": "Pro",
        "hint": "Fügt die Zeit oben für jeden vollen Betrag hinzu. Trage in einem Bits-Rezept 100 ein, um je 100 Bits zu zählen. Leer lassen, um sie einmal pro Ereignis hinzuzufügen."
      }
    }
  },
  "countdownAdd": {
    "label": "Zeit zum Countdown hinzufügen",
    "summary": "Einen laufenden Countdown verlängern",
