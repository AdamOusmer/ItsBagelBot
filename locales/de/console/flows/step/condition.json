{
  "op": {
    "eq": "ist gleich",
    "ne": "ist ungleich",
    "gt": "ist größer als",
    "gte": "ist mindestens",
    "lt": "ist kleiner als",
    "lte": "ist höchstens",
    "contains": "enthält",
    "starts": "beginnt mit",
    "exists": "ist auf einen beliebigen Wert gesetzt",
    "not_exists": "ist nicht gesetzt"
  },
  "role": {
    "label": "Nutzerlevel",
    "summary": "Rolle des Zuschauers prüfen",
    "warning": "Rollen sind nur bei Chat-Auslösern und Countdowns bekannt. Bei diesem Auslöser zählt jeder als Zuschauer.",
    "remove": "Prüfung entfernen, erlaubte Schritte behalten",
    "everyoneNote": "Alle bestehen diese Prüfung, deshalb blockiert sie nie.",
    "field": {
      "level": {
        "label": "Mindestens",
        "option": {
          "everyone": "Jeder",
          "sub": "Abonnent",
          "vip": "VIP",
          "mod": "Moderator",
          "lead_mod": "Hauptmoderator",
          "broadcaster": "Kanalinhaber"
        }
      }
    },
    "out": {
      "yes": "Erlaubt",
      "no": "Blockiert"
    }
  },
  "user": {
    "label": "Zuschauerliste",
    "summary": "Ausgewählte Zuschauer zulassen oder blockieren",
    "repick": "Erneut auswählen, um die ID zu speichern",
    "removeViewer": "{name} entfernen",
    "field": {
      "mode": { "label": "Modus", "option": { "only": "Nur diese Zuschauer", "except": "Alle außer diesen" } },
      "users": { "label": "Zuschauer", "placeholder": "itsbagelbot" }
    },
    "out": { "yes": "Zugelassen", "no": "Blockiert" }
  },
  "cooldown": {
    "label": "Abklingzeit",
    "summary": "Nur alle paar Sekunden ausführen",
    "field": {
      "channelSeconds": {
        "label": "Wartezeit für den Kanal",
        "range": "Verwende 0 Sekunden bis {days} Tage."
      },
      "viewerSeconds": {
        "label": "Wartezeit pro Zuschauer",
        "range": "Verwende 0 Sekunden bis {days} Tage."
      },
      "name": {
        "label": "Name",
        "placeholder": "subathon",
        "hint": "Schritte zum Hinzufügen von Zeit in jedem Rezept können eine benannte Abklingzeit verlängern. Gilt nur für die Kanalwartezeit."
      },
      "leftCommand": {
        "label": "Befehl für verbleibende Zeit",
        "placeholder": "!restzeit"
      },
      "leftReply": {
        "label": "Antwort während der Wartezeit",
        "placeholder": "{user}, noch {cooldown:left}, bevor du das wieder nutzen kannst."
      },
      "readyReply": {
        "label": "Antwort, wenn bereit",
        "placeholder": "{user}, das ist einsatzbereit."
      }
    },
    "out": {
      "yes": "Bereit",
      "no": "In Abklingzeit"
    }
  },
  "compare": {
    "label": "Wert vergleichen",
    "summary": "Zwei Zahlen oder Texte vergleichen",
    "field": {
      "left": {
        "label": "Wert",
        "placeholder": "{bits}"
      },
      "op": {
        "label": "Ist",
        "option": {
          "gte": "mindestens",
          "lt": "kleiner als",
          "eq": "gleich",
          "contains": "enthält"
        }
      },
      "right": {
        "label": "Dieser Wert",
        "placeholder": "1000"
      },
      "matchCase": { "label": "Groß-/Kleinschreibung beachten" }
    },
    "out": {
      "yes": "Ja",
      "no": "Nein"
    }
  },
  "chance": {
    "alwaysNote": "Besteht immer.",
    "label": "Zufallschance",
    "summary": "Nur manchmal durchlassen",
    "field": {
      "percent": {
        "label": "Chance",
        "unit": "%"
      }
    },
    "out": {
      "yes": "Treffer",
      "no": "Verfehlt"
    }
  },
  "var": {
    "label": "Variable prüfen",
    "summary": "Durchlassen, wenn ein gespeicherter Wert übereinstimmt",
    "field": {
      "scope": { "label": "Gespeichert für", "option": { "channel": "Der Kanal", "viewer": "Dieser Zuschauer" } },
      "name": { "label": "Name", "placeholder": "tode" },
      "op": {
        "label": "Ist",
        "option": {
          "eq": "gleich",
          "ne": "nicht gleich",
          "gt": "größer als",
          "gte": "mindestens",
          "lt": "kleiner als",
          "lte": "höchstens",
          "contains": "enthält",
          "exists": "auf irgendetwas gesetzt"
        }
      },
      "value": { "label": "Wert", "placeholder": "10" }
    },
    "out": { "yes": "Ja", "no": "Nein" }
  },
  "live": {
    "label": "Live oder offline",
    "summary": "Prüfen, ob dein Stream live ist",
    "field": { "state": { "label": "Stream ist", "option": { "live": "Live", "offline": "Offline" } } },
    "line": { "live": "Stream ist live", "offline": "Stream ist offline" },
    "out": { "yes": "Live", "no": "Offline" }
  },
  "category": {
    "label": "Spielkategorie",
    "summary": "Die auf deinem Kanal eingestellte Kategorie prüfen",
    "field": {
      "mode": { "label": "Modus", "option": { "allow": "Ist eine davon", "deny": "Ist keine davon" } },
      "games": { "label": "Spiele", "hint": "Verwendet die auf deinem Kanal eingestellte Kategorie, auch wenn du offline bist." }
    },
    "line": { "allow": "Spiel ist {games}", "deny": "Spiel ist nicht {games}" },
    "out": { "yes": "Passt", "no": "Anderes Spiel" }
  },
  "pattern": {
    "label": "Befehlstext passt",
    "summary": "Die Wörter nach einem Chatbefehl prüfen",
    "field": { "pattern": { "label": "Muster", "hint": "Ein Muster für die Wörter nach dem Befehl, zum Beispiel ^[0-9]+$." } },
    "line": "Befehlstext passt zu {pattern}",
    "out": { "yes": "Passt", "no": "Passt nicht" }
  },
  "follow": {
    "label": "Folgt dir",
    "summary": "Prüfen, wie lange dir der Zuschauer schon folgt",
    "field": { "minDays": { "label": "Seit mindestens", "unit": "Tagen" } },
    "line": "Folgt dir seit mindestens {minDays} Tagen",
    "lineAny": "Folgt dir",
    "viewerNote": "Erkennt nur Zuschauer, die dieses Rezept starten.",
    "out": { "yes": "Folgt dir", "no": "Folgt dir nicht" }
  },
  "accountAge": {
    "label": "Kontoalter",
    "summary": "Das Alter des Twitch-Kontos des Zuschauers prüfen",
    "field": { "minDays": { "label": "Mindestens", "unit": "Tage" } },
    "line": "Konto ist mindestens {minDays} Tage alt",
    "out": { "yes": "Alt genug", "no": "Zu neu" }
  }
}
