{
  "role": {
    "label": "Nutzerlevel",
    "summary": "Rolle des Zuschauers prüfen",
    "warning": "Rollen sind nur bei Chat-Auslösern und Countdowns bekannt. Bei diesem Auslöser zählt jeder als Zuschauer.",
    "remove": "Diese Prüfung entfernen",
    "field": {
      "level": {
        "label": "Mindestens",
        "option": {
          "everyone": "Jeder",
          "sub": "Abonnent",
          "vip": "VIP",
          "mod": "Moderator",
          "lead_mod": "Hauptmoderator",
          "broadcaster": "Kanalinhaber"
        }
      }
    },
    "out": {
      "yes": "Erlaubt",
      "no": "Blockiert"
    }
  },
  "user": {
    "label": "Bestimmter Nutzer",
    "summary": "Nur diesen Zuschauer durchlassen",
    "field": {
      "login": {
        "label": "Benutzername",
        "placeholder": "itsbagelbot"
      }
    },
    "out": {
      "yes": "Dieser Nutzer",
      "no": "Alle anderen"
    }
  },
  "cooldown": {
    "label": "Abklingzeit",
    "summary": "Nur alle paar Sekunden ausführen",
    "field": {
      "seconds": {
        "label": "Abklingzeit",
        "range": "Verwende 1 Sekunde bis {days} Tage."
      },
      "perUser": {
        "label": "Pro Zuschauer"
      },
      "name": {
        "label": "Name",
        "placeholder": "subathon",
        "hint": "Eine Benennung startet ihn neu, falls er läuft. Schritte zum Hinzufügen von Zeit können ihn danach in jedem Rezept verlängern. Nicht verfügbar pro Zuschauer."
      },
      "leftCommand": {
        "label": "Befehl für verbleibende Zeit",
        "placeholder": "!restzeit"
      },
      "leftReply": {
        "label": "Antwort während der Wartezeit",
        "placeholder": "{user}, noch {cooldown:left}, bevor du das wieder nutzen kannst."
      },
      "readyReply": {
        "label": "Antwort, wenn bereit",
        "placeholder": "{user}, das ist einsatzbereit."
      }
    },
    "out": {
      "yes": "Bereit",
      "no": "In Abklingzeit"
    }
  },
  "compare": {
    "label": "Wert vergleichen",
    "summary": "Zwei Zahlen oder Texte vergleichen",
    "field": {
      "left": {
        "label": "Wert",
        "placeholder": "{bits}"
      },
      "op": {
        "label": "Ist",
        "option": {
          "gte": "mindestens",
          "lt": "kleiner als",
          "eq": "gleich",
          "contains": "enthält"
        }
      },
      "right": {
        "label": "Dieser Wert",
        "placeholder": "1000"
      }
    },
    "out": {
      "yes": "Ja",
      "no": "Nein"
    }
  },
  "chance": {
    "label": "Zufallschance",
    "summary": "Nur manchmal durchlassen",
    "field": {
      "percent": {
        "label": "Chance",
        "unit": "%"
      }
    },
    "out": {
      "yes": "Treffer",
      "no": "Verfehlt"
    }
  },
  "var": {
    "label": "Variable prüfen",
    "summary": "Durchlassen, wenn ein gespeicherter Wert übereinstimmt",
    "field": {
      "scope": { "label": "Gespeichert für", "option": { "channel": "Der Kanal", "viewer": "Dieser Zuschauer" } },
      "name": { "label": "Name", "placeholder": "tode" },
      "op": {
        "label": "Ist",
        "option": {
          "eq": "gleich",
          "ne": "nicht gleich",
          "gt": "größer als",
          "gte": "mindestens",
          "lt": "kleiner als",
          "lte": "höchstens",
          "contains": "enthält",
          "exists": "auf irgendetwas gesetzt"
        }
      },
      "value": { "label": "Wert", "placeholder": "10" }
    },
    "out": { "yes": "Ja", "no": "Nein" }
  },
  "points": {
    "label": "Punkte des Zuschauers",
    "summary": "Den Punktestand des auslösenden Zuschauers prüfen",
    "field": {
      "op": {
        "label": "Ist"
      },
      "value": {
        "label": "Punkte",
        "unit": "Punkte"
      }
    },
    "out": {
      "yes": "Ja",
      "no": "Nein"
    },
    "line": {
      "eq": "Der Zuschauer hat genau {value} Punkte",
      "ne": "Der Zuschauer hat eine andere Punktzahl als {value}",
      "gt": "Der Zuschauer hat mehr als {value} Punkte",
      "gte": "Der Zuschauer hat mindestens {value} Punkte",
      "lt": "Der Zuschauer hat weniger als {value} Punkte",
      "lte": "Der Zuschauer hat höchstens {value} Punkte"
    }
  },
  "counter": {
    "label": "Zählerwert",
    "summary": "Den aktuellen Wert eines benannten Zählers prüfen",
    "field": {
      "counter": {
        "label": "Zähler"
      },
      "op": {
        "label": "Ist"
      },
      "value": {
        "label": "Wert"
      }
    },
    "out": {
      "yes": "Ja",
      "no": "Nein"
    }
  }
}
