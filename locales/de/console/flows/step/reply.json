{
  "chat": {
    "label": "Chatnachricht senden",
    "summary": "Bot antwortet im Chat",
    "field": {
      "message": {
        "label": "Nachricht",
        "placeholder": "Danke {user}!"
      }
    }
  },
  "points": {
    "label": "Treuepunkte vergeben",
    "summary": "Punkte hinzufügen oder abziehen",
    "field": {
      "amount": {
        "label": "Menge",
        "unit": "Punkte"
      }
    }
  },
  "counter": {
    "label": "Zähler erhöhen",
    "summary": "Einen Zähler erhöhen",
    "field": {
      "counter": {
        "label": "Zähler"
      }
    }
  },
  "lights": {
    "label": "Lichter einstellen",
    "summary": "Eine Govee-Farbe oder -Szene einstellen",
    "field": {
      "device": {
        "label": "Licht"
      },
      "mode": {
        "label": "Einstellen",
        "option": {
          "color": "Farbe",
          "scene": "Szene"
        }
      },
      "color": {
        "label": "Farbe"
      },
      "scene": {
        "label": "Szene"
      }
    }
  },
  "wait": {
    "label": "Warten",
    "summary": "Pause vor dem nächsten Schritt",
    "field": {
      "seconds": {
        "label": "Verzögerung",
        "unit": "Sekunden, max. {max}"
      }
    }
  },
  "loop": {
    "label": "Schritte wiederholen",
    "summary": "Einen Pfad bis zu 100-mal ausführen",
    "field": {
      "times": { "label": "Wie oft", "placeholder": "3" }
    },
    "out": { "body": "Jedes Mal", "done": "Wenn fertig" }
  },
  "varSet": {
    "label": "Variable setzen",
    "summary": "Einen Wert für später speichern",
    "field": {
      "scope": { "label": "Gespeichert für", "option": { "channel": "Der Kanal", "viewer": "Dieser Zuschauer" } },
      "name": { "label": "Name", "placeholder": "tode" },
      "value": { "label": "Wert", "placeholder": "{user}" }
    }
  },
  "varAdd": {
    "label": "Zu Variable hinzufügen",
    "summary": "Hoch- oder herunterzählen",
    "field": {
      "scope": { "label": "Gespeichert für", "option": { "channel": "Der Kanal", "viewer": "Dieser Zuschauer" } },
      "name": { "label": "Name", "placeholder": "tode" },
      "amount": { "label": "Menge" }
    }
  },
  "varDelete": {
    "label": "Variable löschen",
    "summary": "Einen Wert vergessen",
    "field": {
      "scope": { "label": "Gespeichert für", "option": { "channel": "Der Kanal", "viewer": "Dieser Zuschauer" } },
      "name": { "label": "Name", "placeholder": "tode" }
    }
  },
  "text": {
    "label": "Text ändern",
    "summary": "Text bereinigen oder zerlegen",
    "field": {
      "op": {
        "label": "Was getan werden soll",
        "option": {
          "upper": "In Großbuchstaben umwandeln",
          "lower": "In Kleinbuchstaben umwandeln",
          "trim": "Leerzeichen entfernen",
          "length": "Zeichen zählen",
          "replace": "Ersetzen",
          "substring": "Teil herausschneiden",
          "split_pick": "Trennen und eins auswählen",
          "contains": "Prüfen, ob es enthalten ist",
          "url_encode": "Für Links sicher machen"
        }
      },
      "input": { "label": "Text", "placeholder": "{args}" },
      "find": { "label": "Suchen" },
      "replaceWith": { "label": "Ersetzen durch" },
      "start": { "label": "Beginnen bei" },
      "count": { "label": "Wie viele Zeichen" },
      "separator": { "label": "Trennen bei" },
      "pick": { "label": "Welches auswählen", "placeholder": "1, oder random" },
      "needle": { "label": "Suchen nach" },
      "saveAs": { "label": "Speichern als", "placeholder": "bereinigt" }
    }
  },
  "math": {
    "label": "Berechnen",
    "summary": "Eine Zahl berechnen",
    "field": {
      "expression": { "label": "Ausdruck", "placeholder": "({bits} / 100) + 1" },
      "saveAs": { "label": "Speichern als", "placeholder": "summe" }
    }
  },
  "httpGet": {
    "label": "Von Webadresse lesen",
    "summary": "Einen Wert über https abrufen",
    "field": {
      "url": { "label": "Adresse", "placeholder": "https://example.com/data" },
      "jsonPath": { "label": "JSON-Pfad", "placeholder": "data.value" },
      "saveAs": { "label": "Speichern als", "placeholder": "antwort" }
    },
    "out": { "ok": "Geklappt", "failure": "Fehlgeschlagen" }
  },
  "httpPost": {
    "label": "An Webadresse senden",
    "summary": "Über https an einen Webhook senden",
    "field": {
      "url": { "label": "Adresse", "placeholder": "https://example.com/hook" },
      "body": { "label": "Inhalt", "placeholder": "{user} war es" },
      "saveAs": { "label": "Speichern als", "placeholder": "antwort" }
    },
    "out": { "ok": "Geklappt", "failure": "Fehlgeschlagen" }
  },
  "rewardUpdate": {
    "label": "Belohnung ändern",
    "summary": "Eine Belohnung aktivieren oder deaktivieren oder ihre Kosten ändern",
    "field": {
      "reward": { "label": "Belohnung" },
      "setEnabled": { "label": "Aktiviert", "option": { "keep": "Unverändert lassen", "on": "Aktivieren", "off": "Deaktivieren" } },
      "cost": { "label": "Neue Kosten", "unit": "Punkte" },
      "reset": { "label": "Beim Stream-Ende zurücksetzen" }
    }
  },
  "cooldownAdd": {
    "label": "Zeit zu einem Cooldown hinzufügen",
    "summary": "Einen benannten Timer verlängern, während er läuft",
    "field": {
      "name": { "label": "Timer" },
      "seconds": { "label": "Hinzufügen", "range": "Verwende 1 Sekunde bis {days} Tage." },
      "per": { "label": "Pro", "hint": "Fügt die Zeit oben für jeden vollen Betrag hinzu. Trage in einem Bits-Rezept 100 ein, um je 100 Bits zu zählen. Leer lassen, um sie einmal pro Ereignis hinzuzufügen." }
    }
  },
    "countdownStart": {
    "label": "Countdown starten",
    "summary": "Einen benannten Countdown starten oder neu starten",
    "field": {
      "name": {
        "label": "Name",
        "placeholder": "subathon"
      },
      "seconds": {
        "label": "Dauer",
        "range": "1 Sekunde bis {days} Tage eingeben."
      },
      "leftCommand": {
        "label": "Verbleibende Zeit: Befehl",
        "placeholder": "!timeleft"
      },
      "leftReply": {
        "label": "Verbleibende Zeit: Antwort",
        "placeholder": "Noch {countdown:left}"
      },
      "readyReply": {
        "label": "Antwort bei abgelaufenem Countdown",
        "placeholder": "Der Countdown ist beendet!"
      }
    }
  },
    "countdownAdd": {
    "label": "Zeit zum Countdown hinzufügen",
    "summary": "Einen laufenden Countdown verlängern",
    "field": {
      "name": {
        "label": "Countdown"
      },
      "seconds": {
        "label": "Hinzufügen",
        "range": "1 Sekunde bis {days} Tage eingeben."
      },
      "per": {
        "label": "Pro",
        "hint": "Diese Zeit für jeden vollen Betrag hinzufügen. Leer lassen, um sie einmal pro Ereignis hinzuzufügen."
      }
    }
  },
  "poll": {
    "label": "Umfrage starten",
    "summary": "Umfrage starten",
    "field": {
      "title": {
        "label": "Titel"
      },
      "choices": {
        "label": "Antworten (eine pro Zeile)"
      },
      "seconds": {
        "label": "Dauer (Sekunden)"
      }
    }
  },
  "pollEnd": {
    "label": "Umfrage beenden",
    "summary": "Umfrage beenden",
    "field": {
      "status": {
        "label": "Aktion",
        "option": {
          "terminate": "Abstimmung stoppen",
          "archive": "Archivieren"
        }
      }
    }
  },
  "prediction": {
    "label": "Vorhersage starten",
    "summary": "Vorhersage starten",
    "field": {
      "title": {
        "label": "Titel"
      },
      "outcomes": {
        "label": "Ergebnisse (eines pro Zeile)"
      },
      "seconds": {
        "label": "Dauer (Sekunden)"
      }
    }
  },
  "predictionEnd": {
    "label": "Vorhersage beenden",
    "summary": "Vorhersage beenden",
    "field": {
      "status": {
        "label": "Aktion",
        "option": {
          "lock": "Abstimmung sperren",
          "cancel": "Abbrechen und erstatten",
          "resolve": "Gewinner wählen"
        }
      },
      "winner": {
        "label": "Nummer des Gewinnergebnisses"
      }
    }
  },
  "raidStart": {
    "label": "Raid starten",
    "summary": "Raid starten",
    "field": {
      "target": {
        "label": "Kanal- oder Zuschauername"
      }
    }
  },
  "raidCancel": {
    "label": "Raid abbrechen",
    "summary": "Raid abbrechen"
  },
  "mod": {
    "label": "Moderatorrolle ändern",
    "summary": "Moderatorrolle ändern",
    "field": {
      "target": {
        "label": "Kanal- oder Zuschauername"
      },
      "on": {
        "label": "Aktiviert"
      }
    }
  },
  "vip": {
    "label": "VIP-Rolle ändern",
