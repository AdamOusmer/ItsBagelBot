    "field": {
      "status": {
        "label": "Aktion",
        "option": {
          "approve": "Genehmigen",
          "deny": "Ablehnen"
        }
      },
      "resolution": {
        "label": "Entscheidungsnachricht (optional)"
      }
    }
  },
  "brandedContent": {
    "label": "Markeninhalte kennzeichnen",
    "summary": "Markeninhalte kennzeichnen",
