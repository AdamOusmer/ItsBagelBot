  "clearChat": {
    "label": "Chat leeren",
    "summary": "Chat leeren"
  },
  "adSnooze": {
    "label": "Nächste Werbung verschieben",
    "summary": "Nächste Werbung verschieben"
  },
  "whisper": {
    "label": "Flüsternachricht senden",
    "summary": "Flüsternachricht senden",
    "field": {
