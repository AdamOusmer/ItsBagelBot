{
  "role": {
    "label": "Nível de usuário",
    "summary": "Verificar o cargo do espectador",
    "warning": "Os cargos só são conhecidos em gatilhos de chat e contagens regressivas. Neste gatilho, todos contam como espectadores.",
    "remove": "Remover esta verificação",
    "field": {
      "level": {
        "label": "No mínimo",
        "option": {
          "everyone": "Todos",
          "sub": "Inscrito",
          "vip": "VIP",
          "mod": "Moderador",
          "lead_mod": "Moderador líder",
          "broadcaster": "Streamer"
        }
      }
    },
    "out": {
      "yes": "Permitido",
      "no": "Bloqueado"
    }
  },
  "user": {
    "label": "Usuário específico",
    "summary": "Apenas este espectador passa",
    "field": {
      "login": {
        "label": "Nome de usuário",
        "placeholder": "itsbagelbot"
      }
    },
    "out": {
      "yes": "Este usuário",
      "no": "Qualquer outro"
    }
  },
  "cooldown": {
    "label": "Intervalo de espera",
    "summary": "Permite executar uma vez a cada poucos segundos",
    "field": {
      "seconds": {
        "label": "Intervalo de espera",
        "range": "Use de 1 segundo a {days} dias."
      },
      "perUser": {
        "label": "Por espectador"
      },
      "name": {
        "label": "Nome",
        "placeholder": "subathon",
        "hint": "Dar um nome o reinicia se estiver em andamento. Etapas de adicionar tempo em qualquer receita poderão estendê-lo. Não disponível por espectador."
      },
      "leftCommand": {
        "label": "Comando de tempo restante",
        "placeholder": "!temporestante"
      },
      "leftReply": {
        "label": "Resposta durante a espera",
        "placeholder": "{user}, faltam {cooldown:left} para poder usar isso de novo."
      },
      "readyReply": {
        "label": "Resposta quando estiver pronto",
        "placeholder": "{user}, isso já está pronto para usar."
      }
    },
    "out": {
      "yes": "Pronto",
      "no": "Em espera"
    }
  },
  "compare": {
    "label": "Comparar valor",
    "summary": "Comparar dois números ou textos",
    "field": {
      "left": {
        "label": "Valor",
        "placeholder": "{bits}"
      },
      "op": {
        "label": "É",
        "option": {
          "gte": "no mínimo",
          "lt": "menor que",
          "eq": "igual a",
          "contains": "contém"
        }
      },
      "right": {
        "label": "Este valor",
        "placeholder": "1000"
      }
    },
    "out": {
      "yes": "Sim",
      "no": "Não"
    }
  },
  "chance": {
    "label": "Chance aleatória",
    "summary": "Passar às vezes",
    "field": {
      "percent": {
        "label": "Chance",
        "unit": "%"
      }
    },
    "out": {
      "yes": "Acerto",
      "no": "Erro"
    }
  },
  "var": {
    "label": "Verificar uma variável",
    "summary": "Passar quando um valor guardado corresponder",
    "field": {
      "scope": { "label": "Guardada para", "option": { "channel": "O canal", "viewer": "Este espectador" } },
      "name": { "label": "Nome", "placeholder": "mortes" },
      "op": {
        "label": "É",
        "option": {
          "eq": "igual a",
          "ne": "diferente de",
          "gt": "maior que",
          "gte": "no mínimo",
          "lt": "menor que",
          "lte": "no máximo",
          "contains": "contendo",
          "exists": "definida com qualquer valor"
        }
      },
      "value": { "label": "Valor", "placeholder": "10" }
    },
    "out": { "yes": "Sim", "no": "Não" }
  },
  "points": {
    "label": "Pontos do espectador",
    "summary": "Verifique o saldo de pontos de quem acionou a receita",
    "field": {
      "op": {
        "label": "É"
      },
      "value": {
        "label": "Pontos",
        "unit": "pontos"
      }
    },
    "out": {
      "yes": "Sim",
      "no": "Não"
    },
    "line": {
      "eq": "O espectador tem exatamente {value} pontos",
      "ne": "O saldo do espectador é diferente de {value} pontos",
      "gt": "O espectador tem mais de {value} pontos",
      "gte": "O espectador tem pelo menos {value} pontos",
      "lt": "O espectador tem menos de {value} pontos",
      "lte": "O espectador tem no máximo {value} pontos"
    }
  },
  "counter": {
    "label": "Valor do contador",
    "summary": "Verifique o valor atual de um contador com nome",
    "field": {
      "counter": {
        "label": "Contador"
      },
      "op": {
        "label": "É"
      },
      "value": {
        "label": "Valor"
      }
    },
    "out": {
      "yes": "Sim",
      "no": "Não"
    }
  }
}
