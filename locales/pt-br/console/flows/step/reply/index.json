{
  "chat": {
    "label": "Enviar mensagem",
    "summary": "Publique uma mensagem no chat",
    "field": {
      "message": {
        "label": "Mensagem",
        "placeholder": "Obrigado, {user}!"
      }
    }
  },
  "points": {
    "label": "Dar pontos de fidelidade",
    "summary": "Adicionar ou remover pontos",
    "field": {
      "amount": {
        "label": "Quantidade",
        "unit": "pontos"
      }
    }
  },
  "counter": {
    "label": "Aumentar contador",
    "summary": "Aumentar um contador",
    "field": {
      "counter": {
        "label": "Contador"
      }
    }
  },
  "lights": {
    "label": "Ajustar luzes",
    "summary": "Cor, cena, branco, ligar ou desligar luzes Govee",
    "field": {
      "device": {
        "label": "Luz"
      },
      "mode": {
        "label": "Definir",
        "option": {
          "color": "Cor",
          "scene": "Cena",
          "white": "Branco",
          "on": "Ligar",
          "off": "Desligar"
        }
      },
      "color": {
        "label": "Cor"
      },
      "scene": {
        "label": "Cena",
        "hint": "Usa a lista de cenas da primeira luz."
      },
      "liveOnly": {
        "label": "Só durante a live"
      },
      "kelvin": {
        "label": "Temperatura de cor"
      },
      "brightness": {
        "label": "Brilho",
        "placeholder": "Manter",
        "unit": "%"
      },
      "holdS": {
        "label": "Voltar após",
        "hint": "As luzes voltam ao estado anterior. Se havia uma cena, sua última cor é restaurada.",
        "range": "Use de 0 a {max} segundos."
      }
    },
    "noColors": "Esta luz não tem cores",
    "noWarmth": "Esta luz não tem branco ajustável",
    "noLights": "Nenhuma luz Govee controlável foi encontrada.",
    "noLightsBody": "Adicione uma luz à sua conta pelo app da Govee."
  },
  "wait": {
    "label": "Aguardar",
    "summary": "Pausar antes da próxima etapa",
    "field": {
      "seconds": {
        "label": "Aguardar por",
        "unit": "segundos, máximo {max}",
        "hint": "A soma de todas as esperas em uma execução pode chegar a 60 segundos."
      }
    }
  },
  "loop": {
    "label": "Repetir etapas",
    "summary": "Executar um caminho até 100 vezes",
    "field": {
      "times": {
        "label": "Quantas vezes",
        "placeholder": "3",
        "hint": "De 1 a 100. Uma variável como {args} também funciona."
      }
    },
    "out": {
      "body": "A cada repetição",
      "done": "Ao terminar"
    }
  },
  "varSet": {
    "label": "Definir uma variável",
    "summary": "Guardar um valor para depois",
    "field": {
      "scope": {
        "label": "Guardada para",
        "option": {
          "channel": "O canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nome",
        "placeholder": "mortes"
      },
      "value": {
        "label": "Valor",
        "placeholder": "{user}"
      }
    }
  },
  "varAdd": {
    "label": "Somar a uma variável",
    "summary": "Contar para cima ou para baixo",
    "field": {
      "scope": {
        "label": "Guardada para",
        "option": {
          "channel": "O canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nome",
        "placeholder": "mortes"
      },
      "amount": {
        "label": "Quantidade"
      }
    }
  },
  "varDelete": {
    "label": "Apagar uma variável",
    "summary": "Esquecer um valor",
    "field": {
      "scope": {
        "label": "Guardada para",
        "option": {
          "channel": "O canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nome",
        "placeholder": "mortes"
      }
    }
  },
  "math": {
    "label": "Fazer cálculos",
    "summary": "Calcular um número",
    "field": {
      "expression": {
        "label": "Expressão",
        "placeholder": "random(1, 6) * 10",
        "hint": "Use + - * / % ^ e as funções round, floor, ceil, abs, min, max e random(a, b)."
      },
      "saveAs": {
        "label": "Salvar como",
        "placeholder": "total"
      }
    }
  },
  "cooldownAdd": {
    "label": "Adicionar tempo a um intervalo de uso",
    "summary": "Estender um temporizador nomeado enquanto ele está em andamento",
    "line": "Adicionar {seconds} a {name}",
    "field": {
      "name": {
        "label": "Temporizador"
      },
      "seconds": {
        "label": "Adicionar",
        "range": "Use de 1 segundo a {days} dias."
      },
      "per": {
        "label": "Por",
        "hint": "Adiciona o tempo acima para cada quantidade completa. Coloque 100 em uma receita de bits para contar a cada 100 bits. Deixe vazio para adicionar uma vez por evento."
      }
    }
  },
  "countdownAdd": {
    "label": "Adicionar tempo à contagem regressiva",
    "summary": "Estender uma contagem regressiva ativa",
    "line": "Adicionar {seconds} a {name}",
    "field": {
      "name": {
        "label": "Contagem regressiva"
      },
      "seconds": {
        "label": "Adicionar",
        "range": "Use de 1 segundo a {days} dias."
      },
      "per": {
        "label": "A cada",
        "hint": "Adiciona este tempo para cada valor completo. Deixe vazio para adicionar uma vez por evento."
      }
    }
  },
  "poll": {
    "label": "Iniciar uma enquete",
    "summary": "Deixe os espectadores votarem em uma pergunta",
    "line": "Enquete: {title}",
    "field": {
      "title": {
        "label": "Título"
      },
      "choices": {
        "label": "Opções (uma por linha)"
      },
      "seconds": {
        "label": "Duração (segundos)"
      },
      "extraVotes": {
        "label": "Votos extras com Pontos do Canal"
      },
      "pointsPerVote": {
        "label": "Pontos por voto"
      }
    }
  },
  "pollEnd": {
    "label": "Encerrar uma enquete",
    "summary": "Pare a votação ou arquive os resultados",
    "line": {
      "terminate": "Encerrar enquete e mostrar resultados",
      "archive": "Encerrar enquete e ocultar resultados"
    },
    "field": {
      "status": {
        "label": "Ação",
        "option": {
          "terminate": "Encerrar e mostrar resultados",
          "archive": "Encerrar e ocultar resultados"
        }
      }
    }
  },
  "prediction": {
    "label": "Iniciar uma previsão",
    "summary": "Deixe os espectadores apostarem pontos em um resultado",
    "line": "Previsão: {title}",
    "field": {
      "title": {
        "label": "Título"
      },
      "outcomes": {
        "label": "Resultados (um por linha)"
      },
      "seconds": {
        "label": "Duração (segundos)"
      }
    }
  },
  "predictionEnd": {
    "label": "Encerrar uma previsão",
    "summary": "Feche apostas, devolva pontos ou escolha um vencedor",
    "line": {
      "lock": "Fechar apostas",
      "cancel": "Cancelar e reembolsar",
      "resolve": "Vencedor: {outcome}"
    },
    "field": {
      "status": {
        "label": "Ação",
        "option": {
          "lock": "Fechar apostas",
          "cancel": "Cancelar e reembolsar",
          "resolve": "Escolher um vencedor"
        }
      },
      "outcome": {
        "label": "Resultado vencedor",
        "hint": "Um número ou o nome do resultado"
      }
    }
  },
  "raidStart": {
    "label": "Iniciar uma raid",
    "summary": "Envie seus espectadores para outro canal",
    "line": "Fazer uma raid para {target}",
    "field": {
      "target": {
        "label": "Canal de destino da raid",
        "placeholder": "nome do canal"
      }
    }
  },
  "raidCancel": {
    "label": "Cancelar uma raid",
    "summary": "Pare a raid antes que os espectadores saiam"
  },
  "mod": {
    "label": "Cargo de moderador",
    "summary": "Adicione ou remova um moderador",
    "line": {
      "add": "Dar cargo de moderador: {who}",
      "remove": "Remover cargo de moderador: {who}"
    },
    "field": {
      "change": {
        "label": "Alteração",
        "option": { "add": "Adicionar", "remove": "Remover" }
      }
    }
  },
  "vip": {
    "label": "Cargo VIP",
    "summary": "Adicione ou remova um VIP",
    "line": {
      "add": "Dar cargo VIP: {who}",
      "remove": "Remover cargo VIP: {who}"
    },
    "field": {
      "change": {
        "label": "Alteração",
        "option": { "add": "Adicionar", "remove": "Remover" }
      }
    }
  },
  "clearChat": {
    "label": "Limpar o chat",
    "summary": "Remova todas as mensagens do chat",
    "line": "Limpar todo o chat"
  },
  "adSnooze": {
    "label": "Adiar o próximo anúncio",
    "summary": "Atrase a próxima pausa para anúncios"
  },
  "whisper": {
    "label": "Enviar um sussurro",
    "summary": "Envie uma mensagem privada para um espectador",
    "line": "Sussurrar para {target}: {text}",
    "field": {
      "target": {
        "label": "Nome do canal ou espectador"
      },
      "text": {
        "label": "Mensagem",
        "hint": "A mensagem é enviada pela conta do bot."
      }
    }
  },
  "unbanResolve": {
    "label": "Responder ao pedido de desbanimento",
    "summary": "Aprove ou negue um recurso",
    "line": {
      "approve": "Aprovar o pedido de desbanimento",
      "deny": "Negar o pedido de desbanimento"
    },
    "field": {
      "status": {
        "label": "Resposta",
        "option": {
          "approve": "Aprovar",
          "deny": "Negar"
        }
      },
      "resolution": {
        "label": "Mensagem ao espectador (opcional)"
      }
    }
  },
  "stop": {
    "label": "Parar aqui",
    "summary": "Encerra a execução aqui",
    "keywords": "fim encerrar sair parar",
    "line": "Encerra a execução aqui",
    "note": "Em caminhos paralelos, encerra apenas esse caminho."
  },
  "random": {
    "label": "Escolher um caminho aleatório",
    "summary": "Escolhe um caminho com as chances que você definir",
    "keywords": "dados sorteio embaralhar ponderado",
    "path": "Caminho {path}",
    "pathPercent": "{label} ({percent}%)",
    "field": {
      "paths": {
        "label": "Caminhos",
        "option": {
          "2": "2",
          "3": "3",
          "4": "4",
          "5": "5"
        }
      },
      "weight1": {
        "label": "Chance do caminho 1",
        "unit": "partes"
      },
      "weight2": {
        "label": "Chance do caminho 2",
        "unit": "partes"
      },
      "weight3": {
        "label": "Chance do caminho 3",
        "unit": "partes"
      },
      "weight4": {
        "label": "Chance do caminho 4",
        "unit": "partes"
      },
      "weight5": {
        "label": "Chance do caminho 5",
        "unit": "partes"
      }
    }
  },
  "run": {
    "label": "Executar outra receita",
    "summary": "Inicia outra receita deste canal",
    "keywords": "chamar acionar encadear",
    "line": "Executar {name}",
    "note": "Uma receita pode chamar outras em até 2 níveis.",
    "field": {
      "automationId": {
        "label": "Receita",
