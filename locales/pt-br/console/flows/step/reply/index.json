{
  "chat": {
    "label": "Enviar mensagem no chat",
    "summary": "Bot responde no chat",
    "field": {
      "message": {
        "label": "Mensagem",
        "placeholder": "Obrigado, {user}!"
      }
    }
  },
  "points": {
    "label": "Alterar pontos",
    "summary": "Adicionar ou remover pontos",
    "field": {
      "amount": {
        "label": "Quantidade",
        "unit": "pontos"
      },
      "change": { "label": "Alteração", "option": { "add": "Adicionar", "take": "Retirar" } }
    },
    "line": { "add": "Dar {amount}", "take": "Tirar {amount}" }
  },
  "counter": {
    "label": "Alterar contador",
    "summary": "Aumente, diminua ou defina um contador com nome",
    "field": {
      "counter": {
        "label": "Contador"
      },
      "change": { "label": "Alteração", "option": { "add": "Adicionar", "set": "Definir" } },
      "amount": { "label": "Quantidade", "hint": "Use um número negativo para subtrair" },
      "value": { "label": "Valor" }
    },
    "line": { "add": "Adicionar {amount} a {counter}", "take": "Tirar {amount} de {counter}", "set": "Definir {counter} como {value}" }
  },
  "lights": {
    "label": "Ajustar luzes",
    "summary": "Definir uma cor ou cena Govee",
    "field": {
      "device": {
        "label": "Luz"
      },
      "mode": {
        "label": "Definir",
        "option": {
          "color": "Cor",
          "scene": "Cena"
        }
      },
      "color": {
        "label": "Cor"
      },
      "scene": {
        "label": "Cena"
      },
      "liveOnly": {
        "label": "Só durante a live"
      }
    }
  },
  "wait": {
    "label": "Aguardar",
    "summary": "Pausar antes da próxima etapa",
    "field": {
      "seconds": {
        "label": "Atraso",
        "unit": "segundos, máximo {max}"
      }
    }
  },
  "loop": {
    "label": "Repetir etapas",
    "summary": "Executar um caminho até 100 vezes",
    "field": {
      "times": {
        "label": "Quantas vezes",
        "placeholder": "3"
      }
    },
    "out": {
      "body": "A cada repetição",
      "done": "Ao terminar"
    }
  },
  "varSet": {
    "label": "Definir uma variável",
    "summary": "Guardar um valor para depois",
    "field": {
      "scope": {
        "label": "Guardada para",
        "option": {
          "channel": "O canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nome",
        "placeholder": "mortes"
      },
      "value": {
        "label": "Valor",
        "placeholder": "{user}"
      }
    }
  },
  "varAdd": {
    "label": "Somar a uma variável",
    "summary": "Contar para cima ou para baixo",
    "field": {
      "scope": {
        "label": "Guardada para",
        "option": {
          "channel": "O canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nome",
        "placeholder": "mortes"
      },
      "amount": {
        "label": "Quantidade"
      }
    }
  },
  "varDelete": {
    "label": "Apagar uma variável",
    "summary": "Esquecer um valor",
    "field": {
      "scope": {
        "label": "Guardada para",
        "option": {
          "channel": "O canal",
          "viewer": "Este espectador"
        }
      },
      "name": {
        "label": "Nome",
        "placeholder": "mortes"
      }
    }
  },
  "math": {
    "label": "Fazer cálculos",
    "summary": "Calcular um número",
    "field": {
      "expression": {
        "label": "Expressão",
        "placeholder": "({bits} / 100) + 1"
      },
      "saveAs": {
        "label": "Salvar como",
        "placeholder": "total"
      }
    }
  },
  "cooldownAdd": {
    "label": "Adicionar tempo a um intervalo de uso",
    "summary": "Estender um temporizador nomeado enquanto ele está em andamento",
    "line": "Adicionar {seconds} a {name}",
    "field": {
      "name": {
        "label": "Temporizador"
      },
      "seconds": {
        "label": "Adicionar",
        "range": "Use de 1 segundo a {days} dias."
      },
      "per": {
        "label": "A cada",
        "hint": "Apenas para Cheers e inscrições presenteadas. Deixe em branco para adicionar tempo uma vez."
      }
    }
  },
  "countdownAdd": {
    "label": "Adicionar tempo à contagem regressiva",
    "summary": "Estender uma contagem regressiva ativa",
    "line": "Adicionar {seconds} a {name}",
    "field": {
      "name": {
        "label": "Contagem regressiva"
      },
      "seconds": {
        "label": "Adicionar",
        "range": "Use de 1 segundo a {days} dias."
      },
      "per": {
        "label": "A cada",
        "hint": "Apenas para Cheers e inscrições presenteadas. Deixe em branco para adicionar tempo uma vez."
      }
    }
  },
  "poll": {
    "label": "Iniciar uma enquete",
    "summary": "Deixe os espectadores votarem em uma pergunta",
    "line": "Enquete: {title}",
    "field": {
      "title": {
        "label": "Título"
      },
      "choices": {
        "label": "Opções (uma por linha)"
      },
      "seconds": {
        "label": "Duração (segundos)"
      }
    }
  },
  "pollEnd": {
    "label": "Encerrar uma enquete",
    "summary": "Pare a votação ou arquive os resultados",
    "line": {
      "terminate": "Encerrar a enquete e mostrar os resultados",
      "archive": "Arquivar a enquete"
    },
    "field": {
      "status": {
        "label": "Ação",
        "option": {
          "terminate": "Parar a votação",
          "archive": "Arquivar"
        }
      }
    }
  },
  "prediction": {
    "label": "Iniciar uma previsão",
    "summary": "Deixe os espectadores apostarem pontos em um resultado",
    "line": "Previsão: {title}",
    "field": {
      "title": {
        "label": "Título"
      },
      "outcomes": {
        "label": "Resultados (um por linha)"
      },
      "seconds": {
        "label": "Duração (segundos)"
      }
    }
  },
  "predictionEnd": {
    "label": "Encerrar uma previsão",
    "summary": "Feche apostas, devolva pontos ou escolha um vencedor",
    "line": {
      "lock": "Fechar as apostas",
      "cancel": "Cancelar e devolver os pontos",
      "resolve": "Resultado vencedor: {winner}"
    },
    "field": {
      "status": {
        "label": "Ação",
        "option": {
          "lock": "Bloquear a votação",
          "cancel": "Cancelar e reembolsar",
          "resolve": "Escolher vencedor"
        }
      },
      "winner": {
        "label": "Número do resultado vencedor"
      }
    }
  },
  "raidStart": {
    "label": "Iniciar uma raid",
    "summary": "Envie seus espectadores para outro canal",
    "line": "Fazer uma raid para {target}",
    "field": {
      "target": {
        "label": "Nome do canal ou espectador"
      }
    }
  },
  "raidCancel": {
    "label": "Cancelar uma raid",
    "summary": "Pare a raid antes que os espectadores saiam"
  },
  "mod": {
    "label": "Alterar cargo de moderador",
    "summary": "Dê ou remova permissões de moderador",
    "line": {
      "on": "Dar cargo de moderador a {target}",
      "off": "Remover cargo de moderador de {target}"
    },
    "field": {
      "target": {
        "label": "Nome do canal ou espectador"
      },
      "on": {
        "label": "Ativado"
      }
    }
  },
  "vip": {
    "label": "Alterar cargo VIP",
    "summary": "Dê ou remova o distintivo VIP de um espectador",
    "line": {
      "on": "Dar cargo VIP a {target}",
      "off": "Remover cargo VIP de {target}"
    },
    "field": {
      "target": {
        "label": "Nome do canal ou espectador"
      },
      "on": {
        "label": "Ativado"
      }
    }
  },
  "clearChat": {
    "label": "Limpar o chat",
    "summary": "Remova todas as mensagens do chat"
  },
  "adSnooze": {
    "label": "Adiar o próximo anúncio",
    "summary": "Atrase a próxima pausa para anúncios"
  },
  "whisper": {
    "label": "Enviar um sussurro",
    "summary": "Envie uma mensagem privada para um espectador",
    "line": "Sussurro para {target}: {text}",
    "field": {
      "target": {
        "label": "Nome do canal ou espectador"
      },
      "text": {
        "label": "Mensagem"
      }
    }
  },
  "unbanResolve": {
    "label": "Resolver pedido de desbanimento",
    "summary": "Aprove ou negue o recurso de um espectador",
    "field": {
      "status": {
        "label": "Ação",
        "option": {
          "approve": "Aprovar",
          "deny": "Negar"
        }
      },
      "resolution": {
        "label": "Mensagem da decisão (opcional)"
      }
    }
  },
  "brandedContent": {
    "label": "Definir conteúdo de marca",
    "summary": "Mostre ou oculte o aviso de promoção paga",
    "field": {
      "on": {
        "label": "Ativado"
      }
    }
  },
  "redemption": {
    "label": "Concluir resgate",
    "summary": "Atenda a um resgate de recompensa ou devolva os pontos",
    "field": {
      "result": {
        "label": "Resultado"
      }
    },
    "line": {
      "fulfill": "Marcar como atendida",
      "cancel": "Devolver os pontos"
    }
  },
  "pointsSpend": {
    "label": "Gastar pontos",
    "summary": "Desconte pontos quando o espectador tiver saldo suficiente",
    "line": "Gastar {amount}",
    "field": {
      "amount": {
        "label": "Quantidade",
        "unit": "pontos"
      }
    },
    "out": {
      "enough": "Suficientes",
      "notEnough": "Insuficientes"
    }
  },
  "countdownStop": {
    "label": "Parar a contagem regressiva",
    "summary": "Encerre antes da hora uma contagem regressiva em andamento",
    "line": "Parar {name}",
    "field": {
      "name": {
        "label": "Contagem regressiva"
      }
    }
  },
  "cooldownReset": {
    "label": "Zerar o intervalo",
    "summary": "Encerre a espera de um intervalo com nome",
    "line": "Zerar {name}",
    "field": {
      "name": {
        "label": "Intervalo"
      }
    }
  }
}
