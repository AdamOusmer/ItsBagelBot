      "expression": { "label": "Expressão", "placeholder": "({bits} / 100) + 1" },
      "saveAs": { "label": "Salvar como", "placeholder": "total" }
    }
  },
  "httpGet": {
    "label": "Ler de um endereço web",
    "summary": "Buscar um valor via https",
    "field": {
      "url": { "label": "Endereço", "placeholder": "https://example.com/data" },
