    "out": { "ok": "Funcionou", "failure": "Falhou" }
  },
  "rewardUpdate": {
    "label": "Alterar uma recompensa",
    "summary": "Ativar ou desativar uma recompensa, ou definir seu custo",
    "field": {
      "reward": { "label": "Recompensa" },
