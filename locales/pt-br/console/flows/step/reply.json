        "label": "Resposta de tempo restante",
        "placeholder": "Restam {countdown:left}"
      },
      "readyReply": {
        "label": "Resposta de tempo restante ao terminar",
        "placeholder": "A contagem regressiva terminou!"
      }
    }
  },
    "countdownAdd": {
    "label": "Adicionar tempo à contagem regressiva",
