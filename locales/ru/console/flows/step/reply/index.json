    "field": {
      "message": {
        "label": "Сообщение",
        "placeholder": "Спасибо, {user}!"
      }
    }
  },
  "points": {
    "label": "Начислить баллы лояльности",
    "summary": "Добавить или списать баллы",
    "field": {
      "amount": {
        "label": "Количество",
        "unit": "баллов"
      }
    }
  },
  "counter": {
    "label": "Увеличить счётчик",
    "summary": "Увеличить счётчик",
    "field": {
      "counter": {
        "label": "Счётчик"
      }
    }
  },
  "lights": {
    "label": "Настроить свет",
    "summary": "Цвет, сцена, белый свет, включение или выключение устройств Govee",
    "field": {
      "device": {
        "label": "Свет"
      },
      "mode": {
        "label": "Режим",
        "option": {
          "color": "Цвет",
          "scene": "Сцена",
          "white": "Белый",
          "on": "Включить",
          "off": "Выключить"
        }
      },
      "color": {
        "label": "Цвет"
      },
      "scene": {
        "label": "Сцена",
        "hint": "Используется список сцен первого светильника."
      },
      "liveOnly": {
        "label": "Только во время эфира"
      },
      "kelvin": {
        "label": "Цветовая температура"
      },
      "brightness": {
        "label": "Яркость",
        "placeholder": "Сохранить",
        "unit": "%"
      },
      "holdS": {
        "label": "Вернуть через",
        "hint": "Светильники вернутся в прежнее состояние. Если была включена сцена, восстановится её последний цвет.",
        "range": "Укажите от 0 до {max} с."
      }
    },
    "noColors": "Этот светильник не поддерживает цветной свет",
    "noWarmth": "У этого светильника не регулируется оттенок белого",
