{
  "chat": {
    "label": "Отправить сообщение",
    "summary": "Опубликовать сообщение в чате",
    "field": {
      "message": {
        "label": "Сообщение",
        "placeholder": "Спасибо, {user}!"
      }
    }
  },
  "wait": {
    "label": "Ожидание",
    "summary": "Пауза перед следующим шагом",
    "field": {
      "seconds": {
        "label": "Ждать в течение",
        "unit": "секунд, макс. {max}",
        "hint": "Общая длительность всех пауз за один запуск не превышает 60 секунд."
      }
    }
  },
  "loop": {
    "label": "Повторить шаги",
    "summary": "Запустить путь до 100 раз",
    "field": {
      "times": {
        "label": "Сколько раз",
        "placeholder": "3",
        "hint": "От 1 до 100. Можно использовать переменную, например {args}."
      }
    },
    "out": {
      "body": "Каждый раз",
      "done": "После завершения"
    }
  },
  "varDelete": {
    "label": "Удалить переменную",
    "summary": "Забыть значение",
    "field": {
      "scope": {
        "label": "Хранить для",
        "option": {
          "channel": "Канал",
          "viewer": "Этот зритель"
        }
      },
      "name": {
        "label": "Название",
        "placeholder": "deaths"
      }
    }
  },
  "math": {
    "label": "Вычислить",
    "summary": "Вычислить число",
    "field": {
      "expression": {
        "label": "Выражение",
        "placeholder": "random(1, 6) * 10",
        "hint": "Используйте + - * / % ^ и функции round, floor, ceil, abs, min, max и random(a, b)."
      },
      "saveAs": {
        "label": "Сохранить как",
        "placeholder": "total"
      }
    }
  },
  "pollEnd": {
    "label": "Завершить опрос",
    "summary": "Остановить голосование или сохранить итоги",
    "line": {
      "terminate": "Завершить опрос и показать результаты",
      "archive": "Завершить опрос и скрыть результаты"
    },
    "field": {
      "status": {
        "label": "Действие",
        "option": {
          "terminate": "Завершить и показать результаты",
          "archive": "Завершить и скрыть результаты"
        }
      }
    }
  },
  "prediction": {
    "label": "Начать прогноз",
    "summary": "Предложить зрителям поставить баллы на исход",
    "line": "Прогноз: {title}",
    "field": {
      "title": {
        "label": "Название"
      },
      "outcomes": {
        "label": "Исходы (по одному в строке)"
      },
      "seconds": {
        "label": "Длительность (секунды)"
      }
    }
  },
  "raidStart": {
    "label": "Начать рейд",
    "summary": "Отправить зрителей на другой канал",
    "line": "Начать рейд на канал {target}",
    "field": {
      "target": {
        "label": "Канал для рейда",
        "placeholder": "имя канала"
      }
    }
  },
  "raidCancel": {
    "label": "Отменить рейд",
    "summary": "Остановить рейд до перехода зрителей"
  },
  "mod": {
    "label": "Роль модератора",
    "summary": "Добавить или удалить модератора",
    "line": {
      "add": "Назначить модератором: {who}",
      "remove": "Снять права модератора: {who}"
    },
    "field": {
      "change": {
        "label": "Изменение",
        "option": {
          "add": "Добавить",
          "remove": "Удалить"
        }
      }
    }
  },
  "vip": {
    "label": "Роль VIP",
    "summary": "Добавить или удалить VIP",
    "line": {
      "add": "Выдать статус VIP: {who}",
      "remove": "Снять статус VIP: {who}"
    },
    "field": {
      "change": {
        "label": "Изменение",
        "option": {
          "add": "Добавить",
          "remove": "Удалить"
        }
      }
    }
  },
  "clearChat": {
    "label": "Очистить чат",
    "summary": "Удалить все сообщения из чата",
    "line": "Очистить весь чат"
  },
  "adSnooze": {
    "label": "Отложить следующую рекламу",
    "summary": "Сдвинуть следующую рекламную паузу"
  },
  "whisper": {
    "label": "Отправить личное сообщение",
    "summary": "Написать одному зрителю приватно",
    "line": "Личное сообщение для {target}: {text}",
    "field": {
      "target": {
        "label": "Имя канала или зрителя"
      },
      "text": {
        "label": "Сообщение",
        "hint": "Сообщение отправляется с аккаунта бота."
      }
    }
  },
  "stop": {
    "label": "Остановиться здесь",
    "summary": "Завершить выполнение здесь",
    "keywords": "конец завершить выйти остановить",
    "line": "Завершить выполнение здесь",
    "note": "При параллельном выполнении завершает только эту ветку."
  },
  "run": {
    "label": "Запустить другой рецепт",
    "summary": "Запустить другой рецепт этого канала",
    "keywords": "вызвать запустить цепочка",
    "line": "Запустить {name}",
    "note": "Вложенность вызовов рецептов ограничена 2 уровнями.",
    "field": {
      "automationId": {
        "label": "Рецепт",
        "hint": "Проверки другого рецепта по-прежнему действуют. Он получает значения текущего рецепта, а его изменения остаются в нём."
      }
    }
  },
  "redemption": {
    "label": "Завершить получение награды",
    "summary": "Подтвердить получение награды или вернуть баллы",
    "field": {
      "result": {
        "label": "Результат"
      }
    },
    "line": {
      "fulfill": "Отметить как выполненную",
      "cancel": "Вернуть баллы"
    }
  },
  "pointsSpend": {
    "label": "Потратить баллы",
    "summary": "Спишите баллы, если их достаточно у зрителя",
    "line": "Потратить: {amount}",
    "field": {
      "amount": {
        "label": "Количество",
        "unit": "баллы"
      }
    },
    "out": {
      "enough": "Достаточно",
      "notEnough": "Недостаточно"
    }
  },
  "countdownStop": {
    "label": "Остановить обратный отсчёт",
    "summary": "Досрочно завершите запущенный обратный отсчёт",
    "line": "Остановить {name}",
    "field": {
      "name": {
        "label": "Обратный отсчёт"
      }
    }
  },
  "cooldownReset": {
    "label": "Сбросить время ожидания",
    "summary": "Снимите ограничение ожидания с заданным именем",
    "line": "Сбросить {name}",
    "field": {
      "name": {
        "label": "Время ожидания"
      }
    }
  }
}
