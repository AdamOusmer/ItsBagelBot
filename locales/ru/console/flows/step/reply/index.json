        "label": "Сохранить как",
        "placeholder": "total"
      }
    }
  },
  "cooldownAdd": {
    "label": "Добавить время к перезарядке",
    "summary": "Продлить именованный таймер, пока он работает",
    "line": "Продлить {name} на {seconds}",
    "field": {
      "name": {
        "label": "Таймер"
      },
      "seconds": {
        "label": "Добавить",
        "range": "Используйте от 1 секунды до {days} дней."
      },
      "per": {
        "label": "За",
        "hint": "Добавляет указанное время за каждую полную сумму. Укажите 100 в рецепте с битсами, чтобы считать каждые 100 битсов. Оставьте пустым, чтобы добавлять один раз за событие."
      }
    }
  },
  "countdownAdd": {
    "label": "Добавить время к отсчёту",
    "summary": "Продлить текущий обратный отсчёт",
