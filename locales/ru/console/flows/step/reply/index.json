  "wait": {
    "label": "Ожидание",
    "summary": "Пауза перед следующим шагом",
    "field": {
      "seconds": {
        "label": "Ждать в течение",
        "unit": "секунд, макс. {max}",
        "hint": "Общая длительность всех пауз за один запуск не превышает 60 секунд."
      }
    }
  },
  "loop": {
    "label": "Повторить шаги",
    "summary": "Запустить путь до 100 раз",
    "field": {
      "times": {
        "label": "Сколько раз",
        "placeholder": "3",
        "hint": "От 1 до 100. Можно использовать переменную, например {args}."
      }
    },
    "out": {
      "body": "Каждый раз",
      "done": "После завершения"
    }
  },
  "varSet": {
