    "label": "Вычислить",
    "summary": "Вычислить число",
    "field": {
      "expression": {
        "label": "Выражение",
        "placeholder": "random(1, 6) * 10",
        "hint": "Используйте + - * / % ^ и функции round, floor, ceil, abs, min, max и random(a, b)."
