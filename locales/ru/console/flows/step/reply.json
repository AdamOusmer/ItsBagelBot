    "field": {
      "device": {
        "label": "Свет"
      },
      "mode": {
        "label": "Режим",
        "option": {
          "color": "Цвет",
          "scene": "Сцена"
        }
      },
      "color": {
        "label": "Цвет"
      },
      "scene": {
        "label": "Сцена"
      }
    }
  },
  "wait": {
    "label": "Ожидание",
