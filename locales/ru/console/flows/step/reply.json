    },
    "out": { "ok": "Сработало", "failure": "Не сработало" }
  },
  "rewardUpdate": {
    "label": "Изменить награду",
    "summary": "Включить или выключить награду или задать её стоимость",
    "field": {
      "reward": { "label": "Награда" },
      "setEnabled": { "label": "Включено", "option": { "keep": "Оставить как есть", "on": "Включить", "off": "Выключить" } },
      "cost": { "label": "Новая стоимость", "unit": "баллов" },
      "reset": { "label": "Вернуть обратно в конце стрима" }
    }
  },
  "cooldownAdd": {
    "label": "Добавить время к перезарядке",
    "summary": "Продлить именованный таймер, пока он работает",
    "field": {
      "name": { "label": "Таймер" },
      "seconds": { "label": "Добавить", "range": "Используйте от 1 секунды до {days} дней." },
      "per": { "label": "За", "hint": "Добавляет указанное время за каждую полную сумму. Укажите 100 в рецепте с битсами, чтобы считать каждые 100 битсов. Оставьте пустым, чтобы добавлять один раз за событие." }
    }
  },
    "countdownStart": {
    "label": "Запустить обратный отсчёт",
    "summary": "Запустить или перезапустить обратный отсчёт",
    "field": {
      "name": {
        "label": "Название",
        "placeholder": "subathon"
      },
      "seconds": {
        "label": "Длительность",
        "range": "Укажите от 1 секунды до {days} дней."
      },
      "leftCommand": {
        "label": "Команда оставшегося времени",
        "placeholder": "!timeleft"
      },
      "leftReply": {
        "label": "Ответ с оставшимся временем",
        "placeholder": "Осталось {countdown:left}"
      },
      "readyReply": {
        "label": "Ответ об оставшемся времени после завершения",
        "placeholder": "Обратный отсчёт завершён!"
      }
    }
  },
    "countdownAdd": {
    "label": "Добавить время к отсчёту",
    "summary": "Продлить текущий обратный отсчёт",
    "field": {
      "name": {
        "label": "Обратный отсчёт"
      },
      "seconds": {
        "label": "Добавить",
        "range": "Укажите от 1 секунды до {days} дней."
      },
      "per": {
        "label": "За каждые",
        "hint": "Добавляет это время за каждую полную сумму. Оставьте пустым, чтобы добавить один раз за событие."
      }
    }
  },
