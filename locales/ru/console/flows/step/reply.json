  "text": {
    "label": "Изменить текст",
    "summary": "Очистить или разобрать текст",
    "field": {
      "op": {
        "label": "Что сделать",
        "option": {
          "upper": "Сделать заглавными",
          "lower": "Сделать строчными",
          "trim": "Убрать пробелы",
          "length": "Посчитать символы",
          "replace": "Заменить",
          "substring": "Взять часть",
          "split_pick": "Разделить и выбрать",
          "contains": "Проверить, содержит ли",
          "url_encode": "Подготовить для ссылки"
