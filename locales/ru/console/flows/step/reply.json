      "amount": {
        "label": "Количество",
        "unit": "баллов"
      }
    }
  },
  "counter": {
    "label": "Увеличить счётчик",
    "summary": "Увеличить счётчик",
    "field": {
      "counter": {
        "label": "Счётчик"
      }
    }
  },
  "lights": {
    "label": "Настроить свет",
