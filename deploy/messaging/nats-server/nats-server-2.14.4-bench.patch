@@ -0,0 +1,241 @@
+package server
+
+import (
+	"bytes"
+	"sync/atomic"
+	"unsafe"
+)
+
+// BENCH: header key index cache. Every JetStream ingest/apply step scans the
+// header block once per key it might care about (~30 bytes.Index calls per
+// message). This parses the block once, keeps a bitmap of the known JetStream
+// keys that are present, and answers absent keys with a bit test. The cached
+// copy of the raw block is compared byte-for-byte before use, so pooled or
+// reused buffers can never serve a stale index.
+
+const hdrCacheSlots = 64
+
+type hdrCacheKey struct{ start, klen int }
+
+type hdrCacheEntry struct {
+	raw     []byte
+	present uint64
+	keys    []hdrCacheKey
+}
+
+var hdrCache [hdrCacheSlots]atomic.Pointer[hdrCacheEntry]
+
+func knownHeaderBit(key string) (uint, bool) {
+	switch key {
+	case "Nats-Batch-Commit":
+		return 0, true
+	case "Nats-Batch-Id":
+		return 1, true
+	case "Nats-Batch-Sequence":
+		return 2, true
+	case "Nats-Consumer-Stalled":
+		return 3, true
+	case "Nats-Counter-Sources":
+		return 4, true
+	case "Nats-Expected-Last-Msg-Id":
+		return 5, true
+	case "Nats-Expected-Last-Sequence":
+		return 6, true
+	case "Nats-Expected-Last-Subject-Sequence":
+		return 7, true
+	case "Nats-Expected-Last-Subject-Sequence-Subject":
+		return 8, true
+	case "Nats-Expected-Stream":
+		return 9, true
+	case "Nats-Incr":
+		return 10, true
+	case "Nats-Last-Consumer":
+		return 11, true
+	case "Nats-Last-Sequence":
+		return 12, true
+	case "Nats-Last-Stream":
+		return 13, true
+	case "Nats-Marker-Reason":
+		return 14, true
+	case "Nats-Msg-Id":
+		return 15, true
+	case "Nats-Msg-Size":
+		return 16, true
+	case "Nats-Num-Pending":
+		return 17, true
+	case "Nats-Pending-Bytes":
+		return 18, true
+	case "Nats-Pending-Messages":
+		return 19, true
+	case "Nats-Pin-Id":
+		return 20, true
+	case "Nats-Required-Api-Level":
+		return 21, true
+	case "Nats-Response-Type":
+		return 22, true
+	case "Nats-Rollup":
+		return 23, true
+	case "Nats-Schedule":
+		return 24, true
+	case "Nats-Schedule-Next":
+		return 25, true
+	case "Nats-Schedule-Rollup":
+		return 26, true
+	case "Nats-Schedule-Source":
+		return 27, true
+	case "Nats-Schedule-TTL":
+		return 28, true
+	case "Nats-Schedule-Target":
+		return 29, true
+	case "Nats-Schedule-Time-Zone":
+		return 30, true
+	case "Nats-Scheduler":
+		return 31, true
+	case "Nats-Sequence":
+		return 32, true
+	case "Nats-Stream":
+		return 33, true
+	case "Nats-Stream-Source":
+		return 34, true
+	case "Nats-Subject":
+		return 35, true
+	case "Nats-TTL":
+		return 36, true
+	case "Nats-Time-Stamp":
+		return 37, true
+	case "Nats-UpTo-Sequence":
+		return 38, true
+	}
+	return 0, false
+}
+
+// knownHeaderBitBytes is knownHeaderBit for a byte slice; the switch on
+// string(b) compiles without allocating.
+func knownHeaderBitBytes(b []byte) (uint, bool) {
+	switch string(b) {
+	case "Nats-Batch-Commit":
+		return 0, true
+	case "Nats-Batch-Id":
+		return 1, true
+	case "Nats-Batch-Sequence":
+		return 2, true
+	case "Nats-Consumer-Stalled":
+		return 3, true
+	case "Nats-Counter-Sources":
+		return 4, true
+	case "Nats-Expected-Last-Msg-Id":
+		return 5, true
+	case "Nats-Expected-Last-Sequence":
+		return 6, true
+	case "Nats-Expected-Last-Subject-Sequence":
+		return 7, true
+	case "Nats-Expected-Last-Subject-Sequence-Subject":
+		return 8, true
+	case "Nats-Expected-Stream":
+		return 9, true
+	case "Nats-Incr":
+		return 10, true
+	case "Nats-Last-Consumer":
+		return 11, true
+	case "Nats-Last-Sequence":
+		return 12, true
+	case "Nats-Last-Stream":
+		return 13, true
+	case "Nats-Marker-Reason":
+		return 14, true
+	case "Nats-Msg-Id":
+		return 15, true
+	case "Nats-Msg-Size":
+		return 16, true
+	case "Nats-Num-Pending":
+		return 17, true
+	case "Nats-Pending-Bytes":
+		return 18, true
+	case "Nats-Pending-Messages":
+		return 19, true
+	case "Nats-Pin-Id":
+		return 20, true
+	case "Nats-Required-Api-Level":
+		return 21, true
+	case "Nats-Response-Type":
+		return 22, true
+	case "Nats-Rollup":
+		return 23, true
+	case "Nats-Schedule":
+		return 24, true
+	case "Nats-Schedule-Next":
+		return 25, true
+	case "Nats-Schedule-Rollup":
+		return 26, true
+	case "Nats-Schedule-Source":
+		return 27, true
+	case "Nats-Schedule-TTL":
+		return 28, true
+	case "Nats-Schedule-Target":
+		return 29, true
+	case "Nats-Schedule-Time-Zone":
+		return 30, true
+	case "Nats-Scheduler":
+		return 31, true
+	case "Nats-Sequence":
+		return 32, true
+	case "Nats-Stream":
+		return 33, true
+	case "Nats-Stream-Source":
+		return 34, true
+	case "Nats-Subject":
+		return 35, true
+	case "Nats-TTL":
+		return 36, true
+	case "Nats-Time-Stamp":
+		return 37, true
+	case "Nats-UpTo-Sequence":
+		return 38, true
+	}
+	return 0, false
+}
+
+func parseHdrCacheEntry(hdr []byte) *hdrCacheEntry {
+	e := &hdrCacheEntry{raw: append(make([]byte, 0, len(hdr)), hdr...), keys: make([]hdrCacheKey, 0, 8)}
+	i := bytes.Index(hdr, []byte("\r\n"))
+	for i >= 0 {
+		start := i + 2
+		if start >= len(hdr) {
+			break
+		}
+		rest := hdr[start:]
+		nl := bytes.Index(rest, []byte("\r\n"))
+		if nl < 0 {
+			nl = len(rest)
+		}
+		if colon := bytes.IndexByte(rest[:nl], ':'); colon > 0 {
+			e.keys = append(e.keys, hdrCacheKey{start: start, klen: colon})
+			if bit, ok := knownHeaderBit(string(rest[:colon])); ok {
+				e.present |= 1 << bit
+			}
+		}
+		if start+nl >= len(hdr) {
+			break
+		}
+		i = start + nl
+	}
+	return e
+}
+
+func hdrCacheKeyIndex(key string, hdr []byte) int {
+	slot := &hdrCache[(uintptr(unsafe.Pointer(unsafe.SliceData(hdr)))>>4)%hdrCacheSlots]
+	e := slot.Load()
+	if e == nil || !bytes.Equal(e.raw, hdr) {
+		e = parseHdrCacheEntry(hdr)
+		slot.Store(e)
+	}
+	if bit, ok := knownHeaderBit(key); ok && e.present&(1<<bit) == 0 {
+		return -1
+	}
+	for _, k := range e.keys {
+		if k.klen == len(key) && string(hdr[k.start:k.start+k.klen]) == key {
+			return k.start
+		}
+	}
+	return -1
+}
diff --git a/server/bench_hdrindex.go b/server/bench_hdrindex.go
new file mode 100644
index 0000000..26ca109
--- /dev/null
+++ b/server/bench_hdrindex.go
@@ -0,0 +1,105 @@
+package server
+
+import (
+	"bytes"
+	"unsafe"
+)
+
+// BENCH: hdrIndex is a parse-once view of one message's header block. The
+// JetStream ingest and apply paths probe the same block ~30 times per message
+// (expected-* checks, TTL, schedules, batch and rollup headers), each probe a
+// bytes.Index over the whole block; on the stream leader that was ~2.5 s of a
+// 9.6 s serialized budget per 10 s at 127k msg/s. The index is built once at
+// the top of a hot function, threaded to the getters, and answers absent
+// known keys with a bit test. It is bound to one exact slice (data pointer
+// and length): any lookup with a different slice, and any lookup when the
+// knob is off, falls through to sliceHeader, and callers re-index after they
+// rewrite hdr. Nothing is cached across messages.
+type hdrIndex struct {
+	data    *byte
+	n       int
+	nk      int
+	present uint64
+	ok      bool
+	keys    [16]hdrIndexKey
+}
+
+type hdrIndexKey struct{ ks, kl, vs, ve int32 }
+
+func indexHeader(hdr []byte) hdrIndex {
+	var hx hdrIndex
+	if !benchHdrIndex || len(hdr) < 2 {
+		return hx
+	}
+	hx.data, hx.n = unsafe.SliceData(hdr), len(hdr)
+	i := bytes.Index(hdr, crlfBytes)
+	for i >= 0 {
+		start := i + 2
+		if start >= len(hdr) {
+			break
+		}
+		rest := hdr[start:]
+		nl := bytes.Index(rest, crlfBytes)
+		if nl < 0 {
+			nl = len(rest)
+		}
+		line := rest[:nl]
+		if colon := bytes.IndexByte(line, ':'); colon > 0 {
+			if hx.nk == len(hx.keys) {
+				return hdrIndex{} // too many keys for the fixed index: plain scans
+			}
+			vs := colon + 1
+			for vs < nl && line[vs] == ' ' {
+				vs++
+			}
+			hx.keys[hx.nk] = hdrIndexKey{int32(start), int32(colon), int32(start + vs), int32(start + nl)}
+			hx.nk++
+			if bit, known := knownHeaderBitBytes(line[:colon]); known {
+				hx.present |= 1 << bit
+			}
+		}
+		if start+nl >= len(hdr) {
+			break
+		}
+		i = start + nl
+	}
+	hx.ok = true
+	return hx
+}
+
+var crlfBytes = []byte("\r\n")
+
+// refresh re-parses only when hdr is a different slice from the one indexed,
+// so a rewrite that returned the same slice costs nothing.
+func (hx *hdrIndex) refresh(hdr []byte) {
+	if hx.ok && hx.n == len(hdr) && hx.data == unsafe.SliceData(hdr) {
+		return
+	}
+	*hx = indexHeader(hdr)
+}
+
+// slice mirrors sliceHeader: the value bytes of key inside hdr, or nil.
+func (hx *hdrIndex) slice(key string, hdr []byte) []byte {
+	if hx == nil || !hx.ok || hx.n != len(hdr) || hx.data != unsafe.SliceData(hdr) {
+		return sliceHeader(key, hdr)
+	}
+	if bit, known := knownHeaderBit(key); known && hx.present&(1<<bit) == 0 {
+		return nil
+	}
+	for i := 0; i < hx.nk; i++ {
+		k := &hx.keys[i]
+		if int(k.kl) == len(key) && string(hdr[k.ks:k.ks+k.kl]) == key {
+			return hdr[k.vs:k.ve]
+		}
+	}
+	return nil
+}
+
+// get mirrors getHeader: a copy of the value, or nil.
+func (hx *hdrIndex) get(key string, hdr []byte) []byte {
+	v := hx.slice(key, hdr)
+	if v == nil {
+		return nil
+	}
+	return append(make([]byte, 0, len(v)), v...)
+}
diff --git a/server/bench_knobs.go b/server/bench_knobs.go
new file mode 100644
index 0000000..a9feec7
--- /dev/null
+++ b/server/bench_knobs.go
@@ -0,0 +1,56 @@
+package server
+
+import (
+	"os"
+	"runtime"
+	"strconv"
+	"time"
+)
+
+// Bench-only knobs, all inert unless set. NATS_BENCH_TLS_COLLAPSE=1 joins the
+// pending outbound buffers of a TLS connection into one write (what the route
+// compression path already does), NATS_BENCH_PROPOSE_COALESCE=<duration> lets a
+// consumer's proposal forwarder gather more entries per append entry, and
+// NATS_BENCH_ACKNONE_PROPOSE_EVERY=<n> replicates an AckNone consumer's
+// delivered cursor every n deliveries instead of every delivery.
+var (
+	benchHdrCache        = os.Getenv("NATS_BENCH_HDR_CACHE") == "1"
+	benchEvictBatch      = int(benchUint("NATS_BENCH_EVICT_BATCH"))
+	benchHdrIndex        = os.Getenv("NATS_BENCH_HDR_INDEX") == "1"
+	benchStageArena      = os.Getenv("NATS_BENCH_STAGE_ARENA") == "1"
+	benchRingIndex       = os.Getenv("NATS_BENCH_RING_INDEX") == "1"
+	benchTLSCollapse     = os.Getenv("NATS_BENCH_TLS_COLLAPSE") == "1"
+	benchProposeCoalesce = benchDuration("NATS_BENCH_PROPOSE_COALESCE")
+	benchAckNoneEvery    = benchUint("NATS_BENCH_ACKNONE_PROPOSE_EVERY")
+	// benchDeliverBatch keeps the consumer lock across up to n deliveries
+	// (0 = one per acquisition, stock); benchSignalCoalesce signals a consumer
+	// once per applied batch instead of once per stored message.
+	benchDeliverBatch   = int(benchUint("NATS_BENCH_DELIVER_BATCH"))
+	benchSignalCoalesce = os.Getenv("NATS_BENCH_SIGNAL_COALESCE") == "1"
+	// benchPrefetch loads up to n messages from the store with the consumer
+	// lock released, then delivers them under one hold (0 = stock path).
+	benchPrefetch = int(benchUint("NATS_BENCH_PREFETCH"))
+	// benchApplyUnlockStore releases the stream lock around the store write
+	// when a committed entry is applied; the single apply goroutine keeps the
+	// order, and the ingest loop no longer queues behind every store copy.
+	benchApplyUnlockStore = os.Getenv("NATS_BENCH_APPLY_UNLOCK_STORE") == "1"
+)
+
+func benchDuration(key string) time.Duration {
+	d, _ := time.ParseDuration(os.Getenv(key))
+	return d
+}
+
+func benchUint(key string) uint64 {
+	n, _ := strconv.ParseUint(os.Getenv(key), 10, 64)
+	return n
+}
+
+// NATS_BENCH_LOCK_PROFILE=1 samples mutex contention (1 in 20) and blocking
+// events of 50us or longer so /debug/pprof/mutex and /block name the locks.
+func init() {
+	if os.Getenv("NATS_BENCH_LOCK_PROFILE") == "1" {
+		runtime.SetMutexProfileFraction(20)
+		runtime.SetBlockProfileRate(50_000)
+	}
+}
diff --git a/server/bench_msgindex.go b/server/bench_msgindex.go
new file mode 100644
index 0000000..b121de6
--- /dev/null
+++ b/server/bench_msgindex.go
@@ -0,0 +1,174 @@
+package server
+
+import "iter"
+
+// BENCH: msgIndex is the memory store's sequence -> message index. The stock
+// map costs a hash insert and delete per message plus periodic rehash
+// (~0.8 us of the leader's serialized budget at 127k msg/s, and a rehash
+// cliff past a million entries). Sequences are contiguous apart from
+// deletions, so with NATS_BENCH_RING_INDEX=1 a power-of-two ring indexed by
+// seq&mask replaces it: O(1) with no hashing, growing only when the span
+// between the lowest and highest live sequence outgrows the ring.
+type msgIndex interface {
+	get(seq uint64) (*StoreMsg, bool)
+	get1(seq uint64) *StoreMsg
+	set(seq uint64, sm *StoreMsg)
+	del(seq uint64)
+	len() int
+	all() iter.Seq[*StoreMsg]
+}
+
+func newMsgIndex() msgIndex {
+	if benchRingIndex {
+		return &ringMsgIndex{buf: make([]*StoreMsg, 1024), mask: 1023}
+	}
+	return mapMsgIndex{}
+}
+
+type mapMsgIndex map[uint64]*StoreMsg
+
+func (m mapMsgIndex) get(seq uint64) (*StoreMsg, bool) { sm, ok := m[seq]; return sm, ok }
+func (m mapMsgIndex) get1(seq uint64) *StoreMsg        { return m[seq] }
+func (m mapMsgIndex) set(seq uint64, sm *StoreMsg)     { m[seq] = sm }
+func (m mapMsgIndex) del(seq uint64)                   { delete(m, seq) }
+func (m mapMsgIndex) len() int                         { return len(m) }
+func (m mapMsgIndex) all() iter.Seq[*StoreMsg] {
+	return func(yield func(*StoreMsg) bool) {
+		for _, sm := range m {
+			if !yield(sm) {
+				return
+			}
+		}
+	}
+}
+
+type ringMsgIndex struct {
+	buf  []*StoreMsg
+	mask uint64
+	base uint64 // lowest live sequence (valid when n > 0)
+	hi   uint64 // highest sequence set since the ring was last empty
+	n    int
+}
+
+func (r *ringMsgIndex) inRange(seq uint64) bool {
+	return r.n > 0 && seq >= r.base && seq-r.base < uint64(len(r.buf))
+}
+
+func (r *ringMsgIndex) get(seq uint64) (*StoreMsg, bool) {
+	if !r.inRange(seq) {
+		return nil, false
+	}
+	sm := r.buf[seq&r.mask]
+	return sm, sm != nil
+}
+
+func (r *ringMsgIndex) get1(seq uint64) *StoreMsg {
+	sm, _ := r.get(seq)
+	return sm
+}
+
+func (r *ringMsgIndex) set(seq uint64, sm *StoreMsg) {
+	if r.n == 0 {
+		r.base, r.hi = seq, seq
+	}
+	if seq < r.base {
+		r.base = seq
+	}
+	if seq > r.hi {
+		r.hi = seq
+	}
+	for r.hi-r.base >= uint64(len(r.buf)) {
+		r.grow()
+	}
+	slot := &r.buf[seq&r.mask]
+	if *slot == nil {
+		r.n++
+	}
+	*slot = sm
+}
+
+func (r *ringMsgIndex) grow() {
+	nbuf := make([]*StoreMsg, 2*len(r.buf))
+	nmask := uint64(len(nbuf) - 1)
+	for _, sm := range r.buf {
+		if sm != nil {
+			nbuf[sm.seq&nmask] = sm
+		}
+	}
+	r.buf, r.mask = nbuf, nmask
+}
+
+func (r *ringMsgIndex) del(seq uint64) {
+	if !r.inRange(seq) {
+		return
+	}
+	slot := &r.buf[seq&r.mask]
+	if *slot == nil {
+		return
+	}
+	*slot = nil
+	r.n--
+	if r.n == 0 {
+		return
+	}
+	if seq == r.base {
+		for r.buf[r.base&r.mask] == nil {
+			r.base++
+		}
+	}
+}
+
+func (r *ringMsgIndex) len() int { return r.n }
+
+func (r *ringMsgIndex) all() iter.Seq[*StoreMsg] {
+	return func(yield func(*StoreMsg) bool) {
+		for _, sm := range r.buf {
+			if sm != nil && !yield(sm) {
+				return
+			}
+		}
+	}
+}
+
+// Nil-safe accessors: the stock code relied on Go's nil-map semantics (zero
+// length, no-op delete, zero-value lookup) after Stop sets ms.msgs to nil.
+func (ms *memStore) idxget(seq uint64) (*StoreMsg, bool) {
+	if ms.msgs == nil {
+		return nil, false
+	}
+	return ms.msgs.get(seq)
+}
+
+func (ms *memStore) idxget1(seq uint64) *StoreMsg {
+	if ms.msgs == nil {
+		return nil
+	}
+	return ms.msgs.get1(seq)
+}
+
+func (ms *memStore) idxset(seq uint64, sm *StoreMsg) {
+	if ms.msgs == nil {
+		ms.msgs = newMsgIndex()
+	}
+	ms.msgs.set(seq, sm)
+}
+
+func (ms *memStore) idxdel(seq uint64) {
+	if ms.msgs != nil {
+		ms.msgs.del(seq)
+	}
+}
+
+func (ms *memStore) idxlen() int {
+	if ms.msgs == nil {
+		return 0
+	}
+	return ms.msgs.len()
+}
+
+func (ms *memStore) idxall() iter.Seq[*StoreMsg] {
+	if ms.msgs == nil {
+		return func(func(*StoreMsg) bool) {}
+	}
+	return ms.msgs.all()
+}
