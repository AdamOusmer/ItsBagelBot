+	for _, m := range cms {
+		seq, subj := m.seq, m.subj
+		m.returnToPool()
+		csl.Match(subj, func(o *consumer) {
+			sigs[o] = append(sigs[o], seq)
+		})
+	}
+	mset.clsMu.RUnlock()
+	for o, seqs := range sigs {
+		o.processStreamSignalBatch(seqs)
+	}
