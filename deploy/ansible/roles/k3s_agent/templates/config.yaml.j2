# Managed by Ansible
server: {{ k3s_url }}
token: {{ k3s_token }}
node-name: {{ fleet_node_name }}
node-ip: {{ ansible_tailscale0.ipv4.address }}
{% if node_external_ip | length > 0 %}
node-external-ip: {{ node_external_ip }}
{% endif %}
flannel-iface: {{ flannel_iface }}
node-label:
  - "topology.kubernetes.io/zone={{ node_zone }}"
  # Every other node carries region as well as zone. A node-label absent from
  # this file is DROPPED when the node re-registers, so omitting it here means a
  # playbook-provisioned node can never match the rest of the fleet.
  - "topology.kubernetes.io/region={{ node_region }}"
  - "itsbagelbot.dev/role={{ node_role }}"
{% if node_role in ['cp', 'worker'] %}
# cp and worker are default-deny: only pods that explicitly tolerate the role
# land there. The plain "node" role is the application tier and stays
# schedulable, so it takes no taint.
node-taint:
  - "itsbagelbot.dev/role={{ node_role }}:NoSchedule"
{% endif %}
kubelet-arg:
  - "protect-kernel-defaults=true"
  - "make-iptables-util-chains=true"
  - "image-gc-high-threshold=55"
  - "image-gc-low-threshold=45"
  - "eviction-hard=memory.available<5%,nodefs.available<1%,imagefs.available<10%"
  - "serialize-image-pulls=true"
