{
  "format": "itsbagelbot.flows",
  "version": 1,
  "flows": [
    {
      "ref": "f1",
      "name": "Hype redeem",
      "definition": {
        "version": 1,
        "trigger": {
          "type": "reward",
          "params": {
            "reward_id": "setup-required"
          }
        },
        "conditions": [
          {
            "type": "users",
            "params": {
              "allow": [
                "_setup_required"
              ]
            }
          }
        ],
        "actions": [
          {
            "type": "chat",
            "params": {
              "text": "{user} redeemed, deaths at {counter:deaths}, {urlfetch:weather}"
            }
          },
          {
            "type": "http_post",
            "params": {
              "url": "https://example.com/setup-required"
            },
            "enabled": false
          },
          {
            "type": "lights",
            "params": {
              "device": "setup-required",
              "sku": "setup-required",
              "device_name": "setup-required",
              "mode": "scene",
              "scene_id": "setup-required",
              "scene_name": "setup-required",
              "scene_type": "setup-required",
              "scene_instance": "setup-required",
              "scene_value": "\"setup-required\""
            },
            "enabled": false
          },
          {
            "type": "run",
            "params": {
              "automation_id": "f2"
            }
          },
          {
            "type": "counter_add",
            "params": {
              "name": "deaths",
              "amount": 1
            }
          }
        ]
      }
    },
    {
      "ref": "f2",
      "name": "Mod helper",
      "definition": {
        "version": 1,
        "trigger": {
          "type": "event",
          "params": {
            "kind": "channel.follow",
            "filters": {
              "user_id": "setup-required"
            }
          }
        },
        "actions": [
          {
            "type": "if",
            "params": {
              "condition": {
                "type": "users",
                "params": {
                  "deny": [
                    "_setup_required"
                  ]
                }
              },
              "then": [
                {
                  "type": "points_add",
                  "params": {
                    "login": "_setup_required",
                    "amount": 500
                  },
                  "enabled": false
                },
                {
                  "type": "shoutout",
                  "params": {
                    "login": "{user}"
                  }
                }
              ],
              "else": [
                {
                  "type": "chat",
                  "params": {
                    "text": "setup-required"
                  },
                  "enabled": false
                },
                {
                  "type": "run",
                  "params": {
                    "automation_id": "f1"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "ref": "f3",
      "name": "Recipes v2",
      "definition": {
        "version": 1,
        "trigger": {
          "type": "command",
          "params": {
            "name": "!v2"
          }
        },
        "queue": "sounds",
        "conditions": [
          {
            "type": "var",
            "params": {
              "scope": "channel",
              "name": "mode",
              "op": "eq",
              "value": "on"
            }
          }
        ],
        "actions": [
          {
            "type": "var_set",
            "params": {
              "scope": "viewer",
              "name": "seen",
              "value": "{user}"
            }
          },
          {
            "type": "var_add",
            "params": {
              "scope": "channel",
              "name": "total",
              "amount": 1
            }
          },
          {
            "type": "var_delete",
            "params": {
              "scope": "channel",
              "name": "old"
            }
          },
          {
            "type": "text",
            "params": {
              "op": "upper",
              "input": "{args}",
              "arg1": "",
              "arg2": "",
              "save_as": "loud"
            }
          },
          {
            "type": "math",
            "params": {
              "expression": "{var:total}*2",
              "save_as": "double"
            }
          },
          {
            "type": "loop",
            "params": {
              "times": "3",
              "actions": [
                {
                  "type": "http_get",
                  "params": {
                    "url": "https://example.com/setup-required",
                    "json_path": [
                      "data",
                      "value"
                    ],
                    "save_as": "answer",
                    "on_ok": [
                      {
                        "type": "chat",
                        "params": {
                          "text": "got {local:answer}"
                        }
                      }
                    ],
                    "on_failure": [
                      {
                        "type": "overlay_sound",
                        "params": {
                          "url": "https://example.com/setup-required",
                          "volume": 40
                        },
                        "enabled": false
                      }
                    ]
                  },
                  "enabled": false
                }
              ]
            }
          },
          {
            "type": "reward_update",
            "params": {
              "reward_id": "setup-required",
              "enabled": false,
              "cost": null,
              "reset_on_stream_end": true
            },
            "enabled": false
          },
          {
            "type": "overlay_show",
            "params": {
              "kind": "text",
              "content": "hello {user}",
              "seconds": 5,
              "position": "top"
            }
          },
          {
            "type": "overlay_show",
            "params": {
              "kind": "image",
              "content": "https://example.com/setup-required",
              "seconds": 5,
              "position": "center"
            },
            "enabled": false
          }
        ]
      }
    }
  ]
}
