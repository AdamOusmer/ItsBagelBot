{
  "name": "web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "kit",
    "marketing",
    "docs",
    "dashboard",
    "admin"
  ],
  "scripts": {
    "build": "bun run --filter dashboard build && bun run --filter admin build",
    "dev:dashboard": "bun run --filter dashboard dev",
    "dev:admin": "bun run --filter admin dev",
    "check": "bun run --filter '*' check",
    "test": "bun test kit dashboard/src/lib/server/oauth-start.test.ts && bun kit/scripts/size.ts",
    "postinstall": "mkdir -p node_modules/@bagel && ln -sfn ../../../ui node_modules/@bagel/ui && bun install --cwd ../ui --frozen-lockfile --production"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.0.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "cookie": "^0.7.0",
    "mysql2": "^3.22.5",
    "sirv": "^3.0.2"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "@opentelemetry/core": "^2.8.0",
    "@sveltejs/kit": {
      "cookie": "^0.7.0"
    }
  }
}
