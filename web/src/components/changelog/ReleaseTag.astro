/**
 * Release-channel label. Each channel is a `.bb-tag` hairline plus its own
 * mark: alpha hollow, beta solid + sweep, pre-release triangle, release dash.
 */
interface Props {
    tag: 'alpha' | 'beta' | 'prerelease' | 'release';
    label: string;
}

const { tag, label } = Astro.props;

const TONE: Record<Props['tag'], string> = {
    alpha: 'bb-tag--alpha',
    beta: 'bb-tag--live',
    prerelease: 'bb-tag--pre',
    release: 'bb-tag--quiet',
};

const MARK: Record<Props['tag'], string> = {
    alpha: 'bb-mark bb-mark--hollow',
    beta: 'bb-mark',
    prerelease: 'bb-mark bb-mark--up',
    release: 'bb-mark bb-mark--dash',
};
---

<span class:list={['rtag', `rtag--${tag}`, 'bb-tag', TONE[tag]]}>
    <i class={MARK[tag]} aria-hidden="true"></i>
    {label}
    {tag === 'beta' && <i class="bb-sweep" aria-hidden="true"></i>}
</span>

<style>
    /* Was a translucent pill per channel (hatched alpha, glowing 50% dot on a
       sine pulse for beta, gradient-border ember for pre-release). All four
       now ride the shared .bb-tag hairline, so only the row fit stays local:
       the 7px hairline gap sits the label above the centre of the version
       chip next to it, and 3px puts the two texts back on the same line. */
    .rtag {
        flex-shrink: 0;
        top: 3px;
    }
</style>
