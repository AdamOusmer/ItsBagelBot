/**
 * Games — game integrations bento grid.
 * Shows Minecraft (Hypixel Bedwars + MCSR Ranked), Fortnite, Valorant,
 * Clash Royale, and a call-to-action for requesting more games.
 */
import Card from '../ui/Card.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// The affiliation note names the Minecraft account the Hypixel API key belongs
// to. `{ign}` marks where the linked handle sits so each locale keeps it in its
// own prose order; the profile link is the public proof of that ownership.
const IGN = 'ItsMavey';
const IGN_PROFILE = `https://namemc.com/profile/${IGN}`;
const [legalBefore, legalAfter = ''] = t('games.legal').split('{ign}');
---

<section class="games" id="integrations">
    <SectionHeading eyebrow={t('games.eyebrow')} title={t('games.title')} />

    <div class="games__grid">
        <!-- Minecraft: Hypixel Bedwars + MCSR Ranked -->
        <Card class="games__card" label={t('games.mcCh')} data-reveal>
            <div class="games__demo games__demo--mc" slot="band" aria-hidden="true">
                <div class="games-mc__group games-mc__group--bw">
                    <span class="games-mc__line games-mc__line--bw">!bwstats player123</span>
                    <div class="games-mc__stats games-mc__stats--bw">
                        <span class="games-mc__stat"><b>Level</b> 402</span>
                        <span class="games-mc__stat"><b>Wins</b> 2,541</span>
                        <span class="games-mc__stat"><b>FKDR</b> 4.82</span>
                    </div>
                </div>
                <div class="games-mc__group games-mc__group--mcsr">
                    <span class="games-mc__line games-mc__line--mcsr">!mcsr ranked</span>
                    <div class="games-mc__stats games-mc__stats--mcsr">
                        <span class="games-mc__stat"><b>Elo</b> 1520</span>
                        <span class="games-mc__stat"><b>W/L</b> 142/98</span>
                    </div>
                </div>
            </div>
            <h3 class="games__title">
                {t('games.mcTitle')}
            </h3>
            <p class="games__desc">{t('games.mcDesc')}</p>
        </Card>

        <!-- Fortnite -->
        <Card class="games__card" label={t('games.fnCh')} data-reveal style="--reveal-i: 1">
            <div class="games__demo games__demo--fn" slot="band" aria-hidden="true">
                <svg class="games-fn__scar" viewBox="0 0 220 72" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg">
                    <!-- stock -->
                    <path d="M10 32 L30 29 L30 47 L14 50 Z" />
                    <path d="M14 36 L27 34.5" stroke-width="1.5" />
                    <!-- receiver -->
                    <path d="M30 27 H134 V47 H30 Z" />
                    <!-- top rail + ticks -->
                    <path d="M34 27 V22 H128 V27" />
                    <path d="M44 22 v3 M56 22 v3 M68 22 v3 M80 22 v3 M92 22 v3 M104 22 v3 M116 22 v3" stroke-width="1.5" />
                    <!-- rear sight + charging handle -->
                    <path d="M40 22 v-5 h7 v5" />
                    <path d="M62 22 v-4" />
                    <!-- ejection port -->
                    <path d="M84 33 h20 v7 H84 Z" stroke-width="1.5" />
                    <!-- trigger guard + grip -->
                    <path d="M76 47 q1 9 10 9 h8" />
                    <path d="M98 47 L94 64 L104 66 L109 47" />
                    <!-- magazine -->
                    <path d="M112 47 C110 57 114 64 123 66 L133 62 C128 56 128 51 129 47 Z" />
                    <!-- barrel + front sight + muzzle -->
                    <path d="M134 31 H184 M134 41 H184" />
                    <path d="M152 31 v-8 h7 v8" />
                    <path d="M184 28 h16 l4 4 v6 l-4 4 h-12 Z" />
                    <path d="M190 32 v8 M196 32 v8" stroke-width="1.5" />
                </svg>
                <div class="games-fn__meta">
                    <span class="games-fn__rarity">Legendary</span>
                    <span class="games-fn__price">
                        <svg viewBox="0 0 12 12" width="11" height="11" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="6" cy="6" r="2" fill="currentColor"/></svg>
                        1,200
                    </span>
                </div>
            </div>
            <h3 class="games__title">
                {t('games.fnTitle')}
            </h3>
            <p class="games__desc">{t('games.fnDesc')}</p>
        </Card>

        <!-- Valorant -->
        <Card class="games__card" label={t('games.valCh')} data-reveal style="--reveal-i: 2">
            <div class="games__demo games__demo--val" slot="band" aria-hidden="true">
                <span class="games-val__line">!valrank Frosty#EUW1</span>
                <div class="games-val__stats">
                    <span class="games-val__stat"><b>Tier</b> Immortal 2</span>
                    <span class="games-val__stat"><b>RR</b> 67</span>
                    <span class="games-val__stat"><b>Peak</b> Immortal 1</span>
                </div>
            </div>
            <h3 class="games__title">
                {t('games.valTitle')}
            </h3>
            <p class="games__desc">{t('games.valDesc')}</p>
        </Card>

        <!-- Clash Royale -->
        <Card class="games__card" label={t('games.crCh')} data-reveal style="--reveal-i: 3">
            <div class="games__demo games__demo--cr" slot="band" aria-hidden="true">
                <span class="games-cr__line">!cr #P2LQ0GR</span>
                <div class="games-cr__stats">
                    <span class="games-cr__stat"><b>Level</b> 62</span>
                    <span class="games-cr__stat"><b>W/L</b> 600/300</span>
                    <span class="games-cr__stat"><b>WR</b> 60%</span>
                </div>
            </div>
            <h3 class="games__title">
                {t('games.crTitle')}
            </h3>
            <p class="games__desc">{t('games.crDesc')}</p>
        </Card>

        <!-- Request more games -->
        <Card class="games__card games__card--req" label={t('games.reqCh')} data-reveal style="--reveal-i: 4">
            <div class="games__demo games__demo--req" slot="band" aria-hidden="true">
                <a href="https://github.com/AdamOusmer/ItsBagelBot/issues/new" target="_blank" rel="noopener noreferrer" class="games-req__btn">
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                    </svg>
                    New Issue
                </a>
            </div>
            <h3 class="games__title">{t('games.reqTitle')}</h3>
            <p class="games__desc">{t('games.reqDesc')}</p>
        </Card>
    </div>

    <p class="games__legal">{legalBefore}<a
        class="games__legal-link"
        href={IGN_PROFILE}
        target="_blank"
        rel="noopener noreferrer"
    >{IGN}</a>{legalAfter}</p>
</section>

<style>
    .games {
        position: relative;
        padding: var(--space-section, 96px) 24px;
        max-width: var(--content-max, 1200px);
        margin: 0 auto;
        z-index: 3;
    }

    .games__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
    }

    @media (min-width: 720px) {
        .games__grid { grid-template-columns: repeat(3, 1fr); }
        /* Five cards on a three-column grid: the request tile stretches over
           the two columns the second row leaves free. */
        .games__card--req { grid-column: span 2; }
    }

    .games__title {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        font-family: var(--font-display, "Syne", sans-serif);
        font-size: 1.06rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--white, #f0ece4);
        margin: 0 0 8px;
    }

    .badge-incoming {
        display: inline-flex;
        align-items: center;
        padding: 5px 12px;
        border-radius: 100px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(82, 183, 136, 0.4);
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.65rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--green-glow, #52b788);
    }

    .games__desc {
        font-family: var(--font-body, "DM Sans", sans-serif);
        font-size: 0.86rem;
        line-height: 1.6;
        color: var(--muted, #888077);
        margin: 0;
    }

    /* ── Demo stage shared ── */

    /* Demos live in the Card's housing band (slot="band"); the band owns the
       chrome and outer padding. Height matches the band's 104px minimum. */
    .games__demo {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        min-height: 72px;
        overflow: hidden;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.74rem;
    }

    /* ── Minecraft (Bedwars ⇄ MCSR alternating) ── */

    .games__demo--mc {
        position: relative;
    }

    .games-mc__group {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        padding: 14px 16px;
    }

    .games-mc__line {
        color: var(--tan-light, #e0c49a);
        font-weight: 500;
        width: max-content;
        border-right: 1px solid rgba(224, 196, 154, 0.6);
        white-space: nowrap;
        overflow: hidden;
    }

    .games-mc__line--bw {
        animation: gamesTypeMcBw 12s steps(17) infinite;
    }

    .games-mc__line--mcsr {
        opacity: 0;
        animation: gamesTypeMcMcsr 12s steps(12) infinite;
    }

    .games-mc__stats {
        display: flex;
        gap: 12px;
        color: var(--green-glow, #52b788);
        opacity: 0;
        transform: translateY(4px);
    }

    .games-mc__stats--bw {
        animation: gamesFadeMcBw 12s ease-in-out infinite;
    }

    .games-mc__stats--mcsr {
        animation: gamesFadeMcMcsr 12s ease-in-out infinite;
    }

    .games-mc__stat b {
        color: var(--muted, #888077);
        font-weight: 400;
        margin-right: 4px;
    }

    /* ── Fortnite (item-shop tile, original line-art SCAR) ── */

    .games__demo--fn {
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
    }

    .games-fn__scar {
        width: 158px;
        height: auto;
        color: var(--tan-light, #e0c49a);
        filter: drop-shadow(0 0 10px rgba(224, 196, 154, 0.22));
        animation: gamesFnFloat 4.5s ease-in-out infinite;
    }

    .games-fn__meta {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .games-fn__rarity {
        color: var(--green-glow, #52b788);
        font-size: 0.66rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .games-fn__price {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--muted, #888077);
        font-size: 0.7rem;
    }

    /* ── Valorant & Clash Royale (typed command + stat chips) ── */

    .games-val__line,
    .games-cr__line {
        color: var(--tan-light, #e0c49a);
        font-weight: 500;
        width: max-content;
        border-right: 1px solid rgba(224, 196, 154, 0.6);
        white-space: nowrap;
        overflow: hidden;
    }

    .games-val__stats,
    .games-cr__stats {
        display: flex;
        gap: 12px;
        color: var(--green-glow, #52b788);
        opacity: 0;
        transform: translateY(4px);
    }

    .games-val__stat b,
    .games-cr__stat b {
        color: var(--muted, #888077);
        font-weight: 400;
        margin-right: 4px;
    }

    .games-val__line { animation: gamesTypeVal 12s steps(20) infinite; }
    .games-cr__line { animation: gamesTypeCr 12s steps(12) infinite; }
    .games-val__stats { animation: gamesFadeVal 12s ease-in-out infinite; }
    .games-cr__stats { animation: gamesFadeCr 12s ease-in-out infinite; }

    /* ── Request ── */

    .games__demo--req {
        align-items: center;
    }

    .games-req__btn {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--tan-light, #e0c49a);
        background: rgba(201, 168, 124, 0.1);
        border: 1px solid rgba(201, 168, 124, 0.2);
        padding: 8px 16px;
        border-radius: 6px;
        text-decoration: none;
        font-family: var(--font-body, "DM Sans", sans-serif);
        font-weight: 500;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .games-req__btn:hover {
        background: rgba(201, 168, 124, 0.2);
        border-color: rgba(201, 168, 124, 0.4);
        transform: translateY(-1px);
        color: var(--white, #f0ece4);
    }

    /* ── Animations ── */

    /* Minecraft card: first half of the 12s cycle is Bedwars, second half MCSR. */
    @keyframes gamesTypeMcBw {
        0%, 4% { width: 0; opacity: 1; }
        13%, 42% { width: 17ch; opacity: 1; }
        47%, 100% { width: 17ch; opacity: 0; }
    }

    @keyframes gamesFadeMcBw {
        0%, 14% { opacity: 0; transform: translateY(4px); }
        20%, 42% { opacity: 1; transform: none; }
        47%, 100% { opacity: 0; transform: translateY(4px); }
    }

    @keyframes gamesTypeMcMcsr {
        0%, 52% { width: 0; opacity: 0; }
        54% { width: 0; opacity: 1; }
        62%, 92% { width: 12ch; opacity: 1; }
        97%, 100% { width: 12ch; opacity: 0; }
    }

    @keyframes gamesFadeMcMcsr {
        0%, 63% { opacity: 0; transform: translateY(4px); }
        69%, 92% { opacity: 1; transform: none; }
        97%, 100% { opacity: 0; transform: translateY(4px); }
    }

    @keyframes gamesFnFloat {
        0%, 100% { transform: translateY(1.5px); }
        50% { transform: translateY(-1.5px); }
    }

    /* Valorant: "!valrank Frosty#EUW1" types out over the first fifth of the
       12s cycle, holds most of it, then resets. */
    @keyframes gamesTypeVal {
        0%, 4% { width: 0; opacity: 1; }
        20%, 88% { width: 20ch; opacity: 1; }
        94%, 100% { width: 20ch; opacity: 0; }
    }

    @keyframes gamesFadeVal {
        0%, 24% { opacity: 0; transform: translateY(4px); }
        32%, 84% { opacity: 1; transform: none; }
        92%, 100% { opacity: 0; transform: translateY(4px); }
    }

    /* Clash Royale: same cadence as the Valorant tile for "!cr #P2LQ0GR". */
    @keyframes gamesTypeCr {
        0%, 4% { width: 0; opacity: 1; }
        16%, 88% { width: 12ch; opacity: 1; }
        94%, 100% { width: 12ch; opacity: 0; }
    }

    @keyframes gamesFadeCr {
        0%, 22% { opacity: 0; transform: translateY(4px); }
        30%, 84% { opacity: 1; transform: none; }
        92%, 100% { opacity: 0; transform: translateY(4px); }
    }

    /* ── Legal ── */

    .games__legal {
        margin: 28px auto 0;
        max-width: 720px;
        text-align: center;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.62rem;
        letter-spacing: 0.02em;
        line-height: 1.7;
        color: var(--muted, #888077);
        opacity: 0.75;
    }

    .games__legal-link {
        color: var(--tan-light, #e0c49a);
        text-decoration: underline;
        text-decoration-color: rgba(224, 196, 154, 0.4);
        text-underline-offset: 2px;
        transition: color 180ms ease, text-decoration-color 180ms ease;
    }

    .games__legal-link:is(:hover, :focus-visible) {
        color: var(--white, #f0ece4);
        text-decoration-color: rgba(240, 236, 228, 0.7);
    }

    @media (prefers-reduced-motion: reduce) {
        .games-mc__line {
            animation: none;
            border-right: none;
        }
        .games-mc__line--bw { width: 17ch; opacity: 1; }
        .games-mc__stats--bw {
            animation: none;
            opacity: 1;
            transform: none;
        }
        /* Static fallback shows the Bedwars half only. */
        .games-mc__group--mcsr { display: none; }
        .games-fn__scar { animation: none; }
        .games-val__line,
        .games-cr__line {
            animation: none;
            border-right: none;
        }
        .games-val__line { width: 20ch; opacity: 1; }
        .games-cr__line { width: 12ch; opacity: 1; }
        .games-val__stats,
        .games-cr__stats {
            animation: none;
            opacity: 1;
            transform: none;
        }
    }

    @media (max-width: 640px) {
        .games { padding: var(--space-section-sm, 72px) 20px; }
        .games-mc__stats { flex-wrap: wrap; gap: 8px; }
    }
</style>
