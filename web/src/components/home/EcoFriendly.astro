/**
 * EcoFriendly: one slim band, not a section.
 *
 * It used to be a full section heading over a single 560px card, which said
 * "Powered by Sustainable Energy" three times over (section title, card title,
 * body) and spent a 96px band and a 160px card housing to carry two sentences
 * and two links. The facts are worth stating; they are not worth a full
 * chapter between Game Integrations and the letter. Stated once now, in a
 * band roughly half the old height.
 */
import Icon from '../ui/Icon.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="eco" id="eco-friendly">
    <div class="eco__band" data-reveal>
        <span class="eco__glyph" aria-hidden="true">
            <Icon name="leaf" size={40} strokeWidth={1.5} class="eco__leaf" />
        </span>

        <div class="eco__body">
            <span class="eco__eyebrow">{t('eco.eyebrow')}</span>
            <h2 class="eco__title">{t('eco.title')}</h2>
            <p class="eco__desc">{t('eco.desc')}</p>
        </div>

        <div class="eco__links">
            <a href="https://www.websitecarbon.com/website/itsbagelbot-com/" target="_blank" rel="noopener noreferrer">
                Website Carbon: ItsBagelBot
            </a>
            <a href="https://www.websitecarbon.com/website/dashboard-itsbagelbot-com-login/" target="_blank" rel="noopener noreferrer">
                Website Carbon: Dashboard
            </a>
        </div>
    </div>
</section>

<style>
    .eco {
        position: relative;
        padding: 40px 24px;
        max-width: var(--content-max, 1200px);
        margin: 0 auto;
        z-index: 3;
    }

    .eco__band {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 24px;
        max-width: 960px;
        margin: 0 auto;
        padding: 22px 26px;
        border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
        border-radius: var(--radius-md);
    }

    .eco__glyph {
        display: inline-flex;
        line-height: 0;
    }

    .eco__eyebrow {
        display: block;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--green-glow, #52b788);
        margin-bottom: 8px;
    }

    .eco__title {
        font-family: var(--font-display, "Syne", sans-serif);
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        line-height: 1.2;
        color: var(--white, #f0ece4);
        margin: 0 0 6px;
    }

    .eco__desc {
        font-family: var(--font-body, "DM Sans", sans-serif);
        font-size: 0.92rem;
        line-height: 1.6;
        color: var(--muted, #888077);
        margin: 0;
    }

    .eco__links {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.78rem;
        white-space: nowrap;
    }

    .eco__links a {
        color: var(--green-glow, #52b788);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .eco__links a:hover {
        color: var(--white, #f0ece4);
    }

    /* :global because the glyph is Icon's root svg: Astro scopes this
       component's rules to its own elements, and the child's root carries no
       scope attribute of ours. The draw runs on that svg rather than its paths,
       which come from the generated icon map via set:html and are scoped to
       nothing at all; stroke-dasharray and stroke-dashoffset inherit, so the
       svg hands both to blade and stem. The stem is the shorter of Lucide's two
       paths, so it lands last and still reads as a leaf growing out of its
       stalk. */
    .eco__glyph :global(.eco__leaf) {
        width: 40px;
        height: 40px;
        color: var(--green-glow, #52b788);
        filter: drop-shadow(0 0 12px rgba(82, 183, 136, 0.35));
        stroke-dasharray: 64;
        stroke-dashoffset: 64;
        animation: drawLeaf 3s ease-out forwards;
    }

    @keyframes drawLeaf {
        to { stroke-dashoffset: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .eco__glyph :global(.eco__leaf) { animation: none; stroke-dashoffset: 0; }
    }

    @media (max-width: 860px) {
        .eco__band {
            grid-template-columns: auto minmax(0, 1fr);
            gap: 18px;
        }

        .eco__links {
            grid-column: 1 / -1;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 16px;
            white-space: normal;
        }
    }

    @media (max-width: 520px) {
        .eco {
            padding: 32px 18px;
        }

        .eco__band {
            grid-template-columns: minmax(0, 1fr);
            padding: 20px;
        }

        .eco__links {
            flex-direction: column;
            gap: 10px;
        }
    }
</style>
