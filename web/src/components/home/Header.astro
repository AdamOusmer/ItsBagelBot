import { getLangFromUrl, useTranslations, defaultLang } from '../../i18n/ui';
import ScrollCue from './ScrollCue.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---


<header>

    <div class="bg" aria-hidden="true">
        <div class="bg-ring">
            <svg viewBox="0 0 800 800" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M400 400 Q 550 200 650 400 Q 750 600 550 700 Q 350 800 200 650 Q 50 500 150 300 Q 250 100 450 150 Q 650 200 700 400 Q 750 600 600 720 Q 450 840 280 760 Q 110 680 80 500 Q 50 320 180 200 Q 310 80 480 120"
                      stroke="url(#g1)" stroke-width="2.5" fill="none"/>
                <path d="M400 400 Q 240 220 150 400 Q 60 580 240 680 Q 420 780 560 660 Q 700 540 680 360 Q 660 180 480 140 Q 300 100 180 240 Q 60 380 120 560 Q 180 740 360 780"
                      stroke="url(#g2)" stroke-width="1.5" fill="none"/>
                <defs>
                    <linearGradient id="g1" x1="0" y1="0" x2="800" y2="800" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#c9a87c" offset="0"/>
                        <stop offset="1" stop-color="#2d6a4f"/>
                    </linearGradient>
                    <linearGradient id="g2" x1="800" y1="0" x2="0" y2="800" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#40916c" offset="0"/>
                        <stop offset="1" stop-color="#c9a87c"/>
                    </linearGradient>
                </defs>
            </svg>
        </div>

        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
    </div>


    <div class="header-material">
        <a class="eyebrow" href="https://discord.gg/SZ2remwSDv" target="_blank" rel="noopener noreferrer">
            <span class="eyebrow__badge">
                <span class="eyebrow__dot"></span>{t('hero.devBadge')}
            </span>
            <span class="eyebrow__text">{t('hero.topText')}</span>
        </a>

        <div class="split">
            {/* Each line is split into glyph spans so the intro can roll them
                in one by one; the full title lives in aria-label and the
                visual lines are hidden from AT. */}
            <h1 aria-label={`${t('hero.title1')} ${t('hero.title2')} ${t('hero.title3')}`} data-hero-title>
                {[
                    { text: t('hero.title1'), cls: 'tan' },
                    { text: t('hero.title2'), cls: '' },
                    { text: t('hero.title3'), cls: 'green' },
                ].map((line) => (
                    <span class:list={['line', line.cls]} aria-hidden="true" data-hero-line>
                        {Array.from(line.text).map((glyph) => (
                            <span class="glyph" data-hero-glyph>{glyph === ' ' ? ' ' : glyph}</span>
                        ))}
                    </span>
                ))}
            </h1>

            <div class="aside">
                <p>
                    {t('hero.lede')}
                </p>

                <!-- Trust signals as bare mono text, not pills: bordered chips under
                     the lede competed with the h1, and each fact has a full section
                     further down anyway. The import line stays a whisper on purpose —
                     it only needs to tell switchers the door exists. -->
                <div class="facts">
                    <span>{t('hero.badge1')}</span>
                    <span>{t('hero.badge2')}</span>
                    <span>{t('hero.badge3')}</span>
                    <span>{t('hero.badge4')}</span>
                </div>

                <a class="migrate" href={`https://dashboard.itsbagelbot.com/settings/import${lang === defaultLang ? '' : `?lang=${lang}`}`}>
                    {t('hero.migrateText')}<span class="migrate__arrow" aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </div>

    <ScrollCue />

</header>

<script>
    import { animate, stagger, cubicBezier } from "motion";

    // Title intro: each line's glyphs roll up out of a per-line mask with a
    // slight tilt and a blur that burns off; the trailing period on every line
    // pops in last with a back-eased overshoot and a one-shot glow. CSS keeps
    // glyphs hidden pre-intro only under (scripting: enabled) and
    // (prefers-reduced-motion: no-preference), so no-JS and reduced-motion
    // visitors get the static headline with zero flash.
    const LINE_DELAY_BASE = 0.35;
    const LINE_DELAY_STEP = 0.16;
    const GLYPH_STAGGER = 0.024;
    const easeOutQuint = cubicBezier(0.22, 1, 0.36, 1);
    const easeBackOut = cubicBezier(0.34, 1.56, 0.64, 1);

    function heroTitleIntro(): void {
        const h1 = document.querySelector<HTMLElement>('[data-hero-title]');
        if (!h1 || h1.dataset.heroMotionReady === 'true') return;
        h1.dataset.heroMotionReady = 'true';

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        h1.querySelectorAll<HTMLElement>('[data-hero-line]').forEach((line, lineIndex) => {
            const glyphs = Array.from(line.querySelectorAll<HTMLElement>('[data-hero-glyph]'));
            if (!glyphs.length) return;

            const lineDelay = LINE_DELAY_BASE + lineIndex * LINE_DELAY_STEP;
            const period = glyphs[glyphs.length - 1];
            const letters = glyphs.slice(0, -1);

            animate(
                letters,
                {
                    transform: ['translateY(118%) rotate(6deg)', 'translateY(0%) rotate(0deg)'],
                    opacity: [0, 1],
                    filter: ['blur(6px)', 'blur(0px)'],
                },
                {
                    delay: stagger(GLYPH_STAGGER, { startDelay: lineDelay }),
                    duration: 0.8,
                    ease: easeOutQuint,
                },
            );

            // The period lands after its line settles: scale overshoot plus a
            // brief glow that fades as it seats.
            const periodDelay = lineDelay + letters.length * GLYPH_STAGGER + 0.18;
            animate(
                period,
                {
                    transform: ['translateY(0%) scale(0)', 'translateY(0%) scale(1)'],
                    opacity: [0, 1],
                },
                { delay: periodDelay, duration: 0.55, ease: easeBackOut },
            );
            animate(
                period,
                {
                    textShadow: [
                        '0 0 0px rgba(245, 230, 207, 0)',
                        '0 0 28px rgba(245, 230, 207, 0.85)',
                        '0 0 0px rgba(245, 230, 207, 0)',
                    ],
                },
                { delay: periodDelay, duration: 0.9, ease: 'easeOut' },
            );
        });
    }

    heroTitleIntro();
    document.addEventListener('astro:page-load', heroTitleIntro);
</script>

<style>

    header {
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: max(96px, 12vh) 50px 48px;
        position: sticky;
        top: 0;
        z-index: 5;
        overflow: hidden;
        pointer-events: none;
    }

    .header-material {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: min(100%, 1200px);
        opacity: max(0, calc(1 - var(--hero-p, 0) * 1.5));
        transform: scale(calc(1 - var(--hero-p, 0) * 0.15));
        filter: blur(calc(var(--hero-p, 0) * 12px));
        transform-origin: center;
        will-change: var(--hero-content-will-change, opacity, transform, filter);
    }

    .eyebrow,
    .migrate,
    .actions a,
    header button {
        pointer-events: var(--hero-ui-pointer-events, auto);
    }

    /* display:contents keeps the stacked phone layout identical to the old
       markup; the 2b desktop block at the end of this sheet turns it into the
       editorial grid. That block stays LAST — an earlier attempt sat above the
       base rules and silently lost the cascade. */
    .split {
        display: contents;
    }

    .bg {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
    }

    /* 2b: the ring drifts off the right edge instead of sitting behind the
       copy; the max-width 900px block re-centers it for stacked layouts. */
    .bg-ring {
        position: absolute;
        top: 50%;
        right: -180px;
        width: 760px;
        height: 760px;
        opacity: max(0, calc(0.1 - var(--hero-p, 0) * 0.15));
        transform: translateY(-50%) scale(calc(1 - var(--hero-p, 0) * 0.15));
        filter: blur(calc(var(--hero-p, 0) * 12px));
        transform-origin: center;
        will-change: var(--hero-content-will-change, opacity, transform, filter);
    }

    svg {
        width: 100%;
        height: 100%;
        animation: slowspin 40s linear infinite;
        animation-play-state: var(--hero-animation-state, running);
    }

    .orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        --orb-scroll-glow: min(calc(var(--hero-p, 0) * 0.24), calc((1 - var(--hero-p, 0)) * 0.28));
        opacity: max(0, calc(0.16 - var(--hero-p, 0) * 0.16), var(--orb-scroll-glow));
        transform: translate3d(var(--orb-shift-x), var(--orb-shift-y), 0) scale(calc(1 - var(--hero-p, 0) * 0.82));
        transform-origin: center;
        will-change: var(--hero-orb-will-change, opacity, transform);
    }

    .orb::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: inherit;
        animation: pulse 5s ease-in-out infinite;
        animation-play-state: var(--hero-animation-state, running);
    }

    .orb::after {
        content: "";
        position: absolute;
        inset: 8%;
        border-radius: inherit;
        background: radial-gradient(circle, var(--orb-glow-core) 0 24%, var(--orb-glow-soft) 48%, transparent 72%);
        opacity: min(calc(var(--hero-p, 0) * 1.2), calc((1 - var(--hero-p, 0)) * 1.1));
        transform: scale(calc(0.42 + var(--hero-p, 0) * 1.35));
        transform-origin: center;
        will-change: opacity, transform;
    }

    /* 2b: glows trade corners — green rides top-right above the ring, tan
       warms bottom-left under the headline. Shift math still converges each
       orb on the viewport center as --hero-p climbs. */
    .orb-1 {
        width: 500px;
        height: 500px;
        background: var(--green);
        top: -120px;
        right: -60px;
        --orb-glow-core: rgba(167, 243, 208, 0.85);
        --orb-glow-soft: rgba(82, 183, 136, 0.34);
        --orb-shift-x: calc(var(--hero-p, 0) * (-50vw + 190px));
        --orb-shift-y: calc(var(--hero-p, 0) * (50vh - 130px));
    }

    .orb-1::before {
        animation-delay: 0s;
    }

    .orb-2 {
        width: 400px;
        height: 400px;
        background: var(--tan);
        bottom: -100px;
        left: -80px;
        --orb-glow-core: rgba(245, 230, 207, 0.78);
        --orb-glow-soft: rgba(201, 168, 124, 0.32);
        --orb-shift-x: calc(var(--hero-p, 0) * (50vw - 120px));
        --orb-shift-y: calc(var(--hero-p, 0) * (-50vh + 100px));
    }

    .orb-2::before {
        animation-delay: 400ms;
    }


    @keyframes slowspin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }

    @keyframes pulse {
        0%, 100% {
            opacity: 0.55;
            transform: scale(1);
        }
        50% {
            opacity: 1;
            transform: scale(1.1);
        }
    }


    /* Status and tagline share one line, and the whole line is the Discord
       invite. The old standalone dev banner sat between the lede and the badge
       row and cost ~90px in a hero that had none to give. */
    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        text-decoration: none;
        opacity: 0;
        animation: fadeUp 800ms 200ms var(--ease-out-expo) forwards;
    }

    .eyebrow__badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
        padding: 4px 11px;
        border-radius: 20px;
        background: rgba(45, 106, 79, 0.15);
        border: 1px solid rgba(64, 145, 108, 0.30);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--green-light);
        transition: border-color 0.2s;
    }

    .eyebrow__dot {
        width: 7px;
        height: 7px;
        flex-shrink: 0;
        border-radius: 50%;
        background: var(--green-glow);
        animation: pulse-dot 1.8s ease-in-out infinite;
        animation-play-state: var(--hero-animation-state, running);
    }

    .eyebrow__text {
        font-family: var(--font-mono);
        font-size: 0.9rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--green-glow);
        transition: color 0.2s;
    }

    .eyebrow:hover .eyebrow__badge {
        border-color: rgba(64, 145, 108, 0.7);
    }

    .eyebrow:hover .eyebrow__text {
        color: var(--white);
    }

    /* No block-level fadeUp here any more — the intro script rolls the title
       in glyph by glyph, so the h1 itself stays static. */
    h1 {
        font-family: var(--font-display);
        font-size: clamp(3rem, min(9vw, 15vh), 8rem);
        font-weight: 800;
        line-height: 0.9;
        letter-spacing: 0;
        margin-bottom: 24px;
        position: relative;
    }

    h1 .line {
        display: block;
        white-space: nowrap;
        /* Mask for the glyph roll-in. The padding/margin pair keeps the tight
           0.9 line-height while giving descenders room inside the clip box. */
        overflow: hidden;
        padding-block: 0.12em;
        margin-block: -0.12em;
    }

    h1 .line.tan {
        color: var(--tan);
    }

    h1 .line.green {
        color: var(--green-glow);
    }

    h1 .glyph {
        display: inline-block;
        transform-origin: 20% 80%;
    }

    /* Hide glyphs pre-intro only when the script that reveals them can run,
       and never for reduced-motion users — no-JS and reduced-motion both get
       the static headline instantly. */
    @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
        h1 .glyph {
            opacity: 0;
            transform: translateY(118%) rotate(6deg);
        }
    }

    .actions {
        display: flex;
        gap: 40px;
    }

    p {
        max-width: 550px;
        font-size: 1.05rem;
        line-height: 1.75;
        color: #b0a898;
        margin-bottom: 24px;
        opacity: 0;
        animation: fadeUp 0.9s 0.5s var(--ease-out-expo) forwards;
        position: relative;
    }

    .facts {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        margin-top: 26px;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(201, 168, 124, 0.66);
        opacity: 0;
        animation: fadeUp 0.9s 0.65s var(--ease-out-expo) forwards;
        position: relative;
    }

    /* Separator via ::after on the leading spans, not ::before on the
       trailing ones: when the row wraps, the dot then ends the first line
       instead of orphaning at the start of the second. */
    .facts span:not(:last-child)::after {
        content: "·";
        margin: 0 16px;
        color: rgba(201, 168, 124, 0.4);
    }

    .migrate {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 18px;
        font-size: 0.85rem;
        color: var(--green-light);
        text-decoration: none;
        opacity: 0;
        animation: fadeUp 0.9s 0.8s var(--ease-out-expo) forwards;
        position: relative;
        transition: color 0.2s;
    }

    .migrate__arrow {
        transition: transform 0.25s var(--ease-out-expo);
    }

    .migrate:hover {
        color: var(--white);
    }

    .migrate:hover .migrate__arrow {
        transform: translateX(4px);
    }

    @keyframes pulse-dot {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.30;
            transform: scale(0.75);
        }
    }

    @keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Short viewports (720p laptops) have no spare vertical room: the copy
       already overflows its own padding box, the eyebrow line lands within 1px
       of the fixed 76px nav, and the ScrollCue needs a gutter under the import line.
       Tightening these two margins by 24px total buys ~12px at each end, since
       the overflow is split evenly above and below by justify-content: center. */
    @media (max-height: 820px) {
        h1 {
            margin-bottom: 16px;
        }

        .facts {
            margin-top: 16px;
        }

        .migrate {
            margin-top: 12px;
        }
    }

    @media (max-width: 900px) {
        header {
            padding: clamp(72px, 10vh, 92px) 24px 28px;
        }

        .header-material {
            width: min(100%, 680px);
        }

        .bg-ring {
            top: 53%;
            left: 50%;
            right: auto;
            width: clamp(440px, 128vw, 620px);
            height: clamp(440px, 128vw, 620px);
            opacity: max(0, calc(0.08 - var(--hero-p, 0) * 0.13));
            transform: translate(-50%, -50%) scale(calc(1 - var(--hero-p, 0) * 0.15));
        }

        h1 {
            font-size: clamp(1.9rem, min(9vw, 8.4vh), 4.2rem);
            line-height: 0.96;
            margin-bottom: 18px;
        }

        /* Neither tagline fits beside the badge at this width (the French one
           is 40 characters), and letting it wrap in a row leaves the badge
           floating against a two-line block. Stack instead. */
        .eyebrow {
            flex-direction: column;
            gap: 8px;
            margin-bottom: 14px;
        }

        .eyebrow__text {
            text-align: center;
        }

        .eyebrow__text {
            font-size: 0.78rem;
            letter-spacing: 0.16em;
        }

        .eyebrow__badge {
            padding: 3px 9px;
            font-size: 0.62rem;
        }

        .aside > p {
            max-width: min(520px, 100%);
            font-size: 0.98rem;
            line-height: 1.58;
            margin-bottom: 18px;
        }

        .facts {
            margin-top: 18px;
            font-size: 0.6rem;
            letter-spacing: 0.11em;
        }

        .facts span:not(:last-child)::after {
            margin: 0 11px;
        }

        .migrate {
            margin-top: 14px;
            font-size: 0.8rem;
        }

        .actions {
            flex-direction: column;
            gap: 20px;
        }
    }

    @media (max-width: 480px) {
        header {
            padding: clamp(68px, 10vh, 84px) 18px 20px;
        }

        .bg-ring {
            top: 50%;
            width: clamp(380px, 118vw, 500px);
            height: clamp(380px, 118vw, 500px);
        }

        .eyebrow {
            gap: 8px;
            margin-bottom: 12px;
        }

        .eyebrow__text {
            font-size: 0.68rem;
            letter-spacing: 0.14em;
        }

        .eyebrow__dot {
            width: 6px;
            height: 6px;
        }

        h1 {
            font-size: clamp(1.75rem, min(8.4vw, 7.6vh), 2.25rem);
            margin-bottom: 16px;
        }

        .aside > p {
            font-size: 0.92rem;
            line-height: 1.52;
            margin-bottom: 16px;
        }

        .facts {
            margin-top: 14px;
            font-size: 0.56rem;
        }

        .facts span:not(:last-child)::after {
            margin: 0 8px;
        }

        .migrate {
            margin-top: 12px;
            font-size: 0.76rem;
        }
    }

    @media (max-width: 380px) and (max-height: 700px) {
        header {
            padding-top: 66px;
            padding-bottom: 16px;
        }

        .facts {
            margin-top: 12px;
        }

        .migrate {
            margin-top: 10px;
        }
    }

    /* ── 2b "Editorial left" — desktop only. Keep this block last. ── */
    @media (min-width: 901px) {
        .header-material {
            align-items: flex-start;
            text-align: left;
            /* The centered hero capped at 1200px; the 88px Syne headline is
               ~890px alone, so the grid needs the full row for its aside. */
            width: 100%;
        }

        .split {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 56px;
            align-items: end;
            width: 100%;
        }

        .split h1 {
            margin-bottom: 0;
            font-size: clamp(3rem, min(6.1vw, 13vh), 5.5rem);
        }

        .aside {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            padding-bottom: 10px;
        }

        .aside p {
            max-width: 380px;
            margin-bottom: 24px;
        }

        .eyebrow {
            align-self: flex-start;
            margin-bottom: 36px;
        }

        .facts {
            justify-content: flex-start;
            margin-top: 0;
            text-align: left;
        }

        .migrate {
            margin-top: 16px;
        }
    }




</style>
