/**
 * SocialRail: a quiet vertical stack of social icons tucked into the
 * bottom-left corner, sitting just above the Brackets ornament's bl corner
 * (same 24px inline inset) so it reads as part of the frame, not a widget.
 * Glyphs come from Simple Icons through the generated map in src/lib/icons.ts;
 * Icon still inlines them at build, so the strict img-src CSP never sees an
 * external asset and the brand bodies inherit the tan tint.
 */
import Icon from '../ui/Icon.astro';

const socials = [
    { label: 'Discord', href: 'https://discord.gg/SZ2remwSDv', icon: 'discord' },
    { label: 'X', href: 'https://x.com/itsbagelbot', icon: 'x' },
    { label: 'TikTok', href: 'https://tiktok.com/@itsbagelbot', icon: 'tiktok' },
    { label: 'YouTube', href: 'https://youtube.com/@itsbagelbot', icon: 'youtube' },
    { label: 'GitHub', href: 'https://github.com/AdamOusmer/ItsBagelBot', icon: 'github' },
] as const;
---

<aside class="social-rail" aria-label="Social links">
    {socials.map(({ label, href, icon }) => (
        <a href={href} aria-label={label} title={label} target="_blank" rel="noopener noreferrer">
            <Icon name={icon} size={17} />
        </a>
    ))}
</aside>

<style>
    .social-rail {
        position: fixed;
        /* Matches the Brackets ornament: --ornament-inline 24px, corner sits
           at bottom 24px with a 40px arm, the stack rests just above it. */
        left: 24px;
        bottom: 76px;
        z-index: 40; /* under the nav (50) so the mobile menu overlays it */
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .social-rail a {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        color: var(--tan);
        opacity: 0.45;
        transition: opacity 0.2s ease, color 0.2s ease;
    }

    .social-rail a:hover,
    .social-rail a:focus-visible {
        opacity: 1;
        color: var(--tan-light);
    }

    .social-rail a:focus-visible {
        outline: 1px solid var(--tan);
        outline-offset: 2px;
    }

    /* Narrow viewports: rail would crowd the content column. */
    @media (max-width: 900px) {
        .social-rail {
            display: none;
        }
    }
</style>
