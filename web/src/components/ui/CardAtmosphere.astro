/**
 * Card atmosphere: the instrument-panel light (QuietWork Cards, variant 3a).
 * The ring and sheen geometry is shared with the console's CardAtmosphere.svelte
 * (console/shared/styles/card-atmosphere.css) so the two surfaces cannot drift
 * apart on a look that is meant to be the same material in both places.
 *
 * What is genuinely this site's, and stays below: the layer sits at z-index 0
 * inside the card's own stacking context, and hover brightens on every card
 * shape the site draws (.card, .gcard, .clog__item), because marketing cards
 * are links. The console gates the same hover on .hoverable instead.
 *
 * Inside a `.card__band` housing the arc re-parks to band scale (see
 * Card.astro); on a flat card it keeps the card-scale geometry.
 *
 * The card itself still owns the border and lift.
 */
import '@bagel/styles/card-atmosphere.css';
---

<div class="card-atmo" aria-hidden="true">
    <span class="card-atmo__ring"></span>
    <span class="card-atmo__sheen"></span>
</div>

<style>
    .card-atmo {
        z-index: 0;
        --card-atmo-ease: var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
    }

    /* Even siblings flip so neighbouring cards don't share one corner glow.
       scaleX on this layer only, body copy is a sibling, not a child. */
    :global(.card:nth-child(even)) .card-atmo,
    :global(.gcard:nth-child(even)) .card-atmo,
    :global(.clog__item:nth-child(even) .clog__card) .card-atmo {
        transform: scaleX(-1);
    }

    :global(.card:hover) .card-atmo,
    :global(.gcard:hover) .card-atmo,
    :global(.clog__item:hover) .card-atmo,
    :global(.card:focus-visible) .card-atmo,
    :global(.gcard:focus-visible) .card-atmo {
        --card-atmo-glow: 1.6;
        --card-atmo-ring: 0.24;
    }
</style>
