interface Props {
    label: string;
}

const { label } = Astro.props;
---

<!-- Was a translucent green pill (.badge-incoming); status decorations lose the pill under the bb-* system. -->
<span class="bb-tag bb-tag--incoming"><i class="bb-mark bb-mark--plus" aria-hidden="true"></i>{label}</span>
