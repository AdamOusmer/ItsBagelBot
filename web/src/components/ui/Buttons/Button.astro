// One link-button. MainButton and SecondaryButton were the same component
// twice over, differing only in the modifier class they printed, so the
// difference is a prop instead: two files could (and did) drift apart on
// everything the modifier does not name.
//
// The variant is the modifier suffix, not a free-form class: `bb-btn--primary`
// and `bb-btn--quiet` are the only two the button system in style.css draws,
// and naming them here keeps a caller from inventing a third that renders bare.
interface Props {
    href?: string;
    label?: string;
    variant?: 'primary' | 'quiet';
}

const { href, label, variant = 'primary' } = Astro.props;
---

<a class={`bb-btn bb-btn--${variant}`} href={href}>{label}</a>
