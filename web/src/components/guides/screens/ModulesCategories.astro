/**
 * The Modules page read as a catalogue: no search box, the category rail on
 * Community, and tiles from Community and Games with one open. Module names
 * and descriptions stay English in every locale, matching the dashboard.
 */
interface Props {
    labels?: Record<string, string>;
}

const { labels = {} } = Astro.props;
const L = {
    console: 'Console',
    crumbPage: 'Modules',
    account: 'streamer · Broadcaster',
    eyebrow: 'Manage',
    titleHtml: 'Channel <i>modules</i>',
    sub: 'Optional features for your channel. 1 of 20 enabled.',
    railTitle: 'Categories',
    rail1: 'Chat Tools',
    rail2: 'Community',
    rail3: 'Games',
    cat1: 'Community',
    cat2: 'Games',
    tile1Name: 'Chat Alerts',
    tile1Cat: 'Community',
    tile1Desc: 'Announce follows, subs, cheers and raids in chat.',
    tile2Name: 'Loyalty Points',
    tile2Cat: 'Community',
    tile2Desc: 'Viewers earn channel currency for subs, cheers and watch time.',
    tile3Name: 'Bedwars Stats',
    tile3Cat: 'Games',
    tile3Desc: 'Hypixel Bedwars stats, urchin score and blacklist tags in chat.',
    tile4Name: 'MCSR Ranked',
    tile4Cat: 'Games',
    tile4Desc: 'Ranked elo and per-stream session stats for MCSR runners.',
    configure: 'Configure',
    dockOverview: 'Overview',
    dockCommands: 'Commands',
    dockModules: 'Modules',
    dockBilling: 'Billing',
    dockSettings: 'Settings',
    ...labels,
};
---

<div class="df-main">
    <div class="df-topbar"><span class="df-brand">ItsBagelBot <small>{L.console}</small></span><span class="df-crumb">ItsBagelBot / <b>{L.crumbPage}</b></span><span class="df-account">{L.account}</span></div>
    <span class="df-eyebrow">{L.eyebrow}</span>
    <p class="df-title" set:html={L.titleHtml}></p>
    <p class="df-sub">{L.sub}</p>
    <div class="df-cols df-cols--rail">
        <div class="df-rail"><b>{L.railTitle}</b><span>{L.rail1}</span><span class="is-active">{L.rail2}</span><span>{L.rail3}</span></div>
        <div style="display:grid; gap:10px; align-content:start;">
            <span class="df-cat">{L.cat1}</span>
            <div class="df-grid">
                <div class="df-tile"><div class="df-tile-head"><span><b>{L.tile1Name}</b><small>{L.tile1Cat}</small></span></div><small>{L.tile1Desc}</small><div class="df-tile-foot"><span class="df-btn--configure">{L.configure}</span><span class="df-toggle is-on"></span></div><i class="df-dot" style="top:10px; right:10px;">1</i></div>
                <div class="df-tile is-open"><div class="df-tile-head"><span><b>{L.tile2Name}</b><small>{L.tile2Cat}</small></span></div><small>{L.tile2Desc}</small><div class="df-tile-foot"><span class="df-btn--configure">{L.configure}</span><span class="df-toggle"></span></div><i class="df-dot" style="top:10px; right:10px;">2</i></div>
            </div>
            <span class="df-cat">{L.cat2}</span>
            <div class="df-grid">
                <div class="df-tile"><div class="df-tile-head"><span><b>{L.tile3Name}</b><small>{L.tile3Cat}</small></span></div><small>{L.tile3Desc}</small><div class="df-tile-foot"><span class="df-btn--configure">{L.configure}</span><span class="df-toggle"></span></div></div>
                <div class="df-tile"><div class="df-tile-head"><span><b>{L.tile4Name}</b><small>{L.tile4Cat}</small></span></div><small>{L.tile4Desc}</small><div class="df-tile-foot"><span class="df-btn--configure">{L.configure}</span><span class="df-toggle"></span></div></div>
            </div>
        </div>
    </div>
    <div class="df-dock"><span>{L.dockOverview}</span><span>{L.dockCommands}</span><span class="is-active">{L.dockModules}</span><span>{L.dockBilling}</span><span>{L.dockSettings}</span></div>
</div>
