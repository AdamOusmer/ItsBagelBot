/**
 * The Counters page "new counter" panel: a name, the scope picker, and the
 * plain-language reminder of where a counter gets bumped from.
 */
interface Props {
    labels?: Record<string, string>;
}

const { labels = {} } = Astro.props;
const L = {
    panelHead: 'New counter',
    fieldName: 'Name',
    nameValue: 'deaths',
    fieldCounts: 'Counts',
    countsValue: 'One total for the channel',
    chip1: 'whole channel',
    chip2: 'per user',
    chip3: 'per command',
    chip4: 'per user + command',
    hint: 'Bump it with &#123;counter:deaths&#125; in a command response, from a channel-point reward, or with !counter add.',
    cancel: 'Cancel',
    create: '✓ Create counter',
    ...labels,
};
---

<div class="df-main" style="max-width:420px; margin:0 auto;">
    <div class="df-panel">
        <div class="df-panel-head">{L.panelHead} <i>✕</i></div>
        <div class="df-field"><span>{L.fieldName}</span><div class="df-input">{L.nameValue}<i class="df-dot" style="position:static; margin-left:auto;">1</i></div></div>
        <div class="df-field">
            <span>{L.fieldCounts}</span>
            <div class="df-input">{L.countsValue}<i class="df-dot" style="position:static; margin-left:auto;">2</i></div>
        </div>
        <div class="df-chips"><i>{L.chip1}</i><i>{L.chip2}</i><i>{L.chip3}</i><i>{L.chip4}</i></div>
        <p style="font-family:var(--font-body); font-size:0.66rem; color:var(--muted); margin:0;">
            <Fragment set:html={L.hint} /><i class="df-dot" style="position:static; margin-left:auto; display:inline-grid; vertical-align:middle;">3</i>
        </p>
        <div class="df-panel-foot"><span class="df-btn df-btn--ghost">{L.cancel}</span><span class="df-btn df-btn--tan">{L.create}</span></div>
    </div>
</div>
