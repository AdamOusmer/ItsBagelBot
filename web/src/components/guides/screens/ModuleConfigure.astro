/**
 * What Configure opens: one module's own page, drawn here with Chat Alerts.
 * Module status on top with the switch that turns the whole thing on or off,
 * then the six alert replies as rows with their own switches, then the reply
 * editor docked on the right with the chat rehearsal under the message.
 *
 * The component name is the one reserved in lib/guides/types.ts, kept as is
 * so no other guide's content file has to change. Module names, alert labels
 * and default messages stay English in every locale, matching the dashboard.
 */
import Icon from '../../ui/Icon.astro';

interface Props {
    labels?: Record<string, string>;
}

const { labels = {} } = Astro.props;
const L = {
    console: 'Console',
    crumbPage: 'Modules / Chat Alerts',
    account: 'streamer · Broadcaster',
    eyebrow: 'Module',
    titleHtml: 'Chat <i>Alerts</i>',
    sub: 'The bot posts a chat line when someone follows, subscribes, cheers, or raids, and can announce ad breaks.',
    statusLabel: 'Module status',
    statusHelp: 'Turn this module on or off for your channel.',
    statusOn: 'On',
    repliesLabel: 'Replies',
    row1Name: 'Follow alert',
    row1Text: 'Thank you for following the channel, {user}!',
    row2Name: 'Subscribe alert',
    row2Text: 'Welcome to the community, {user}! Thank you for subscribing!',
    row3Name: 'Gift sub alert',
    row3Text: '{user} just gifted {count} subs to the community! Thank you!',
    row4Name: 'Cheer alert',
    row4Text: 'Thank you for the {bits} bits, {user}!',
    row5Name: 'Raid alert',
    row5Text: '{user} is raiding the channel with {viewers} viewers! Welcome everyone!',
    row6Name: 'Ad break alert',
    row6Text: "Ads are rolling for {duration} seconds. Hang tight, we'll be right back!",
    panelHead: 'Follow alert',
    closeLabel: 'Close',
    fieldMessage: 'Follow alert message',
    messageHtml: 'Thank you for following the channel, <span class="df-var">&#123;user&#125;</span>!',
    blankHint: 'Leave blank to use the default message.',
    chatTag: 'Chat rehearsal',
    systemText: 'sesame_sam followed the channel',
    botName: 'ItsBagelBot',
    botHtml: 'Thank you for following the channel, <mark>sesame_sam</mark>!',
    cancel: 'Cancel',
    save: 'Save changes',
    dockOverview: 'Overview',
    dockCommands: 'Commands',
    dockModules: 'Modules',
    dockBilling: 'Billing',
    dockSettings: 'Settings',
    ...labels,
};
---

<div class="df-main">
    <div class="df-topbar"><span class="df-brand">ItsBagelBot <small>{L.console}</small></span><span class="df-crumb">ItsBagelBot / <b>{L.crumbPage}</b></span><span class="df-account">{L.account}</span></div>
    <span class="df-eyebrow">{L.eyebrow}</span>
    <p class="df-title" set:html={L.titleHtml}></p>
    <p class="df-sub">{L.sub}</p>
    <div class="df-row">
        <span class="df-grow"><b>{L.statusLabel}</b><br /><small style="color:var(--muted, #888077);">{L.statusHelp}</small></span>
        <span class="df-pill df-pill--on">{L.statusOn}</span>
        <span class="df-toggle is-on"></span>
        <i class="df-mark" data-note="1"></i>
    </div>
    <div class="df-cols">
        <div style="display:grid; gap:8px; align-content:start;">
            <span class="df-meta">{L.repliesLabel}</span>
            <div class="df-row is-open"><span class="df-num">01</span><span class="df-grow"><b>{L.row1Name}</b> {L.row1Text}</span><span class="df-toggle is-on"></span><i class="df-mark" data-note="2"></i></div>
            <div class="df-row"><span class="df-num">02</span><span class="df-grow"><b>{L.row2Name}</b> {L.row2Text}</span><span class="df-toggle is-on"></span></div>
            <div class="df-row"><span class="df-num">03</span><span class="df-grow"><b>{L.row3Name}</b> {L.row3Text}</span><span class="df-toggle is-on"></span></div>
            <div class="df-row"><span class="df-num">04</span><span class="df-grow"><b>{L.row4Name}</b> {L.row4Text}</span><span class="df-toggle is-on"></span></div>
            <div class="df-row"><span class="df-num">05</span><span class="df-grow"><b>{L.row5Name}</b> {L.row5Text}</span><span class="df-toggle is-on"></span></div>
            <div class="df-row"><span class="df-num">06</span><span class="df-grow"><b>{L.row6Name}</b> {L.row6Text}</span><span class="df-toggle"></span><i class="df-mark" data-note="3"></i></div>
        </div>
        <div class="df-panel">
            <div class="df-panel-head">{L.panelHead} <Icon name="x" size={12} /></div>
            <div class="df-field"><span>{L.fieldMessage}</span><div class="df-input is-focus"><span set:html={L.messageHtml}></span><i class="df-mark" data-note="4"></i></div></div>
            <div class="df-field"><span><small>{L.blankHint}</small></span></div>
            <div class="df-chat">
                <span class="df-chat-tag">{L.chatTag}</span>
                <p class="df-viewer"><span>{L.systemText}</span></p>
                <p class="df-bot"><b>{L.botName}</b><span set:html={L.botHtml}></span></p>
                <i class="df-mark" data-note="5"></i>
            </div>
            <div class="df-panel-foot"><span class="df-btn df-btn--ghost">{L.cancel}</span><span class="df-btn df-btn--tan">{L.save}</span></div>
        </div>
    </div>
    <div class="df-dock"><span>{L.dockOverview}</span><span>{L.dockCommands}</span><span class="is-active">{L.dockModules}</span><span>{L.dockBilling}</span><span>{L.dockSettings}</span></div>
</div>
