/**
 * The command editor panel on its own, every field annotated: name, alternate
 * names, response, chat rehearsal, access, cooldown, the user restriction and
 * the two switches.
 */
interface Props {
    labels?: Record<string, string>;
}

const { labels = {} } = Astro.props;
const L = {
    panelHead: 'Edit command',
    fieldName: 'Name',
    nameValue: 'hug',
    fieldAlts: 'Alternate names',
    optional: '(optional)',
    altChip: 'cuddle ✕',
    fieldResponse: 'Response',
    responseHtml: '<span class="df-var">&#123;user&#125;</span> gives <span class="df-var">&#123;touser&#125;</span> a warm bagel hug 🥯',
    chip1: '&#123;user&#125;',
    chip2: '&#123;target&#125;',
    chip3: '&#123;random&#125;',
    chatTag: 'Chat rehearsal',
    viewerName: 'sesame_sam',
    viewerText: '!hug ferret_king',
    botName: 'ItsBagelBot',
    botHtml: '<mark>sesame_sam</mark> gives <mark>ferret_king</mark> a warm bagel hug 🥯',
    fieldAccess: 'Access',
    accessValue: 'Everyone',
    fieldCooldown: 'Cooldown (s)',
    cooldownValue: '10',
    fieldRestrict: 'Restrict to user ID',
    restrictPlaceholder: 'Twitch user ID. Only they can run it',
    checkActive: 'Active',
    checkLive: 'Only while live',
    cancel: 'Cancel',
    save: '✓ Save changes',
    ...labels,
};
---

<div class="df-main" style="max-width:420px; margin:0 auto;">
    <div class="df-panel">
        <div class="df-panel-head">{L.panelHead} <i>✕</i></div>
        <div class="df-field"><span>{L.fieldName}</span><div class="df-input">{L.nameValue}<i class="df-dot" style="position:static; margin-left:auto;">1</i></div></div>
        <div class="df-field"><span>{L.fieldAlts} <small>{L.optional}</small></span><div class="df-input"><span class="df-pill df-pill--tan">{L.altChip}</span><i class="df-dot" style="position:static; margin-left:auto;">2</i></div></div>
        <div class="df-field"><span>{L.fieldResponse}</span><div class="df-input"><span set:html={L.responseHtml}></span><i class="df-dot" style="position:static; margin-left:auto;">3</i></div></div>
        <div class="df-chips"><i set:html={L.chip1}></i><i set:html={L.chip2}></i><i set:html={L.chip3}></i></div>
        <div class="df-chat">
            <span class="df-chat-tag">{L.chatTag}</span>
            <p class="df-viewer"><b>{L.viewerName}</b><span>{L.viewerText}</span></p>
            <p class="df-bot"><b>{L.botName}</b><span set:html={L.botHtml}></span></p>
            <i class="df-dot" style="top:-10px; right:8px;">4</i>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
            <div class="df-field"><span>{L.fieldAccess}</span><div class="df-input">{L.accessValue}</div></div>
            <div class="df-field"><span>{L.fieldCooldown}</span><div class="df-input">{L.cooldownValue}<i class="df-dot" style="position:static; margin-left:auto;">5</i></div></div>
        </div>
        <div class="df-field"><span>{L.fieldRestrict} <small>{L.optional}</small></span><div class="df-input is-placeholder">{L.restrictPlaceholder}</div></div>
        <span class="df-check is-on">{L.checkActive}</span>
        <span class="df-check">{L.checkLive} <i class="df-dot" style="position:static; margin-left:auto;">6</i></span>
        <div class="df-panel-foot"><span class="df-btn df-btn--ghost">{L.cancel}</span><span class="df-btn df-btn--tan">{L.save}</span></div>
    </div>
</div>
