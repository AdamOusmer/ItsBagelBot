/**
 * GuideCard: one entry on the guides hub. Built on the shared banded
 * ui/Card: the index is the housing's mono channel label, the guide's own
 * chips (the tokens and commands it teaches) are the band's visual, body
 * copy is title, description and a meta strip (reading time · section
 * count) so a reader can budget attention before committing: the hub is a
 * menu, not a maze. Hover, lift and atmosphere all come from Card now.
 */
import Card from '../ui/Card.astro';

interface Props {
    index: string;
    href: string;
    title: string;
    description: string;
    meta: string;
    /** Small mono chips naming what's inside (e.g. "!commands", "variables"). */
    chips?: string[];
    revealIndex?: number;
}

const { index, href, title, description, meta, chips = [], revealIndex = 0 } = Astro.props;
---

<Card as="a" href={href} label={index} class="gcard" data-reveal style={`--reveal-i: ${revealIndex}`}>
    {chips.length > 0 && (
        <span class="gcard__chips" slot="band" aria-hidden="true">
            {chips.map((chip) => <i class="bb-tag bb-tag--bare">{chip}</i>)}
        </span>
    )}
    <b class="gcard__title">{title}</b>
    <p class="gcard__desc">{description}</p>
    <span class="gcard__meta">{meta}</span>
</Card>

<style>
    .gcard__chips {
        display: flex;
        flex-wrap: wrap;
        align-content: center;
        gap: 10px;
    }

    /* .bb-tag--bare handles the box; only the colour stays local, same
       convention as ChatMock's badge and DashFrame's legend dots. */
    .gcard__chips i {
        font-style: normal;
        color: var(--tan-light, #e0c49a);
    }

    .gcard__title {
        display: block;
        font-family: var(--font-display, "Syne", sans-serif);
        font-size: clamp(1.05rem, 2vw, 1.3rem);
        font-weight: 700;
        letter-spacing: -0.015em;
        color: var(--white, #f0ece4);
        margin-bottom: 8px;
    }

    .gcard__desc {
        font-family: var(--font-body, "DM Sans", sans-serif);
        font-size: 0.96rem;
        line-height: 1.65;
        color: #a39c92;
        max-width: 58ch;
        margin-bottom: 14px;
    }

    .gcard__meta {
        display: block;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        color: var(--muted, #888077);
        white-space: nowrap;
    }
</style>
