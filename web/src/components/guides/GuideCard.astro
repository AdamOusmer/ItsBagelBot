/**
 * GuideCard: one row on the guides hub. A flat plate on purpose (no band, no
 * atmosphere, no lift): five of them stack, and five glowing housings read as
 * a wall. The whole row is the link, but the row carries data-cursor="quiet"
 * so the custom cursor does not stamp itself onto 700px of card; the button
 * inside is the one element that takes the morph, and it fills on row hover
 * so the affordance is obvious from anywhere on the row. The button is a
 * <span>: an <a> inside an <a> is not allowed.
 */
interface Props {
    index: string;
    href: string;
    title: string;
    description: string;
    meta: string;
    /** Small mono chips naming what's inside (e.g. "!commands", "variables"). */
    chips?: string[];
    /** Button label, from the hub content (same in every row). */
    cta: string;
    revealIndex?: number;
}

const { index, href, title, description, meta, chips = [], cta, revealIndex = 0 } = Astro.props;
---

<a class="gcard" href={href} data-cursor="quiet" data-reveal style={`--reveal-i: ${revealIndex}`}>
    <span class="gcard__index" aria-hidden="true">{index}</span>
    <span class="gcard__body">
        <b class="gcard__title">{title}</b>
        <span class="gcard__desc">{description}</span>
        <span class="gcard__meta">
            <span>{meta}</span>
            {chips.map((chip) => <i class="bb-tag bb-tag--bare">{chip}</i>)}
        </span>
    </span>
    <span class="gcard__btn" data-cursor>{cta}</span>
</a>

<style>
    .gcard {
        display: grid;
        grid-template-columns: 44px 1fr auto;
        align-items: center;
        gap: 20px 24px;
        padding: 24px 26px;
        background: var(--card-bg, #111110);
        border: 1px solid var(--border, rgba(201, 168, 124, 0.15));
        border-radius: var(--radius-card, 16px);
        text-decoration: none;
        transition: border-color 360ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
    }

    .gcard__index {
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.78rem;
        letter-spacing: 0.12em;
        color: var(--tan, #c9a87c);
        align-self: start;
        padding-top: 4px;
    }

    .gcard__body {
        display: block;
        min-width: 0;
    }

    .gcard__title {
        display: block;
        font-family: var(--font-display, "Syne", sans-serif);
        font-size: clamp(1.1rem, 2vw, 1.35rem);
        font-weight: 700;
        letter-spacing: -0.015em;
        color: var(--white, #f0ece4);
        margin-bottom: 6px;
    }

    .gcard__desc {
        display: block;
        font-family: var(--font-body, "DM Sans", sans-serif);
        font-size: 0.96rem;
        line-height: 1.6;
        color: #a39c92;
        max-width: 60ch;
        margin-bottom: 12px;
    }

    .gcard__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 10px;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        color: var(--muted, #888077);
    }

    .gcard__meta i {
        font-style: normal;
        color: var(--tan-light, #e0c49a);
    }

    /* Same shape as ui/Buttons/SecondaryButton, as a span. */
    .gcard__btn {
        justify-self: end;
        white-space: nowrap;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.74rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 10px 18px;
        border: 1px solid var(--tan, #c9a87c);
        border-radius: 4px;
        color: var(--tan-light, #e0c49a);
        transition:
            background 240ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)),
            color 240ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
    }

    @media (hover: hover) and (pointer: fine) {
        .gcard:hover { border-color: rgba(201, 168, 124, 0.38); }
        .gcard:hover .gcard__btn { background: var(--tan, #c9a87c); color: var(--black, #0a0a0a); }
    }

    .gcard:focus-visible {
        outline: 2px solid var(--green-glow, #52b788);
        outline-offset: 3px;
    }

    @media (max-width: 640px) {
        .gcard {
            grid-template-columns: 1fr;
            gap: 10px;
            padding: 20px;
        }
        .gcard__index { padding-top: 0; }
        .gcard__btn { justify-self: start; }
    }

    @media (prefers-reduced-motion: reduce) {
        .gcard, .gcard__btn { transition: none; }
    }
</style>
