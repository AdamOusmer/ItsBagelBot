/**
 * FetchBudget: how many real requests a busy command actually sends. Two
 * numbers drive it, both from the live limits: a good answer is cached for
 * 30 seconds, so one definition can send at most 2 requests a minute however
 * hard chat runs the command, and a channel is allowed 6 requests a minute
 * across every definition it owns.
 *
 * The static markup already carries the answer for the default slider value,
 * so the block still teaches the arithmetic with scripting off.
 */
interface Props {
    labels?: Record<string, string>;
    props?: Record<string, unknown>;
}

const { labels = {}, props = {} } = Astro.props;
const L = {
    runsLabel: 'Viewers run the command',
    runsUnit: 'times per minute',
    sourcesLabel: 'Data sources your commands quote',
    fetchesLabel: 'Requests your API actually receives',
    fetchesUnit: 'per minute',
    cachedLabel: 'Answered from the 30-second cache',
    blockedLabel: 'Refused by the 6 per minute channel cap',
    blockedLine: 'Those runs print [source unavailable] in chat.',
    why: 'The cache is there for your API key. Your quota, and every other channel pointed at the same host, would burn out in an evening otherwise.',
    ...labels,
};
const runs = typeof props.runs === 'number' ? props.runs : 12;
const sources = 1;
const perDefinition = Math.min(runs, 2);
const wanted = perDefinition * sources;
const made = Math.min(wanted, 6);
---

<div class="gbudget" data-fetchbudget>
    <div class="gbudget__controls">
        <label class="gbudget__field">
            <span class="gbudget__label">{L.runsLabel}</span>
            <input type="range" min="1" max="60" value={runs} data-fb-runs />
            <output class="gbudget__out" data-fb-runs-out>{runs} {L.runsUnit}</output>
        </label>
        <fieldset class="gbudget__field">
            <legend class="gbudget__label">{L.sourcesLabel}</legend>
            <div class="gbudget__radios">
                {[1, 2, 3, 4].map((n) => (
                    <label class="gbudget__radio">
                        <input type="radio" name="fb-sources" value={String(n)} checked={n === sources} data-fb-sources />
                        <span>{n}</span>
                    </label>
                ))}
            </div>
        </fieldset>
    </div>
    <dl class="gbudget__readout" aria-live="polite">
        <div>
            <dt>{L.fetchesLabel}</dt>
            <dd><b data-fb-made>{made}</b> <i>{L.fetchesUnit}</i></dd>
        </div>
        <div>
            <dt>{L.cachedLabel}</dt>
            <dd><b data-fb-cached>{runs * sources - wanted}</b> <i>{L.fetchesUnit}</i></dd>
        </div>
        <div data-fb-blocked-row hidden={wanted <= 6}>
            <dt>{L.blockedLabel}</dt>
            <dd><b data-fb-blocked>{wanted - made}</b> <i>{L.fetchesUnit}</i></dd>
        </div>
    </dl>
    <p class="gbudget__note" data-fb-blocked-line hidden={wanted <= 6}>{L.blockedLine}</p>
    <p class="gbudget__note">{L.why}</p>
</div>

<style>
    .gbudget { display: grid; gap: 14px; margin: 22px 0; padding: 15px 16px; border: 1px solid var(--border, rgba(201, 168, 124, 0.15)); border-radius: var(--radius-lg); background: rgba(17, 17, 16, 0.6); }
    .gbudget__controls { display: grid; gap: 14px; }
    @media (min-width: 720px) { .gbudget__controls { grid-template-columns: 1.4fr 1fr; align-items: start; } }
    .gbudget__field { display: grid; gap: 7px; margin: 0; padding: 0; border: 0; }
    .gbudget__label { font-family: var(--font-mono, "DM Mono", monospace); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted, #888077); padding: 0; }
    .gbudget__field input[type="range"] { width: 100%; accent-color: var(--tan, #c9a87c); }
    .gbudget__out { font-family: var(--font-body, "DM Sans", sans-serif); font-size: 0.82rem; color: var(--white, #f0ece4); }
    .gbudget__radios { display: flex; gap: 6px; }
    .gbudget__radio { display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px; border: 1px solid var(--border, rgba(201, 168, 124, 0.15)); border-radius: var(--radius-pill); font-family: var(--font-mono, "DM Mono", monospace); font-size: 0.72rem; color: var(--tan-light, #e0c49a); cursor: pointer; }
    .gbudget__radio input { accent-color: var(--green-glow, #52b788); }
    .gbudget__readout { display: grid; gap: 9px; margin: 0; padding: 11px 12px; border: 1px solid var(--border, rgba(201, 168, 124, 0.15)); border-radius: var(--radius-sm); background: rgba(10, 10, 10, 0.5); }
    .gbudget__readout > div { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 10px; }
    .gbudget__readout dt { font-family: var(--font-body, "DM Sans", sans-serif); font-size: 0.82rem; color: var(--muted, #888077); }
    .gbudget__readout dd { margin: 0; display: flex; align-items: baseline; gap: 6px; }
    .gbudget__readout b { font-family: var(--font-display, "Syne", sans-serif); font-size: 1.5rem; color: var(--tan-light, #e0c49a); }
    .gbudget__readout i { font-style: normal; font-family: var(--font-mono, "DM Mono", monospace); font-size: 0.62rem; color: var(--muted, #888077); }
    .gbudget__note { margin: 0; font-family: var(--font-body, "DM Sans", sans-serif); font-size: 0.86rem; line-height: 1.6; color: #a39c92; }
</style>

<script>
    // Bundled by Astro, so it satisfies the site's script-src 'self' CSP.
    // A cached answer lives 30 s, so one definition sends at most 2 requests a
    // minute; the channel is capped at 6 across all of its definitions.
    const CACHE_CEILING = 2;
    const CHANNEL_CAP = 6;

    function setupFetchBudget(root: HTMLElement) {
        const runsInput = root.querySelector<HTMLInputElement>('[data-fb-runs]')!;
        const runsOut = root.querySelector<HTMLOutputElement>('[data-fb-runs-out]')!;
        const unit = runsOut.textContent!.replace(/^\s*\d+\s*/, '');
        const sourceInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-fb-sources]'));
        const made = root.querySelector<HTMLElement>('[data-fb-made]')!;
        const cached = root.querySelector<HTMLElement>('[data-fb-cached]')!;
        const blocked = root.querySelector<HTMLElement>('[data-fb-blocked]')!;
        const blockedRow = root.querySelector<HTMLElement>('[data-fb-blocked-row]')!;
        const blockedLine = root.querySelector<HTMLElement>('[data-fb-blocked-line]')!;

        function update() {
            const runs = Number(runsInput.value);
            const sources = Number(sourceInputs.find((i) => i.checked)?.value ?? 1);
            const wanted = Math.min(runs, CACHE_CEILING) * sources;
            const actual = Math.min(wanted, CHANNEL_CAP);
            runsOut.textContent = `${runs} ${unit}`;
            made.textContent = String(actual);
            cached.textContent = String(runs * sources - wanted);
            blocked.textContent = String(wanted - actual);
            blockedRow.hidden = wanted <= CHANNEL_CAP;
            blockedLine.hidden = wanted <= CHANNEL_CAP;
        }

        runsInput.addEventListener('input', update);
        sourceInputs.forEach((input) => input.addEventListener('change', update));
        update();
    }

    // The site runs the ClientRouter, so a guide can arrive by DOM swap as
    // well as by a full load. Wiring on astro:page-load covers both, and the
    // data-ready flag keeps a second pass from binding the same widget twice.
    function setupAll() {
        document.querySelectorAll<HTMLElement>('[data-fetchbudget]').forEach((root) => {
            if (root.dataset.ready === '1') return;
            root.dataset.ready = '1';
            setupFetchBudget(root);
        });
    }

    setupAll();
    document.addEventListener('astro:page-load', setupAll);
</script>
