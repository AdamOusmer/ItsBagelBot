/**
 * DashFrame: an annotated, hand-built "screenshot" of the dashboard for the
 * guides. Pure CSS, no images: a browser window (address bar only)
 * wraps a mock UI the page composes in the slot from the df-* helper classes
 * below. Invisible anchors (`<i class="df-mark" data-note="1">`) placed inside the mock
 * pair with the `notes` legend rendered underneath, so every visual carries
 * its own explanation, no "see figure 3" indirection.
 */
// The df-* mock library used by whatever this component wraps. It has to be
// global: slotted markup carries the caller's scope attribute, never this
// component's, so a scoped rule here would never match. Imported rather than
// inlined so screens/ authors have one file to read.
import '../../styles/dashframe.css';

interface Note {
    n: number;
    text: string;
}

interface Props {
    /** Path shown in the address bar, e.g. "/commands". */
    path?: string;
    notes?: Note[];
    caption?: string;
}

const { path = '/', notes = [], caption } = Astro.props;
---

<figure class="dframe" data-reveal>
    <div class="dframe__win" role="img" aria-label={caption ?? `dashboard.itsbagelbot.com${path}`}>
        <div class="dframe__bar">
            <span class="dframe__url">dashboard.itsbagelbot.com<b>{path}</b></span>
        </div>
        <div class="dframe__body">
            <slot />
        </div>
    </div>
    {notes.length > 0 && (
        <ul class="dframe__legend">
            {notes.map((note) => (
                <li data-note-for={note.n} tabindex="0">
                    <i class="dframe__idx" aria-hidden="true">{String(note.n).padStart(2, '0')}</i>
                    <span>{note.text}</span>
                </li>
            ))}
        </ul>
    )}
    {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
    .dframe { margin: 20px 0 28px; }

    .dframe__win {
        border: 1px solid var(--border, rgba(201, 168, 124, 0.15));
        border-radius: var(--radius-md);
        background: #0d0d0c;
        overflow: hidden;
        box-shadow: 0 24px 55px rgba(0, 0, 0, 0.4);
    }

    .dframe__bar {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 10px 14px;
        border-bottom: 1px solid rgba(201, 168, 124, 0.1);
        background: rgba(17, 17, 16, 0.92);
    }




    .dframe__url {
        flex: 1;
        max-width: 340px;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.64rem;
        color: var(--muted, #888077);
        background: rgba(240, 236, 228, 0.04);
        border: 1px solid rgba(201, 168, 124, 0.1);
        border-radius: var(--radius-pill);
        padding: 5px 12px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dframe__url b { color: var(--tan-light, #e0c49a); font-weight: 400; }

    .dframe__body { position: relative; padding: 18px; }

    .dframe__legend {
        display: grid;
        gap: 8px;
        margin-top: 14px;
        padding-left: 2px;
    }

    /* The legend is the annotation: a mono index per line, and hovering or
       focusing a line lights the matching element inside the frame. No badges
       on the mock itself. */
    .dframe__legend li {
        display: flex;
        gap: 12px;
        align-items: baseline;
        padding: 2px 6px;
        margin: 0 -6px;
        border-radius: var(--radius-sm);
        font-family: var(--font-body, "DM Sans", sans-serif);
        font-size: 0.92rem;
        line-height: 1.6;
        color: #b6afa5;
        cursor: default;
        transition: background 300ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
    }

    .dframe__legend li:hover,
    .dframe__legend li:focus-visible {
        background: rgba(201, 168, 124, 0.06);
        outline: none;
    }

    .dframe__idx {
        flex: none;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-style: normal;
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        color: var(--tan, #c9a87c);
    }

    @media (prefers-reduced-motion: reduce) {
        .dframe__legend li { transition: none; }
    }

    figcaption {
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.72rem;
        letter-spacing: 0.05em;
        color: var(--muted, #888077);
        margin-top: 12px;
        padding-left: 2px;
    }

    @media (max-width: 640px) {
        .dframe__body { padding: 12px; }
    }
</style>

<script>
    // Legend line -> element in the frame. Each screen leaves an invisible
    // <i class="df-mark" data-note="N"> inside the element it describes; the
    // matching legend line lights that element's parent while hovered or
    // focused. Bound on astro:page-load as well as at load for the ClientRouter,
    // with data-ready so a second pass never binds twice.
    function setupFrame(frame: HTMLElement) {
        const lines = frame.querySelectorAll<HTMLElement>('[data-note-for]');
        lines.forEach((line) => {
            const n = line.dataset.noteFor;
            const target = frame.querySelector<HTMLElement>(`.df-mark[data-note="${n}"]`)?.parentElement;
            if (!target) return;
            const on = () => target.classList.add('is-hot');
            const off = () => target.classList.remove('is-hot');
            line.addEventListener('mouseenter', on);
            line.addEventListener('mouseleave', off);
            line.addEventListener('focus', on);
            line.addEventListener('blur', off);
        });
    }

    function setupAll() {
        document.querySelectorAll<HTMLElement>('.dframe').forEach((frame) => {
            if (frame.dataset.ready === '1') return;
            frame.dataset.ready = '1';
            setupFrame(frame);
        });
    }

    setupAll();
    document.addEventListener('astro:page-load', setupAll);
</script>
