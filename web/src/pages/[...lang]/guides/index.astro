// The guides hub, one file for every locale. Cards come from each guide's own
// content file (meta.card), so the hub can never describe a guide that no
// longer says that; order and numbering come from the slug list.
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import GuideCard from '../../../components/guides/GuideCard.astro';
import TextLink from '../../../components/ui/TextLink.astro';
import { getLangFromUrl, locales, defaultLang } from '../../../i18n/ui';
import { getGuide, getHub, guideIndex, guidePath, guideSlugs } from '../../../lib/guides/registry';

export function getStaticPaths() {
    return locales.map((l) => ({ params: { lang: l === defaultLang ? undefined : l } }));
}

const lang = getLangFromUrl(Astro.url);
const hub = getHub(lang);
const guides = guideSlugs.map((slug) => ({
    index: guideIndex(slug),
    href: guidePath(slug, lang),
    ...getGuide(slug, lang).meta.card,
}));
---

<Layout title={hub.meta.title} description={hub.meta.description} ogType="article">
    <PageHero eyebrow={hub.meta.eyebrow} title={hub.meta.heading} description={hub.meta.lead} />

    <section class="ghub">
        <div class="ghub__list">
            {guides.map((guide, i) => (
                <GuideCard {...guide} revealIndex={i + 1} />
            ))}
        </div>

        <!-- The tool: not a guide, a workbench. -->
        <a class="ghub__tool" href={hub.tool.href} data-reveal style="--reveal-i: 4">
            <div class="ghub__tool-copy">
                <span class="ghub__tool-eyebrow">{hub.tool.eyebrow}</span>
                <b>{hub.tool.name}</b>
                <p>{hub.tool.description}</p>
                <span class="ghub__tool-cta">{hub.tool.cta}</span>
            </div>
            <div class="ghub__tool-demo" aria-hidden="true">
                <span class="ghub__tool-line" set:html={hub.tool.demoIn}></span>
                <span class="ghub__tool-arrow">↓</span>
                <span class="ghub__tool-line ghub__tool-line--out" set:html={hub.tool.demoOut}></span>
            </div>
        </a>

        <div class="ghub__help" data-reveal style="--reveal-i: 5">
            <p>{hub.help.prompt}</p>
            <div>
                {hub.help.links.map((link) => (
                    <TextLink href={link.href} label={link.label} external={link.external} />
                ))}
            </div>
        </div>
    </section>
</Layout>

<style>
    .ghub {
        width: min(880px, calc(100% - 48px));
        margin: 0 auto;
        padding: 0 0 110px;
    }

    .ghub__list { display: grid; gap: 16px; }

    /* ── Builder feature card ── */

    .ghub__tool {
        position: relative;
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 30px;
        align-items: center;
        margin-top: 40px;
        padding: clamp(26px, 4vw, 42px);
        border: 1px solid rgba(82, 183, 136, 0.28);
        border-radius: var(--radius-card, 16px);
        background:
            radial-gradient(500px 260px at 85% 10%, rgba(82, 183, 136, 0.09), transparent 70%),
            rgba(17, 17, 16, 0.9);
        overflow: hidden;
        transition: border-color 220ms ease, transform 260ms var(--ease-out-expo);
    }

    .ghub__tool:hover {
        border-color: rgba(82, 183, 136, 0.55);
        transform: translateY(-3px);
    }

    .ghub__tool-copy { display: grid; gap: 12px; }

    .ghub__tool-eyebrow {
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.64rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--green-glow, #52b788);
    }

    .ghub__tool-copy b {
        font-family: var(--font-display, "Syne", sans-serif);
        font-size: clamp(1.4rem, 3vw, 1.9rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--white, #f0ece4);
    }

    .ghub__tool-copy p {
        font-family: var(--font-body, "DM Sans", sans-serif);
        font-size: 1rem;
        line-height: 1.7;
        color: #a39c92;
        margin: 0;
    }

    .ghub__tool-cta {
        font-family: var(--font-display, "Syne", sans-serif);
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--green-glow, #52b788);
        margin-top: 4px;
        transition: transform 260ms var(--ease-out-expo);
    }

    .ghub__tool:hover .ghub__tool-cta { transform: translateX(4px); }

    /* Mini before/after demo. */

    .ghub__tool-demo {
        display: grid;
        gap: 10px;
        justify-items: start;
    }

    .ghub__tool-line {
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.78rem;
        line-height: 1.6;
        color: rgba(240, 236, 228, 0.85);
        background: #0b0b0a;
        border: 1px solid rgba(201, 168, 124, 0.16);
        border-radius: 10px;
        padding: 11px 14px;
    }

    .ghub__tool-line i {
        font-style: normal;
        color: var(--green-glow, #52b788);
        background: rgba(82, 183, 136, 0.09);
        border-radius: 4px;
        padding: 1px 4px;
    }

    .ghub__tool-line--out { border-color: rgba(82, 183, 136, 0.3); }
    .ghub__tool-line--out b { color: var(--green-glow, #52b788); font-weight: 700; }

    .ghub__tool-arrow {
        font-size: 0.8rem;
        color: var(--tan, #c9a87c);
        padding-left: 16px;
    }

    /* ── Help strip ── */

    .ghub__help {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 14px;
        margin-top: 44px;
        padding-top: 28px;
        border-top: 1px solid var(--border, rgba(201, 168, 124, 0.15));
    }

    .ghub__help p {
        font-family: var(--font-body, "DM Sans", sans-serif);
        font-size: 0.95rem;
        color: var(--muted, #888077);
        margin: 0;
    }

    .ghub__help div { display: flex; flex-wrap: wrap; gap: 20px; }

    @media (prefers-reduced-motion: reduce) {
        .ghub__tool, .ghub__tool-cta { transition: none; }
    }

    @media (max-width: 760px) {
        .ghub { width: calc(100% - 32px); }
        .ghub__tool { grid-template-columns: 1fr; gap: 22px; }
    }
</style>
