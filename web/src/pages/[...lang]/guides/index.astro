// The guides hub, one file for every locale. Cards come from each guide's own
// content file (meta.card), so the hub can never describe a guide that no
// longer says that; order and numbering come from the slug list.
//
// Order on the page: the command builder first (the thing most people came
// for), then the five guides as one calm list, then where to ask.
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import GuideCard from '../../../components/guides/GuideCard.astro';
import TextLink from '../../../components/ui/TextLink.astro';
import { getLangFromUrl, locales, defaultLang } from '../../../i18n/ui';
import { getGuide, getHub, guideIndex, guidePath, guideSlugs } from '../../../lib/guides/registry';

export function getStaticPaths() {
    return locales.map((l) => ({ params: { lang: l === defaultLang ? undefined : l } }));
}

const lang = getLangFromUrl(Astro.url);
const hub = getHub(lang);
const guides = guideSlugs.map((slug) => ({
    index: guideIndex(slug),
    href: guidePath(slug, lang),
    ...getGuide(slug, lang).meta.card,
}));
---

<Layout title={hub.meta.title} description={hub.meta.description} ogType="article">
    <PageHero eyebrow={hub.meta.eyebrow} title={hub.meta.heading} description={hub.meta.lead} />

    <section class="ghub">
        <!-- The builder: a workbench, not a guide. One flat plate, copy and a
             real button on the left, the rehearsal on the right. The whole
             plate is the link; the cursor stays quiet on it and morphs on the
             button only. -->
        <a class="ghub__tool" href={hub.tool.href} data-cursor="quiet" data-reveal style="--reveal-i: 1">
            <span class="ghub__tool-copy">
                <span class="ghub__eyebrow">{hub.tool.eyebrow}</span>
                <b class="ghub__tool-name">{hub.tool.name}</b>
                <span class="ghub__tool-desc">{hub.tool.description}</span>
                <span class="ghub__tool-btn" data-cursor>{hub.tool.cta}</span>
            </span>
            <span class="ghub__tool-demo" aria-hidden="true">
                <span class="ghub__tool-line" set:html={hub.tool.demoIn}></span>
                <span class="ghub__tool-line ghub__tool-line--out" set:html={hub.tool.demoOut}></span>
            </span>
        </a>

        <ol class="ghub__list" aria-label={hub.meta.eyebrow}>
            {guides.map((guide, i) => (
                <li><GuideCard {...guide} cta={hub.readCta} revealIndex={Math.min(i + 2, 6)} /></li>
            ))}
        </ol>

        <div class="ghub__help" data-reveal style="--reveal-i: 6">
            <p>{hub.help.prompt}</p>
            <div>
                {hub.help.links.map((link) => (
                    <TextLink href={link.href} label={link.label} external={link.external} />
                ))}
            </div>
        </div>
    </section>
</Layout>

<style>
    .ghub {
        width: min(880px, calc(100% - 48px));
        margin: 0 auto;
        padding: 0 0 110px;
    }

    .ghub__eyebrow {
        display: block;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--green-glow, #52b788);
        margin-bottom: 12px;
    }

    /* ── Builder plate ── */
    .ghub__tool {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        align-items: center;
        gap: 32px;
        padding: 30px 32px;
        background: var(--card-bg, #111110);
        border: 1px solid var(--border, rgba(201, 168, 124, 0.15));
        border-radius: var(--radius-card, 16px);
        text-decoration: none;
        transition: border-color 360ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
    }

    .ghub__tool-copy { display: block; min-width: 0; }

    .ghub__tool-name {
        display: block;
        font-family: var(--font-display, "Syne", sans-serif);
        font-size: clamp(1.4rem, 3vw, 1.9rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--white, #f0ece4);
        margin-bottom: 10px;
    }

    .ghub__tool-desc {
        display: block;
        font-family: var(--font-body, "DM Sans", sans-serif);
        font-size: 0.98rem;
        line-height: 1.65;
        color: #a39c92;
        max-width: 46ch;
        margin-bottom: 20px;
    }

    /* Same shape as ui/Buttons/MainButton, as a span (this sits inside a link). */
    .ghub__tool-btn {
        display: inline-block;
        font-family: var(--font-display, "Syne", sans-serif);
        font-weight: 700;
        font-size: 0.92rem;
        padding: 13px 26px;
        background: var(--tan, #c9a87c);
        color: var(--black, #0a0a0a);
        border-radius: 4px;
        letter-spacing: -0.01em;
        transition: background 240ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
    }

    /* Rehearsal: the request, a thin tan rule, the bot's reply. Inset on the
       page ink so it reads as a screen, not as more plate. */
    .ghub__tool-demo {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
        padding: 18px 20px;
        background: var(--black, #0a0a0a);
        border: 1px solid rgba(201, 168, 124, 0.12);
        border-radius: var(--radius-sm, 6px);
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.78rem;
        line-height: 1.6;
    }

    .ghub__tool-line { color: rgba(240, 236, 228, 0.85); }

    .ghub__tool-line :global(i) {
        font-style: normal;
        color: var(--green-glow, #52b788);
        background: rgba(82, 183, 136, 0.09);
        border-radius: 4px;
        padding: 1px 4px;
    }

    .ghub__tool-line--out {
        position: relative;
        padding-top: 10px;
        color: var(--green-glow, #52b788);
    }

    .ghub__tool-line--out::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 48px;
        height: 1px;
        background: var(--tan, #c9a87c);
        opacity: 0.5;
    }

    .ghub__tool-line--out :global(b) { font-weight: 700; }

    @media (hover: hover) and (pointer: fine) {
        .ghub__tool:hover { border-color: rgba(201, 168, 124, 0.38); }
        .ghub__tool:hover .ghub__tool-btn { background: var(--tan-light, #e0c49a); }
    }

    .ghub__tool:focus-visible {
        outline: 2px solid var(--green-glow, #52b788);
        outline-offset: 3px;
    }

    /* ── Guide list ── */
    .ghub__list {
        display: grid;
        gap: 12px;
        list-style: none;
        margin: 36px 0 0;
        padding: 0;
    }

    /* ── Help strip ── */
    .ghub__help {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 14px;
        margin-top: 44px;
        padding-top: 28px;
        border-top: 1px solid var(--border, rgba(201, 168, 124, 0.15));
    }

    .ghub__help p {
        font-family: var(--font-body, "DM Sans", sans-serif);
        font-size: 0.95rem;
        color: var(--muted, #888077);
        margin: 0;
    }

    .ghub__help div { display: flex; flex-wrap: wrap; gap: 20px; }

    @media (max-width: 760px) {
        .ghub { width: calc(100% - 32px); }
        .ghub__tool {
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 24px 22px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .ghub__tool, .ghub__tool-btn { transition: none; }
    }
</style>
