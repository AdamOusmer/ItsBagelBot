// The guides hub, one file for every locale. Cards come from each guide's own
// content file (meta.card), so the hub can never describe a guide that no
// longer says that; order and numbering come from the slug list.
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Card from '../../../components/ui/Card.astro';
import GuideCard from '../../../components/guides/GuideCard.astro';
import TextLink from '../../../components/ui/TextLink.astro';
import { getLangFromUrl, locales, defaultLang } from '../../../i18n/ui';
import { getGuide, getHub, guideIndex, guidePath, guideSlugs } from '../../../lib/guides/registry';

export function getStaticPaths() {
    return locales.map((l) => ({ params: { lang: l === defaultLang ? undefined : l } }));
}

const lang = getLangFromUrl(Astro.url);
const hub = getHub(lang);
const guides = guideSlugs.map((slug) => ({
    index: guideIndex(slug),
    href: guidePath(slug, lang),
    ...getGuide(slug, lang).meta.card,
}));
---

<Layout title={hub.meta.title} description={hub.meta.description} ogType="article">
    <PageHero eyebrow={hub.meta.eyebrow} title={hub.meta.heading} description={hub.meta.lead} />

    <section class="ghub">
        <div class="ghub__list">
            {guides.map((guide, i) => (
                <GuideCard {...guide} revealIndex={i + 1} />
            ))}
        </div>

        <!-- The tool: not a guide, a workbench. Banded like every other Card;
             distinct only through what sits in the band, no bespoke glow. -->
        <Card as="a" href={hub.tool.href} label={hub.tool.eyebrow} class="ghub__tool" data-reveal style="--reveal-i: 4">
            <div class="ghub__tool-demo" slot="band" aria-hidden="true">
                <span class="ghub__tool-line" set:html={hub.tool.demoIn}></span>
                <span class="ghub__tool-line ghub__tool-line--out" set:html={hub.tool.demoOut}></span>
            </div>
            <b class="ghub__tool-name">{hub.tool.name}</b>
            <p class="ghub__tool-desc">{hub.tool.description}</p>
            <span class="ghub__tool-cta">{hub.tool.cta}</span>
        </Card>

        <div class="ghub__help" data-reveal style="--reveal-i: 5">
            <p>{hub.help.prompt}</p>
            <div>
                {hub.help.links.map((link) => (
                    <TextLink href={link.href} label={link.label} external={link.external} />
                ))}
            </div>
        </div>
    </section>
</Layout>

<style>
    .ghub {
        width: min(880px, calc(100% - 48px));
        margin: 0 auto;
        padding: 0 0 110px;
    }

    .ghub__list {
        display: grid;
        gap: 16px;
        /* One housing height for the row of guide cards so every seam lines
           up (Card's band is a fixed height, not a min-height). */
        --card-band-h: 84px;
    }

    /* ── Builder feature card ──
       Same banded Card as every guide card; the only thing that sets it
       apart is what sits in the band (the rehearsal, not a green glow). */

    .ghub__tool {
        margin-top: 40px;
        --card-band-h: 108px;
    }

    .ghub__tool-name {
        display: block;
        font-family: var(--font-display, "Syne", sans-serif);
        font-size: clamp(1.4rem, 3vw, 1.9rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--white, #f0ece4);
        margin-bottom: 12px;
    }

    .ghub__tool-desc {
        font-family: var(--font-body, "DM Sans", sans-serif);
        font-size: 1rem;
        line-height: 1.7;
        color: #a39c92;
        margin: 0 0 4px;
    }

    .ghub__tool-cta {
        display: inline-block;
        font-family: var(--font-display, "Syne", sans-serif);
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--green-glow, #52b788);
        margin-top: 4px;
    }

    /* Mini before/after rehearsal, stacked with a thin tan rule standing in
       for the arrow: request above, the bot's reply below. */

    .ghub__tool-demo {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
        width: 100%;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.78rem;
        line-height: 1.6;
    }

    .ghub__tool-line {
        color: rgba(240, 236, 228, 0.85);
    }

    .ghub__tool-line i {
        font-style: normal;
        color: var(--green-glow, #52b788);
        background: rgba(82, 183, 136, 0.09);
        border-radius: 4px;
        padding: 1px 4px;
    }

    .ghub__tool-line--out {
        position: relative;
        padding-top: 10px;
        color: var(--green-glow, #52b788);
    }

    .ghub__tool-line--out::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 48px;
        height: 1px;
        background: var(--tan, #c9a87c);
        opacity: 0.5;
    }

    .ghub__tool-line--out b { font-weight: 700; }

    /* ── Help strip ── */

    .ghub__help {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 14px;
        margin-top: 44px;
        padding-top: 28px;
        border-top: 1px solid var(--border, rgba(201, 168, 124, 0.15));
    }

    .ghub__help p {
        font-family: var(--font-body, "DM Sans", sans-serif);
        font-size: 0.95rem;
        color: var(--muted, #888077);
        margin: 0;
    }

    .ghub__help div { display: flex; flex-wrap: wrap; gap: 20px; }

    @media (max-width: 760px) {
        .ghub { width: calc(100% - 32px); }
    }
</style>
