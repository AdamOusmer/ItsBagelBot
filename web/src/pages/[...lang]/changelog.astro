import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ChangelogList from '../../components/changelog/ChangelogList.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, locales, defaultLang } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l === defaultLang ? undefined : l } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const entries = (await getCollection('changelog')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title={t('changelog.metaTitle')} description={t('changelog.metaDesc')}>
    <PageHero
        eyebrow={t('changelog.eyebrow')}
        title={t('changelog.title')}
        description={t('changelog.desc')}
    />
    <ChangelogList entries={entries} />
</Layout>
