import { SITE } from '@bagel/kit/site-links';
import { docsI18n, docsLocaleOptions } from '../i18n/ui';

import Nav from '@bagel/ui/astro/Nav.astro';
import '@bagel/ui/styles/elements/fit.css';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

const { t, path: localizedPath, locale } = docsI18n(Astro.locals.starlightRoute.locale);
const links = [
  { href: localizedPath('/guides/getting-started/'), label: t('guides') },
  { href: localizedPath('/architecture/'), label: t('architecture') },
  { href: localizedPath('/microservices/'), label: t('services') },
  { href: localizedPath('/adr/'), label: t('adr') },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<Nav
  variant="bar"
  menu={false}
  brand={{ title: 'ItsBagelBot', sub: t('brand'), href: localizedPath('/') }}
  links={links.map((link) => ({ ...link, current: isActive(link.href) }))}
  cta={{ href: `${SITE.web}${localizedPath('/')}`, label: t('mainSite'), external: true }}
  locales={docsLocaleOptions(Astro.url.pathname, locale)}
  localeLabel={Astro.locals.t('languageSelect.accessibleLabel')}
  label={t('brand')}
  menuLabels={{ open: t('menu.open'), close: t('menu.close'), panel: t('menu.panel') }}
>
  <Fragment slot="actions">
    <Search />
    <ThemeSelect />
  </Fragment>
</Nav>

<script>
  import { mountTextFit } from '@bagel/ui/lib/text-fit';

  let disposeTextFit: (() => void) | null = null;

  function teardownTextFit() {
    disposeTextFit?.();
    disposeTextFit = null;
  }

  function setupTextFit() {
    teardownTextFit();
    disposeTextFit = mountTextFit(document);
  }

  setupTextFit();
  document.addEventListener('astro:page-load', setupTextFit);
  document.addEventListener('astro:before-swap', teardownTextFit);
  window.addEventListener('pagehide', teardownTextFit);
</script>
