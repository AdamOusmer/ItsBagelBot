import { SITE } from '@bagel/kit/site-links';
import { docsI18n } from '../i18n/ui';

/**
 * Starlight `Header` override: the docs wear the same nav bar as the rest of
 * the site.
 *
 * It is a WRAPPER around `@bagel/ui/astro/Nav.astro`, not the library
 * component pointed at directly, because Starlight renders this file inside
 * its own fixed header with its own props and its own slots. Two of its
 * pieces have to survive: the search box (Pagefind's modal trigger, which the
 * whole docs keyboard flow hangs off) and the theme toggle.
 *
 * Two props do the fitting:
 *  - `variant="bar"` drops the marketing bar's fixed position, max width,
 *    pill shell and blur, because Starlight's header already provides all
 *    four. Everything about the LINKS stays shared, which is the point.
 *  - `menu={false}` leaves the hamburger and the top-down panel out.
 *    Starlight ships its own mobile menu in the same bar; rendering ours as
 *    well would put two hamburgers side by side opening two different
 *    navigations.
 *
 * Starlight owns the locale switch. The custom links below follow the current
 * locale; all shared navigation copy lives in the documentation catalogs.
 */
import Nav from '@bagel/ui/astro/Nav.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

const { t, path: localizedPath } = docsI18n(Astro.locals.starlightRoute.locale);
const links = [
  { href: localizedPath('/guides/getting-started/'), label: t('guides') },
  { href: localizedPath('/architecture/'), label: t('architecture') },
  { href: localizedPath('/microservices/'), label: t('services') },
  { href: localizedPath('/adr/'), label: t('adr') },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<Nav
  variant="bar"
  menu={false}
  brand={{ title: 'ItsBagelBot', sub: t('brand'), href: localizedPath('/') }}
  links={links.map((link) => ({ ...link, active: isActive(link.href) }))}
  cta={{ href: `${SITE.web}${localizedPath('/')}`, label: t('mainSite'), external: true }}
  ariaLabel={t('brand')}
  menuLabels={{ open: t('menu.open'), close: t('menu.close'), panel: t('menu.panel') }}
>
  <Fragment slot="actions">
    <Search />
    <LanguageSelect />
    <ThemeSelect />
  </Fragment>
</Nav>
