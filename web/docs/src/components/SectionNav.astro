import Glide from '@bagel/ui/astro/Glide.astro';
import Label from '@bagel/ui/astro/Label.astro';
import RailItem from '@bagel/ui/astro/RailItem.astro';
import { docsI18n } from '../i18n/ui';
import type { DocPage } from '../lib/pages';
import type { Space } from '../lib/spaces';

interface Props {
  space: Space;
  pages: Map<string, DocPage>;
  current: string;
  locale: string;
  label: string;
}

const { space, pages, current, locale, label } = Astro.props;
const { t } = docsI18n(locale);
---

<nav class="doc-section" aria-label={label}>
  <Glide />
  {space.groups.map((group) => (
    <div class="doc-section__group">
      {group.label && <Label mono as="span" class="doc-section__title">{t(group.label)}</Label>}
      <div class="doc-section__list">
        {group.pages.map((id) => {
          const page = pages.get(id)!;
          return <RailItem href={page.href} label={page.label} current={id === current} title={page.label} />;
        })}
      </div>
    </div>
  ))}
</nav>

<style>
  .doc-section {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--bb-space-5);
  }

  .doc-section__group {
    display: flex;
    flex-direction: column;
    gap: var(--bb-space-2);
  }

  .doc-section__title {
    padding-inline: 12px;
  }

  .doc-section__list {
    display: flex;
    flex-direction: column;
    gap: var(--bb-space-1);
  }
</style>

<script>
  import { mountGlide } from '@bagel/ui/lib/glide';

  let cleanups: (() => void)[] = [];
  function dispose() {
    cleanups.forEach((cleanup) => cleanup());
    cleanups = [];
  }
  function mount() {
    dispose();
    document.querySelectorAll<HTMLElement>('.doc-section').forEach((nav) => {
      cleanups.push(mountGlide(nav, { observe: nav, selector: '.bb-rail-item.is-active', watch: true }));
    });
  }

  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', dispose);
</script>
