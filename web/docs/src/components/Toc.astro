import Label from '@bagel/ui/astro/Label.astro';
import SectionNav from '@bagel/ui/astro/SectionNav.astro';
import { docsI18n } from '../i18n/ui';

interface Props {
  sections: { slug: string; text: string }[];
  locale: string;
  bare?: boolean;
}

const { sections, locale, bare = false } = Astro.props;
const { t } = docsI18n(locale);
const items = sections.map(({ slug, text }) => ({ href: `#${slug}`, label: text }));
---

<div class="doc-onpage">
  {!bare && <Label mono as="span">{t('chrome.onThisPage')}</Label>}
  <SectionNav label={t('chrome.onThisPage')} items={items} variant="toc" />
</div>

<style>
  .doc-onpage {
    display: flex;
    flex-direction: column;
    gap: var(--bb-space-3);
  }
</style>

<script>
  import { mountSectionNav } from '@bagel/ui/lib/scroll-spy';

  let cleanups: (() => void)[] = [];
  function dispose() {
    cleanups.forEach((cleanup) => cleanup());
    cleanups = [];
  }
  function mount() {
    dispose();
    document.querySelectorAll<HTMLElement>('.doc-onpage .bb-tabs').forEach((nav) => {
      cleanups.push(mountSectionNav(nav));
    });
  }

  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', dispose);
</script>
