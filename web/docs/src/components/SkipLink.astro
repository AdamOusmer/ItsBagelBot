import Default from '@astrojs/starlight/components/SkipLink.astro';

const { entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
---

<Default><slot /></Default>

{
    /* Decoration is restricted to splash pages; doc pages stay clean. */
    isSplash && (
        <div class="bb-decoration" aria-hidden="true" data-astro-transition-persist="bb-decoration">
            <div class="bb-orb bb-orb--halo bb-orb--green bb-orb-1" />
            <div class="bb-orb bb-orb--halo bb-orb--tan bb-orb-2" />
            <div class="bb-noise" />
        </div>
    )
}
