import SkipLink from '@bagel/ui/astro/SkipLink.astro';
import MermaidInteractive from './MermaidInteractive.astro';

const { entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
---

<SkipLink href="#_top" label={Astro.locals.t('skipLink.label')} />

{
    isSplash && (
        <div class="docs-decoration" aria-hidden="true" data-astro-transition-persist="docs-decoration">
            <div class="bb-orb bb-orb--halo bb-orb--green docs-orb-1" />
            <div class="bb-orb bb-orb--halo bb-orb--tan docs-orb-2" />
            <div class="docs-noise" />
        </div>
    )
}

<MermaidInteractive />
