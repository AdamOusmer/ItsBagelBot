import { SITE } from '@bagel/kit/site-links';
import { docsI18n } from '../i18n/ui';

/**
 * Starlight `Footer` override: the page's own footer, then the site's.
 *
 * Starlight's Footer is per-PAGE furniture -- edit link, last updated,
 * previous/next pagination -- and every one of those is worth keeping, so the
 * default renders first, unchanged. `@bagel/ui/astro/Footer.astro` follows it
 * as the sitewide sign-off, which is what makes the docs feel like the same
 * property as the marketing site rather than a subdomain someone forgot.
 *
 * No colophon slot here: the ownership block is the homepage's, and it is
 * homepage-gated for a reason (see web/marketing/src/components/layout/Footer.astro).
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import Footer from '@bagel/ui/astro/Footer.astro';

const { t, path } = docsI18n(Astro.locals.starlightRoute.locale);
const columns = [
  {
    title: t('brand'),
    links: [
      { href: path('/guides/getting-started/'), label: t('guides') },
      { href: path('/architecture/'), label: t('architecture') },
      { href: path('/adr/'), label: t('adr') },
    ],
  },
  {
    title: t('product'),
    links: [
      { href: `${SITE.web}${path('/')}`, label: t('mainSite'), external: true },
      { href: `${SITE.web}${path('/pricing')}`, label: t('pricing'), external: true },
      { href: SITE.dashboard, label: t('dashboard'), external: true },
    ],
  },
  {
    title: t('community'),
    links: [
      { href: SITE.discord, label: 'Discord', external: true },
      { href: SITE.github, label: 'GitHub', external: true },
    ],
  },
];
---

<Default><slot /></Default>
<Footer
  class="docs-footer"
  brand={{ title: 'ItsBagelBot', sub: t('brand'), href: `${SITE.web}${path('/')}` }}
  columns={columns}
  legal={[
    { href: `${SITE.web}${path('/privacy')}`, label: t('privacy'), external: true },
    { href: `${SITE.web}${path('/terms')}`, label: t('terms'), external: true },
  ]}
  copyright="© 2026 ItsBagelBot"
/>
