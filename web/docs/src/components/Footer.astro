import { getImage } from 'astro:assets';
import { SITE } from '@bagel/kit/site-links';
import { docsI18n } from '../i18n/ui';
import logoImage from '../assets/LogoBOT.png';

import Default from '@astrojs/starlight/components/Footer.astro';
import Footer from '@bagel/ui/astro/Footer.astro';

const { t, path } = docsI18n(Astro.locals.starlightRoute.locale);
const logo = await getImage({ src: logoImage, width: 110, height: 110, format: 'webp' });
const columns = [
  {
    title: t('brand'),
    links: [
      { href: path('/guides/getting-started/'), label: t('guides') },
      { href: path('/architecture/'), label: t('architecture') },
      { href: path('/adr/'), label: t('adr') },
    ],
  },
  {
    title: t('product'),
    links: [
      { href: `${SITE.web}${path('/')}`, label: t('mainSite'), external: true },
      { href: `${SITE.web}${path('/pricing')}`, label: t('pricing'), external: true },
      { href: SITE.dashboard, label: t('dashboard'), external: true },
    ],
  },
  {
    title: t('community'),
    links: [
      { href: SITE.discord, label: 'Discord', external: true },
      { href: SITE.github, label: 'GitHub', external: true },
    ],
  },
];
---

<Default><slot /></Default>
<Footer
  brand={{ title: 'ItsBagelBot', sub: t('brand'), href: `${SITE.web}${path('/')}`, logoSrc: logo.src }}
  columns={columns}
  legal={[
    { href: `${SITE.web}${path('/privacy')}`, label: t('privacy'), external: true },
    { href: `${SITE.web}${path('/terms')}`, label: t('terms'), external: true },
  ]}
  copyright="© 2026 ItsBagelBot"
/>
