import Modal from '@bagel/ui/astro/Modal.astro';
import IconButton from '@bagel/ui/astro/IconButton.astro';
import Button from '@bagel/ui/astro/Button.astro';
import Icon from '@bagel/ui/astro/Icon.astro';
import { docsI18n } from '../i18n/ui';

const { t } = docsI18n(Astro.locals.starlightRoute?.locale);
const controls = [
  { action: 'zoom-out', label: t('diagram.zoomOut'), icon: 'minus' },
  { action: 'reset', label: t('diagram.reset'), icon: 'expand' },
  { action: 'zoom-in', label: t('diagram.zoomIn'), icon: 'plus' },
  { action: 'close', label: t('diagram.close'), icon: 'x' },
] as const;
---

<Modal
  variant="viewer"
  open={false}
  label={t('diagram.viewer')}
  toolbarLabel={t('diagram.controls')}
  closeLabel={t('diagram.close')}
  data-mermaid-viewer
>
  <Fragment slot="toolbar">
    {controls.map(({ action, label, icon }) => (
      <IconButton label={label} title={label} data-action={action}><Icon name={icon} /></IconButton>
    ))}
  </Fragment>
  <Fragment slot="hint">{t('diagram.hint')}</Fragment>
</Modal>

<template data-mermaid-expand>
  <span class="mermaid-expand">
    <Button variant="secondary" size="sm" aria-label={t('diagram.open')} title={t('diagram.fullscreen')}><Icon name="expand" size={14} />{t('diagram.expand')}</Button>
  </span>
</template>

<script>
  import { pushOverlay, removeOverlay, isTopmost, trapFocus } from '@bagel/ui/lib/overlay-stack';
  import panzoom, { type PanZoom } from 'panzoom';

  const READY = 'mermaid-interactive-ready';
  const ZOOM_STEP = 1.4;

  let viewer: HTMLElement | null = null;
  let stage: HTMLElement | null = null;
  let instance: PanZoom | null = null;
  let observer: MutationObserver | null = null;
  let overlayId: number | null = null;
  let focusTrap: ReturnType<typeof trapFocus> | null = null;

  const actions: Record<string, () => void> = {
    close: closeModal,
    'zoom-in': () => zoomBy(ZOOM_STEP),
    'zoom-out': () => zoomBy(1 / ZOOM_STEP),
    reset: resetView,
  };

  function onViewerClick(event: MouseEvent) {
    const target = event.target as HTMLElement;
    if (target.closest('.bb-modal__backdrop')) {
      closeModal();
      return;
    }
    const action = target.closest('[data-action]')?.getAttribute('data-action');
    if (action) actions[action]?.();
  }

  function mountViewer() {
    const found = document.querySelector<HTMLElement>('[data-mermaid-viewer]');
    if (!found || found === viewer) return;
    viewer = found;
    stage = found.querySelector<HTMLElement>('.bb-modal__stage');
    found.addEventListener('click', onViewerClick);
  }

  function zoomBy(factor: number) {
    if (!instance || !stage) return;
    const r = stage.getBoundingClientRect();
    instance.smoothZoom(r.left + r.width / 2, r.top + r.height / 2, factor);
  }

  function resetView() {
    if (!instance) return;
    instance.moveTo(0, 0);
    instance.zoomAbs(0, 0, 1);
  }

  function fittedClone(source: SVGElement): SVGElement {
    const clone = source.cloneNode(true) as SVGElement;
    const rect = source.getBoundingClientRect();
    const fit = Math.min((window.innerWidth * 0.92) / rect.width, (window.innerHeight * 0.88) / rect.height, 1);
    const w = Math.round(rect.width * fit);
    const h = Math.round(rect.height * fit);
    clone.setAttribute('width', String(w));
    clone.setAttribute('height', String(h));
    Object.assign(clone.style, { width: `${w}px`, height: `${h}px`, maxWidth: 'none', maxHeight: 'none', display: 'block' });
    return clone;
  }

  function diagramHost(source: SVGElement): HTMLElement {
    const host = document.createElement('pre');
    host.className = 'mermaid mermaid-modal-host';
    host.setAttribute('data-processed', 'true');
    host.appendChild(fittedClone(source));
    return host;
  }

  function openModal(panel: HTMLElement) {
    const source = panel.querySelector('svg');
    if (!source || !viewer?.hidden || !stage) return;

    const host = diagramHost(source);
    stage.replaceChildren(host);
    viewer.hidden = false;
    overlayId = pushOverlay();
    focusTrap = trapFocus(viewer.querySelector<HTMLElement>('.bb-modal__card') ?? viewer);

    instance?.dispose();
    instance = panzoom(host, {
      maxZoom: 12,
      minZoom: 0.1,
      bounds: false,
      smoothScroll: false,
      zoomDoubleClickSpeed: 1,
      beforeWheel: () => false,
    });
  }

  function closeModal() {
    if (!viewer) return;
    viewer.hidden = true;
    if (overlayId !== null) removeOverlay(overlayId);
    overlayId = null;
    focusTrap?.destroy();
    focusTrap = null;
    instance?.dispose();
    instance = null;
    stage?.replaceChildren();
  }

  function expandButton(): HTMLElement | null {
    const template = document.querySelector<HTMLTemplateElement>('template[data-mermaid-expand]');
    const button = template?.content.firstElementChild?.cloneNode(true);
    return button instanceof HTMLElement ? button : null;
  }

  function enhance(panel: HTMLElement) {
    if (panel.classList.contains(READY) || !panel.querySelector('svg')) return;
    panel.classList.add(READY);

    const button = expandButton();
    if (button) {
      button.addEventListener('click', (e) => {
        e.stopPropagation();
        openModal(panel);
      });
      panel.appendChild(button);
    }

    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.mermaid-expand')) return;
      if (window.getSelection()?.toString()) return;
      openModal(panel);
    });
  }

  function scan() {
    document
      .querySelectorAll<HTMLElement>('pre.mermaid[data-processed]:not(.mermaid-modal-host)')
      .forEach(enhance);
  }

  function init() {
    mountViewer();
    scan();

    observer?.disconnect();
    observer = new MutationObserver(scan);
    observer.observe(document.body, {
      subtree: true,
      childList: true,
      attributes: true,
      attributeFilter: ['data-processed'],
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlayId !== null && isTopmost(overlayId)) closeModal();
  });

  document.addEventListener('astro:before-swap', () => {
    closeModal();
    observer?.disconnect();
    observer = null;
  });
  document.addEventListener('astro:page-load', init);

  if (document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init);
</script>
