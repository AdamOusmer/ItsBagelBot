import Icon from '@bagel/ui/astro/Icon.astro';
import Kbd from '@bagel/ui/astro/Kbd.astro';
import { docsI18n } from '../i18n/ui';

interface Props {
  locale: string;
}

const { t } = docsI18n(Astro.props.locale);
---

<button type="button" class="doc-search-button" data-doc-search-open>
  <Icon name="search" size={15} />
  <span class="doc-search-button__label">{t('chrome.search')}</span>
  <span class="doc-search-button__key"><Kbd>/</Kbd></span>
</button>

<style>
  .doc-search-button {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--bb-border);
    border-radius: var(--bb-radius-sm);
    background: rgba(var(--bb-white-pure-rgb), 0.02);
    color: var(--bb-muted);
    font-size: 0.875rem;
    transition: border-color var(--bb-dur-fast) var(--bb-ease-out-expo), color var(--bb-dur-fast) var(--bb-ease-out-expo);
  }

  .doc-search-button:hover {
    border-color: var(--bb-border-strong);
    color: var(--bb-white);
  }

  .doc-search-button__label {
    flex: 1;
    text-align: start;
  }

  @media (hover: none) {
    .doc-search-button__key {
      display: none;
    }
  }
</style>
