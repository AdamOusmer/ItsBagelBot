import Button from '@bagel/ui/astro/Button.astro';
import Icon from '@bagel/ui/astro/Icon.astro';
import Kbd from '@bagel/ui/astro/Kbd.astro';
import { docsI18n } from '../i18n/ui';

interface Props {
  locale: string;
}

const { t } = docsI18n(Astro.props.locale);
---

<Button variant="secondary" block class="doc-search-button" aria-haspopup="dialog">
  <span class="doc-search-button__content">
    <Icon name="search" size={15} />
    <span class="doc-search-button__label">{t('chrome.search')}</span>
    <span class="doc-search-button__key"><Kbd>/</Kbd></span>
  </span>
</Button>

<style>
  :global(.doc-search-button > .bb-btn__content) {
    width: 100%;
  }

  .doc-search-button__content {
    display: flex;
    align-items: center;
    gap: var(--bb-space-2);
    width: 100%;
  }

  .doc-search-button__label {
    flex: 1;
    text-align: start;
  }

  @media (hover: none) {
    .doc-search-button__key {
      display: none;
    }
  }
</style>
