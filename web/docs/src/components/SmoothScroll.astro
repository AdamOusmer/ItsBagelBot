<script>
    import { createSmoothScroll, getSmoothScroll } from "@bagel/ui/lib/lenis";

    createSmoothScroll({
        prevent: (node) =>
            typeof node.closest === "function" && node.closest("[data-lenis-prevent], dialog") !== null,
    });

    document.addEventListener("astro:before-preparation", () => {
        getSmoothScroll()?.stop();
    });

    document.addEventListener("astro:after-swap", () => {
        const lenis = getSmoothScroll();
        if (!lenis) return;
        if (!location.hash) lenis.scrollTo(0, { immediate: true, force: true });
        lenis.start();
    });
</script>
