/**
 * Smooth scroll for the docs, on the shared scroller.
 *
 * This component used to carry its own copy of the marketing site's scroll.js —
 * the same three Lenis options, its own rAF loop parked on `window.__bbLenisRaf`
 * and its own visibilitychange gating — under a comment that said "ported from
 * web/marketing/src/script/scroll.js so the docs feel exactly like the
 * marketing site". A port is a promise that holds only until one of the two is
 * edited. The construction, the tick and the reduced-motion guard now live in
 * @bagel/ui/lib/lenis; what is left here is the one thing that is genuinely
 * docs-specific, the `prevent` predicate for Starlight's nested scroll panes.
 *
 * The global it publishes changed name with the move: `window.lenis` ->
 * `window.__lenis`, which is what the console already used. See the record in
 * ui/lib/lenis.ts for why the prefixed one won.
 */
---

<script>
    import { createSmoothScroll, getSmoothScroll } from "@bagel/ui/lib/lenis";

    // Lenis hijacks wheel and touch at the document level and preventDefaults
    // them, which kills native overflow scrolling inside every nested pane.
    // Exempt Starlight's own scroll containers (left sidebar, right TOC, mobile
    // menu) and any dialog so those scroll normally. Called per node up the
    // event's composed path — return true to hand the gesture back to the
    // browser. `data-lenis-prevent` stays supported for one-offs.
    const PANES =
        "#starlight__sidebar, .right-sidebar, mobile-starlight-toc, dialog, [data-lenis-prevent]";

    // Idempotent in the library: ClientRouter re-runs this script after a swap,
    // and a second call adopts the live instance rather than building a second
    // scroller over the same document.
    createSmoothScroll({
        prevent: (node) =>
            typeof node.closest === "function" && node.closest(PANES) !== null,
    });

    // ClientRouter persists <body> across navigations. Two considerations:
    //   1. Lenis's rAF keeps applying scroll transforms while the view
    //      transition snapshot is taken, which fights the compositor and is the
    //      lag the user reported. Pause it for the swap.
    //   2. Snap to 0 afterwards so the new page does not smooth-animate from
    //      the previous page's offset.
    document.addEventListener("astro:before-preparation", () => {
        getSmoothScroll()?.stop();
    });

    document.addEventListener("astro:after-swap", () => {
        const lenis = getSmoothScroll();
        if (!lenis) return;
        lenis.scrollTo(0, { immediate: true, force: true });
        lenis.start();
    });
</script>
