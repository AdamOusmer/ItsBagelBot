#!/usr/bin/env bash
# Copyright (c) 2026 Adam Ousmer. All rights reserved.
# Proprietary. No license granted. See LICENSE.md.
# Wraps adr-tools with the local template and rewrites the new ADR's title number to the zero-padded filename form.
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

export ADR_TEMPLATE="$project_root/.adr/template.md"

cd "$project_root"

if [ "${1:-}" = "new" ]; then
    shift
    file=$(adr new "$@" | tail -n 1)
    num=$(basename "$file" | grep -oE '^[0-9]+')
    sed -i '' -E "s/^title: \"[0-9]+ - (.*)\"\$/title: \"$num - \\1\"/" "$file"
    echo "$file"
else
    exec adr "$@"
fi
