{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun astro dev",
    "start": "bun --bun astro dev",
    "build": "bun --bun astro build && bun x pagefind --site dist",
    "preview": "bun --bun astro preview",
