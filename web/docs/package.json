  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@bagel/kit": "workspace:*",
    "astro": "^7.4.4",
    "cookie": "^2.0.1",
    "astro-mermaid": "^2.1.0",
    "mermaid": "^12.0.0",
    "pagefind": "^1.5.2",
    "panzoom": "^9.4.4",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "github-slugger": "^2.0.0",
    "mdast-util-from-markdown": "^2.0.2"
