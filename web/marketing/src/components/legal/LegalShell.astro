import Card from '@bagel/ui/astro/Card.astro';
import LightField from '@bagel/ui/astro/LightField.astro';
import BolotaSvg from '../BolotaSvg.astro';
import SectionLane from '../shared/SectionLane.astro';
import SectionLaneList from '../shared/SectionLaneList.astro';
import { staticBolota } from '../../lib/bolota';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

interface Section {
    id: string;
    heading: string;
    plain: string;
    Content: AstroComponentFactory;
}

interface Props {
    eyebrow: string;
    title: string;
    description: string;
    updated: string;
    sections: Section[];
}

const { eyebrow, title, description, updated, sections } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const labels = { summary: t('legal.summary'), updated: t('legal.updated') };
const ordinal = (i: number) => String(i + 1).padStart(2, '0');
const titleWords = title.split(' ');
const reader = staticBolota('sesame_sam', 84, 'green');
---

<div class="lsky" aria-hidden="true">
    <LightField class="bb-light-field--bleed" />
    <div class="bb-orb bb-orb--halo bb-orb--green lorb lorb--green"><i class="bb-orb__pulse"></i></div>
    <div class="bb-orb bb-orb--halo bb-orb--tan lorb lorb--tan"><i class="bb-orb__pulse"></i></div>
</div>

<div class="lshell">
    <header class="lshell__hero">
        <span class="lshell__eyebrow">{eyebrow}</span>
        <h1 class="lshell__title">{titleWords.map((word, i) => <>{i > 0 && ' '}<span class="lshell__word">{word}</span></>)}</h1>
        <p class="lshell__lede">{description}</p>
        <p class="lshell__updated">{`${labels.updated} ${updated}`}</p>
    </header>

    <section class="lshell__short" aria-labelledby="legal-summary">
        <div class="lshell__reader" aria-hidden="true"><BolotaSvg bolota={reader} class="lshell__reader-face" expression="happy" /></div>
        <Card class="lshell__short-card" tone="accent" raised>
            <h2 class="lshell__short-label" id="legal-summary">{labels.summary}</h2>
            <ol class="lshell__short-grid">
                {sections.map((section, i) => (
                    <li class="lshell__short-cell">
                        <a class="lshell__short-item" href={`#${section.id}`}>
                            <span class="lshell__short-num">{ordinal(i)}</span>
                            <span class="lshell__short-heading">{section.heading}</span>
                            <span class="lshell__short-plain">{section.plain}</span>
                        </a>
                    </li>
                ))}
            </ol>
        </Card>
    </section>

    <SectionLaneList>
        {sections.map((section, i) => {
            const Content = section.Content;
            return (
                <SectionLane class="lshell__lane" id={section.id} num={ordinal(i)} heading={section.heading} revealIndex={i + 1}>
                    <div class="bb-prose lshell__body"><Content /></div>
                </SectionLane>
            );
        })}
    </SectionLaneList>
</div>

<style>
    .lsky {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
    }

    .lorb { --bb-orb-opacity: 0.14; }
    .lorb--green { width: 520px; height: 520px; top: -140px; right: -80px; }
    .lorb--tan { width: 420px; height: 420px; bottom: -120px; left: -100px; --bb-orb-pulse-delay: 400ms; }

    .lshell {
        display: flex;
        flex-direction: column;
        gap: var(--bb-space-8);
        width: min(100% - 32px, 1120px);
        margin-inline: auto;
        padding: calc(var(--nav-offset) + var(--bb-space-8)) 0 var(--bb-space-section);
    }

    .lshell__hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--bb-space-3);
        text-align: center;
    }

    .lshell__eyebrow {
        font-size: var(--bb-text-md);
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--bb-green-glow);
        text-shadow: 0 0 18px rgba(var(--bb-green-glow-rgb), 0.45);
    }

    .lshell__title {
        margin: 0;
        font-family: var(--bb-font-display);
        font-size: clamp(2.5rem, 5.5vw, 4.25rem);
        font-weight: 500;
        letter-spacing: var(--bb-tracking-display);
        line-height: 1.04;
    }

    .lshell__word {
        display: inline-block;
        background: linear-gradient(180deg, var(--bb-white) 40%, rgba(var(--bb-tan-light-rgb), 0.55));
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        filter: drop-shadow(0 0 36px rgba(var(--bb-tan-rgb), 0.18));
    }

    .lshell__lede {
        max-width: 56ch;
        margin: 0;
        font-size: var(--bb-text-md);
        line-height: 1.6;
        color: var(--bb-muted-light);
    }

    .lshell__updated {
        margin: 0;
        font: var(--bb-text-xs)/1.4 var(--bb-font-mono);
        letter-spacing: 0.06em;
        color: var(--bb-muted);
    }

    .lshell__short {
        display: flex;
        flex-direction: column;
    }

    .lshell__reader {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: center;
        height: 84px;
        margin-bottom: -40px;
    }

    .lshell__reader :global(.lshell__reader-face) {
        width: 84px;
        height: 84px;
        overflow: visible;
        /* One transform, not scale + translate: Chrome runs independent transform properties on an svg on the main thread. */
        scale: none;
        transform: scale(0.9);
        animation: lshell-bob 6.5s ease-in-out infinite alternate;
    }

    .lshell__short :global(.lshell__short-card) {
        padding: calc(var(--bb-space-7) + 6px) var(--bb-space-6) var(--bb-space-6);
    }

    .lshell__short-label {
        margin: 0 0 var(--bb-space-4);
        font-size: var(--bb-text-md);
        font-weight: 700;
        text-align: center;
        color: var(--bb-green-glow);
        text-shadow: 0 0 18px rgba(var(--bb-green-glow-rgb), 0.45);
    }

    .lshell__short-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--bb-space-2) var(--bb-space-5);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .lshell__short-cell { min-width: 0; }

    .lshell__short-item {
        display: grid;
        grid-template-columns: 2rem minmax(0, 1fr);
        column-gap: var(--bb-space-2);
        height: 100%;
        padding: var(--bb-space-3);
        border-radius: var(--bb-radius-sm);
        color: inherit;
        text-decoration: none;
        transition: background var(--bb-dur-fast) ease;
    }

    .lshell__short-item:hover { background: rgba(var(--bb-white-rgb), 0.04); }

    .lshell__short-item:focus-visible {
        outline: 2px solid var(--bb-focus);
        outline-offset: 2px;
    }

    .lshell__short-num {
        grid-row: span 2;
        font: var(--bb-text-xs)/1.6 var(--bb-font-mono);
        color: var(--bb-tan-light);
    }

    .lshell__short-heading {
        font-size: var(--bb-text-sm);
        font-weight: 600;
        color: var(--bb-paper);
    }

    .lshell__short-plain {
        font-size: var(--bb-text-sm);
        line-height: 1.5;
        color: var(--bb-muted-light);
    }

    .lshell__body { max-width: 68ch; }

    @keyframes lshell-bob {
        from { transform: translate(0, 0) scale(0.9); }
        to { transform: translate(0, -6px) scale(0.9); }
    }

    @media (prefers-reduced-motion: reduce) {
        .lshell__reader :global(.lshell__reader-face) { animation: none; }
    }

    @media (max-width: 900px) {
        .lshell__short-grid { grid-template-columns: minmax(0, 1fr); }
    }

    @media (max-width: 640px) {
        .lshell { padding-top: calc(var(--nav-offset) + var(--bb-space-6)); }
        .lshell__short :global(.lshell__short-card) { padding-inline: var(--bb-space-4); }
    }
</style>
