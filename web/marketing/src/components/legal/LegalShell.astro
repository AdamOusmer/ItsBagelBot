import SectionNav from '@bagel/ui/astro/SectionNav.astro';
import AlertBanner from '@bagel/ui/astro/AlertBanner.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Label from '@bagel/ui/astro/Label.astro';
import Tag from '@bagel/ui/astro/Tag.astro';
import Text from '@bagel/ui/astro/Text.astro';

import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

interface Section {
    id: string;
    heading: string;
    plain: string;
    Content: AstroComponentFactory;
}

interface Props {
    updated: string;
    sections: Section[];
}

import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const { updated, sections } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const labels = { toc: t('legal.toc'), updated: t('legal.updated'), plain: t('legal.plain') };
const tocItems = sections.map((section) => ({
    href: `#${section.id}`,
    label: section.heading,
    attrs: { 'data-legal-link': section.id },
}));
---

<div class="lshell">
    <div class="lshell__grid">
        <div class="lshell__toc">
            <Label mono as="span" class="lshell__toc-label">{labels.toc}</Label>
            <SectionNav variant="toc" label={labels.toc} items={tocItems} data-legal-toc />
        </div>

        <article class="lshell__content">
            <Text size="xs" mono tone="positive" class="lshell__updated" data-reveal>{`${labels.updated} ${updated}`}</Text>

            {sections.map((section, i) => {
                const Content = section.Content;
                return (
                    <div class="lshell__block" id={section.id} data-reveal style={`--reveal-i: ${Math.min(i + 1, 6)}`}>
                        <Heading level={4} as="h2" class="lshell__heading">{section.heading}</Heading>
                        <AlertBanner tone="success" role="note" class="lshell__plain" variant="callout"><Tag tone="live" bare class="lshell__plain-tag">{labels.plain}</Tag>{section.plain}</AlertBanner>
                        <Content />
                    </div>
                );
            })}
        </article>
    </div>
</div>

<style>
    .lshell {
        max-width: var(--bb-content-max);
        margin: 0 auto;
        padding: 0 24px 96px;
    }

    .lshell__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 48px;
    }

    @media (min-width: 980px) {
        .lshell__grid {
            grid-template-columns: 220px minmax(0, 1fr);
            gap: 72px;
        }
    }

    .lshell__toc { display: none; }

    @media (min-width: 980px) {
        .lshell__toc {
            display: block;
            position: sticky;
            top: calc(var(--nav-offset) + 32px);
            align-self: start;
        }
    }

    .lshell__toc-label { margin-bottom: 16px; }

    .lshell__content { max-width: var(--bb-content-text); }

    .lshell__updated {
        margin-bottom: 48px;
        letter-spacing: 0.08em;
    }

    .lshell__block { scroll-margin-top: calc(var(--nav-offset) + 24px); }

    .lshell__heading { margin: 52px 0 12px; }

    .lshell__plain { margin: 0 0 16px; }

    .lshell__plain-tag { margin-right: 8px; }

    .lshell__block:first-of-type .lshell__heading { margin-top: 0; }

    .lshell__block :global(p),
    .lshell__block :global(ul) {
        font-family: var(--bb-font-body);
        font-size: 0.94rem;
        color: var(--bb-muted);
        line-height: 1.8;
        margin-bottom: 14px;
    }

    .lshell__block :global(ul) {
        padding-left: 1.4em;
        list-style-type: disc;
    }

    .lshell__block :global(ul li) { margin-bottom: 7px; }
    .lshell__block :global(ul li::marker) { color: var(--bb-green-glow); }

    .lshell__block :global(a) {
        color: var(--bb-tan);
        border-bottom: 1px solid transparent;
        transition: color var(--bb-dur-fast) ease, border-color var(--bb-dur-fast) ease;
    }

    .lshell__block :global(a:hover) {
        color: var(--bb-tan-light);
        border-bottom-color: var(--bb-tan-light);
    }

    @media (max-width: 480px) {
        .lshell { padding: 0 16px 72px; }
        .lshell__heading { margin-top: 40px; }
    }
</style>

<script>
    import { mountSectionNav } from '@bagel/ui/lib/scroll-spy';

    let dispose: (() => void) | undefined;

    function unmountToc() {
        dispose?.();
        dispose = undefined;
    }

    function mountToc() {
        unmountToc();
        const toc = document.querySelector<HTMLElement>('[data-legal-toc]');
        if (toc) dispose = mountSectionNav(toc);
    }

    mountToc();
    document.addEventListener('astro:page-load', mountToc);
    document.addEventListener('astro:before-swap', unmountToc);
    window.addEventListener('pagehide', unmountToc);
    window.addEventListener('pageshow', (event) => { if (event.persisted) mountToc(); });
</script>
