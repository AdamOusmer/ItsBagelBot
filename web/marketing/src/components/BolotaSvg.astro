import ClientProps from '@bagel/kit/components/ClientProps.astro';
import type { StaticBolota } from '../lib/bolota';

interface Props {
    bolota: StaticBolota;
    expression?: string;
    follow?: boolean;
    class?: string;
    style?: string;
}

const { bolota, expression, follow = false, class: className, style, ...rest } = Astro.props;
---

<svg
    class:list={['live-bolota', className]}
    style={style}
    viewBox="0 0 100 100"
    aria-hidden="true"
    {...rest}
    set:html={bolota.inner}
/>
<ClientProps value={{ name: bolota.name, size: bolota.size, palette: { head: bolota.head, eye: bolota.eye }, expression, follow }} />

<style>
    svg { scale: 0.9; }
</style>
