import NavLink from '@bagel/ui/astro/NavLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations, defaultLang } from '../../i18n/ui';

interface Props {
    links: { href: string; label: string }[];
    ctaHref?: string;
    ctaLabel?: string;
}

const { links, ctaHref = "#", ctaLabel = "Add to Twitch" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const getAppHref = `https://dashboard.itsbagelbot.com/?install=1${lang === defaultLang ? '' : `&lang=${lang}`}`;
---

<div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true" inert>
    <svg class="mobile-menu__curve" aria-hidden="true" focusable="false">
        <defs>
            <clipPath id="mobile-menu-clip" clipPathUnits="userSpaceOnUse">
                <path class="mobile-menu__curve-path" data-menu-curve-path d=""></path>
            </clipPath>
        </defs>
    </svg>

    <div class="mobile-menu__panel" role="dialog" aria-label={t('menu.primary')} aria-modal="true">
        <ul class="mobile-menu__links">
            {links.map((link) => (
                <li data-menu-item><NavLink class="mobile-menu__link" href={link.href} label={link.label} block /></li>
            ))}
        </ul>

        <div class="mobile-menu__footer" data-menu-footer>
            <NavLink class="mobile-menu__cta" variant="cta" href={ctaHref} label={ctaLabel} block />
            <a class="mobile-menu__app" href={getAppHref}>{t('nav.getApp')}</a>
            <div class="mobile-menu__lang"><LanguageSwitcher /></div>
            <span class="mobile-menu__meta">{t('menu.meta')}</span>
        </div>
    </div>
</div>

<style>
    .mobile-menu {
        display: none;
        position: fixed;
        inset: var(--nav-offset, 76px) 0 0;
        padding: 16px;
        background: rgba(10, 10, 10, 0.72);
        backdrop-filter: blur(22px);
        z-index: 49;
        isolation: isolate;
        overflow: hidden;
        transform: translateY(-100%);
        clip-path: url(#mobile-menu-clip);
        -webkit-clip-path: url(#mobile-menu-clip);
        will-change: transform;

        visibility: hidden;
        pointer-events: none;
    }

    .mobile-menu.is-visible {
        visibility: visible;
    }

    .mobile-menu.is-open {
        pointer-events: auto;
    }

    .mobile-menu__curve {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    .mobile-menu__curve-path {
        fill: #fff;
    }

    .mobile-menu__panel {
        position: relative;
        z-index: 1;
        width: min(720px, 100%);
        height: 100%;
        margin: 0 auto;
        padding: clamp(34px, 6vw, 56px);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 40px;
        overflow-y: auto;
    }

    /* ─── Links ─── */
    .mobile-menu__links {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    /* The panel's links are the same `.bb-nav-link` the bar and the footer
       render; only the type changes, and it changes through the contract's own
       properties rather than by restating the look. Display face at 2.45rem is
       the panel's editorial voice and predates the element. line-height stays
       at 1.2, not the contract's 1 — at 2.45rem a line-height of 1 clips Syne's
       descenders against the 8px list gap.

       No :active colour swap any more. It was the only feedback a touch user
       got, and it fired after the tap had already committed; the contract's
       drawline runs under the label on :hover AND :focus-visible, which is what
       a touch device reports on press. */
    .mobile-menu__link {
        --bb-nav-link-family: var(--font-display, "Syne", sans-serif);
        --bb-nav-link-size: 2.45rem;
        --bb-nav-link-weight: 700;
        --bb-nav-link-tracking: 0;
        --bb-nav-link-transform: none;
        --bb-nav-link-pad: 6px 0 10px;
        --bb-nav-link-rest: var(--white, #f0ece4);
        line-height: 1.2;
    }

    .mobile-menu__links li,
    .mobile-menu__footer {
        opacity: 0;
        transform: translateY(-28px);
        will-change: opacity, transform;
    }

    /* ─── Footer ─── */
    .mobile-menu__footer {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-bottom: calc(clamp(56px, 8vh, 86px) + env(safe-area-inset-bottom, 0px));
        padding-top: 24px;
        border-top: 1px solid rgba(201, 168, 124, 0.15);
    }

    /* The panel CTA is the bar CTA: same filled variant, same green, so the two
       entry points to the dashboard cannot drift. It was `bb-btn bb-btn--primary`
       before, and `.bb-btn--primary` has never existed in this stylesheet — the
       class was inert and the button fell back to the bare hollow tan frame,
       which is why the panel's call to action looked quieter than the bar's. */
    .mobile-menu__cta {
        justify-content: center;
    }

    .mobile-menu__app {
        display: block;
        text-align: center;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.78rem;
        letter-spacing: 0;
        text-transform: uppercase;
        color: var(--tan-light, #e0c49a);
        text-decoration: underline;
        text-decoration-color: rgba(201, 168, 124, 0.4);
        text-underline-offset: 4px;
        transition: color 200ms ease;
    }

    .mobile-menu__app:active { color: var(--green-glow, #52b788); }

    .mobile-menu__lang {
        display: flex;
        justify-content: center;
    }

    .mobile-menu__meta {
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.7rem;
        letter-spacing: 0;
        text-transform: uppercase;
        color: var(--muted, #888077);
        text-align: center;
    }

    @media (max-width: 1023px) {
        .mobile-menu { display: flex; }
    }

    @media (max-width: 639px) {
        .mobile-menu {
            padding: 0;
            background: rgba(10, 10, 10, 0.96);
        }

        .mobile-menu__panel {
            width: 100%;
            padding: 32px 24px 28px;
        }

        .mobile-menu__link {
            font-size: 2.2rem;
        }

        .mobile-menu__footer {
            margin-bottom: calc(clamp(64px, 9vh, 92px) + env(safe-area-inset-bottom, 0px));
        }
    }

    @media (max-width: 380px) {
        .mobile-menu__panel {
            padding: 28px 20px 24px;
        }

        .mobile-menu__link {
            font-size: 2rem;
        }
    }
</style>
