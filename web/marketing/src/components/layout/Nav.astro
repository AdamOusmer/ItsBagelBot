/**
 * The site nav, as this site's data.
 *
 * The bar, the floating pill, the hamburger, the top-down panel and its
 * choreography are @bagel/ui's `.bb-nav` family now. What is left here is
 * everything that made the 430-line component this site's and only this
 * site's: five links resolved from the i18n catalog, `localizePath`, the
 * dashboard login URL, and the "get the app" row in the panel footer.
 */
import { getImage } from 'astro:assets';
import logoImage from '../../assets/LogoBOT.png';
import Nav from '@bagel/ui/astro/Nav.astro';
import LanguageSwitcher from '@bagel/ui/astro/LanguageSwitcher.astro';
import {
    getLangFromUrl,
    useTranslations,
    localizePath,
    dashLoginHref,
    localeOptions,
    defaultLang,
} from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
    { href: localizePath("/pricing", lang),  label: t('nav.pricing')  },
    { href: localizePath("/guides", lang),   label: t('nav.guides')   },
    { href: localizePath("/contact", lang),  label: t('nav.contact')  },
    { href: "https://stats.itsbagelbot.com", label: t('nav.stats')    },
    { href: "https://status.itsbagelbot.com",label: t('nav.status')   },
];

const cta = { href: dashLoginHref(lang), label: t('nav.cta') };

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
    href.startsWith("/") && href.replace(/\/+$/, "") === currentPath;

// The mark is resolved through getImage rather than passed as the raw import:
// LogoBOT.png is a 1 MB source file, and `logoImage.src` would put THAT in the
// bar on every page. 52px is the 26px mark at 2x. Same reason and same shape
// as the builder's avatar (CommandBuilder.astro).
const logo = await getImage({ src: logoImage, width: 52, height: 52, format: 'webp' });

const locales = localeOptions(Astro.url);
const getAppHref = `https://dashboard.itsbagelbot.com/?install=1${lang === defaultLang ? '' : `&lang=${lang}`}`;
---

<Nav
    brand={{ title: 'ItsBagelBot', href: localizePath("/", lang), logoSrc: logo.src, logoAlt: '' }}
    links={links.map((link) => ({ ...link, active: isActive(link.href) }))}
    cta={cta}
    locales={locales}
    localeLabel="Language"
    ariaLabel={t('nav.primary')}
    menuLabels={{ open: t('nav.menuOpen'), close: t('nav.menuClose'), panel: t('menu.primary') }}
    menuMeta={t('menu.meta')}
>
    <Fragment slot="mobileFooter">
        <a class="mobile-menu__app" href={getAppHref}>{t('nav.getApp')}</a>
        <div class="mobile-menu__lang"><LanguageSwitcher options={locales} ariaLabel="Language" /></div>
    </Fragment>
</Nav>

<style>
    /* The two rows this site adds to the panel's footer. They are slotted into
       @bagel/ui's panel, and slotted markup carries the scope attribute of the
       file it is WRITTEN in -- this one -- so these rules reach it. */
    .mobile-menu__app {
        display: block;
        text-align: center;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.78rem;
        letter-spacing: 0;
        text-transform: uppercase;
        color: var(--tan-light, #e0c49a);
        text-decoration: underline;
        text-decoration-color: rgba(201, 168, 124, 0.4);
        text-underline-offset: 4px;
        transition: color 200ms ease;
    }

    .mobile-menu__app:active { color: var(--green-glow, #52b788); }

    .mobile-menu__lang {
        display: flex;
        justify-content: center;
    }
</style>
