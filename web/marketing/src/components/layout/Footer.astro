/**
 * The sign-off, as this site's data.
 *
 * The layout, the ember behind the goodbye line, the columns and the bottom
 * strip are @bagel/ui's `.bb-footer`. Two things stay here.
 *
 * The first is the copy and the routes, as everywhere else.
 *
 * The second is the ownership colophon, and it is NOT a copy decision: it is
 * bot-specific, homepage-only, and load-bearing for an external ownership
 * check. It is passed into the footer's `colophon` slot rather than moved.
 */
import { getImage } from 'astro:assets';
import logoImage from '../../assets/LogoBOT.png';
import Footer from '@bagel/ui/astro/Footer.astro';
import { OWNER_IGN, OWNER_PROFILE_URL } from '../../owner';
import { getLangFromUrl, useTranslations, localizePath, defaultLang } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const dashboardQuery = lang === defaultLang ? '' : `?lang=${lang}`;

// The ownership colophon sits in its own mini section just above the footer,
// not inside it. It names the owner, so it keeps the {ign} placeholder split
// that lets each locale put the linked handle where its own prose needs it.
// The game trademark notices live in the Terms of Service (11-third-party).
const [ownerBefore, ownerAfter = ''] = t('about.line1').split('{ign}');
const [keyBefore, keyAfter = ''] = t('about.mcLine').split('{ign}');

// Landing page only: the colophon is the homepage's sign-off, not sitewide
// chrome. Trailing slashes normalized because localizePath always emits one
// and Astro serves both shapes.
const normalize = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const isHome = normalize(Astro.url.pathname) === localizePath('/', lang);

// 110px is the 55px mark at 2x; see the same note in Nav.astro for why the
// 1 MB source is never handed to the library directly.
const logo = await getImage({ src: logoImage, width: 110, height: 110, format: 'webp' });

const columns = [
    {
        title: t('footer.product'),
        links: [
            { href: localizePath("/pricing", lang), label: t('footer.pricing') },
            { href: localizePath("/guides", lang), label: t('footer.guides') },
            { href: localizePath("/changelog", lang), label: t('footer.changelog') },
            { href: localizePath("/command-builder", lang), label: t('footer.builder') },
        ],
    },
    {
        title: t('footer.company'),
        links: [
            { href: localizePath("/contact", lang), label: t('footer.contact') },
            { href: "https://stats.itsbagelbot.com", label: t('footer.stats'), external: true },
            { href: "https://status.itsbagelbot.com", label: t('footer.status'), external: true },
        ],
    },
    {
        title: t('footer.community'),
        links: [
            { href: "https://discord.gg/SZ2remwSDv", label: "Discord", external: true },
            { href: "https://twitch.tv/itsbagelbot", label: "Twitch", external: true },
            { href: "https://github.com/AdamOusmer/ItsBagelBot", label: "GitHub", external: true },
            { href: "https://docs.itsbagelbot.com", label: t('footer.developer'), external: true },
            { href: `https://dashboard.itsbagelbot.com${dashboardQuery}`, label: t('footer.dashboard'), external: true },
        ],
    },
];

const legal = [
    { href: localizePath('/privacy', lang), label: t('footer.privacy') },
    { href: localizePath('/terms', lang), label: t('footer.terms') },
    { href: localizePath('/creator-terms', lang), label: t('footer.creatorTerms') },
];
---

<Footer
    brand={{ title: 'ItsBagelBot', sub: t('footer.tagline'), logoSrc: logo.src, logoAlt: 'ItsBagelBot Logo' }}
    signoff={{ line: t('footer.signoff'), sub: t('footer.signoffSub') }}
    columns={columns}
    legal={legal}
    copyright="© 2026 ItsBagelBot"
    note={t('footer.note')}
>
    {/* Deliberately NOT gated behind data-reveal: every revealed block starts at
        opacity 0 (reveal.css [data-reveal]) and only appears once the reveal
        observer runs, and Hypixel verifies ownership by scanning served HTML for
        the username as visible text. A reviewer with JS off has to find ItsMavey
        here, so this stays statically visible. The id stays "about": it is the
        ownership colophon; tests/site.spec.js scans #about for the NameMC links. */}
    {isHome && <section class="colophon" slot="colophon">
        <div class="colophon__owner" id="about">
            <p>{ownerBefore}<a
                class="colophon__ign"
                href={OWNER_PROFILE_URL}
                target="_blank"
                rel="noopener noreferrer"
            >{OWNER_IGN}</a>{ownerAfter}</p>
            <p>{keyBefore}<a
                class="colophon__ign"
                href={OWNER_PROFILE_URL}
                target="_blank"
                rel="noopener noreferrer"
            >{OWNER_IGN}</a>{keyAfter}</p>
        </div>
    </section>}
</Footer>

<style>
    /* The sign-off's hand-written sub-line. Caveat is this site's decorative
       accent and is not in the shared font set, so it arrives as the contract's
       own custom property rather than as a rule that would have to win a
       specificity fight with it. */
    :global(.bb-footer) {
        --footer-signoff-sub-font: var(--font-hand, "Caveat", cursive);
    }

    .colophon {
        position: relative;
        padding: 28px 24px;
        border-top: 1px solid var(--border, rgba(255, 255, 255, 0.08));
        text-align: center;
        font-family: var(--font-mono);
        color: var(--muted);
    }

    .colophon__owner {
        max-width: 760px;
        margin: 0 auto;
    }

    .colophon__owner p {
        margin: 0 0 8px;
        font-size: 0.72rem;
        letter-spacing: 0.05em;
        line-height: 1.8;
    }

    .colophon__ign {
        color: var(--tan-light);
        text-decoration: underline;
        text-decoration-color: rgba(224, 196, 154, 0.4);
        text-underline-offset: 3px;
        transition: color 180ms ease, text-decoration-color 180ms ease;
    }

    .colophon__ign:is(:hover, :focus-visible) {
        color: var(--white);
        text-decoration-color: rgba(240, 236, 228, 0.7);
    }
</style>
