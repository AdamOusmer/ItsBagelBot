import { SITE } from '@bagel/kit/site-links';

import Icon from '@bagel/ui/astro/Icon.astro';
import Tag from '@bagel/ui/astro/Tag.astro';
import Chip from '@bagel/ui/astro/Chip.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Text from '@bagel/ui/astro/Text.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Line {
    index: string;
    title: string;
    note: string;
    href: string;
    hint: string;
    external?: boolean;
    copy?: string;
    tone: 'green' | 'tan';
}

const lines: Line[] = [
    {
        index: '01',
        title: t('board.l1Title'),
        note: t('board.l1Note'),
        href: SITE.discord,
        hint: t('board.l1Hint'),
        external: true,
        tone: 'green',
    },
    {
        index: '02',
        title: t('board.l2Title'),
        note: t('board.l2Note'),
        href: `mailto:${SITE.supportEmail}`,
        hint: SITE.supportEmail,
        copy: SITE.supportEmail,
        tone: 'tan',
    },
    {
        index: '03',
        title: t('board.l3Title'),
        note: t('board.l3Note'),
        href: `mailto:${SITE.enterpriseEmail}`,
        hint: SITE.enterpriseEmail,
        copy: SITE.enterpriseEmail,
        tone: 'tan',
    },
    {
        index: '04',
        title: t('board.l4Title'),
        note: t('board.l4Note'),
        href: SITE.github,
        hint: t('board.l4Hint'),
        external: true,
        tone: 'green',
    },
];
---

<section class="board">
    <div class="board__list">
        {lines.map((line, i) => (
            <div
                class:list={['line', `line--${line.tone}`]}
                data-reveal
                style={`--reveal-i: ${i}`}
            >
                <a
                    class="line__target"
                    href={line.href}
                    aria-label={`${line.title}: ${line.note}`}
                    target={line.external ? '_blank' : undefined}
                    rel={line.external ? 'noopener noreferrer' : undefined}
                ></a>
                <Text as="span" size="xs" mono tone="muted" class="line__index" aria-hidden="true">{line.index}</Text>
                <Tag
                    tone={line.tone === 'green' ? 'live' : 'paid'}
                    mark="solid"
                    sweep={line.tone === 'green'}
                    class="line__dot"
                    aria-hidden="true"
                />
                <span class="line__main">
                    <Heading level={5} as="span" class="line__title">{line.title}</Heading>
                    <Text as="span" size="sm" tone="muted" class="line__note">{line.note}</Text>
                </span>
                <span class="line__meta">
                    {line.copy ? (
                        <Chip
                            tone="muted"
                            class="line__copy"
                            data-copy={line.copy}
                            aria-label={`${t('board.copy')} ${line.copy}`}
                        >
                            <span>{line.hint}</span>
                            <span class="line__copy-icon line__copy-icon--default" aria-hidden="true">
                                <Icon name="copy" size={13} strokeWidth={2} />
                            </span>
                            <span class="line__copy-icon line__copy-icon--done" aria-hidden="true">
                                <Icon name="check" size={13} strokeWidth={2.5} />
                            </span>
                        </Chip>
                    ) : (
                        <Text as="span" size="xs" mono tone="muted" class="line__hint">{line.hint}</Text>
                    )}
                    <span class="line__arrow" aria-hidden="true">→</span>
                </span>
            </div>
        ))}
    </div>

    <Text size="xs" mono tone="muted" class="board__note" data-reveal>
        {t('board.note')}
    </Text>
</section>

<style>
    .board {
        max-width: 860px;
        margin: 0 auto;
        padding: 0 24px var(--bb-space-section);
    }

    .board__list {
        border-top: 1px solid var(--bb-border);
    }

    .line {
        position: relative;
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 26px 12px;
        border-bottom: 1px solid var(--bb-border);
        text-decoration: none;
        overflow: hidden;
        transition: padding-left var(--bb-dur-base) var(--bb-ease-out-expo), background var(--bb-dur-base) ease;
    }

    .line::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(var(--bb-tan-rgb), 0.07), transparent 65%);
        opacity: 0;
        transform: translateX(-16px);
        transition: opacity var(--bb-dur-base) ease, transform var(--bb-dur-base) var(--bb-ease-out-expo);
        pointer-events: none;
    }

    .line__target {
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: var(--bb-radius-xs);
    }

    .line__target:focus-visible {
        outline: 2px solid var(--bb-tan-light);
        outline-offset: -3px;
    }

    @media (hover: hover) and (pointer: fine) {
        .line:hover { padding-left: 24px; }
        .line:hover::before { opacity: 1; transform: none; }
    }

    .line__index {
        flex-shrink: 0;
        transition: color var(--bb-dur-fast) ease;
    }

    .line:hover .line__index { color: var(--bb-tan); }

    .line__dot { flex-shrink: 0; }

    .line__main {
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 0;
        flex: 1;
    }

    .line__title {
        transition: color var(--bb-dur-fast) ease;
    }

    .line:hover .line__title { color: var(--bb-tan-light); }

    .line__note {
        max-width: 52ch;
    }

    .line__meta {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-shrink: 0;
    }

    .line__hint {
        transition: color var(--bb-dur-fast) ease;
    }

    .line:hover .line__hint { color: var(--bb-tan-light); }

    .line__copy {
        position: relative;
        z-index: 2;
    }

    .line__copy-icon { display: inline-flex; line-height: 0; }
    .line__copy-icon--done { display: none; }

    .line__copy.is-done .line__copy-icon--default { display: none; }
    .line__copy.is-done .line__copy-icon--done { display: inline-flex; }

    .line__arrow {
        font-family: var(--bb-font-mono);
        color: var(--bb-tan);
        opacity: 0;
        transform: translateX(-8px);
        transition: opacity var(--bb-dur-base) ease, transform var(--bb-dur-base) var(--bb-ease-out-expo);
    }

    @media (hover: hover) and (pointer: fine) {
        .line:hover .line__arrow { opacity: 1; transform: none; }
    }

    @media (hover: none) {
        .line__arrow { opacity: 0.5; transform: none; }
    }

    .board__note {
        --reveal-i: 4;
        text-align: center;
        margin-top: 40px;
        opacity: 0.8;
    }

    @media (prefers-reduced-motion: reduce) {
        .line, .line::before, .line__arrow { transition: none; }
    }

    @media (max-width: 640px) {
        .line {
            flex-wrap: wrap;
            gap: 12px;
            padding: 22px 4px;
        }
        .line__main { flex-basis: 100%; order: 3; }
        .line__meta { margin-left: auto; }
    }
</style>
