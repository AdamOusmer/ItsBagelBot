import { SITE } from '@bagel/kit/site-links';
import { SOCIAL_LINKS } from '@bagel/kit/social';
import ButtonLink from '@bagel/ui/astro/ButtonLink.astro';
import Icon from '@bagel/ui/astro/Icon.astro';
import LightField from '@bagel/ui/astro/LightField.astro';
import type { IconName } from '@bagel/ui/lib/icons';
import brandTokens from '@bagel/ui/styles/brand.css?raw';
import { parts, type Palette } from '@luzir/bolota';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const t = useTranslations(getLangFromUrl(Astro.url));

function token(name: string): string {
    const value = brandTokens.match(new RegExp(`--${name}:\\s*(#[0-9a-fA-F]{3,8})\\s*;`))?.[1];
    if (!value) throw new Error(`@bagel/ui brand.css has no color token --${name}`);
    return value;
}

const PALETTES: Palette[] = ['bb-green-glow', 'bb-tan-light', 'bb-tan-pale'].map((head) => ({
    head: token(head),
    eye: token('bb-black'),
}));

function bolota(name: string, size: number, palette: number) {
    const colors = PALETTES[palette];
    return { name, size, colors, inner: parts(name, { size, palette: colors, background: false }).inner };
}

const mascot = bolota('oven_fresh', 260, 0);
const communityFaces = [bolota('kiki_bakes', 34, 2), bolota('ren_exe', 34, 1), bolota('sesame_sam', 34, 0)];
const supportFaces = [bolota('kassidy_mod', 34, 1)];

const ext = { target: '_blank', rel: 'noopener noreferrer' };

interface Lane {
    key: 'community' | 'support';
    faces: ReturnType<typeof bolota>[];
    href: string;
    icon?: IconName;
    external?: boolean;
}

const lanes: Lane[] = [
    { key: 'community', faces: communityFaces, href: SITE.discord, icon: 'discord', external: true },
    { key: 'support', faces: supportFaces, href: `mailto:${SITE.supportEmail}` },
];

interface Item {
    key: 'enterprise' | 'source' | 'docs';
    icon: IconName;
    href: string;
    external?: boolean;
}

const items: Item[] = [
    { key: 'enterprise', icon: 'server', href: `mailto:${SITE.enterpriseEmail}` },
    { key: 'source', icon: 'github', href: SITE.newIssue, external: true },
    { key: 'docs', icon: 'list', href: SITE.docs, external: true },
];

const STATES = ['operational', 'degraded', 'downtime', 'maintenance'] as const;
const stateText = Object.fromEntries(
    STATES.map((state) => [`data-text-${state}`, t(`contact.status${state[0].toUpperCase()}${state.slice(1)}`)]),
);

const socials = [
    { label: 'Twitch', href: SITE.twitch, icon: 'twitch' as IconName },
    ...SOCIAL_LINKS.filter((link) => link.icon !== 'discord' && link.icon !== 'github'),
];

const titleWords = t('contact.title').split(' ');
---

<section class="stage">
    <div class="starfield" aria-hidden="true"><LightField class="bb-light-field--bleed" /></div>
    <div class="bg" aria-hidden="true">
        <div class="bb-orb bb-orb--halo bb-orb--green orb orb-1"><i class="bb-orb__pulse"></i></div>
        <div class="bb-orb bb-orb--halo bb-orb--tan orb orb-2"><i class="bb-orb__pulse"></i></div>
    </div>

    <div class="wrap">
        <div class="top">
            <div class="head">
                <span class="glow"><span data-fit>{t('contact.eyebrow')}</span></span>
                <h1 class="title" data-contact-title><span data-fit="block">{titleWords.map((word, i) => (
                    <>{i > 0 && ' '}<span class="word" data-contact-word>{word}</span></>
                ))}</span></h1>
                <p class="lede rise" style="--i: 1"><span data-fit="block">{t('contact.desc')}</span></p>
            </div>
            <div class="mascot" aria-hidden="true">
                <svg
                    class="bolota"
                    viewBox="0 0 100 100"
                    data-contact-bolota={mascot.name}
                    data-size={mascot.size}
                    data-head={mascot.colors.head}
                    data-eye={mascot.colors.eye}
                    data-follow
                    set:html={mascot.inner}
                />
            </div>
        </div>

        <div class="lanes">
            {lanes.map((lane, i) => (
                <div class="lane rise" style={`--i: ${i + 2}`}>
                    <span class="label">
                        <span class="faces" aria-hidden="true">
                            {lane.faces.map((face) => (
                                <svg
                                    class="face"
                                    viewBox="0 0 100 100"
                                    data-contact-bolota={face.name}
                                    data-size={face.size}
                                    data-head={face.colors.head}
                                    data-eye={face.colors.eye}
                                    set:html={face.inner}
                                />
                            ))}
                        </span>
                        <span class="label__text"><span data-fit>{t(`contact.${lane.key}Label`)}</span></span>
                    </span>
                    <p class="say"><span data-fit="block">{t(`contact.${lane.key}Text`)}</span></p>
                    <ButtonLink class="cta" href={lane.href} {...(lane.external ? ext : {})}>
                        {lane.icon && <Icon name={lane.icon} size={15} />}
                        <span data-fit>{t(`contact.${lane.key}Cta`)}</span>
                    </ButtonLink>
                </div>
            ))}
        </div>

        <div class="more rise" style="--i: 4">
            {items.map((item) => (
                <div class="item">
                    <span class="label"><Icon name={item.icon} size={14} /><span class="label__text"><span data-fit>{t(`contact.${item.key}Label`)}</span></span></span>
                    <p class="item__text"><span data-fit="block">{t(`contact.${item.key}Text`)}</span></p>
                    <ButtonLink class="cta cta--sm" variant="secondary" size="sm" href={item.href} {...(item.external ? ext : {})}>
                        <span data-fit>{t(`contact.${item.key}Cta`)}</span>
                    </ButtonLink>
                </div>
            ))}
            <div class="item" data-contact-status data-state="unknown" {...stateText}>
                <span class="label"><span class="beacon" aria-hidden="true"></span><span class="label__text"><span data-fit>{t('contact.statusLabel')}</span></span></span>
                <p class="item__text" aria-live="polite"><span data-fit="block" data-contact-status-text>{t('contact.statusUnknown')}</span></p>
                <ButtonLink class="cta cta--sm" variant="secondary" size="sm" href={SITE.status} {...ext}>
                    <span data-fit>{t('contact.statusCta')}</span>
                </ButtonLink>
            </div>
        </div>

        <div class="socials rise" style="--i: 5">
            <span class="label label--follow"><span class="label__text"><span data-fit>{t('contact.followLabel')}</span></span></span>
            <ul class="socials__row">
                {socials.map((link) => (
                    <li><a class="social" href={link.href} {...ext}><Icon name={link.icon} size={16} /><span>{link.label}</span></a></li>
                ))}
            </ul>
        </div>
    </div>
</section>

<script>
    import '@luzir/bolota/motion.css';
    import '@luzir/bolota/gaze.css';
    import { animate, stagger, cubicBezier } from 'motion';
    import { prefersReducedMotion } from '@bagel/ui/lib/motion-query';
    import type { EngineHandle } from '@luzir/bolota/engine';

    const STATUS_URL = 'https://status.itsbagelbot.com/en/index.json';
    const STATES = new Set(['operational', 'degraded', 'downtime', 'maintenance']);
    const EXPRESSIONS = ['happy', 'attentive', 'curious', 'proud', 'excited'];
    const EXPRESSION_MIN_MS = 2600;
    const EXPRESSION_SPREAD_MS = 3400;
    const easeOutQuint = cubicBezier(0.22, 1, 0.36, 1);

    interface Live {
        svg: SVGSVGElement;
        handle: EngineHandle;
        timer: ReturnType<typeof setTimeout> | null;
    }

    let engines: Live[] = [];
    let mounting = false;

    function titleIntro(): void {
        const h1 = document.querySelector<HTMLElement>('[data-contact-title]');
        if (!h1 || h1.dataset.motionReady === 'true') return;
        h1.dataset.motionReady = 'true';
        if (prefersReducedMotion()) return;
        animate(
            h1.querySelectorAll<HTMLElement>('[data-contact-word]'),
            {
                transform: ['translateY(112%) rotate(3deg)', 'translateY(0%) rotate(0deg)'],
                opacity: [0, 1],
                filter: ['blur(8px)', 'blur(0px)'],
            },
            { delay: stagger(0.11, { startDelay: 0.3 }), duration: 0.9, ease: easeOutQuint },
        );
    }

    function scheduleExpression(live: Live, delayMs: number): void {
        live.timer = setTimeout(() => {
            live.handle.setExpression(EXPRESSIONS[Math.floor(Math.random() * EXPRESSIONS.length)]);
            scheduleExpression(live, EXPRESSION_MIN_MS + Math.random() * EXPRESSION_SPREAD_MS);
        }, delayMs);
    }

    async function mountBolotas(): Promise<void> {
        if (engines.length || mounting || prefersReducedMotion()) return;
        const svgs = Array.from(document.querySelectorAll<SVGSVGElement>('[data-contact-bolota]'));
        if (!svgs.length) return;
        mounting = true;
        const { mountEngine } = await import('@luzir/bolota/engine');
        if (!mounting) return;

        engines = svgs.map((svg) => {
            const handle = mountEngine(svg, svg.dataset.contactBolota ?? 'oven_fresh', {
                size: Number(svg.dataset.size) || 100,
                palette: { head: svg.dataset.head ?? '', eye: svg.dataset.eye ?? '' },
                background: false,
            });
            handle.loop('idle');
            if (svg.hasAttribute('data-follow')) handle.follow('window');
            const live: Live = { svg, handle, timer: null };
            scheduleExpression(live, Math.random() * EXPRESSION_SPREAD_MS);
            return live;
        });
        mounting = false;
    }

    function unmountBolotas(): void {
        mounting = false;
        engines.forEach((live) => {
            if (live.timer) clearTimeout(live.timer);
            live.handle.destroy();
        });
        engines = [];
    }

    function showState(box: HTMLElement, state: string): void {
        const text = box.dataset[`text${state[0].toUpperCase()}${state.slice(1)}`];
        const target = box.querySelector('[data-contact-status-text]');
        if (!text || !target) return;
        box.dataset.state = state;
        target.textContent = text;
    }

    async function loadStatus(): Promise<void> {
        const box = document.querySelector<HTMLElement>('[data-contact-status]');
        if (!box || box.dataset.state !== 'unknown') return;
        try {
            const response = await fetch(STATUS_URL);
            if (!response.ok) return;
            const state = (await response.json())?.data?.attributes?.aggregate_state;
            if (STATES.has(state)) showState(box, state);
        } catch {
            return;
        }
    }

    function setup(): void {
        titleIntro();
        void mountBolotas();
        void loadStatus();
    }

    setup();
    document.addEventListener('astro:page-load', setup);
    document.addEventListener('astro:before-swap', unmountBolotas);
    window.addEventListener('pagehide', unmountBolotas);
</script>

<style>
    .stage {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        padding: calc(var(--nav-offset) + var(--bb-space-8)) 0 var(--bb-space-section);
    }

    .starfield,
    .bg {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
    }

    .bg { overflow: hidden; }

    .orb { --bb-orb-opacity: 0.16; }

    .orb-1 {
        width: 520px;
        height: 520px;
        top: -140px;
        right: -80px;
    }

    .orb-2 {
        width: 420px;
        height: 420px;
        bottom: -120px;
        left: -100px;
        --bb-orb-pulse-delay: 400ms;
    }

    .wrap {
        width: min(100% - 32px, 1080px);
        margin-inline: auto;
        display: flex;
        flex-direction: column;
    }

    .top {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 260px;
        align-items: end;
        gap: var(--bb-space-6);
        padding-bottom: var(--bb-space-9);
    }

    .head {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--bb-space-4);
        min-width: 0;
    }

    .glow {
        display: flex;
        width: 100%;
        font-size: var(--bb-text-md);
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--bb-green-glow);
        text-shadow: 0 0 18px rgba(var(--bb-green-glow-rgb), 0.45);
        opacity: 0;
        animation: fadeUp 800ms 150ms var(--bb-ease-out-expo) forwards;
    }

    .title {
        width: 100%;
        height: calc(1lh + 0.08em);
        font-family: var(--bb-font-display);
        font-size: clamp(2.75rem, 6.4vw, 4.75rem);
        font-weight: 500;
        letter-spacing: var(--bb-tracking-display);
        line-height: 1.04;
        overflow: hidden;
    }

    .word {
        display: inline-block;
        transform-origin: 20% 90%;
        background: linear-gradient(180deg, var(--bb-white) 40%, rgba(var(--bb-tan-light-rgb), 0.55));
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        filter: drop-shadow(0 0 36px rgba(var(--bb-tan-rgb), 0.18));
    }

    .lede {
        width: min(100%, 46ch);
        height: calc(3 * 1lh);
        color: var(--bb-muted-light);
        font-size: var(--bb-text-md);
        line-height: 1.6;
    }

    .mascot {
        width: 260px;
        height: 260px;
        margin-bottom: calc(var(--bb-space-6) * -1);
        animation: riseIn 1.1s 0.5s var(--bb-ease-out-back) both;
    }

    .bolota,
    .face {
        display: block;
        overflow: visible;
        /* One transform, not scale + translate: Chrome runs independent transform properties on an svg on the main thread. */
        transform: scale(0.9);
    }

    .bolota {
        width: 100%;
        height: 100%;
        animation: bob 6.5s ease-in-out infinite alternate;
    }

    .lanes {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--bb-space-8);
        padding-bottom: var(--bb-space-9);
    }

    .lane {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--bb-space-4);
        min-width: 0;
    }

    .label {
        display: flex;
        align-items: center;
        gap: var(--bb-space-2);
        width: 100%;
        min-width: 0;
        font-size: var(--bb-text-sm);
        color: var(--bb-muted);
    }

    .label__text {
        display: flex;
        flex: 1 1 0;
        min-width: 0;
    }

    .faces {
        display: inline-flex;
        flex: none;
    }

    .face {
        width: 26px;
        height: 26px;
    }

    .face + .face { margin-left: -8px; }

    .say {
        width: min(100%, 30ch);
        height: calc(3 * 1lh);
        font-size: clamp(1.15rem, 1.8vw, 1.4rem);
        line-height: 1.45;
        letter-spacing: -0.01em;
        color: var(--bb-paper);
        text-wrap: pretty;
    }

    .cta {
        --btn-w: 200px;
        --btn-justify: flex-start;
        margin-top: var(--bb-space-2);
    }

    .cta--sm {
        --btn-w: 150px;
        margin-top: 0;
    }

    .more {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--bb-space-6);
        padding-top: var(--bb-space-8);
        border-top: 1px solid var(--bb-border);
    }

    .item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--bb-space-3);
        min-width: 0;
    }

    .item__text {
        width: 100%;
        height: calc(3 * 1lh);
        color: var(--bb-muted);
        font-size: var(--bb-text-sm);
        line-height: 1.55;
    }

    .beacon {
        position: relative;
        flex: none;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--beacon, var(--bb-tier-inactive));
        box-shadow: 0 0 10px var(--beacon, transparent);
        transition: background var(--bb-dur-base) ease;
    }

    .beacon::after {
        content: "";
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 1px solid var(--beacon, transparent);
        opacity: 0;
        animation: ping 2.4s var(--bb-ease-out-expo) infinite;
    }

    [data-state='operational'] { --beacon: var(--bb-green-glow); }
    [data-state='degraded'],
    [data-state='maintenance'] { --beacon: var(--bb-tan-light); }
    [data-state='downtime'] { --beacon: var(--bb-status-danger); }
    [data-state='unknown'] .beacon::after { animation: none; }

    .socials {
        display: flex;
        align-items: center;
        gap: var(--bb-space-5);
        margin-top: var(--bb-space-8);
        padding-top: var(--bb-space-6);
        border-top: 1px solid var(--bb-border);
    }

    .label--follow {
        flex: 1 1 0;
        width: auto;
    }

    .socials__row {
        display: flex;
        gap: var(--bb-space-2);
        list-style: none;
        padding: 0;
    }

    .social {
        display: inline-flex;
        align-items: center;
        gap: var(--bb-space-2);
        height: 36px;
        padding-inline: var(--bb-space-3);
        border-radius: var(--bb-radius-sm);
        color: var(--bb-muted-light);
        font-size: var(--bb-text-sm);
        text-decoration: none;
        transition: color var(--bb-dur-fast) ease, background var(--bb-dur-fast) ease;
    }

    .social:hover {
        color: var(--bb-paper);
        background: rgba(var(--bb-white-rgb), 0.05);
    }

    .social:focus-visible {
        outline: 2px solid var(--bb-focus);
        outline-offset: 2px;
    }

    .rise {
        opacity: 0;
        animation: fadeUp 0.9s calc(0.45s + var(--i, 0) * 0.12s) var(--bb-ease-out-expo) forwards;
    }

    @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
        .word {
            opacity: 0;
            transform: translateY(112%) rotate(3deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .glow,
        .rise,
        .mascot {
            opacity: 1;
            animation: none;
        }

        .bolota,
        .beacon::after {
            animation: none;
        }
    }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: none; }
    }

    @keyframes riseIn {
        from { opacity: 0; transform: translateY(70%) scale(0.86); }
        to { opacity: 1; transform: none; }
    }

    @keyframes bob {
        from { transform: translate(0, 0) scale(0.9); }
        to { transform: translate(0, -7px) scale(0.9); }
    }

    @keyframes ping {
        from { opacity: 0.8; transform: scale(0.6); }
        to { opacity: 0; transform: scale(1.8); }
    }

    @media (max-width: 900px) {
        .more { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--bb-space-7); }
    }

    @media (max-width: 760px) {
        .stage { padding-top: calc(var(--nav-offset) + var(--bb-space-6)); }

        .top {
            grid-template-columns: 1fr;
            padding-bottom: var(--bb-space-7);
        }

        .mascot {
            order: -1;
            justify-self: end;
            width: 140px;
            height: 140px;
            margin: 0 0 calc(var(--bb-space-5) * -1);
        }

        .title { height: calc(2 * 1lh + 0.08em); }

        .lanes,
        .more {
            grid-template-columns: 1fr;
        }

        .lanes { gap: var(--bb-space-7); padding-bottom: var(--bb-space-7); }
        .item__text { height: calc(2 * 1lh); }

        .socials {
            flex-direction: column;
            align-items: flex-start;
        }

        .label--follow { width: 100%; }
        .socials__row { flex-wrap: wrap; }
    }
</style>
