import type { CollectionEntry } from 'astro:content';
import Badge from '@bagel/ui/astro/Badge.astro';
import Text from '@bagel/ui/astro/Text.astro';
import ReleaseTag from './ReleaseTag.astro';
import TextLink from '@bagel/ui/astro/TextLink.astro';
import SectionLane from '../shared/SectionLane.astro';
import SectionLaneList from '../shared/SectionLaneList.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';

interface Props {
    entries: CollectionEntry<'changelog'>[];
}

const { entries } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type Localized = string | { en: string; [locale: string]: string };
type LocalizedList = string[] | { en: string[]; [locale: string]: string[] };

function pick(value: Localized, locale: string): string {
    if (typeof value === 'string') return value;
    return value[locale] ?? value.en;
}

function pickList(value: LocalizedList, locale: string): string[] {
    if (Array.isArray(value)) return value;
    return value[locale] ?? value.en;
}

const dateFmt = new Intl.DateTimeFormat(lang === 'fr' ? 'fr-CA' : 'en-CA', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});

const tagLabel: Record<CollectionEntry<'changelog'>['data']['tag'], string> = {
    alpha: t('changelog.tag.alpha'),
    beta: t('changelog.tag.beta'),
    prerelease: t('changelog.tag.prerelease'),
    release: t('changelog.tag.release'),
};
---

<section class="clog" aria-label={t('changelog.eyebrow')}>
    {entries.length === 0 ? (
        <Text tone="muted" class="clog__empty">{t('changelog.empty')}</Text>
    ) : (
        <SectionLaneList>
            {entries.map((entry, i) => {
                const { tag, version, title, highlights, github, date } = entry.data;
                const lines = pickList(highlights, lang);
                return (
                    <SectionLane class="clog__item" id={version} num={String(i + 1).padStart(2, '0')} heading={pick(title, lang)} revealIndex={i + 1}>
                        <Fragment slot="side-note">
                            <div class="clog__meta">
                                <ReleaseTag tag={tag} label={tagLabel[tag]} />
                                <a class="clog__ver" href={localizePath(`/changelog/${version}`, lang)}>
                                    <Badge shape="pill" tone="neutral" literal>{version}</Badge>
                                </a>
                            </div>
                            <time class="clog__date" datetime={date.toISOString()}>{dateFmt.format(date)}</time>
                        </Fragment>
                        <ul class="clog__highlights">
                            {lines.map((line) => (
                                <Text as="li" tone="muted-light" class="clog__highlight">{line}</Text>
                            ))}
                        </ul>
                        <TextLink
                            href={github}
                            label={t('changelog.releaseLink')}
                            external
                        />
                    </SectionLane>
                );
            })}
        </SectionLaneList>
    )}
</section>

<style>
    .clog {
        width: min(100% - 32px, 1120px);
        margin-inline: auto;
        padding-bottom: 96px;
    }

    .clog__empty {
        text-align: center;
        padding: 48px 0 80px;
    }

    .clog__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 14px;
    }

    .clog__date {
        display: block;
        font: var(--bb-text-xs)/1.4 var(--bb-font-mono);
        color: var(--bb-muted);
    }

    .clog__highlights {
        display: grid;
        gap: 10px;
        max-width: 62ch;
        width: 100%;
        margin: 0 0 14px;
        padding: 0;
    }

    .clog__highlight {
        position: relative;
        padding-left: 1.1em;
    }

    .clog__highlight::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.55em;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: rgba(var(--bb-tan-rgb), 0.55);
    }

    @media (max-width: 640px) {
        .clog { padding-bottom: 72px; }
    }
</style>
