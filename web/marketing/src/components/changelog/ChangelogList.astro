import type { CollectionEntry } from 'astro:content';
import Card from '@bagel/ui/astro/Card.astro';
import Badge from '@bagel/ui/astro/Badge.astro';
import Eyebrow from '@bagel/ui/astro/Eyebrow.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Text from '@bagel/ui/astro/Text.astro';
import ReleaseTag from './ReleaseTag.astro';
import TextLink from '@bagel/ui/astro/TextLink.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';

interface Props {
    entries: CollectionEntry<'changelog'>[];
}

const { entries } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type Localized = string | { en: string; [locale: string]: string };
type LocalizedList = string[] | { en: string[]; [locale: string]: string[] };

function pick(value: Localized, locale: string): string {
    if (typeof value === 'string') return value;
    return value[locale] ?? value.en;
}

function pickList(value: LocalizedList, locale: string): string[] {
    if (Array.isArray(value)) return value;
    return value[locale] ?? value.en;
}

const dateFmt = new Intl.DateTimeFormat(lang === 'fr' ? 'fr-CA' : 'en-CA', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});

const tagLabel: Record<CollectionEntry<'changelog'>['data']['tag'], string> = {
    alpha: t('changelog.tag.alpha'),
    beta: t('changelog.tag.beta'),
    prerelease: t('changelog.tag.prerelease'),
    release: t('changelog.tag.release'),
};
---

<section class="clog" aria-label={t('changelog.eyebrow')}>
    {entries.length === 0 ? (
        <Text tone="muted" class="clog__empty">{t('changelog.empty')}</Text>
    ) : (
        <ol class="clog__list">
            {entries.map((entry, i) => {
                const { tag, version, title, highlights, github, date } = entry.data;
                const lines = pickList(highlights, lang);
                return (
                    <li class="clog__item" data-reveal style={`--reveal-i: ${i + 1}`}>
                        <Eyebrow as="div">
                            <time datetime={date.toISOString()}>{dateFmt.format(date)}</time>
                        </Eyebrow>
                        <Card as="article" atmo hover class="clog__card">
                            <div class="clog__body">
                                <header class="clog__meta">
                                    <ReleaseTag tag={tag} label={tagLabel[tag]} />
                                    <a class="clog__ver" href={localizePath(`/changelog/${version}`, lang)}>
                                        <Badge shape="pill" literal class="clog__ver-badge">{version}</Badge>
                                    </a>
                                </header>
                                <Heading level={2} variant="card">{pick(title, lang)}</Heading>
                                <ul class="clog__highlights">
                                    {lines.map((line) => (
                                        <Text as="li" tone="muted-light" class="clog__highlight">{line}</Text>
                                    ))}
                                </ul>
                                <TextLink
                                    href={github}
                                    label={t('changelog.releaseLink')}
                                    external
                                />
                            </div>
                        </Card>
                    </li>
                );
            })}
        </ol>
    )}
</section>

<style>
    .clog {
        --card-pad: clamp(22px, 3vw, 30px);
        width: min(760px, calc(100% - 48px));
        margin: 0 auto;
        padding: 0 0 110px;
        max-width: none;
    }

    .clog__empty {
        text-align: center;
        padding: 48px 0 80px;
    }

    .clog__list {
        position: relative;
        display: grid;
        gap: 28px;
    }

    .clog__list::before {
        content: "";
        position: absolute;
        left: 11px;
        top: 8px;
        bottom: 8px;
        width: 1px;
        background: linear-gradient(
            180deg,
            rgba(var(--bb-tan-rgb), 0.55),
            rgba(var(--bb-green-glow-rgb), 0.35) 55%,
            transparent
        );
        pointer-events: none;
    }

    .clog__item {
        position: relative;
        display: grid;
        gap: 12px;
        padding-left: 40px;
    }

    .clog__item::before {
        content: "";
        position: absolute;
        left: 6px;
        top: 22px;
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: var(--bb-black);
        border: 1.5px solid var(--bb-tan);
        box-shadow: 0 0 10px rgba(var(--bb-tan-rgb), 0.35);
        z-index: 1;
    }

    .clog__body {
        display: grid;
        gap: 14px;
        justify-items: start;
    }

    .clog__item:nth-child(even) .clog__card {
        --card-atmo-flip: -1;
    }

    @media (hover: hover) and (pointer: fine) {
        .clog__item:hover::before {
            background: var(--bb-tan);
            box-shadow: 0 0 14px rgba(var(--bb-tan-rgb), 0.6);
        }
    }

    .clog__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 14px;
    }

    .clog__ver-badge {
        --badge-tone: var(--bb-tan-light);
        --badge-bg: rgba(var(--bb-tan-rgb), 0.07);
        --badge-tone-rule: rgba(var(--bb-tan-rgb), 0.14);
    }

    .clog__highlights {
        display: grid;
        gap: 10px;
        max-width: 62ch;
        width: 100%;
    }

    .clog__highlight {
        position: relative;
        padding-left: 1.1em;
    }

    .clog__highlight::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.55em;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: rgba(var(--bb-tan-rgb), 0.55);
    }

    @media (max-width: 640px) {
        .clog {
            width: calc(100% - 32px);
            padding-bottom: 80px;
        }

        .clog__list::before { left: 7px; }

        .clog__item {
            padding-left: 28px;
            gap: 8px;
        }

        .clog__item::before {
            left: 2px;
            width: 10px;
            height: 10px;
            top: 18px;
        }
    }
</style>
