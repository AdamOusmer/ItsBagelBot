/**
 * Release-channel label: which tone and which mark a channel wears.
 *
 * The element itself is @bagel/ui's Badge. This file used to write the
 * contract's class strings out by hand (`bb-tag bb-tag--alpha`, `bb-mark
 * bb-mark--hollow`), which is the same element with the adapter skipped — the
 * two tone maps below are the only part that is the changelog's.
 */
import Badge from '@bagel/ui/astro/Badge.astro';

interface Props {
    tag: 'alpha' | 'beta' | 'prerelease' | 'release';
    label: string;
}

const { tag, label } = Astro.props;

const TONE = {
    alpha: 'alpha',
    beta: 'live',
    prerelease: 'pre',
    release: 'quiet',
} as const;

const MARK = {
    alpha: 'hollow',
    beta: 'solid',
    prerelease: 'up',
    release: 'dash',
} as const;
---

<Badge class="rtag" tone={TONE[tag]} mark={MARK[tag]} sweep={tag === 'beta'}>{label}</Badge>

<style>
    /* Was a translucent pill per channel (hatched alpha, glowing 50% dot on a
       sine pulse for beta, gradient-border ember for pre-release). All four
       now ride the shared .bb-tag hairline, so only the row fit stays local:
       the 7px hairline gap sits the label above the centre of the version
       chip next to it, and 3px puts the two texts back on the same line. */
    .rtag {
        flex-shrink: 0;
        top: 3px;
    }
</style>
