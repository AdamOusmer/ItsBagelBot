import Badge from '@bagel/ui/astro/Badge.astro';

interface Props {
    tag: 'alpha' | 'beta' | 'prerelease' | 'release';
    label: string;
}

const { tag, label } = Astro.props;

const TONE = {
    alpha: 'alpha',
    beta: 'live',
    prerelease: 'pre',
    release: 'quiet',
} as const;

const MARK = {
    alpha: 'hollow',
    beta: 'solid',
    prerelease: 'up',
    release: 'dash',
} as const;
---

<Badge class={`rtag rtag--${tag}`} tone={TONE[tag]} mark={MARK[tag]} sweep={tag === 'beta'}>{label}</Badge>

<style>
    .rtag {
        flex-shrink: 0;
        top: 3px;
    }
</style>
