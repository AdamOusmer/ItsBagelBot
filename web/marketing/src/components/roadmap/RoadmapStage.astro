import ButtonLink from '@bagel/ui/astro/ButtonLink.astro';
import Card from '@bagel/ui/astro/Card.astro';
import LightField from '@bagel/ui/astro/LightField.astro';
import BolotaSvg from '../BolotaSvg.astro';
import { staticBolota, type BolotaTone } from '../../lib/bolota';
import type { Column, Roadmap } from '../../lib/roadmap/linear';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/ui';

interface Props {
    roadmap: Roadmap;
}

const { roadmap } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Station {
    column: Column;
    face: string;
    tone: BolotaTone;
}

const LINE: Station[] = [
    { column: 'later', face: 'caramel_cass', tone: 'pale' },
    { column: 'next', face: 'oven_mitt', tone: 'pale' },
    { column: 'now', face: 'oven_fresh', tone: 'tan' },
    { column: 'shipped', face: 'glazed_val', tone: 'green' },
];

const REQUEST_COLUMN: Column = 'later';

const stations = LINE.filter((station) => roadmap[station.column].length > 0 || station.column === REQUEST_COLUMN).map(
    (station) => ({ ...station, bolota: staticBolota(station.face, 40, station.tone), items: roadmap[station.column] }),
);

const titleWords = t('roadmap.title').split(' ');
---

<section class="stage roadmap-stage">
    <div class="starfield" aria-hidden="true"><LightField class="bb-light-field--bleed" /></div>
    <div class="bg" aria-hidden="true">
        <div class="bb-orb bb-orb--halo bb-orb--tan orb orb-1"><i class="bb-orb__pulse"></i></div>
        <div class="bb-orb bb-orb--halo bb-orb--green orb orb-2"><i class="bb-orb__pulse"></i></div>
    </div>

    <div class="wrap">
        <header class="head">
            <span class="glow"><bb-fit>{t('roadmap.eyebrow')}</bb-fit></span>
            <h1 class="title"><bb-fit mode="block">{titleWords.map((word, i) => (
                <>{i > 0 && ' '}<span class="word" style={`--w: ${i}`}>{word}</span></>
            ))}</bb-fit></h1>
            <p class="lede rise" style="--i: 1"><bb-fit mode="block">{t('roadmap.desc')}</bb-fit></p>
        </header>

        <div class="line" style={`--lanes: ${stations.length}`}>
            {stations.map((station, i) => (
                <section class={`lane lane--${station.column} rise`} style={`--i: ${i + 2}`} aria-labelledby={`lane-${station.column}`}>
                    <div class="lane__head">
                        <span class="station" aria-hidden="true"></span>
                        <BolotaSvg class="lane__face" bolota={station.bolota} expression={station.column === 'shipped' ? 'happy' : undefined} />
                        <div class="lane__words">
                            <h2 class="lane__label" id={`lane-${station.column}`}><bb-fit>{t(`roadmap.${station.column}`)}</bb-fit></h2>
                            <span class="lane__note"><bb-fit>{t(`roadmap.${station.column}Hint`)}</bb-fit></span>
                        </div>
                        <span class="lane__count">{String(station.items.length).padStart(2, '0')}</span>
                    </div>

                    <ul class="lane__cards">
                        {station.items.map((item) => (
                            <Card as="li" class="rcard" id={item.id}>
                                <h3 class="rcard__title"><bb-fit mode="block">{item.title}</bb-fit></h3>
                                <p class="rcard__text"><bb-fit mode="block">{item.summary}</bb-fit></p>
                            </Card>
                        ))}
                        {station.column === REQUEST_COLUMN && (
                            <Card as="li" dashed class="rcard rcard--request">
                                <h3 class="rcard__title"><bb-fit mode="block">{t('roadmap.requestTitle')}</bb-fit></h3>
                                <p class="rcard__text"><bb-fit mode="block">{t('roadmap.requestDesc')}</bb-fit></p>
                                <ButtonLink class="rcard__cta" variant="secondary" size="sm" href={localizePath('/contact', lang)}>
                                    <bb-fit>{t('roadmap.requestCta')}</bb-fit>
                                </ButtonLink>
                            </Card>
                        )}
                    </ul>
                </section>
            ))}
        </div>
    </div>
</section>

<style>
    .stage {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        padding: calc(var(--nav-offset) + var(--bb-space-8)) 0 var(--bb-space-section);
    }

    .starfield,
    .bg {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
    }

    .bg { overflow: hidden; }

    .orb { --bb-orb-opacity: 0.14; }

    .orb-1 {
        width: 520px;
        height: 520px;
        top: -160px;
        left: -120px;
    }

    .orb-2 {
        width: 460px;
        height: 460px;
        top: 38%;
        right: -140px;
        --bb-orb-pulse-delay: 400ms;
    }

    .wrap {
        width: min(100% - 32px, 1080px);
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: var(--bb-space-9);
    }

    .head {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--bb-space-4);
    }

    .glow {
        display: flex;
        width: 100%;
        font-size: var(--bb-text-md);
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--bb-green-glow);
        text-shadow: 0 0 18px rgba(var(--bb-green-glow-rgb), 0.45);
        opacity: 0;
        animation: fadeUp 800ms 150ms var(--bb-ease-out-expo) forwards;
    }

    .title {
        width: 100%;
        height: calc(1lh + 0.08em);
        font-family: var(--bb-font-display);
        font-size: clamp(2.75rem, 6.4vw, 4.75rem);
        font-weight: 500;
        letter-spacing: var(--bb-tracking-display);
        line-height: 1.04;
        overflow: hidden;
    }

    .word {
        display: inline-block;
        transform-origin: 20% 90%;
        animation: hero-word-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: calc(0.3s + var(--w, 0) * 0.11s);
        background: linear-gradient(180deg, var(--bb-white) 40%, rgba(var(--bb-tan-light-rgb), 0.55));
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        filter: drop-shadow(0 0 36px rgba(var(--bb-tan-rgb), 0.18));
    }

    .lede {
        width: min(100%, 52ch);
        height: calc(2 * 1lh);
        color: var(--bb-muted-light);
        font-size: var(--bb-text-md);
        line-height: 1.6;
    }

    .line {
        --station: var(--bb-tan-pale);
        position: relative;
        display: grid;
        grid-template-columns: repeat(var(--lanes), minmax(0, 1fr));
        gap: var(--bb-space-6);
    }

    .line::before {
        content: "";
        position: absolute;
        top: 5px;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
            90deg,
            rgba(var(--bb-tan-pale-rgb), 0.3),
            rgba(var(--bb-tan-light-rgb), 0.6) 66%,
            rgba(var(--bb-green-glow-rgb), 0.55)
        );
        pointer-events: none;
    }

    .lane {
        display: flex;
        flex-direction: column;
        gap: var(--bb-space-5);
        min-width: 0;
    }

    .lane--now { --station: var(--bb-tan-light); }
    .lane--shipped { --station: var(--bb-green-glow); }

    .lane__head {
        position: relative;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--bb-space-3);
        padding-top: var(--bb-space-6);
    }

    .station {
        position: absolute;
        top: 0;
        left: 0;
        box-sizing: border-box;
        width: 11px;
        height: 11px;
        border: 1.5px solid var(--station);
        border-radius: var(--bb-radius-pill);
        background: var(--bb-black);
        box-shadow: 0 0 10px color-mix(in srgb, var(--station) 40%, transparent);
    }

    .lane--shipped .station { background: var(--station); }

    .lane--now .station::after {
        content: "";
        position: absolute;
        inset: -5px;
        border-radius: 50%;
        border: 1px solid var(--station);
        opacity: 0;
        animation: ping 2.4s var(--bb-ease-out-expo) infinite;
    }

    .lane__face {
        display: block;
        width: 40px;
        height: 40px;
        overflow: visible;
    }

    .lane__words {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .lane__label {
        display: flex;
        margin: 0;
        font-family: var(--bb-font-display);
        font-size: 1.35rem;
        font-weight: 500;
        letter-spacing: -0.02em;
        line-height: 1.2;
        color: var(--bb-paper);
    }

    .lane__note {
        display: flex;
        font-size: var(--bb-text-sm);
        color: var(--station);
    }

    .lane__count {
        font: 500 var(--bb-text-sm)/1 var(--bb-font-mono);
        color: var(--bb-muted);
    }

    .lane__cards {
        display: flex;
        flex-direction: column;
        gap: var(--bb-space-3);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .rcard {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--bb-space-2);
        height: 188px;
        scroll-margin-top: calc(var(--nav-offset) + 24px);
        --card-pad: var(--bb-space-5);
    }

    .rcard__title {
        width: 100%;
        height: calc(2 * 1lh);
        margin: 0;
        font-family: var(--bb-font-display);
        font-size: 1.08rem;
        font-weight: 500;
        letter-spacing: -0.015em;
        line-height: 1.3;
        color: var(--bb-paper);
    }

    .rcard__text {
        width: 100%;
        height: calc(4 * 1lh);
        margin: 0;
        color: var(--bb-muted);
        font-size: var(--bb-text-sm);
        line-height: 1.5;
        text-wrap: pretty;
    }

    .rcard--request {
        --card-bg: transparent;
        --card-shadow: none;
        --card-border: rgba(var(--bb-white-rgb), 0.12);
    }

    .rcard--request .rcard__text { height: calc(3 * 1lh); }

    .rcard__cta {
        --btn-w: 100%;
        --btn-justify: flex-start;
        margin-top: auto;
    }

    .rise {
        opacity: 0;
        animation: fadeUp 0.9s calc(0.45s + var(--i, 0) * 0.12s) var(--bb-ease-out-expo) forwards;
    }

    @keyframes hero-word-in {
        from {
            transform: translateY(112%) rotate(3deg);
            opacity: 0;
            filter: blur(8px);
        }
        to {
            transform: none;
            opacity: 1;
            filter: blur(0);
        }
    }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: none; }
    }

    @keyframes ping {
        from { opacity: 0.8; transform: scale(0.6); }
        to { opacity: 0; transform: scale(1.8); }
    }

    @media (prefers-reduced-motion: reduce) {
        .word,
        .lane--now .station::after {
            animation: none;
        }

        .glow,
        .rise {
            opacity: 1;
            animation: none;
        }
    }

    @media (max-width: 900px) {
        .line {
            grid-template-columns: minmax(0, 1fr);
            gap: var(--bb-space-8);
            padding-left: var(--bb-space-6);
        }

        .line::before {
            top: 6px;
            bottom: 0;
            left: 5px;
            right: auto;
            width: 1px;
            height: auto;
            background: linear-gradient(
                180deg,
                rgba(var(--bb-tan-pale-rgb), 0.3),
                rgba(var(--bb-tan-light-rgb), 0.6) 66%,
                rgba(var(--bb-green-glow-rgb), 0.55)
            );
        }

        .lane__head { padding-top: 0; }

        .station {
            top: 50%;
            left: calc(var(--bb-space-6) * -1);
            translate: 0 -50%;
        }

        .lane__cards {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .rcard { height: 172px; }
        .rcard__text { height: calc(3 * 1lh); }
    }

    @media (max-width: 760px) {
        .stage { padding-top: calc(var(--nav-offset) + var(--bb-space-6)); }
        .title { height: calc(2 * 1lh + 0.08em); }
        .lede { height: calc(3 * 1lh); }
    }

    @media (max-width: 640px) {
        .wrap { gap: var(--bb-space-8); }
        .lane__cards { grid-template-columns: minmax(0, 1fr); }
        .rcard { height: 156px; }
    }
</style>
