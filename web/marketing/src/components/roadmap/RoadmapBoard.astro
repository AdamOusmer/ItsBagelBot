import Button from '@bagel/ui/astro/Button.astro';
import Card from '@bagel/ui/astro/Card.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Text from '@bagel/ui/astro/Text.astro';
import SectionLane from '../shared/SectionLane.astro';
import SectionLaneList from '../shared/SectionLaneList.astro';
import { COLUMNS, type Roadmap } from '../../lib/roadmap/linear';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/ui';

interface Props {
    roadmap: Roadmap;
}

const { roadmap } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="rmap" aria-label={t('roadmap.eyebrow')}>
    <SectionLaneList>
        {COLUMNS.map((column, i) => (
            <SectionLane class="rmap__lane" id={column} num={String(i + 1).padStart(2, '0')} heading={t(`roadmap.${column}`)} revealIndex={i + 1}>
                <Text slot="side-note" size="sm" tone="muted">{t(`roadmap.${column}Hint`)}</Text>
                {roadmap[column].length === 0 ? (
                    <Text tone="muted" class="rmap__empty">{t('roadmap.emptyColumn')}</Text>
                ) : (
                    <ul class="rmap__items">
                        {roadmap[column].map((item) => (
                            <li class="rmap__item" id={item.id}>
                                <h3 class="rmap__title">{item.title}</h3>
                                <Text tone="muted-light">{item.summary}</Text>
                            </li>
                        ))}
                    </ul>
                )}
            </SectionLane>
        ))}
    </SectionLaneList>

    <Card atmo hover as="a" href={localizePath('/contact', lang)} class="rmap__request reveal-in" style="--reveal-i: 5; --bb-cursor: quiet">
        <span class="rmap__request-body">
            <span class="rmap__request-copy">
                <Heading level={4} as="span" class="rmap__request-name"><bb-fit>{t('roadmap.requestTitle')}</bb-fit></Heading>
                <Text as="span" tone="muted-light" class="rmap__request-desc"><bb-fit mode="block">{t('roadmap.requestDesc')}</bb-fit></Text>
            </span>
            <Button as="span" variant="secondary" class="rmap__request-btn" style="--bb-cursor: follow"><bb-fit>{t('roadmap.requestCta')}</bb-fit></Button>
        </span>
    </Card>
</section>

<style>
    .rmap {
        width: min(100% - 32px, 1120px);
        margin-inline: auto;
        padding-bottom: 96px;
    }

    .rmap__items {
        display: grid;
        gap: var(--bb-space-5);
        max-width: 62ch;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .rmap__item {
        position: relative;
        display: grid;
        gap: 6px;
        padding-left: 1.1em;
    }

    .rmap__item::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.6em;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: rgba(var(--bb-tan-rgb), 0.55);
    }

    .rmap__title {
        margin: 0;
        font-family: var(--bb-font-display);
        font-size: 1.15rem;
        font-weight: 500;
        letter-spacing: -0.02em;
        line-height: 1.3;
        color: var(--bb-paper);
    }

    .rmap__request {
        margin-top: var(--bb-space-7);
    }

    .rmap__request-body {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--bb-space-5);
    }

    .rmap__request-copy {
        display: block;
        flex: 1 1 0;
        min-width: 0;
    }

    .rmap__request-name {
        display: block;
        margin-bottom: 6px;
    }

    .rmap__request-desc {
        display: block;
        max-width: 62ch;
        height: calc(2 * 1lh);
    }

    .rmap__request-btn {
        --btn-w: 18rem;
        --btn-justify: safe center;
        flex: none;
    }

    @media (max-width: 900px) {
        .rmap__request-body {
            align-items: stretch;
            flex-direction: column;
        }

        .rmap__request-copy { flex: none; }
        .rmap__request-desc { height: calc(3 * 1lh); }
    }

    @media (max-width: 640px) {
        .rmap { padding-bottom: 72px; }
    }
</style>
