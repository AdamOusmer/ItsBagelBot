import Tag from '@bagel/ui/astro/Tag.astro';
import Chip from '@bagel/ui/astro/Chip.astro';
import Card from '@bagel/ui/astro/Card.astro';
import SegmentedControl from '@bagel/ui/astro/SegmentedControl.astro';
import Field from '@bagel/ui/astro/Field.astro';
import Input from '@bagel/ui/astro/Input.astro';
import Select from '@bagel/ui/astro/Select.astro';
import Textarea from '@bagel/ui/astro/Textarea.astro';
import Label from '@bagel/ui/astro/Label.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Text from '@bagel/ui/astro/Text.astro';
import Disclosure from '@bagel/ui/astro/Disclosure.astro';
import ButtonLink from '@bagel/ui/astro/ButtonLink.astro';
import Code from '@bagel/ui/astro/Code.astro';
import TextLink from '@bagel/ui/astro/TextLink.astro';

// DOM + textContent only: never innerHTML for anything user-typed.
import { getImage } from 'astro:assets';
import logoImage from '../../assets/LogoBOT.png';
import { builderData, builderUI, builderRecipes, LIMITS } from '../../i18n/builder';

const avatarImage = await getImage({ src: logoImage, width: 28, height: 28, format: 'webp' });
import { localizePath, defaultLang, type Lang } from '../../i18n/ui';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const data = builderData(lang);
const ui = builderUI(lang);
const guideHref = localizePath('/guides/commands', lang);

const groups: { group: string; items: { id: string; label: string }[] }[] = [];
for (const surface of data.surfaces) {
    if (surface.id === 'custom') continue;
    const bucket = groups.find((g) => g.group === surface.group);
    if (bucket) bucket.items.push({ id: surface.id, label: surface.label });
    else groups.push({ group: surface.group, items: [{ id: surface.id, label: surface.label }] });
}

const modeOptions = [
    { value: 'custom', label: ui.modeCustom, attrs: { 'data-mode': 'custom' } },
    { value: 'module', label: ui.modeModule, attrs: { 'data-mode': 'module' } },
];
const surfaceOptions = groups.flatMap((g) => g.items.map((item) => ({ value: item.id, label: item.label, group: g.group })));
const firstSurfaceHint = data.surfaces.find((s) => s.id === surfaceOptions[0]?.value)?.hint ?? '';
const styleOptions = data.styles.map((s) => ({ value: s.value || 'plain', label: s.label }));

const MEDIUM_DESC_CHARS = 110;
const LONG_DESC_CHARS = 250;
const descSize: Record<string, 'medium' | 'long'> = {};
for (const surface of builderData(defaultLang).surfaces) {
    for (const item of surface.vars) {
        if (item.desc.length > LONG_DESC_CHARS) descSize[`${surface.id} ${item.token}`] = 'long';
        else if (item.desc.length > MEDIUM_DESC_CHARS) descSize[`${surface.id} ${item.token}`] = 'medium';
    }
}
---

<div class="builder" data-builder>
    <div class="layout">
        <Card>
            <div class="compose">
                <SegmentedControl options={modeOptions} value="custom" label={ui.step1Title} class="bb-tabs--even" data-modes />

                <div class="module-pick" hidden data-module-pick>
                    <Field label={ui.surfaceLabel} for="cb-surface" hint={firstSurfaceHint} hintId="cb-surface-hint">
                        <Select id="cb-surface" fill options={surfaceOptions} label={ui.surfaceLabel} data-surface aria-describedby="cb-surface-hint" />
                    </Field>
                </div>

                <div class="f-name" data-command-fields>
                    <Field label={ui.nameLabel} for="cb-name" hint={ui.nameHint} hintId="cb-name-hint">
                        <Input id="cb-name" value="welcome" fill maxlength={LIMITS.nameMax} data-name aria-describedby="cb-name-hint">
                            <span slot="leading" class="f-name__prefix" aria-hidden="true">!</span>
                        </Input>
                    </Field>
                </div>

                <div class="response">
                    <Field label={ui.responseLabel} for="cb-template">
                        <Textarea id="cb-template" name="template" rows={4} fill maxlength={LIMITS.lineMax * LIMITS.linesMax + LIMITS.linesMax - 1} data-template />
                    </Field>
                    <Text as="small" size="xs" tone="muted" class="response__count"><b data-count>0</b>/{LIMITS.lineMax}</Text>
                </div>
                <div class="recipes" data-recipes><Label mono as="span" class="recipes__label"><span data-fit>{ui.recipesLabel}</span></Label></div>

                <section class="palette">
                    <div class="palette__head">
                        <Heading level={5} as="h3" class="palette__title"><span data-fit>{ui.step3Title}</span></Heading>
                        <Tag tone="live" bare class="palette__scope"><span data-fit data-scope></span></Tag>
                    </div>
                    <Text size="sm" tone="muted-light" class="palette__sub"><span data-fit="block">{ui.step3Sub}</span></Text>
                    <div class="vars" data-vars></div>
                    <Disclosure size="sm" summary={ui.bracesSummary} class="palette__braces">
                        <Text size="xs" tone="muted-light" class="palette__braces-body"><span data-fit="block">{ui.bracesBody}</span></Text>
                    </Disclosure>
                </section>

                <div class="more" data-more>
                    <Disclosure size="sm" summary={ui.moreOptions}>
                        <div class="more-grid">
                            <div class="span2">
                                <Field label={ui.aliasLabel} for="cb-aliases" hint={ui.aliasHint} hintId="cb-alias-hint">
                                    <Input id="cb-aliases" fill placeholder="hi, heya" data-aliases aria-describedby="cb-alias-hint" />
                                </Field>
                            </div>
                            <Field label={ui.permLabel} for="cb-perm">
                                <Select id="cb-perm" name="perm" fill options={data.perms} label={ui.permLabel} data-perm />
                            </Field>
                            <Field label={ui.cooldownLabel} for="cb-cooldown" hint={ui.cooldownHint} hintId="cb-cd-hint">
                                <Input id="cb-cooldown" type="number" value="0" fill min={0} max={LIMITS.cooldownMax} data-cooldown aria-describedby="cb-cd-hint" />
                            </Field>
                            <div class="span2">
                                <Field label={ui.styleLabel} for="cb-style">
                                    <Select id="cb-style" name="style" fill options={styleOptions} label={ui.styleLabel} data-style />
                                </Field>
                            </div>
                        </div>
                    </Disclosure>
                </div>
            </div>
        </Card>

        <aside>
            <Card>
                <div class="card-head">
                    <Label mono as="span" class="card-head__start"><i class="bb-mark card-head__rec" aria-hidden="true"></i><span data-fit>{ui.previewTitle}</span></Label>
                    <Label mono as="span" class="card-head__end"><span data-fit data-context></span></Label>
                </div>
                <div class="chat" data-chat data-avatar={avatarImage.src}>
                    <Tag tone="live" bare class="chat-tag" data-chat-tag><span data-fit data-chat-tag-text>{ui.rehearsal}</span></Tag>
                </div>
                <Text as="small" size="xs" tone="muted-light" class="preview__note"><span data-fit="block" data-preview-note></span></Text>
            </Card>

            <Card>
                <div class="card-head">
                    <Label mono as="span" class="card-head__start"><span data-fit data-action-title>{ui.sendTitle}</span></Label>
                    <Text as="span" size="xs" tone="danger" class="card-head__end"><span data-fit data-valid aria-live="polite"></span></Text>
                </div>
                <div class="send" data-send-wrap>
                    <ButtonLink block data-send target="_blank" rel="noopener noreferrer" href={data.dashboardOrigin + '/commands'} tone="success">
                        <span data-fit>{ui.sendCta}{' '}<span aria-hidden="true">→</span></span>
                    </ButtonLink>
                    <Text size="xs" tone="muted" class="send__help"><span data-fit="block">{ui.sendHelp}</span></Text>
                </div>
                <div class="copyw" data-copy-wrap>
                    <Label mono as="span" class="copyw__label"><span data-fit="block" data-copy-title>{ui.copyTitleCustom}</span></Label>
                    <Code block wrap maxHeight="150px" data-output />
                    <Chip class="copyw__btn" data-copy-cta><span data-fit data-copy-label>{ui.copyCta}</span></Chip>
                    <div class="copyw__module" data-module-wrap hidden>
                        <TextLink variant="quiet" href={data.dashboardOrigin} external data-module-link>{ui.openModule} →</TextLink>
                    </div>
                </div>
            </Card>
        </aside>
    </div>

    <Text size="sm" tone="muted-light" class="learn"><span data-fit="block">{ui.learnMore}{' '}<TextLink variant="inline" href={guideHref}>{ui.learnMoreCta} →</TextLink></span></Text>

    <script type="application/json" is:inline data-builder-json set:html={JSON.stringify({
        data,
        ui: {
            statusName: ui.statusName,
            statusLines: ui.statusLines,
            statusLineLen: ui.statusLineLen,
            statusEmpty: ui.statusEmpty,
            copied: ui.copied,
            copyFail: ui.copyFail,
            copyCta: ui.copyCta,
            counterNameAria: ui.counterNameAria,
            counterScopeAria: ui.counterScopeAria,
            sendTitle: ui.sendTitle,
            copyTitleCustom: ui.copyTitleCustom,
            copyTitleModule: ui.copyTitleModule,
            copyBodyModule: ui.copyBodyModule,
            rehearsal: ui.rehearsal,
            ariaTyping: ui.ariaTyping,
            announcement: ui.announcement,
            addMessageAfter: ui.addMessageAfter,
            shoutsOut: ui.shoutsOut,
            nameChannel: ui.nameChannel,
            pinnedForStream: ui.pinnedForStream,
            addActionAfterMe: ui.addActionAfterMe,
            nothingToSay: ui.nothingToSay,
            unknownVar: ui.unknownVar,
            recipes: builderRecipes(lang),
        },
        descSize,
    })} />
</div>

<script>
    import { bindOnce } from '../../script/bind';
    import { copyFlash } from '@bagel/ui/lib/clipboard';
    import { mountTextFit } from '@bagel/ui/lib/text-fit';

    type CounterScope = { id: string; label: string; hint: string };
    type Var = { token: string; sample: string; name: string; desc: string; scopes?: CounterScope[]; pinned?: boolean };
    type Surface = { id: string; group: string; label: string; dashPath: string; hint: string; example: string; prompt: string; vars: Var[] };
    type Payload = {
        data: {
            lang: string;
            defaultLang: string;
            limits: { nameMax: number; aliasMax: number; lineMax: number; linesMax: number; cooldownMax: number };
            dashboardOrigin: string;
            perms: { value: string; label: string }[];
            styles: { value: string; label: string }[];
            surfaces: Surface[];
        };
        ui: Record<string, string> & { recipes: { label: string; text: string }[] };
        descSize: Record<string, 'medium' | 'long'>;
    };

    import { rehearseCommand, rehearseReply, resolvedWithoutSample, type RehearsedLine, type Seg } from '@bagel/kit/engine/rehearsal';
    import { lex, type VarToken } from '@bagel/kit/engine/tmpl';

    function spanOf(token: string): VarToken | null {
        const tokens = lex(token);
        return tokens.length === 1 && tokens[0].kind === 'var' ? tokens[0] : null;
    }

    const ACCENT: Record<string, string> = {
        primary: 'var(--bb-tan-light)',
        blue: '#4a9eff',
        green: 'var(--bb-green-glow)',
        orange: '#ff9f45',
        purple: '#c77dff',
    };

    const MODES = ['custom', 'module'] as const;
    const COPY_FLASH_MS = 1800;
    const SVG_NS = 'http://www.w3.org/2000/svg';

    function verbLabelOf(view: RehearsedLine): string {
        if (view.mode === 'announce') return view.color === 'primary' ? '/announce' : `/announce (${view.color})`;
        return view.verb ?? '';
    }

    function selectChevron(): SVGSVGElement {
        const svg = document.createElementNS(SVG_NS, 'svg');
        svg.setAttribute('class', 'bb-input__chevron');
        svg.setAttribute('viewBox', '0 0 24 24');
        svg.setAttribute('aria-hidden', 'true');
        const path = document.createElementNS(SVG_NS, 'path');
        path.setAttribute('d', 'm6 9 6 6 6-6');
        svg.append(path);
        return svg;
    }

    function inputShell(control: HTMLInputElement | HTMLSelectElement): HTMLElement {
        const shell = document.createElement('span');
        shell.className = 'bb-input bb-input--fill';
        shell.append(control);
        if (control instanceof HTMLSelectElement) {
            shell.classList.add('bb-input--select');
            shell.append(selectChevron());
        }
        return shell;
    }

    function initBuilder(root: HTMLElement) {
        const payload: Payload = JSON.parse(root.querySelector('[data-builder-json]')?.textContent || 'null');
        if (!payload) return;
        const { data, ui } = payload;
        const surfaces = new Map(data.surfaces.map((s) => [s.id, s]));

        const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
        const ta = $<HTMLTextAreaElement>('[data-template]');
        const nameInput = $<HTMLInputElement>('[data-name]');
        const aliasInput = $<HTMLInputElement>('[data-aliases]');
        const permSel = $<HTMLSelectElement>('[data-perm]');
        const cdInput = $<HTMLInputElement>('[data-cooldown]');
        const styleSel = $<HTMLSelectElement>('[data-style]');
        const surfaceSel = $<HTMLSelectElement>('[data-surface]');
        const surfaceHint = root.querySelector<HTMLElement>('#cb-surface-hint');
        const modeGroup = $<HTMLElement>('[data-modes]');
        const sendLink = $<HTMLAnchorElement>('[data-send]');
        const moduleWrap = $<HTMLElement>('[data-module-wrap]');
        const moduleLink = $<HTMLAnchorElement>('[data-module-link]');
        const copyWrap = $<HTMLElement>('[data-copy-wrap]');
        const output = $<HTMLElement>('[data-output] code');
        const copyBtn = $<HTMLButtonElement>('[data-copy-cta]');
        const chat = $<HTMLElement>('[data-chat]');
        const chatTag = $<HTMLElement>('[data-chat-tag]');
        const avatarSrc = chat.dataset.avatar ?? '';

        const fitted = new Map<Element, () => void>();
        const fitWithin = (box: Element) => {
            fitted.get(box)?.();
            fitted.set(box, mountTextFit(box));
        };
        const setFitText = (sel: string, text: string) => {
            const node = $<HTMLElement>(sel);
            if (node.textContent === text && node.hasAttribute('data-fit-ready')) return;
            node.textContent = text;
            fitWithin(node.parentElement!);
        };

        let mode: 'custom' | 'module' = 'custom';
        let surfaceId = 'custom';
        const current = () => surfaces.get(surfaceId)!;
        const stylePrefix = () => data.styles[styleSel.selectedIndex]?.value ?? '';

        const cleanName = () =>
            nameInput.value.trim().replace(/^!+/, '').replace(/\s+/g, '').toLowerCase().slice(0, data.limits.nameMax);

        const cleanAliases = () =>
            aliasInput.value
                .split(',')
                .map((a) => a.trim().replace(/^!+/, '').replace(/\s+/g, '').toLowerCase())
                .filter(Boolean)
                .slice(0, data.limits.aliasMax);

        const cleanCooldown = () => {
            const n = Math.floor(Number(cdInput.value) || 0);
            return Math.min(Math.max(n, 0), data.limits.cooldownMax);
        };

        function clampTemplate() {
            const raw = ta.value.split(/\r\n|\r|\n/);
            let changed = raw.length > data.limits.linesMax;
            const prefixLen = mode === 'custom' ? stylePrefix().length : 0;
            const clamped = raw.slice(0, data.limits.linesMax).map((line, i) => {
                const max = i === 0 ? data.limits.lineMax - prefixLen : data.limits.lineMax;
                if (line.length <= max) return line;
                changed = true;
                return line.slice(0, max);
            });
            if (!changed) return;
            const pos = ta.selectionStart ?? ta.value.length;
            ta.value = clamped.join('\n');
            const at = Math.min(pos, ta.value.length);
            ta.setSelectionRange(at, at);
        }

        const lines = () => {
            const raw = ta.value.split(/\r\n|\r|\n/).map((l) => l.replace(/[ \t]+$/, '')).filter((l) => l !== '');
            const prefix = stylePrefix();
            if (mode === 'custom' && prefix && raw.length > 0) raw[0] = prefix + raw[0];
            return raw;
        };

        function sampleMap(): Record<string, string> {
            const kind = mode === 'custom' ? 'command' : 'reply';
            const samples: Record<string, string> = {};
            for (const item of current().vars) {
                const span = spanOf(item.token);
                if (span && !resolvedWithoutSample(span.name, kind)) samples[span.key] = item.sample;
            }
            return samples;
        }

        const DYNAMIC_NAMES = new Set(['random', 'choice']);
        const surfaceIsDynamic = () =>
            current().vars.some((x) => {
                const span = spanOf(x.token);
                return span !== null && DYNAMIC_NAMES.has(span.name);
            });

        function rehearse(): RehearsedLine[] {
            const source = lines().join('\n');
            return mode === 'custom'
                ? rehearseCommand(source, sampleMap())
                : rehearseReply(source, sampleMap(), { dynamic: surfaceIsDynamic() });
        }

        const el = (tag: string, className: string, text?: string) => {
            const node = document.createElement(tag);
            node.className = className;
            if (text !== undefined) node.textContent = text;
            return node;
        };

        const fitIn = (tag: string, text: string, mode: '' | 'block') => {
            const box = el(tag, '');
            const label = el('span', '', text);
            label.dataset.fit = mode;
            box.append(label);
            return box;
        };

        function botName(): HTMLElement {
            const who = el('span', 'who bot-name');
            if (avatarSrc) {
                const img = document.createElement('img');
                img.className = 'bot-avatar';
                img.src = avatarSrc;
                img.alt = '';
                who.append(img);
            }
            who.append('ItsBagelBot');
            return who;
        }

        function msgWithSegments(className: string, segments: Seg[]): HTMLElement {
            const msg = el('span', className);
            for (const seg of segments) {
                if (seg.kind === 'plain') {
                    msg.append(seg.text);
                } else {
                    const mark = el('mark', seg.kind === 'unknown' ? 'unknown' : '', seg.text);
                    if (seg.kind === 'unknown') mark.title = ui.unknownVar;
                    msg.append(mark);
                }
            }
            return msg;
        }

        function viaBadge(label: string, inline = false): HTMLElement {
            return el('span', `via bb-tag bb-tag--quiet bb-tag--bare${inline ? ' inline' : ''}`, `Twitch ${label}`);
        }

        function botLine(view: RehearsedLine, index: number): HTMLElement {
            const line = el('div', 'line bot');
            line.style.setProperty('--reply-delay', `${index * 140}ms`);
            if (view.mode !== 'chat') line.classList.add('special');
            if (view.mode === 'me') {
                line.classList.remove('special');
                line.classList.add('me');
            }
            line.append(botName());

            if (view.mode === 'announce') {
                const box = el('div', 'announce');
                box.style.setProperty('--acc', ACCENT[view.color ?? 'primary']);
                const head = el('span', 'announce-head');
                head.append(viaBadge(verbLabelOf(view)), ui.announcement);
                box.append(head);
                box.append(view.segments.length
                    ? msgWithSegments('msg reply', view.segments)
                    : el('span', 'msg empty', ui.addMessageAfter.replace('{verb}', view.verb ?? '')));
                line.append(box);
            } else if (view.mode === 'shoutout') {
                const box = el('div', 'shoutout');
                box.append(viaBadge('/shoutout'));
                if (view.target) {
                    const msg = el('span', 'msg reply', `${ui.shoutsOut} `);
                    const strong = el('strong', '', `@${view.target}`);
                    msg.append(strong);
                    box.append(msg);
                } else {
                    box.append(el('span', 'msg empty', ui.nameChannel));
                }
                line.append(box);
            } else if (view.mode === 'pin') {
                const box = el('div', 'pin');
                const head = el('span', 'pin-head');
                head.append(viaBadge('/pin'), ui.pinnedForStream);
                box.append(head);
                box.append(view.segments.length
                    ? msgWithSegments('msg reply', view.segments)
                    : el('span', 'msg empty', ui.addMessageAfter.replace('{verb}', '/pin')));
                line.append(box);
            } else if (view.mode === 'me') {
                line.append(viaBadge('/me', true));
                line.append(view.segments.length
                    ? msgWithSegments('msg reply action', view.segments)
                    : el('span', 'msg empty', ui.addActionAfterMe));
            } else {
                line.append(msgWithSegments('msg reply', view.segments));
            }
            return line;
        }

        const promptKind = () => {
            const surface = current();
            if (mode === 'custom' || surface.prompt.startsWith('!')) return 'command';
            if (surface.id === 'triggers') return 'message';
            return 'event';
        };

        function clearChat() {
            for (const node of [...chat.children]) if (node !== chatTag) node.remove();
        }

        function viewerLine(): HTMLElement | null {
            const kind = promptKind();
            if (kind === 'event') return null;
            const surface = current();
            const line = el('div', 'line viewer');
            const who = el('span', 'who viewer-name', surface.vars.find((x) => x.token === '{user}')?.sample ?? 'maya_live');
            const text = mode === 'custom' ? `!${cleanName() || 'command'}` : surface.prompt;
            const msg = el('span', kind === 'message' ? 'msg plain' : 'msg', text);
            line.append(who, msg);
            return line;
        }

        function renderReplies() {
            clearChat();
            setFitText('[data-chat-tag-text]', promptKind() === 'event' ? current().prompt : ui.rehearsal);
            const viewer = viewerLine();
            if (viewer) chat.append(viewer);

            const views = rehearse();
            if (views.length === 0) {
                const line = el('div', 'line bot');
                line.append(botName(), el('span', 'msg empty', ui.nothingToSay));
                chat.append(line);
                return;
            }
            views.forEach((view, i) => chat.append(botLine(view, i)));
        }

        function renderTyping() {
            clearChat();
            setFitText('[data-chat-tag-text]', promptKind() === 'event' ? current().prompt : ui.rehearsal);
            const viewer = viewerLine();
            if (viewer) chat.append(viewer);
            const line = el('div', 'line bot');
            const msg = el('span', 'msg typing');
            msg.setAttribute('aria-label', ui.ariaTyping);
            msg.append(el('span', 'bb-drawline'));
            line.append(botName(), msg);
            chat.append(line);
        }

        let settle: ReturnType<typeof setTimeout> | undefined;
        let firstRender = true;
        function schedulePreview() {
            if (firstRender) {
                firstRender = false;
                renderReplies();
                return;
            }
            renderTyping();
            clearTimeout(settle);
            settle = setTimeout(renderReplies, 550);
        }

        function insert(text: string) {
            const a = ta.selectionStart ?? ta.value.length;
            const b = ta.selectionEnd ?? ta.value.length;
            ta.value = ta.value.slice(0, a) + text + ta.value.slice(b);
            ta.focus();
            ta.setSelectionRange(a + text.length, a + text.length);
            update();
        }

        function buildSimpleVar(item: Var): HTMLElement {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'var';
            const size = payload.descSize[`${surfaceId} ${item.token}`];
            if (size) btn.classList.add(`var--${size}`);
            const code = el('code', '', item.token);
            const span = el('span', '');
            span.append(fitIn('b', item.name, ''), fitIn('small', item.desc, 'block'));
            btn.append(code, span, el('i', '', '+'));
            btn.addEventListener('click', () => insert(item.token));
            return btn;
        }

        function buildCounterVar(item: Var): HTMLElement {
            const scopes = item.scopes ?? [];
            const defaultName = spanOf(item.token)?.payload || 'name';

            const card = el('div', 'var var--counter');

            const head = el('div', 'ctr-head');
            head.append(fitIn('b', item.name, ''), fitIn('small', item.desc, 'block'));

            const nameInput = document.createElement('input');
            nameInput.type = 'text';
            nameInput.name = `counter-${defaultName}-name`;
            nameInput.placeholder = defaultName;
            nameInput.maxLength = data.limits.nameMax;
            nameInput.setAttribute('aria-label', ui.counterNameAria);

            const scopeSelect = document.createElement('select');
            scopeSelect.name = `counter-${defaultName}-scope`;
            scopeSelect.setAttribute('aria-label', ui.counterScopeAria);
            for (const scope of scopes) {
                const opt = document.createElement('option');
                opt.value = scope.id;
                opt.textContent = scope.label;
                scopeSelect.append(opt);
            }

            const tokenCode = el('code', '', item.token);
            const insertBtn = document.createElement('button');
            insertBtn.type = 'button';
            insertBtn.className = 'ctr-insert';
            insertBtn.append(tokenCode, el('i', '', '+'));

            const hint = el('small', 'ctr-hint');
            const hintText = el('span', '');
            hintText.dataset.fit = 'block';
            hint.append(hintText);
            const row = el('div', 'ctr-row');
            row.append(inputShell(nameInput), inputShell(scopeSelect), insertBtn);

            const cleanCounterName = () =>
                nameInput.value.trim().replace(/^!+/, '').toLowerCase().slice(0, data.limits.nameMax);

            const syncToken = () => {
                tokenCode.textContent = `{counter:${cleanCounterName() || defaultName}}`;
            };
            const syncHint = () => {
                const scope = scopes.find((s) => s.id === scopeSelect.value) ?? scopes[0];
                hintText.textContent = scope?.hint ?? '';
                if (hint.isConnected) fitWithin(hint);
            };

            nameInput.addEventListener('input', syncToken);
            nameInput.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    insertBtn.click();
                }
            });
            scopeSelect.addEventListener('change', syncHint);
            insertBtn.addEventListener('click', () => insert(`{counter:${cleanCounterName() || defaultName}}`));

            syncToken();
            syncHint();

            card.append(head, row, hint);
            return card;
        }

        function renderVars() {
            const box = $<HTMLElement>('[data-vars]');
            const all = current().vars;
            const shown = surfaceId === 'custom' ? all.filter((item) => item.pinned) : all;

            box.replaceChildren();
            for (const item of shown) {
                box.append(item.scopes?.length ? buildCounterVar(item) : buildSimpleVar(item));
            }
            fitWithin(box);
        }

        const recipesBox = $<HTMLElement>('[data-recipes]');
        for (const recipe of ui.recipes) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'bb-chip bb-chip--muted';
            const label = el('span', '', recipe.label);
            label.dataset.fit = '';
            btn.append(label);
            btn.addEventListener('click', () => {
                ta.value = recipe.text;
                update();
            });
            recipesBox.append(btn);
        }
        fitWithin(recipesBox);

        function problem(): string | null {
            const out = lines();
            if (mode === 'custom' && !cleanName()) return ui.statusName;
            if (out.length === 0) return ui.statusEmpty;
            if (out.length > data.limits.linesMax) return ui.statusLines;
            if (out.some((l) => l.length > data.limits.lineMax)) return ui.statusLineLen;
            return null;
        }

        function dashboardURL(): string {
            const url = new URL(data.dashboardOrigin + '/commands');
            url.searchParams.set('compose', '1');
            url.searchParams.set('name', cleanName());
            url.searchParams.set('response', lines().join('\n'));
            url.searchParams.set('perm', permSel.value);
            url.searchParams.set('cooldown', String(cleanCooldown()));
            const aliases = cleanAliases();
            if (aliases.length) url.searchParams.set('aliases', aliases.join(','));
            if (data.lang !== data.defaultLang) url.searchParams.set('lang', data.lang);
            return url.toString();
        }

        function moduleHref(surface: Surface): string {
            const query = data.lang !== data.defaultLang ? '?lang=' + data.lang : '';
            return data.dashboardOrigin + surface.dashPath + query;
        }

        function syncSend(err: string | null) {
            const custom = mode === 'custom';
            $('[data-send-wrap]').toggleAttribute('hidden', !custom);
            if (!custom) return;
            sendLink.href = err ? '#' : dashboardURL();
            sendLink.setAttribute('aria-disabled', String(Boolean(err)));
        }

        function showCustomCopy(out: string[]) {
            setFitText('[data-copy-title]', ui.copyTitleCustom);
            moduleWrap.hidden = true;
            const single = out.length === 1;
            copyWrap.toggleAttribute('hidden', !single);
            if (single) output.textContent = `!cmd add ${cleanName() || 'yourcommand'} ${out[0]}`;
        }

        function showModuleCopy(surface: Surface) {
            setFitText('[data-copy-title]', ui.copyBodyModule);
            copyWrap.removeAttribute('hidden');
            output.textContent = ta.value.trim();
            moduleWrap.hidden = false;
            moduleLink.href = moduleHref(surface);
        }

        function update() {
            clampTemplate();
            const surface = current();
            const err = problem();
            const out = lines();
            const custom = mode === 'custom';

            $('[data-count]').textContent = String(Math.max(0, ...out.map((l) => l.length), 0));
            setFitText('[data-context]', custom ? `!${cleanName() || 'yourcommand'}` : surface.label);
            setFitText('[data-scope]', surface.label);
            setFitText('[data-preview-note]', surface.hint);
            setFitText('[data-valid]', err ?? '');
            setFitText('[data-action-title]', custom ? ui.sendTitle : ui.copyTitleModule);

            syncSend(err);
            if (custom) showCustomCopy(out);
            else showModuleCopy(surface);
            copyBtn.disabled = !!err;

            schedulePreview();
        }

        function setSurface(id: string) {
            surfaceId = id;
            const surface = current();
            if (surfaceHint) surfaceHint.textContent = surface.hint;
            ta.value = surface.example;
            renderVars();
            update();
        }

        function setMode(next: 'custom' | 'module') {
            mode = next;
            const custom = next === 'custom';
            $('[data-module-pick]').toggleAttribute('hidden', custom);
            $('[data-command-fields]').toggleAttribute('hidden', !custom);
            $('[data-more]').toggleAttribute('hidden', !custom);
            recipesBox.toggleAttribute('hidden', !custom);
            setSurface(custom ? 'custom' : surfaceSel.value);
        }

        function showCopyState(label: string, done: boolean) {
            setFitText('[data-copy-label]', label);
            copyBtn.classList.toggle('is-done', done);
        }

        modeGroup.addEventListener('click', (event) => {
            const value = (event.target as Element).closest<HTMLButtonElement>('[role="radio"]')?.value;
            const picked = MODES.find((candidate) => candidate === value);
            if (picked) setMode(picked);
        });
        surfaceSel.addEventListener('change', () => setSurface(surfaceSel.value));
        [ta, nameInput, aliasInput, permSel, cdInput, styleSel].forEach((input) =>
            input.addEventListener('input', update),
        );

        copyBtn.addEventListener('click', async () => {
            const copied = await copyFlash(output.textContent || '', (on) => showCopyState(on ? ui.copied : ui.copyCta, on), COPY_FLASH_MS);
            if (copied) return;
            showCopyState(ui.copyFail, false);
            setTimeout(() => showCopyState(ui.copyCta, false), COPY_FLASH_MS);
        });

        sendLink.addEventListener('click', (event) => {
            if (sendLink.getAttribute('aria-disabled') === 'true') event.preventDefault();
        });

        setSurface('custom');
    }

    bindOnce('[data-builder]', initBuilder);
</script>

<style>
