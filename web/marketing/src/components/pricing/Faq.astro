import Section from '@bagel/ui/astro/Section.astro';
import SectionHeading from '@bagel/ui/astro/SectionHeading.astro';
import Disclosure from '@bagel/ui/astro/Disclosure.astro';
import Text from '@bagel/ui/astro/Text.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface FaqItem {
    question: string;
    answer: string;
}

interface Props {
    eyebrow?: string;
    title?: string;
    items?: FaqItem[];
}

const {
    eyebrow = t('faq.eyebrow'),
    title = t('faq.title'),
    items,
} = Astro.props;

const faqs: FaqItem[] = items ?? [
    { question: t('faq.q1'), answer: t('faq.a1') },
    { question: t('faq.q2'), answer: t('faq.a2') },
    { question: t('faq.q3'), answer: t('faq.a3') },
    { question: t('faq.q4'), answer: t('faq.a4') },
    { question: t('faq.q5'), answer: t('faq.a5') },
];

const faqLd = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
};
---

<Section size="page" class="faq">
    <SectionHeading eyebrow={eyebrow} title={title} />

    <div class="faq__list">
        {faqs.map((faq, i) => (
            <Disclosure summary={faq.question} index={String(i + 1).padStart(2, '0')} data-reveal style={`--reveal-i: ${i}`}>
                <Text size="sm" tone="muted" class="faq__answer"><span data-fit="block">{faq.answer}</span></Text>
            </Disclosure>
        ))}
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />
</Section>

<style>
    .faq {
        padding-inline: 48px;
        max-width: var(--bb-content-max);
        margin: 0 auto;
    }

    .faq__list {
        max-width: var(--bb-content-hero);
        margin: 0 auto;
    }

    .faq__answer { height: calc(3 * 1lh); }

    @media (max-width: 640px) {
        .faq { padding-inline: 24px; }
        .faq__answer { height: calc(7 * 1lh); }
        .faq__list { --disclosure-label-lines: 2; }
    }
</style>
