import { dashboardHref } from '@bagel/kit/site-links';
import ButtonLink from '@bagel/ui/astro/ButtonLink.astro';
import Card from '@bagel/ui/astro/Card.astro';
import Icon from '@bagel/ui/astro/Icon.astro';
import BolotaSvg from '../BolotaSvg.astro';
import { staticBolota, type StaticBolota } from '../../lib/bolota';
import { getLangFromUrl, useTranslations, defaultLang, dashLoginHref } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const external = { target: '_blank', rel: 'noopener noreferrer' };

interface Tier {
    key: 'free' | 'premium' | 'enterprise';
    faces: StaticBolota[];
    name: string;
    badge?: string;
    price: string;
    suffix?: string;
    desc: string;
    lead?: string;
    features: string[];
    cta: string;
    href: string;
    primary?: boolean;
    external?: boolean;
    note?: string;
}

const tiers: Tier[] = [
    {
        key: 'free',
        faces: [staticBolota('seedling_sky', 72, 'green')],
        name: t('pricingTiers.free'),
        price: '$0',
        suffix: t('pricingTiers.freeSuffix'),
        desc: t('pricingTiers.freeDesc'),
        features: [t('pricingTiers.freeFeat1'), t('pricingTiers.freeFeat2'), t('pricingTiers.freeFeat3'), t('pricingTiers.freeFeat4')],
        cta: t('pricingTiers.getStarted'),
        href: dashLoginHref(lang),
        external: true,
    },
    {
        key: 'premium',
        faces: [staticBolota('kiki_bakes', 72, 'tan')],
        name: t('pricingTiers.premium'),
        badge: t('pricingTiers.premiumBadge'),
        price: '7$',
        suffix: t('pricingTiers.premiumSuffix'),
        desc: t('pricingTiers.premiumDesc'),
        lead: t('pricingTiers.premiumFeat1'),
        features: [t('pricingTiers.premiumFeat2'), t('pricingTiers.premiumFeat3'), t('pricingTiers.premiumFeat4'), t('pricingTiers.premiumFeat5')],
        cta: t('pricingTiers.getPremium'),
        href: dashboardHref('/billing?subscribe=1', lang === defaultLang ? '' : `?lang=${lang}`),
        primary: true,
        external: true,
        note: t('pricingTiers.tebexNote'),
    },
    {
        key: 'enterprise',
        faces: [staticBolota('crumb_lord', 56, 'pale'), staticBolota('mirafox', 72, 'green'), staticBolota('dusty_crumbs', 56, 'tan')],
        name: t('pricingTiers.enterprise'),
        price: t('pricingTiers.enterpriseAmount'),
        desc: t('pricingTiers.enterpriseDesc'),
        lead: t('pricingTiers.enterpriseFeat1'),
        features: [t('pricingTiers.enterpriseFeat2'), t('pricingTiers.enterpriseFeat3'), t('pricingTiers.enterpriseFeat4')],
        cta: t('pricingTiers.contactSales'),
        href: 'mailto:enterprise@itsbagelbot.com',
    },
];
---

<div class="tiers">
    {tiers.map((tier, i) => (
        <div class:list={['tier', `tier--${tier.key}`]} data-reveal style={`--reveal-i: ${i}`}>
            <div class="tier__faces" aria-hidden="true">
                {tier.faces.map((face) => (
                    <BolotaSvg bolota={face} class="tier__face" style={`--s: ${face.size}px`} />
                ))}
            </div>
            <Card class="tier__card" tone={tier.primary ? 'accent' : undefined} raised={tier.primary}>
                <h3 class="tier__head">
                    <span class="tier__name"><span data-fit>{tier.name}</span></span>
                    {tier.badge && <span class="tier__badge"><span data-fit>{tier.badge}</span></span>}
                </h3>
                <div class="tier__price">
                    <span class="tier__amount"><span data-fit>{tier.price}</span></span>
                    {tier.suffix && <span class="tier__suffix"><span data-fit>{tier.suffix}</span></span>}
                </div>
                <p class="tier__desc"><span data-fit="block">{tier.desc}</span></p>
                <div class="tier__rule"></div>
                <p class="tier__lead">{tier.lead && <span data-fit>{tier.lead}</span>}</p>
                <ul class="tier__features">
                    {tier.features.map((feature) => (
                        <li class="tier__feature"><Icon name="check" size={14} class="tier__check" /><span class="tier__feat"><span data-fit="block">{feature}</span></span></li>
                    ))}
                </ul>
                <ButtonLink
                    class="tier__cta"
                    href={tier.href}
                    variant={tier.primary ? 'primary' : 'secondary'}
                    {...(tier.external ? external : {})}
                ><span data-fit>{tier.cta}</span></ButtonLink>
                <p class="tier__note">{tier.note && <span data-fit>{tier.note}</span>}</p>
            </Card>
        </div>
    ))}
</div>

<style>
    .tiers {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        grid-template-rows: repeat(9, auto);
        column-gap: var(--bb-space-5);
    }

    .tier {
        display: grid;
        grid-row: span 9;
        grid-template-rows: subgrid;
        min-width: 0;
    }

    .tier__faces {
        grid-row: 1;
        position: relative;
        z-index: 2;
        display: flex;
        align-items: flex-end;
        height: 72px;
        margin-bottom: -34px;
        padding-left: var(--bb-space-5);
        pointer-events: none;
    }

    .tier__faces :global(.tier__face) {
        display: block;
        width: var(--s);
        height: var(--s);
        overflow: visible;
        animation: bob 6.5s ease-in-out infinite alternate;
    }

    .tier__faces :global(.tier__face + .tier__face) {
        margin-left: -14px;
        animation-delay: -1.8s;
    }

    .tier__faces :global(.tier__face:nth-child(3)) { animation-delay: -3.4s; }

    .tier :global(.tier__card) {
        grid-row: 2 / span 8;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
        row-gap: var(--bb-space-4);
        min-width: 0;
        padding: calc(var(--bb-space-6) + 8px) var(--bb-space-6) var(--bb-space-6);
    }

    .tier--free :global(.tier__card) { --card-halo-rgb: var(--bb-halo-green-rgb); }
    .tier--enterprise :global(.tier__card) { --card-halo: 0.35; }

    .tier__head {
        display: flex;
        align-items: center;
        gap: var(--bb-space-3);
        margin: 0;
        font-size: var(--bb-text-md);
        font-weight: 600;
        color: var(--bb-paper);
    }

    .tier--free .tier__head { color: var(--bb-tier-free); }
    .tier--premium .tier__head { color: var(--bb-tier-paid); }

    .tier__name {
        display: flex;
        flex: 0 0 6.75rem;
        min-width: 0;
    }

    .tier__badge {
        display: flex;
        flex: 1 1 0;
        justify-content: flex-end;
        min-width: 0;
        font-size: var(--bb-text-xs);
        font-weight: 500;
        color: var(--bb-muted);
    }

    .tier__price {
        display: flex;
        align-items: baseline;
        gap: var(--bb-space-2);
        min-width: 0;
    }

    .tier__amount {
        display: flex;
        flex: none;
        max-width: 100%;
        font-family: var(--bb-font-display);
        font-size: clamp(2.5rem, 4vw, 3.25rem);
        font-weight: 500;
        letter-spacing: -0.05em;
        line-height: 1;
        color: var(--bb-paper);
    }

    .tier__suffix {
        display: flex;
        flex: 1 1 0;
        min-width: 0;
        font-size: var(--bb-text-sm);
        color: var(--bb-muted);
    }

    .tier__desc {
        height: calc(2 * 1lh);
        margin: 0;
        font-size: var(--bb-text-sm);
        line-height: 1.55;
        color: var(--bb-muted-light);
    }

    .tier__rule {
        align-self: center;
        height: 1px;
        background: var(--bb-border);
    }

    .tier__lead {
        display: flex;
        height: 1lh;
        margin: 0;
        font-size: var(--bb-text-sm);
        color: var(--bb-muted);
    }

    .tier__features {
        display: flex;
        flex-direction: column;
        gap: var(--bb-space-1);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tier__feature {
        display: flex;
        align-items: flex-start;
        gap: var(--bb-space-2);
        font-size: var(--bb-text-sm);
        line-height: 1.45;
        color: var(--bb-paper);
    }

    .tier__features :global(.tier__check) {
        flex: none;
        margin-top: 3px;
        color: var(--bb-green-glow);
    }

    .tier--premium .tier__features :global(.tier__check) { color: var(--bb-tan-light); }

    .tier__feat {
        flex: 1 1 0;
        min-width: 0;
        height: calc(2 * 1lh);
    }

    .tier :global(.tier__cta) {
        --btn-w: 100%;
        align-self: end;
        margin-top: var(--bb-space-3);
    }

    .tier__note {
        display: flex;
        justify-content: center;
        height: 1lh;
        margin: 0;
        font-size: var(--bb-text-xs);
        color: var(--bb-muted);
    }

    @keyframes bob {
        from { translate: 0 0; }
        to { translate: 0 -7px; }
    }

    @media (prefers-reduced-motion: reduce) {
        .tier__faces :global(.tier__face) { animation: none; }
    }

    @media (max-width: 900px) {
        .tiers {
            grid-template-columns: minmax(0, 1fr);
            width: min(100%, 480px);
            margin-inline: auto;
        }

        .tier { margin-bottom: var(--bb-space-6); }
    }

    @media (max-width: 760px) {
        .tier :global(.tier__card) { padding-inline: var(--bb-space-5); }
    }
</style>
