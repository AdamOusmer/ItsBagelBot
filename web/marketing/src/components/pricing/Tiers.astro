import { dashboardHref } from '@bagel/kit/site-links';

import Card from '@bagel/ui/astro/Card.astro';
import ButtonLink from '@bagel/ui/astro/ButtonLink.astro';
import Badge from '@bagel/ui/astro/Badge.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Text from '@bagel/ui/astro/Text.astro';
import { Image } from 'astro:assets';
import premiumLogo from '../../assets/premium-logo.png';
import { getLangFromUrl, useTranslations, defaultLang, dashLoginHref } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const freeFeatures = [
    t('pricingTiers.freeFeat1'), t('pricingTiers.freeFeat2'), t('pricingTiers.freeFeat3'), t('pricingTiers.freeFeat4'),
];

const premiumFeatures = [
    t('pricingTiers.premiumFeat1'), t('pricingTiers.premiumFeat2'), t('pricingTiers.premiumFeat3'), t('pricingTiers.premiumFeat4'),
    t('pricingTiers.premiumFeat5'),
];

const enterpriseFeatures = [
    t('pricingTiers.enterpriseFeat1'), t('pricingTiers.enterpriseFeat2'), t('pricingTiers.enterpriseFeat3'), t('pricingTiers.enterpriseFeat4'),
];
---

<section class="tiers">
    <div class="tier-glow" data-reveal>
    <Card atmo hover tone="accent">
        <div class="tier-free__layout">
            <div class="tier-free__head">
                <Heading level={5} as="h3" variant="title" uppercase class="tier__name"><span data-fit>{t('pricingTiers.free')}</span></Heading>
                <div class="tier__price">
                    <Heading level={2} as="span">$0</Heading>
                    <Text as="span" size="sm" tone="muted" class="tier__suffix"><span data-fit>{t('pricingTiers.freeSuffix')}</span></Text>
                </div>
                <Text size="sm" tone="muted" class="tier__desc"><span data-fit="block">{t('pricingTiers.freeDesc')}</span></Text>
                <ButtonLink href={dashLoginHref(lang)} target="_blank" rel="noopener noreferrer" class="tier__start"><span data-fit>{t('pricingTiers.getStarted')}</span></ButtonLink>
            </div>

            <ul class="tier__features tier-free__features">
                {freeFeatures.map((feature, fi) => (
                    <li data-reveal style={`--reveal-i: ${fi + 1}`}>
                        <Text as="span" size="sm" tone="soft" class="tier__feat"><span data-fit="block">{feature}</span></Text>
                    </li>
                ))}
            </ul>
        </div>
    </Card>
    </div>

    <div class="tiers__pair">
        <Card atmo hover class="tier--premium" data-reveal>
            <div class="tier__demo" slot="band" aria-hidden="true">
                <span class="tier__premium-float bb-layers">
                    <Image src={premiumLogo} alt="Premium" class="tier__premium-logo" width={160} height={160} loading="lazy" />
                    <Image src={premiumLogo} alt="" class="tier__premium-logo tier__premium-logo--lit" width={160} height={160} loading="lazy" />
                </span>
            </div>
            <Badge shape="pill" class="tier__badge"><span data-fit>{t('pricingTiers.premiumBadge')}</span></Badge>
            <Heading level={5} as="h3" variant="title" uppercase class="tier__name"><span data-fit>{t('pricingTiers.premium')}</span></Heading>
            <div class="tier__price">
                <Heading level={2} as="span" data-tier-count>7$</Heading>
                <Text as="span" size="sm" tone="muted" class="tier__suffix"><span data-fit>{t('pricingTiers.premiumSuffix')}</span></Text>
            </div>
            <Text size="sm" tone="muted" class="tier__desc"><span data-fit="block">{t('pricingTiers.premiumDesc')}</span></Text>
            <ul class="tier__features">
                {premiumFeatures.map((feature, fi) => (
                    <li data-reveal style={`--reveal-i: ${fi + 1}`}>
                        <Text as="span" size="sm" tone="muted" class="tier__feat"><span data-fit="block">{feature}</span></Text>
                    </li>
                ))}
            </ul>
            <ButtonLink
                variant="secondary"
                block
                class="tier__cta"
                href={dashboardHref('/billing?subscribe=1', lang === defaultLang ? '' : `?lang=${lang}`)}
                target="_blank"
                rel="noopener noreferrer"
            ><span data-fit>{t('pricingTiers.chipIn')}</span></ButtonLink>
            <Text size="xs" mono tone="muted" class="tier__tebex-note">{t('pricingTiers.tebexNote')}</Text>
        </Card>

        <Card atmo hover class="tier--enterprise" data-reveal>
            <div class="tier__demo" slot="band" aria-hidden="true">
                <div class="tier__demo-ent">
                    <div class="ent-server">
                        <i class="bb-mark ent-server__light" aria-hidden="true"></i><span class="ent-line"></span><i class="bb-sweep" aria-hidden="true"></i>
                    </div>
                    <div class="ent-server">
                        <i class="bb-mark ent-server__light" aria-hidden="true"></i><span class="ent-line"></span><i class="bb-sweep ent-sweep--2" aria-hidden="true"></i>
                    </div>
                    <div class="ent-server">
                        <i class="bb-mark ent-server__light" aria-hidden="true"></i><span class="ent-line"></span><i class="bb-sweep ent-sweep--3" aria-hidden="true"></i>
                    </div>
                </div>
            </div>
            <Heading level={5} as="h3" variant="title" uppercase class="tier__name"><span data-fit>{t('pricingTiers.enterprise')}</span></Heading>
            <div class="tier__price">
                <Heading level={2} as="span" class="tier__amount"><span data-fit>{t('pricingTiers.enterpriseAmount')}</span></Heading>
            </div>
            <Text size="sm" tone="muted" class="tier__desc"><span data-fit="block">{t('pricingTiers.enterpriseDesc')}</span></Text>
            <ul class="tier__features">
                {enterpriseFeatures.map((feature, fi) => (
                    <li data-reveal style={`--reveal-i: ${fi + 1}`}>
                        <Text as="span" size="sm" tone="muted" class="tier__feat"><span data-fit="block">{feature}</span></Text>
                    </li>
                ))}
            </ul>
            <ButtonLink variant="secondary" block class="tier__cta" href="mailto:enterprise@itsbagelbot.com"><span data-fit>{t('pricingTiers.contactSales')}</span></ButtonLink>
        </Card>
    </div>

    <Text size="xs" mono tone="muted" class="tiers__oath" data-reveal><span data-fit="block">{t('pricingTiers.oath')}</span></Text>
</section>

<style>
    .tiers {
        --card-body-display: flex;
        --card-body-dir: column;
        --card-body-h: 100%;
        padding: 0 24px var(--bb-space-section);
        max-width: var(--bb-content-max);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .tier--premium { --reveal-i: 1; }
    .tier--enterprise { --reveal-i: 2; }

    .tiers__pair {
        display: grid;
        grid-template-columns: 1fr;
        gap: 24px;
        --card-band-h: 116px;
    }

    @media (min-width: 860px) {
        .tiers__pair { grid-template-columns: repeat(2, 1fr); }
    }

    .tier-glow {
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .tier-glow::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: var(--bb-radius-md);
        box-shadow: 0 0 56px rgba(var(--bb-tan-rgb), 0.22), 0 0 100px rgba(var(--bb-tan-rgb), 0.07);
        opacity: 0;
        pointer-events: none;
        animation: freeGlow 5s ease-in-out infinite;
    }

    @keyframes freeGlow {
        0%, 100% { opacity: 0; }
        50% { opacity: 1; }
    }

    @media (prefers-reduced-motion: reduce) {
        .tier-glow::before { animation: none; }
    }

    .tier-free__layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 32px;
    }

    @media (min-width: 860px) {
        .tier-free__layout {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
            gap: 48px;
            align-items: center;
            padding: 8px;
        }
    }

    .tier__tebex-note {
        text-align: center;
        margin-top: 12px;
    }

    .tier__badge {
        --badge-pill-size: var(--bb-text-xs);
        --badge-tone: var(--bb-black);
        --badge-bg: var(--bb-tan);
        --badge-tone-rule: var(--bb-tan);
        position: absolute;
        top: 0;
        left: 50%;
        justify-content: center;
        width: min(19rem, calc(100% - 32px));
        transform: translate(-50%, -50%);
        z-index: 1;
    }

    .tier__demo {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100%;
        overflow: hidden;
    }

    .tier__premium-float {
        max-width: 90%;
        place-items: center;
        animation: premiumFloat 5s ease-in-out infinite;
    }

    .tier__premium-logo {
        max-width: 100%;
        max-height: 80px;
        object-fit: contain;
        filter: drop-shadow(0 4px 12px rgba(var(--bb-tan-rgb), 0.15));
    }

    .tier__premium-logo--lit {
        filter: drop-shadow(0 8px 20px rgba(var(--bb-tan-rgb), 0.35));
        opacity: 0;
        animation: premiumGlow 5s ease-in-out infinite;
    }

    @keyframes premiumFloat {
        0%, 100% { transform: none; }
        50% { transform: translateY(-3px) scale(1.02); }
    }

    @keyframes premiumGlow {
        0%, 100% { opacity: 0; }
        50% { opacity: 1; }
    }

    .tier__demo-ent {
        display: flex;
        flex-direction: column;
        gap: 6px;
        width: 80px;
    }

    .ent-server {
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 8px;
        border: 1px solid rgba(var(--bb-tan-rgb), 0.15);
        border-radius: var(--bb-radius-xs);
        background: rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .ent-server__light {
        color: var(--bb-green-glow);
    }

    .ent-sweep--2 { animation-delay: 0.5s; }
    .ent-sweep--3 { animation-delay: 1s; }

    .ent-line {
        flex: 1;
        height: 2px;
        background: rgba(var(--bb-tan-rgb), 0.2);
        border-radius: var(--bb-radius-pill);
    }

    @media (prefers-reduced-motion: reduce) {
        .tier__premium-float,
        .tier__premium-logo--lit { animation: none; }
    }

    .tier__name {
        margin-bottom: 18px;
    }

    .tier__price {
        display: flex;
        align-items: baseline;
        gap: 2px;
        margin-bottom: 14px;
    }

    .tier__suffix {
        flex: 1 1 0;
        min-width: 0;
        margin-left: 6px;
    }

    .tier__amount {
        flex: 1 1 0;
        min-width: 0;
    }

    .tier__desc {
        height: calc(2 * 1lh);
        margin: 0 0 22px;
        max-width: 40ch;
    }

    .tier__start { --btn-w: 13rem; }

    .tier__feat {
        display: block;
        height: 1lh;
    }

    .tier-free__features .tier__feat { height: calc(2 * 1lh); }

    @media (max-width: 859px) {
        .tier__feat { height: calc(2 * 1lh); }
    }

    .tier__features {
        display: flex;
        flex-direction: column;
        gap: 11px;
        margin: 0 0 26px;
    }

    .tier-free__features {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        margin: 0;
        padding: 20px 0 0;
        border-top: 1px solid var(--bb-border);
    }

    @media (min-width: 560px) {
        .tier-free__features { grid-template-columns: repeat(2, 1fr); }
    }

    @media (min-width: 860px) {
        .tier-free__features { border-top: none; border-left: 1px solid var(--bb-border); padding: 0 0 0 40px; }
    }

    .tier__cta {
        margin-top: auto;
    }

    .tiers__oath {
        text-align: center;
        border: 1px dashed rgba(var(--bb-tan-rgb), 0.22);
        border-radius: var(--bb-radius-pill);
        width: min(36rem, 100%);
        height: calc(2 * 1lh + 24px);
        padding: 12px 24px;
        margin: 12px auto 0;
    }
</style>

<script>
    import { bindOnce } from '../../script/bind';
    import { countUp } from '@bagel/ui/lib/count-up';

    function countWhenRevealed(amount: HTMLElement) {
        const scene = amount.closest<HTMLElement>('[data-reveal]');
        if (!scene || scene.classList.contains('is-revealed')) {
            countUp(amount);
            return;
        }
        const watcher = new MutationObserver(() => {
            if (!scene.classList.contains('is-revealed')) return;
            watcher.disconnect();
            countUp(amount);
        });
        watcher.observe(scene, { attributes: true, attributeFilter: ['class'] });
    }

    bindOnce('[data-tier-count]', countWhenRevealed);
</script>
