import BolotaSvg from './BolotaSvg.astro';
import brandTokens from '@bagel/ui/styles/brand.css?raw';
import { parts } from '@luzir/bolota';

const NAME = 'oven_fresh';
const SIZE = 240;

function token(name: string): string {
    const value = brandTokens.match(new RegExp(`--${name}:\\s*(#[0-9a-fA-F]{3,8})\\s*;`))?.[1];
    if (!value) throw new Error(`@bagel/ui brand.css has no color token --${name}`);
    return value;
}

const palette = { head: token('bb-green-glow'), eye: token('bb-black') };
const { inner } = parts(NAME, { size: SIZE, palette, background: false });
---

<BolotaSvg class="error-bolota" bolota={{ name: NAME, size: SIZE, head: palette.head, eye: palette.eye, inner }} />

<script>
    import { bolotaProps } from '../lib/bolota-props';
    import '@luzir/bolota/motion.css';
    import '@luzir/bolota/gaze.css';
    import { prefersReducedMotion } from '@bagel/ui/lib/motion-query';
    import type { EngineHandle } from '@luzir/bolota/engine';

    const EXPRESSIONS = ['curious', 'surprised', 'proud', 'attentive'];
    const EXPRESSION_MS = 3400;

    let handle: EngineHandle | null = null;
    let timer: ReturnType<typeof setInterval> | null = null;
    let mounting = false;

    async function mount(): Promise<void> {
        const svg = document.querySelector<SVGSVGElement>('.error-bolota');
        if (!svg || handle || mounting || prefersReducedMotion()) return;
        mounting = true;
        const { mountEngine } = await import('@luzir/bolota/engine');
        if (!mounting) return;

        const props = bolotaProps(svg);
        handle = mountEngine(svg, props.name, {
            size: props.size,
            palette: props.palette,
            background: false,
        });
        handle.loop('idle');
        handle.follow('window');

        let step = 0;
        const next = () => handle?.setExpression(EXPRESSIONS[step++ % EXPRESSIONS.length]);
        next();
        timer = setInterval(next, EXPRESSION_MS);
        mounting = false;
    }

    function teardown(): void {
        mounting = false;
        if (timer) clearInterval(timer);
        timer = null;
        handle?.destroy();
        handle = null;
    }

    mount();
    document.addEventListener('astro:page-load', mount);
    document.addEventListener('astro:before-swap', teardown);
    window.addEventListener('pagehide', teardown);
</script>

<style>
    :global(.error-bolota) { scale: 0.9; }
</style>
