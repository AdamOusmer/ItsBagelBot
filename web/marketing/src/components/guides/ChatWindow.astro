import ChatPreview from '@bagel/ui/astro/ChatPreview.astro';
import ChatLines from './ChatLines.astro';
import type { ChatLine } from './ChatLines.astro';

export type { ChatLine };

interface Props {
    title: string;
    label: string;
    lines: ChatLine[];
    class?: string;
}

const { title, label, lines, class: className } = Astro.props;
---

<ChatPreview title={title} label={label} kind="chat" class={className}>
    <ChatLines lines={lines} />
</ChatPreview>
