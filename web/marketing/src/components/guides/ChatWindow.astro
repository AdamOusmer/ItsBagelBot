import type { HTMLAttributes } from 'astro/types';
import ChatPreview from '@bagel/ui/astro/ChatPreview.astro';
import ChatLines from './ChatLines.astro';
import type { ChatLine } from './ChatLines.astro';

export type { ChatLine };

interface Props extends HTMLAttributes<'div'> {
    title: string;
    label: string;
    lines: ChatLine[];
    kind?: string;
    fitReplies?: boolean;
    class?: string;
}

const { title, label, lines, kind = 'chat', fitReplies, ...rest } = Astro.props;
---

<ChatPreview title={title} label={label} kind={kind} {...rest}>
    <ChatLines lines={lines} fitReplies={fitReplies} />
</ChatPreview>
