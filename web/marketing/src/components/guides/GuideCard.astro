import Card from '@bagel/ui/astro/Card.astro';

interface Props {
    index: string;
    href: string;
    title: string;
    description: string;
    meta: string;
    chips?: string[];
    cta: string;
    wide?: boolean;
    revealIndex?: number;
}

const { index, href, title, description, meta, chips = [], cta, wide = false, revealIndex = 0 } = Astro.props;
---

<Card atmo hover
    as="a"
    href={href}
    label={index}
    class:list={['gcard', { 'gcard--wide': wide }]}
    data-cursor="quiet"
    data-reveal
    style={`--reveal-i: ${revealIndex}`}
>
    <span class="gcard__chips" slot="band" aria-hidden="true">
        {chips.map((chip) => <i>{chip}</i>)}
    </span>
    <span class="gcard__body">
        <b class="gcard__title">{title}</b>
        <span class="gcard__desc">{description}</span>
        <span class="gcard__foot">
            <span class="gcard__meta">{meta}</span>
            <span class="bb-btn bb-btn--quiet gcard__btn" data-cursor>{cta}</span>
        </span>
    </span>
</Card>

<style>
    .gcard__chips {
        display: flex;
        flex-wrap: wrap;
        align-content: center;
        align-items: center;
        gap: 8px;
        height: 100%;
        padding-right: 48px;
    }

    .gcard__chips i {
        font-style: normal;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        color: var(--tan-light, #e0c49a);
        padding: 4px 9px;
        border: 1px solid rgba(201, 168, 124, 0.22);
        border-radius: var(--radius-sm);
        background: rgba(201, 168, 124, 0.05);
    }

    .gcard__body {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-width: 0;
    }

    .gcard__title {
        display: block;
        font-family: var(--font-display, "Syne", sans-serif);
        font-size: clamp(1.15rem, 2vw, 1.4rem);
        font-weight: 700;
        letter-spacing: -0.015em;
        color: var(--white, #f0ece4);
        margin-bottom: 8px;
    }

    .gcard__desc {
        display: block;
        font-family: var(--font-body, "DM Sans", sans-serif);
        font-size: 0.96rem;
        line-height: 1.6;
        color: #a39c92;
        max-width: 58ch;
        margin-bottom: 18px;
    }

    .gcard__foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: auto;
    }

    .gcard__meta {
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        color: var(--muted, #888077);
        white-space: nowrap;
    }

    .gcard__btn {
        white-space: nowrap;
    }

    @media (hover: hover) and (pointer: fine) {
        :global(.gcard:hover) .gcard__btn {
            background: rgba(201, 168, 124, 0.08);
            border-color: rgba(201, 168, 124, 0.5);
            color: var(--tan-pale, #f5e6cf);
        }
    }

    :global(.gcard:focus-visible) {
        outline: 2px solid var(--green-glow, #52b788);
        outline-offset: 3px;
    }

    :global(.gcard--wide) .gcard__body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: 8px 32px;
    }
    :global(.gcard--wide) .gcard__title { grid-column: 1; }
    :global(.gcard--wide) .gcard__desc { grid-column: 1; margin-bottom: 0; }
    :global(.gcard--wide) .gcard__foot {
        grid-column: 2;
        grid-row: 1 / span 2;
        flex-direction: column;
        align-items: flex-end;
        margin-top: 0;
    }

    @media (max-width: 640px) {
        :global(.gcard--wide) .gcard__body { display: flex; align-items: stretch; }
        :global(.gcard--wide) .gcard__desc { margin-bottom: 18px; }
        :global(.gcard--wide) .gcard__foot { flex-direction: row; align-items: center; }
        .gcard__chips { padding-right: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .gcard__btn { transition: none; }
    }
</style>
