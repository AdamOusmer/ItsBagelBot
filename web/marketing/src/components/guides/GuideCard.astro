import Button from '@bagel/ui/astro/Button.astro';
import Card from '@bagel/ui/astro/Card.astro';
import Chip from '@bagel/ui/astro/Chip.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Text from '@bagel/ui/astro/Text.astro';

interface Props {
    index: string;
    href: string;
    title: string;
    description: string;
    meta: string;
    chips?: string[];
    cta: string;
    wide?: boolean;
    revealIndex?: number;
}

const { index, href, title, description, meta, chips = [], cta, wide = false, revealIndex = 0 } = Astro.props;
---

<Card atmo hover
    as="a"
    href={href}
    label={index}
    class:list={['gcard', { 'gcard--wide': wide }]}
    data-cursor="quiet"
    data-reveal
    style={`--reveal-i: ${revealIndex}`}
>
    <span class="gcard__chips" slot="band" aria-hidden="true">
        {chips.map((chip) => <Chip as="span">{chip}</Chip>)}
    </span>
    <span class="gcard__body">
        <Heading level={4} as="span" class="gcard__title">{title}</Heading>
        <Text as="span" tone="muted-light" class="gcard__desc">{description}</Text>
        <span class="gcard__foot">
            <Text as="span" size="xs" mono tone="muted" class="gcard__meta">{meta}</Text>
            <Button as="span" variant="secondary" data-cursor>{cta}</Button>
        </span>
    </span>
</Card>

<style>
    .gcard__chips {
        display: flex;
        flex-wrap: wrap;
        align-content: center;
        align-items: center;
        gap: 8px;
        height: 100%;
        padding-right: 48px;
    }

    .gcard__body {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-width: 0;
    }

    .gcard__title { margin-bottom: 8px; }

    .gcard__desc {
        display: block;
        max-width: 58ch;
        margin-bottom: 18px;
    }

    .gcard__foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: auto;
    }

    .gcard__meta { white-space: nowrap; }

    .gcard:focus-visible {
        outline: 2px solid var(--bb-green-glow);
        outline-offset: 3px;
    }

    .gcard--wide .gcard__body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: 8px 32px;
    }
    .gcard--wide .gcard__title { grid-column: 1; }
    .gcard--wide .gcard__desc { grid-column: 1; margin-bottom: 0; }
    .gcard--wide .gcard__foot {
        grid-column: 2;
        grid-row: 1 / span 2;
        flex-direction: column;
        align-items: flex-end;
        margin-top: 0;
    }

    @media (max-width: 640px) {
        .gcard--wide .gcard__body { display: flex; align-items: stretch; }
        .gcard--wide .gcard__desc { margin-bottom: 18px; }
        .gcard--wide .gcard__foot { flex-direction: row; align-items: center; }
        .gcard__chips { padding-right: 0; }
    }
</style>
