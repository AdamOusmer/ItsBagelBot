import Button from '@bagel/ui/astro/Button.astro';
import Card from '@bagel/ui/astro/Card.astro';
import Chip from '@bagel/ui/astro/Chip.astro';
import Cluster from '@bagel/ui/astro/Cluster.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Text from '@bagel/ui/astro/Text.astro';

interface Props {
    index: string;
    href: string;
    title: string;
    description: string;
    meta: string;
    chips?: string[];
    cta: string;
    wide?: boolean;
    revealIndex?: number;
}

const { index, href, title, description, meta, chips = [], cta, wide = false, revealIndex = 0 } = Astro.props;
---

<Card atmo hover
    as="a"
    href={href}
    label={index}
    class:list={['gcard', 'reveal-in', { 'gcard--wide': wide }]}
    data-cursor="quiet"
    style={`--reveal-i: ${revealIndex}`}
>
    <span class="gcard__chips" slot="band" aria-hidden="true">
        {chips.map((chip) => <Chip as="span" class="bb-chip--cell"><bb-fit>{chip}</bb-fit></Chip>)}
    </span>
    <span class="gcard__body">
        <Heading level={4} as="span" class="gcard__title"><bb-fit>{title}</bb-fit></Heading>
        <Text as="span" tone="muted-light" class="gcard__desc"><bb-fit mode="block">{description}</bb-fit></Text>
        <Cluster as="span" gap={3} justify="between" class="gcard__foot">
            <Text as="span" size="xs" mono tone="muted" class="gcard__meta"><bb-fit>{meta}</bb-fit></Text>
            <Button as="span" variant="secondary" class="gcard__cta" data-cursor><bb-fit>{cta}</bb-fit></Button>
        </Cluster>
    </span>
</Card>

<style>
    .gcard__chips {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
        align-content: center;
        align-items: center;
        gap: 8px;
        height: 100%;
        padding-right: 48px;
    }

    .gcard__body {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-width: 0;
    }

    .gcard__title {
        display: block;
        margin-bottom: 8px;
    }

    .gcard__desc {
        display: block;
        max-width: 58ch;
        height: calc(4 * 1lh);
        margin-bottom: 18px;
    }

    .gcard__foot { margin-top: auto; }

    .gcard__meta {
        flex: 0 0 11rem;
        min-width: 0;
    }

    .gcard__cta { --btn-w: 11rem; --btn-justify: safe center; }

    .gcard:focus-visible {
        outline: 2px solid var(--bb-green-glow);
        outline-offset: 3px;
    }

    .gcard--wide .gcard__body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: 8px 32px;
    }
    .gcard--wide .gcard__title { grid-column: 1; }
    .gcard--wide .gcard__desc { grid-column: 1; margin-bottom: 0; }
    .gcard--wide .gcard__foot {
        grid-column: 2;
        grid-row: 1 / span 2;
        flex-direction: column;
        align-items: flex-end;
        margin-top: 0;
    }
    .gcard--wide .gcard__meta {
        flex: none;
        width: 11rem;
        text-align: end;
    }

    @media (max-width: 640px) {
        .gcard--wide .gcard__body { display: flex; align-items: stretch; }
        .gcard--wide .gcard__desc { margin-bottom: 18px; }
        .gcard--wide .gcard__foot { flex-direction: row; align-items: center; }
        .gcard__chips { padding-right: 0; }
        .gcard__desc { height: calc(6 * 1lh); }
        .gcard--wide .gcard__meta { text-align: start; }
    }
</style>
