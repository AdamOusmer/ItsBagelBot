import Text from '@bagel/ui/astro/Text.astro';
import ChatWindow from './ChatWindow.astro';
import type { ChatLine } from './ChatWindow.astro';

interface Props {
    title?: string;
    lines: ChatLine[];
    caption?: string;
}

const { title = '#your_channel', lines, caption } = Astro.props;
---

<figure class="cmock" data-reveal>
    <ChatWindow title={title} label={caption ?? title} lines={lines} class="cmock__win" />
    {caption && <figcaption class="cmock__caption"><Text as="span" size="xs" mono tone="muted">{caption}</Text></figcaption>}
</figure>

<style>
    .cmock { margin: 20px 0 26px; }

    .cmock__caption {
        margin-top: 10px;
        padding-left: 2px;
    }
</style>
