import Checkbox from '@bagel/ui/astro/Checkbox.astro';

interface Props {
    label: string;
    checked?: boolean;
    note?: string;
}
const { label, checked = false, note } = Astro.props;
---

<span class="screen-check" inert>
    <Checkbox checked={checked} tabindex="-1">{label}</Checkbox>
    {note && <i class="gs-mark" data-note={note}></i>}
</span>

<style>
    .screen-check { display: inline-flex; align-items: center; gap: 10px; }
</style>
