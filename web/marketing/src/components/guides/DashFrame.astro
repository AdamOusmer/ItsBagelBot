import Text from '@bagel/ui/astro/Text.astro';
import '../../styles/guide-screen.css';

interface Note {
    n: number;
    text: string;
}

interface Props {
    path?: string;
    notes?: Note[];
    caption?: string;
}

const { path = '/', notes = [], caption } = Astro.props;
---

<figure class="dframe" data-reveal>
    <div class="dframe__win" role="img" aria-label={caption ?? `dashboard.itsbagelbot.com${path}`}>
        <div class="dframe__bar">
            <span class="dframe__url">dashboard.itsbagelbot.com<b class="dframe__path">{path}</b></span>
        </div>
        <div class="dframe__body" data-static>
            <slot />
        </div>
    </div>
    {notes.length > 0 && (
        <ul class="dframe__legend">
            {notes.map((note) => (
                <Text as="li" tone="muted-soft" class="dframe__note" data-note-for={note.n} tabindex={0}>
                    <i class="dframe__idx" aria-hidden="true">{String(note.n).padStart(2, '0')}</i>
                    <span>{note.text}</span>
                </Text>
            ))}
        </ul>
    )}
    {caption && <figcaption class="dframe__caption"><Text as="span" size="xs" mono tone="muted">{caption}</Text></figcaption>}
</figure>

<style>
    .dframe { margin: 20px 0 28px; }

    .dframe__win {
        border: 1px solid var(--bb-border);
        border-radius: var(--bb-radius-md);
        background: var(--bb-inset-bg);
        overflow: hidden;
        box-shadow: 0 24px 55px rgba(var(--bb-shadow-rgb), 0.4);
    }

    .dframe__bar {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 10px 14px;
        border-bottom: 1px solid rgba(var(--bb-tan-rgb), 0.1);
        background: rgba(var(--bb-card-bg-rgb), 0.92);
    }

    .dframe__url {
        flex: 1;
        max-width: 340px;
        font-family: var(--bb-font-mono);
        font-size: 0.64rem;
        color: var(--bb-muted);
        background: rgba(var(--bb-white-rgb), 0.04);
        border: 1px solid rgba(var(--bb-tan-rgb), 0.1);
        border-radius: var(--bb-radius-pill);
        padding: 5px 12px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dframe__path { color: var(--bb-tan-light); font-weight: 400; }

    .dframe__body { position: relative; padding: 18px; }

    .dframe__legend {
        display: grid;
        gap: 8px;
        margin-top: 14px;
        padding-left: 2px;
    }

    .dframe__note {
        display: flex;
        gap: 12px;
        align-items: baseline;
        padding: 2px 6px;
        margin: 0 -6px;
        border-radius: var(--bb-radius-sm);
        cursor: default;
        transition: background var(--bb-dur-base) var(--bb-ease-out-expo);
    }

    .dframe__note:hover,
    .dframe__note:focus-visible {
        background: rgba(var(--bb-tan-rgb), 0.06);
        outline: none;
    }

    .dframe__idx {
        flex: none;
        font-family: var(--bb-font-mono);
        font-style: normal;
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        color: var(--bb-tan);
    }

    @media (prefers-reduced-motion: reduce) {
        .dframe__note { transition: none; }
    }

    .dframe__caption {
        margin-top: 12px;
        padding-left: 2px;
    }

    @media (max-width: 640px) {
        .dframe__body { padding: 12px; }
    }
</style>

<script>
    import { bindOnce } from '../../script/bind';

    function setupFrame(frame: HTMLElement) {
        const lines = frame.querySelectorAll<HTMLElement>('[data-note-for]');
        lines.forEach((line) => {
            const n = line.dataset.noteFor;
            const target = frame.querySelector<HTMLElement>(`.gs-mark[data-note="${n}"]`)?.parentElement;
            if (!target) return;
            const on = () => target.classList.add('is-hot');
            const off = () => target.classList.remove('is-hot');
            line.addEventListener('mouseenter', on);
            line.addEventListener('mouseleave', off);
            line.addEventListener('focus', on);
            line.addEventListener('blur', off);
        });
    }

    bindOnce('.dframe', setupFrame);
</script>
