import Cluster from '@bagel/ui/astro/Cluster.astro';
import Stack from '@bagel/ui/astro/Stack.astro';
import Text from '@bagel/ui/astro/Text.astro';
import Well from '@bagel/ui/astro/Well.astro';
import Window from '@bagel/ui/astro/Window.astro';
import '../../styles/guide-screen.css';

interface Note {
    n: number;
    text: string;
}

interface Props {
    path?: string;
    notes?: Note[];
    caption?: string;
}

const { path = '/', notes = [], caption } = Astro.props;
---

<figure class="dframe" data-reveal>
    <Window class="dframe__win" role="img" aria-label={caption ?? `dashboard.itsbagelbot.com${path}`}>
        <Well as="span" slot="title" class="dframe__url">dashboard.itsbagelbot.com<b class="dframe__path">{path}</b></Well>
        <div class="dframe__body" data-static inert>
            <slot />
        </div>
    </Window>
    {notes.length > 0 && (
        <Stack as="ul" gap={2} class="dframe__legend">
            {notes.map((note) => (
                <Cluster as="li" gap={3} align="baseline" nowrap class="dframe__note" data-note-for={note.n} tabindex={0}>
                    <i class="dframe__idx" aria-hidden="true">{String(note.n).padStart(2, '0')}</i>
                    <Text as="span" tone="muted-soft">{note.text}</Text>
                </Cluster>
            ))}
        </Stack>
    )}
    {caption && <figcaption class="dframe__caption"><Text as="span" size="xs" mono tone="muted">{caption}</Text></figcaption>}
</figure>

<style>
    .dframe { margin: 20px 0 28px; }

    .dframe__url {
        flex: 1;
        max-width: 340px;
        padding: 5px 12px;
        font-size: 0.64rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dframe__path { color: var(--bb-tan-light); font-weight: 400; }

    .dframe__body { position: relative; padding: 18px; }

    .dframe__legend {
        margin-top: 14px;
        padding-left: 2px;
    }

    .dframe__note {
        padding: 2px 6px;
        margin: 0 -6px;
        border-radius: var(--bb-radius-sm);
        cursor: default;
        transition: background var(--bb-dur-base) var(--bb-ease-out-expo);
    }

    .dframe__note:hover,
    .dframe__note:focus-visible {
        background: rgba(var(--bb-tan-rgb), 0.06);
        outline: none;
    }

    .dframe__idx {
        flex: none;
        font-family: var(--bb-font-mono);
        font-style: normal;
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        color: var(--bb-tan);
    }

    @media (prefers-reduced-motion: reduce) {
        .dframe__note { transition: none; }
    }

    .dframe__caption {
        margin-top: 12px;
        padding-left: 2px;
    }

    @media (max-width: 640px) {
        .dframe__body { padding: 12px; }
    }
</style>

<script>
    import { bindOnce } from '../../script/bind';

    function setupFrame(frame: HTMLElement) {
        const lines = frame.querySelectorAll<HTMLElement>('[data-note-for]');
        lines.forEach((line) => {
            const n = line.dataset.noteFor;
            const target = frame.querySelector<HTMLElement>(`.gs-mark[data-note="${n}"]`)?.parentElement;
            if (!target) return;
            const on = () => target.classList.add('is-hot');
            const off = () => target.classList.remove('is-hot');
            line.addEventListener('mouseenter', on);
            line.addEventListener('mouseleave', off);
            line.addEventListener('focus', on);
            line.addEventListener('blur', off);
        });
    }

    bindOnce('.dframe', setupFrame);
</script>
