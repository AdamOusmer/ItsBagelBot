import Card from '@bagel/ui/astro/Card.astro';
import Table from '@bagel/ui/astro/Table.astro';

interface Props {
    head: string[];
    rows: string[][];
    caption?: string;
    id?: string;
}

const { head, rows, caption, id } = Astro.props;
---

<Card flush class="gtable">
    <Table roomy label={caption ?? head.join(' · ')} id={id}>
        {caption && <caption>{caption}</caption>}
        <thead><tr>{head.map((cell) => <th scope="col" set:html={cell} />)}</tr></thead>
        <tbody>
            {rows.map((row) => (
                <tr>{row.map((cell) => <td set:html={cell} />)}</tr>
            ))}
        </tbody>
    </Table>
</Card>

<style>
    .gtable { margin: 18px 0 22px; }
</style>
