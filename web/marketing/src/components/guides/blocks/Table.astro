interface Props {
    head: string[];
    rows: string[][];
    caption?: string;
    id?: string;
}

const { head, rows, caption, id } = Astro.props;
---

<div class="gtable-wrap">
    <table id={id}>
        {caption && <caption>{caption}</caption>}
        <thead><tr>{head.map((cell) => <th set:html={cell} />)}</tr></thead>
        <tbody>
            {rows.map((row) => (
                <tr>{row.map((cell) => <td set:html={cell} />)}</tr>
            ))}
        </tbody>
    </table>
</div>
