import Card from '@bagel/ui/astro/Card.astro';
import Heading from '@bagel/ui/astro/Heading.astro';

interface Props {
    items: { title: string; html: string }[];
}

const { items } = Astro.props;
---

<ol class="gsteps">
    {items.map((item) => (
        <Card as="li" flush>
            <div class="gsteps__item">
                <Heading level={6} as="div" class="gsteps__title">{item.title}</Heading>
                <div class="gsteps__body" set:html={item.html}></div>
            </div>
        </Card>
    ))}
</ol>

<style>
    .gsteps {
        list-style: none;
        display: grid;
        gap: 14px;
        counter-reset: gstep;
        margin: 22px 0;
        padding: 0;
    }

    .gsteps__item {
        counter-increment: gstep;
        position: relative;
        padding: 14px 16px 14px 46px;
    }

    .gsteps__item::before {
        content: counter(gstep, decimal-leading-zero);
        position: absolute;
        top: 15px;
        left: 16px;
        font-family: var(--bb-font-mono);
        font-size: 0.7rem;
        color: var(--bb-tan);
    }

    .gsteps__title { margin-bottom: 4px; }

    .gsteps__body :global(p) { margin: 0; }

    @media (max-width: 640px) {
        .gsteps__item { padding: 12px 13px 13px 40px; }
    }
</style>
