import Card from '@bagel/ui/astro/Card.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import '@bagel/ui/styles/elements/step-list.css';

interface Props {
    items: { title: string; html: string }[];
}

const { items } = Astro.props;
---

<ol class="bb-steps bb-steps--numbered gsteps">
    {items.map((item) => (
        <Card as="li" flush class="bb-step">
            <div class="bb-step__item">
                <Heading level={6} as="div">{item.title}</Heading>
                <div class="gsteps__body" set:html={item.html}></div>
            </div>
        </Card>
    ))}
</ol>

<style>
    .gsteps { margin: 22px 0; }

    .gsteps__body :global(p) { margin: 0; }
</style>
