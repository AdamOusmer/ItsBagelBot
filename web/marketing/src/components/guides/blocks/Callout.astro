import AlertBanner from '@bagel/ui/astro/AlertBanner.astro';

interface Props {
    tone: 'tip' | 'warn' | 'note';
    html: string;
}

const TONE = { tip: 'warm', warn: 'danger', note: 'neutral' } as const;

const { tone, html } = Astro.props;
---

<AlertBanner tone={TONE[tone] ?? 'warm'} variant="callout" role="note"><Fragment set:html={html} /></AlertBanner>
