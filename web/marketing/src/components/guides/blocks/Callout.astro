import AlertBanner from '@bagel/ui/astro/AlertBanner.astro';

interface Props {
    tone: 'tip' | 'warn' | 'note';
    html: string;
}

const VARIANT = { tip: 'tip', warn: 'danger', note: 'note' } as const;

const { tone, html } = Astro.props;
---

<AlertBanner variant={VARIANT[tone] ?? 'tip'} callout role="note"><Fragment set:html={html} /></AlertBanner>
