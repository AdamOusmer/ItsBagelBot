import { getLangFromUrl, localizePath, type Lang } from '../../i18n/ui';

/**
 * The reference deliberately accepts the manifest as data rather than
 * importing builder definitions. The variables catalog is the contract shared
 * by the bot and the site; this component only gives that contract a calm,
 * searchable presentation. The small normalizer keeps the page tolerant of
 * localized strings and of manifest fields that are optional for a family.
 */
type Localized = string | Record<string, string> | undefined;
type RawEntry = Record<string, unknown>;

interface Entry {
    id: string;
    syntax: string;
    syntaxes: string[];
    examples: { syntax: string; output: string }[];
    aliases: string[];
    aliasTokens: string[];
    name: string;
    description: string;
    example: string;
    output: string;
    category: string;
    surfaces: string[];
    surfaceIds: string[];
    requirement: string;
    payload: string;
    behavior: string;
    legacy: boolean;
}

interface Props {
    /** The language-neutral variable manifest. */
    catalog: unknown;
    lang?: Lang;
}

const { catalog, lang: providedLang } = Astro.props;
const lang = providedLang ?? getLangFromUrl(Astro.url);

const copy = lang === 'fr'
    ? {
        eyebrow: 'Référence',
        title: 'Toutes les variables.',
        lead: 'Une collection claire des variables que le bot sait développer dans vos réponses.',
        searchLabel: 'Rechercher les variables',
        searchPlaceholder: 'Syntaxe, alias, module ou description',
        categoryLabel: 'Catégorie',
        allCategories: 'Toutes les catégories',
        surfaceLabel: 'Disponible dans',
        allSurfaces: 'Toutes les surfaces',
        showing: 'variables affichées',
        empty: 'Aucune variable ne correspond.',
        emptyHint: 'Essayez une syntaxe, un alias ou un nom de module.',
        syntax: 'Syntaxe',
        example: 'Exemple',
        result: 'Résultat',
        available: 'Disponible dans',
        needs: 'Nécessite',
        payload: 'À modifier',
        behavior: 'À savoir',
        aliases: 'Aussi écrit',
        legacy: 'Alias historique',
        copy: 'Copier',
        copied: 'Copié',
        copyFailed: 'Copie impossible',
        unknown: 'Cette variable reste visible si sa surface ou son module ne la prend pas en charge.',
        noExample: 'Modifiez la valeur selon vos besoins.',
    }
    : {
        eyebrow: 'Reference',
        title: 'Every variable.',
        lead: 'A clear collection of the variables the bot can expand in your replies.',
        searchLabel: 'Search variables',
        searchPlaceholder: 'Syntax, alias, module, or description',
        categoryLabel: 'Category',
        allCategories: 'All categories',
        surfaceLabel: 'Available in',
        allSurfaces: 'All surfaces',
        showing: 'variables shown',
        empty: 'No variables match that search.',
        emptyHint: 'Try a syntax, alias, or module name.',
        syntax: 'Syntax',
        example: 'Example',
        result: 'Result',
        available: 'Available in',
        needs: 'Requires',
        payload: 'Change this',
        behavior: 'Good to know',
        aliases: 'Also written as',
        legacy: 'Legacy alias',
        copy: 'Copy',
        copied: 'Copied',
        copyFailed: 'Copy failed',
        unknown: 'This variable stays visible when its surface or module does not support it.',
        noExample: 'Change the value to suit your reply.',
    };

function local(value: Localized): string {
    if (typeof value === 'string') return value;
    if (!value) return '';
    return value[lang] ?? value.en ?? Object.values(value)[0] ?? '';
}

function list(value: unknown): string[] {
    if (!Array.isArray(value)) return [];
    return value.map((item) => {
        if (typeof item === 'string') return item;
        if (item && typeof item === 'object') {
            const record = item as RawEntry;
            return local((record.label ?? record.name ?? record.id) as Localized);
        }
        return '';
    }).filter(Boolean);
}

function stringField(record: RawEntry, ...keys: string[]): string {
    for (const key of keys) {
        const value = record[key];
        const result = local(value as Localized);
        if (result) return result;
    }
    return '';
}

function sourceEntries(value: unknown): RawEntry[] {
    if (Array.isArray(value)) return value.filter((item): item is RawEntry => !!item && typeof item === 'object');
    if (!value || typeof value !== 'object') return [];
    const record = value as RawEntry;
    for (const key of ['entries', 'variables', 'families', 'items']) {
        if (Array.isArray(record[key])) return sourceEntries(record[key]);
    }
    return [];
}

function normalize(record: RawEntry, index: number): Entry {
    const syntax = stringField(record, 'syntax', 'token', 'pattern', 'example') || `{variable-${index + 1}}`;
    const aliases = list(record.aliases ?? record.alsoWrittenAs);
    const aliasTokens = list(record.aliasTokens);
    const rawSurfaces = Array.isArray(record.surfaces) ? record.surfaces : [];
    const surfaces = list(record.surfaces ?? record.availability ?? record.availableIn ?? record.contexts);
    const surfaceIds = list(record.surfaceIds).length > 0
        ? list(record.surfaceIds)
        : rawSurfaces.map((item) => item && typeof item === 'object' ? String((item as RawEntry).id ?? '') : String(item)).filter(Boolean);
    const syntaxes = list(record.syntaxes);
    const rawExamples = Array.isArray(record.examples) ? record.examples : [];
    const examples = rawExamples.map((item) => {
        if (!item || typeof item !== 'object') return { syntax: '', output: '' };
        const example = item as RawEntry;
        return {
            syntax: stringField(example, 'syntax', 'token', 'pattern'),
            output: stringField(example, 'output', 'result', 'sample'),
        };
    }).filter((item) => item.syntax);
    const requirements = list(record.requirements);
    // Family records carry concrete examples separately from their canonical
    // pattern. Prefer the first of those for Copy so `{counter:name}` remains
    // explanatory while the button gives the broadcaster a paste-ready token.
    const example = stringField(record, 'example', 'editableExample', 'sample') || examples[0]?.syntax || syntax;
    return {
        id: String(record.id ?? record.key ?? syntax),
        syntax,
        syntaxes: [...new Set([syntax, ...syntaxes].filter(Boolean))],
        examples,
        aliases,
        aliasTokens,
        name: stringField(record, 'name', 'label', 'title') || syntax,
        description: stringField(record, 'description', 'desc', 'summary'),
        example,
        output: stringField(record, 'output', 'result', 'sampleOutput') || examples[0]?.output || '',
        category: stringField(record, 'category', 'group', 'family') || (lang === 'fr' ? 'Autres' : 'Other'),
        surfaces,
        surfaceIds,
        requirement: requirements.join(', ') || stringField(record, 'requirement', 'requires', 'needs', 'module'),
        payload: stringField(record, 'payload', 'payloadRule', 'input', 'change'),
        behavior: stringField(record, 'behavior', 'emptyBehavior', 'notes') || copy.unknown,
        legacy: record.legacy === true || record.deprecated === true,
    };
}

const entries = sourceEntries(catalog).map(normalize);
const categories = [...new Set(entries.map((entry) => entry.category))];
const surfaces = [...new Map(entries.flatMap((entry) => entry.surfaces.map((label, index) => [entry.surfaceIds[index] ?? label, label] as const))).entries()];
const categoryNames: Record<string, string> = lang === 'fr'
    ? { basics: 'Bases', arguments: 'Arguments', counters: 'Compteurs', dynamic: 'Dynamique', utilities: 'Utilitaires', viewer: 'Spectateur', channel: 'Chaîne', chat: 'Chat', emotes: 'Émotes', alerts: 'Alertes', rewards: 'Récompenses', queue: 'File d’attente', 'game-stats': 'Stats de jeu' }
    : { basics: 'Basics', arguments: 'Arguments', counters: 'Counters', dynamic: 'Dynamic', utilities: 'Utilities', viewer: 'Viewer', channel: 'Channel', chat: 'Chat', emotes: 'Emotes', alerts: 'Alerts', rewards: 'Rewards', queue: 'Queue', 'game-stats': 'Game stats' };
const searchState = Astro.url.searchParams.get('q') ?? '';
const categoryState = Astro.url.searchParams.get('category') ?? '';
const surfaceState = Astro.url.searchParams.get('surface') ?? '';
const referenceHref = localizePath('/guides/variables', lang);
---

<section class="vref" data-variables-reference data-initial-query={searchState} data-initial-category={categoryState} data-initial-surface={surfaceState}>
    <div class="vref__head">
        <p class="vref__eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p class="vref__lead">{copy.lead}</p>
    </div>

    <div class="vref__controls" role="search">
        <label class="vref__search">
            <span>{copy.searchLabel}</span>
            <input type="search" data-variable-search placeholder={copy.searchPlaceholder} value={searchState} autocomplete="off" />
        </label>
        <label>
            <span>{copy.categoryLabel}</span>
            <select data-variable-category>
                <option value="">{copy.allCategories}</option>
                {categories.map((category) => <option value={category} selected={category === categoryState}>{categoryNames[category] ?? category}</option>)}
            </select>
        </label>
        <label>
            <span>{copy.surfaceLabel}</span>
            <select data-variable-surface>
                <option value="">{copy.allSurfaces}</option>
                {surfaces.map(([id, label]) => <option value={id} selected={id === surfaceState}>{label}</option>)}
            </select>
        </label>
    </div>

    <p class="vref__count" data-variable-count aria-live="polite">{entries.length} {copy.showing}</p>

    <div class="vref__list" data-variable-list>
        {entries.map((entry) => (
            <article
                class="vref__entry"
                data-variable-entry
                data-category={entry.category}
                data-surfaces={entry.surfaceIds.join('|')}
                data-search={[entry.id, entry.syntax, ...entry.syntaxes, entry.example, ...entry.examples.flatMap((example) => [example.syntax, example.output]), ...entry.aliases, ...entry.aliasTokens, entry.name, entry.description, entry.category, categoryNames[entry.category] ?? '', ...entry.surfaces, entry.requirement, entry.payload].join(' ').toLocaleLowerCase()}
            >
                <header class="vref__entry-head">
                    <div>
                        <p class="vref__category">{categoryNames[entry.category] ?? entry.category}</p>
                        <h2>{entry.name}</h2>
                    </div>
                    <button class="vref__copy" type="button" data-copy-variable={entry.example} aria-label={`${copy.copy} ${entry.example}`}>
                        <span aria-hidden="true">⧉</span> {copy.copy}
                    </button>
                </header>

                <div class="vref__syntax-row">
                    <code>{entry.syntax}</code>
                    {entry.legacy && <span class="vref__legacy">{copy.legacy}</span>}
                </div>
                {entry.aliases.length + entry.aliasTokens.length > 0 && (
                    <p class="vref__aliases"><span>{copy.aliases}</span> {[...entry.aliases, ...entry.aliasTokens].map((alias) => <code>{alias}</code>)}</p>
                )}
                {entry.description && <p class="vref__description">{entry.description}</p>}

                <dl class="vref__details">
                    <div><dt>{copy.example}</dt><dd><code>{entry.example}</code></dd></div>
                    {entry.syntaxes.length > 1 && <div><dt>{copy.syntax}</dt><dd class="vref__forms">{entry.syntaxes.slice(1).map((syntax) => <code>{syntax}</code>)}</dd></div>}
                    {entry.output && <div><dt>{copy.result}</dt><dd>{entry.output}</dd></div>}
                    {entry.surfaces.length > 0 && <div><dt>{copy.available}</dt><dd class="vref__chips">{entry.surfaces.map((surface) => <span>{surface}</span>)}</dd></div>}
                    {entry.requirement && <div><dt>{copy.needs}</dt><dd>{entry.requirement}</dd></div>}
                    {entry.payload && <div><dt>{copy.payload}</dt><dd>{entry.payload}</dd></div>}
                    {entry.behavior && <div><dt>{copy.behavior}</dt><dd>{entry.behavior}</dd></div>}
                </dl>
            </article>
        ))}
    </div>

    <div class="vref__empty" data-variable-empty hidden>
        <p>{copy.empty}</p>
        <small>{copy.emptyHint}</small>
    </div>

    <p class="vref__back"><a href={localizePath('/guides', lang)}>← {lang === 'fr' ? 'Tous les guides' : 'All guides'}</a><span aria-hidden="true">·</span><a href={localizePath('/command-builder', lang)}>{lang === 'fr' ? 'Ouvrir le constructeur' : 'Open the builder'} →</a></p>

    <script type="application/json" data-variables-copy set:html={JSON.stringify({ ...copy, referenceHref })} />
</section>

<script>
    function initVariableReference(root: HTMLElement) {
        if (root.dataset.variablesReady === 'true') return;
        root.dataset.variablesReady = 'true';
        const search = root.querySelector<HTMLInputElement>('[data-variable-search]');
        const category = root.querySelector<HTMLSelectElement>('[data-variable-category]');
        const surface = root.querySelector<HTMLSelectElement>('[data-variable-surface]');
        const count = root.querySelector<HTMLElement>('[data-variable-count]');
        const empty = root.querySelector<HTMLElement>('[data-variable-empty]');
        const entries = [...root.querySelectorAll<HTMLElement>('[data-variable-entry]')];
        const copyText = JSON.parse(root.querySelector('[data-variables-copy]')?.textContent || '{}') as { showing?: string; copied?: string; copyFailed?: string };
        const initial = {
            q: root.dataset.initialQuery ?? '',
            category: root.dataset.initialCategory ?? '',
            surface: root.dataset.initialSurface ?? '',
        };

        if (search && !search.value) search.value = initial.q;
        if (category && initial.category) category.value = initial.category;
        if (surface && initial.surface) surface.value = initial.surface;

        const updateUrl = () => {
            const params = new URLSearchParams();
            if (search?.value.trim()) params.set('q', search.value.trim());
            if (category?.value) params.set('category', category.value);
            if (surface?.value) params.set('surface', surface.value);
            const query = params.toString();
            history.replaceState(null, '', `${location.pathname}${query ? `?${query}` : ''}${location.hash}`);
        };

        const filter = () => {
            const needle = search?.value.trim().toLocaleLowerCase() ?? '';
            const selectedCategory = category?.value ?? '';
            const selectedSurface = surface?.value ?? '';
            let visible = 0;
            for (const entry of entries) {
                const matches = (!needle || (entry.dataset.search ?? '').includes(needle))
                    && (!selectedCategory || entry.dataset.category === selectedCategory)
                    && (!selectedSurface || (entry.dataset.surfaces ?? '').split('|').includes(selectedSurface));
                entry.hidden = !matches;
                if (matches) visible++;
            }
            if (count) count.textContent = `${visible} ${copyText.showing ?? 'variables shown'}`;
            if (empty) empty.hidden = visible !== 0;
            updateUrl();
        };

        search?.addEventListener('input', filter);
        category?.addEventListener('change', filter);
        surface?.addEventListener('change', filter);
        window.addEventListener('popstate', () => {
            const params = new URLSearchParams(location.search);
            if (search) search.value = params.get('q') ?? '';
            if (category) category.value = params.get('category') ?? '';
            if (surface) surface.value = params.get('surface') ?? '';
            filter();
        });

        const copyValue = async (value: string) => {
            if (navigator.clipboard?.writeText) {
                await navigator.clipboard.writeText(value);
                return;
            }
            const fallback = document.createElement('textarea');
            fallback.value = value;
            fallback.setAttribute('readonly', '');
            fallback.style.position = 'fixed';
            fallback.style.opacity = '0';
            document.body.append(fallback);
            fallback.select();
            const copied = document.execCommand('copy');
            fallback.remove();
            if (!copied) throw new Error('Clipboard unavailable');
        };

        for (const button of root.querySelectorAll<HTMLButtonElement>('[data-copy-variable]')) {
            button.addEventListener('click', async () => {
                const value = button.dataset.copyVariable ?? '';
                try {
                    await copyValue(value);
                    const original = button.innerHTML;
                    button.textContent = copyText.copied ?? 'Copied';
                    window.setTimeout(() => { button.innerHTML = original; }, 1400);
                } catch {
                    button.textContent = copyText.copyFailed ?? 'Copy failed';
                    window.setTimeout(() => { button.textContent = copyText.copied ?? 'Copy'; }, 1400);
                }
            });
        }

        filter();
    }

    function bootVariableReferences() {
        document.querySelectorAll<HTMLElement>('[data-variables-reference]').forEach(initVariableReference);
    }
    bootVariableReferences();
    document.addEventListener('astro:page-load', bootVariableReferences);
</script>

<style>
    .vref {
        width: min(var(--content-max, 1200px), calc(100% - 48px));
        margin: 0 auto;
        padding: 76px 0 104px;
    }

    .vref__head { max-width: 720px; margin-bottom: 44px; }
    .vref__eyebrow, .vref__category, .vref__details dt, .vref__search > span, .vref__controls label > span {
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.67rem;
        letter-spacing: 0.15em;
        line-height: 1.4;
        text-transform: uppercase;
        color: var(--green-glow, #52b788);
    }
    .vref__head h1 {
        margin: 10px 0 14px;
        font-family: var(--font-display, "Syne", sans-serif);
        font-size: clamp(2.25rem, 6vw, 4.25rem);
        line-height: 0.98;
        letter-spacing: -0.045em;
        color: var(--white, #f0ece4);
    }
    .vref__lead { max-width: 58ch; color: var(--muted, #888077); font-size: 1.05rem; line-height: 1.7; }

    .vref__controls {
        display: grid;
        grid-template-columns: minmax(220px, 1.8fr) minmax(160px, 1fr) minmax(160px, 1fr);
        gap: 14px;
        padding: 18px;
        margin-bottom: 18px;
        border: 1px solid var(--border, rgba(201, 168, 124, 0.15));
        border-radius: var(--radius-md, 12px);
        background: rgba(255,255,255,0.018);
    }
    .vref__controls label { display: grid; gap: 8px; min-width: 0; }
    .vref__controls label > span { color: var(--muted, #888077); letter-spacing: 0.08em; }
    .vref__controls input, .vref__controls select {
        width: 100%; min-height: 42px; padding: 9px 12px;
        border: 1px solid rgba(201, 168, 124, 0.22); border-radius: var(--radius-sm, 8px);
        background: var(--black, #0a0a0a); color: var(--white, #f0ece4); outline: none;
    }
    .vref__controls input:focus, .vref__controls select:focus { border-color: var(--green-glow, #52b788); box-shadow: 0 0 0 3px rgba(82, 183, 136, 0.13); }
    .vref__count { margin: 0 0 14px; color: var(--muted, #888077); font-family: var(--font-mono, "DM Mono", monospace); font-size: 0.72rem; }

    .vref__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .vref__entry { min-width: 0; padding: 22px; border: 1px solid var(--border, rgba(201, 168, 124, 0.15)); border-radius: var(--radius-md, 12px); background: var(--card-bg, #111110); }
    .vref__entry[hidden] { display: none; }
    .vref__entry-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
    .vref__category { margin-bottom: 7px; color: var(--tan, #c9a87c); letter-spacing: 0.1em; }
    .vref__entry h2 { font-family: var(--font-display, "Syne", sans-serif); font-size: 1.25rem; line-height: 1.15; color: var(--white, #f0ece4); }
    .vref__copy { flex: 0 0 auto; padding: 6px 9px; border: 1px solid rgba(201, 168, 124, 0.22); border-radius: var(--radius-sm, 8px); color: var(--tan-light, #e0c49a); font-family: var(--font-mono, "DM Mono", monospace); font-size: 0.66rem; cursor: pointer; }
    .vref__copy:hover, .vref__copy:focus-visible { border-color: var(--green-glow, #52b788); color: var(--green-glow, #52b788); }
    .vref__syntax-row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin: 19px 0 10px; }
    .vref code { font-family: var(--font-mono, "DM Mono", monospace); font-size: 0.79rem; color: var(--tan-light, #e0c49a); overflow-wrap: anywhere; }
    .vref__syntax-row code { padding: 6px 9px; border-radius: var(--radius-xs, 4px); background: rgba(82, 183, 136, 0.08); color: var(--green-glow, #52b788); }
    .vref__legacy { padding: 3px 7px; border: 1px solid rgba(201, 168, 124, 0.18); border-radius: var(--radius-pill, 999px); color: var(--muted, #888077); font-size: 0.67rem; }
    .vref__aliases { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-bottom: 14px; color: var(--muted, #888077); font-size: 0.78rem; }
    .vref__aliases span { font-family: var(--font-mono, "DM Mono", monospace); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; }
    .vref__aliases code { color: var(--muted, #888077); }
    .vref__description { margin-bottom: 18px; color: #b4ada3; line-height: 1.6; font-size: 0.93rem; }
    .vref__details { display: grid; gap: 10px; }
    .vref__details > div { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 10px; align-items: baseline; }
    .vref__details dt { color: var(--muted, #888077); font-size: 0.58rem; letter-spacing: 0.08em; }
    .vref__details dd { min-width: 0; color: #b4ada3; font-size: 0.84rem; line-height: 1.5; }
    .vref__details dd code { display: inline-block; max-width: 100%; padding: 3px 5px; background: rgba(255,255,255,0.035); }
    .vref__forms { display: flex; flex-wrap: wrap; gap: 6px; }
    .vref__chips { display: flex; flex-wrap: wrap; gap: 5px; }
    .vref__chips span { padding: 3px 7px; border: 1px solid rgba(201, 168, 124, 0.16); border-radius: var(--radius-pill, 999px); font-size: 0.71rem; color: var(--tan-light, #e0c49a); }
    .vref__empty { padding: 48px 20px; border: 1px dashed rgba(201, 168, 124, 0.24); border-radius: var(--radius-md, 12px); text-align: center; }
    .vref__empty p { color: var(--white, #f0ece4); margin-bottom: 8px; }
    .vref__empty small { color: var(--muted, #888077); }
    .vref__back { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 38px; color: var(--muted, #888077); font-family: var(--font-mono, "DM Mono", monospace); font-size: 0.72rem; }
    .vref__back a { color: var(--tan-light, #e0c49a); }
    .vref__back a:hover, .vref__back a:focus-visible { color: var(--green-glow, #52b788); }

    @media (max-width: 780px) {
        .vref__controls, .vref__list { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
        .vref { width: calc(100% - 32px); padding-top: 48px; }
        .vref__controls { padding: 14px; }
        .vref__entry { padding: 18px; }
    }
</style>
