import Badge from '@bagel/ui/astro/Badge.astro';
import Card from '@bagel/ui/astro/Card.astro';
import Chip from '@bagel/ui/astro/Chip.astro';
import Disclosure from '@bagel/ui/astro/Disclosure.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Label from '@bagel/ui/astro/Label.astro';
import SearchInput from '@bagel/ui/astro/SearchInput.astro';
import Text from '@bagel/ui/astro/Text.astro';

interface Module {
    name: string;
    tagline: string;
    cat: string;
    plan?: 'free' | 'premium';
    start?: string;
    needs?: string;
    commands?: string;
}

interface Props {
    labels?: Record<string, string>;
    props?: Record<string, unknown>;
}

const { labels = {}, props = {} } = Astro.props;
const L = {
    all: 'All',
    searchLabel: 'Filter modules',
    searchPlaceholder: 'Name, command, or what it does',
    countAll: '{n} modules',
    countCat: '{n} in {cat}',
    countMatch: '{shown} of {total}',
    commands: 'Commands',
    needs: 'Needs',
    free: 'Free',
    premium: 'Premium beta',
    empty: 'Nothing matches that. Try a command like !sr, or a game name.',
    ...labels,
};

const categories = Array.isArray(props.categories) ? (props.categories as string[]) : [];
const modules = Array.isArray(props.modules) ? (props.modules as Module[]) : [];
const total = String(modules.length);
const haystack = (m: Module) => `${m.name} ${m.tagline} ${m.commands ?? ''}`.toLowerCase();
const planTone = (m: Module) => (m.plan === 'premium' ? 'paid' : 'free');
---

<div class="mcat" data-mcat data-count-all={L.countAll} data-count-cat={L.countCat} data-count-match={L.countMatch}>
    <div class="mcat__bar" data-mcat-bar hidden>
        <div class="mcat__chips" role="group" aria-label={L.searchLabel}>
            <Chip tone="muted" on data-mcat-chip="" aria-pressed="true">{L.all}</Chip>
            {categories.map((cat, i) => (
                <Chip tone="muted" data-mcat-chip={String(i)} aria-pressed="false">{cat}</Chip>
            ))}
        </div>
        <div class="mcat__search">
            <SearchInput fill placeholder={L.searchPlaceholder} aria-label={L.searchLabel} data-mcat-input />
        </div>
    </div>
    <Label mono as="span" data-mcat-count aria-live="polite">{L.countAll.replace('{n}', total)}</Label>
    <ul class="mcat__grid">
        {modules.map((m) => (
            <Card as="li" flush class="mcat__cell" data-cat={String(categories.indexOf(m.cat))} data-hay={haystack(m)}>
                <div class="mcat__inner">
                    <Heading level={6} as="span">{m.name}</Heading>
                    <span class="mcat__tags">
                        <Badge shape="pill" tone="neutral">{m.cat}</Badge>
                        <Badge shape="pill" tone={planTone(m)}>{m.plan === 'premium' ? L.premium : L.free}</Badge>
                        {m.start && <Badge shape="pill" tone="neutral">{m.start}</Badge>}
                    </span>
                    <Text size="sm" tone="muted-light">{m.tagline}</Text>
                    {m.needs && <Text size="xs" tone="muted"><Text as="span" size="xs" tone="accent">{L.needs}</Text> {m.needs}</Text>}
                    {m.commands && (
                        <Disclosure size="sm" summary={L.commands}>
                            <Text size="xs" mono tone="accent" class="mcat__cmds-list">{m.commands}</Text>
                        </Disclosure>
                    )}
                </div>
            </Card>
        ))}
    </ul>
    <Text size="sm" tone="muted" data-mcat-empty hidden>{L.empty}</Text>
</div>

<style>
    .mcat { margin: 24px 0; display: grid; gap: 14px; }

    .mcat__bar { display: grid; gap: 12px; }

    .mcat__chips { display: flex; flex-wrap: wrap; gap: 8px; }

    .mcat__search { max-width: 340px; }

    .mcat__grid {
        list-style: none; margin: 0; padding: 0; display: grid; gap: 10px;
        grid-template-columns: repeat(auto-fill, minmax(268px, 1fr));
    }

    .mcat__cell[hidden] { display: none; }

    .mcat__inner { display: grid; gap: 7px; align-content: start; padding: 15px 16px; }

    .mcat__tags { display: flex; flex-wrap: wrap; gap: 6px; }


    .mcat__cmds-list { overflow-wrap: anywhere; }

    .mcat__cell.is-shown { animation: mcat-in var(--bb-dur-fast) var(--bb-ease-out-expo) both; }

    @keyframes mcat-in {
        from { opacity: 0; transform: translateX(12px); }
        to { opacity: 1; transform: none; }
    }

    @media (prefers-reduced-motion: reduce) {
        .mcat__cell.is-shown { animation: none; }
    }
</style>

<script>
    import { bindOnce } from '../../../script/bind';

    function fill(tpl: string, values: Record<string, string>): string {
        return tpl.replace(/\{(\w+)\}/g, (_, key) => values[key] ?? '');
    }

    function replayEntrance(cell: HTMLElement) {
        cell.classList.remove('is-shown');
        void cell.offsetWidth;
        cell.classList.add('is-shown');
    }

    function showCell(cell: HTMLElement, visible: boolean) {
        if (visible && cell.hidden) replayEntrance(cell);
        cell.hidden = !visible;
    }

    function setupCatalog(root: HTMLElement) {
        const bar = root.querySelector<HTMLElement>('[data-mcat-bar]');
        const input = root.querySelector<HTMLInputElement>('[data-mcat-input]');
        const countEl = root.querySelector<HTMLElement>('[data-mcat-count]');
        const emptyEl = root.querySelector<HTMLElement>('[data-mcat-empty]');
        const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mcat-chip]'));
        const cells = Array.from(root.querySelectorAll<HTMLElement>('.mcat__cell'));
        const total = String(cells.length);
        let cat = '';

        function matches(cell: HTMLElement, query: string): boolean {
            const okCat = cat === '' || cell.dataset.cat === cat;
            return okCat && (cell.dataset.hay ?? '').includes(query);
        }

        function countText(query: string, shown: number): string {
            const label = chips.find((c) => c.dataset.mcatChip === cat)?.textContent ?? '';
            if (query !== '') return fill(root.dataset.countMatch ?? '', { shown: String(shown), total });
            if (cat !== '') return fill(root.dataset.countCat ?? '', { n: String(shown), cat: label });
            return fill(root.dataset.countAll ?? '', { n: total });
        }

        function apply() {
            const query = (input?.value ?? '').trim().toLowerCase();
            const visible = cells.filter((cell) => matches(cell, query));
            cells.forEach((cell) => showCell(cell, visible.includes(cell)));
            if (emptyEl) emptyEl.hidden = visible.length > 0;
            if (countEl) countEl.textContent = countText(query, visible.length);
        }

        chips.forEach((chip) => {
            chip.addEventListener('click', () => {
                cat = chip.dataset.mcatChip ?? '';
                chips.forEach((other) => {
                    const on = other === chip;
                    other.toggleAttribute('data-on', on);
                    other.setAttribute('aria-pressed', on ? 'true' : 'false');
                });
                apply();
            });
        });

        input?.addEventListener('input', apply);
        if (bar) bar.hidden = false;
    }

    bindOnce('[data-mcat]', setupCatalog);
</script>
