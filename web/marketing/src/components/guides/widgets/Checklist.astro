import ClientProps from '@bagel/kit/components/ClientProps.astro';
import Button from '@bagel/ui/astro/Button.astro';
import Card from '@bagel/ui/astro/Card.astro';
import Checkbox from '@bagel/ui/astro/Checkbox.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Text from '@bagel/ui/astro/Text.astro';

interface Props {
    labels?: Record<string, string>;
    props?: Record<string, unknown>;
}

const { labels = {}, props = {} } = Astro.props;
const L = {
    heading: 'Your checklist',
    reset: 'Clear',
    ...labels,
};
const items = Array.isArray(props.items) ? (props.items as string[]) : [];
const storageKey = typeof props.storageKey === 'string' ? props.storageKey : 'guides.checklist';
---

<Card flush class="gcheck-card">
    <div class="gcheck" >
        <ClientProps value={{ storageKey }} />
        <div class="gcheck__head">
            <Heading level={6} as="span">{L.heading}</Heading>
            <Button class="gcheck-reset" variant="ghost" size="sm">{L.reset}</Button>
        </div>
        <ul class="gcheck__list">
            {items.map((item, i) => (
                <li class="gcheck__row">
                    <Checkbox value={String(i)}><Text as="span" tone="muted-light" class="gcheck__label"><Fragment set:html={item} /></Text></Checkbox>
                </li>
            ))}
        </ul>
    </div>
</Card>

<style>
    .gcheck-card { margin: 22px 0; }

    .gcheck {
        display: grid;
        gap: 10px;
        padding: 15px 16px;
    }

    .gcheck__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .gcheck__list { list-style: none; display: grid; gap: 8px; margin: 0; padding: 0; }

    .gcheck__row:has(:checked) .gcheck__label { color: var(--bb-muted); text-decoration: line-through; }
</style>

<script>
    import { readClientProps } from '@bagel/kit/client-props';
    import { bindOnce } from '../../../script/bind';

    function setupChecklist(root: HTMLElement) {
        const { storageKey: key } = readClientProps<{ storageKey: string }>(root);
        const boxes = Array.from(root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));

        function read(): string[] {
            try {
                const raw = window.localStorage.getItem(key);
                const parsed = raw ? JSON.parse(raw) : [];
                return Array.isArray(parsed) ? parsed.map(String) : [];
            } catch {
                return [];
            }
        }

        function write(ticked: string[]) {
            try {
                window.localStorage.setItem(key, JSON.stringify(ticked));
            } catch {
            }
        }

        const ticked = new Set(read());
        boxes.forEach((box) => {
            box.checked = ticked.has(box.value);
            box.addEventListener('change', () => {
                const id = box.value;
                if (box.checked) ticked.add(id);
                else ticked.delete(id);
                write(Array.from(ticked));
            });
        });

        root.querySelector<HTMLButtonElement>('.gcheck-reset')?.addEventListener('click', () => {
            ticked.clear();
            boxes.forEach((box) => { box.checked = false; });
            write([]);
        });
    }

    bindOnce('.gcheck', setupChecklist);
</script>
