import Card from '@bagel/ui/astro/Card.astro';
import Fact from '@bagel/ui/astro/Fact.astro';
import FactList from '@bagel/ui/astro/FactList.astro';
import Label from '@bagel/ui/astro/Label.astro';
import SegmentedControl from '@bagel/ui/astro/SegmentedControl.astro';
import Slider from '@bagel/ui/astro/Slider.astro';
import Text from '@bagel/ui/astro/Text.astro';

interface Props {
    labels?: Record<string, string>;
    props?: Record<string, unknown>;
}

const { labels = {}, props = {} } = Astro.props;
const L = {
    runsLabel: 'Viewers run the command',
    runsUnit: 'times per minute',
    sourcesLabel: 'Data sources your commands quote',
    fetchesLabel: 'Requests your API actually receives',
    fetchesUnit: 'per minute',
    cachedLabel: 'Answered from the 30-second cache',
    blockedLabel: 'Refused by the 6 per minute channel cap',
    blockedLine: 'Those runs print [source unavailable] in chat.',
    why: 'The cache is there for your API key. Your quota, and every other channel pointed at the same host, would burn out in an evening otherwise.',
    ...labels,
};
const runs = typeof props.runs === 'number' ? props.runs : 12;
const sources = 1;
const perDefinition = Math.min(runs, 2);
const wanted = perDefinition * sources;
const made = Math.min(wanted, 6);
const sourceOptions = ['1', '2', '3', '4'];
---

<Card flush class="gbudget-card">
    <div class="gbudget" data-fetchbudget>
        <div class="gbudget__controls">
            <label class="gbudget__field">
                <Label mono as="span">{L.runsLabel}</Label>
                <Slider min={1} max={60} value={runs} data-fb-runs />
                <output><Text as="span" size="sm" data-fb-runs-out>{`${runs} ${L.runsUnit}`}</Text></output>
            </label>
            <fieldset class="gbudget__field">
                <Label mono as="legend">{L.sourcesLabel}</Label>
                <SegmentedControl options={sourceOptions} value={String(sources)} label={L.sourcesLabel} data-fb-sources />
            </fieldset>
        </div>
        <div class="gbudget__readout" aria-live="polite">
            <FactList>
                <Fact term={L.fetchesLabel}><span data-fb-made>{made}</span> {L.fetchesUnit}</Fact>
                <Fact term={L.cachedLabel}><span data-fb-cached>{runs * sources - wanted}</span> {L.fetchesUnit}</Fact>
                <Fact term={L.blockedLabel}><span data-fb-blocked>{wanted - made}</span> {L.fetchesUnit}</Fact>
            </FactList>
        </div>
        <Text size="sm" tone="muted-light" data-fb-blocked-line hidden={wanted <= 6}>{L.blockedLine}</Text>
        <Text size="sm" tone="muted-light">{L.why}</Text>
    </div>
</Card>

<style>
    .gbudget-card { margin: 22px 0; }
    .gbudget { display: grid; gap: 14px; padding: 15px 16px; }
    .gbudget__controls { display: grid; gap: 14px; }
    @media (min-width: 720px) { .gbudget__controls { grid-template-columns: 1.4fr 1fr; align-items: start; } }
    .gbudget__field { display: grid; gap: 7px; margin: 0; padding: 0; border: 0; min-width: 0; }
    .gbudget__readout { padding: 11px 12px; border: 1px solid var(--bb-border); border-radius: var(--bb-radius-sm); background: var(--bb-inset-bg); }
</style>

<script>
    import { bindOnce } from '../../../script/bind';

    const CACHE_CEILING = 2;
    const CHANNEL_CAP = 6;

    function chosenSources(group: HTMLElement): number {
        return Number(group.querySelector<HTMLButtonElement>('[aria-checked="true"]')?.value || 1);
    }

    function setupFetchBudget(root: HTMLElement) {
        const runsInput = root.querySelector<HTMLInputElement>('[data-fb-runs]')!;
        const runsOut = root.querySelector<HTMLElement>('[data-fb-runs-out]')!;
        const unit = runsOut.textContent!.replace(/^\s*\d+\s*/, '');
        const sourceGroup = root.querySelector<HTMLElement>('[data-fb-sources]')!;
        const made = root.querySelector<HTMLElement>('[data-fb-made]')!;
        const cached = root.querySelector<HTMLElement>('[data-fb-cached]')!;
        const blocked = root.querySelector<HTMLElement>('[data-fb-blocked]')!;
        const blockedLine = root.querySelector<HTMLElement>('[data-fb-blocked-line]')!;
        let sources = chosenSources(sourceGroup);

        function update() {
            const runs = Number(runsInput.value);
            const wanted = Math.min(runs, CACHE_CEILING) * sources;
            const actual = Math.min(wanted, CHANNEL_CAP);
            runsOut.textContent = `${runs} ${unit}`;
            made.textContent = String(actual);
            cached.textContent = String(runs * sources - wanted);
            blocked.textContent = String(wanted - actual);
            blockedLine.hidden = wanted <= CHANNEL_CAP;
        }

        function pickSources(event: MouseEvent) {
            const chosen = (event.target as Element).closest<HTMLButtonElement>('button[role="radio"]');
            if (!chosen) return;
            sources = Number(chosen.value || 1);
            update();
        }

        runsInput.addEventListener('input', update);
        sourceGroup.addEventListener('click', pickSources);
        update();
    }

    bindOnce('[data-fetchbudget]', setupFetchBudget);
</script>
