import ClientProps from '@bagel/kit/components/ClientProps.astro';
import Button from '@bagel/ui/astro/Button.astro';
import Label from '@bagel/ui/astro/Label.astro';
import ChatWindow from '../ChatWindow.astro';

interface Props {
    labels?: Record<string, string>;
    props?: Record<string, unknown>;
}

const { labels = {}, props = {} } = Astro.props;
const L = {
    heading: 'Try it: bump the counter',
    windowTitle: '#your_channel',
    modName: 'Ayshacinder',
    addOne: '!death',
    subOne: '!death -1',
    addFive: '!death 5',
    viewerName: 'SnackPackPanda',
    viewerCommand: '!deaths',
    viewerReplyTemplate: 'Oh no, {value} deaths so far.',
    modReplyTemplate: 'The boss wins again.',
    ...labels,
};
const start = typeof props.start === 'number' ? props.start : 12;
const withStart = (template: string) => template.replace('{value}', String(start));
const lines = [
    { who: 'mod' as const, name: L.modName, text: L.addOne, hook: 'mod-cmd' },
    { who: 'bot' as const, text: withStart(L.modReplyTemplate), hook: 'mod-reply' },
    { who: 'viewer' as const, name: L.viewerName, text: L.viewerCommand },
    { who: 'bot' as const, text: withStart(L.viewerReplyTemplate), hook: 'token-reply' },
];
const actions = [
    { kind: 'add', command: L.addOne },
    { kind: 'sub', command: L.subOne },
    { kind: 'add5', command: L.addFive },
];
---

<div class="gcplay">
    <ClientProps value={{ start, modTemplate: L.modReplyTemplate, tokenTemplate: L.viewerReplyTemplate, actions }} />
    <Label mono as="span" class="gcplay__heading">{L.heading}</Label>
    <ChatWindow title={L.windowTitle} label={L.windowTitle} lines={lines} />
    <div class="gcplay__row">
        {actions.map((action) => (
            <Button variant="secondary" size="sm" class="gcplay__action">{action.command}</Button>
        ))}
    </div>
</div>

<style>
    .gcplay { margin: 20px 0 26px; }

    .gcplay__heading { margin-bottom: 10px; }

    .gcplay__row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
</style>

<script>
    import { readClientProps } from '@bagel/kit/client-props';
    import { bindOnce } from '../../../script/bind';

    const STEP: Record<string, (value: number) => number> = {
        add: (value) => value + 1,
        sub: (value) => value - 1,
        add5: (value) => value + 5,
    };

    function swap(el: HTMLElement | null, text: string) {
        if (!el) return;
        el.classList.add('is-swapping');
        window.setTimeout(() => {
            el.textContent = text;
            el.classList.remove('is-swapping');
        }, 120);
    }

    function setupCounterPlay(root: HTMLElement) {
        const { start, modTemplate: modReplyTemplate, tokenTemplate: tokenReplyTemplate, actions } = readClientProps<{ start: number; modTemplate: string; tokenTemplate: string; actions: { kind: string; command: string }[] }>(root);
        let value = Number.isFinite(start) ? start : 0;

        const line = (hook: string) => root.querySelector<HTMLElement>(`.chat-line--${hook}`);
        const modCmd = line('mod-cmd');
        const modReply = line('mod-reply');
        const tokenReply = line('token-reply');

        root.querySelectorAll<HTMLButtonElement>('.gcplay__action').forEach((btn, index) => {
            const step = STEP[actions[index].kind] ?? ((current: number) => current);
            const command = actions[index].command;
            btn.addEventListener('click', () => {
                value = step(value);
                swap(modCmd, command);
                swap(modReply, modReplyTemplate.replace('{value}', String(value)));
                swap(tokenReply, tokenReplyTemplate.replace('{value}', String(value)));
            });
        });
    }

    bindOnce('.gcplay', setupCounterPlay);
</script>
