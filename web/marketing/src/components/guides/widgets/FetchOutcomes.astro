import Card from '@bagel/ui/astro/Card.astro';
import SegmentedControl from '@bagel/ui/astro/SegmentedControl.astro';
import Text from '@bagel/ui/astro/Text.astro';

interface Outcome {
    id: string;
    label: string;
    bot: string;
    why: string;
}

interface Props {
    labels?: Record<string, string>;
    props?: Record<string, unknown>;
}

const { labels = {}, props = {} } = Astro.props;
const L = {
    legend: 'Pick what went wrong',
    title: '#your_channel',
    viewer: 'sesame_sam',
    viewerText: '!weather',
    botName: 'ItsBagelBot',
    ...labels,
};
const outcomes = (Array.isArray(props.outcomes) ? props.outcomes : []) as Outcome[];
const options = outcomes.map((outcome) => ({
    value: outcome.id,
    label: outcome.label,
    attrs: {
        'data-go-tab': outcome.id,
        'data-go-bot': outcome.bot,
        'aria-controls': `gout-why-${outcome.id}`,
    },
}));
---

<Card flush class="gout-card">
    <div class="gout" data-fetchoutcomes>
        <SegmentedControl options={options} value={outcomes[0]?.id} label={L.legend} data-go-tabs />
        <div class="gout__win">
            <div class="gout__bar"><span>{L.title}</span></div>
            <div class="gout__feed">
                <p class="gout__msg"><b class="gout__viewer">{L.viewer}</b><span class="gout__line">{L.viewerText}</span></p>
                <p class="gout__msg"><b class="gout__bot">{L.botName}</b><span class="gout__line" data-go-line>{outcomes[0]?.bot}</span></p>
            </div>
        </div>
        <div aria-live="polite">
            {outcomes.map((outcome, i) => (
                <Text size="sm" tone="muted-light" id={`gout-why-${outcome.id}`} data-go-why={outcome.id} data-go-bot={outcome.bot} hidden={i !== 0}>
                    {outcome.why}
                </Text>
            ))}
        </div>
    </div>
</Card>

<style>
    .gout-card { margin: 22px 0; }
    .gout { display: grid; gap: 12px; padding: 15px 16px; min-width: 0; }
    .gout__win { border: 1px solid var(--bb-border); border-radius: var(--bb-radius-sm); background: rgba(var(--bb-black-rgb), 0.7); overflow: hidden; }
    .gout__bar { padding: 7px 11px; border-bottom: 1px solid var(--bb-border); font-family: var(--bb-font-mono); font-size: 0.62rem; color: var(--bb-muted); }
    .gout__feed { display: grid; gap: 7px; padding: 11px; }
    .gout__msg { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; font-family: var(--bb-font-body); font-size: 0.86rem; line-height: 1.5; color: rgba(var(--bb-white-rgb), 0.85); }
    .gout__viewer, .gout__bot { font-weight: 600; }
    .gout__viewer { color: var(--bb-tan-light); }
    .gout__bot { color: var(--bb-green-glow); }
    .gout__line { font-family: var(--bb-font-mono); font-size: var(--bb-text-sm); }
    .gout__line.is-new { animation: gout-slide var(--bb-dur-fast) var(--bb-ease-out-expo); }

    @keyframes gout-slide { from { opacity: 0; transform: translateX(12px); } to { opacity: 1; transform: none; } }

    @media (prefers-reduced-motion: reduce) {
        .gout__line.is-new { animation: none; }
    }
</style>

<script>
    import { bindOnce } from '../../../script/bind';

    function replay(line: HTMLElement) {
        line.classList.remove('is-new');
        void line.offsetWidth;
        line.classList.add('is-new');
    }

    function setupFetchOutcomes(root: HTMLElement) {
        const group = root.querySelector<HTMLElement>('[data-go-tabs]')!;
        const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('button[role="radio"]'));
        const line = root.querySelector<HTMLElement>('[data-go-line]')!;
        const whys = Array.from(root.querySelectorAll<HTMLElement>('[data-go-why]'));

        function select(index: number) {
            whys.forEach((why, i) => { why.hidden = i !== index; });
            line.textContent = whys[index]?.dataset.goBot ?? line.textContent;
            replay(line);
        }

        group.addEventListener('click', (event) => {
            const chosen = (event.target as Element).closest<HTMLButtonElement>('button[role="radio"]');
            if (chosen) select(buttons.indexOf(chosen));
        });
    }

    bindOnce('[data-fetchoutcomes]', setupFetchOutcomes);
</script>
