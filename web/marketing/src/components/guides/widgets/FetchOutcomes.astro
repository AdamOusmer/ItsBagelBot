import Card from '@bagel/ui/astro/Card.astro';
import ChatPreview from '@bagel/ui/astro/ChatPreview.astro';
import SegmentedControl from '@bagel/ui/astro/SegmentedControl.astro';
import Text from '@bagel/ui/astro/Text.astro';
import ChatLines from '../ChatLines.astro';

interface Outcome {
    id: string;
    label: string;
    bot: string;
    why: string;
}

interface Props {
    labels?: Record<string, string>;
    props?: Record<string, unknown>;
}

const { labels = {}, props = {} } = Astro.props;
const L = {
    legend: 'Pick what went wrong',
    title: '#your_channel',
    viewer: 'PrincessBarney',
    viewerText: '!weather',
    botName: 'ItsBagelBot',
    ...labels,
};
const outcomes = (Array.isArray(props.outcomes) ? props.outcomes : []) as Outcome[];
const options = outcomes.map((outcome) => ({
    value: outcome.id,
    label: outcome.label,
    attrs: {
        'data-go-tab': outcome.id,
        'data-go-bot': outcome.bot,
        'aria-controls': `gout-why-${outcome.id}`,
    },
}));
---

<Card flush class="gout-card">
    <div class="gout" data-fetchoutcomes>
        <SegmentedControl options={options} value={outcomes[0]?.id} label={L.legend} data-go-tabs />
        <ChatPreview title={L.title}>
            <ChatLines
                lines={[
                    { who: 'viewer', name: L.viewer, text: L.viewerText },
                    { who: 'bot', name: L.botName, text: outcomes[0]?.bot ?? '', hook: 'go-line' },
                ]}
            />
        </ChatPreview>
        <div aria-live="polite">
            {outcomes.map((outcome, i) => (
                <Text size="sm" tone="muted-light" id={`gout-why-${outcome.id}`} data-go-why={outcome.id} data-go-bot={outcome.bot} hidden={i !== 0}>
                    {outcome.why}
                </Text>
            ))}
        </div>
    </div>
</Card>

<style>
    .gout-card { margin: 22px 0; }
    .gout { display: grid; gap: 12px; padding: 15px 16px; }
</style>

<script>
    import { bindOnce } from '../../../script/bind';

    function replay(line: HTMLElement) {
        line.classList.remove('bb-chat__reply');
        void line.offsetWidth;
        line.classList.add('bb-chat__reply');
    }

    function setupFetchOutcomes(root: HTMLElement) {
        const group = root.querySelector<HTMLElement>('[data-go-tabs]')!;
        const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('button[role="radio"]'));
        const line = root.querySelector<HTMLElement>('[data-chat-hook="go-line"]')!;
        const whys = Array.from(root.querySelectorAll<HTMLElement>('[data-go-why]'));

        function select(index: number) {
            whys.forEach((why, i) => { why.hidden = i !== index; });
            line.textContent = whys[index]?.dataset.goBot ?? line.textContent;
            replay(line);
        }

        group.addEventListener('click', (event) => {
            const chosen = (event.target as Element).closest<HTMLButtonElement>('button[role="radio"]');
            if (chosen) select(buttons.indexOf(chosen));
        });
    }

    bindOnce('[data-fetchoutcomes]', setupFetchOutcomes);
</script>
