import AlertBanner from '@bagel/ui/astro/AlertBanner.astro';
import Card from '@bagel/ui/astro/Card.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Label from '@bagel/ui/astro/Label.astro';
import SectionNav from '@bagel/ui/astro/SectionNav.astro';
import Tag from '@bagel/ui/astro/Tag.astro';
import Text from '@bagel/ui/astro/Text.astro';
import TextLink from '@bagel/ui/astro/TextLink.astro';
import GuideBody from './GuideBody.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';
import type { Block } from '../../lib/guides/types';

interface Section {
    id: string;
    heading: string;
    note?: string;
    blocks: Block[];
}

interface Pager {
    href: string;
    label: string;
}

interface Props {
    sections: Section[];
    minutes?: string;
    prev?: Pager;
    next?: Pager;
}

const { sections, minutes, prev, next } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const labels = {
    toc: t('guide.toc'),
    glance: t('guide.glance'),
    hub: t('guide.hub'),
    prev: t('guide.prevLabel'),
    next: t('guide.nextLabel'),
};
const hubHref = localizePath('/guides', lang);
const tocItems = sections.map((section) => ({
    href: `#${section.id}`,
    label: section.heading,
    attrs: { 'data-guide-link': section.id },
}));
const ordinal = (position: number) => String(position + 1).padStart(2, '0');
---

<div class="gshell">
    <div class="gshell__grid">
        <div class="gshell__toc">
            <TextLink class="gshell__hub" href={hubHref} label={labels.hub} size="0.7rem" />
            <Label mono as="span" class="gshell__toc-label">{labels.toc}</Label>
            <SectionNav variant="toc" index label={labels.toc} items={tocItems} data-guide-toc />
        </div>

        <article class="gshell__content">
            <div class="gshell__meta" data-reveal>
                <TextLink class="gshell__hub gshell__hub--inline" href={hubHref} label={labels.hub} size="0.7rem" />
                {minutes && <Text as="span" size="xs" mono tone="positive" class="gshell__minutes">{minutes}</Text>}
            </div>

            {sections.map((section, i) => (
                <section class="gshell__block" id={section.id} data-guide-section data-reveal style={`--reveal-i: ${Math.min(i + 1, 6)}`}>
                    <Heading level={3} as="h2" class="gshell__heading"><Text as="span" size="xs" mono tone="positive" class="gshell__num">{ordinal(i)}</Text>{section.heading}</Heading>
                    {section.note && (
                        <AlertBanner variant="positive" callout role="note" class="gshell__glance"><Tag tone="live" bare class="gshell__glance-tag">{labels.glance}</Tag>{section.note}</AlertBanner>
                    )}
                    <GuideBody blocks={section.blocks} />
                </section>
            ))}

            {(prev || next) && (
                <nav class="gshell__pager" aria-label={labels.next}>
                    {prev ? (
                        <Card as="a" href={prev.href} hover flush class="gshell__pager-card">
                            <span class="gshell__pager-body">
                                <Label mono as="span">{labels.prev}</Label>
                                <Heading level={5} as="span">{prev.label}</Heading>
                            </span>
                        </Card>
                    ) : <span />}
                    {next && (
                        <Card as="a" href={next.href} hover flush class="gshell__pager-card gshell__pager-card--next">
                            <span class="gshell__pager-body">
                                <Label mono as="span">{labels.next}</Label>
                                <Heading level={5} as="span">{next.label}</Heading>
                            </span>
                        </Card>
                    )}
                </nav>
            )}
        </article>
    </div>
</div>

<style>
    .gshell {
        max-width: var(--bb-content-max);
        margin: 0 auto;
        padding: 0 24px 96px;
    }

    .gshell__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 48px;
    }

    @media (min-width: 980px) {
        .gshell__grid {
            grid-template-columns: 240px minmax(0, 1fr);
            gap: 72px;
        }
    }

    .gshell__toc { display: none; }

    @media (min-width: 980px) {
        .gshell__toc {
            display: flex;
            flex-direction: column;
            position: sticky;
            top: calc(var(--nav-offset) + 32px);
            align-self: start;
        }
    }

    .gshell__hub { margin-bottom: 26px; }

    .gshell__toc-label { margin-bottom: 16px; }

    .gshell__content { max-width: 780px; min-width: 0; }

    .gshell__meta {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 44px;
    }

    .gshell__hub--inline { margin-bottom: 0; }

    @media (min-width: 980px) {
        .gshell__hub--inline { display: none; }
    }

    .gshell__minutes { letter-spacing: 0.08em; }

    .gshell__block {
        max-width: var(--bb-content-max);
        margin: 0 auto;
        padding: 100px 48px;
        scroll-margin-top: calc(var(--nav-offset) + 24px);
    }

    .gshell__heading { margin: 60px 0 14px; }

    .gshell__block:first-of-type .gshell__heading { margin-top: 0; }

    .gshell__num {
        margin-right: 12px;
        letter-spacing: 0.1em;
    }

    .gshell__glance { margin: 0 0 18px; }

    .gshell__glance-tag { margin-right: 8px; }

    .gshell__block :global(p:not([class])),
    .gshell__block :global(ul:not([class])),
    .gshell__block :global(ol:not([class])) {
        font-family: var(--bb-font-body);
        font-size: 1.05rem;
        color: var(--bb-muted-soft);
        line-height: 1.85;
        margin-bottom: 16px;
    }

    .gshell__block :global(ul:not([class])),
    .gshell__block :global(ol:not([class])) { padding-left: 1.4em; }
    .gshell__block :global(ul:not([class])) { list-style-type: disc; }
    .gshell__block :global(ul:not([class]) li),
    .gshell__block :global(ol:not([class]) li) { margin-bottom: 7px; }
    .gshell__block :global(ul:not([class]) li::marker),
    .gshell__block :global(ol:not([class]) li::marker) { color: var(--bb-green-glow); }

    .gshell__block :global(h3:not([class])) {
        font-family: var(--bb-font-display);
        font-size: 1.12rem;
        font-weight: 700;
        color: var(--bb-white);
        margin: 30px 0 10px;
    }

    .gshell__block :global(a:not([class])) {
        color: var(--bb-tan);
        background-image: linear-gradient(
            90deg,
            rgba(var(--bb-tan-rgb), 0.75),
            rgba(var(--bb-green-glow-rgb), 0.55)
        );
        background-repeat: no-repeat;
        background-position: 0 100%;
        background-size: 0% 1px;
        padding-bottom: 1px;
        transition: color var(--bb-dur-fast) ease, background-size var(--bb-dur-base) var(--bb-ease-out-expo);
    }

    .gshell__block :global(a:not([class]):hover) {
        color: var(--bb-tan-light);
        background-size: 100% 1px;
    }

    .gshell__block :global(code:not([class])) {
        font-family: var(--bb-font-mono);
        font-size: 0.82em;
        color: var(--bb-tan-light);
        background: rgba(var(--bb-tan-rgb), 0.08);
        border: 1px solid rgba(var(--bb-tan-rgb), 0.14);
        border-radius: var(--bb-radius-xs);
        padding: 2px 6px;
        white-space: nowrap;
    }

    .gshell__pager {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-top: 72px;
    }

    .gshell__pager-body {
        display: flex;
        flex-direction: column;
        gap: 7px;
        padding: 18px 20px;
    }

    .gshell__pager-card--next { text-align: right; }

    @media (prefers-reduced-motion: reduce) {
        .gshell__block :global(a:not([class])) { transition: none; }
    }

    @media (max-width: 640px) {
        .gshell { padding: 0 16px 72px; }
        .gshell__heading { margin-top: 44px; }
        .gshell__pager { grid-template-columns: 1fr; }
        .gshell__pager-card--next { text-align: left; }
    }
</style>

<script>
    import { mountSectionNav } from '@bagel/ui/lib/scroll-spy';

    let dispose: (() => void) | undefined;

    function unmountToc() {
        dispose?.();
        dispose = undefined;
    }

    function mountToc() {
        unmountToc();
        const toc = document.querySelector<HTMLElement>('[data-guide-toc]');
        if (toc) dispose = mountSectionNav(toc);
    }

    mountToc();
    document.addEventListener('astro:page-load', mountToc);
    document.addEventListener('astro:before-swap', unmountToc);
    window.addEventListener('pagehide', unmountToc);
    window.addEventListener('pageshow', (event) => { if (event.persisted) mountToc(); });
</script>
