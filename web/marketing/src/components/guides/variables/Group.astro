// One group section in the main column. `data-vref-group` is what
// reference.ts hides when a filter leaves nothing visible inside it, and
// `id` is what the rail's per-group links jump to.
import Entry from './Entry.astro';
import type { LocalizedVariableReference } from '../../../lib/variables';

interface GroupCopy {
    formsLabel: string;
    formSyntax: string;
    formExample: string;
    formOutput: string;
    available: string;
    needs: string;
    aliases: string;
    legacy: string;
    copy: string;
    copied: string;
    copyFailed: string;
    composeInDashboard: string;
    surfaceCount: string;
    tryIt: string;
    tryItHint: string;
}

interface Props {
    group: string;
    label: string;
    entries: readonly LocalizedVariableReference[];
    dashboardOrigin: string;
    builderLang: string;
    revealIndex: number;
    copy: GroupCopy;
}

const { group, label, entries, dashboardOrigin, builderLang, revealIndex, copy } = Astro.props;
---

<section id={group} class="vref-group" data-vref-group data-reveal style={`--reveal-i: ${revealIndex}`}>
    <h2 class="vref-group__heading">{label}</h2>
    <div class="vref-group__list">
        {entries.map((entry) => (
            <Entry entry={entry} groupLabel={label} dashboardOrigin={dashboardOrigin} builderLang={builderLang} copy={copy} />
        ))}
    </div>
</section>
