// One group section: a heading, one table (Variable / Means / Example /
// Result), and an optional per-table "Also written" footnote built from
// every alias token the group's own entries carry -- a group with none
// renders no footnote rather than an empty line.
import Table from '@bagel/ui/astro/Table.astro';
import Entry from './Entry.astro';
import type { LocalizedVariableReference } from '../../../lib/variables';

interface GroupCopy {
    colVariable: string;
    colMeans: string;
    colExample: string;
    colResult: string;
    aliases: string;
    copy: string;
}

interface Props {
    group: string;
    label: string;
    entries: readonly LocalizedVariableReference[];
    copy: GroupCopy;
    revealIndex: number;
}

const { group, label, entries, copy, revealIndex } = Astro.props;

const aliasTokens = [...new Set(entries.flatMap((entry) => entry.aliasTokens))];
---

<section id={group} class="vref-group" data-reveal style={`--reveal-i: ${revealIndex}`}>
    <h2 class="vref-group__heading">{label}</h2>
    <Table label={label} class="vref-table">
        <thead>
            <tr>
                <th scope="col">{copy.colVariable}</th>
                <th scope="col">{copy.colMeans}</th>
                <th scope="col">{copy.colExample}</th>
                <th scope="col">{copy.colResult}</th>
            </tr>
        </thead>
        <tbody>
            {entries.map((entry) => (
                <Entry entry={entry} copy={{ copy: copy.copy }} />
            ))}
        </tbody>
    </Table>
    {aliasTokens.length > 0 && (
        <p class="vref-group__footnote"><span>{copy.aliases}</span> {aliasTokens.map((token) => <code>{token}</code>)}</p>
    )}
    <slot />
</section>
