import Code from '@bagel/ui/astro/Code.astro';
import Eyebrow from '@bagel/ui/astro/Eyebrow.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Table from '@bagel/ui/astro/Table.astro';
import Text from '@bagel/ui/astro/Text.astro';
import Entry from './Entry.astro';
import type { LocalizedVariableReference } from '../../../lib/variables';

interface GroupCopy {
    colVariable: string;
    colMeans: string;
    colExample: string;
    colResult: string;
    aliases: string;
    copy: string;
}

interface Props {
    group: string;
    label: string;
    entries: readonly LocalizedVariableReference[];
    copy: GroupCopy;
    revealIndex: number;
}

const { group, label, entries, copy, revealIndex } = Astro.props;

const aliasTokens = [...new Set(entries.flatMap((entry) => entry.aliasTokens))];
---

<section id={group} class="vref-group" data-reveal style={`--reveal-i: ${revealIndex}`}>
    <Heading level={3} as="h2" class="vref-group__heading">{label}</Heading>
    <Table label={label} class="vref-table">
        <thead>
            <tr>
                <th scope="col">{copy.colVariable}</th>
                <th scope="col">{copy.colMeans}</th>
                <th scope="col">{copy.colExample}</th>
                <th scope="col">{copy.colResult}</th>
            </tr>
        </thead>
        <tbody>
            {entries.map((entry) => (
                <Entry entry={entry} copy={{ copy: copy.copy }} />
            ))}
        </tbody>
    </Table>
    {aliasTokens.length > 0 && (
        <Text size="sm" tone="muted" class="vref-group__footnote"><Eyebrow class="vref-group__aliases">{copy.aliases}</Eyebrow> {aliasTokens.map((token) => <Code class="vref-alias">{token}</Code>)}</Text>
    )}
    <slot />
</section>
