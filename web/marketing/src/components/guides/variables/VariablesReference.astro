/**
 * The variables guide: a header, then one table per group, in manifest
 * group order (docs/specs/variables-catalog.md phase 7). Replaces the
 * search-and-filter, rail-and-<details> layout (docs/specs/variables-
 * catalog.md D7, phase 3-6) with a flat page a browser's own Ctrl-F already
 * searches: every row is always in the DOM, so there is nothing to filter
 * and nothing that moves when a visitor clicks a copy button.
 *
 * Still takes the manifest as data (`catalog: variableReferenceData(lang)`)
 * rather than importing it itself -- the page owns the localization call,
 * this component only presents the result.
 */
import Eyebrow from '@bagel/ui/astro/Eyebrow.astro';
import Group from './Group.astro';
import './reference.css';
import { getLangFromUrl, useTranslations, localizePath, type Lang, type UIKey } from '../../../i18n/ui';
import { GROUP_ORDER, type LocalizedVariableReference } from '../../../lib/variables';
import { forSurface } from '@bagel/kit/variables';

interface Props {
    catalog: readonly LocalizedVariableReference[];
    lang?: Lang;
}

const { catalog, lang: providedLang } = Astro.props;
const lang = providedLang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const groups = GROUP_ORDER
    .map((group) => ({
        id: group,
        label: t(`guides.variables.group.${group}` as UIKey),
        entries: catalog.filter((entry) => entry.group === group),
    }))
    .filter((group) => group.entries.length > 0);

const groupCopy = {
    colVariable: t('guides.variables.colVariable'),
    colMeans: t('guides.variables.colMeans'),
    colExample: t('guides.variables.colExample'),
    colResult: t('guides.variables.colResult'),
    aliases: t('guides.variables.aliases'),
    copy: t('guides.variables.copy'),
};

const clientCopy = {
    copy: groupCopy.copy,
    copied: t('guides.variables.copied'),
    copyFailed: t('guides.variables.copyFailed'),
};

// The one-line note under "Your stream": which groups a timer's message can
// draw variables from, derived straight from the surface kit itself owns
// rather than a second hand-kept list (a timer has no invoking viewer, so
// this is not simply "every group").
const timerGroupIds = new Set(forSurface('timer').map((def) => def.group));
const timerGroupLabels = GROUP_ORDER
    .filter((group) => timerGroupIds.has(group))
    .map((group) => t(`guides.variables.group.${group}` as UIKey));
const timerNote = t('guides.variables.timerNote').replace('{groups}', timerGroupLabels.join(', '));
---

<section class="vref" data-vref-root>
    <div class="vref__head" data-reveal style="--reveal-i: 0">
        <Eyebrow>{t('guides.variables.eyebrow')}</Eyebrow>
        <h1>{t('guides.variables.title')}</h1>
        <p class="vref__lead">{t('guides.variables.lead')}</p>
        <p class="vref__note">{t('guides.variables.note')}</p>
    </div>

    <div class="vref__main">
        {groups.map((group, index) => (
            <Group group={group.id} label={group.label} entries={group.entries} copy={groupCopy} revealIndex={Math.min(index + 1, 6)}>
                {group.id === 'stream' && <p class="vref__timer-note">{timerNote}</p>}
            </Group>
        ))}
    </div>

    <p class="vref__back">
        <a href={localizePath('/guides', lang)}>&larr; {t('guides.variables.backToGuides')}</a>
        <span aria-hidden="true">&middot;</span>
        <a href={localizePath('/command-builder', lang)}>{t('guides.variables.openBuilder')} &rarr;</a>
    </p>

    <script is:inline type="application/json" data-vref-copy-text set:html={JSON.stringify(clientCopy)} />
</section>

<script>
    import { bootAllVariableReferences } from './reference';
    bootAllVariableReferences();
    document.addEventListener('astro:page-load', bootAllVariableReferences);
</script>
