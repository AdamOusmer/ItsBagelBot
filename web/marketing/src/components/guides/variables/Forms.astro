// One row per concrete example: `syntaxes[i]` gives the form that example
// belongs to when the two arrays line up index-for-index (every kit-backed
// variable), and falls back to the example's own spelling for a surface-only
// token, which can carry more examples (one per surface) than it has forms.
import Table from '@bagel/ui/astro/Table.astro';
import Code from '@bagel/ui/astro/Code.astro';

interface FormsCopy {
    label: string;
    formSyntax: string;
    formExample: string;
    formOutput: string;
}

interface Props {
    syntaxes: readonly string[];
    examples: readonly { syntax: string; output: string; surfaceId: string }[];
    copy: FormsCopy;
}

const { syntaxes, examples, copy } = Astro.props;
const rows = examples.map((example, i) => ({
    form: syntaxes[i] ?? syntaxes[syntaxes.length - 1] ?? example.syntax,
    example: example.syntax,
    output: example.output,
}));
---

<Table label={copy.label} class="vref-forms" compact>
    <thead>
        <tr>
            <th scope="col">{copy.formSyntax}</th>
            <th scope="col">{copy.formExample}</th>
            <th scope="col">{copy.formOutput}</th>
        </tr>
    </thead>
    <tbody>
        {rows.map((row) => (
            <tr>
                <td><Code>{row.form}</Code></td>
                <td><Code>{row.example}</Code></td>
                <td>{row.output}</td>
            </tr>
        ))}
    </tbody>
</Table>
