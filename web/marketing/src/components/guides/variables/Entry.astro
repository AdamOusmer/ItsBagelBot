import Code from '@bagel/ui/astro/Code.astro';
import type { LocalizedVariableReference } from '../../../lib/variables';

interface EntryCopy {
    copy: string;
}

interface Props {
    entry: LocalizedVariableReference;
    copy: EntryCopy;
}

const { entry, copy } = Astro.props;

function firstSentence(text: string): string {
    const match = text.match(/^.*?[.!?](?=\s|$)/);
    return match ? match[0] : text;
}
const means = entry.hint || firstSentence(entry.description);

const extraForms = entry.syntaxes.slice(1).map((syntax, i) => ({
    syntax,
    output: entry.examples[i + 1]?.output ?? '',
}));
---

<tr id={entry.id} data-vref-entry>
    <td>
        <span class="vref-td-variable">
            <span class="vref-chip"><Code>{entry.syntax}</Code></span>
            <button type="button" class="vref-copy" data-vref-copy={entry.example}>{copy.copy}</button>
        </span>
    </td>
    <td class="vref-td-means">{means}</td>
    <td><Code>{entry.example}</Code></td>
    <td>{entry.output}</td>
</tr>
{extraForms.map((form, i) => (
    <tr id={`${entry.id}-${i + 2}`} class="vref-entry-extra">
        <td></td>
        <td></td>
        <td><Code>{form.syntax}</Code></td>
        <td>{form.output}</td>
    </tr>
))}
