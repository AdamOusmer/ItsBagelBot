import Tag from '@bagel/ui/astro/Tag.astro';

export interface Line {
    who: 'viewer' | 'bot' | 'system';
    name?: string;
    text?: string;
    html?: string;
}

interface Props {
    tag: string;
    lines: Line[];
    note?: string;
}

const { tag, lines, note } = Astro.props;
---

<div class="chat">
    <Tag tone="live" bare class="chat-tag">{tag}</Tag>
    {lines.map((line) => (
        <p class:list={['line', line.who]}>
            {line.name && <span class:list={['who', `${line.who}-name`]}>{line.name}</span>}
            {line.html ? <span class="msg" set:html={line.html} /> : <span class="msg">{line.text}</span>}
        </p>
    ))}
    {note && <i class="gs-mark" data-note={note}></i>}
</div>

<style>
    .chat {
        position: relative;
        margin-top: 10px;
        padding: 14px 14px 12px;
        border: 1px solid var(--bb-border);
        border-radius: var(--bb-radius-md);
        background: rgba(var(--bb-shadow-rgb), 0.3);
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .chat-tag {
        position: absolute;
        top: -8px;
        left: 10px;
        font-size: 10px;
        background: var(--bb-inset-bg);
        padding: 0 6px;
    }

    .line {
        display: flex;
        align-items: baseline;
        gap: 8px;
        min-width: 0;
        margin: 0;
    }

    .who {
        font-family: var(--bb-font-body);
        font-weight: 700;
        font-size: var(--bb-text-sm);
        flex: none;
    }

    .viewer-name { color: var(--bb-tan-light); }
    .bot-name { color: var(--bb-green-glow); }
    .viewer-name::after,
    .bot-name::after { content: ":"; color: var(--bb-muted); font-weight: 400; }

    .msg {
        font-family: var(--bb-font-body);
        font-size: var(--bb-text-sm);
        line-height: 1.5;
        color: var(--bb-white);
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .line.viewer .msg {
        font-family: var(--bb-font-mono);
        font-size: var(--bb-text-sm);
        color: var(--bb-tan-light);
    }

    .line.system .msg { color: var(--bb-muted); font-style: italic; }

    .msg :global(mark) {
        background: rgba(var(--bb-green-glow-rgb), 0.14);
        color: var(--bb-green-glow);
        border-radius: var(--bb-radius-xs);
        padding: 0 3px;
    }
</style>
