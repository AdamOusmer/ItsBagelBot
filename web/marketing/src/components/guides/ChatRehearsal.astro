import ChatPreview from '@bagel/ui/astro/ChatPreview.astro';
import ChatLines from './ChatLines.astro';
import type { ChatLine } from './ChatLines.astro';

interface Props {
    tag: string;
    lines: ChatLine[];
    note?: string;
}

const { tag, lines, note } = Astro.props;
---

<ChatPreview title={tag} note={note}>
    <ChatLines lines={lines} />
</ChatPreview>
