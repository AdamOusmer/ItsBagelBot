/**
 * The command editor's insert palette with the "Data source" chip open: the
 * token chips a response already offers, then the popover listing the saved
 * definitions with their paths. Clicking a row drops the token at the cursor.
 *
 * The popover is the one piece with no @bagel/ui element behind it: it is the
 * editor's own FetchSourcePicker, a live listbox, so the still frame of it is
 * drawn here in scoped CSS and stays here.
 */
import Card from '@bagel/ui/astro/Card.astro';
import Chip from '@bagel/ui/astro/Chip.astro';
import Field from '@bagel/ui/astro/Field.astro';
import '@bagel/ui/styles/elements/field.css';

interface Props {
    labels?: Record<string, string>;
}

const { labels = {} } = Astro.props;
const L = {
    fieldResponse: 'Response',
    responseHtml:
        'It is <span class="gs-var">&#123;urlfetch:weather&#125;</span>°C in Montreal right now. Ask <span class="gs-var">&#123;user&#125;</span> if they want a coat.',
    insertVariable: 'Insert variable',
    chipUser: '&#123;user&#125;',
    chipArgs: '&#123;args&#125;',
    chipCounter: 'Counter',
    chipDataSource: 'Data source',
    popoverTitle: 'Saved definitions',
    row1Name: 'weather',
    row1Path: 'current.temperature_2m',
    row2Name: 'quote',
    row2Path: 'Plain text',
    newSource: '+ New data source',
    ...labels,
};
---

<div class="dframe__screen dframe__screen--panel">
    <Card>
        <Field label={L.fieldResponse}>
            <span class="bb-input gs-value" data-focus><Fragment set:html={L.responseHtml} /></span>
        </Field>
        <p class="gs-hint">{L.insertVariable}</p>
        <div class="gs-actions">
            <Chip tone="muted"><Fragment set:html={L.chipUser} /></Chip>
            <Chip tone="muted"><Fragment set:html={L.chipArgs} /></Chip>
            <Chip tone="muted">{L.chipCounter}</Chip>
            <Chip on>{L.chipDataSource}<i class="gs-mark" data-note="1"></i></Chip>
        </div>
        <div class="dsp__pop">
            <span class="dsp__title">{L.popoverTitle}</span>
            <span class="dsp__row is-active">
                <b>{L.row1Name}</b><em>{L.row1Path}</em>
                <i class="gs-mark" data-note="2"></i>
            </span>
            <span class="dsp__row"><b>{L.row2Name}</b><em>{L.row2Path}</em></span>
            <span class="dsp__new">{L.newSource}<i class="gs-mark" data-note="3"></i></span>
        </div>
    </Card>
</div>

<style>
    .dsp__pop {
        display: grid;
        gap: 4px;
        margin-top: 10px;
        padding: 8px 9px;
        border: 1px solid var(--border, rgba(201, 168, 124, 0.15));
        border-radius: var(--radius-sm);
        background: rgba(10, 10, 10, 0.8);
    }

    .dsp__title {
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted, #888077);
    }

    .dsp__row,
    .dsp__new {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 5px 6px;
        border-radius: var(--radius-sm);
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.72rem;
    }

    .dsp__row b { font-weight: 400; color: rgba(240, 236, 228, 0.85); }
    .dsp__row em { font-style: normal; color: var(--muted, #888077); }
    .dsp__row.is-active { background: rgba(201, 168, 124, 0.12); }
    .dsp__row.is-active b { color: var(--tan-light, #e0c49a); }

    .dsp__new {
        color: var(--tan-light, #e0c49a);
        border-top: 1px solid var(--border, rgba(201, 168, 124, 0.15));
        border-radius: 0;
        margin-top: 2px;
        padding-top: 7px;
    }
</style>
