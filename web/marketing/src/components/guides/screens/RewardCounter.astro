/**
 * The counter block inside a channel-point reward editor: the checkbox, the
 * counter name, and the same four scopes worded for rewards. Labels are the
 * console catalog's own strings (rewardCounter.* in
 * web/kit/lib/i18n/locales).
 */
import EditorFooter from '@bagel/ui/astro/EditorFooter.astro';
import Field from '@bagel/ui/astro/Field.astro';
import InspectorSurface from '@bagel/ui/astro/InspectorSurface.astro';
import ScreenCheck from '../ScreenCheck.astro';
import '@bagel/ui/styles/elements/field.css';
import '@bagel/ui/styles/tags.css';

interface Props {
    labels?: Record<string, string>;
}

const { labels = {} } = Astro.props;
const L = {
    panelHead: 'Hydrate!',
    close: 'Close',
    check: 'Keep a counter',
    fieldName: 'Counter name',
    nameValue: 'hydrations',
    fieldScope: 'What each redemption counts toward',
    chip1: 'whole channel',
    chip2: 'per viewer',
    chip3: 'per reward',
    chip4: 'per viewer + reward',
    cancel: 'Cancel',
    save: 'Save changes',
    ...labels,
};

const scopes = [L.chip1, L.chip2, L.chip3, L.chip4];
---

<div class="dframe__screen dframe__screen--panel">
    <InspectorSurface title={L.panelHead} closeLabel={L.close}>
        <ScreenCheck label={L.check} checked note="1" />
        <Field label={L.fieldName}>
            <span class="bb-input gs-value">{L.nameValue}</span>
        </Field>
        <Field label={L.fieldScope}>
            <span class="bb-tabs bb-tabs--wrap" role="radiogroup" aria-label={L.fieldScope}>
                {scopes.map((scope, i) => (
                    <span class={`bb-tab ${i === 3 ? 'is-active' : ''}`}>{scope}</span>
                ))}
                <i class="gs-mark" data-note="2"></i>
            </span>
        </Field>
        <div class="gs-foot">
            <EditorFooter cancelLabel={L.cancel} saveLabel={L.save} dirty />
        </div>
    </InspectorSurface>
</div>
