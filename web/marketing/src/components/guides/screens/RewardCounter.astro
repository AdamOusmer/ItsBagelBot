/**
 * The counter block inside a channel-point reward editor: the switch, the
 * counter name, and the same four scopes worded for rewards. Labels are the
 * console catalog's own strings (rewardCounter.* in
 * web/kit/lib/i18n/locales).
 */
import Icon from '@bagel/ui/astro/Icon.astro';

interface Props {
    labels?: Record<string, string>;
}

const { labels = {} } = Astro.props;
const L = {
    panelHead: 'Hydrate!',
    close: 'Close',
    check: 'Keep a counter',
    fieldName: 'Counter name',
    nameValue: 'hydrations',
    fieldScope: 'What each redemption counts toward',
    scopeValue: 'Per viewer, per reward',
    chip1: 'whole channel',
    chip2: 'per viewer',
    chip3: 'per reward',
    chip4: 'per viewer + reward',
    cancel: 'Cancel',
    save: 'Save changes',
    ...labels,
};
---

<div class="df-main" style="max-width:420px; margin:0 auto;">
    <div class="df-panel">
        <div class="df-panel-head">{L.panelHead} <i aria-label={L.close} role="img"><Icon name="x" size={12} /></i></div>
        <span class="df-check is-on">{L.check}<i class="df-mark" data-note="1"></i></span>
        <div class="df-field"><span>{L.fieldName}</span><div class="df-input">{L.nameValue}</div></div>
        <div class="df-field">
            <span>{L.fieldScope}</span>
            <div class="df-input is-focus">{L.scopeValue}<i class="df-mark" data-note="2"></i></div>
        </div>
        <div class="df-chips"><i>{L.chip1}</i><i>{L.chip2}</i><i>{L.chip3}</i><i>{L.chip4}</i></div>
        <div class="df-panel-foot"><span class="df-btn df-btn--ghost">{L.cancel}</span><span class="df-btn df-btn--tan">{L.save}</span></div>
    </div>
</div>
