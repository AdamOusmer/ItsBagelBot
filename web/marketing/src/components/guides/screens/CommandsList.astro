/**
 * The Commands page with the editor docked beside the list: the toolbar's
 * filter chips and search, two command rows, and the "New command" inspector
 * open on the right. Same elements as the console: PageToolbar's `.bb-toolbar`,
 * DeckList, ManagementRow, InspectorSurface, Field and EditorFooter.
 */
import Button from '@bagel/ui/astro/Button.astro';
import Chip from '@bagel/ui/astro/Chip.astro';
import DeckList from '@bagel/ui/astro/DeckList.astro';
import EditorFooter from '@bagel/ui/astro/EditorFooter.astro';
import Field from '@bagel/ui/astro/Field.astro';
import InspectorSurface from '@bagel/ui/astro/InspectorSurface.astro';
import ManagementRow from '@bagel/ui/astro/ManagementRow.astro';
import SearchInput from '@bagel/ui/astro/SearchInput.astro';
import Switch from '@bagel/ui/astro/Switch.astro';
import ChatRehearsal from '../ChatRehearsal.astro';
import ScreenChrome from '../ScreenChrome.astro';
import '@bagel/ui/styles/elements/shell.css';
import '@bagel/ui/styles/elements/field.css';

interface Props {
    labels?: Record<string, string>;
}

const { labels = {} } = Astro.props;
const L = {
    console: 'Console',
    crumbPage: 'Commands',
    account: 'streamer · Broadcaster',
    eyebrow: 'Manage',
    titleHtml: 'Chat <em>commands</em>',
    filterAll: 'All',
    filterActive: 'Active',
    filterCustom: 'Custom',
    searchPlaceholder: 'Search name, alias, response…',
    newCommand: 'New command',
    row1Name: '!followage',
    builtIn: 'built-in',
    row1Meta: 'Everyone · 15s',
    row2Name: '!discord',
    row2Text: 'Come hang out between streams…',
    row2Meta: 'Everyone · 0s',
    panelHead: 'New command',
    close: 'Close',
    fieldName: 'Name',
    nameValue: 'discord',
    fieldResponse: 'Response',
    responseValue: 'Come hang out between streams: discord.gg/your-invite',
    chatTag: 'Chat rehearsal',
    viewerName: 'sesame_sam',
    viewerText: '!discord',
    botName: 'ItsBagelBot',
    cancel: 'Cancel',
    create: 'Create',
    navLabel: 'Manage',
    navOverview: 'Overview',
    navCommands: 'Commands',
    navModules: 'Modules',
    navDiscord: 'Discord',
    navBilling: 'Billing',
    navSettings: 'Settings',
    ...labels,
};

const nav = {
    overview: L.navOverview,
    commands: L.navCommands,
    modules: L.navModules,
    discord: L.navDiscord,
    billing: L.navBilling,
    settings: L.navSettings,
};
---

<ScreenChrome
    console={L.console}
    crumb={L.crumbPage}
    account={L.account}
    navLabel={L.navLabel}
    nav={nav}
    active="commands"
    eyebrow={L.eyebrow}
    titleHtml={L.titleHtml}
>
    <div class="bb-toolbar">
        <div class="gs-actions">
            <Chip on>{L.filterAll}</Chip>
            <Chip tone="muted">{L.filterActive}</Chip>
            <Chip tone="muted">{L.filterCustom}</Chip>
        </div>
        <div class="bb-toolbar__grow"></div>
        <SearchInput placeholder={L.searchPlaceholder} readonly />
        <Button size="sm">{L.newCommand}</Button>
        <i class="gs-mark" data-note="1"></i>
    </div>
    <div class="gs-cols">
        <DeckList>
            <ManagementRow>
                <span class="gs-row">
                    <span class="gs-num">01</span>
                    <code>{L.row1Name}</code>
                    <span class="bb-tag bb-tag--quiet">{L.builtIn}</span>
                    <span class="gs-grow"></span>
                    <span class="gs-meta">{L.row1Meta}</span>
                </span>
                <Fragment slot="actions"><Switch checked label={L.row1Name} /></Fragment>
            </ManagementRow>
            <ManagementRow selected>
                <span class="gs-row">
                    <span class="gs-num">02</span>
                    <code>{L.row2Name}</code>
                    <span class="gs-grow">{L.row2Text}</span>
                    <span class="gs-meta">{L.row2Meta}</span>
                </span>
                <Fragment slot="actions"><Switch checked label={L.row2Name} /></Fragment>
            </ManagementRow>
        </DeckList>
        <InspectorSurface title={L.panelHead} closeLabel={L.close}>
            <Field label={L.fieldName}>
                <span class="bb-input gs-value" data-focus>{L.nameValue}<i class="gs-mark" data-note="2"></i></span>
            </Field>
            <Field label={L.fieldResponse}>
                <span class="bb-input gs-value">{L.responseValue}<i class="gs-mark" data-note="3"></i></span>
            </Field>
            <ChatRehearsal
                tag={L.chatTag}
                lines={[
                    { who: 'viewer', name: L.viewerName, text: L.viewerText },
                    { who: 'bot', name: L.botName, text: L.responseValue },
                ]}
            />
            <div class="gs-foot">
                <EditorFooter cancelLabel={L.cancel} saveLabel={L.create} dirty />
                <i class="gs-mark" data-note="4"></i>
            </div>
        </InspectorSurface>
    </div>
</ScreenChrome>
