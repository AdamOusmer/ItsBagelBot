/**
 * The command editor panel on its own, every field annotated: name, alternate
 * names, response, chat rehearsal, access, cooldown, the user restriction and
 * the two checkboxes. The palette row also carries the Data source chip: it
 * inserts a {urlfetch:name} token from a saved API definition (see the Data
 * sources guide), same as the real editor.
 */
import Chip from '@bagel/ui/astro/Chip.astro';
import EditorFooter from '@bagel/ui/astro/EditorFooter.astro';
import Field from '@bagel/ui/astro/Field.astro';
import Icon from '@bagel/ui/astro/Icon.astro';
import InspectorSurface from '@bagel/ui/astro/InspectorSurface.astro';
import ChatRehearsal from '../ChatRehearsal.astro';
import ScreenCheck from '../ScreenCheck.astro';
import '@bagel/ui/styles/elements/field.css';

interface Props {
    labels?: Record<string, string>;
}

const { labels = {} } = Astro.props;
const L = {
    panelHead: 'Edit command',
    close: 'Close',
    fieldName: 'Name',
    nameValue: 'hug',
    fieldAlts: 'Alternate names',
    optional: '(optional)',
    altChipLabel: 'cuddle',
    remove: 'Remove',
    fieldResponse: 'Response',
    responseHtml: '<span class="gs-var">&#123;user&#125;</span> gives <span class="gs-var">&#123;touser&#125;</span> a warm bagel hug 🥯',
    chip1: '&#123;user&#125;',
    chip2: '&#123;target&#125;',
    chip3: '&#123;random&#125;',
    chip4: 'Data source',
    chip4Tooltip: 'Insert a fetched value from a saved API definition',
    chatTag: 'Chat rehearsal',
    viewerName: 'sesame_sam',
    viewerText: '!hug ferret_king',
    botName: 'ItsBagelBot',
    botHtml: '<mark>sesame_sam</mark> gives <mark>ferret_king</mark> a warm bagel hug 🥯',
    fieldAccess: 'Access',
    accessValue: 'Everyone',
    fieldCooldown: 'Cooldown (s)',
    cooldownValue: '10',
    fieldRestrict: 'Restrict to user ID',
    restrictPlaceholder: 'Twitch user ID. Only they can run it',
    checkActive: 'Active',
    checkLive: 'Only while live',
    cancel: 'Cancel',
    save: 'Save changes',
    ...labels,
};
---

<div class="dframe__screen dframe__screen--panel">
    <InspectorSurface title={L.panelHead} closeLabel={L.close}>
        <Field label={L.fieldName}>
            <span class="bb-input gs-value">{L.nameValue}<i class="gs-mark" data-note="1"></i></span>
        </Field>
        <Field label={L.fieldAlts} tag={L.optional}>
            <span class="bb-input gs-value">
                <Chip on aria-label={`${L.altChipLabel} · ${L.remove}`}>{L.altChipLabel} <Icon name="x" size={10} /></Chip>
                <i class="gs-mark" data-note="2"></i>
            </span>
        </Field>
        <Field label={L.fieldResponse}>
            <span class="bb-input gs-value">
                <span set:html={L.responseHtml}></span><i class="gs-mark" data-note="3"></i>
            </span>
        </Field>
        <div class="gs-actions">
            <Chip tone="muted"><Fragment set:html={L.chip1} /></Chip>
            <Chip tone="muted"><Fragment set:html={L.chip2} /></Chip>
            <Chip tone="muted"><Fragment set:html={L.chip3} /></Chip>
            <Chip tone="muted" title={L.chip4Tooltip}>{L.chip4}</Chip>
            <i class="gs-mark" data-note="7"></i>
        </div>
        <ChatRehearsal
            tag={L.chatTag}
            note="4"
            lines={[
                { who: 'viewer', name: L.viewerName, text: L.viewerText },
                { who: 'bot', name: L.botName, html: L.botHtml },
            ]}
        />
        <div class="gs-pair">
            <Field label={L.fieldAccess}>
                <span class="bb-input gs-value">{L.accessValue}</span>
            </Field>
            <Field label={L.fieldCooldown}>
                <span class="bb-input gs-value">{L.cooldownValue}<i class="gs-mark" data-note="5"></i></span>
            </Field>
        </div>
        <Field label={L.fieldRestrict} tag={L.optional}>
            <span class="bb-input gs-value" data-placeholder>{L.restrictPlaceholder}</span>
        </Field>
        <ScreenCheck label={L.checkActive} checked />
        <ScreenCheck label={L.checkLive} note="6" />
        <div class="gs-foot">
            <EditorFooter cancelLabel={L.cancel} saveLabel={L.save} dirty />
        </div>
    </InspectorSurface>
</div>
