import Badge from '@bagel/ui/astro/Badge.astro';
import DeckList from '@bagel/ui/astro/DeckList.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import ManagementRow from '@bagel/ui/astro/ManagementRow.astro';
import SearchInput from '@bagel/ui/astro/SearchInput.astro';
import SectionNav from '@bagel/ui/astro/SectionNav.astro';
import Switch from '@bagel/ui/astro/Switch.astro';
import Tag from '@bagel/ui/astro/Tag.astro';
import Text from '@bagel/ui/astro/Text.astro';
import ScreenChrome from '../ScreenChrome.astro';

interface Props {
    labels?: Record<string, string>;
}

const { labels = {} } = Astro.props;
const L = {
    console: 'Console',
    crumbPage: 'Modules',
    account: 'streamer · Broadcaster',
    eyebrow: 'Manage',
    titleHtml: 'Channel <em>modules</em>',
    sub: 'Find a feature by name, by what it does, or by a chat command. 3 of 24 on.',
    searchPlaceholder: 'Search name, command, or what it does…',
    railTitle: 'Categories',
    rail1: 'Moderation',
    rail2: 'Chat',
    rail3: 'Channel',
    rail4: 'Points',
    rail5: 'Play',
    rail6: 'Gear',
    rail7: 'Stats',
    cat1: 'Moderation',
    cat1Hint: 'Everything that reads chat before your mods have to.',
    cat2: 'Chat',
    cat2Hint: 'What the bot says, and what makes it say it.',
    cat3: 'Points',
    cat3Hint: 'Channel currency, counters and what viewers spend them on.',
    row1Name: 'AutoMod',
    row1Desc: 'Catch scams, IP-grabbers and raid spam before your mods do.',
    row1Beta: 'Beta · Premium',
    row2Name: 'Trigger Words',
    row2Desc: 'Auto-reply when a word shows up in chat, no "!" needed.',
    row2Cmds: '!triggers',
    row3Name: 'Quotes',
    row3Desc: 'Save the best things said on stream and replay them in chat.',
    row3Cmds: '!quote, !addquote',
    row4Name: 'Loyalty Points',
    row4Desc: 'Viewers earn channel currency for subs, cheers and watch time.',
    row4Cmds: '!points, !leaderboard',
    row5Name: 'Counters',
    row5Desc: 'Track wins, deaths, hugs, redeems, anything your chat can count.',
    row5Cmds: '!counter',
    row5State: 'Always on',
    statusOn: 'On',
    beta: 'Beta',
    dot1: '1',
    dot2: '2',
    dot3: '3',
    dot4: '4',
    dot5: '5',
    dot6: '6',
    navLabel: 'Manage',
    navOverview: 'Overview',
    navCommands: 'Commands',
    navModules: 'Modules',
    navDiscord: 'Discord',
    navBilling: 'Billing',
    navSettings: 'Settings',
    ...labels,
};

const nav = {
    overview: L.navOverview,
    commands: L.navCommands,
    modules: L.navModules,
    discord: L.navDiscord,
    billing: L.navBilling,
    settings: L.navSettings,
};

const categories: { label: string; count: number }[] = [
    { label: L.rail1, count: 3 },
    { label: L.rail2, count: 5 },
    { label: L.rail3, count: 4 },
    { label: L.rail4, count: 4 },
    { label: L.rail5, count: 3 },
    { label: L.rail6, count: 2 },
    { label: L.rail7, count: 3 },
];
const categoryTabs = categories.map((cat, i) => ({ href: '#', label: cat.label, count: cat.count, current: i === 0 }));
---

<ScreenChrome
    console={L.console}
    crumb={L.crumbPage}
    account={L.account}
    navLabel={L.navLabel}
    nav={nav}
    active="modules"
    eyebrow={L.eyebrow}
    titleHtml={L.titleHtml}
    description={L.sub}
>
    <div class="gs-find"><SearchInput fill placeholder={L.searchPlaceholder} readonly /></div>
    <div class="gs-index">
        <div class="gs-rail">
            <SectionNav label={L.railTitle} items={categoryTabs} />
            {L.dot1 && <i class="gs-mark" data-note={L.dot1}></i>}
        </div>
        <div class="gs-stack">
            <div class="gs-family">
                <header class="gs-family-head"><Heading level={5} as="h2" variant="title">{L.cat1}</Heading><Text size="xs" tone="muted">{L.cat1Hint}</Text></header>
                <DeckList>
                    <ManagementRow>
                        <span class="gs-copy">
                            <span class="gs-name">{L.row1Name}<Tag tone="alpha">{L.beta}</Tag></span>
                            <span class="gs-grow">{L.row1Desc}</span>
                        </span>
                        <Fragment slot="actions">
                            <Tag tone="pre">{L.row1Beta}</Tag>
                            {L.dot5 && <i class="gs-mark" data-note={L.dot5}></i>}
                        </Fragment>
                    </ManagementRow>
                </DeckList>
            </div>
            <div class="gs-family">
                <header class="gs-family-head"><Heading level={5} as="h2" variant="title">{L.cat2}</Heading><Text size="xs" tone="muted">{L.cat2Hint}</Text></header>
                <DeckList>
                    <ManagementRow>
                        <span class="gs-copy">
                            <span class="gs-name">{L.row2Name}</span>
                            <span class="gs-grow">{L.row2Desc}</span>
                            <span class="gs-cmds"><Tag tone="bare">{L.row2Cmds}</Tag></span>
                            {L.dot2 && <i class="gs-mark" data-note={L.dot2}></i>}
                        </span>
                        <Fragment slot="actions"><Switch label={L.row2Name} /></Fragment>
                    </ManagementRow>
                    <ManagementRow>
                        <span class="gs-copy">
                            <span class="gs-name">{L.row3Name}</span>
                            <span class="gs-grow">{L.row3Desc}</span>
                            <span class="gs-cmds"><Tag tone="bare">{L.row3Cmds}</Tag></span>
                        </span>
                        <Fragment slot="actions">
                            <Switch label={L.row3Name} />
                            {L.dot3 && <i class="gs-mark" data-note={L.dot3}></i>}
                        </Fragment>
                    </ManagementRow>
                </DeckList>
            </div>
            <div class="gs-family">
                <header class="gs-family-head"><Heading level={5} as="h2" variant="title">{L.cat3}</Heading><Text size="xs" tone="muted">{L.cat3Hint}</Text></header>
                <DeckList>
                    <ManagementRow>
                        <span class="gs-copy">
                            <span class="gs-name">{L.row4Name}</span>
                            <span class="gs-grow">{L.row4Desc}</span>
                            <span class="gs-cmds"><Tag tone="bare">{L.row4Cmds}</Tag></span>
                        </span>
                        <Fragment slot="actions">
                            <Badge tone="live" mark="solid">{L.statusOn}</Badge>
                            <Switch checked label={L.row4Name} />
                            {L.dot4 && <i class="gs-mark" data-note={L.dot4}></i>}
                        </Fragment>
                    </ManagementRow>
                    <ManagementRow>
                        <span class="gs-copy">
                            <span class="gs-name">{L.row5Name}</span>
                            <span class="gs-grow">{L.row5Desc}</span>
                            <span class="gs-cmds"><Tag tone="bare">{L.row5Cmds}</Tag></span>
                        </span>
                        <Fragment slot="actions">
                            <Tag tone="quiet">{L.row5State}</Tag>
                            {L.dot6 && <i class="gs-mark" data-note={L.dot6}></i>}
                        </Fragment>
                    </ManagementRow>
                </DeckList>
            </div>
        </div>
    </div>
</ScreenChrome>

<style>
    .gs-rail { min-width: 0; }
</style>
