/**
 * What opening a module row gets you: one module's own page, drawn here with
 * Chat Alerts. Module status on top with the switch that turns the whole thing
 * on or off, then the six alert replies as rows with their own switches, then
 * the reply editor docked on the right with the chat rehearsal under the
 * message.
 *
 * The component name is the one reserved in lib/guides/types.ts, kept as is
 * so no other guide's content file has to change. Module names, alert labels
 * and default messages stay English in every locale, matching the dashboard.
 */
import Badge from '@bagel/ui/astro/Badge.astro';
import Card from '@bagel/ui/astro/Card.astro';
import DeckList from '@bagel/ui/astro/DeckList.astro';
import EditorFooter from '@bagel/ui/astro/EditorFooter.astro';
import Field from '@bagel/ui/astro/Field.astro';
import InspectorSurface from '@bagel/ui/astro/InspectorSurface.astro';
import ManagementRow from '@bagel/ui/astro/ManagementRow.astro';
import Switch from '@bagel/ui/astro/Switch.astro';
import ChatRehearsal from '../ChatRehearsal.astro';
import ScreenChrome from '../ScreenChrome.astro';
import '@bagel/ui/styles/elements/field.css';
import '@bagel/ui/styles/elements/toggle.css';

interface Props {
    labels?: Record<string, string>;
}

const { labels = {} } = Astro.props;
const L = {
    console: 'Console',
    crumbPage: 'Modules / Chat Alerts',
    account: 'streamer · Broadcaster',
    eyebrow: 'Module',
    titleHtml: 'Chat <em>Alerts</em>',
    sub: 'The bot posts a chat line when someone follows, subscribes, cheers, or raids, and can announce ad breaks.',
    statusLabel: 'Module status',
    statusHelp: 'Turn this module on or off for your channel.',
    statusOn: 'On',
    repliesLabel: 'Replies',
    row1Name: 'Follow alert',
    row1Text: 'Thank you for following the channel, {user}!',
    row2Name: 'Subscribe alert',
    row2Text: 'Welcome to the community, {user}! Thank you for subscribing!',
    row3Name: 'Gift sub alert',
    row3Text: '{user} just gifted {count} subs to the community! Thank you!',
    row4Name: 'Cheer alert',
    row4Text: 'Thank you for the {bits} bits, {user}!',
    row5Name: 'Raid alert',
    row5Text: '{user} is raiding the channel with {viewers} viewers! Welcome everyone!',
    row6Name: 'Ad break alert',
    row6Text: "Ads are rolling for {duration} seconds. Hang tight, we'll be right back!",
    panelHead: 'Follow alert',
    closeLabel: 'Close',
    fieldMessage: 'Follow alert message',
    messageHtml: 'Thank you for following the channel, <span class="gs-var">&#123;user&#125;</span>!',
    blankHint: 'Leave blank to use the default message.',
    chatTag: 'Chat rehearsal',
    systemText: 'sesame_sam followed the channel',
    botName: 'ItsBagelBot',
    botHtml: 'Thank you for following the channel, <mark>sesame_sam</mark>!',
    cancel: 'Cancel',
    save: 'Save changes',
    navLabel: 'Manage',
    navOverview: 'Overview',
    navCommands: 'Commands',
    navModules: 'Modules',
    navDiscord: 'Discord',
    navBilling: 'Billing',
    navSettings: 'Settings',
    ...labels,
};

const nav = {
    overview: L.navOverview,
    commands: L.navCommands,
    modules: L.navModules,
    discord: L.navDiscord,
    billing: L.navBilling,
    settings: L.navSettings,
};

const replies: { name: string; text: string; on: boolean }[] = [
    { name: L.row1Name, text: L.row1Text, on: true },
    { name: L.row2Name, text: L.row2Text, on: true },
    { name: L.row3Name, text: L.row3Text, on: true },
    { name: L.row4Name, text: L.row4Text, on: true },
    { name: L.row5Name, text: L.row5Text, on: true },
    { name: L.row6Name, text: L.row6Text, on: false },
];
---

<ScreenChrome
    console={L.console}
    crumb={L.crumbPage}
    account={L.account}
    navLabel={L.navLabel}
    nav={nav}
    active="modules"
    eyebrow={L.eyebrow}
    titleHtml={L.titleHtml}
    description={L.sub}
>
    <Card>
        <span class="gs-row">
            <span class="bb-switch-row gs-grow">
                <span class="bb-switch-row__text">
                    <span class="bb-switch-row__label">{L.statusLabel}</span>
                    <span class="bb-switch-row__hint">{L.statusHelp}</span>
                </span>
            </span>
            <Badge tone="live" mark="solid">{L.statusOn}</Badge>
            <Switch checked label={L.statusLabel} />
            <i class="gs-mark" data-note="1"></i>
        </span>
    </Card>
    <div class="gs-cols">
        <div class="gs-stack">
            <span class="gs-h">{L.repliesLabel}</span>
            <DeckList>
                {replies.map((reply, i) => (
                    <ManagementRow selected={i === 0}>
                        <span class="gs-row">
                            <span class="gs-num">{String(i + 1).padStart(2, '0')}</span>
                            <span class="gs-grow"><b>{reply.name}</b> {reply.text}</span>
                            {i === 0 && <i class="gs-mark" data-note="2"></i>}
                        </span>
                        <Fragment slot="actions">
                            <Switch checked={reply.on} label={reply.name} />
                            {i === replies.length - 1 && <i class="gs-mark" data-note="3"></i>}
                        </Fragment>
                    </ManagementRow>
                ))}
            </DeckList>
        </div>
        <InspectorSurface title={L.panelHead} closeLabel={L.closeLabel}>
            <Field label={L.fieldMessage} hint={L.blankHint}>
                <span class="bb-input gs-value" data-focus>
                    <span set:html={L.messageHtml}></span><i class="gs-mark" data-note="4"></i>
                </span>
            </Field>
            <ChatRehearsal
                tag={L.chatTag}
                note="5"
                lines={[
                    { who: 'system', text: L.systemText },
                    { who: 'bot', name: L.botName, html: L.botHtml },
                ]}
            />
            <div class="gs-foot">
                <EditorFooter cancelLabel={L.cancel} saveLabel={L.save} dirty />
            </div>
        </InspectorSurface>
    </div>
</ScreenChrome>
