/**
 * The Counters page "new counter" panel: a name, the scope picker, and the
 * plain-language reminder of where a counter gets bumped from. Labels are the
 * console catalog's own strings (counters.* in web/kit/lib/i18n/locales).
 *
 * The scope picker is the `.bb-radio-group` contract with no <input> in it: on
 * a still frame a real radio is a control that changes nothing, and the
 * element's own `[data-on]` carries the picked state without one.
 */
import EditorFooter from '@bagel/ui/astro/EditorFooter.astro';
import Field from '@bagel/ui/astro/Field.astro';
import InspectorSurface from '@bagel/ui/astro/InspectorSurface.astro';
import '@bagel/ui/styles/elements/field.css';
import '@bagel/ui/styles/elements/radio-group.css';

interface Props {
    labels?: Record<string, string>;
}

const { labels = {} } = Astro.props;
const L = {
    panelHead: 'New counter',
    close: 'Close',
    fieldName: 'Name',
    nameValue: 'deaths',
    fieldCounts: 'Counts',
    chip1: 'channel total',
    chip2: 'per user',
    chip3: 'per command',
    chip4: 'per user + command',
    hint: 'Bump it from a command response with &#123;counter:deaths&#125;, from a reward on the Channel Points page, or with !counter add.',
    cancel: 'Cancel',
    create: 'Create counter',
    ...labels,
};

const scopes = [L.chip1, L.chip2, L.chip3, L.chip4];
---

<div class="dframe__screen dframe__screen--panel">
    <InspectorSurface title={L.panelHead} closeLabel={L.close}>
        <Field label={L.fieldName}>
            <span class="bb-input gs-value">{L.nameValue}<i class="gs-mark" data-note="1"></i></span>
        </Field>
        <Field label={L.fieldCounts}>
            <span class="bb-radio-group" role="radiogroup" aria-label={L.fieldCounts}>
                {scopes.map((scope, i) => (
                    <span class="bb-radio" data-on={i === 0 ? '' : undefined}>
                        <span class="bb-radio__dot" aria-hidden="true"></span>{scope}
                    </span>
                ))}
                <i class="gs-mark" data-note="2"></i>
            </span>
        </Field>
        <p class="gs-hint"><Fragment set:html={L.hint} /><i class="gs-mark" data-note="3"></i></p>
        <div class="gs-foot">
            <EditorFooter cancelLabel={L.cancel} saveLabel={L.create} dirty />
        </div>
    </InspectorSurface>
</div>
