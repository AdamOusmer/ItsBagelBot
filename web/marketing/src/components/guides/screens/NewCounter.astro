import EditorFooter from '@bagel/ui/astro/EditorFooter.astro';
import Mark from '../Mark.astro';
import Field from '@bagel/ui/astro/Field.astro';
import InspectorSurface from '@bagel/ui/astro/InspectorSurface.astro';
import SegmentedControl from '@bagel/ui/astro/SegmentedControl.astro';
import '@bagel/ui/styles/elements/field.css';

interface Props {
    labels?: Record<string, string>;
}

const { labels = {} } = Astro.props;
const L = {
    panelHead: 'New counter',
    close: 'Close',
    fieldName: 'Name',
    nameValue: 'deaths',
    fieldCounts: 'Counts',
    chip1: 'channel total',
    chip2: 'per user',
    chip3: 'per command',
    chip4: 'per user + command',
    hint: 'Bump it from a command with its Bump a counter option or from a reward on the Channel Points page. Show it with &#123;counter:deaths&#125;.',
    cancel: 'Cancel',
    create: 'Create counter',
    ...labels,
};

const scopes = [L.chip1, L.chip2, L.chip3, L.chip4];
---

<div class="dframe__screen dframe__screen--panel">
    <InspectorSurface title={L.panelHead} closeLabel={L.close}>
        <Field label={L.fieldName}>
            <span class="bb-input gs-value">{L.nameValue}<Mark n={1} /></span>
        </Field>
        <Field label={L.fieldCounts}>
            <div class="gs-choices" inert>
                <SegmentedControl options={scopes} value={scopes[0]} label={L.fieldCounts} />
                <Mark n={2} />
            </div>
        </Field>
        <p class="gs-hint"><Fragment set:html={L.hint} /><Mark n={3} /></p>
        <div class="gs-foot">
            <EditorFooter cancelLabel={L.cancel} saveLabel={L.create} dirty />
        </div>
    </InspectorSurface>
</div>
