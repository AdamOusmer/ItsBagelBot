/**
 * The dashboard Overview page, built from the @bagel/ui elements the console
 * itself renders: the rail, the topbar, the page head, a card and management
 * rows. English is the default; a locale overrides only the keys it needs, so
 * a translator never touches this DOM. The numbered gs-mark anchors live here,
 * on the element they describe; their explanations come from the content
 * file's `notes`.
 */
import Button from '@bagel/ui/astro/Button.astro';
import Card from '@bagel/ui/astro/Card.astro';
import DeckList from '@bagel/ui/astro/DeckList.astro';
import ManagementRow from '@bagel/ui/astro/ManagementRow.astro';
import ScreenChrome from '../ScreenChrome.astro';

interface Props {
    labels?: Record<string, string>;
}

const { labels = {} } = Astro.props;
const L = {
    console: 'Console',
    crumbPage: 'Overview',
    account: 'streamer · Broadcaster',
    eyebrow: 'Status',
    titleHtml: 'Good evening, <em>streamer</em>',
    statusState: 'Online · in chat',
    statusNote: '· nothing needs you right now',
    restart: 'Restart',
    disconnect: 'Disconnect',
    quickActions: 'Quick actions',
    newCommand: 'New command',
    manageModules: 'Manage modules',
    topCommands: 'Your top commands',
    cmd1Name: '!bagel',
    cmd1Response: '&#123;user&#125; tosses a warm bagel to &#123;target&#125;. Toasty.',
    cmd1Count: '1.2k',
    cmd2Name: '!lurk',
    cmd2Response: '&#123;user&#125; fades into the shadows. Thanks for the lurk.',
    cmd2Count: '521',
    uses: 'uses',
    navLabel: 'Manage',
    navOverview: 'Overview',
    navCommands: 'Commands',
    navModules: 'Modules',
    navDiscord: 'Discord',
    navBilling: 'Billing',
    navSettings: 'Settings',
    ...labels,
};

const nav = {
    overview: L.navOverview,
    commands: L.navCommands,
    modules: L.navModules,
    discord: L.navDiscord,
    billing: L.navBilling,
    settings: L.navSettings,
};
---

<ScreenChrome
    console={L.console}
    crumb={L.crumbPage}
    account={L.account}
    navLabel={L.navLabel}
    nav={nav}
    active="overview"
    eyebrow={L.eyebrow}
    titleHtml={L.titleHtml}
    railNote="1"
>
    <Card>
        <span class="gs-row">
            <span class="gs-grow"><b>{L.statusState}</b> {L.statusNote}</span>
            <Button variant="ghost" size="sm">{L.restart}</Button>
            <Button variant="ghost" size="sm">{L.disconnect}</Button>
            <i class="gs-mark" data-note="2"></i>
        </span>
    </Card>
    <span class="gs-h">{L.quickActions}</span>
    <div class="gs-actions">
        <Button size="sm">{L.newCommand}</Button>
        <Button variant="ghost" size="sm">{L.manageModules}</Button>
        <i class="gs-mark" data-note="3"></i>
    </div>
    <span class="gs-h">{L.topCommands} <i class="gs-mark" data-note="4"></i></span>
    <DeckList>
        <ManagementRow>
            <span class="gs-row">
                <code>{L.cmd1Name}</code>
                <span class="gs-grow" set:html={L.cmd1Response}></span>
                <span class="gs-meta"><b>{L.cmd1Count}</b> {L.uses}</span>
            </span>
        </ManagementRow>
        <ManagementRow>
            <span class="gs-row">
                <code>{L.cmd2Name}</code>
                <span class="gs-grow" set:html={L.cmd2Response}></span>
                <span class="gs-meta"><b>{L.cmd2Count}</b> {L.uses}</span>
            </span>
        </ManagementRow>
    </DeckList>
</ScreenChrome>
