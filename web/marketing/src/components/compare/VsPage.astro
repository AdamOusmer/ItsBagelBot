import PageHero from '@bagel/ui/astro/PageHero.astro';
import Button from '@bagel/ui/astro/Button.astro';
import Section from '@bagel/ui/astro/Section.astro';
import Table from '@bagel/ui/astro/Table.astro';
import VisuallyHidden from '@bagel/ui/astro/VisuallyHidden.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Text from '@bagel/ui/astro/Text.astro';
import Cluster from '@bagel/ui/astro/Cluster.astro';

interface Row {
    label: string;
    us: string;
    them: string;
}

interface Props {
    competitor: string;
    intro: string;
    rows: Row[];
    switchReasons: string[];
    otherVs: { href: string; label: string };
}

const { competitor, intro, rows, switchReasons, otherVs } = Astro.props;
const DASHBOARD_LOGIN = 'https://dashboard.itsbagelbot.com/auth/login';
const title = `ItsBagelBot vs ${competitor}`;
---

<PageHero
    eyebrow="Comparison"
    title={title}
    description={intro}
/>

<Section class="vs">
    <div class="vs__table" data-reveal>
        <Table roomy label={title}>
            <thead>
                <tr>
                    <th scope="col"><VisuallyHidden>Feature</VisuallyHidden></th>
                    <th scope="col">ItsBagelBot</th>
                    <th scope="col">{competitor}</th>
                </tr>
            </thead>
            <tbody>
                {rows.map((row) => (
                    <tr>
                        <th scope="row" class="vs__feature">{row.label}</th>
                        <td class="acc">{row.us}</td>
                        <td class="mut">{row.them}</td>
                    </tr>
                ))}
            </tbody>
        </Table>
    </div>

    <Heading level={3} as="h2" class="vs__subtitle" data-reveal>Why streamers switch</Heading>
    <ul class="vs__reasons">
        {switchReasons.map((reason, i) => (
            <li data-reveal style={`--reveal-i: ${i}`}><Text as="span" tone="muted">{reason}</Text></li>
        ))}
    </ul>

    <Cluster justify="center" gap={3} class="vs__actions" data-reveal>
        <Button href={DASHBOARD_LOGIN}>Add to Twitch</Button>
        <Button variant="quiet" href="/import/">Import your setup</Button>
        <Button variant="quiet" href={otherVs.href}>{otherVs.label}</Button>
    </Cluster>

    <Text size="xs" mono tone="muted" class="vs__disclaimer">
        {competitor} is a well-made bot and this table plays fair: it reflects
        publicly documented features as of September 2026. Spotted something
        out of date? Tell us and we will fix it.
    </Text>
</Section>

<style>
    .vs {
        max-width: var(--bb-content-max);
        margin-inline: auto;
        padding: var(--bb-space-section-sm) var(--bb-space-7) var(--bb-space-section);
    }

    .vs__table {
        max-width: 900px;
        margin: 0 auto;
    }

    .vs__feature { white-space: nowrap; }

    .vs__subtitle {
        text-align: center;
        margin: 64px 0 20px;
    }

    .vs__reasons {
        max-width: var(--bb-content-hero);
        margin: 0 auto;
        padding: 0 0 0 1.2em;
    }

    .vs__actions {
        margin-top: 48px;
    }

    .vs__disclaimer {
        max-width: var(--bb-content-hero);
        margin: 40px auto 0;
        opacity: 0.75;
        text-align: center;
    }

    @media (max-width: 860px) {
        .vs { padding-inline: var(--bb-space-5); }
        .vs__feature { white-space: normal; }
    }
</style>
