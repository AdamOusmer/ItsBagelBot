import PageHero from '@bagel/ui/astro/PageHero.astro';
import SectionHeading from '@bagel/ui/astro/SectionHeading.astro';
import Card from '@bagel/ui/astro/Card.astro';
import Faq from '../pricing/Faq.astro';
import ButtonLink from '@bagel/ui/astro/ButtonLink.astro';
import Section from '@bagel/ui/astro/Section.astro';
import Grid from '@bagel/ui/astro/Grid.astro';
import Cluster from '@bagel/ui/astro/Cluster.astro';
import Eyebrow from '@bagel/ui/astro/Eyebrow.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Text from '@bagel/ui/astro/Text.astro';

interface Item {
    name?: string;
    title?: string;
    desc: string;
}

interface Props {
    eyebrow: string;
    title: string;
    lead: string;
    howEyebrow: string;
    howTitle: string;
    steps: Item[];
    listEyebrow: string;
    listTitle: string;
    listItems: Item[];
    listNote?: string;
    faqEyebrow: string;
    faqTitle: string;
    faqItems: { question: string; answer: string }[];
    ctaTitle: string;
    ctaPrimary: { href: string; label: string };
    ctaSecondary?: { href: string; label: string };
    legal?: string;
}

const {
    eyebrow, title, lead, howEyebrow, howTitle, steps,
    listEyebrow, listTitle, listItems, listNote,
    faqEyebrow, faqTitle, faqItems,
    ctaTitle, ctaPrimary, ctaSecondary, legal,
} = Astro.props;
---

<PageHero eyebrow={eyebrow} title={title} description={lead} style="--page-hero-title-lines: 3" />

<Section class="flhow">
    <SectionHeading eyebrow={howEyebrow} title={howTitle} />
    <Grid as="ol" cols={3} gap={5} stackAt="md">
        {steps.map((step, i) => (
            <li>
                <Card atmo hover class="flhow__card" data-reveal style={`--reveal-i: ${i}`}>
                    <Eyebrow aria-hidden="true">{String(i + 1).padStart(2, '0')}</Eyebrow>
                    <Heading level={5} as="h3" class="flhow__title"><span data-fit="block">{step.title}</span></Heading>
                    <Text size="sm" tone="muted" class="flhow__desc"><span data-fit="block">{step.desc}</span></Text>
                </Card>
            </li>
        ))}
    </Grid>
</Section>

<Section class="fllist">
    <SectionHeading eyebrow={listEyebrow} title={listTitle} />
    <dl class="fllist__list">
        {listItems.map((item, i) => (
            <div class="fllist__row" data-reveal style={`--reveal-i: ${i}`}>
                <Text as="dt" size="sm" mono tone="accent" class="fllist__name"><span data-fit>{item.name}</span></Text>
                <Text as="dd" size="sm" tone="muted" class="fllist__desc"><span data-fit="block">{item.desc}</span></Text>
            </div>
        ))}
    </dl>
    {listNote && <Text size="sm" tone="muted" class="fllist__note" data-reveal><span data-fit="block">{listNote}</span></Text>}
</Section>

<Faq eyebrow={faqEyebrow} title={faqTitle} items={faqItems} />

<Section class="flcta">
    <SectionHeading title={ctaTitle} class="flcta__title" />
    <Cluster justify="center" gap={3} class="flcta__actions" data-reveal>
        <ButtonLink href={ctaPrimary.href} class="flcta__btn"><span data-fit>{ctaPrimary.label}</span></ButtonLink>
        {ctaSecondary && <ButtonLink variant="secondary" href={ctaSecondary.href} class="flcta__btn"><span data-fit>{ctaSecondary.label}</span></ButtonLink>}
    </Cluster>
    {legal && <Text size="xs" mono tone="muted" class="flcta__legal"><span data-fit="block">{legal}</span></Text>}
</Section>

<style>
    .flhow,
    .fllist,
    .flcta {
        max-width: var(--bb-content-max);
        margin-inline: auto;
        padding: var(--bb-space-section-sm) var(--bb-space-7);
    }

    .flhow { --card-pad: 28px; }

    .flhow__card { height: 100%; }

    .flhow__title {
        height: calc(2 * 1lh);
        margin: 10px 0 8px;
    }

    .flhow__desc { height: calc(5 * 1lh); }

    .fllist__list {
        max-width: var(--bb-content-hero);
        margin: 0 auto;
    }

    .fllist__row {
        display: flex;
        align-items: baseline;
        gap: 20px;
        padding: 16px 4px;
        border-bottom: 1px solid var(--bb-border);
    }

    .fllist__name {
        flex: 0 0 24ch;
        min-width: 0;
    }

    .fllist__desc {
        flex: 1 1 0;
        min-width: 0;
        height: calc(2 * 1lh);
    }

    .fllist__note {
        max-width: var(--bb-content-hero);
        height: calc(2 * 1lh);
        margin: 20px auto 0;
        text-align: center;
    }

    .flcta {
        padding-bottom: var(--bb-space-section);
        text-align: center;
    }

    .flcta__title {
        --section-heading-lines: 2;
        --section-heading-lines-phone: 4;
        margin-bottom: 24px;
    }

    .flcta__btn { --btn-w: 18rem; --btn-justify: safe center; }

    .flcta__actions { --reveal-i: 2; }

    .flcta__legal {
        height: calc(2 * 1lh);
        margin: 32px auto 0;
        opacity: 0.75;
    }

    @media (max-width: 860px) {
        .flhow,
        .fllist { padding-inline: var(--bb-space-5); }
    }

    @media (max-width: 640px) {
        .fllist__row {
            flex-direction: column;
            align-items: stretch;
            gap: 6px;
        }

        .fllist__name { flex-basis: auto; }

        .fllist__desc {
            flex-basis: auto;
            height: calc(3 * 1lh);
        }
    }
</style>
