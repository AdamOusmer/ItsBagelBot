import PageHero from '@bagel/ui/astro/PageHero.astro';
import SectionHeading from '@bagel/ui/astro/SectionHeading.astro';
import Card from '@bagel/ui/astro/Card.astro';
import Faq from '../pricing/Faq.astro';
import ButtonLink from '@bagel/ui/astro/ButtonLink.astro';
import Section from '@bagel/ui/astro/Section.astro';
import Container from '@bagel/ui/astro/Container.astro';
import Grid from '@bagel/ui/astro/Grid.astro';
import Cluster from '@bagel/ui/astro/Cluster.astro';
import Eyebrow from '@bagel/ui/astro/Eyebrow.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Text from '@bagel/ui/astro/Text.astro';
import Table from '@bagel/ui/astro/Table.astro';
import CopySurface from '@bagel/ui/astro/CopySurface.astro';
import Code from '@bagel/ui/astro/Code.astro';
import StepCard from '@bagel/ui/astro/StepCard.astro';
import LinkRow from '@bagel/ui/astro/LinkRow.astro';
import Fact from '@bagel/ui/astro/Fact.astro';
import FactList from '@bagel/ui/astro/FactList.astro';
import ChatMock from '../guides/ChatMock.astro';
import type { ChatLine } from '../guides/ChatWindow.astro';

interface Item {
    name?: string;
    title?: string;
    desc: string;
}

interface TableRow {
    cells: string[];
    copy?: string;
}

interface TableSpec {
    eyebrow: string;
    title: string;
    columns: string[];
    widths: string[];
    monoColumns?: number[];
    rows: TableRow[];
    rowLines?: number;
    copyLabel?: string;
    note?: string;
}

interface DemoSpec {
    eyebrow: string;
    title: string;
    caption: string;
    channel?: string;
    lines: ChatLine[];
}

interface PrereqSpec {
    title: string;
    items: string[];
}

interface ConvertSpec {
    eyebrow: string;
    title: string;
    beforeLabel: string;
    before: string;
    afterLabel: string;
    after: string;
    note: string;
}

interface Props {
    eyebrow: string;
    title: string;
    lead: string;
    howEyebrow: string;
    howTitle: string;
    steps: Item[];
    listEyebrow: string;
    listTitle: string;
    listItems: Item[];
    listNote?: string;
    faqEyebrow: string;
    faqTitle: string;
    faqItems: { question: string; answer: string }[];
    ctaTitle: string;
    ctaPrimary: { href: string; label: string };
    ctaSecondary?: { href: string; label: string };
    legal?: string;
    updated?: { text: string; iso: string };
    table?: TableSpec;
    demo?: DemoSpec;
    prereq?: PrereqSpec;
    convert?: ConvertSpec;
    related?: { title: string; links: { href: string; label: string; external?: boolean }[] };
}

const {
    eyebrow, title, lead, howEyebrow, howTitle, steps,
    listEyebrow, listTitle, listItems, listNote,
    faqEyebrow, faqTitle, faqItems,
    ctaTitle, ctaPrimary, ctaSecondary, legal,
    updated, table, demo, prereq, convert, related,
} = Astro.props;
---

<PageHero eyebrow={eyebrow} title={title} description={lead} style="--page-hero-title-lines: 3" />

{updated && (
    <Text size="xs" mono tone="muted" class="flupd"><bb-fit><time datetime={updated.iso}>{updated.text}</time></bb-fit></Text>
)}

{table && (
    <Section size="band" class="fltbl">
      <Container>
        <SectionHeading eyebrow={table.eyebrow} title={table.title} />
        <Card flush class="fltbl__card reveal-in">
            <Table roomy label={table.title} minWidth="52rem" style={`--fltbl-lines: ${table.rowLines ?? 2}`}>
                <colgroup>{table.widths.map((width) => <col style={`width: ${width}`} />)}</colgroup>
                <thead>
                    <tr>{table.columns.map((column) => <th scope="col"><bb-fit>{column}</bb-fit></th>)}</tr>
                </thead>
                <tbody>
                    {table.rows.map((row) => (
                        <tr>
                            {row.cells.map((cell, i) => (
                                <td>
                                    {i === 0 && row.copy ? (
                                        <CopySurface variant="well" text={row.copy} class="fltbl__copy" aria-label={`${table.copyLabel ?? ''} ${row.copy}`.trim()}>{cell}</CopySurface>
                                    ) : (
                                        <div class:list={['fltbl__cell', table.monoColumns?.includes(i) && 'fltbl__cell--mono']}>
                                            <bb-fit mode="block">{cell}</bb-fit>
                                        </div>
                                    )}
                                </td>
                            ))}
                        </tr>
                    ))}
                </tbody>
            </Table>
        </Card>
        {table.note && <Text size="sm" tone="muted" class="flsec__note reveal-in"><bb-fit mode="block">{table.note}</bb-fit></Text>}
      </Container>
    </Section>
)}

{demo && (
    <Section size="band" class="fldemo">
      <Container>
        <SectionHeading eyebrow={demo.eyebrow} title={demo.title} />
        <div class="fldemo__frame">
            <ChatMock title={demo.channel} lines={demo.lines} caption={demo.caption} />
        </div>
      </Container>
    </Section>
)}

{prereq && (
    <Section size="band" class="flprereq">
      <Container>
        <Card class="flprereq__card reveal-in">
            <Heading level={5} as="h2" class="flprereq__title"><bb-fit>{prereq.title}</bb-fit></Heading>
            <ul class="flprereq__list">
                {prereq.items.map((item) => (
                    <li class="flprereq__item"><Text size="sm" tone="muted" as="span"><bb-fit mode="block">{item}</bb-fit></Text></li>
                ))}
            </ul>
        </Card>
      </Container>
    </Section>
)}

{convert && (
    <Section size="band" class="flconv">
      <Container>
        <SectionHeading eyebrow={convert.eyebrow} title={convert.title} />
        <Grid cols={2} gap={5} stackAt="md" class="flconv__pair">
            <div class="flconv__side reveal-in">
                <Eyebrow><bb-fit>{convert.beforeLabel}</bb-fit></Eyebrow>
                <Code block wrap class="flconv__code">{convert.before}</Code>
            </div>
            <div class="flconv__side reveal-in" style="--reveal-i: 1">
                <Eyebrow><bb-fit>{convert.afterLabel}</bb-fit></Eyebrow>
                <Code block wrap class="flconv__code">{convert.after}</Code>
            </div>
        </Grid>
        <Text size="sm" tone="muted" class="flsec__note reveal-in"><bb-fit mode="block">{convert.note}</bb-fit></Text>
      </Container>
    </Section>
)}

<Section size="band" class="flhow">
  <Container>
    <SectionHeading eyebrow={howEyebrow} title={howTitle} />
    <Grid as="ol" cols={3} gap={5} stackAt="md">
        {steps.map((step, i) => (
            <StepCard index={i + 1} title={step.title} class="reveal-in" style={`--reveal-i: ${i}`}>{step.desc}</StepCard>
        ))}
    </Grid>
  </Container>
</Section>

<Section size="band" class="fllist">
  <Container>
    <SectionHeading eyebrow={listEyebrow} title={listTitle} />
    <FactList layout="list" class="fllist__list">
        {listItems.map((item, i) => (
            <Fact term={item.name ?? ''} fit class="reveal-in" style={`--reveal-i: ${i}`}>{item.desc}</Fact>
        ))}
    </FactList>
    {listNote && <Text size="sm" tone="muted" class="fllist__note reveal-in"><bb-fit mode="block">{listNote}</bb-fit></Text>}
  </Container>
</Section>

{related && (
    <Section size="band">
      <Container>
        <LinkRow title={related.title} links={related.links} class="flrel" />
      </Container>
    </Section>
)}

<Faq eyebrow={faqEyebrow} title={faqTitle} items={faqItems} />

<Section size="band" class="flcta">
  <Container>
    <SectionHeading title={ctaTitle} class="flcta__title" />
    <Cluster justify="center" gap={3} class="flcta__actions reveal-in">
        <ButtonLink href={ctaPrimary.href} class="flcta__btn" variant="twitch"><bb-fit>{ctaPrimary.label}</bb-fit></ButtonLink>
        {ctaSecondary && <ButtonLink variant="secondary" href={ctaSecondary.href} class="flcta__btn"><bb-fit>{ctaSecondary.label}</bb-fit></ButtonLink>}
    </Cluster>
    {legal && <Text size="xs" mono tone="muted" class="flcta__legal"><bb-fit mode="block">{legal}</bb-fit></Text>}
  </Container>
</Section>

<style>
    .flupd {
        height: 1lh;
        margin: -8px 0 0;
        text-align: center;
    }

    .flsec__note {
        max-width: var(--bb-content-hero);
        height: calc(2 * 1lh);
        margin: 20px auto 0;
        text-align: center;
    }

    .fltbl__card { max-width: var(--bb-content-max); margin-inline: auto; }

    .fltbl__cell {
        height: calc(var(--fltbl-lines, 2) * 1lh);
        font-size: var(--bb-text-sm);
        line-height: 1.5;
        color: var(--bb-muted);
    }

    .fltbl__cell--mono { font-family: var(--bb-font-mono); color: var(--bb-tan-pale); }

    :global(.fltbl__copy) {
        width: 100%;
        padding: 10px var(--bb-space-4);
    }

    :global(.fltbl__copy:hover) { transform: none; }

    .fldemo__frame {
        max-width: 640px;
        margin-inline: auto;
    }

    .flprereq__card {
        max-width: var(--bb-content-hero);
        margin-inline: auto;
        --card-pad: 28px;
    }

    .flprereq__title { height: 1lh; margin: 0 0 16px; }

    .flprereq__list { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }

    .flprereq__item { height: calc(2 * 1lh); }

    .flconv__pair { max-width: var(--bb-content-hero); margin-inline: auto; }

    .flconv__side { display: grid; gap: 10px; align-content: start; min-width: 0; }

    .flconv__code { min-height: calc(3 * 1lh); }

    .flhow { --step-card-body-lines: 5; }

    .fllist__list {
        --fact-value-h: calc(2 * 1lh);
        max-width: var(--bb-content-hero);
        margin: 0 auto;
    }

    .fllist__note {
        max-width: var(--bb-content-hero);
        height: calc(2 * 1lh);
        margin: 20px auto 0;
        text-align: center;
    }

    .flcta {
        padding-bottom: var(--bb-space-section);
        text-align: center;
    }

    .flcta__title {
        --section-heading-lines: 2;
        --section-heading-lines-phone: 4;
        margin-bottom: 24px;
    }

    .flcta__btn { --btn-w: 18rem; --btn-justify: safe center; }

    .flcta__actions { --reveal-i: 2; }

    .flcta__legal {
        height: calc(2 * 1lh);
        margin: 32px auto 0;
        opacity: 0.75;
    }

    @media (max-width: 640px) {
        .fllist__list { --fact-value-h: calc(3 * 1lh); }
    }
</style>
