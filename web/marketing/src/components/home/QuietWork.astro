import Container from '@bagel/ui/astro/Container.astro';
import SectionHeading from '@bagel/ui/astro/SectionHeading.astro';
import Icon from '@bagel/ui/astro/Icon.astro';
import ProgressBar from '@bagel/ui/astro/ProgressBar.astro';
import Section from '@bagel/ui/astro/Section.astro';
import StatusDot from '@bagel/ui/astro/StatusDot.astro';
import BentoGrid from './BentoGrid.astro';
import FeatureCard from './FeatureCard.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const GOVEE_TONES = ['off', 'green', 'tan', 'red'];
const GOVEE_DOT = { off: 'neutral', green: 'success', tan: 'warning', red: 'danger' } as const;
// Sixteen raffle entries in an 8x2 grid; the ring lands on the winner's slot.
const WIN_ENTRIES = Array.from({ length: 16 }, (_, i) => i);
---

<Container class="qw-wrap">
<Section size="page" class="qw" id="quiet-work" data-motion>
    <SectionHeading eyebrow={t('quietWork.eyebrow')} title={t('quietWork.title')} />

    <BentoGrid cols={3}>
        <FeatureCard index={0} span={2} tone="gold" href={localizePath('/song-requests', lang)}>
            <div slot="demo" class="qw__demo qw__demo--song">
                <span class="qw-song__glow bb-layers">
                    <i class="qw-song__glow-a"></i>
                    <i class="qw-song__glow-b"></i>
                </span>
                <span class="qw-song__disc">
                    <span class="qw-song__vinyl"><i></i></span>
                    <span class="qw-song__sheen"></span>
                </span>
                <span class="qw-song__meta">
                    <span class="qw-song__now"><span data-fit>{t('quietWork.songNow')}</span></span>
                    <span class="qw-song__track bb-layers">
                        <span class="qw-song__title qw-song__title--a">One More Time<small class="qw-song__artist">Daft Punk</small></span>
                        <span class="qw-song__title qw-song__title--b">Midnight City<small class="qw-song__artist">M83</small></span>
                    </span>
                    <ProgressBar class="qw-song__scrub" value={0} size="sm" tone="success" gradient label={t('quietWork.songNow')} />
                    <span class="qw-song__req">
                        <span class="qw-song__cmd"><b class="qw__user">PrincessBarney</b>!sr late night lo-fi</span>
                        <span class="qw-song__ack"><span data-fit>{t('quietWork.songAck')}</span></span>
                    </span>
                </span>
                <span class="qw-song__next">
                    <span class="qw-song__next-label"><span data-fit>{t('quietWork.upNext')}</span></span>
                    <span class="qw-song__list">
                        <span class="qw-song__item qw-song__item--a">
                            <b class="qw-song__pos">#1</b>
                            <span class="qw-song__item-text">Midnight City<em>Lotti</em></span>
                        </span>
                        <span class="qw-song__item qw-song__item--b">
                            <b class="qw-song__pos bb-layers"><i class="qw-song__pos-was">#2</i><i class="qw-song__pos-now">#1</i></b>
                            <span class="qw-song__item-text">late night lo-fi<em>PrincessBarney</em></span>
                        </span>
                    </span>
                </span>
            </div>
            {t('quietWork.songTitle')}
        </FeatureCard>

        <FeatureCard index={1} tone="green" href={localizePath('/govee', lang)}>
            <div slot="demo" class="qw__demo qw__demo--govee">
                <span class="qw-govee__glow bb-layers">
                    {GOVEE_TONES.map((tone) => <i class={`qw-govee__tone qw-govee__tone--${tone}`}></i>)}
                </span>
                <span class="qw-govee__bulb bb-layers">
                    {GOVEE_TONES.map((tone) => (
                        <span class={`qw-govee__tone qw-govee__tone--${tone}`}>
                            <Icon name="bulb" size={44} strokeWidth={1.6} class="qw-govee__icon" />
                        </span>
                    ))}
                </span>
                <span class="qw-govee__redeem">
                    <span class="qw-govee__dot bb-layers">
                        {GOVEE_TONES.map((tone) => (
                            <span class={`qw-govee__tone qw-govee__tone--${tone}`}><StatusDot tone={GOVEE_DOT[tone]} /></span>
                        ))}
                    </span>
                    <span class="qw-govee__redeem-text"><span data-fit="block">{t('quietWork.goveeReward')}</span></span>
                </span>
            </div>
            {t('quietWork.goveeTitle')}
        </FeatureCard>

        <FeatureCard index={2} tone="green" href={localizePath('/command-builder', lang)}>
            <div slot="demo" class="qw__demo qw__demo--cmd">
                <span class="qw-cmd__in">!welcome PrincessBarney</span>
                <span class="qw-cmd__out"><span data-fit>{t('quietWork.cmdOut')}</span></span>
            </div>
            {t('quietWork.cmdTitle')}
        </FeatureCard>

        <FeatureCard index={3} tone="gold" href={localizePath('/viewer-queue', lang)}>
            <div slot="demo" class="qw__demo qw__demo--queue">
                <span class="qw-queue__chat bb-layers">
                    <span class="qw-queue__msg qw-queue__msg--join"><b class="qw__user">MikanMeerkat</b>!join</span>
                    <span class="qw-queue__msg qw-queue__msg--next"><b class="qw__user">Ayshacinder</b>!queue next</span>
                </span>
                <span class="qw-queue__list">
                    <span class="qw-queue__row qw-queue__row--a">
                        <b class="qw-queue__pos">#1</b>
                        <span class="qw-queue__name">PrincessBarney</span>
                        <em class="qw-queue__tag">
                            <Icon name="gamepad" size={12} strokeWidth={1.8} class="qw-queue__tag-icon" />
                            <span class="qw-queue__tag-text"><span data-fit>{t('quietWork.upNext')}</span></span>
                        </em>
                    </span>
                    <span class="qw-queue__row qw-queue__row--b">
                        <b class="qw-queue__pos bb-layers"><i class="qw-queue__pos-was">#2</i><i class="qw-queue__pos-now">#1</i></b>
                        <span class="qw-queue__name">Lotti</span>
                    </span>
                    <span class="qw-queue__row qw-queue__row--c">
                        <b class="qw-queue__pos bb-layers"><i class="qw-queue__pos-was">#3</i><i class="qw-queue__pos-now">#2</i></b>
                        <span class="qw-queue__name">MikanMeerkat</span>
                        <em class="qw-queue__joined">✓</em>
                    </span>
                </span>
            </div>
            {t('quietWork.queueTitle')}
        </FeatureCard>

        <FeatureCard index={4} tone="gold" href={localizePath('/giveaways', lang)}>
            <div slot="demo" class="qw__demo qw__demo--win" data-qw-draw>
                <span class="qw-win__chat bb-layers">
                    <span class="qw-win__msg qw-win__msg--open"><b class="qw__user">Ayshacinder</b>!raffle 1000 60</span>
                    <span class="qw-win__msg qw-win__msg--join1"><b class="qw__user">Lotti</b>!join</span>
                    <span class="qw-win__msg qw-win__msg--join2"><b class="qw__user">PrincessBarney</b>!join</span>
                    <span class="qw-win__msg qw-win__msg--draw"><b class="qw__user">Ayshacinder</b>!raffle draw</span>
                    <span class="qw-win__msg qw-win__msg--claim"><b class="qw__user">MikanMeerkat</b>!claim<em>✓</em></span>
                </span>
                <span class="qw-win__pool">
                    <span class="qw-win__dots">
                        {WIN_ENTRIES.map((i) => <i style={`--i: ${i}`}></i>)}
                    </span>
                    <i class="qw-win__pulse"></i>
                    <i class="qw-win__pick"></i>
                    <i class="qw-win__ring" data-qw-ring></i>
                </span>
                <span class="qw-win__result">
                    <span class="qw-win__label"><span data-fit>{t('quietWork.winLabel')}</span></span>
                    <span class="qw-win__name"><span data-fit><span class="fcard-value" data-qw-winner>MikanMeerkat</span></span></span>
                </span>
            </div>
            {t('quietWork.winTitle')}
        </FeatureCard>
    </BentoGrid>
</Section>
</Container>

<style>
    .qw {
        --section-heading-lines: 2;
        --section-heading-lines-phone: 3;
        position: relative;
        z-index: 3;
    }

    .qw__demo {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 8px;
        height: 100%;
        overflow: hidden;
        font-family: var(--bb-font-mono);
        font-size: 0.74rem;
    }

    .qw__user,
    .qw-song__pos,
    .qw-queue__pos {
        font-weight: 500;
    }

    /* Song requests: a record player on the left, the request landing in the
       queue on the right, and the queue advancing when the track ends. Ten
       second loop; the glow, title and scrub all flip at the change. */

    .qw__demo--song {
        position: relative;
        flex-direction: row;
        align-items: center;
        gap: 18px;
        padding: 4px 0;
    }

    .qw-song__glow {
        position: absolute;
        inset: 0 auto 0 0;
        width: 200px;
        pointer-events: none;
    }

    .qw-song__glow i {
        border-radius: 50%;
        opacity: 0;
        animation-duration: 10s;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
    }

    .qw-song__glow-a {
        background: radial-gradient(closest-side, rgba(var(--bb-green-glow-rgb), 0.22), transparent);
        animation-name: qwSongLayerA;
    }

    .qw-song__glow-b {
        background: radial-gradient(closest-side, rgba(var(--bb-tan-rgb), 0.24), transparent);
        animation-name: qwSongLayerB;
    }

    .qw-song__disc {
        position: relative;
        flex: none;
        width: 56px;
        height: 56px;
    }

    .qw-song__vinyl {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        box-shadow:
            0 0 0 1px rgba(var(--bb-white-rgb), 0.08),
            0 8px 18px rgba(var(--bb-black-rgb), 0.55);
        overflow: hidden;
    }

    .qw-song__vinyl i {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background:
            conic-gradient(from 20deg, transparent 0 78%, rgba(var(--bb-white-pure-rgb), 0.06) 78% 100%),
            radial-gradient(circle, var(--bb-tan-deep) 0 5px, #1b1b1e 5.5px 7px, transparent 7px),
            repeating-radial-gradient(circle, #2b2b30 0 1.5px, #18181b 1.5px 3.5px);
        animation: qwSongSpin 3.6s linear infinite;
    }

    .qw-song__sheen {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(var(--bb-white-pure-rgb), 0.1), transparent 48%);
        pointer-events: none;
    }

    .qw-song__meta {
        position: relative;
        display: flex;
        flex: 1 1 0;
        flex-direction: column;
        gap: 5px;
        min-width: 0;
    }

    .qw-song__now,
    .qw-song__next-label {
        display: block;
        height: 1lh;
        font-size: 0.62rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--bb-muted);
    }

    .qw-song__track {
        height: 30px;
    }

    .qw-song__title {
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
        color: var(--bb-tan-light);
        white-space: nowrap;
        overflow: hidden;
        opacity: 0;
        animation-duration: 10s;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
    }

    .qw-song__artist {
        font-size: 0.62rem;
        color: var(--bb-muted);
    }

    .qw-song__title--a { animation-name: qwSongTitleA; }
    .qw-song__title--b { animation-name: qwSongTitleB; }

    .qw-song__scrub > :global(span) {
        transform-origin: left;
        animation: qwSongScrub 10s linear infinite;
    }

    .qw-song__req {
        display: flex;
        flex-direction: column;
        gap: 3px;
        margin-top: 5px;
        min-width: 0;
    }

    .qw-song__cmd,
    .qw-queue__msg,
    .qw-win__msg {
        display: block;
        height: 1lh;
        white-space: nowrap;
        overflow: hidden;
        color: var(--bb-white);
    }

    .qw__user {
        margin-right: 0.6em;
        color: var(--bb-tan);
    }

    .qw-song__cmd {
        opacity: 0;
        animation: qwSongCmd 10s ease infinite;
    }

    .qw-song__ack {
        display: block;
        width: 120px;
        height: 1lh;
        font-size: 0.68rem;
        color: var(--bb-green-glow);
        opacity: 0;
        animation: qwSongAck 10s ease infinite;
    }

    .qw-song__next {
        display: flex;
        flex: none;
        flex-direction: column;
        gap: 5px;
        width: 190px;
        align-self: flex-start;
        padding-top: 4px;
    }

    .qw-song__list {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 6px;
        height: 70px;
        opacity: 0;
        animation: qwSongList 10s ease infinite;
    }

    .qw-song__item {
        display: flex;
        flex: none;
        align-items: center;
        gap: 8px;
        height: 32px;
        padding: 0 9px;
        border: 1px solid var(--bb-border);
        border-radius: var(--bb-radius-sm);
        background: rgba(var(--bb-white-rgb), 0.03);
        color: var(--bb-tan-light);
        white-space: nowrap;
    }

    .qw-song__item--a { animation: qwSongItemA 10s ease infinite; }

    .qw-song__item--b {
        opacity: 0;
        animation: qwSongItemB 10s ease infinite;
    }

    .qw-song__pos,
    .qw-queue__pos {
        flex: none;
        font-size: 0.62rem;
        color: var(--bb-muted);
    }

    .qw-song__pos-was,
    .qw-queue__pos-was,
    .qw-song__pos-now,
    .qw-queue__pos-now {
        font-style: normal;
        animation-duration: 10s;
        animation-timing-function: ease;
        animation-iteration-count: infinite;
    }

    .qw-song__pos-was { animation-name: qwSongPosWas; }
    .qw-song__pos-now { opacity: 0; animation-name: qwSongPosNow; }

    .qw-song__item-text {
        display: flex;
        flex: 1 1 0;
        flex-direction: column;
        gap: 1px;
        min-width: 0;
        overflow: hidden;
    }

    .qw-song__item-text em {
        font-size: 0.56rem;
        font-style: normal;
        color: var(--bb-muted);
    }

    @keyframes qwSongSpin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    @keyframes qwSongLayerA {
        0%, 54% { opacity: 1; }
        59%, 94% { opacity: 0; }
        99%, 100% { opacity: 1; }
    }

    @keyframes qwSongLayerB {
        0%, 54% { opacity: 0; }
        59%, 94% { opacity: 1; }
        99%, 100% { opacity: 0; }
    }

    @keyframes qwSongTitleA {
        0%, 54% { opacity: 1; transform: none; }
        58% { opacity: 0; transform: translateY(-5px); }
        60%, 94% { opacity: 0; transform: translateY(5px); }
        98%, 100% { opacity: 1; transform: none; }
    }

    @keyframes qwSongTitleB {
        0%, 54% { opacity: 0; transform: translateY(5px); }
        58%, 94% { opacity: 1; transform: none; }
        98% { opacity: 0; transform: translateY(-5px); }
        99%, 100% { opacity: 0; transform: translateY(5px); }
    }

    @keyframes qwSongScrub {
        0% { transform: scaleX(0); }
        54%, 56% { transform: scaleX(1); }
        56.5% { transform: scaleX(0); }
        95% { transform: scaleX(0.72); }
        95.5%, 100% { transform: scaleX(0); }
    }

    @keyframes qwSongCmd {
        0%, 8% { opacity: 0; transform: translateX(12px); animation-timing-function: var(--bb-ease-out-expo); }
        12%, 50% { opacity: 1; transform: none; }
        54%, 100% { opacity: 0; transform: translateX(-6px); }
    }

    @keyframes qwSongAck {
        0%, 15% { opacity: 0; transform: translateX(10px); animation-timing-function: var(--bb-ease-out-expo); }
        19%, 50% { opacity: 1; transform: none; }
        54%, 100% { opacity: 0; transform: translateX(-6px); }
    }

    @keyframes qwSongList {
        0% { opacity: 0; }
        4%, 93% { opacity: 1; }
        97%, 100% { opacity: 0; }
    }

    @keyframes qwSongItemA {
        0%, 54% { opacity: 1; transform: none; }
        58%, 100% { opacity: 0; transform: translateY(-10px); }
    }

    @keyframes qwSongItemB {
        0%, 16% { opacity: 0; transform: translateY(8px) scale(0.96); animation-timing-function: var(--bb-ease-out-back); }
        21%, 54% { opacity: 1; transform: none; animation-timing-function: var(--bb-ease-out-expo); }
        58%, 100% { opacity: 1; transform: translateY(-38px); }
    }

    @keyframes qwSongPosWas {
        0%, 54% { opacity: 1; }
        58%, 100% { opacity: 0; }
    }

    @keyframes qwSongPosNow {
        0%, 54% { opacity: 0; }
        58%, 100% { opacity: 1; }
    }

    /* Below the three-column grid the card is one column wide: the player
       keeps the request line and the queue column goes. */
    @media (max-width: 1023px) {
        .qw-song__next { display: none; }
        .qw-song__cmd .qw__user { display: none; }
    }

    /* Govee lights. */

    .qw__demo--govee {
        position: relative;
        flex-direction: row;
        align-items: center;
        gap: 16px;
    }

    .qw-govee__glow {
        position: absolute;
        inset: 0 auto 0 0;
        width: 160px;
        opacity: 0.05;
        animation: qwGoveeBloom 9s ease-in-out infinite;
        pointer-events: none;
    }

    .qw-govee__glow i {
        background: radial-gradient(closest-side, currentColor, transparent);
    }

    .qw-govee__bulb {
        flex: none;
        place-items: center;
        animation: qwGoveeLit 9s ease-in-out infinite;
    }

    .qw-govee__bulb .qw-govee__tone:not(.qw-govee__tone--off) {
        filter: drop-shadow(0 0 5px currentColor) drop-shadow(0 0 16px currentColor);
    }

    .qw-govee__icon { width: 44px; height: 44px; }

    .qw-govee__redeem {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: min(280px, calc(100% - 60px));
        color: var(--bb-muted);
        opacity: 0;
        animation: qwGoveeRedeem 9s ease-in-out infinite;
    }

    .qw-govee__redeem-text {
        flex: 1 1 0;
        min-width: 0;
        height: calc(2 * 1lh);
    }

    .qw-govee__dot {
        flex: none;
        width: 8px;
        height: 8px;
    }

    .qw-govee__dot .qw-govee__tone {
        display: flex;
    }

    .qw-govee__tone {
        opacity: 0;
        animation-duration: 9s;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
    }

    .qw-govee__tone--off { color: var(--bb-gray-4-dark); opacity: 1; animation-name: qwGoveeOff; }
    .qw-govee__tone--green { color: var(--bb-green-glow); animation-name: qwGoveeGreen; }
    .qw-govee__tone--tan { color: var(--bb-tan-light); animation-name: qwGoveeTan; }
    .qw-govee__tone--red { color: var(--bb-status-danger); animation-name: qwGoveeRed; }

    @keyframes qwGoveeOff {
        0%, 28% { opacity: 1; }
        40%, 82% { opacity: 0; }
        100% { opacity: 1; }
    }

    @keyframes qwGoveeGreen {
        0%, 28% { opacity: 0; }
        40%, 50% { opacity: 1; }
        62%, 100% { opacity: 0; }
    }

    @keyframes qwGoveeTan {
        0%, 50% { opacity: 0; }
        62%, 72% { opacity: 1; }
        82%, 100% { opacity: 0; }
    }

    @keyframes qwGoveeRed {
        0%, 72% { opacity: 0; }
        82% { opacity: 1; }
        100% { opacity: 0; }
    }

    @keyframes qwGoveeBloom {
        0%, 28%   { opacity: 0.05; transform: scale(0.85); }
        44%, 82%  { opacity: 0.3;  transform: scale(1); }
        100%      { opacity: 0.05; transform: scale(0.85); }
    }

    @keyframes qwGoveeLit {
        0%, 28%  { opacity: 0.5; }
        44%, 82% { opacity: 1; }
        100%     { opacity: 0.5; }
    }

    @keyframes qwGoveeRedeem {
        0%, 26%  { opacity: 0; transform: translateY(4px); }
        34%, 84% { opacity: 1; transform: none; }
        94%, 100% { opacity: 0; }
    }

    /* Custom commands. */

    .qw-cmd__in {
        color: var(--bb-tan-light);
        width: 18ch;
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        border-right: 1px solid color-mix(in srgb, var(--bb-tan-light) 60%, transparent);
        animation: qwType 5.4s steps(18) infinite;
    }

    .qw-cmd__out {
        display: block;
        height: 1lh;
        white-space: nowrap;
        color: var(--bb-green-glow);
        opacity: 0;
        animation: qwCmdOut 5.4s ease-in-out infinite;
    }

    @keyframes qwType {
        0%, 6% { width: 0; }
        30%, 92% { width: 18ch; }
        97%, 100% { width: 0; }
    }

    @keyframes qwCmdOut {
        0%, 34% { opacity: 0; transform: translateY(4px); }
        44%, 88% { opacity: 1; transform: none; }
        96%, 100% { opacity: 0; }
    }

    /* Play queue: a viewer joins at the back, a moderator calls the next
       player, the front row leaves and the line moves up. Eight second loop.
       Positions are stacked copies so the renumbering is an opacity swap. */

    .qw__demo--queue {
        justify-content: center;
        gap: 10px;
    }

    .qw-queue__msg {
        opacity: 0;
        animation-duration: 8s;
        animation-timing-function: ease;
        animation-iteration-count: infinite;
    }

    .qw-queue__msg--join { animation-name: qwQueueJoinMsg; }
    .qw-queue__msg--next { animation-name: qwQueueNextMsg; }

    .qw-queue__list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        opacity: 0;
        animation: qwQueueList 8s ease infinite;
    }

    .qw-queue__row {
        position: relative;
        display: flex;
        flex: none;
        align-items: center;
        gap: 10px;
        height: 28px;
        padding: 0 10px;
        border: 1px solid var(--bb-border);
        border-radius: var(--bb-radius-sm);
