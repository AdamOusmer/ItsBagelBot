        .qw-song__scrub > :global(span) { transform: scaleX(0.46); }
        .qw-song__cmd, .qw-song__ack, .qw-song__list, .qw-song__item--b { opacity: 1; transform: none; }
        .qw-govee__glow { opacity: 0.22; transform: none; }
        .qw-govee__bulb { opacity: 1; }
        .qw-govee__tone { opacity: 0; }
        .qw-govee__tone--green { opacity: 1; }
        .qw-govee__redeem { opacity: 1; }
        .qw-cmd__in { width: 18ch; border-right: none; }
        .qw-cmd__out { opacity: 1; }
        .qw-queue__msg--next, .qw-queue__list, .qw-queue__row--c, .qw-queue__row--a::after, .qw-queue__tag { opacity: 1; transform: none; }
        .qw-win__msg--claim, .qw-win__dots i, .qw-win__pick, .qw-win__result { opacity: 1; transform: none; }
