<script>
    import { bindOnce } from '../../script/bind';
    import { decode } from '@bagel/ui/lib/decode';
    import { reduceMotion } from '@bagel/ui/lib/motion-query';

    const WINNER = 'MikanMeerkat';
    const SCRAMBLE = { charset: 'abcdefghijklmnopqrstuvwxyz_0123456789', durationMs: 720 };
    // The ring's loop in the stylesheet above: it settles on the winner at 60% of 8.4s.
    const RING_ANIMATION = 'qwWinRing';
    const LAND_MS = 5040;

    // The CSS loop owns the clock. The ring's animation events mark each
    // cycle (and every restart after the motion gate), so the decode is
    // armed from them instead of a free-running timer that would drift.
    function setupDraw(root: HTMLElement) {
        const ring = root.querySelector<HTMLElement>('[data-qw-ring]');
        const name = root.querySelector<HTMLElement>('[data-qw-winner]');
        if (!ring || !name || reduceMotion.matches) return;

        let timer = 0;
        let stopDecode = () => {};

        function settle() {
            window.clearTimeout(timer);
            stopDecode();
            stopDecode = () => {};
            if (name!.textContent !== WINNER) name!.textContent = WINNER;
        }

        function arm(event: AnimationEvent) {
            if (event.animationName !== RING_ANIMATION) return;
            settle();
            timer = window.setTimeout(() => {
                stopDecode = decode(name!, WINNER, SCRAMBLE);
            }, LAND_MS);
        }

        ring.addEventListener('animationstart', arm);
        ring.addEventListener('animationiteration', arm);
        ring.addEventListener('animationcancel', (event) => {
            if (event.animationName === RING_ANIMATION) settle();
        });
    }

    bindOnce('[data-qw-draw]', setupDraw);
</script>
