import SectionHeading from '@bagel/ui/astro/SectionHeading.astro';
import Icon from '@bagel/ui/astro/Icon.astro';
import Section from '@bagel/ui/astro/Section.astro';
import BentoGrid from './BentoGrid.astro';
import FeatureCard from './FeatureCard.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const GOVEE_TONES = ['off', 'green', 'tan', 'red'];
---

<Section size="page" class="qw" id="quiet-work" data-motion>
    <SectionHeading eyebrow={t('quietWork.eyebrow')} title={t('quietWork.title')} />

    <BentoGrid cols={3}>
        <FeatureCard index={0} span={2} tone="gold" href={localizePath('/song-requests', lang)}>
            <div slot="demo" class="qw__demo qw__demo--song">
                <span class="qw-song__art">
                    <span class="qw-song__eq"><i></i><i></i><i></i><i></i><i></i></span>
                </span>
                <span class="qw-song__meta">
                    <span class="qw-song__now">{t('quietWork.songNow')}</span>
                    <span class="qw-song__track">{t('quietWork.songTrack')}</span>
                    <span class="qw-song__scrub"><i></i></span>
                </span>
                <span class="qw-song__req">
                    <span class="qw-song__cmd">!sr late night lo-fi</span>
                    <span class="qw-song__ack"><span data-fit>{t('quietWork.songAck')}</span></span>
                </span>
            </div>
            {t('quietWork.songTitle')}
        </FeatureCard>

        <FeatureCard index={1} tone="green" href={localizePath('/govee', lang)}>
            <div slot="demo" class="qw__demo qw__demo--govee">
                <span class="qw-govee__glow bb-layers">
                    {GOVEE_TONES.map((tone) => <i class={`qw-govee__tone qw-govee__tone--${tone}`}></i>)}
                </span>
                <span class="qw-govee__bulb bb-layers">
                    {GOVEE_TONES.map((tone) => (
                        <span class={`qw-govee__tone qw-govee__tone--${tone}`}>
                            <Icon name="bulb" size={44} strokeWidth={1.6} class="qw-govee__icon" />
                        </span>
                    ))}
                </span>
                <span class="qw-govee__redeem">
                    <span class="qw-govee__dot bb-layers">
                        {GOVEE_TONES.map((tone) => <i class={`qw-govee__tone qw-govee__tone--${tone}`}></i>)}
                    </span>
                    <span class="qw-govee__redeem-text"><span data-fit="block">{t('quietWork.goveeReward')}</span></span>
                </span>
            </div>
            {t('quietWork.goveeTitle')}
        </FeatureCard>

        <FeatureCard index={2} tone="green" href={localizePath('/command-builder', lang)}>
            <div slot="demo" class="qw__demo qw__demo--cmd">
                <span class="qw-cmd__in">!welcome PrincessBarney</span>
                <span class="qw-cmd__out"><span data-fit>{t('quietWork.cmdOut')}</span></span>
            </div>
            {t('quietWork.cmdTitle')}
        </FeatureCard>

        <FeatureCard index={3} tone="gold" href={localizePath('/viewer-queue', lang)}>
            <div slot="demo" class="qw__demo qw__demo--queue">
                <span class="qw-queue__row"><b class="qw-queue__pos">#1</b>Lotti</span>
                <span class="qw-queue__row"><b class="qw-queue__pos">#2</b>PrincessBarney</span>
            </div>
            {t('quietWork.queueTitle')}
        </FeatureCard>

        <FeatureCard index={4} tone="gold" href={localizePath('/giveaways', lang)}>
            <div slot="demo" class="qw__demo qw__demo--win">
                <span class="qw-win__label"><span data-fit>{t('quietWork.winLabel')}</span></span>
                <span class="qw-win__name"><span data-fit><span class="fcard-value" data-qw-winner>MikanMeerkat</span></span></span>
            </div>
            {t('quietWork.winTitle')}
        </FeatureCard>

        <FeatureCard index={5} span={3} tone="green" href={localizePath('/timers', lang)} class="qw__beat-card">
            <div slot="demo" class="qw__demo qw__demo--beat">
                <span class="qw-beat">
                    <span class="qw-beat__wipe bb-wipe">
                        <svg viewBox="0 0 120 32" preserveAspectRatio="none">
                            <path class="qw-beat__path" d="M0 16 H30 L38 16 L44 4 L52 28 L58 16 H82 L88 10 L94 22 L100 16 H120"
                                  fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                        </svg>
                    </span>
                </span>
            </div>
            {t('quietWork.beatTitle')}
        </FeatureCard>
    </BentoGrid>
</Section>

<style>
    .qw {
        --section-heading-lines: 2;
        --section-heading-lines-phone: 3;
        position: relative;
        padding-inline: 24px;
        max-width: var(--bb-content-max);
        margin: 0 auto;
        z-index: 3;
    }

    .qw :global(.qw__beat-card) {
        --fcard-demo-h: 72px;
    }

    .qw__demo {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 8px;
        height: 100%;
        overflow: hidden;
        font-family: var(--bb-font-mono);
        font-size: 0.74rem;
    }

    .qw__demo--song {
        flex-direction: row;
        align-items: center;
        gap: 18px;
        padding: 4px 0;
    }

    .qw-song__art {
        flex: none;
        display: grid;
        place-items: center;
        width: 56px;
        height: 56px;
        border-radius: var(--bb-radius-md);
        background: linear-gradient(145deg, rgba(var(--bb-green-glow-rgb), 0.16), rgba(var(--bb-tan-rgb), 0.1));
        box-shadow: inset 0 0 0 1px rgba(var(--bb-white-rgb), 0.07);
    }

    .qw-song__eq {
        display: flex;
        align-items: flex-end;
        gap: 3px;
        height: 22px;
    }

    .qw-song__eq i {
        width: 3px;
        height: 100%;
        border-radius: var(--bb-radius-pill);
        background: var(--bb-green-glow);
        transform-origin: bottom;
        transform: scaleY(0.25);
        animation: qwSongEq 1.15s ease-in-out infinite alternate;
    }

    .qw-song__eq i:nth-child(2) { animation-delay: 0.16s; }
    .qw-song__eq i:nth-child(3) { animation-delay: 0.34s; }
    .qw-song__eq i:nth-child(4) { animation-delay: 0.08s; }
    .qw-song__eq i:nth-child(5) { animation-delay: 0.26s; }

    @keyframes qwSongEq {
        from { transform: scaleY(0.2); opacity: 0.55; }
        to   { transform: scaleY(1);   opacity: 1; }
    }

    .qw-song__meta {
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 0;
        flex: 0 1 440px;
        margin-right: auto;
    }

    .qw-song__now {
        font-size: 0.62rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--bb-muted);
    }

    .qw-song__track {
        color: var(--bb-tan-light);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .qw-song__scrub {
        display: block;
        height: 3px;
        border-radius: var(--bb-radius-xs);
        background: rgba(var(--bb-white-rgb), 0.08);
        overflow: hidden;
    }

    .qw-song__scrub i {
        display: block;
        height: 100%;
        transform: scaleX(0.06);
        transform-origin: left;
        border-radius: var(--bb-radius-xs);
        background: linear-gradient(90deg, rgba(var(--bb-green-glow-rgb), 0.5), var(--bb-green-glow));
        animation: qwSongScrub 9s var(--bb-ease-out-expo) infinite;
    }

    @keyframes qwSongScrub {
        0%   { transform: scaleX(0.06); }
        100% { transform: scaleX(1); }
    }

    .qw-song__req {
        flex: none;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        text-align: right;
    }

    .qw-song__cmd {
        color: var(--bb-muted);
        opacity: 0;
        animation: qwSongReq 9s var(--bb-ease-out-expo) infinite;
    }

    .qw-song__ack {
        display: block;
        width: 100px;
        font-size: 0.68rem;
        color: var(--bb-green-glow);
        opacity: 0;
        animation: qwSongAck 9s var(--bb-ease-out-expo) infinite;
    }

    @keyframes qwSongReq {
        0%       { opacity: 0; transform: translateX(18px); }
        12%, 88% { opacity: 1; transform: none; }
        97%, 100% { opacity: 0; transform: translateX(18px); }
    }

    @keyframes qwSongAck {
        0%, 20%  { opacity: 0; transform: translateX(12px); }
        30%, 88% { opacity: 1; transform: none; }
        97%, 100% { opacity: 0; transform: translateX(12px); }
    }

    @media (max-width: 560px) {
        .qw-song__req { display: none; }
    }

    .qw__demo--govee {
        position: relative;
        flex-direction: row;
        align-items: center;
        gap: 16px;
    }

    .qw-govee__glow {
        position: absolute;
        inset: 0;
        opacity: 0.05;
        transform-origin: 38px 50%;
        animation: qwGoveeBloom 9s ease-in-out infinite;
        pointer-events: none;
        mask-image: radial-gradient(160px 50% at 38px 50%, #000 35%, transparent);
    }

    .qw-govee__glow i {
        background: radial-gradient(circle at 38px 50%, currentColor, transparent 72%);
    }

    .qw-govee__bulb {
        flex: none;
        place-items: center;
        animation: qwGoveeLit 9s ease-in-out infinite;
    }

    .qw-govee__bulb .qw-govee__tone:not(.qw-govee__tone--off) {
        filter: drop-shadow(0 0 5px currentColor) drop-shadow(0 0 16px currentColor);
    }

    .qw-govee__icon { width: 44px; height: 44px; }

    .qw-govee__redeem {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: min(280px, calc(100% - 60px));
        color: var(--bb-muted);
        opacity: 0;
        animation: qwGoveeRedeem 9s ease-in-out infinite;
    }

    .qw-govee__redeem-text {
        flex: 1 1 0;
        min-width: 0;
        height: calc(2 * 1lh);
    }

    .qw-govee__dot {
        flex: none;
        width: 7px;
        height: 7px;
    }

    .qw-govee__dot i {
        border-radius: 50%;
        background: currentColor;
        box-shadow: 0 0 8px currentColor;
    }

    .qw-govee__tone {
        opacity: 0;
        animation-duration: 9s;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
    }

    .qw-govee__tone--off { color: var(--bb-gray-4-dark); opacity: 1; animation-name: qwGoveeOff; }
    .qw-govee__tone--green { color: var(--bb-green-glow); animation-name: qwGoveeGreen; }
    .qw-govee__tone--tan { color: var(--bb-tan-light); animation-name: qwGoveeTan; }
    .qw-govee__tone--red { color: var(--bb-status-danger); animation-name: qwGoveeRed; }

    @keyframes qwGoveeOff {
        0%, 28% { opacity: 1; }
        40%, 82% { opacity: 0; }
        100% { opacity: 1; }
    }

    @keyframes qwGoveeGreen {
        0%, 28% { opacity: 0; }
        40%, 50% { opacity: 1; }
        62%, 100% { opacity: 0; }
    }

    @keyframes qwGoveeTan {
        0%, 50% { opacity: 0; }
        62%, 72% { opacity: 1; }
        82%, 100% { opacity: 0; }
    }

    @keyframes qwGoveeRed {
        0%, 72% { opacity: 0; }
        82% { opacity: 1; }
        100% { opacity: 0; }
    }

    @keyframes qwGoveeBloom {
        0%, 28%   { opacity: 0.05; transform: scale(0.85); }
        44%, 82%  { opacity: 0.3;  transform: scale(1); }
        100%      { opacity: 0.05; transform: scale(0.85); }
    }

    @keyframes qwGoveeLit {
        0%, 28%  { opacity: 0.5; }
        44%, 82% { opacity: 1; }
        100%     { opacity: 0.5; }
    }

    @keyframes qwGoveeRedeem {
        0%, 26%  { opacity: 0; transform: translateY(4px); }
        34%, 84% { opacity: 1; transform: none; }
        94%, 100% { opacity: 0; }
    }

    .qw-cmd__in {
        color: var(--bb-tan-light);
        width: 18ch;
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        border-right: 1px solid color-mix(in srgb, var(--bb-tan-light) 60%, transparent);
        animation: qwType 5.4s steps(18) infinite;
    }

    .qw-cmd__out {
        display: block;
        height: 1lh;
        white-space: nowrap;
        color: var(--bb-green-glow);
        opacity: 0;
        animation: qwCmdOut 5.4s ease-in-out infinite;
    }

    @keyframes qwType {
        0%, 6% { width: 0; }
        30%, 92% { width: 18ch; }
        97%, 100% { width: 0; }
    }

    @keyframes qwCmdOut {
        0%, 34% { opacity: 0; transform: translateY(4px); }
        44%, 88% { opacity: 1; transform: none; }
        96%, 100% { opacity: 0; }
    }

    .qw-queue__row {
        display: flex;
        gap: 10px;
        align-items: baseline;
        color: var(--bb-tan-light);
    }

    .qw-queue__pos {
        font-weight: 500;
        font-size: 0.68rem;
        color: var(--bb-muted);
    }

    .qw-queue__row:nth-child(2) { color: var(--bb-green-glow); }

    .qw__demo--win { align-items: stretch; gap: 8px; }

    .qw-win__label {
        align-self: stretch;
        font-size: 0.62rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--bb-muted);
    }

    .qw-win__name {
        display: block;
        height: 1lh;
        font-size: clamp(1.6rem, 2.4vw, 2.2rem);
        line-height: 1;
        white-space: nowrap;
    }

    .qw__demo--beat { color: var(--bb-green-glow); padding: 18px 12px; }

    .qw-beat {
        display: block;
        width: 100%;
        height: 100%;
        animation: qwBeat 3.2s linear infinite;
    }

    .qw-beat__wipe {
        display: block;
        height: calc(100% + 24px);
        margin-block: -12px;
        padding-block: 12px;
        animation-duration: 3.2s;
        animation-timing-function: linear(0, 1 62%, 1);
        animation-iteration-count: infinite;
    }

    .qw-beat__wipe svg { display: block; width: 100%; height: 100%; overflow: visible; }

    .qw-beat__path {
        filter: drop-shadow(0 0 6px rgba(var(--bb-green-glow-rgb), 0.55));
    }

    @keyframes qwBeat {
        0%, 62% { opacity: 1; }
        78% { opacity: 0.25; }
        100% { opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .qw-govee__glow, .qw-govee__bulb, .qw-govee__tone, .qw-govee__redeem,
        .qw-cmd__in, .qw-cmd__out,
        .qw-song__eq i, .qw-song__scrub i, .qw-song__cmd, .qw-song__ack,
        .qw-beat {
            animation: none;
        }
        .qw-song__eq i { transform: scaleY(0.7); }
        .qw-song__scrub i { transform: scaleX(0.46); }
        .qw-song__cmd, .qw-song__ack { opacity: 1; transform: none; }
        .qw-govee__glow { opacity: 0.22; transform: none; }
        .qw-govee__bulb { opacity: 1; }
        .qw-govee__tone { opacity: 0; }
        .qw-govee__tone--green { opacity: 1; }
        .qw-govee__redeem { opacity: 1; }
        .qw-cmd__in { width: 18ch; border-right: none; }
        .qw-cmd__out { opacity: 1; }
    }

    @media (max-width: 640px) {
        .qw { padding-inline: 20px; }
    }
</style>

<script>
    import { bindOnce } from '../../script/bind';
    import { decode } from '@bagel/ui/lib/decode';
    import { reduceMotion } from '@bagel/ui/lib/motion-query';

    const NAMES = ['MikanMeerkat', 'SnackPackPanda', 'PrincessBarney', 'Ayshacinder', 'Lotti'];
    const SCRAMBLE = { charset: 'abcdefghijklmnopqrstuvwxyz_0123456789', durationMs: 900 };

    function setupWinner(el: HTMLElement) {
        if (reduceMotion.matches) return;

        let visible = false;
        let i = 0;
        let timer = 0;
        let stopDecode = () => {};

        function loop() {
            window.clearTimeout(timer);
            if (!visible || document.hidden) return;
            stopDecode();
            stopDecode = decode(el, NAMES[i++ % NAMES.length], SCRAMBLE);
            timer = window.setTimeout(loop, 4200);
        }

        const io = new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            if (visible) loop();
            else window.clearTimeout(timer);
        }, { rootMargin: '40px' });
        io.observe(el);
    }

    bindOnce('[data-qw-winner]', setupWinner);
</script>
