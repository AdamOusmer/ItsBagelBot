    /* Giveaway: entries fill an 8x2 pool, a ring hops between them, slows and
       settles on one, which lights up while the name decodes in below. 8.4s
       loop; the script in this file schedules the decode off the ring's
       animation events so both stay in step. The pool entries carry a
       staggered delay, so they also leave one by one after the draw. */

    .qw__demo--win {
        justify-content: center;
        gap: 12px;
    }

    .qw-win__msg {
        opacity: 0;
        animation-duration: 8.4s;
        animation-timing-function: ease;
