    .qw-win__name {
        display: block;
        height: 1lh;
        font-size: clamp(1.5rem, 2.2vw, 1.9rem);
        line-height: 1;
        white-space: nowrap;
    }

    @keyframes qwWinMsgOpen {
        0%, 2% { opacity: 0; transform: translateX(10px); animation-timing-function: var(--bb-ease-out-expo); }
        5%, 12% { opacity: 1; transform: none; }
        15%, 100% { opacity: 0; transform: translateX(-6px); }
    }

    @keyframes qwWinMsgJoin1 {
        0%, 14% { opacity: 0; transform: translateX(10px); animation-timing-function: var(--bb-ease-out-expo); }
        17%, 20% { opacity: 1; transform: none; }
        23%, 100% { opacity: 0; transform: translateX(-6px); }
    }

    @keyframes qwWinMsgJoin2 {
        0%, 20% { opacity: 0; transform: translateX(10px); animation-timing-function: var(--bb-ease-out-expo); }
        23%, 26% { opacity: 1; transform: none; }
        29%, 100% { opacity: 0; transform: translateX(-6px); }
    }

    @keyframes qwWinMsgDraw {
        0%, 27% { opacity: 0; transform: translateX(10px); animation-timing-function: var(--bb-ease-out-expo); }
        30%, 60% { opacity: 1; transform: none; }
        64%, 100% { opacity: 0; transform: translateX(-6px); }
    }

    @keyframes qwWinMsgClaim {
        0%, 68% { opacity: 0; transform: translateX(10px); animation-timing-function: var(--bb-ease-out-expo); }
        71%, 92% { opacity: 1; transform: none; }
        95%, 100% { opacity: 0; transform: translateX(-6px); }
    }

    @keyframes qwWinDot {
        0% { opacity: 0; transform: scale(0.3); animation-timing-function: var(--bb-ease-out-back); }
        3.5%, 73% { opacity: 1; transform: none; }
        77%, 100% { opacity: 0; transform: scale(0.6); }
    }

    @keyframes qwWinDots {
        0%, 60% { opacity: 1; }
        63%, 100% { opacity: 0.35; }
    }

    /* Hops hold with steps(), the last leg glides in, then the ring sits on the winner. */
    @keyframes qwWinRing {
        0%, 24% { opacity: 0; transform: translate(0, 0) scale(0.6); animation-timing-function: var(--bb-ease-out-back); }
        26% { opacity: 1; transform: translate(0, 0); animation-timing-function: steps(1, end); }
        27.6% { transform: translate(120px, 0); animation-timing-function: steps(1, end); }
        29.2% { transform: translate(48px, 24px); animation-timing-function: steps(1, end); }
        31% { transform: translate(48px, 0); animation-timing-function: steps(1, end); }
        32.9% { transform: translate(144px, 24px); animation-timing-function: steps(1, end); }
        34.9% { transform: translate(168px, 0); animation-timing-function: steps(1, end); }
        37.1% { transform: translate(24px, 24px); animation-timing-function: steps(1, end); }
        39.6% { transform: translate(168px, 24px); animation-timing-function: steps(1, end); }
        42.4% { transform: translate(72px, 0); animation-timing-function: steps(1, end); }
        45.7% { transform: translate(96px, 24px); animation-timing-function: steps(1, end); }
        49.6% { transform: translate(144px, 0); animation-timing-function: steps(1, end); }
        54.3% { transform: translate(24px, 0); animation-timing-function: var(--bb-ease-out-expo); }
        60%, 92% { opacity: 1; transform: translate(72px, 24px); }
        96%, 100% { opacity: 0; transform: translate(72px, 24px) scale(0.8); }
    }

    @keyframes qwWinPick {
        0%, 60% { opacity: 0; transform: scale(0.5); animation-timing-function: var(--bb-ease-out-back); }
        63% { opacity: 1; transform: scale(1.3); }
        67%, 92% { opacity: 1; transform: none; }
        96%, 100% { opacity: 0; transform: scale(0.8); }
    }

    @keyframes qwWinPulse {
        0%, 60% { opacity: 0; transform: scale(0.6); }
        61% { opacity: 0.9; }
        74%, 100% { opacity: 0; transform: scale(3.4); }
    }

    @keyframes qwWinResult {
        0%, 60% { opacity: 0; transform: translateY(8px); animation-timing-function: var(--bb-ease-out-expo); }
        65%, 92% { opacity: 1; transform: none; }
        96%, 100% { opacity: 0; transform: translateY(-4px); }
