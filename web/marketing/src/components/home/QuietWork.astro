    @media (prefers-reduced-motion: reduce) {
        .qw-govee__glow, .qw-govee__bulb, .qw-govee__tone, .qw-govee__redeem,
        .qw-cmd__in, .qw-cmd__out,
        .qw-song__glow i, .qw-song__vinyl i, .qw-song__title,
        .qw-song__scrub > :global(span), .qw-song__cmd, .qw-song__ack, .qw-song__list, .qw-song__item,
        .qw-song__pos-was, .qw-song__pos-now,
        .qw-queue__msg, .qw-queue__list, .qw-queue__row, .qw-queue__row--a::after, .qw-queue__tag,
        .qw-queue__joined, .qw-queue__pos-was, .qw-queue__pos-now,
        .qw-win__msg, .qw-win__dots, .qw-win__dots i, .qw-win__pick, .qw-win__pulse, .qw-win__ring,
        .qw-win__result {
            animation: none;
        }
