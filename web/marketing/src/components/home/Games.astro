import { SITE } from '@bagel/kit/site-links';

import ButtonLink from '@bagel/ui/astro/ButtonLink.astro';
import Card from '@bagel/ui/astro/Card.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Icon from '@bagel/ui/astro/Icon.astro';
import Section from '@bagel/ui/astro/Section.astro';
import SectionHeading from '@bagel/ui/astro/SectionHeading.astro';
import Text from '@bagel/ui/astro/Text.astro';
import TextLink from '@bagel/ui/astro/TextLink.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const [legalShortBefore, legalShortAfter = ''] = t('games.legalShort').split('{terms}');
---

<Section size="page" class="games" id="integrations" data-motion>
    <SectionHeading eyebrow={t('games.eyebrow')} title={t('games.title')} />

    <div class="games__grid">
        <Card atmo hover class="games__card" label={t('games.mcCh')} data-reveal>
            <div class="games__demo games__demo--mc" slot="band" aria-hidden="true">
                <div class="games-mc__group games-mc__group--bw">
                    <span class="games-mc__line games-mc__line--bw">!bwstats player123</span>
                    <div class="games-mc__stats games-mc__stats--bw">
                        <span class="games-mc__stat"><b class="games-stat__key">Level</b> 402</span>
                        <span class="games-mc__stat"><b class="games-stat__key">Wins</b> 2,541</span>
                        <span class="games-mc__stat"><b class="games-stat__key">FKDR</b> 4.82</span>
                    </div>
                </div>
                <div class="games-mc__group games-mc__group--mcsr">
                    <span class="games-mc__line games-mc__line--mcsr">!mcsr ranked</span>
                    <div class="games-mc__stats games-mc__stats--mcsr">
                        <span class="games-mc__stat"><b class="games-stat__key">Elo</b> 1520</span>
                        <span class="games-mc__stat"><b class="games-stat__key">W/L</b> 142/98</span>
                    </div>
                </div>
            </div>
            <Heading level={5} as="h3" variant="title" class="games__title">{t('games.mcTitle')}</Heading>
            <Text size="sm" tone="muted">{t('games.mcDesc')}</Text>
        </Card>

        <Card atmo hover class="games__card" label={t('games.fnCh')} data-reveal style="--reveal-i: 1">
            <div class="games__demo games__demo--fn" slot="band" aria-hidden="true">
                <svg class="games-fn__scar" viewBox="0 0 220 72" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 32 L30 29 L30 47 L14 50 Z" />
                    <path d="M14 36 L27 34.5" stroke-width="1.5" />
                    <path d="M30 27 H134 V47 H30 Z" />
                    <path d="M34 27 V22 H128 V27" />
                    <path d="M44 22 v3 M56 22 v3 M68 22 v3 M80 22 v3 M92 22 v3 M104 22 v3 M116 22 v3" stroke-width="1.5" />
                    <path d="M40 22 v-5 h7 v5" />
                    <path d="M62 22 v-4" />
                    <path d="M84 33 h20 v7 H84 Z" stroke-width="1.5" />
                    <path d="M76 47 q1 9 10 9 h8" />
                    <path d="M98 47 L94 64 L104 66 L109 47" />
                    <path d="M112 47 C110 57 114 64 123 66 L133 62 C128 56 128 51 129 47 Z" />
                    <path d="M134 31 H184 M134 41 H184" />
                    <path d="M152 31 v-8 h7 v8" />
                    <path d="M184 28 h16 l4 4 v6 l-4 4 h-12 Z" />
                    <path d="M190 32 v8 M196 32 v8" stroke-width="1.5" />
                </svg>
                <div class="games-fn__meta">
                    <span class="games-fn__rarity">Legendary</span>
                    <span class="games-fn__price">
                        <svg viewBox="0 0 12 12" width="11" height="11" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="6" cy="6" r="2" fill="currentColor"/></svg>
                        1,200
                    </span>
                </div>
            </div>
            <Heading level={5} as="h3" variant="title" class="games__title">{t('games.fnTitle')}</Heading>
            <Text size="sm" tone="muted">{t('games.fnDesc')}</Text>
        </Card>

        <Card atmo hover class="games__card" label={t('games.valCh')} data-reveal style="--reveal-i: 2">
            <div class="games__demo games__demo--val" slot="band" aria-hidden="true">
                <span class="games-val__line">!valrank Frosty#EUW1</span>
                <div class="games-val__stats">
                    <span class="games-val__stat"><b class="games-stat__key">Tier</b> Immortal 2</span>
                    <span class="games-val__stat"><b class="games-stat__key">RR</b> 67</span>
                    <span class="games-val__stat"><b class="games-stat__key">Peak</b> Immortal 1</span>
                </div>
            </div>
            <Heading level={5} as="h3" variant="title" class="games__title">{t('games.valTitle')}</Heading>
            <Text size="sm" tone="muted">{t('games.valDesc')}</Text>
            <TextLink variant="arrow" tone="go" class="games__more" href={localizePath('/valorant-stats', lang)} label={t('rail.learnMore')} />
        </Card>

        <Card atmo hover class="games__card" label={t('games.crCh')} data-reveal style="--reveal-i: 3">
            <div class="games__demo games__demo--cr" slot="band" aria-hidden="true">
                <span class="games-cr__line">!cr #P2LQ0GR</span>
                <div class="games-cr__stats">
                    <span class="games-cr__stat"><b class="games-stat__key">Level</b> 62</span>
                    <span class="games-cr__stat"><b class="games-stat__key">W/L</b> 600/300</span>
                    <span class="games-cr__stat"><b class="games-stat__key">WR</b> 60%</span>
                </div>
            </div>
            <Heading level={5} as="h3" variant="title" class="games__title">{t('games.crTitle')}</Heading>
            <Text size="sm" tone="muted">{t('games.crDesc')}</Text>
        </Card>

        <Card atmo hover class="games__card games__card--req" label={t('games.reqCh')} data-reveal style="--reveal-i: 4">
            <div class="games__demo games__demo--req" slot="band" aria-hidden="true">
                <ButtonLink variant="tan" href={`${SITE.github}/issues/new`} target="_blank" rel="noopener noreferrer">
                    <Icon name="githubLine" />
                    New Issue
                </ButtonLink>
            </div>
            <Heading level={5} as="h3" variant="title" class="games__title">{t('games.reqTitle')}</Heading>
            <Text size="sm" tone="muted">{t('games.reqDesc')}</Text>
        </Card>
    </div>

    <Text size="xs" mono tone="muted" class="games__legal">{legalShortBefore}<TextLink
        variant="inline"
        href={localizePath('/terms', lang)}
    >{t('games.legalTermsLabel')}</TextLink>{legalShortAfter}</Text>
</Section>

<style>
    .games {
        position: relative;
        padding-inline: 24px;
        max-width: var(--bb-content-max);
        margin: 0 auto;
        z-index: 3;
    }

    .games__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        --card-band-h: 132px;
    }

    @media (min-width: 720px) {
        .games__grid { grid-template-columns: repeat(3, 1fr); }
        .games__card--req { grid-column: span 2; }
    }

    .games__title {
        margin: 0 0 8px;
    }

    .games__more { margin-top: 14px; align-self: flex-start; }

    .games__demo {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        height: 100%;
        overflow: hidden;
        font-family: var(--bb-font-mono);
        font-size: 0.74rem;
    }

    .games__demo--mc {
        position: relative;
    }

    .games-mc__group {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        padding: 14px 16px;
    }

    .games-mc__line {
        color: var(--bb-tan-light);
        font-weight: 500;
        width: max-content;
        border-right: 1px solid color-mix(in srgb, var(--bb-tan-light) 60%, transparent);
        white-space: nowrap;
        overflow: hidden;
    }

    .games-mc__line--bw {
        animation: gamesTypeMcBw 12s steps(17) infinite;
    }

    .games-mc__line--mcsr {
        opacity: 0;
        animation: gamesTypeMcMcsr 12s steps(12) infinite;
    }

    .games-mc__stats {
        display: flex;
        gap: 12px;
        color: var(--bb-green-glow);
        opacity: 0;
        transform: translateY(4px);
    }

    .games-mc__stats--bw {
        animation: gamesFadeMcBw 12s ease-in-out infinite;
    }

    .games-mc__stats--mcsr {
        animation: gamesFadeMcMcsr 12s ease-in-out infinite;
    }

    .games-stat__key {
        color: var(--bb-muted);
        font-weight: 400;
        margin-right: 4px;
    }

    .games__demo--fn {
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
    }

    .games-fn__scar {
        width: 158px;
        height: auto;
        color: var(--bb-tan-light);
        filter: drop-shadow(0 0 10px color-mix(in srgb, var(--bb-tan-light) 22%, transparent));
        animation: gamesFnFloat 4.5s ease-in-out infinite;
    }

    .games-fn__meta {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .games-fn__rarity {
        color: var(--bb-green-glow);
        font-size: 0.66rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .games-fn__price {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--bb-muted);
        font-size: 0.7rem;
    }

    .games-val__line,
    .games-cr__line {
        color: var(--bb-tan-light);
        font-weight: 500;
        width: max-content;
        border-right: 1px solid color-mix(in srgb, var(--bb-tan-light) 60%, transparent);
        white-space: nowrap;
        overflow: hidden;
    }

    .games-val__stats,
    .games-cr__stats {
        display: flex;
        gap: 12px;
        color: var(--bb-green-glow);
        opacity: 0;
        transform: translateY(4px);
    }

    .games-val__line { animation: gamesTypeVal 12s steps(20) infinite; }
    .games-cr__line { animation: gamesTypeCr 12s steps(12) infinite; }
    .games-val__stats { animation: gamesFadeVal 12s ease-in-out infinite; }
    .games-cr__stats { animation: gamesFadeCr 12s ease-in-out infinite; }

    .games__demo--req {
        align-items: center;
    }

    @keyframes gamesTypeMcBw {
        0%, 4% { width: 0; opacity: 1; }
        13%, 42% { width: 17ch; opacity: 1; }
        47%, 100% { width: 17ch; opacity: 0; }
    }

    @keyframes gamesFadeMcBw {
        0%, 14% { opacity: 0; transform: translateY(4px); }
        20%, 42% { opacity: 1; transform: none; }
        47%, 100% { opacity: 0; transform: translateY(4px); }
    }

    @keyframes gamesTypeMcMcsr {
        0%, 52% { width: 0; opacity: 0; }
        54% { width: 0; opacity: 1; }
        62%, 92% { width: 12ch; opacity: 1; }
        97%, 100% { width: 12ch; opacity: 0; }
    }

    @keyframes gamesFadeMcMcsr {
        0%, 63% { opacity: 0; transform: translateY(4px); }
        69%, 92% { opacity: 1; transform: none; }
        97%, 100% { opacity: 0; transform: translateY(4px); }
    }

    @keyframes gamesFnFloat {
        0%, 100% { transform: translateY(1.5px); }
        50% { transform: translateY(-1.5px); }
    }

    @keyframes gamesTypeVal {
        0%, 4% { width: 0; opacity: 1; }
        20%, 88% { width: 20ch; opacity: 1; }
        94%, 100% { width: 20ch; opacity: 0; }
    }

    @keyframes gamesFadeVal {
        0%, 24% { opacity: 0; transform: translateY(4px); }
        32%, 84% { opacity: 1; transform: none; }
        92%, 100% { opacity: 0; transform: translateY(4px); }
    }

    @keyframes gamesTypeCr {
        0%, 4% { width: 0; opacity: 1; }
        16%, 88% { width: 12ch; opacity: 1; }
        94%, 100% { width: 12ch; opacity: 0; }
    }

    @keyframes gamesFadeCr {
        0%, 22% { opacity: 0; transform: translateY(4px); }
        30%, 84% { opacity: 1; transform: none; }
        92%, 100% { opacity: 0; transform: translateY(4px); }
    }

    .games__legal {
        margin: 28px auto 0;
        max-width: 720px;
        text-align: center;
        opacity: 0.75;
    }

    @media (prefers-reduced-motion: reduce) {
        .games-mc__line {
            animation: none;
            border-right: none;
        }
        .games-mc__line--bw { width: 17ch; opacity: 1; }
        .games-mc__stats--bw {
            animation: none;
            opacity: 1;
            transform: none;
        }
        .games-mc__group--mcsr { display: none; }
        .games-fn__scar { animation: none; }
        .games-val__line,
        .games-cr__line {
            animation: none;
            border-right: none;
        }
        .games-val__line { width: 20ch; opacity: 1; }
        .games-cr__line { width: 12ch; opacity: 1; }
        .games-val__stats,
        .games-cr__stats {
            animation: none;
            opacity: 1;
            transform: none;
        }
    }

    @media (max-width: 640px) {
        .games { padding-inline: 20px; }
        .games-mc__stats { flex-wrap: wrap; gap: 8px; }
    }
</style>
