import Text from '@bagel/ui/astro/Text.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="letter" id="letter">
    <div class="letter__paper" data-reveal>
        <Text as="div" size="xs" mono tone="muted" class="letter__meta">
            <span>notes.txt</span>
            <span class="letter__meta2"><span data-fit>{t('letter.meta2')}</span></span>
        </Text>

        <Text class="letter__line letter__line--1"><span data-fit="block" data-fit-group="letter">{t('letter.line1')}</span></Text>

        <Text class="letter__line letter__line--2"><span data-fit="block" data-fit-group="letter">{t('letter.line2')}</span></Text>

        <Text class="letter__line letter__line--3"><span data-fit="block" data-fit-group="letter">{t('letter.line3')}</span></Text>

        <div class="letter__sign">
            <span class="letter__signature"><span class="letter__signature-text" data-fit>{t('letter.signature')}</span></span>
            <button type="button" class="letter__stamp" data-letter-stamp aria-label={t('letter.stampAria')}>
                🥯
            </button>
        </div>

        <Text as="span" size="xs" mono tone="muted" class="letter__ps"><span data-fit>{t('letter.ps')}</span></Text>
    </div>
</section>

<style>
    .letter {
        position: relative;
        padding: var(--bb-space-section) 24px;
        max-width: none;
        margin: 0;
        z-index: 3;
        display: flex;
        justify-content: center;
        overflow: hidden;
        scroll-margin-top: calc(var(--nav-offset) + 16px);
    }

    .letter::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 100vmin;
        height: 80vmin;
        translate: -50% -50%;
        pointer-events: none;
        background: radial-gradient(
            50% 55% at 50% 50%,
            rgba(var(--bb-tan-rgb), 0.1) 0%,
            transparent 70%
        );
        filter: blur(14px);
    }

    .letter__paper {
        position: relative;
        width: min(560px, 100%);
        background: linear-gradient(160deg, rgba(var(--bb-white-rgb), 0.014), transparent), var(--bb-card-bg);
        border: 1px solid rgba(var(--bb-tan-rgb), 0.2);
        border-radius: var(--bb-radius-md);
        padding: clamp(28px, 5vw, 48px);
        rotate: -0.6deg;
        box-shadow:
            0 30px 80px rgba(var(--bb-shadow-rgb), 0.55),
            inset 0 1px 0 rgba(var(--bb-white-rgb), 0.04);
        transition: rotate var(--bb-dur-slow) var(--bb-ease-out-expo), box-shadow var(--bb-dur-slow) var(--bb-ease-out-expo);
    }

    @media (hover: hover) and (pointer: fine) {
        .letter__paper:hover {
            rotate: 0deg;
            box-shadow:
                0 36px 90px rgba(var(--bb-shadow-rgb), 0.6),
                0 0 60px rgba(var(--bb-tan-rgb), 0.07),
                inset 0 1px 0 rgba(var(--bb-white-rgb), 0.05);
        }
    }

    .letter__meta {
        display: flex;
        justify-content: space-between;
        border-bottom: 1px dashed rgba(var(--bb-tan-rgb), 0.18);
        padding-bottom: 14px;
        margin-bottom: 26px;
    }

    .letter__meta2 {
        width: 120px;
        text-align: right;
    }

    .letter__line {
        height: calc(var(--letter-lines, 4) * 1lh);
        line-height: 1.8;
        color: rgba(var(--bb-white-rgb), 0.82);
        margin: 0 0 20px;
    }

    .letter__sign {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 32px;
    }

    .letter__signature {
        flex: 1 1 0;
        min-width: 0;
        font-family: var(--bb-font-hand);
        font-size: clamp(1.5rem, 3.4vw, 1.9rem);
        font-weight: 600;
        color: var(--bb-tan-light);
        line-height: 1;
    }

    .letter__signature-text {
        position: relative;
    }

    .letter__signature-text::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -8px;
        width: 100%;
        height: 2px;
        border-radius: var(--bb-radius-pill);
        background: linear-gradient(90deg, rgba(var(--bb-tan-rgb), 0.7), rgba(var(--bb-green-glow-rgb), 0.5));
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 900ms var(--bb-ease-out-expo) 600ms;
    }

    .letter__paper.is-revealed .letter__signature-text::after {
        transform: scaleX(1);
    }

    .letter__stamp {
        flex-shrink: 0;
        display: grid;
        place-items: center;
        width: 58px;
        height: 58px;
        font-size: 1.5rem;
        border-radius: 50%;
        border: 1.5px dashed rgba(var(--bb-tan-rgb), 0.4);
        rotate: 8deg;
        cursor: pointer;
        transition: rotate var(--bb-dur-base) var(--bb-ease-out-back),
                    border-color var(--bb-dur-fast) ease,
                    background var(--bb-dur-fast) ease;
    }

    @media (hover: hover) and (pointer: fine) {
        .letter__stamp:hover {
            rotate: -6deg;
            border-color: rgba(var(--bb-tan-rgb), 0.7);
            background: rgba(var(--bb-tan-rgb), 0.06);
        }
    }

    .letter__stamp:active { rotate: 14deg; }

    .letter__stamp.is-stamped {
        animation: stampPress var(--bb-dur-base) var(--bb-ease-out-back);
    }

    @keyframes stampPress {
        0% { scale: 1; }
        40% { scale: 0.82; }
        100% { scale: 1; }
    }

    .letter__ps {
        display: block;
        margin-top: 26px;
        opacity: 0.7;
    }

    @media (max-width: 600px) {
        .letter__line--1 { --letter-lines: 6; }
        .letter__line--2,
        .letter__line--3 { --letter-lines: 5; }
    }

    @media (prefers-reduced-motion: reduce) {
        .letter__paper { rotate: 0deg; transition: none; }
        .letter__signature-text::after { transform: scaleX(1); transition: none; }
        .letter__stamp { transition: none; }
        .letter__stamp.is-stamped { animation: none; }
    }
</style>

<script>
    import { bindOnce } from '../../script/bind';
    import { reduceMotion } from '@bagel/ui/lib/motion-query';

    function sprinkle(x: number, y: number) {
        if (reduceMotion.matches) return;
        const count = 10 + Math.floor(Math.random() * 6);
        for (let i = 0; i < count; i++) {
            const seed = document.createElement('span');
            seed.className = 'sesame-seed';
            seed.style.left = `${x + (Math.random() - 0.5) * 70}px`;
            seed.style.top = `${y + (Math.random() - 0.5) * 70}px`;
            seed.style.setProperty('--rot', `${Math.floor(Math.random() * 360)}deg`);
            document.body.appendChild(seed);
            window.setTimeout(() => seed.remove(), 1100);
        }
    }

    bindOnce('[data-letter-stamp]', (stamp) => {
        stamp.addEventListener('click', (event) => {
            stamp.classList.remove('is-stamped');
            void stamp.offsetWidth;
            stamp.classList.add('is-stamped');
            sprinkle(event.clientX || 0, event.clientY || 0);
        });
    });
</script>
