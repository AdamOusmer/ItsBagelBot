import { getImage } from 'astro:assets';
import Brand from '@bagel/ui/astro/Brand.astro';
import ButtonLink from '@bagel/ui/astro/ButtonLink.astro';
import Text from '@bagel/ui/astro/Text.astro';
import logoImage from '../../assets/LogoBOT.png';
import LightField from '@bagel/ui/astro/LightField.astro';
import brandTokens from '@bagel/ui/styles/brand.css?raw';
import { parts, type Palette } from '@luzir/bolota';

import { getLangFromUrl, useTranslations, dashLoginHref, localizePath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const heroLogo = await getImage({ src: logoImage, width: 320, height: 320, format: 'webp' });

function token(name: string): string {
    const value = brandTokens.match(new RegExp(`--${name}:\\s*(#[0-9a-fA-F]{3,8})\\s*;`))?.[1];
    if (!value) throw new Error(`@bagel/ui brand.css has no color token --${name}`);
    return value;
}

const PALETTES: Palette[] = ['bb-green-glow', 'bb-tan-light', 'bb-tan-pale'].map((head) => ({
    head: token(head),
    eye: token('bb-black'),
}));

type Row = 'back' | 'mid' | 'front' | 'hero';

interface Seat {
    name: string;
    x: number;
    row: Row;
    size: number;
    palette: number;
    wide?: boolean;
}

const SEATS: Seat[] = [
    { name: 'ttv_marguerite', x: 3, row: 'back', size: 64, palette: 1, wide: true },
    { name: 'noodle_arms', x: 13, row: 'back', size: 72, palette: 2, wide: true },
    { name: 'glazed_val', x: 26, row: 'back', size: 60, palette: 0, wide: true },
    { name: 'byte_sized_ben', x: 36, row: 'back', size: 70, palette: 1 },
    { name: 'seedling_sky', x: 49, row: 'back', size: 58, palette: 2 },
    { name: 'the_other_sam', x: 62, row: 'back', size: 66, palette: 2 },
    { name: 'caramel_cass', x: 19, row: 'back', size: 56, palette: 0, wide: true },
    { name: 'pixel_pavlova', x: 80, row: 'back', size: 60, palette: 1, wide: true },
    { name: 'oven_mitt', x: 72, row: 'back', size: 74, palette: 0, wide: true },
    { name: 'frosty_fern', x: 86, row: 'back', size: 62, palette: 1, wide: true },
    { name: 'ash_runs_it', x: 97, row: 'back', size: 68, palette: 2, wide: true },

    { name: 'lumen_tv', x: 6, row: 'mid', size: 104, palette: 2, wide: true },
    { name: 'dusty_crumbs', x: 21, row: 'mid', size: 118, palette: 0 },
    { name: 'sesame_sam', x: 36, row: 'mid', size: 96, palette: 1 },
    { name: 'tobi_plays', x: 50, row: 'mid', size: 88, palette: 2, wide: true },
    { name: 'crumb_lord', x: 64, row: 'mid', size: 110, palette: 1 },
    { name: 'kiki_bakes', x: 79, row: 'mid', size: 122, palette: 2 },
    { name: 'moonpie_mo', x: 94, row: 'mid', size: 100, palette: 0, wide: true },

    { name: 'nightfall_jo', x: 11, row: 'front', size: 196, palette: 1 },
    { name: 'ren_exe', x: 30, row: 'front', size: 172, palette: 2 },
    { name: 'oven_fresh', x: 50, row: 'hero', size: 290, palette: 0 },
    { name: 'mirafox', x: 70, row: 'front', size: 180, palette: 1 },
    { name: 'kassidy_mod', x: 89, row: 'front', size: 204, palette: 2 },
];

const poses = SEATS.map((seat, i) => ({
    seat,
    delay: (i * 37) % 11,
    inner: parts(seat.name, { size: seat.size, palette: PALETTES[seat.palette], background: false }).inner,
}));

const titleWords = `${t('hero.title1')} ${t('hero.title2')}`.split(' ');
---

<header class="hero" data-hero-progress>

    <div class="starfield" aria-hidden="true">
        <LightField class="bb-light-field--bleed" />
    </div>

    <div class="bg" aria-hidden="true">
        <div class="bb-orb bb-orb--halo bb-orb--green orb orb-1"><i class="bb-orb__pulse"></i></div>
        <div class="bb-orb bb-orb--halo bb-orb--tan orb orb-2"><i class="bb-orb__pulse"></i></div>
    </div>

    <div class="material">
        <div class="eyebrow">
            <span class="eyebrow__beta"><span class="eyebrow__beta-label"><span data-fit>{t('hero.devBadge')}</span></span></span>
            <Brand title="ItsBagelBot" logoSrc={heroLogo.src} wordmark size="lg" class="eyebrow__brand" />
        </div>

        <h1 data-hero-title><span data-fit="block">{titleWords.map((word, i) => (
            <>{i > 0 && ' '}<span class="word" data-hero-word>{word}</span></>
        ))}</span></h1>

        <Text tone="muted-soft" size="md" class="lede"><span data-fit="block">{t('hero.lede')}</span></Text>

        <div class="actions">
            <ButtonLink class="cta" href={dashLoginHref(lang)} variant="twitch"><span data-fit>{t('nav.cta')}</span></ButtonLink>
            <ButtonLink class="cta" variant="secondary" href={localizePath('/import', lang)}><span data-fit>{t('hero.importCta')}</span></ButtonLink>
        </div>
    </div>

    <div class="crowd" aria-hidden="true" data-crowd>
        {poses.map(({ seat, delay, inner }) => (
            <div
                class:list={['seat', `seat--${seat.row}`, seat.wide && 'seat--wide']}
                style={`--x: ${seat.x}%; --s: ${seat.size}px; --d: ${delay}`}
            >
                <div class="bob">
                    <svg
                        class="bolota"
                        viewBox="0 0 100 100"
                        data-bolota={seat.name}
                        data-size={seat.size}
                        data-head={PALETTES[seat.palette].head}
                        data-eye={PALETTES[seat.palette].eye}
                        set:html={inner}
                    />
                </div>
            </div>
        ))}
    </div>

</header>

<script>
    import '@luzir/bolota/motion.css';
    import { prefersReducedMotion } from '@bagel/ui/lib/motion-query';
    import { animate, stagger, cubicBezier } from 'motion';
    import type { EngineHandle } from '@luzir/bolota/engine';

    const easeOutQuint = cubicBezier(0.22, 1, 0.36, 1);

    const TITLE_DELAY = 0.3;
    const TITLE_WORD_STAGGER = 0.11;
    const EXPRESSIONS = ['happy', 'attentive', 'curious', 'proud', 'excited'];
    const EXPRESSION_MIN_MS = 2600;
    const EXPRESSION_SPREAD_MS = 3400;

    function titleIntro(): void {
        const h1 = document.querySelector<HTMLElement>('[data-hero-title]');
        if (!h1 || h1.dataset.heroMotionReady === 'true') return;
        h1.dataset.heroMotionReady = 'true';
        if (prefersReducedMotion()) return;

        const words = h1.querySelectorAll<HTMLElement>('[data-hero-word]');
        animate(
            words,
            {
                transform: ['translateY(112%) rotate(3deg)', 'translateY(0%) rotate(0deg)'],
                opacity: [0, 1],
                filter: ['blur(8px)', 'blur(0px)'],
            },
            { delay: stagger(TITLE_WORD_STAGGER, { startDelay: TITLE_DELAY }), duration: 0.9, ease: easeOutQuint },
        );
    }

    interface Live {
        svg: SVGSVGElement;
        handle: EngineHandle;
        expression: string | null;
        timer: ReturnType<typeof setTimeout> | null;
    }

    let engines: Live[] = [];
    let observer: IntersectionObserver | null = null;
    let mounting = false;
    let crowdVisible = false;
    let crowdFaded = false;
    let heroEl: HTMLElement | null = null;
    let heroFadeListener: ((event: Event) => void) | null = null;

    // The crowd sits at opacity 0 from two thirds of the hero scroll on; 24 idle engines kept animating it there.
    const crowdActive = () => crowdVisible && !crowdFaded;

    let enginePromise: Promise<typeof import('@luzir/bolota/engine')> | null = null;
    const loadEngine = () => (enginePromise ??= import('@luzir/bolota/engine'));

    function leastUsedExpression(live: Live): string {
        const counts = new Map(EXPRESSIONS.map((name) => [name, 0]));
        engines.forEach((other) => {
            if (other !== live && other.expression) counts.set(other.expression, (counts.get(other.expression) ?? 0) + 1);
        });
        const options = EXPRESSIONS.filter((name) => name !== live.expression);
        const fewest = Math.min(...options.map((name) => counts.get(name) ?? 0));
        const pool = options.filter((name) => counts.get(name) === fewest);
        return pool[Math.floor(Math.random() * pool.length)];
    }

    function scheduleExpression(live: Live, delayMs: number): void {
        live.timer = setTimeout(() => {
            live.expression = leastUsedExpression(live);
            live.handle.setExpression(live.expression);
            scheduleExpression(live, EXPRESSION_MIN_MS + Math.random() * EXPRESSION_SPREAD_MS);
        }, delayMs);
    }

    async function mountCrowd(crowd: HTMLElement): Promise<void> {
        if (engines.length || mounting) return;
        mounting = true;
        const { mountEngine } = await loadEngine();
        if (!mounting) return;

        const visible = Array.from(crowd.querySelectorAll<SVGSVGElement>('[data-bolota]'))
            .filter((svg) => svg.getClientRects().length > 0);

        visible.forEach((svg) => {
            const handle = mountEngine(svg, svg.dataset.bolota ?? 'chatter', {
                size: Number(svg.dataset.size) || 100,
                palette: { head: svg.dataset.head ?? '', eye: svg.dataset.eye ?? '' },
                background: false,
            });
            handle.loop('idle');
            engines.push({ svg, handle, expression: null, timer: null });
        });

        engines.forEach((live) => scheduleExpression(live, Math.random() * EXPRESSION_SPREAD_MS));
        mounting = false;
        if (!crowdActive()) pauseCrowd();
    }

    function pauseCrowd(): void {
        engines.forEach((live) => {
            if (live.timer) clearTimeout(live.timer);
            live.timer = null;
            live.handle.stop();
        });
    }

    function resumeCrowd(): void {
        engines.forEach((live) => {
            live.handle.loop('idle');
            if (!live.timer) scheduleExpression(live, Math.random() * EXPRESSION_SPREAD_MS);
        });
    }

    function syncCrowd(crowd: HTMLElement): void {
        if (!crowdActive()) pauseCrowd();
        else if (engines.length) resumeCrowd();
        else mountCrowd(crowd);
    }

    function onCrowdVisibility(crowd: HTMLElement, visible: boolean): void {
        crowdVisible = visible;
        syncCrowd(crowd);
    }

    function onHeroFade(crowd: HTMLElement, event: Event): void {
        crowdFaded = Boolean((event as CustomEvent<{ faded: boolean }>).detail?.faded);
        syncCrowd(crowd);
    }

    function watchHeroFade(crowd: HTMLElement): void {
        heroEl = crowd.closest<HTMLElement>('[data-hero-progress]');
        if (!heroEl) return;
        crowdFaded = heroEl.style.getPropertyValue('--hero-ui-pointer-events') === 'none';
        heroFadeListener = (event) => onHeroFade(crowd, event);
        heroEl.addEventListener('itsbagelbot:hero-fade', heroFadeListener);
    }

    function unwatchHeroFade(): void {
        if (heroEl && heroFadeListener) heroEl.removeEventListener('itsbagelbot:hero-fade', heroFadeListener);
        heroEl = null;
        heroFadeListener = null;
        crowdFaded = false;
    }

    function unmountCrowd(): void {
        mounting = false;
        engines.forEach((live) => {
            if (live.timer) clearTimeout(live.timer);
            live.handle.destroy();
        });
        engines = [];
    }

    function crowdSetup(): void {
        const crowd = document.querySelector<HTMLElement>('[data-crowd]');
        if (!crowd || crowd.dataset.heroMotionReady === 'true') return;
        crowd.dataset.heroMotionReady = 'true';
        if (prefersReducedMotion()) return;

        watchHeroFade(crowd);
        if (typeof IntersectionObserver !== 'function') {
            onCrowdVisibility(crowd, true);
            return;
        }
        observer = new IntersectionObserver((entries) => {
            onCrowdVisibility(crowd, entries[0].isIntersecting);
        }, { threshold: 0.05 });
        observer.observe(crowd);
    }

    function teardown(): void {
        observer?.disconnect();
        observer = null;
        unwatchHeroFade();
        unmountCrowd();
    }

    function setup(): void {
        titleIntro();
        crowdSetup();
    }

    setup();
    document.addEventListener('astro:page-load', setup);
    document.addEventListener('astro:before-swap', teardown);
    window.addEventListener('pagehide', teardown);
</script>

<style>
    .hero {
        --hero-pad-x: 40px;
        --crowd-h: 360px;
        --crowd-scale: 1;

        height: 100vh;
        height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        text-align: center;
        padding: calc(var(--nav-offset) + clamp(40px, 8vh, 88px)) var(--hero-pad-x) 0;
        position: sticky;
        top: 0;
        z-index: 5;
        overflow: hidden;
        pointer-events: none;
    }

    .material {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: min(100%, 1160px);
        position: relative;
        z-index: 2;
        opacity: max(0, calc(1 - var(--hero-p, 0) * 1.5));
        transform: scale(calc(1 - var(--hero-p, 0) * 0.15));
        filter: blur(calc(var(--hero-p, 0) * 12px));
        transform-origin: center;
        will-change: var(--hero-content-will-change, opacity, transform, filter);
    }

    .eyebrow,
    .cta {
        pointer-events: var(--hero-ui-pointer-events, auto);
    }

    .starfield {
        display: var(--hero-decor-display, block);
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: max(0, calc(1 - var(--hero-p, 0) * 1.5));
        will-change: opacity;
    }

    .bg {
        display: var(--hero-decor-display, block);
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
    }

    .orb {
        --orb-scroll-glow: min(calc(var(--hero-p, 0) * 0.24), calc((1 - var(--hero-p, 0)) * 0.28));
        --bb-orb-opacity: max(0, calc(0.16 - var(--hero-p, 0) * 0.16), var(--orb-scroll-glow));
        --bb-orb-transform: scale(calc(1 - var(--hero-p, 0) * 0.82));
        --bb-orb-will-change: var(--hero-orb-will-change, opacity, transform);
        --bb-orb-core-opacity: min(calc(var(--hero-p, 0) * 1.2), calc((1 - var(--hero-p, 0)) * 1.1));
        --bb-orb-core-scale: calc(0.42 + var(--hero-p, 0) * 1.35);
        --bb-orb-core-will-change: var(--hero-orb-will-change, opacity, transform);
        --bb-orb-play-state: var(--hero-animation-state, running);
    }

    .orb-1 {
        width: 520px;
        height: 520px;
        top: -140px;
        right: -80px;
    }

    .orb-2 {
        width: 420px;
        height: 420px;
        bottom: -120px;
        left: -100px;
        --bb-orb-pulse-delay: 400ms;
    }

    .eyebrow {
        --hero-brand-size: min(calc((100vw - var(--hero-pad-x) * 2) / 9), 5.2rem);

        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
        margin-bottom: 28px;
        opacity: 0;
        animation: fadeUp 800ms 150ms var(--bb-ease-out-expo) forwards;
    }

    .eyebrow :global(.eyebrow__brand) {
        --brand-name-size: var(--hero-brand-size);
        flex: none;
        height: calc(var(--hero-brand-size) * 1.12);
    }

    .eyebrow :global(.eyebrow__brand .bb-brand__name) {
        letter-spacing: var(--bb-tracking-display);
        line-height: 1.12;
        background: linear-gradient(180deg, var(--bb-white) 40%, rgba(var(--bb-tan-light-rgb), 0.55));
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        filter: drop-shadow(0 0 36px rgba(var(--bb-tan-rgb), 0.18));
    }

    .eyebrow__beta {
        display: inline-flex;
        align-items: center;
        flex: none;
        width: 56px;
        height: 24px;
        font-family: var(--bb-font-body);
        font-size: var(--bb-text-md);
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--bb-green-glow);
        text-shadow: 0 0 18px rgba(var(--bb-green-glow-rgb), 0.45);
    }

    .eyebrow__beta-label {
        flex: 1 1 0;
        min-width: 0;
    }

    h1 {
        --h1-lines: 1;

        display: flex;
        flex-direction: column;
        justify-content: safe center;
        font-family: var(--bb-font-body);
        font-size: clamp(1.35rem, 2.2vw, 2.1rem);
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.01em;
        color: var(--bb-tan-pale);
        text-wrap: balance;
        width: min(100%, 900px);
        height: calc(var(--h1-lines) * 1lh);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .word {
        display: inline-block;
        transform-origin: 20% 90%;
        transition: none;
    }

    .lede {
        --lede-lines: 2;

        width: min(100%, 560px);
        height: calc(var(--lede-lines) * 1lh);
        display: flex;
        flex-direction: column;
        justify-content: safe center;
        line-height: 1.6;
        margin-bottom: 36px;
        opacity: 0;
        animation: fadeUp 0.9s 0.55s var(--bb-ease-out-expo) forwards;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        width: 100%;
        opacity: 0;
        animation: fadeUp 0.9s 0.75s var(--bb-ease-out-expo) forwards;
    }

    .cta {
        --btn-w: 216px;
        --btn-justify: center;
        --btn-min-h: 48px;
        --btn-pad: 13px 16px;
    }

    .crowd {
        display: var(--hero-decor-display, block);
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: var(--crowd-h);
        z-index: 1;
        pointer-events: none;
        opacity: max(0, calc(1 - var(--hero-p, 0) * 1.5));
        transform: translateY(calc(var(--hero-p, 0) * 40vh));
        will-change: opacity, transform;
    }

    .seat {
        position: absolute;
        left: var(--x);
        bottom: var(--row-bottom);
        width: calc(var(--s) * var(--crowd-scale));
        height: calc(var(--s) * var(--crowd-scale));
        transform: translateX(-50%);
        opacity: var(--row-opacity, 1);
        /* Do not inherit the scroll variable: it restyles every animated bolota subtree per frame. */
        --hero-p: 0;
    }

    .seat--back {
        --row-bottom: 60%;
        --row-opacity: 0.5;
    }

    .seat--mid {
        --row-bottom: 30%;
        --row-opacity: 0.8;
    }

    .seat--front {
        --row-bottom: -6%;
    }

    .seat--hero {
        --row-bottom: -8%;
        z-index: 2;
    }

    .bob {
        width: 100%;
        height: 100%;
        animation:
            riseIn 1.1s calc(0.5s + var(--d) * 0.09s) var(--bb-ease-out-back) both,
            bob 6.5s calc(var(--d) * -0.7s) ease-in-out infinite alternate;
        animation-play-state: var(--hero-animation-state, running), var(--hero-animation-state, running);
    }

    .bolota {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
        scale: 0.9;
    }

    @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
        .word {
            opacity: 0;
            transform: translateY(112%) rotate(3deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .eyebrow,
        .lede,
        .actions {
            opacity: 1;
            animation: none;
        }

        .bob {
            animation: none;
        }
    }

    @keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes riseIn {
        from {
            opacity: 0;
            transform: translateY(70%) scale(0.86);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @keyframes bob {
        from { translate: 0 0; }
        to { translate: 0 -7px; }
    }

    @media (max-height: 820px) and (min-width: 901px) {
        .hero {
            --crowd-h: 280px;
            padding-top: calc(var(--nav-offset) + 32px);
        }

        .eyebrow {
            --hero-brand-size: min(calc((100vw - var(--hero-pad-x) * 2) / 9), 4rem);
            gap: 14px;
            margin-bottom: 22px;
        }

        h1 {
            margin-bottom: 16px;
        }

        .lede {
            margin-bottom: 28px;
        }
    }

    @media (max-width: 900px) {
        .hero {
            --hero-pad-x: 20px;
            --crowd-h: 40svh;
            --crowd-scale: 0.74;
            height: auto;
            min-height: 100svh;
            padding: calc(var(--nav-offset) + 40px) var(--hero-pad-x) 0;
        }

        .crowd {
            position: relative;
            flex: 1 0 var(--crowd-h);
            width: calc(100% + var(--hero-pad-x) * 2);
            margin-top: 20px;
        }

        .eyebrow {
            gap: 14px;
            margin-bottom: 20px;
        }

        h1 {
            --h1-lines: 2;
            font-size: clamp(1.2rem, 4.6vw, 1.8rem);
            margin-bottom: 16px;
        }

        .lede {
            --lede-lines: 3;
            font-size: var(--bb-text-md);
            line-height: 1.55;
            margin-bottom: 28px;
        }

        .seat--wide {
            display: none;
        }
        .seat--back {
            --row-bottom: 78%;
        }

        .seat--mid {
            --row-bottom: 45%;
        }
    }

    @media (max-width: 480px) {
        .hero {
            --hero-pad-x: 16px;
            --crowd-h: 38svh;
            --crowd-scale: 0.64;
            padding-top: calc(var(--nav-offset) + 32px);
        }

        .eyebrow {
            gap: 12px;
            margin-bottom: 18px;
        }

        .lede {
            font-size: var(--bb-text-sm);
            margin-bottom: 24px;
        }

        .actions {
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .cta {
            --btn-w: 240px;
        }
    }
</style>
