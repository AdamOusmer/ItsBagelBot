import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import Code from '@bagel/ui/astro/Code.astro';
import Container from '@bagel/ui/astro/Container.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import RoundBadge from '@bagel/ui/astro/RoundBadge.astro';
import Section from '@bagel/ui/astro/Section.astro';
import SectionHeading from '@bagel/ui/astro/SectionHeading.astro';
import Timeline from '@bagel/ui/astro/Timeline.astro';
import TimelineItem from '@bagel/ui/astro/TimelineItem.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [
    {
        num: '01',
        title: t('steps.s1Title'),
        receipt: 'oauth ✓ · scopes ✓ · 1.2s',
    },
    {
        num: '02',
        title: t('steps.s2Title'),
        receipt: t('steps.s2Receipt'),
    },
    {
        num: '03',
        title: t('steps.s3Title'),
        receipt: t('steps.s3Receipt'),
    },
];
---

<Container width="hero" class="steps-wrap">
    <Section size="page" class="steps" id="how">
        <SectionHeading eyebrow={t('steps.eyebrow')} title={t('steps.title')} />

        <Timeline rail="bridge" draw class="steps__list" data-reveal>
            {steps.map((step, i) => (
                <TimelineItem dot={false} class="step" data-badge-host data-reveal style={`--reveal-i: ${i + 2}`}>
                    <RoundBadge size="lg" solid class="step__num" aria-hidden="true">{step.num}</RoundBadge>
                    <div class="step__body">
                        <Heading level={4} as="h3" class="step__title"><span data-fit="block">{step.title}</span></Heading>
                        <Code class="step__receipt"><span data-fit data-decode={step.receipt}>{step.receipt}</span></Code>
                    </div>
                </TimelineItem>
            ))}
        </Timeline>
    </Section>
</Container>

<style>
    .steps {
        --section-heading-lines: 3;
        --section-heading-lines-phone: 3;
        position: relative;
        z-index: 3;
        scroll-margin-top: calc(var(--nav-offset) + 16px);
    }

    .steps__list {
        --reveal-i: 2;
        --timeline-gap: 32px;
        --timeline-gutter: 0px;
        --timeline-rail-x: 27px;
    }

    .step {
        display: flex;
        gap: 28px;
        align-items: flex-start;
    }

    .step__num {
        font-family: var(--bb-font-mono);
        font-size: 0.8rem;
    }

    .step__body {
        flex: 1 1 0;
        min-width: 0;
    }

    .step__title {
        height: calc(var(--step-title-lines, 1) * 1lh);
        font-weight: 700;
        margin: 6px 0 12px;
    }

    @media (min-width: 1024px) {
        .steps__list {
            --timeline-rail-display: none;
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .step {
            flex-direction: column;
            gap: 16px;
        }

        .step__title {
            --step-title-lines: 2;
            margin-top: 0;
        }
    }

    .step__receipt {
        display: block;
        width: min(100%, 300px);
        font-size: var(--bb-text-xs);
        letter-spacing: 0.05em;
        padding: 6px 10px;
    }

    @media (max-width: 640px) {
        .steps-wrap { --container-pad: 20px; }
        .steps__list { --timeline-gap: 28px; --timeline-rail-x: 22px; }
        .step { gap: 18px; }
        .step__num { --round-badge-size: 44px; font-size: 0.72rem; }
    }
</style>
