import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import Heading from '@bagel/ui/astro/Heading.astro';
import LightField from '@bagel/ui/astro/LightField.astro';
import Section from '@bagel/ui/astro/Section.astro';
import SectionHeading from '@bagel/ui/astro/SectionHeading.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [
    {
        num: '01',
        title: t('steps.s1Title'),
        receipt: 'oauth ✓ · scopes ✓ · 1.2s',
    },
    {
        num: '02',
        title: t('steps.s2Title'),
        receipt: t('steps.s2Receipt'),
    },
    {
        num: '03',
        title: t('steps.s3Title'),
        receipt: t('steps.s3Receipt'),
    },
];
---

<Section size="page" class="steps" id="how">
    <LightField class="bb-light-field--bleed" />
    <SectionHeading eyebrow={t('steps.eyebrow')} title={t('steps.title')} />

    <ol class="steps__list" data-reveal>
        <span class="steps__rail" aria-hidden="true"></span>
        {steps.map((step, i) => (
            <li class="step" data-reveal style={`--reveal-i: ${i + 2}`}>
                <span class="step__num" aria-hidden="true">{step.num}</span>
                <div class="step__body">
                    <Heading level={4} as="h3" class="step__title"><span data-fit="block">{step.title}</span></Heading>
                    <span class="step__receipt"><span data-fit data-decode={step.receipt}>{step.receipt}</span></span>
                </div>
            </li>
        ))}
    </ol>
</Section>

<style>
    .steps {
        --section-heading-lines: 3;
        --section-heading-lines-phone: 3;
        position: relative;
        padding-inline: 24px;
        max-width: var(--bb-content-hero);
        margin: 0 auto;
        z-index: 3;
        scroll-margin-top: calc(var(--nav-offset) + 16px);
    }

    .steps__list {
        --reveal-i: 2;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 32px;
        padding-left: 0;
        margin: 0;
    }

    .steps__rail {
        position: absolute;
        left: 27px;
        top: 8px;
        bottom: 8px;
        width: 1px;
        background: linear-gradient(
            to bottom,
            rgba(var(--bb-green-glow-rgb), 0.5),
            rgba(var(--bb-tan-rgb), 0.4)
        );
        transform: scaleY(0);
        transform-origin: top;
        transition: transform 1400ms var(--bb-ease-out-expo) 200ms;
    }

    .steps__list.is-revealed .steps__rail {
        transform: scaleY(1);
    }

    .step {
        position: relative;
        display: flex;
        gap: 28px;
        align-items: flex-start;
    }

    .step__num {
        position: relative;
        z-index: 1;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: var(--bb-card-bg);
        border: 1px solid transparent;
        box-shadow: var(--bb-depth-1);
        font-family: var(--bb-font-mono);
        font-size: 0.8rem;
        color: var(--bb-tan-light);
        transition:
            border-color var(--bb-dur-base) var(--bb-ease-out-expo),
            box-shadow var(--bb-dur-base) var(--bb-ease-out-expo),
            color var(--bb-dur-base) ease;
    }

    @media (hover: hover) and (pointer: fine) {
        .step:hover .step__num {
            box-shadow: var(--bb-depth-2), 0 0 24px rgba(var(--bb-tan-rgb), 0.25);
            color: var(--bb-tan-pale);
        }
    }

    .step__body {
        flex: 1 1 0;
        min-width: 0;
    }

    .step__title {
        height: calc(var(--step-title-lines, 1) * 1lh);
        font-weight: 700;
        margin: 6px 0 12px;
    }

    @media (min-width: 1024px) {
        .steps__list {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 32px;
        }

        .steps__rail {
            display: none;
        }

        .step {
            flex-direction: column;
            gap: 16px;
        }

        .step__title {
            --step-title-lines: 2;
            margin-top: 0;
        }
    }

    .step__receipt {
        display: block;
        width: min(100%, 300px);
        font-family: var(--bb-font-mono);
        font-size: var(--bb-text-xs);
        letter-spacing: 0.05em;
        color: var(--bb-green-glow);
        background: rgba(var(--bb-green-glow-rgb), 0.06);
        border: 1px solid transparent;
        box-shadow: var(--bb-depth-0);
        border-radius: var(--bb-radius-sm);
        padding: 6px 10px;
        transition: box-shadow var(--bb-dur-base) ease;
    }

    @media (hover: hover) and (pointer: fine) {
        .step:hover .step__receipt {
            box-shadow: var(--bb-depth-0), 0 0 18px rgba(var(--bb-green-glow-rgb), 0.14);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .steps__rail {
            transform: none;
            transition: none;
        }
    }

    @media (max-width: 640px) {
        .steps { padding-inline: 20px; }
        .steps__list { gap: 28px; }
        .step { gap: 18px; }
        .step__num { width: 44px; height: 44px; font-size: 0.72rem; }
        .steps__rail { left: 22px; }
    }
</style>
