import SectionHeading from '@bagel/ui/astro/SectionHeading.astro';
import Container from '@bagel/ui/astro/Container.astro';
import Section from '@bagel/ui/astro/Section.astro';
import BentoGrid from './BentoGrid.astro';
import FeatureCard from './FeatureCard.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const NETWORK_HUB = { x: 180, y: 56 };
const NETWORK_NODES = [
    { x: 118, y: 14, wave: 0 },
    { x: 242, y: 14, wave: 0 },
    { x: 54, y: 20, wave: 1 },
    { x: 55, y: 92, wave: 1 },
    { x: 305, y: 92, wave: 1 },
    { x: 306, y: 20, wave: 1 },
];
const NETWORK_WAVES = [0, 1];
const nodesIn = (wave: number) => NETWORK_NODES.filter((node) => node.wave === wave);
---

<Container class="safe-wrap">
<Section size="page" class="safe" id="safety-layers" data-motion>
    <SectionHeading eyebrow={t('safetyLayers.eyebrow')} title={t('safetyLayers.title')}>
        <span slot="badge" class="safe__beta"><span class="safe__beta-label"><span data-fit>{t('badge.beta')}</span></span></span>
    </SectionHeading>

    <BentoGrid cols={3}>
        <FeatureCard tone="green" index={0}>
            <div slot="demo" class="safe__demo safe__demo--jury">
                <span class="jury__case"><span data-fit>{t('safetyLayers.spam')} / {t('safetyLayers.hate')}</span></span>
                <div class="jury__table">
                    <span class="jury__evidence">msg</span>
                    <span class="jury__seat jury__seat--tl" style="--jury-i: 0"><i></i><em>block</em></span>
                    <span class="jury__seat jury__seat--tr" style="--jury-i: 1"><i></i><em>block</em></span>
                    <span class="jury__seat jury__seat--l" style="--jury-i: 2"><i></i><em>block</em></span>
                    <span class="jury__seat jury__seat--r" style="--jury-i: 3"><i></i><em>allowed</em></span>
                    <span class="jury__seat jury__seat--bl" style="--jury-i: 4"><i></i><em>block</em></span>
                    <span class="jury__seat jury__seat--br" style="--jury-i: 5"><i></i><em>block</em></span>
                    <span class="jury__tally">
                        <small class="jury__verdict"><span data-fit>{t('safetyLayers.juryVerdict')}</span></small>
                        <b class="jury__count fcard-value">5-1</b>
                        <em>block</em>
                    </span>
                </div>
            </div>
            {t('safetyLayers.juryTitle')}
        </FeatureCard>

        <FeatureCard tone="green" index={1}>
            <div slot="demo" class="safe__demo safe__demo--gates">
                <div class="gates__lane bb-track">
                    <span class="gates__packet bb-layers"><span>MSG</span><span class="gates__packet-ok">MSG</span></span>
                    <span class="gates__gate" style="--gate-i: 0"><i></i><b class="gates__name"><span data-fit>{t('safetyLayers.gateRate')}</span></b></span>
                    <span class="gates__gate" style="--gate-i: 1"><i></i><b class="gates__name"><span data-fit>{t('safetyLayers.gateShape')}</span></b></span>
                    <span class="gates__gate" style="--gate-i: 2"><i></i><b class="gates__name"><span data-fit>{t('safetyLayers.gateLink')}</span></b></span>
                    <span class="gates__exit">✓</span>
                </div>
                <div class="gates__receipt">
                    <span class="gates__check"><span data-fit>{t('safetyLayers.gateRate')}&nbsp;<b class="gates__ok">✓</b></span></span>
                    <span class="gates__check"><span data-fit>{t('safetyLayers.gateShape')}&nbsp;<b class="gates__ok">✓</b></span></span>
                    <span class="gates__check"><span data-fit>{t('safetyLayers.gateLink')}&nbsp;<b class="gates__ok">✓</b></span></span>
                    <em><span data-fit>{t('safetyLayers.gatesPassed')}</span></em>
                </div>
            </div>
            {t('safetyLayers.gatesTitle')}
        </FeatureCard>

        <FeatureCard tone="green" index={2}>
            <div slot="demo" class="safe__demo safe__demo--network">
                <div class="network__map bb-layers">
                    {NETWORK_WAVES.map((wave) => (
                        <svg class="network__layer network__links" viewBox="0 0 360 112" style={`--wave-i: ${wave}`}>
                            {nodesIn(wave).map((node) => <path d={`M${NETWORK_HUB.x} ${NETWORK_HUB.y} L${node.x} ${node.y}`} />)}
                        </svg>
                    ))}
                    <svg class="network__layer network__base" viewBox="0 0 360 112">
                        {NETWORK_NODES.map((node) => <circle class="network__node" cx={node.x} cy={node.y} r="5" />)}
                        <circle class="network__ring" cx={NETWORK_HUB.x} cy={NETWORK_HUB.y} r="20" />
                        <circle class="network__dot" cx={NETWORK_HUB.x} cy={NETWORK_HUB.y} r="8" />
                    </svg>
                    {NETWORK_WAVES.map((wave) => (
                        <svg class="network__layer network__lit" viewBox="0 0 360 112" style={`--wave-i: ${wave}`}>
                            {nodesIn(wave).map((node) => <circle cx={node.x} cy={node.y} r="5" />)}
                        </svg>
                    ))}
                    <svg class="network__layer network__ping" viewBox="0 0 360 112">
                        <circle cx={NETWORK_HUB.x} cy={NETWORK_HUB.y} r="58" />
                    </svg>
                    <svg class="network__layer network__ring-alert" viewBox="0 0 360 112">
                        <circle cx={NETWORK_HUB.x} cy={NETWORK_HUB.y} r="20" />
                    </svg>
                    <svg class="network__layer network__dot-alert" viewBox="0 0 360 112">
                        <circle cx={NETWORK_HUB.x} cy={NETWORK_HUB.y} r="8" />
                    </svg>
                    <svg class="network__layer network__core-safe" viewBox="0 0 360 112">
                        <circle class="network__ring" cx={NETWORK_HUB.x} cy={NETWORK_HUB.y} r="20" />
                        <circle class="network__dot" cx={NETWORK_HUB.x} cy={NETWORK_HUB.y} r="8" />
                    </svg>
                </div>
                <span class="network__alert"><span data-fit>{t('safetyLayers.networkAlert')}</span></span>
                <span class="network__status"><span data-fit>{t('safetyLayers.networkStatus')}</span></span>
            </div>
            {t('safetyLayers.networkTitle')}
        </FeatureCard>
    </BentoGrid>
</Section>
</Container>

<style>
    .safe {
        --section-heading-lines: 2;
        --section-heading-lines-phone: 3;
        --fcard-demo-h: 170px;
        position: relative;
        z-index: 3;
    }

    .safe__beta {
        display: inline-flex;
        align-items: center;
        width: 56px;
        height: 24px;
        font-family: var(--bb-font-body);
        font-size: var(--bb-text-md);
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--bb-green-glow);
        text-shadow: 0 0 18px rgba(var(--bb-green-glow-rgb), 0.45);
    }

    .safe__beta-label {
        flex: 1 1 0;
        min-width: 0;
    }

    .safe__demo {
        position: relative;
        height: 100%;
        overflow: hidden;
        container-type: inline-size;
        font-family: var(--bb-font-mono);
        font-size: 0.66rem;
    }

    .safe__demo--jury {
        display: grid;
        place-items: center;
        padding: 0 4px;
    }

    .jury__case {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1lh;
        color: var(--bb-muted);
        font-size: 0.54rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .jury__table {
        position: relative;
        width: min(310px, 82%);
        height: 116px;
        border: 1px solid var(--bb-border);
        border-radius: 50%;
    }

    .jury__table::after {
        content: "";
        position: absolute;
        inset: 10px 24px;
        border: 1px solid var(--bb-border);
        border-radius: 50%;
        opacity: 0.5;
    }

    .jury__seat {
        position: absolute;
        z-index: 3;
        width: 24px;
        height: 30px;
    }

    .jury__seat i::before {
        content: "";
        position: absolute;
        top: 0;
        left: 8px;
        width: 8px;
        height: 8px;
        border: 1px solid var(--bb-muted);
        border-radius: 50%;
        background: var(--bb-bg-0);
    }

    .jury__seat::after {
        content: "";
        position: absolute;
        top: 0;
        left: 8px;
        width: 8px;
        height: 8px;
        border: 1px solid var(--bb-white);
        border-radius: 50%;
        background: var(--bb-bg-0);
        opacity: 0;
        animation: jurySeatThink 7.2s ease-in-out infinite;
        animation-delay: calc(var(--jury-i) * 70ms);
    }

    .jury__seat i::after {
        content: "";
        position: absolute;
        top: 11px;
        left: 4px;
        width: 16px;
        height: 9px;
        border: 1px solid var(--bb-muted);
        border-bottom: 0;
        border-radius: var(--bb-radius-sm) var(--bb-radius-sm) 0 0;
    }

    .jury__seat em {
        position: absolute;
        left: 50%;
        bottom: 3px;
        padding: 2px 4px;
        border: 1px solid rgba(var(--bb-status-danger-rgb), 0.42);
        border-radius: var(--bb-radius-xs);
        color: var(--bb-status-danger);
        background: var(--bb-bg-0);
        font-size: 0.42rem;
        font-style: normal;
        text-transform: uppercase;
        opacity: 0;
        transform: translate(-50%, 9px) scale(0.85);
        animation: juryBallot 7.2s ease infinite;
        animation-delay: calc(var(--jury-i) * 140ms);
    }

    .jury__seat--r em { color: var(--bb-green-glow); border-color: rgba(var(--bb-green-glow-rgb), 0.42); }

    .jury__evidence {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 50%;
        padding: 3px 7px;
        border: 1px solid rgba(var(--bb-status-danger-rgb), 0.5);
        border-radius: var(--bb-radius-xs);
        color: var(--bb-status-danger);
        background: var(--bb-bg-0);
        font-size: 0.52rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.72);
        animation: juryEvidence 7.2s ease infinite;
    }

    .jury__seat--tl { top: -9px; left: 22%; }
    .jury__seat--tr { top: -9px; right: 22%; }
    .jury__seat--l { top: 43px; left: -13px; }
    .jury__seat--r { top: 43px; right: -13px; }
    .jury__seat--bl { bottom: -11px; left: 22%; }
    .jury__seat--br { right: 22%; bottom: -11px; }

    .jury__tally {
        position: absolute;
        z-index: 2;
        inset: 14px 30%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
        text-align: center;
        opacity: 0;
        animation: juryTally 7.2s ease-in-out infinite;
    }

    .jury__verdict {
        align-self: stretch;
        color: var(--bb-muted);
        font-size: 0.44rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .jury__count {
        font-size: 2.4rem;
    }

    .jury__tally em {
        color: var(--bb-status-danger);
        font-size: 0.48rem;
        font-style: normal;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    @keyframes juryEvidence {
        0%, 2% { opacity: 0; transform: translate(-50%, -50%) scale(0.72); animation-timing-function: var(--bb-ease-out-back); }
        7% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        20% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        26%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
    }

    @keyframes jurySeatThink {
        0%, 8%, 24%, 100% { opacity: 0; }
        12%, 20% { opacity: 1; }
    }

    @keyframes juryBallot {
        0%, 24% { opacity: 0; transform: translate(-50%, 9px) scale(0.85); animation-timing-function: var(--bb-ease-out-back); }
        31% { opacity: 1; transform: translate(-50%, -7px) scale(1); }
        80% { opacity: 1; transform: translate(-50%, -7px) scale(1); }
        87%, 100% { opacity: 0; transform: translate(-50%, -4px) scale(0.95); }
    }

    @keyframes juryTally {
        0%, 38% { opacity: 0; transform: scale(1.18); }
        44% { opacity: 1; transform: scale(1); }
        88% { opacity: 1; transform: scale(1); }
        95%, 100% { opacity: 0; transform: scale(0.96); }
    }

    .safe__demo--gates {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 28px;
    }

    .gates__lane {
        position: relative;
        height: 68px;
    }

    .gates__lane::before {
        content: "";
        position: absolute;
        top: 25px;
        left: 8px;
        right: 8px;
        height: 1px;
        background: var(--bb-border);
    }

    .gates__packet {
        position: absolute;
        z-index: 3;
        top: 12px;
        left: 4px;
        display: grid;
        place-items: center;
        width: 36px;
        height: 27px;
        border: 1px solid transparent;
        box-shadow: var(--bb-depth-1);
        border-radius: var(--bb-radius-xs);
        color: var(--bb-muted);
        background: var(--bb-bg-0);
        opacity: 0;
        animation: gatePacket 7.2s ease infinite;
    }

    .gates__packet > * {
        align-self: center;
        justify-self: center;
    }

    .gates__packet::after {
        content: "";
        grid-area: 1 / 1;
        align-self: stretch;
        justify-self: stretch;
        margin: -1px;
        border: 1px solid rgba(var(--bb-green-glow-rgb), 0.64);
        border-radius: inherit;
    }

    .gates__packet-ok {
        color: var(--bb-green-glow);
    }

    .gates__packet::after,
    .gates__packet-ok {
        opacity: 0;
        animation: gatePacketOk 7.2s ease infinite;
    }

    .gates__gate {
        position: absolute;
        top: 2px;
        left: calc(29% + var(--gate-i) * 21%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        width: 60px;
        margin-left: -19px;
        color: var(--bb-muted);
    }

    .gates__gate i {
        position: relative;
        width: 1px;
        height: 48px;
        background: var(--bb-muted);
        transform-origin: top;
    }

    .gates__gate i::before,
    .gates__gate i::after {
        content: "";
        position: absolute;
        inset: 0;
        opacity: 0;
    }

    .gates__gate i::before {
        background: var(--bb-white);
    }

    .gates__gate i::after {
        background: var(--bb-green-glow);
    }

    .gates__gate i,
    .gates__gate i::before,
    .gates__gate i::after {
        animation-duration: 7.2s;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
        animation-delay: var(--gate-delay, 0s);
    }

    .gates__gate i { animation-name: gateOpen; }
    .gates__gate i::before { animation-name: gateScan; }
    .gates__gate i::after { animation-name: gateGreen; }
    .gates__gate:nth-child(3) { --gate-delay: 1.584s; }
    .gates__gate:nth-child(4) { --gate-delay: 3.024s; }

    .gates__name { align-self: stretch; font-size: 0.52rem; font-weight: 500; text-align: center; text-transform: uppercase; }

    .gates__exit {
        position: absolute;
        top: 13px;
        right: 2px;
        display: grid;
        place-items: center;
        width: 26px;
        height: 26px;
        border: 1px solid rgba(var(--bb-green-glow-rgb), 0.42);
        border-radius: 50%;
        color: var(--bb-green-glow);
        opacity: 0;
        animation: gateExit 7.2s ease infinite;
    }

    .gates__receipt {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        align-items: center;
        gap: 6px 10px;
        padding-top: 10px;
        border-top: 1px solid var(--bb-border);
        color: var(--bb-muted);
    }

    .gates__check {
        font-size: 0.54rem;
        text-transform: uppercase;
        opacity: 0.26;
        animation-duration: 7.2s;
        animation-timing-function: ease;
        animation-iteration-count: infinite;
    }
    .gates__check:nth-child(1) { animation-name: receiptOne; }
    .gates__check:nth-child(2) { animation-name: receiptTwo; }
    .gates__check:nth-child(3) { animation-name: receiptThree; }
    .gates__ok { color: var(--bb-green-glow); font-weight: 500; transition: none; }
    .gates__receipt em {
        grid-column: 1 / -1;
        text-align: left;
        color: var(--bb-green-glow);
        font-size: 0.58rem;
        font-style: normal;
        opacity: 0;
        animation: gateExit 7.2s ease infinite;
    }

    @keyframes gatePacket {
        0% { transform: none; opacity: 0; }
        2% { opacity: 1; animation-timing-function: var(--bb-ease-out-expo); }
        15% { transform: translateX(calc(29cqi - 50px)); }
        26% { transform: translateX(calc(29cqi - 50px)); animation-timing-function: var(--bb-ease-out-expo); }
        36% { transform: translateX(calc(50cqi - 50px)); }
        48% { transform: translateX(calc(50cqi - 50px)); animation-timing-function: var(--bb-ease-out-expo); }
        58% { transform: translateX(calc(71cqi - 50px)); }
        68% { transform: translateX(calc(71cqi - 50px)); animation-timing-function: var(--bb-ease-out-expo); }
        78% { transform: translateX(calc(100cqi - 78px)); }
        90% { transform: translateX(calc(100cqi - 78px)); opacity: 1; }
        95%, 100% { transform: translateX(calc(100cqi - 78px)); opacity: 0; }
    }

    @keyframes gatePacketOk {
        0% { opacity: 0; }
        78%, 100% { opacity: 1; }
    }

    @keyframes gateOpen {
        0%, 21% { transform: scaleY(1); }
        23%, 34% { transform: scaleY(0.18); }
        39%, 100% { transform: scaleY(1); }
    }

    @keyframes gateScan {
        0%, 16% { opacity: 0; }
        17.5%, 20% { opacity: 1; }
        21%, 100% { opacity: 0; }
    }

    @keyframes gateGreen {
        0%, 21% { opacity: 0; }
        23%, 34% { opacity: 1; }
        39%, 100% { opacity: 0; }
    }

    @keyframes gateExit {
        0%, 79% { opacity: 0; transform: scale(0.7); animation-timing-function: var(--bb-ease-out-back); }
        84% { opacity: 1; transform: scale(1); }
        92% { opacity: 1; transform: scale(1); }
        97%, 100% { opacity: 0; transform: scale(0.9); }
    }

    @keyframes receiptOne {
        0%, 22% { opacity: 0.26; transform: translateY(2px); }
        26% { opacity: 1; transform: none; }
        92% { opacity: 1; transform: none; }
        98%, 100% { opacity: 0.26; transform: translateY(2px); }
    }
    @keyframes receiptTwo {
        0%, 44% { opacity: 0.26; transform: translateY(2px); }
        48% { opacity: 1; transform: none; }
        92% { opacity: 1; transform: none; }
        98%, 100% { opacity: 0.26; transform: translateY(2px); }
    }
    @keyframes receiptThree {
        0%, 64% { opacity: 0.26; transform: translateY(2px); }
        68% { opacity: 1; transform: none; }
        92% { opacity: 1; transform: none; }
        98%, 100% { opacity: 0.26; transform: translateY(2px); }
    }

    .safe__demo--network { padding: 0; }

    .network__map {
        width: 100%;
        height: 100%;
    }

    .network__layer {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .network__links {
        fill: none;
        stroke: rgba(var(--bb-green-glow-rgb), 0.48);
        stroke-width: 1;
        opacity: 0;
        transform: scale(0);
        animation: networkLine 7.2s var(--bb-ease-out-expo) infinite;
        animation-delay: calc(var(--wave-i) * 200ms);
    }

    .network__node {
        fill: var(--bb-bg-0);
        stroke: var(--bb-muted);
        stroke-width: 1;
    }

    .network__ring {
        fill: none;
        stroke: var(--bb-muted);
    }

    .network__dot {
        fill: var(--bb-muted);
    }

    .network__lit {
        fill: var(--bb-green-glow);
        stroke: none;
        opacity: 0;
        animation: networkNode 7.2s ease-in-out infinite;
        animation-delay: calc(var(--wave-i) * 200ms);
    }

    .network__ping {
        fill: none;
        stroke: rgba(var(--bb-green-glow-rgb), 0.55);
        stroke-width: 1;
        opacity: 0;
        transform: scale(0.1724);
        animation: networkPing 7.2s ease-out infinite;
    }

    .network__ring-alert {
        fill: none;
        stroke: rgba(var(--bb-status-danger-rgb), 0.55);
        opacity: 0;
        animation: networkRingAlert 7.2s ease-in-out infinite;
    }

    .network__dot-alert {
        fill: var(--bb-status-danger);
        opacity: 0;
        animation: networkDotAlert 7.2s ease-in-out infinite;
    }

    .network__core-safe {
        opacity: 0;
        animation: networkCoreSafe 7.2s ease-in-out infinite;
    }

    .network__core-safe .network__ring { stroke: rgba(var(--bb-green-glow-rgb), 0.5); }
    .network__core-safe .network__dot { fill: var(--bb-green-glow); }

    .network__alert,
    .network__status {
        position: absolute;
        top: 0;
        width: min(160px, calc(50% - 4px));
        padding: 4px 7px;
        text-align: center;
        border-radius: var(--bb-radius-xs);
        font-size: 0.58rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .network__alert {
        left: 0;
        border: 1px solid rgba(var(--bb-status-danger-rgb), 0.42);
        color: var(--bb-status-danger);
        opacity: 0;
        animation: networkAlert 7.2s ease infinite;
    }

    .network__status {
        right: 0;
        border: 1px solid rgba(var(--bb-green-glow-rgb), 0.42);
        color: var(--bb-green-glow);
        opacity: 0;
        animation: networkStatus 7.2s ease infinite;
    }

    @keyframes networkDotAlert {
        0%, 2% { opacity: 0; }
        5%, 9%, 13% { opacity: 1; }
        7%, 11% { opacity: 0.4; }
        30% { opacity: 1; }
        40%, 100% { opacity: 0; }
    }

    @keyframes networkRingAlert {
        0%, 2% { opacity: 0; }
        6%, 30% { opacity: 1; }
        40%, 100% { opacity: 0; }
    }

    @keyframes networkCoreSafe {
        0%, 30% { opacity: 0; }
        40%, 86% { opacity: 1; }
        96%, 100% { opacity: 0; }
    }

    @keyframes networkPing {
        0%, 13% { opacity: 0; transform: scale(0.1724); }
        16% { opacity: 0.7; }
        34% { opacity: 0; transform: scale(1); }
