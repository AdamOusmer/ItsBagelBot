import Card from '@bagel/ui/astro/Card.astro';
import SectionHeading from '@bagel/ui/astro/SectionHeading.astro';
import Badge from '@bagel/ui/astro/Badge.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import LightField from '@bagel/ui/astro/LightField.astro';
import Section from '@bagel/ui/astro/Section.astro';
import Text from '@bagel/ui/astro/Text.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const NETWORK_HUB = { x: 180, y: 56 };
const NETWORK_NODES = [
    { x: 118, y: 14, wave: 0 },
    { x: 242, y: 14, wave: 0 },
    { x: 54, y: 20, wave: 1 },
    { x: 55, y: 92, wave: 1 },
    { x: 305, y: 92, wave: 1 },
    { x: 306, y: 20, wave: 1 },
];
const NETWORK_WAVES = [0, 1];
const nodesIn = (wave: number) => NETWORK_NODES.filter((node) => node.wave === wave);
---

<Section size="page" class="safe" id="safety-layers" data-motion>
    <LightField class="bb-light-field--bleed" />
    <SectionHeading eyebrow={t('safetyLayers.eyebrow')} title={t('safetyLayers.title')}>
        <Badge slot="badge" tone="incoming" mark="plus">{t('badge.beta')}</Badge>
    </SectionHeading>

    <div class="safe__grid">
        <Card atmo hover class="safe__card" data-reveal>
            <div class="safe__demo safe__demo--jury" slot="band" aria-hidden="true">
                <span class="jury__case">{t('safetyLayers.spam')} / {t('safetyLayers.hate')}</span>
                <div class="jury__table">
                    <span class="jury__evidence">msg</span>
                    <span class="jury__seat jury__seat--tl" style="--jury-i: 0"><i></i><em>block</em></span>
                    <span class="jury__seat jury__seat--tr" style="--jury-i: 1"><i></i><em>block</em></span>
                    <span class="jury__seat jury__seat--l" style="--jury-i: 2"><i></i><em>block</em></span>
                    <span class="jury__seat jury__seat--r" style="--jury-i: 3"><i></i><em>allowed</em></span>
                    <span class="jury__seat jury__seat--bl" style="--jury-i: 4"><i></i><em>block</em></span>
                    <span class="jury__seat jury__seat--br" style="--jury-i: 5"><i></i><em>block</em></span>
                    <span class="jury__tally">
                        <small class="jury__verdict">{t('safetyLayers.juryVerdict')}</small>
                        <b class="jury__count">5-1</b>
                        <em>block</em>
                    </span>
                </div>
            </div>
            <Heading level={5} as="h3" variant="title" class="safe__card-title"><span>{t('safetyLayers.juryTitle')}</span></Heading>
            <Text size="sm" tone="muted">{t('safetyLayers.juryDesc')}</Text>
        </Card>

        <Card atmo hover class="safe__card" data-reveal style="--reveal-i: 1">
            <div class="safe__demo safe__demo--gates" slot="band" aria-hidden="true">
                <div class="gates__lane bb-track">
                    <span class="gates__packet bb-layers"><span>MSG</span><span class="gates__packet-ok">MSG</span></span>
                    <span class="gates__gate" style="--gate-i: 0"><i></i><b class="gates__name">{t('safetyLayers.gateRate')}</b></span>
                    <span class="gates__gate" style="--gate-i: 1"><i></i><b class="gates__name">{t('safetyLayers.gateShape')}</b></span>
                    <span class="gates__gate" style="--gate-i: 2"><i></i><b class="gates__name">{t('safetyLayers.gateLink')}</b></span>
                    <span class="gates__exit">✓</span>
                </div>
                <div class="gates__receipt">
                    <span class="gates__check">{t('safetyLayers.gateRate')} <b class="gates__ok">✓</b></span>
                    <span class="gates__check">{t('safetyLayers.gateShape')} <b class="gates__ok">✓</b></span>
                    <span class="gates__check">{t('safetyLayers.gateLink')} <b class="gates__ok">✓</b></span>
                    <em>{t('safetyLayers.gatesPassed')}</em>
                </div>
            </div>
            <Heading level={5} as="h3" variant="title" class="safe__card-title"><span>{t('safetyLayers.gatesTitle')}</span></Heading>
            <Text size="sm" tone="muted">{t('safetyLayers.gatesDesc')}</Text>
        </Card>

        <Card atmo hover class="safe__card safe__card--network" data-reveal style="--reveal-i: 2">
            <div class="safe__demo safe__demo--network" slot="band" aria-hidden="true">
                <div class="network__map bb-layers">
                    {NETWORK_WAVES.map((wave) => (
                        <svg class="network__layer network__links" viewBox="0 0 360 112" style={`--wave-i: ${wave}`}>
                            {nodesIn(wave).map((node) => <path d={`M${NETWORK_HUB.x} ${NETWORK_HUB.y} L${node.x} ${node.y}`} />)}
                        </svg>
                    ))}
                    <svg class="network__layer network__base" viewBox="0 0 360 112">
                        {NETWORK_NODES.map((node) => <circle class="network__node" cx={node.x} cy={node.y} r="5" />)}
                        <circle class="network__ring" cx={NETWORK_HUB.x} cy={NETWORK_HUB.y} r="20" />
                        <circle class="network__dot" cx={NETWORK_HUB.x} cy={NETWORK_HUB.y} r="8" />
                    </svg>
                    {NETWORK_WAVES.map((wave) => (
                        <svg class="network__layer network__lit" viewBox="0 0 360 112" style={`--wave-i: ${wave}`}>
                            {nodesIn(wave).map((node) => <circle cx={node.x} cy={node.y} r="5" />)}
                        </svg>
                    ))}
                    <svg class="network__layer network__ping" viewBox="0 0 360 112">
                        <circle cx={NETWORK_HUB.x} cy={NETWORK_HUB.y} r="58" />
                    </svg>
                    <svg class="network__layer network__ring-alert" viewBox="0 0 360 112">
                        <circle cx={NETWORK_HUB.x} cy={NETWORK_HUB.y} r="20" />
                    </svg>
                    <svg class="network__layer network__dot-alert" viewBox="0 0 360 112">
                        <circle cx={NETWORK_HUB.x} cy={NETWORK_HUB.y} r="8" />
                    </svg>
                    <svg class="network__layer network__core-safe" viewBox="0 0 360 112">
                        <circle class="network__ring" cx={NETWORK_HUB.x} cy={NETWORK_HUB.y} r="20" />
                        <circle class="network__dot" cx={NETWORK_HUB.x} cy={NETWORK_HUB.y} r="8" />
                    </svg>
                </div>
                <span class="network__alert">{t('safetyLayers.networkAlert')}</span>
                <span class="network__status">{t('safetyLayers.networkStatus')}</span>
            </div>
            <Heading level={5} as="h3" variant="title" class="safe__card-title"><span>{t('safetyLayers.networkTitle')}</span></Heading>
            <Text size="sm" tone="muted">{t('safetyLayers.networkDesc')}</Text>
        </Card>
    </div>
</Section>

<style>
    .safe {
        position: relative;
        max-width: var(--bb-content-max);
        margin: 0 auto;
        padding-inline: 24px;
        z-index: 3;
    }

    .safe__grid {
        position: relative;
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        --card-band-h: 164px;
    }

    .safe__card {
        min-width: 0;
    }

    .safe__card-title {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 9px;
        margin: 0 0 9px;
    }

    .safe__demo {
        position: relative;
        height: 100%;
        overflow: hidden;
        font-family: var(--bb-font-mono);
        font-size: 0.66rem;
    }

    .safe__demo--jury {
        display: grid;
        place-items: center;
        padding: 9px 18px;
    }

    .jury__case {
        position: absolute;
        top: 9px;
        left: 11px;
        color: rgba(var(--bb-status-danger-rgb), 0.74);
        font-size: 0.54rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .jury__table {
        position: relative;
        width: min(310px, 82%);
        height: 92px;
        border: 1px solid rgba(var(--bb-tan-rgb), 0.18);
        border-radius: 50%;
        background: radial-gradient(ellipse, rgba(var(--bb-tan-rgb), 0.07), transparent 68%);
        box-shadow: inset 0 0 24px rgba(var(--bb-tan-rgb), 0.025);
    }

    .jury__table::after {
        content: "";
        position: absolute;
        inset: 10px 24px;
        border: 1px solid rgba(var(--bb-white-rgb), 0.04);
        border-radius: 50%;
    }

    .jury__seat {
        position: absolute;
        z-index: 3;
        width: 24px;
        height: 30px;
    }

    .jury__seat i::before {
        content: "";
        position: absolute;
        top: 0;
        left: 8px;
        width: 8px;
        height: 8px;
        border: 1px solid rgba(var(--bb-white-rgb), 0.58);
        border-radius: 50%;
        background: var(--bb-inset-bg);
    }

    .jury__seat::after {
        content: "";
        position: absolute;
        top: 0;
        left: 8px;
        width: 8px;
        height: 8px;
        border: 1px solid color-mix(in srgb, var(--bb-tan-light) 90%, transparent);
        border-radius: 50%;
        background: var(--bb-inset-bg);
        box-shadow: 0 0 7px rgba(var(--bb-tan-rgb), 0.5);
        opacity: 0;
        animation: jurySeatThink 7.2s ease-in-out infinite;
        animation-delay: calc(var(--jury-i) * 70ms);
    }

    .jury__seat i::after {
        content: "";
        position: absolute;
        top: 11px;
        left: 4px;
        width: 16px;
        height: 9px;
        border: 1px solid rgba(var(--bb-white-rgb), 0.36);
        border-bottom: 0;
        border-radius: var(--bb-radius-md) var(--bb-radius-md) 0 0;
    }

    .jury__seat em {
        position: absolute;
        left: 50%;
        bottom: 3px;
        padding: 2px 4px;
        border: 1px solid rgba(var(--bb-status-danger-rgb), 0.42);
        border-radius: var(--bb-radius-xs);
        color: var(--bb-status-danger);
        background: var(--bb-inset-bg);
        font-size: 0.42rem;
        font-style: normal;
        text-transform: uppercase;
        opacity: 0;
        transform: translate(-50%, 9px) rotate(var(--ballot-rot, -5deg)) scale(0.85);
        animation: juryBallot 7.2s ease infinite;
        animation-delay: calc(var(--jury-i) * 140ms);
    }

    .jury__seat--tl,
    .jury__seat--l,
    .jury__seat--bl { --ballot-rot: -5deg; }
    .jury__seat--tr,
    .jury__seat--r,
    .jury__seat--br { --ballot-rot: 5deg; }
    .jury__seat--r em { color: var(--bb-green-glow); border-color: rgba(var(--bb-green-glow-rgb), 0.42); }

    .jury__evidence {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 50%;
        padding: 3px 7px;
        border: 1px dashed rgba(var(--bb-status-danger-rgb), 0.5);
        border-radius: var(--bb-radius-xs);
        color: rgba(var(--bb-status-danger-rgb), 0.9);
        background: var(--bb-inset-bg);
        font-size: 0.52rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.72);
        animation: juryEvidence 7.2s ease infinite;
    }

    .jury__seat--tl { top: -9px; left: 22%; }
    .jury__seat--tr { top: -9px; right: 22%; }
    .jury__seat--l { top: 31px; left: -13px; }
    .jury__seat--r { top: 31px; right: -13px; }
    .jury__seat--bl { bottom: -11px; left: 22%; }
    .jury__seat--br { right: 22%; bottom: -11px; }

    .jury__tally {
        position: absolute;
        z-index: 2;
        inset: 23px 32%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
        text-align: center;
        text-shadow: 0 0 12px rgba(var(--bb-status-danger-rgb), 0.3);
        opacity: 0;
        animation: juryTally 7.2s ease-in-out infinite;
    }

    .jury__verdict {
        font-size: 0.44rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .jury__count {
        font-family: var(--bb-font-display);
        font-size: 1rem;
        line-height: 1;
        color: var(--bb-white);
    }

    .jury__tally em {
        color: var(--bb-status-danger);
        font-size: 0.48rem;
        font-style: normal;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    @keyframes juryEvidence {
        0%, 2% { opacity: 0; transform: translate(-50%, -50%) scale(0.72); animation-timing-function: var(--bb-ease-out-back); }
        7% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        20% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        26%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
    }

    @keyframes jurySeatThink {
        0%, 8%, 24%, 100% { opacity: 0; }
        12%, 20% { opacity: 1; }
    }

    @keyframes juryBallot {
        0%, 24% { opacity: 0; transform: translate(-50%, 9px) rotate(var(--ballot-rot, -5deg)) scale(0.85); animation-timing-function: var(--bb-ease-out-back); }
        31% { opacity: 1; transform: translate(-50%, -7px) rotate(var(--ballot-rot, -5deg)) scale(1); }
        80% { opacity: 1; transform: translate(-50%, -7px) rotate(var(--ballot-rot, -5deg)) scale(1); }
        87%, 100% { opacity: 0; transform: translate(-50%, -4px) rotate(var(--ballot-rot, -5deg)) scale(0.95); }
    }

    @keyframes juryTally {
        0%, 38% { opacity: 0; transform: scale(1.18); }
        44% { opacity: 1; transform: scale(1); }
        88% { opacity: 1; transform: scale(1); }
        95%, 100% { opacity: 0; transform: scale(0.96); }
    }

    .safe__demo--gates {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .gates__lane {
        position: relative;
        height: 68px;
    }

    .gates__lane::before {
        content: "";
        position: absolute;
        top: 25px;
        left: 8px;
        right: 8px;
        height: 1px;
        background: rgba(var(--bb-white-rgb), 0.08);
    }

    .gates__packet {
        position: absolute;
        z-index: 3;
        top: 12px;
        left: 4px;
        display: grid;
        place-items: center;
        width: 36px;
        height: 27px;
        border: 1px solid rgba(var(--bb-tan-rgb), 0.42);
        border-radius: var(--bb-radius-xs);
        color: var(--bb-tan-light);
        background: var(--bb-inset-bg);
        box-shadow: 0 0 12px rgba(var(--bb-tan-rgb), 0.1);
        opacity: 0;
        animation: gatePacket 7.2s ease infinite;
    }

    .gates__packet > * {
        align-self: center;
        justify-self: center;
    }

    .gates__packet::after {
        content: "";
        grid-area: 1 / 1;
        align-self: stretch;
        justify-self: stretch;
        margin: -1px;
        border: 1px solid rgba(var(--bb-green-glow-rgb), 0.64);
        border-radius: inherit;
    }

    .gates__packet-ok {
        color: var(--bb-green-glow);
    }

    .gates__packet::after,
    .gates__packet-ok {
        opacity: 0;
        animation: gatePacketOk 7.2s ease infinite;
    }

    .gates__gate {
        position: absolute;
        top: 2px;
        left: calc(29% + var(--gate-i) * 21%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        color: var(--bb-muted);
    }

    .gates__gate i {
        position: relative;
        width: 2px;
        height: 48px;
        background: color-mix(in srgb, var(--bb-muted) 56%, transparent);
        box-shadow: 0 0 0 4px var(--bb-inset-bg);
        transform-origin: top;
    }

    .gates__gate i::before,
    .gates__gate i::after {
        content: "";
        position: absolute;
        inset: 0;
        opacity: 0;
    }

    .gates__gate i::before {
        background: color-mix(in srgb, var(--bb-tan-light) 95%, transparent);
        box-shadow: 0 0 9px rgba(var(--bb-tan-rgb), 0.55);
    }

    .gates__gate i::after {
        background: var(--bb-green-glow);
    }

    .gates__gate i,
    .gates__gate i::before,
    .gates__gate i::after {
        animation-duration: 7.2s;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
        animation-delay: var(--gate-delay, 0s);
    }

    .gates__gate i { animation-name: gateOpen; }
    .gates__gate i::before { animation-name: gateScan; }
    .gates__gate i::after { animation-name: gateGreen; }
    .gates__gate:nth-child(3) { --gate-delay: 1.584s; }
    .gates__gate:nth-child(4) { --gate-delay: 3.024s; }

    .gates__name { font-size: 0.52rem; font-weight: 500; text-transform: uppercase; }

    .gates__exit {
        position: absolute;
        top: 13px;
        right: 2px;
        display: grid;
        place-items: center;
        width: 26px;
        height: 26px;
        border: 1px solid rgba(var(--bb-green-glow-rgb), 0.28);
        border-radius: 50%;
        color: var(--bb-green-glow);
        opacity: 0;
        animation: gateExit 7.2s ease infinite;
    }

    .gates__receipt {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--bb-muted);
    }

    .gates__check {
        font-size: 0.54rem;
        text-transform: uppercase;
        opacity: 0.26;
        animation-duration: 7.2s;
        animation-timing-function: ease;
        animation-iteration-count: infinite;
    }
    .gates__check:nth-child(1) { animation-name: receiptOne; }
    .gates__check:nth-child(2) { animation-name: receiptTwo; }
    .gates__check:nth-child(3) { animation-name: receiptThree; }
    .gates__ok { color: var(--bb-green-glow); font-weight: 500; }
    .gates__receipt em {
        margin-left: auto;
        color: var(--bb-green-glow);
        font-size: 0.58rem;
        font-style: normal;
        opacity: 0;
        animation: gateExit 7.2s ease infinite;
    }

    @keyframes gatePacket {
        0% { transform: none; opacity: 0; }
        2% { opacity: 1; animation-timing-function: var(--bb-ease-out-expo); }
        15% { transform: translateX(calc(29cqi - 50px)); }
        26% { transform: translateX(calc(29cqi - 50px)); animation-timing-function: var(--bb-ease-out-expo); }
        36% { transform: translateX(calc(50cqi - 50px)); }
        48% { transform: translateX(calc(50cqi - 50px)); animation-timing-function: var(--bb-ease-out-expo); }
        58% { transform: translateX(calc(71cqi - 50px)); }
        68% { transform: translateX(calc(71cqi - 50px)); animation-timing-function: var(--bb-ease-out-expo); }
        78% { transform: translateX(calc(100cqi - 78px)); }
        90% { transform: translateX(calc(100cqi - 78px)); opacity: 1; }
        95%, 100% { transform: translateX(calc(100cqi - 78px)); opacity: 0; }
    }

    @keyframes gatePacketOk {
        0% { opacity: 0; }
        78%, 100% { opacity: 1; }
    }

    @keyframes gateOpen {
        0%, 21% { transform: scaleY(1); }
        23%, 34% { transform: scaleY(0.18); }
        39%, 100% { transform: scaleY(1); }
    }

    @keyframes gateScan {
        0%, 16% { opacity: 0; }
        17.5%, 20% { opacity: 1; }
        21%, 100% { opacity: 0; }
    }

    @keyframes gateGreen {
        0%, 21% { opacity: 0; }
        23%, 34% { opacity: 1; }
        39%, 100% { opacity: 0; }
    }

    @keyframes gateExit {
        0%, 79% { opacity: 0; transform: scale(0.7); animation-timing-function: var(--bb-ease-out-back); }
        84% { opacity: 1; transform: scale(1); }
        92% { opacity: 1; transform: scale(1); }
        97%, 100% { opacity: 0; transform: scale(0.9); }
    }

    @keyframes receiptOne {
        0%, 22% { opacity: 0.26; transform: translateY(2px); }
        26% { opacity: 1; transform: none; }
        92% { opacity: 1; transform: none; }
        98%, 100% { opacity: 0.26; transform: translateY(2px); }
    }
    @keyframes receiptTwo {
        0%, 44% { opacity: 0.26; transform: translateY(2px); }
        48% { opacity: 1; transform: none; }
        92% { opacity: 1; transform: none; }
        98%, 100% { opacity: 0.26; transform: translateY(2px); }
    }
    @keyframes receiptThree {
        0%, 64% { opacity: 0.26; transform: translateY(2px); }
        68% { opacity: 1; transform: none; }
        92% { opacity: 1; transform: none; }
        98%, 100% { opacity: 0.26; transform: translateY(2px); }
    }

    .safe__demo--network { padding: 10px 16px; }

    .network__map {
        width: 100%;
        height: 100%;
    }

    .network__layer {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .network__links {
        fill: none;
        stroke: rgba(var(--bb-green-glow-rgb), 0.48);
        stroke-width: 1;
        opacity: 0;
        transform: scale(0);
        animation: networkLine 7.2s var(--bb-ease-out-expo) infinite;
        animation-delay: calc(var(--wave-i) * 200ms);
    }

    .network__node {
        fill: var(--bb-inset-bg);
        stroke: color-mix(in srgb, var(--bb-muted) 52%, transparent);
        stroke-width: 1;
    }

    .network__ring {
        fill: rgba(var(--bb-status-danger-rgb), 0.04);
        stroke: color-mix(in srgb, var(--bb-muted) 35%, transparent);
    }

    .network__dot {
        fill: color-mix(in srgb, var(--bb-muted) 60%, transparent);
    }

    .network__lit {
        fill: var(--bb-green-glow);
        stroke: rgba(var(--bb-mint-glow-rgb), 0.86);
        stroke-width: 1;
        filter: drop-shadow(0 0 6px rgba(var(--bb-green-glow-rgb), 0.62));
        opacity: 0;
        animation: networkNode 7.2s ease-in-out infinite;
        animation-delay: calc(var(--wave-i) * 200ms);
    }

    .network__ping {
        fill: none;
        stroke: rgba(var(--bb-green-glow-rgb), 0.55);
        stroke-width: 2.9;
        opacity: 0;
        transform: scale(0.1724);
        animation: networkPing 7.2s ease-out infinite;
    }

    .network__ring-alert {
        fill: none;
        stroke: rgba(var(--bb-status-danger-rgb), 0.55);
        opacity: 0;
        animation: networkRingAlert 7.2s ease-in-out infinite;
    }

    .network__dot-alert {
        fill: rgba(var(--bb-status-danger-rgb), 0.9);
        filter: drop-shadow(0 0 8px rgba(var(--bb-status-danger-rgb), 0.65));
        opacity: 0;
        animation: networkDotAlert 7.2s ease-in-out infinite;
    }

    .network__core-safe {
        filter: drop-shadow(0 0 7px rgba(var(--bb-green-glow-rgb), 0.55));
