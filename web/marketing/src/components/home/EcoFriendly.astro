/**
 * EcoFriendly: the original single card with the giant leaf growing in its
 * housing band. The 2026-09 compression pass flattened this to a slim row and
 * shrank the leaf; the leaf and its stage came back by request. What did NOT
 * come back is the SectionHeading above the card: the title said "Powered by
 * Sustainable Energy" three times over (section title, card title, body), and
 * once is enough.
 */
import Card from '@bagel/ui/astro/Card.astro';
import Icon from '@bagel/ui/astro/Icon.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="eco" id="eco-friendly">
    <div class="eco__grid">
        <Card atmo hover class="eco__card" label={t('eco.ch')} data-reveal>
            <div class="eco__demo" slot="band" aria-hidden="true">
                <Icon name="leaf" size={96} strokeWidth={1.5} class="eco__leaf" />
            </div>
            <h3 class="eco__title">{t('eco.title')}</h3>
            <p class="eco__desc">{t('eco.desc')}</p>
            <div class="eco__links">
                <a href="https://www.websitecarbon.com/website/itsbagelbot-com/" target="_blank" rel="noopener noreferrer">
                    Website Carbon: ItsBagelBot
                </a>
                <a href="https://www.websitecarbon.com/website/dashboard-itsbagelbot-com-login/" target="_blank" rel="noopener noreferrer">
                    Website Carbon: Dashboard
                </a>
            </div>
        </Card>
    </div>
</section>

<style>
    .eco {
        position: relative;
        padding: var(--space-section, 96px) 24px;
        max-width: var(--content-max, 1200px);
        margin: 0 auto;
        z-index: 3;
    }

    .eco__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        --card-band-h: 160px;
    }

    @media (min-width: 720px) {
        .eco__grid { grid-template-columns: minmax(0, 560px); justify-content: center; }
    }

    .eco__title {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        font-family: var(--font-display, "Syne", sans-serif);
        font-size: 1.06rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--white, #f0ece4);
        margin: 0 0 8px;
    }

    .eco__desc {
        font-family: var(--font-body, "DM Sans", sans-serif);
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--muted, #888077);
        margin: 0 0 20px;
    }

    .eco__links {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.8rem;
    }

    .eco__links a {
        color: var(--green-glow, #52b788);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: color 0.2s ease;
    }

    .eco__links a:hover {
        color: var(--white, #f0ece4);
    }

    /* Demo lives in the Card's housing band (slot="band"); the band owns the
       chrome and outer padding, the demo keeps only its stage height. */
    .eco__demo {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        overflow: hidden;
    }

    /* :global because the glyph is Icon's root svg: Astro scopes this
       component's rules to its own elements, and the child's root carries no
       scope attribute of ours. Draw runs on that svg rather than its paths,
       which come from the generated icon map via set:html and are scoped to
       nothing at all; stroke-dasharray and stroke-dashoffset inherit, so the
       svg hands both to blade and stem. The stem is the shorter of Lucide's
       two paths, so it lands last and still reads as a leaf growing out of
       its stalk. */
    .eco__demo :global(.eco__leaf) {
        width: 96px;
        height: 96px;
        color: var(--green-glow, #52b788);
        filter: drop-shadow(0 0 16px rgba(82, 183, 136, 0.4));
        stroke-dasharray: 64;
        stroke-dashoffset: 64;
        animation: drawLeaf 3s ease-out forwards, leafSway 4s ease-in-out infinite;
        transform-origin: bottom left;
    }

    @keyframes leafSway {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(12deg); }
    }

    @keyframes drawLeaf {
        to { stroke-dashoffset: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .eco__demo :global(.eco__leaf) { animation: none; transform: none; stroke-dashoffset: 0; }
    }

    @media (max-width: 640px) {
        .eco__grid { --card-band-h: 120px; }
        .eco__links { flex-direction: column; align-items: flex-start; gap: 10px; }
    }
</style>
