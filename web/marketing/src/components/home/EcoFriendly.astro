import Card from '@bagel/ui/astro/Card.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Icon from '@bagel/ui/astro/Icon.astro';
import Text from '@bagel/ui/astro/Text.astro';
import TextLink from '@bagel/ui/astro/TextLink.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="eco" id="eco-friendly">
    <div class="eco__grid">
        <Card atmo hover class="eco__card" label={t('eco.ch')} data-reveal>
            <div class="eco__demo" slot="band" aria-hidden="true">
                <Icon name="leaf" size={96} strokeWidth={1.5} class="eco__leaf" />
            </div>
            <Heading level={5} as="h3" variant="title" class="eco__title">{t('eco.title')}</Heading>
            <Text tone="muted" class="eco__desc">{t('eco.desc')}</Text>
            <div class="eco__links">
                <TextLink variant="quiet" class="eco__link" href="https://www.websitecarbon.com/website/itsbagelbot-com/" label="Website Carbon: ItsBagelBot" external />
                <TextLink variant="quiet" class="eco__link" href="https://www.websitecarbon.com/website/dashboard-itsbagelbot-com-login/" label="Website Carbon: Dashboard" external />
            </div>
        </Card>
    </div>
</section>

<style>
    .eco {
        position: relative;
        padding: var(--bb-space-section) 24px;
        max-width: var(--bb-content-max);
        margin: 0 auto;
        z-index: 3;
    }

    .eco__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        --card-band-h: 160px;
    }

    @media (min-width: 720px) {
        .eco__grid { grid-template-columns: minmax(0, 560px); justify-content: center; }
    }

    .eco__title {
        margin: 0 0 8px;
    }

    .eco__desc {
        margin: 0 0 20px;
    }

    .eco__links {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
    }

    .eco__link {
        font-family: var(--bb-font-mono);
        font-size: 0.8rem;
        color: var(--bb-green-glow);
        transition: color var(--bb-dur-fast) ease;
    }

    .eco__link:hover {
        color: var(--bb-white);
    }

    .eco__demo {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        overflow: hidden;
    }

    .eco__demo .eco__leaf {
        width: 96px;
        height: 96px;
        color: var(--bb-green-glow);
        filter: drop-shadow(0 0 16px rgba(var(--bb-green-glow-rgb), 0.4));
        stroke-dasharray: 64;
        stroke-dashoffset: 64;
        animation: drawLeaf 3s ease-out forwards, leafSway 4s ease-in-out infinite;
        transform-origin: bottom left;
    }

    @keyframes leafSway {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(12deg); }
    }

    @keyframes drawLeaf {
        to { stroke-dashoffset: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .eco__demo .eco__leaf { animation: none; transform: none; stroke-dashoffset: 0; }
    }

    @media (max-width: 640px) {
        .eco__grid { --card-band-h: 120px; }
        .eco__links { flex-direction: column; align-items: flex-start; gap: 10px; }
    }
</style>
