import Eyebrow from '@bagel/ui/astro/Eyebrow.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Icon from '@bagel/ui/astro/Icon.astro';
import TextLink from '@bagel/ui/astro/TextLink.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="eco" id="eco-friendly" data-motion>
    <div class="eco__leaf-wrap" aria-hidden="true" data-reveal>
        <Icon name="leaf" size={96} strokeWidth={1.5} class="eco__leaf" />
    </div>
    <div class="eco__body">
        <Eyebrow tone="go" class="eco__eyebrow" data-reveal><span data-fit>{t('ecoFriendly.eyebrow')}</span></Eyebrow>
        <Heading level={2} variant="title" class="eco__title" data-reveal><span data-fit="block">{t('ecoFriendly.title')}</span></Heading>
        <p class="eco__lead" data-reveal><span data-fit="block">{t('ecoFriendly.statsLead')}</span></p>
        <div class="eco__stats" data-reveal>
            <span class="eco__stat">
                <span class="eco__value"><span data-fit>92%</span></span>
                <span class="eco__key"><span data-fit>{t('ecoFriendly.statSite')}</span></span>
            </span>
            <span class="eco__stat">
                <span class="eco__value"><span data-fit>95%</span></span>
                <span class="eco__key"><span data-fit>{t('ecoFriendly.statDash')}</span></span>
            </span>
        </div>
        <TextLink variant="arrow" tone="go" class="eco__more" href={localizePath('/green-hosting', lang)} data-reveal><span class="eco__more-text"><span data-fit>{t('ecoFriendly.more')}</span></span></TextLink>
    </div>
</section>

<style>
    .eco {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 56px;
        max-width: var(--bb-content-max);
        margin: 0 auto;
        padding: var(--bb-space-section) 24px;
        z-index: 3;
        scroll-margin-top: calc(var(--nav-offset) + 16px);
    }

    .eco__leaf-wrap {
        --reveal-i: 0;
        display: grid;
        place-items: center;
        flex: none;
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: radial-gradient(closest-side, rgba(var(--bb-green-glow-rgb), 0.14), transparent);
    }

    .eco__leaf-wrap :global(.eco__leaf) {
        width: 96px;
        height: 96px;
        color: var(--bb-green-glow);
        filter: drop-shadow(0 0 16px rgba(var(--bb-green-glow-rgb), 0.4));
        stroke-dasharray: 64;
        stroke-dashoffset: 64;
        transform-origin: bottom left;
        animation: ecoDraw 3s ease-out forwards, ecoSway 4s ease-in-out infinite;
    }

    .eco__body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
        width: min(100%, 520px);
    }

    .eco__eyebrow { --reveal-i: 1; height: 1lh; }

    .eco__title {
        --reveal-i: 2;
        width: 100%;
        height: calc(var(--eco-title-lines, 1) * 1lh);
        margin: 0;
    }

    .eco__lead {
        --reveal-i: 3;
        width: 100%;
        height: calc(2 * 1lh);
        margin: 0;
        font-size: var(--bb-text-sm);
        color: var(--bb-muted);
    }

    .eco__stats {
        --reveal-i: 3;
        display: flex;
        gap: 40px;
    }

    .eco__stat {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .eco__value {
        display: block;
        width: 3.6em;
        height: 1lh;
        font-family: var(--bb-font-display);
        font-size: 2.6rem;
        font-weight: 800;
        line-height: 1;
        background: var(--bb-green-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        -webkit-text-fill-color: transparent;
    }

    .eco__key {
        display: block;
        width: 100%;
        height: 1lh;
        font-family: var(--bb-font-mono);
        font-size: var(--bb-text-xs);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--bb-muted);
    }

    .eco__body :global(.eco__more) {
        --reveal-i: 4;
        height: 1lh;
    }

    .eco__more-text {
        display: inline-block;
        width: 150px;
        height: 1lh;
        text-align: start;
    }

    @media (max-width: 720px) {
        .eco__more-text { text-align: center; }
    }

    @keyframes ecoDraw {
        to { stroke-dashoffset: 0; }
    }

    @keyframes ecoSway {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(12deg); }
    }

    @media (max-width: 720px) {
        .eco {
            --eco-title-lines: 2;
            flex-direction: column;
            gap: 24px;
            text-align: center;
        }
        .eco__leaf-wrap { width: 140px; height: 140px; }
        .eco__leaf-wrap :global(.eco__leaf) { width: 72px; height: 72px; }
        .eco__body { align-items: center; }
        .eco__stats { gap: 24px; }
        .eco__value { font-size: 2rem; }
    }

    @media (prefers-reduced-motion: reduce) {
        .eco__leaf-wrap :global(.eco__leaf) { animation: none; transform: none; stroke-dashoffset: 0; }
    }
</style>
