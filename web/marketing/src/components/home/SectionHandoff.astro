<style>
    /* Longhands only: a minifier folds them into `animation: … view()`, which Chrome drops. */
    @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
            :global(:is(
                #main-content > section > :not(script, style, [data-field], .bento, ol, .finale__glow),
                #main-content > section > :is(.bento, ol) > *
            )) {
                animation-name: section-handoff;
                animation-timing-function: linear;
                animation-fill-mode: both;
                animation-timeline: view();
                animation-range: exit -12vh exit 85%;
            }
        }
    }

    @keyframes section-handoff {
        to {
            opacity: 0;
            scale: 0.94;
        }
    }
</style>
