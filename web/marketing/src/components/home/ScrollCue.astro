import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<button class="cue" type="button" data-scroll-cue>
    <span class="cue__inner">
        <span class="cue__label">{t('hero.scrollCue')}</span>
        <span class="cue__rail" aria-hidden="true">
            <span class="cue__dot"></span>
        </span>
    </span>
</button>

<style>
    .cue {
        position: absolute;
        left: 50%;
        bottom: calc(env(safe-area-inset-bottom, 0px) + 12px);
        transform: translateX(-50%);
        display: block;
        padding: 6px 16px 0;
        border: 0;
        background: none;
        cursor: pointer;
        opacity: max(0, calc(1 - var(--hero-p, 0) * 6));
        pointer-events: var(--hero-ui-pointer-events, auto);
        z-index: 2;
    }

    .cue__inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--cue-gap, 8px);
        opacity: 0;
        animation: cueIn 700ms 1600ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)) forwards;
    }

    .cue__label {
        display: none;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.62rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--muted, #b0a898);
        transition: color 0.2s;
    }

    .cue__rail {
        position: relative;
        display: block;
        width: 2px;
        border-radius: var(--radius-pill);
        height: var(--cue-rail, 24px);
        background: linear-gradient(to bottom, rgba(201, 168, 124, 0), rgba(201, 168, 124, 0.45));
        overflow: hidden;
        transition: background 0.2s;
    }

    .cue__dot {
        position: absolute;
        top: 0;
        left: 50%;
        width: 4px;
        height: 4px;
        margin-left: -1px;
        border-radius: 50%;
        background: var(--green-glow, #52b788);
        box-shadow: 0 0 8px rgba(82, 183, 136, 0.85);
        animation: cueFall 2.4s ease-in-out infinite;
        animation-play-state: var(--hero-animation-state, running);
    }

    .cue:hover .cue__label {
        color: var(--white, #fff);
    }

    .cue:hover .cue__rail {
        background: linear-gradient(to bottom, rgba(201, 168, 124, 0), rgba(201, 168, 124, 0.65));
    }

    .cue:focus-visible {
        outline: 1px solid var(--tan, #c9a87c);
        outline-offset: 4px;
        border-radius: var(--radius-sm);
    }

    @keyframes cueIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes cueFall {
        0% {
            transform: none;
            opacity: 0;
        }
        15% {
            opacity: 1;
        }
        55% {
            opacity: 1;
        }
        70%, 100% {
            transform: translateY(var(--cue-rail, 24px));
            opacity: 0;
        }
    }

    @media (min-height: 840px), (max-width: 900px) and (min-height: 600px) {
        .cue {
            --cue-rail: 42px;
            --cue-gap: 12px;
            bottom: calc(env(safe-area-inset-bottom, 0px) + 24px);
        }

        .cue__label {
            display: block;
        }
    }

    @media (min-width: 901px) and (max-height: 700px) {
        .cue {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .cue__inner {
            opacity: 1;
            animation: none;
        }

        .cue__dot {
            animation: none;
            transform: translateY(var(--cue-rail, 24px));
            opacity: 1;
        }
    }
</style>

<script>
    import { getSmoothScroll } from "@bagel/ui/lib/lenis";
    import { bindOnce } from '../../script/bind';

    function onClick() {
        const top = window.scrollY + window.innerHeight;
        const lenis = getSmoothScroll();

        if (lenis?.scrollTo) {
            lenis.scrollTo(top, { duration: 1.1 });
            return;
        }

        window.scrollTo({ top, behavior: 'smooth' });
    }

    bindOnce('[data-scroll-cue]', (el) => el.addEventListener('click', onClick));
</script>
