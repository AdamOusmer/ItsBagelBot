import Card from '@bagel/ui/astro/Card.astro';
import Chip from '@bagel/ui/astro/Chip.astro';
import Eyebrow from '@bagel/ui/astro/Eyebrow.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import IconButton from '@bagel/ui/astro/IconButton.astro';
import Input from '@bagel/ui/astro/Input.astro';
import Lead from '@bagel/ui/astro/Lead.astro';
import ProgressBar from '@bagel/ui/astro/ProgressBar.astro';
import Section from '@bagel/ui/astro/Section.astro';
import Tag from '@bagel/ui/astro/Tag.astro';
import Text from '@bagel/ui/astro/Text.astro';

// DOM + textContent only: never innerHTML for anything user-typed.
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const chips = [
    { cmd: '!bagel', label: '!bagel' },
    { cmd: '!song', label: '!song' },
    { cmd: '!poll', label: '!poll' },
    { cmd: '!lurk', label: '!lurk' },
];

const playStrings = {
    replyBagel: t('playground.replyBagel'),
    replySong: t('playground.replySong'),
    replyLurk: t('playground.replyLurk'),
    replyHelp: t('playground.replyHelp'),
    pollUp: t('playground.pollUp'),
    pollQ: t('playground.pollQ'),
    pollYes: t('playground.pollYes'),
    pollAlways: t('playground.pollAlways'),
    spamRemoved: t('playground.spamRemoved'),
    quiet: t('playground.quiet'),
    unknown: t('playground.unknown'),
    seedTry: t('playground.seedTry'),
    seed1: t('playground.amb6'),
    ambient: [
        t('playground.amb1'), t('playground.amb2'), t('playground.amb3'), t('playground.amb4'), t('playground.amb5'),
        t('playground.amb6'), t('playground.amb7'), '🥯🥯🥯', t('playground.amb8'), t('playground.amb9'),
    ],
};
---

<Section size="page" class="play" id="playground">
    <script type="application/json" data-play-i18n set:html={JSON.stringify(playStrings)}></script>
    <div class="play__copy">
        <Eyebrow tone="go" class="play__eyebrow" data-reveal>{t('playground.eyebrow')}</Eyebrow>
        <Heading level={2} class="play__title" data-reveal>{t('playground.title')}</Heading>
        <Lead class="play__sub" data-reveal>
            {t('playground.sub')}
        </Lead>

        <div class="play__chips" data-reveal>
            {chips.map((chip) => (
                <Chip data-play-cmd={chip.cmd}>{chip.label}</Chip>
            ))}
            <Chip tone="danger" data-play-spam>
                {t('playground.sendSpam')}<span aria-hidden="true"> ☠</span>
            </Chip>
        </div>

        <Text size="xs" mono tone="muted" class="play__hint" data-reveal>
            {t('playground.hint')}
        </Text>
    </div>

    <div class="play__stage" data-reveal data-playground>
        <Card flush class="play__window">
            <div class="play__bar">
                <span class="play__channel">#your_channel</span>
                <Tag tone="live" class="play__live" mark="solid" sweep>{t('playground.live')}</Tag>
            </div>

            <div class="play__feed" data-play-feed role="log" aria-label={t('playground.feedAria')}></div>

            <form class="play__composer" data-play-form>
                <Input
                    mono
                    fill
                    id="play-input"
                    name="message"
                    data-play-input
                    maxlength={80}
                    placeholder={t('playground.inputPlaceholder')}
                    aria-label={t('playground.inputAria')}
                    autocomplete="off"
                    spellcheck="false"
                />
                <IconButton type="submit" label={t('playground.sendAria')} class="play__send">↵</IconButton>
            </form>
        </Card>
        <template data-play-poll-row>
            <span class="ppoll__row"><ProgressBar value={0} tone="success" gradient label="" /><span data-play-poll-label></span></span>
        </template>
    </div>
</Section>

<style>
    .play {
        position: relative;
        display: grid;
        grid-template-columns: 1fr;
        gap: 48px;
        align-items: center;
        padding-inline: 24px;
        max-width: var(--bb-content-max);
        margin: 0 auto;
        z-index: 3;
        scroll-margin-top: calc(var(--nav-offset) + 16px);
    }

    @media (min-width: 960px) {
        .play {
            grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
            gap: 64px;
            padding-inline: 48px;
        }
    }

    .play__eyebrow {
        display: block;
        margin-bottom: 18px;
    }

    .play__title {
        --reveal-i: 1;
        font-weight: 800;
        font-size: clamp(2rem, 5vw, 3.2rem);
        letter-spacing: var(--bb-tracking-tight);
        margin: 0 0 18px;
    }

    .play__sub {
        --reveal-i: 2;
        max-width: 42ch;
        margin: 0 0 28px;
    }

    .play__chips {
        --reveal-i: 3;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 18px;
    }

    .play__hint {
        --reveal-i: 4;
        opacity: 0.75;
    }

    .play__stage {
        --reveal-i: 2;
    }

    .play__window {
        --card-radius: var(--bb-radius-lg);
        display: flex;
        flex-direction: column;
        height: clamp(420px, 56vh, 520px);
        box-shadow: 0 24px 80px rgba(var(--bb-shadow-rgb), 0.5);
    }

    .play__bar {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 18px;
        border-bottom: 1px solid var(--bb-border);
        background: rgba(var(--bb-white-pure-rgb), 0.015);
    }

    .play__channel {
        font-family: var(--bb-font-mono);
        font-size: 0.78rem;
        color: var(--bb-white);
        letter-spacing: 0.04em;
    }

    .play__live {
        margin-left: auto;
    }

    .play__feed {
        flex: 1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 2px;
        padding: 16px 14px;
        mask-image: linear-gradient(to bottom, transparent 0, black 56px);
        -webkit-mask-image: linear-gradient(to bottom, transparent 0, black 56px);
    }

    .play__feed :global(.pmsg) {
        display: flex;
        align-items: baseline;
        gap: 8px;
        padding: 5px 8px;
        border-radius: var(--bb-radius-md);
        font-size: 0.85rem;
        line-height: 1.5;
        animation: pmsgIn var(--bb-dur-base) var(--bb-ease-out-expo) both;
    }

    @keyframes pmsgIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: none; }
    }

    .play__feed :global(.pmsg__name) {
        font-family: var(--bb-font-mono);
        font-size: 0.78rem;
        flex-shrink: 0;
        color: var(--hue, var(--bb-tan));
    }

    .play__feed :global(.pmsg__text) {
        font-family: var(--bb-font-body);
        color: rgba(var(--bb-white-rgb), 0.82);
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .play__feed :global(.pmsg--you) {
        background: rgba(var(--bb-tan-rgb), 0.06);
    }

    .play__feed :global(.pmsg--bot) {
        background: rgba(var(--bb-green-glow-rgb), 0.05);
    }

    .play__feed :global(.pmsg--bot .pmsg__name) {
        color: var(--bb-green-glow);
    }

    .play__feed :global(.pmsg--bot .pmsg__name::after) {
        content: " ✓";
        font-size: 0.62rem;
        opacity: 0.7;
    }

    .play__feed :global(.pmsg--typing .pmsg__text) {
        display: inline-flex;
        gap: 4px;
        align-items: center;
        padding-top: 4px;
    }

    .play__feed :global(.pmsg--spam .pmsg__text) {
        color: rgba(var(--bb-status-danger-rgb), 0.9);
    }

    .play__feed :global(.pmsg--spam.is-caught) {
        transition: opacity var(--bb-dur-base) ease, filter var(--bb-dur-base) ease;
        opacity: 0.5;
        filter: blur(1.5px);
    }

    .play__feed :global(.pmsg--spam.is-caught .pmsg__text) {
        text-decoration: line-through;
    }

    .play__feed :global(.pmsg--caught) {
        font-family: var(--bb-font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        color: var(--bb-green-glow);
        background: rgba(var(--bb-green-glow-rgb), 0.07);
        border: 1px dashed rgba(var(--bb-green-glow-rgb), 0.3);
        border-radius: var(--bb-radius-md);
        padding: 6px 10px;
    }

    .play__feed :global(.pmsg--poll) {
        display: block;
        background: rgba(var(--bb-green-glow-rgb), 0.05);
        padding: 8px 10px;
    }

    .play__feed :global(.ppoll__q) {
        font-family: var(--bb-font-mono);
        font-size: 0.74rem;
        color: var(--bb-green-glow);
        margin-bottom: 7px;
        display: block;
    }

    .ppoll__row {
        --progress-from: var(--bb-green);
        --progress-duration: 1100ms;
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 8px;
        margin-top: 5px;
        font-family: var(--bb-font-mono);
        font-size: 0.7rem;
        color: rgba(var(--bb-white-rgb), 0.8);
    }


    .play__composer {
        display: flex;
        gap: 10px;
        padding: 12px 14px;
        border-top: 1px solid var(--bb-border);
        background: rgba(var(--bb-white-pure-rgb), 0.015);
    }

    @media (prefers-reduced-motion: reduce) {
        .play__feed :global(.pmsg) { animation: none; }
        .ppoll__row { --progress-duration: 0s; }
    }

    @media (max-width: 640px) {
        .play { padding-inline: 20px; }
        .play__window { height: 420px; }
    }
</style>

<script>
    import { reduceMotion } from '@bagel/ui/lib/motion-query';

    const VIEWERS: Array<[string, string]> = [
        ['moth_lamp', '#e0c49a'],
        ['gg_beans', '#52b788'],
        ['pixel_pal', '#c9a87c'],
        ['night_owl_77', '#9ad1b5'],
        ['soupdream', '#d9c08a'],
        ['tiny_cactus', '#7cc9a4'],
    ];

    const SPAM_LINES = [
        'FREE F0LLOWERS >> sketchy.link/boost CLICK NOW',
        'im giving away gift subs, DM me on telegram!!',
        'V1EWBOTS cheap!! totally-legit.biz',
    ];

    type PlayStrings = {
        replyBagel: string; replySong: string; replyLurk: string; replyHelp: string;
        pollUp: string; pollQ: string; pollYes: string; pollAlways: string;
        spamRemoved: string; quiet: string; unknown: string; seedTry: string;
        ambient: string[]; seed1: string;
    };
    const S: PlayStrings = JSON.parse(
        document.querySelector('[data-play-i18n]')?.textContent || '{}',
    );

    const REPLIES: Record<string, string | null> = {
        '!bagel': S.replyBagel,
        '!song': S.replySong,
        '!lurk': S.replyLurk,
        '!help': S.replyHelp,
        '!poll': null,
    };


    type PlayParts = {
        feed: HTMLElement;
        form: HTMLFormElement;
        input: HTMLInputElement;
        pollRow: HTMLTemplateElement;
        section: HTMLElement;
    };

    function findParts(root: HTMLElement): PlayParts | null {
        const parts = {
            feed: root.querySelector<HTMLElement>('[data-play-feed]'),
            form: root.querySelector<HTMLFormElement>('[data-play-form]'),
            input: root.querySelector<HTMLInputElement>('[data-play-input]'),
            pollRow: root.querySelector<HTMLTemplateElement>('[data-play-poll-row]'),
            section: root.closest('section'),
        };
        return Object.values(parts).every(Boolean) ? (parts as PlayParts) : null;
    }

    function setupPlayground(root: HTMLElement) {
        if (root.dataset.playReady === 'true') return;
        root.dataset.playReady = 'true';

        const parts = findParts(root);
        if (!parts) return;
        const { feed, form, input, pollRow, section } = parts;

        let visible = false;
        let ambientTimer = 0;
        let quietNoteShown = false;
        let seq = 0;

        function trim() {
            while (feed!.children.length > 14) feed!.removeChild(feed!.firstChild!);
        }

        function baseMsg(cls: string) {
            const row = document.createElement('div');
            row.className = `pmsg ${cls}`;
            return row;
        }

        function addChat(name: string, hue: string, text: string, cls = '') {
            const row = baseMsg(cls);
            const who = document.createElement('span');
            who.className = 'pmsg__name';
            who.style.setProperty('--hue', hue);
            who.textContent = name;
            const body = document.createElement('span');
            body.className = 'pmsg__text';
            body.textContent = text;
            row.append(who, body);
            feed!.appendChild(row);
            trim();
            return row;
        }

        function addBot(text: string, delay = 700) {
            const typing = baseMsg('pmsg--bot pmsg--typing');
            const who = document.createElement('span');
            who.className = 'pmsg__name';
            who.textContent = 'itsbagelbot';
            const dots = document.createElement('span');
            dots.className = 'pmsg__text';
            const line = document.createElement('span');
            line.className = 'bb-drawline';
            dots.append(line);
            typing.append(who, dots);
            feed!.appendChild(typing);
            trim();

            const wait = reduceMotion.matches ? 80 : delay;
            window.setTimeout(() => {
                typing.remove();
                addChat('itsbagelbot', '', text, 'pmsg--bot');
            }, wait);
        }

        function addPoll() {
            addBot(S.pollUp, 500);
            window.setTimeout(() => {
                const bubble = baseMsg('pmsg--poll');
                const q = document.createElement('span');
                q.className = 'ppoll__q';
                q.textContent = S.pollQ;
                bubble.appendChild(q);

                const rows: Array<[string, number]> = [[S.pollYes, 68], [S.pollAlways, 32]];
                const bars = rows.map(([label, pct]) => {
                    const row = pollRow.content.firstElementChild!.cloneNode(true) as HTMLElement;
                    const bar = row.querySelector<HTMLElement>('[role="progressbar"]')!;
                    bar.setAttribute('aria-label', label);
                    row.querySelector('[data-play-poll-label]')!.textContent = `${label} ${pct}%`;
                    bubble.appendChild(row);
                    return { bar, pct };
                });
                feed!.appendChild(bubble);
                trim();
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        bars.forEach(({ bar, pct }) => {
                            bar.style.setProperty('--progress', String(pct / 100));
                            bar.setAttribute('aria-valuenow', String(pct));
                        });
                    });
                });
            }, reduceMotion.matches ? 120 : 900);
        }

        function addSpam() {
            const line = SPAM_LINES[seq++ % SPAM_LINES.length];
            const row = addChat('definitely_human_01', '#d98a8a', line, 'pmsg--spam');
            const catchDelay = reduceMotion.matches ? 150 : 650;
            window.setTimeout(() => {
                row.classList.add('is-caught');
                window.setTimeout(() => {
                    const note = baseMsg('pmsg--caught');
                    note.textContent = S.spamRemoved;
                    row.replaceWith(note);
                    trim();
                }, reduceMotion.matches ? 100 : 480);
            }, catchDelay);
        }

        function handleCommand(raw: string) {
            const text = raw.trim();
            if (!text) return;
            addChat('you', '#e0c49a', text, 'pmsg--you');

            if (!text.startsWith('!')) {
                if (!quietNoteShown) {
                    quietNoteShown = true;
                    window.setTimeout(() => {
                        const note = baseMsg('pmsg--caught');
                        note.textContent = S.quiet;
                        feed!.appendChild(note);
                        trim();
                    }, reduceMotion.matches ? 100 : 800);
                }
                return;
            }

            const cmd = text.split(/\s+/)[0].toLowerCase();
            if (cmd === '!poll') { addPoll(); return; }
            const reply = REPLIES[cmd];
            if (reply) { addBot(reply); return; }
            addBot(S.unknown.replace('{cmd}', cmd));
        }

        function scheduleAmbient() {
            window.clearTimeout(ambientTimer);
            if (!visible || document.hidden) return;
            const wait = 2600 + Math.random() * 2600;
            ambientTimer = window.setTimeout(() => {
                const [name, hue] = VIEWERS[Math.floor(Math.random() * VIEWERS.length)];
                addChat(name, hue, S.ambient[Math.floor(Math.random() * S.ambient.length)]);
                if (++seq % 7 === 0) addSpam();
                scheduleAmbient();
            }, wait);
        }

        const io = new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            if (visible) scheduleAmbient();
            else window.clearTimeout(ambientTimer);
        }, { rootMargin: '80px' });
        io.observe(root);

        document.addEventListener('visibilitychange', scheduleAmbient);

        addChat('gg_beans', '#52b788', S.seed1);
        addChat('moth_lamp', '#e0c49a', S.seedTry);

        form.addEventListener('submit', (event) => {
            event.preventDefault();
            handleCommand(input.value);
            input.value = '';
            input.focus();
        });

        section.querySelectorAll<HTMLButtonElement>('[data-play-cmd]').forEach((btn) => {
            btn.addEventListener('click', () => handleCommand(btn.dataset.playCmd ?? ''));
        });

        section.querySelector<HTMLButtonElement>('[data-play-spam]')?.addEventListener('click', () => addSpam());
    }

    function setup() {
        document.querySelectorAll<HTMLElement>('[data-playground]').forEach(setupPlayground);
    }

    setup();
    document.addEventListener('astro:page-load', setup);
</script>
