import Eyebrow from '@bagel/ui/astro/Eyebrow.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Section from '@bagel/ui/astro/Section.astro';
import Text from '@bagel/ui/astro/Text.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const beats = [
    { eyebrow: t('encryption.p1Eyebrow'), title: t('encryption.p1Title'), desc: t('encryption.p1Desc') },
    { eyebrow: t('encryption.p2Eyebrow'), title: t('encryption.p2Title'), desc: t('encryption.p2Desc') },
    { eyebrow: t('encryption.p3Eyebrow'), title: t('encryption.p3Title'), desc: t('encryption.p3Desc') },
];
---

<Section size="page" class="enc" id="enc-section">
    <ol class="enc__list">
        {beats.map((beat, i) => (
            <li class="enc__beat" data-reveal style={`--reveal-i: ${i}`}>
                <Eyebrow tone="go" class="enc__eyebrow"><span data-fit="block">{beat.eyebrow}</span></Eyebrow>
                <Heading level={3} as="h2" class="enc__title"><span data-fit="block">{beat.title}</span></Heading>
                <Text class="enc__desc"><span data-fit="block">{beat.desc}</span></Text>
            </li>
        ))}
    </ol>
</Section>

<style>
    .enc {
        position: relative;
        padding-inline: 24px;
        max-width: var(--bb-content-hero);
        margin: 0 auto;
        z-index: 3;
    }

    .enc__list {
        display: flex;
        flex-direction: column;
        gap: 48px;
        padding: 0;
        margin: 0;
        list-style: none;
    }

    .enc__beat {
        min-width: 0;
    }

    .enc__beat :where(h2, p, span) {
        overflow-wrap: normal;
        word-break: normal;
        hyphens: none;
    }

    .enc__eyebrow {
        display: block;
        height: calc(var(--enc-eyebrow-lines, 1) * 1lh);
        margin-bottom: 14px;
    }

    .enc__title {
        height: calc(var(--enc-title-lines, 2) * 1lh);
        font-weight: 800;
        letter-spacing: var(--bb-tracking-tight);
        margin-bottom: 16px;
    }

    .enc__desc {
        height: calc(var(--enc-desc-lines, 4) * 1lh);
        opacity: 0.9;
    }

    @media (min-width: 1024px) {
        .enc__list {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 40px;
        }

        .enc__beat {
            --enc-eyebrow-lines: 2;
            --enc-title-lines: 3;
            --enc-desc-lines: 5;
        }
    }

    @media (max-width: 640px) {
        .enc { padding-inline: 20px; }
        .enc__list { gap: 40px; }
        .enc__beat {
            --enc-title-lines: 3;
            --enc-desc-lines: 5;
        }
    }
</style>
