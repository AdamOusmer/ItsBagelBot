import ButtonLink from '@bagel/ui/astro/ButtonLink.astro';
import Cluster from '@bagel/ui/astro/Cluster.astro';
import Eyebrow from '@bagel/ui/astro/Eyebrow.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Lead from '@bagel/ui/astro/Lead.astro';
import Text from '@bagel/ui/astro/Text.astro';
import { getLangFromUrl, useTranslations, localizePath, dashLoginHref } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const titleWords = t('finale.title').split(' ');
---

<section class="finale" data-motion>
    <div class="finale__glow" aria-hidden="true"></div>
    <div class="finale__inner">
        <Eyebrow tone="go" class="finale__eyebrow" data-reveal>{t('finale.eyebrow')}</Eyebrow>
        <Heading level={2} class="finale__title" aria-label={titleWords.join(' ')}>
            {titleWords.map((word, i) => (
                <Fragment><span class="finale__word" aria-hidden="true" data-reveal style={`--reveal-i: ${i + 1}`}>{word}</span>{i < titleWords.length - 1 ? ' ' : ''}</Fragment>
            ))}
        </Heading>
        <Lead class="finale__sub" data-reveal>
            {t('finale.sub')}
        </Lead>
        <Cluster gap={4} justify="center" class="finale__actions" data-reveal>
            <ButtonLink href={dashLoginHref(lang)}>{t('nav.cta')}</ButtonLink>
            <ButtonLink variant="secondary" href={localizePath('/pricing', lang)}>{t('finale.seePricing')}</ButtonLink>
        </Cluster>
        <Text as="span" size="xs" mono tone="muted" class="finale__honesty" data-reveal>
            {t('finale.honesty')}
        </Text>
    </div>
</section>

<style>
    .finale {
        position: relative;
        max-width: none;
        margin: 0;
        padding: clamp(120px, 22vh, 220px) 24px clamp(120px, 20vh, 200px);
        overflow: hidden;
        text-align: center;
        z-index: 3;
        border-top: 1px solid var(--bb-border);
        scroll-margin-top: calc(var(--nav-offset) + 16px);
    }

    @media (max-width: 1023px) {
        .finale {
            padding: clamp(80px, 14vh, 180px) 24px clamp(80px, 14vh, 180px);
        }
    }

    .finale__glow {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 130vmin;
        height: 90vmin;
        translate: -50% -50%;
        pointer-events: none;
        background: radial-gradient(
            55% 60% at 50% 50%,
            rgba(var(--bb-tan-rgb), 0.16) 0%,
            rgba(var(--bb-green-glow-rgb), 0.06) 38%,
            transparent 70%
        );
        animation: finaleBreath 7s ease-in-out infinite;
    }

    @keyframes finaleBreath {
        0%, 100% { opacity: 0.8; scale: 1; }
        50% { opacity: 1; scale: 1.04; }
    }

    .finale__inner {
        position: relative;
        z-index: 2;
        max-width: 680px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .finale__eyebrow {
        margin-bottom: 22px;
        text-shadow: 0 0 16px rgba(var(--bb-green-glow-rgb), 0.55), 0 2px 12px rgba(var(--bb-shadow-rgb), 0.95);
    }

    .finale__title {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        column-gap: 0.28em;
        font-weight: 800;
        font-size: clamp(2.1rem, 5.5vw, 3.6rem);
        letter-spacing: var(--bb-tracking-tight);
        margin: 0 0 20px;
        max-width: 18ch;
        text-shadow:
            0 0 24px rgba(var(--bb-white-rgb), 0.18),
            0 3px 18px rgba(var(--bb-shadow-rgb), 0.9),
            0 0 40px rgba(var(--bb-tan-rgb), 0.24);
    }

    .finale__word { display: inline-block; }

    .finale__sub {
        --reveal-i: 8;
        margin: 0 0 40px;
    }

    .finale__actions {
        --reveal-i: 9;
    }

    .finale__honesty {
        --reveal-i: 10;
        margin-top: 30px;
        opacity: 0.75;
    }

    @media (prefers-reduced-motion: reduce) {
        .finale__glow { animation: none; }
    }

    @media (max-width: 480px) {
        .finale__actions {
            flex-direction: column;
            width: 100%;
        }
    }
</style>
