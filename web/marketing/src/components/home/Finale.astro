import ButtonLink from '@bagel/ui/astro/ButtonLink.astro';
import Cluster from '@bagel/ui/astro/Cluster.astro';
import Eyebrow from '@bagel/ui/astro/Eyebrow.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Icon from '@bagel/ui/astro/Icon.astro';
import Lead from '@bagel/ui/astro/Lead.astro';
import Text from '@bagel/ui/astro/Text.astro';
import TextLink from '@bagel/ui/astro/TextLink.astro';
import { getLangFromUrl, useTranslations, localizePath, dashLoginHref } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const titleWords = t('finale.title').split(' ');
---

<section class="finale" data-motion>
    <div class="finale__glow" aria-hidden="true"></div>
    <div class="finale__inner">
        <Eyebrow tone="go" class="finale__eyebrow" data-reveal><span data-fit>{t('finale.eyebrow')}</span></Eyebrow>
        <Heading level={2} class="finale__title" aria-label={titleWords.join(' ')}>
            <span class="finale__title-text" data-fit="block">{titleWords.map((word, i) => (
                <Fragment><span class="finale__word" aria-hidden="true" data-reveal style={`--reveal-i: ${i + 1}`}>{word}</span>{i < titleWords.length - 1 ? ' ' : ''}</Fragment>
            ))}</span>
        </Heading>
        <Lead class="finale__sub" data-reveal><span data-fit="block">{t('finale.sub')}</span></Lead>
        <Cluster gap={4} justify="center" class="finale__actions" data-reveal>
            <ButtonLink class="finale__cta" href={dashLoginHref(lang)}><span data-fit>{t('nav.cta')}</span></ButtonLink>
            <ButtonLink class="finale__cta" variant="secondary" href={localizePath('/pricing', lang)}><span data-fit>{t('finale.seePricing')}</span></ButtonLink>
        </Cluster>
        <Text as="span" size="xs" mono tone="muted" class="finale__honesty" data-reveal><span data-fit="block">{t('finale.honesty')}</span></Text>
        <div class="finale__eco" data-reveal>
            <span class="finale__eco-row">
                <Icon name="leaf" size={16} strokeWidth={1.5} class="finale__leaf" />
                <span class="finale__eco-title"><span data-fit>{t('ecoFriendly.title')}</span></span>
            </span>
            <span class="finale__eco-row">
                <TextLink variant="quiet" class="finale__eco-link" href="https://www.websitecarbon.com/website/itsbagelbot-com/" label="Website Carbon: ItsBagelBot" external />
                <TextLink variant="quiet" class="finale__eco-link" href="https://www.websitecarbon.com/website/dashboard-itsbagelbot-com-login/" label="Website Carbon: Dashboard" external />
            </span>
        </div>
    </div>
</section>

<style>
    .finale {
        position: relative;
        max-width: none;
        margin: 0;
        padding: clamp(60px, 11vh, 110px) 24px clamp(60px, 10vh, 100px);
        overflow: hidden;
        text-align: center;
        z-index: 3;
        border-top: 1px solid var(--bb-border);
        scroll-margin-top: calc(var(--nav-offset) + 16px);
    }

    @media (max-width: 1023px) {
        .finale {
            padding: clamp(48px, 7vh, 90px) 24px clamp(48px, 7vh, 90px);
        }
    }

    .finale__glow {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 130vmin;
        height: 90vmin;
        translate: -50% -50%;
        pointer-events: none;
        background: radial-gradient(
            55% 60% at 50% 50%,
            rgba(var(--bb-tan-rgb), 0.16) 0%,
            rgba(var(--bb-green-glow-rgb), 0.06) 38%,
            transparent 70%
        );
        animation: finaleBreath 7s ease-in-out infinite;
    }

    @keyframes finaleBreath {
        0%, 100% { opacity: 0.8; scale: 1; }
        50% { opacity: 1; scale: 1.04; }
    }

    .finale__inner {
        position: relative;
        z-index: 2;
        max-width: 680px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .finale__eyebrow {
        width: 100%;
        margin-bottom: 22px;
        text-shadow: 0 0 16px rgba(var(--bb-green-glow-rgb), 0.55), 0 2px 12px rgba(var(--bb-shadow-rgb), 0.95);
    }

    .finale__title {
        display: flex;
        flex-direction: column;
        justify-content: safe center;
        width: 100%;
        height: calc(var(--finale-title-lines, 4) * 1lh);
        font-weight: 800;
        font-size: clamp(2.1rem, 5.5vw, 3.6rem);
        letter-spacing: var(--bb-tracking-tight);
        margin: 0 0 20px;
        max-width: 18ch;
        text-shadow:
            0 0 24px rgba(var(--bb-white-rgb), 0.18),
            0 3px 18px rgba(var(--bb-shadow-rgb), 0.9),
            0 0 40px rgba(var(--bb-tan-rgb), 0.24);
    }

    .finale__title-text {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        column-gap: 0.28em;
    }

    .finale__word { display: inline-block; }

    .finale__sub {
        --reveal-i: 8;
        width: 100%;
        height: calc(var(--finale-sub-lines, 2) * 1lh);
        margin: 0 0 40px;
    }

    .finale__actions {
        --reveal-i: 9;
    }

    .finale__cta {
        --btn-w: 216px;
        --btn-justify: center;
    }

    .finale__honesty {
        --reveal-i: 10;
        width: 100%;
        height: calc(var(--finale-honesty-lines, 1) * 1lh);
        margin-top: 30px;
        opacity: 0.75;
    }

    .finale__eco {
        --reveal-i: 11;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        width: 100%;
        margin-top: 28px;
    }

    .finale__eco-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 8px 16px;
        width: 100%;
    }

    .finale__eco :global(.finale__leaf) {
        flex: none;
        width: 16px;
        height: 16px;
        color: var(--bb-green-glow);
    }

    .finale__eco-title {
        display: block;
        flex: none;
        width: min(100%, 280px);
        height: calc(var(--finale-eco-lines, 1) * 1lh);
        font-size: var(--bb-text-xs);
        color: var(--bb-white);
        opacity: 0.75;
    }

    .finale__eco :global(.finale__eco-link) {
        font-family: var(--bb-font-mono);
        font-size: var(--bb-text-xs);
        color: var(--bb-green-glow);
        transition: color var(--bb-dur-fast) ease;
    }

    .finale__eco :global(.finale__eco-link:hover) {
        color: var(--bb-white);
    }

    @media (prefers-reduced-motion: reduce) {
        .finale__glow { animation: none; }
    }

    @media (max-width: 480px) {
        .finale__actions {
            flex-direction: column;
            width: 100%;
        }
    }
</style>
