import Grid from '@bagel/ui/astro/Grid.astro';

interface Props {
    cols?: 3 | 4;
    class?: string;
}

const { cols = 3, class: cls = '' } = Astro.props;
---

<Grid class:list={['bento', `bento--${cols}`, cls]}><slot /></Grid>

<style>
    @media (min-width: 720px) {
        .bento {
            --grid-cols: 2;
        }

        .bento > :global(.fcard--span-3),
        .bento > :global(:last-child:nth-child(odd):not(.fcard--span-2)) {
            grid-column: 1 / -1;
        }
    }

    @media (min-width: 1024px) {
        .bento--3 {
            --grid-cols: 3;
        }

        .bento--4 {
            --grid-cols: 4;
        }

        .bento > :global(:last-child:nth-child(odd):not(.fcard--span-2)) {
            grid-column: auto;
        }

        .bento > :global(.fcard--span-2) {
            grid-column: span 2;
        }

        .bento > :global(.fcard--span-3) {
            grid-column: 1 / -1;
        }
    }
</style>
