import { SITE } from '@bagel/kit/site-links';

import '../styles/style.css';
import '@bagel/ui/styles/elements/fit.css';
import '../lib/contentGuards';

import syneLatinWoff2 from '@bagel/ui/fonts/syne-latin.woff2?url';
import dmSansLatinWoff2 from '@bagel/ui/fonts/dm-sans-latin.woff2?url';

import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import logoImage from '../assets/LogoBOT.png';
import Cursor from '@bagel/ui/astro/Cursor.astro'
import Nav from '@bagel/ui/astro/Nav.astro'
import Footer from '@bagel/ui/astro/Footer.astro'
import LanguageSwitcher from '@bagel/ui/astro/LanguageSwitcher.astro'
import SocialRail from '@bagel/ui/astro/SocialRail.astro'
import { SOCIAL_LINKS } from '@bagel/kit/social'
import {
    SITE_NAV,
    SITE_FOOTER,
    SITE_LEGAL,
    dashboardHref,
    resolveSiteLinks,
    resolveSiteColumns,
    type SiteLinkContext,
} from '@bagel/kit/site-links'
import Brackets from '@bagel/ui/astro/Brackets.astro'
import ReadingProgress from '@bagel/ui/astro/ReadingProgress.astro'
import SkipLink from '@bagel/ui/astro/SkipLink.astro'
import ButtonLink from '@bagel/ui/astro/ButtonLink.astro'
import Cluster from '@bagel/ui/astro/Cluster.astro'
import Text from '@bagel/ui/astro/Text.astro'
import TextLink from '@bagel/ui/astro/TextLink.astro'
import { OWNER_IGN, OWNER_PROFILE_URL } from '../owner';
import { getLangFromUrl, LOCALIZED_PATHS, locales, defaultLang, splitLocale, localizePath, useTranslations, dashLoginHref, localeOptions } from '../i18n/ui';

interface Props {
    title?: string;
    description?: string;
    image?: string;
    ogType?: string;
    noindex?: boolean;
    extraSchema?: Record<string, unknown>[];
}

const {
    title = 'ItsBagelBot. Your Stream, Your Rules',
    description = 'The all-in-one Twitch companion baked for independence. Automated moderation, custom commands, and engagement tools.',
    image = '/og-image.png',
    ogType = 'website',
    noindex = false,
    extraSchema = [],
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(image, Astro.site).href;
const siteName = 'ItsBagelBot';
const ogLocale = t('lang.ogLocale');
const altOgLocales = locales.filter((l) => l !== lang).map((l) => useTranslations(l)('lang.ogLocale'));

const robotsContent = noindex
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const ORIGIN = new URL(Astro.site!).origin;
const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Organization',
            '@id': `${ORIGIN}/#organization`,
            name: siteName,
            url: `${ORIGIN}/`,
            logo: `${ORIGIN}/android-chrome-512x512.png`,
            description,
            sameAs: [
                SITE.twitch,
                SITE.discord,
                SITE.github,
            ],
        },
        {
            '@type': 'WebSite',
            '@id': `${ORIGIN}/#website`,
            url: `${ORIGIN}/`,
            name: siteName,
            description,
            inLanguage: [...locales],
            publisher: { '@id': `${ORIGIN}/#organization` },
        },
        {
            '@type': 'SoftwareApplication',
            '@id': `${ORIGIN}/#software`,
            name: siteName,
            applicationCategory: 'UtilitiesApplication',
            applicationSubCategory: 'Twitch chat bot',
            operatingSystem: 'Web',
            url: `${ORIGIN}/`,
            image: `${ORIGIN}/og-image.png`,
            description,
            publisher: { '@id': `${ORIGIN}/#organization` },
            offers: {
                '@type': 'Offer',
                price: '0',
                priceCurrency: 'USD',
                availability: 'https://schema.org/InStock',
            },
            featureList: [
                'Spotify song requests for Twitch chat (!sr, !skip, !srlist, !song / !np now playing)',
                'Automated chat moderation',
                'Custom commands and variables',
                'Timers',
                'Channel Points rewards',
                'Giveaways',
                'Polls',
                'Game stat integrations (Valorant rank, Hypixel Bedwars, MCSR Ranked, Fortnite)',
            ],
            keywords: [
                'Twitch Spotify song requests',
                'Twitch song request bot',
                '!sr command Twitch',
                'Spotify queue from Twitch chat',
                'free Twitch song request bot',
                'Twitch chat bot',
                'Valorant rank command Twitch',
            ],
        },
        ...extraSchema,
    ],
};

const { path: basePath } = splitLocale(Astro.url.pathname);
const hasAlternates = LOCALIZED_PATHS.has(basePath);
const alternates = hasAlternates
    ? locales.map((l) => ({ lang: l, href: new URL(localizePath(basePath, l), Astro.site).href }))
    : [];
const xDefaultHref = new URL(localizePath(basePath, defaultLang), Astro.site).href;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
    href.startsWith("/") && href.replace(/\/+$/, "") === currentPath;

const langQuery = lang === defaultLang ? '' : `?lang=${lang}`;

const navContext = {
    path: (path: string, englishOnly?: boolean) => localizePath(path, englishOnly ? defaultLang : lang),
    label: (key: string) => t(`nav.${key}` as Parameters<typeof t>[0]),
    langQuery,
    isActive,
} satisfies SiteLinkContext;

const footerContext = {
    ...navContext,
    label: (key: string) => t(`footer.${key}` as Parameters<typeof t>[0]),
} satisfies SiteLinkContext;

const navLinks = resolveSiteLinks(SITE_NAV, navContext);
const footerColumns = resolveSiteColumns(SITE_FOOTER, footerContext);
const footerLegal = resolveSiteLinks(SITE_LEGAL, footerContext);
const navLocales = localeOptions(Astro.url);
const getAppHref = dashboardHref('/?install=1', langQuery);

const navLogo = await getImage({ src: logoImage, width: 52, height: 52, format: 'webp' });
const footerLogo = await getImage({ src: logoImage, width: 110, height: 110, format: 'webp' });

const [ownerBefore, ownerAfter = ''] = t('about.line1').split('{ign}');
const [keyBefore, keyAfter = ''] = t('about.mcLine').split('{ign}');
const isHome = (currentPath === "/" ? "/" : `${currentPath}/`) === localizePath('/', lang);

const devScriptSources = import.meta.env.DEV
    ? " 'unsafe-inline' 'unsafe-eval'"
    : "";
const devConnectSources = import.meta.env.DEV
    ? " ws://localhost:* ws://127.0.0.1:* http://localhost:* http://127.0.0.1:*"
    : "";
const contentSecurityPolicy = [
    "default-src 'self'",
    "img-src 'self' data:",
    "style-src 'self' 'unsafe-inline'",
    "font-src 'self'",
    `script-src 'self'${devScriptSources} https://static.cloudflareinsights.com`,
    `connect-src 'self' https://cloudflareinsights.com${devConnectSources}`,
    "base-uri 'self'",
    "form-action 'self'",
].join('; ');
---


<!doctype html>
<html lang={lang}>

<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta
        http-equiv="Content-Security-Policy"
        content={contentSecurityPolicy}
    />
    <meta name="referrer" content="strict-origin-when-cross-origin"/>

    <link rel="canonical" href={canonicalURL}/>
    <meta name="robots" content={robotsContent}/>

    <meta name="theme-color" content="#0a0a0a"/>
    <meta name="color-scheme" content="dark"/>

    <meta name="generator" content={Astro.generator}/>

    <link rel="preload" href={syneLatinWoff2} as="font" type="font/woff2" crossorigin/>
    <link rel="preload" href={dmSansLatinWoff2} as="font" type="font/woff2" crossorigin/>

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=bot-1">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=bot-1">
    <link rel="shortcut icon" href="/favicon.ico?v=bot-1">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <meta name="description" content={description} />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName}: ${description}`} />
    <meta property="og:locale" content={ogLocale} />
    {altOgLocales.map((code) => (
        <meta property="og:locale:alternate" content={code} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={`${siteName}: ${description}`} />

    {hasAlternates && (
        <Fragment>
            {alternates.map((alt) => (
                <link rel="alternate" hreflang={alt.lang} href={alt.href} />
            ))}
            <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
        </Fragment>
    )}

    <title>{title}</title>

    <ClientRouter />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
</head>

<body>
    <SkipLink href="#main-content" label={t('skip.toContent')} />
    <main id="main-content">
        <slot/>
    </main>
    <Nav
        brand={{ title: 'ItsBagelBot', href: localizePath("/", lang), logoSrc: navLogo.src, logoAlt: '' }}
        links={navLinks}
        cta={{ href: dashLoginHref(lang), label: t('nav.cta') }}
        locales={navLocales}
        label={t('nav.primary')}
        menuLabels={{ open: t('nav.menuOpen'), close: t('nav.menuClose'), panel: t('menu.primary') }}
        menuMeta={t('menu.meta')}
    >
        <Fragment slot="mobileFooter">
            <ButtonLink variant="ghost" block href={getAppHref}>{t('nav.getApp')}</ButtonLink>
            <Cluster justify="center"><LanguageSwitcher options={navLocales} menuId="mobile-menu-lang" variant="field" /></Cluster>
        </Fragment>
    </Nav>
    <SocialRail items={SOCIAL_LINKS} label={t('nav.social')}/>
    <ReadingProgress/>
    <Brackets/>
    <Footer
        brand={{ title: 'ItsBagelBot', sub: t('footer.tagline'), logoSrc: footerLogo.src, logoAlt: t('footer.logoAlt') }}
        signoff={{ line: t('footer.signoff'), sub: t('footer.signoffSub') }}
        columns={footerColumns}
        legal={footerLegal}
        copyright="© 2026 ItsBagelBot"
        note={t('footer.note')}
    >
        {isHome && <section class="colophon" slot="colophon">
            <div class="colophon__owner" id="about">
                <Text size="xs" class="colophon__line"><span data-fit="block">{ownerBefore}<TextLink variant="inline" href={OWNER_PROFILE_URL} external>{OWNER_IGN}</TextLink>{ownerAfter}</span></Text>
                <Text class="colophon__key"><span data-fit="block">{keyBefore}<TextLink variant="inline" href={OWNER_PROFILE_URL} external>{OWNER_IGN}</TextLink>{keyAfter}</span></Text>
            </div>
        </section>}
    </Footer>
    <Cursor/>

    <script>
        import '../script/scroll.js';
        import '../script/dom-motion/index.js';
        import '../script/reveal.js';
        import '../script/motion.js';
        import '../script/interactions.js';
        import '../script/decode.js';
        import '../script/easter-egg';
    </script>

    <script>
        import { mountTextFit } from '@bagel/ui/lib/text-fit';

        let disposeTextFit: (() => void) | null = null;

        function teardownTextFit() {
            disposeTextFit?.();
            disposeTextFit = null;
        }

        function setupTextFit() {
            teardownTextFit();
            disposeTextFit = mountTextFit(document);
        }

        setupTextFit();
        document.addEventListener('astro:page-load', setupTextFit);
        document.addEventListener('astro:before-swap', teardownTextFit);
        window.addEventListener('pagehide', teardownTextFit);
    </script>

</body>
</html>

<style>
    main {
        display: contents;
    }

    .colophon {
        position: relative;
        max-width: var(--bb-content-max);
        margin: 0 auto;
        padding: 28px var(--bb-space-5);
        border-top: 1px solid var(--bb-border);
        text-align: center;
    }

    .colophon__owner {
        max-width: 760px;
        margin: 0 auto;
    }

    .colophon__line {
        height: calc(var(--colophon-lines, 1) * 1lh);
        margin: 0 0 var(--bb-space-2);
    }

    .colophon__key {
        height: calc(var(--colophon-lines, 1) * 1lh);
    }

    @media (max-width: 640px) {
        .colophon__owner {
            --colophon-lines: 2;
        }
    }
</style>
