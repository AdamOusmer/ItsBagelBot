import '../styles/style.css';
// Side-effect import: the build-time guards on src/content and the locale
// catalogs. Here because every page renders through this layout, so there is
// no page that can skip them.
import '../lib/contentGuards';

// Fonts are self-hosted: no third-party origin, and no render-blocking
// stylesheet on one. The original <link href="fonts.googleapis.com/css2?...">
// made a cold visit pay DNS+TLS to two hosts before first paint, on CSS that
// browsers cannot reuse across sites because the HTTP cache is partitioned per
// top-level site. Serving the woff2 files from /_astro (immutable-cached in
// public/_headers) removes both round-trips.
//
// The three Fontsource packages that used to be imported here
// (@fontsource-variable/syne, @fontsource-variable/dm-sans,
// @fontsource/dm-mono) are gone: their @font-face rules now live once in
// @bagel/ui/styles/fonts.css, which style.css imports, so the console and docs
// get the identical faces instead of two more hand-maintained copies. That
// also drops the latin-ext and greek subsets Fontsource shipped and this site
// never requested — 15 woff2 files in dist/_astro became 9.
// Caveat stays on Fontsource: it is a decorative accent only this site
// renders, so it does not belong in the shared library.
import '@fontsource-variable/caveat';
// Preload only the two faces that render above the fold (display + body, latin
// upright). Italic, mono and Caveat load on demand — nothing above the fold
// asks for them, and preloading a font the first screen does not use costs the
// bandwidth the preload was meant to save.
import syneLatinWoff2 from '@bagel/ui/fonts/syne-latin.woff2?url';
import dmSansLatinWoff2 from '@bagel/ui/fonts/dm-sans-latin.woff2?url';

import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import logoImage from '../assets/LogoBOT.png';
import Cursor from '@bagel/ui/astro/Cursor.astro'
// The chrome is the design library's, rendered here rather than through a pair
// of site-local wrappers. Nav.astro and Footer.astro used to sit in
// components/layout/ and did nothing but resolve this site's links before
// handing them to these same two components; the console had its own matching
// pair. Four files, two implementations, one bar. What the library refuses to
// know -- the copy and the destinations -- is resolved below, and the
// destinations are @bagel/kit/site-links, the SAME list the console's
// signed-out layout resolves in web/dashboard/src/routes/(public)/+layout.svelte.
import Nav from '@bagel/ui/astro/Nav.astro'
import Footer from '@bagel/ui/astro/Footer.astro'
import LanguageSwitcher from '@bagel/ui/astro/LanguageSwitcher.astro'
import SocialRail from '@bagel/ui/astro/SocialRail.astro'
import { SOCIAL_LINKS } from '@bagel/kit/social'
import {
    SITE_NAV,
    SITE_FOOTER,
    SITE_LEGAL,
    dashboardHref,
    resolveSiteLinks,
    resolveSiteColumns,
    type SiteLinkContext,
} from '@bagel/kit/site-links'
import Brackets from '@bagel/ui/astro/Brackets.astro'
import ReadingProgress from '@bagel/ui/astro/ReadingProgress.astro'
import { OWNER_IGN, OWNER_PROFILE_URL } from '../owner';
import { getLangFromUrl, LOCALIZED_PATHS, locales, defaultLang, splitLocale, localizePath, useTranslations, dashLoginHref, localeOptions } from '../i18n/ui';

interface Props {
    title?: string;
    description?: string;
    /** Share-card image: absolute URL or site-root path. Defaults to /og-image.png. */
    image?: string;
    /** Open Graph object type. 'website' for landing pages, 'article' for legal/docs. */
    ogType?: string;
    /** Keep the page out of search indexes (still crawlable for link discovery). */
    noindex?: boolean;
    /** Page-specific JSON-LD nodes appended to the site @graph (TechArticle, BreadcrumbList, …). */
    extraSchema?: Record<string, unknown>[];
}

const {
    title = 'ItsBagelBot. Your Stream, Your Rules',
    description = 'The all-in-one Twitch companion baked for independence. Automated moderation, custom commands, and engagement tools.',
    image = '/og-image.png',
    ogType = 'website',
    noindex = false,
    extraSchema = [],
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Absolute URLs for canonical + social cards. Astro.site is the production
// origin (astro.config); resolving against it turns page-relative paths into
// the fully-qualified URLs crawlers and share-card scrapers require.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(image, Astro.site).href;
const siteName = 'ItsBagelBot';
const ogLocale = t('lang.ogLocale');
// One og:locale:alternate per other locale, each in its own tongue's code.
const altOgLocales = locales.filter((l) => l !== lang).map((l) => useTranslations(l)('lang.ogLocale'));

// Let AI answer-engines and search bots pull the biggest preview + full
// snippet; noindex pages still allow link-following for discovery.
const robotsContent = noindex
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// Structured data (@graph): who publishes the site, the site itself, and the
// product. Search engines and LLMs read this to describe ItsBagelBot precisely
// (name, free pricing, feature list, official links). type="application/ld+json"
// is a non-executable data island, so the strict script-src CSP doesn't gate it.
const ORIGIN = new URL(Astro.site!).origin;
const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Organization',
            '@id': `${ORIGIN}/#organization`,
            name: siteName,
            url: `${ORIGIN}/`,
            logo: `${ORIGIN}/android-chrome-512x512.png`,
            description,
            sameAs: [
                'https://twitch.tv/itsbagelbot',
                'https://discord.gg/SZ2remwSDv',
                'https://github.com/AdamOusmer/ItsBagelBot',
            ],
        },
        {
            '@type': 'WebSite',
            '@id': `${ORIGIN}/#website`,
            url: `${ORIGIN}/`,
            name: siteName,
            description,
            inLanguage: [...locales],
            publisher: { '@id': `${ORIGIN}/#organization` },
        },
        {
            '@type': 'SoftwareApplication',
            '@id': `${ORIGIN}/#software`,
            name: siteName,
            applicationCategory: 'UtilitiesApplication',
            applicationSubCategory: 'Twitch chat bot',
            operatingSystem: 'Web',
            url: `${ORIGIN}/`,
            image: `${ORIGIN}/og-image.png`,
            description,
            publisher: { '@id': `${ORIGIN}/#organization` },
            offers: {
                '@type': 'Offer',
                price: '0',
                priceCurrency: 'USD',
                availability: 'https://schema.org/InStock',
            },
            featureList: [
                'Spotify song requests for Twitch chat (!sr, !skip, !srlist, !song / !np now playing)',
                'Automated chat moderation',
                'Custom commands and variables',
                'Timers',
                'Channel Points rewards',
                'Giveaways',
                'Polls',
                'Game stat integrations (Valorant rank, Hypixel Bedwars, MCSR Ranked, Fortnite)',
            ],
            // Song requests are the highest-intent entry point into the
            // product ("twitch spotify song request bot"), so the terms people
            // actually type sit in the graph as well as in the page copy:
            // answer engines quote the graph verbatim when they name features.
            keywords: [
                'Twitch Spotify song requests',
                'Twitch song request bot',
                '!sr command Twitch',
                'Spotify queue from Twitch chat',
                'free Twitch song request bot',
                'Twitch chat bot',
                'Valorant rank command Twitch',
            ],
        },
        ...extraSchema,
    ],
};

// hreflang alternates for the routes that exist in every locale, so search
// engines pair the translated versions instead of treating them as duplicates.
// splitLocale strips any locale prefix to the shared base path; each locale then
// re-localizes it. x-default points at the default locale.
const { path: basePath } = splitLocale(Astro.url.pathname);
const hasAlternates = LOCALIZED_PATHS.has(basePath);
const alternates = hasAlternates
    ? locales.map((l) => ({ lang: l, href: new URL(localizePath(basePath, l), Astro.site).href }))
    : [];
const xDefaultHref = new URL(localizePath(basePath, defaultLang), Astro.site).href;

// ─────────────────────────── the chrome's data ───────────────────────────
// Trailing slashes normalized both sides: localizePath always emits one and
// Astro serves both shapes, so a raw compare lights nothing.
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
    href.startsWith("/") && href.replace(/\/+$/, "") === currentPath;

// The console has no localized routes, so a link into it carries ?lang=.
const langQuery = lang === defaultLang ? '' : `?lang=${lang}`;

// Marketing keeps RELATIVE localized paths so its own links stay on-site and
// keep Astro's prefetching; the console resolves the same defs to absolute
// itsbagelbot.com URLs, because from there every one of them leaves the app.
const navContext = {
    path: (path: string) => localizePath(path, lang),
    label: (key: string) => t(`nav.${key}` as Parameters<typeof t>[0]),
    langQuery,
    isActive,
} satisfies SiteLinkContext;

const footerContext = {
    ...navContext,
    label: (key: string) => t(`footer.${key}` as Parameters<typeof t>[0]),
} satisfies SiteLinkContext;

const navLinks = resolveSiteLinks(SITE_NAV, navContext);
const footerColumns = resolveSiteColumns(SITE_FOOTER, footerContext);
const footerLegal = resolveSiteLinks(SITE_LEGAL, footerContext);
const navLocales = localeOptions(Astro.url);
const getAppHref = dashboardHref('/?install=1', langQuery);

// The marks are resolved through getImage rather than passed as the raw
// import: LogoBOT.png is a 1 MB source file, and `logoImage.src` would put THAT
// in the bar on every page. 52px is the nav's 26px mark at 2x, 110px the
// footer's 55px. Same reason and same shape as the builder's avatar
// (CommandBuilder.astro).
const navLogo = await getImage({ src: logoImage, width: 52, height: 52, format: 'webp' });
const footerLogo = await getImage({ src: logoImage, width: 110, height: 110, format: 'webp' });

// The ownership colophon is NOT a copy decision: it is bot-specific,
// homepage-only, and load-bearing for an external ownership check, which is
// why @bagel/ui's footer takes it as a slot instead of owning it. It names the
// owner, so it keeps the {ign} placeholder split that lets each locale put the
// linked handle where its own prose needs it. The game trademark notices live
// in the Terms of Service (11-third-party).
const [ownerBefore, ownerAfter = ''] = t('about.line1').split('{ign}');
const [keyBefore, keyAfter = ''] = t('about.mcLine').split('{ign}');
const isHome = (currentPath === "/" ? "/" : `${currentPath}/`) === localizePath('/', lang);

const devScriptSources = import.meta.env.DEV
    ? " 'unsafe-inline' 'unsafe-eval'"
    : "";
const devConnectSources = import.meta.env.DEV
    ? " ws://localhost:* ws://127.0.0.1:* http://localhost:* http://127.0.0.1:*"
    : "";
const contentSecurityPolicy = [
    "default-src 'self'",
    "img-src 'self' data:",
    "style-src 'self' 'unsafe-inline'",
    "font-src 'self'",
    `script-src 'self'${devScriptSources} https://static.cloudflareinsights.com`,
    `connect-src 'self' https://cloudflareinsights.com${devConnectSources}`,
    "base-uri 'self'",
    "form-action 'self'",
].join('; ');
---


<!doctype html>
<html lang={lang}>

<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta
        http-equiv="Content-Security-Policy"
        content={contentSecurityPolicy}
    />
    <meta name="referrer" content="strict-origin-when-cross-origin"/>

    <link rel="canonical" href={canonicalURL}/>
    <meta name="robots" content={robotsContent}/>

    <!-- Browser-chrome tint: matches the dark page bg so the mobile address
         bar blends instead of clashing. -->
    <meta name="theme-color" content="#0a0a0a"/>
    <meta name="color-scheme" content="dark"/>

    <meta name="generator" content={Astro.generator}/>

    <link rel="preload" href={syneLatinWoff2} as="font" type="font/woff2" crossorigin/>
    <link rel="preload" href={dmSansLatinWoff2} as="font" type="font/woff2" crossorigin/>

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=bot-1">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=bot-1">
    <link rel="shortcut icon" href="/favicon.ico?v=bot-1">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <meta name="description" content={description} />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    <!-- Open Graph: link previews on Discord, Facebook, LinkedIn, iMessage. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName}: ${description}`} />
    <meta property="og:locale" content={ogLocale} />
    {altOgLocales.map((code) => (
        <meta property="og:locale:alternate" content={code} />
    ))}

    <!-- Twitter/X large summary card. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={`${siteName}: ${description}`} />

    {hasAlternates && (
        <Fragment>
            {alternates.map((alt) => (
                <link rel="alternate" hreflang={alt.lang} href={alt.href} />
            ))}
            <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
        </Fragment>
    )}

    <title>{title}</title>

    <!-- SPA-style navigation. The site's components re-init on
         astro:page-load and clean up on astro:before-swap; this wires them up.
         Uses Astro's default view transition (no custom ::view-transition
         animation). The router script is bundled (assetsInlineLimit:0 keeps it
         external) so it stays within the strict script-src 'self' CSP. -->
    <ClientRouter />

    <!-- Structured data for search engines + LLM answer engines. -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
</head>

<body>
    <a class="skip-link" href="#main-content">{t('skip.toContent')}</a>
    <main id="main-content">
        <slot/>
    </main>
    <Nav
        brand={{ title: 'ItsBagelBot', href: localizePath("/", lang), logoSrc: navLogo.src, logoAlt: '' }}
        links={navLinks}
        cta={{ href: dashLoginHref(lang), label: t('nav.cta') }}
        locales={navLocales}
        localeLabel="Language"
        ariaLabel={t('nav.primary')}
        menuLabels={{ open: t('nav.menuOpen'), close: t('nav.menuClose'), panel: t('menu.primary') }}
        menuMeta={t('menu.meta')}
    >
        <Fragment slot="mobileFooter">
            <a class="mobile-menu__app" href={getAppHref}>{t('nav.getApp')}</a>
            <div class="mobile-menu__lang"><LanguageSwitcher options={navLocales} ariaLabel="Language" /></div>
        </Fragment>
    </Nav>
    <!-- The rail is @bagel/ui's; the five accounts it points at are the
         bot's, so they come from @bagel/kit. -->
    <SocialRail items={SOCIAL_LINKS} ariaLabel={t('nav.social')}/>
    <ReadingProgress/>
    <Brackets/>
    <Footer
        brand={{ title: 'ItsBagelBot', sub: t('footer.tagline'), logoSrc: footerLogo.src, logoAlt: 'ItsBagelBot Logo' }}
        signoff={{ line: t('footer.signoff'), sub: t('footer.signoffSub') }}
        columns={footerColumns}
        legal={footerLegal}
        copyright="© 2026 ItsBagelBot"
        note={t('footer.note')}
        style="--footer-signoff-sub-font: var(--font-hand, 'Caveat', cursive);"
    >
        {/* Deliberately NOT gated behind data-reveal: every revealed block starts at
            opacity 0 (reveal.css [data-reveal]) and only appears once the reveal
            observer runs, and Hypixel verifies ownership by scanning served HTML for
            the username as visible text. A reviewer with JS off has to find ItsMavey
            here, so this stays statically visible. The id stays "about": it is the
            ownership colophon; tests/site.spec.js scans #about for the NameMC links. */}
        {isHome && <section class="colophon" slot="colophon">
            <div class="colophon__owner" id="about">
                <p class="colophon__line">{ownerBefore}<a
                    class="colophon__ign"
                    href={OWNER_PROFILE_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                >{OWNER_IGN}</a>{ownerAfter}</p>
                <p>{keyBefore}<a
                    class="colophon__ign"
                    href={OWNER_PROFILE_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                >{OWNER_IGN}</a>{keyAfter}</p>
            </div>
        </section>}
    </Footer>
    <Cursor/>

    <script>
        import '../script/scroll.js';
        import '../script/dom-motion/index.js';
        import '../script/reveal.js';
        import '../script/interactions.js';
        import '../script/decode.js';
        import '../script/easter-egg';
    </script>

</body>
</html>

<style>
    .skip-link {
        position: absolute;
        left: 12px;
        /* Parked off-screen with a transform, not with `top: -60px`, so the
           reveal runs on the compositor. `top` animates layout: it was the one
           layout-animating transition on every page of the site, since this
           link is in the shared layout. -72px = the focused 12px offset plus
           the 60px this used to sit at, so the resting and focused positions
           are pixel-identical to before. */
        top: 12px;
        transform: translateY(-72px);
        z-index: 200;
        padding: 10px 16px;
        border-radius: var(--radius-sm);
        background: var(--card-bg, #111110);
        border: 1px solid var(--tan, #c9a87c);
        color: var(--tan-light, #e0c49a);
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.8rem;
        text-decoration: none;
        transition: transform 200ms ease;
    }

    .skip-link:focus {
        transform: translateY(0);
    }

    /* No box: keeps the landmark for a11y without disturbing the hero/Encryption
       sticky + scroll math (which assumes top-level sections are body children). */
    main {
        display: contents;
    }

    /* The two rows this site adds to the panel's footer. They are slotted into
       @bagel/ui's panel, and slotted markup carries the scope attribute of the
       file it is WRITTEN in -- this one -- so these rules reach it. */
    .mobile-menu__app {
        display: block;
        text-align: center;
        font-family: var(--font-mono, "DM Mono", monospace);
        font-size: 0.78rem;
        letter-spacing: 0;
        text-transform: uppercase;
        color: var(--tan-light, #e0c49a);
        text-decoration: underline;
        text-decoration-color: rgba(201, 168, 124, 0.4);
        text-underline-offset: 4px;
        transition: color 200ms ease;
    }

    .mobile-menu__app:active { color: var(--green-glow, #52b788); }

    .mobile-menu__lang {
        display: flex;
        justify-content: center;
    }

    .colophon {
        position: relative;
        padding: 28px 24px;
        border-top: 1px solid var(--border, rgba(255, 255, 255, 0.08));
        text-align: center;
        font-family: var(--font-mono);
        color: var(--muted);
    }

    .colophon__owner {
        max-width: 760px;
        margin: 0 auto;
    }

    /* Named, not `.colophon__owner p`: the colophon's own line. 0.72rem is
       below the type scale's smallest step on purpose -- this is the legal
       footer under the footer, and it is sized to be findable rather than
       read. */
    .colophon__line {
        margin: 0 0 8px;
        font-size: 0.72rem;
        letter-spacing: 0.05em;
        line-height: 1.8;
    }

    .colophon__ign {
        color: var(--tan-light);
        text-decoration: underline;
        text-decoration-color: rgba(224, 196, 154, 0.4);
        text-underline-offset: 3px;
        transition: color 180ms ease, text-decoration-color 180ms ease;
    }

    .colophon__ign:is(:hover, :focus-visible) {
        color: var(--white);
        text-decoration-color: rgba(240, 236, 228, 0.7);
    }
</style>
