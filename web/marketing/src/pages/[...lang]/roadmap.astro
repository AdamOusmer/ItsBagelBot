import Layout from '../../layouts/Layout.astro';
import RoadmapStage from '../../components/roadmap/RoadmapStage.astro';
import { getLangFromUrl, useTranslations, localeStaticPaths } from '../../i18n/ui';
import { itemCatalogs } from '../../lib/roadmap/items';
import { loadRoadmap } from '../../lib/roadmap/linear';
import { localizeRoadmap, staleItems } from '../../lib/roadmap/localize';

export const getStaticPaths = localeStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const roadmap = await loadRoadmap();
const stale = lang === 'en' ? staleItems(roadmap, itemCatalogs) : [];
if (stale.length) console.warn(`[roadmap] Linear copy differs from locales/en/roadmap/items.json for: ${stale.join(', ')}`);
---

<Layout title={t('roadmap.metaTitle')} description={t('roadmap.metaDesc')}>
    <RoadmapStage roadmap={localizeRoadmap(roadmap, lang, itemCatalogs)} />
</Layout>
