import Layout from '../../layouts/Layout.astro';
import FeatureLanding from '../../components/landing/FeatureLanding.astro';
import { getLangFromUrl, useTranslations, dashLoginHref, localizePath, localeStaticPaths } from '../../i18n/ui';

export const getStaticPaths = localeStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('songRequests.metaTitle')} description={t('songRequests.metaDesc')}>
    <FeatureLanding
        eyebrow={t('songRequests.eyebrow')}
        title={t('songRequests.title')}
        lead={t('songRequests.lead')}
        howEyebrow={t('songRequests.howEyebrow')}
        howTitle={t('songRequests.howTitle')}
        steps={[
            { title: t('songRequests.step1Title'), desc: t('songRequests.step1Desc') },
            { title: t('songRequests.step2Title'), desc: t('songRequests.step2Desc') },
            { title: t('songRequests.step3Title'), desc: t('songRequests.step3Desc') },
        ]}
        listEyebrow={t('songRequests.cmdEyebrow')}
        listTitle={t('songRequests.cmdTitle')}
        listItems={[
            { name: t('songRequests.cmd1Name'), desc: t('songRequests.cmd1Desc') },
            { name: t('songRequests.cmd2Name'), desc: t('songRequests.cmd2Desc') },
            { name: t('songRequests.cmd3Name'), desc: t('songRequests.cmd3Desc') },
            { name: t('songRequests.cmd4Name'), desc: t('songRequests.cmd4Desc') },
        ]}
        listNote={t('songRequests.limitsNote')}
        faqEyebrow={t('songRequests.faqEyebrow')}
        faqTitle={t('songRequests.faqTitle')}
        faqItems={[
            { question: t('songRequests.faqQ1'), answer: t('songRequests.faqA1') },
            { question: t('songRequests.faqQ2'), answer: t('songRequests.faqA2') },
            { question: t('songRequests.faqQ3'), answer: t('songRequests.faqA3') },
            { question: t('songRequests.faqQ4'), answer: t('songRequests.faqA4') },
            { question: t('songRequests.faqQ5'), answer: t('songRequests.faqA5') },
            { question: t('songRequests.faqQ6'), answer: t('songRequests.faqA6') },
        ]}
        ctaTitle={t('songRequests.ctaTitle')}
        ctaPrimary={{ href: dashLoginHref(lang), label: t('nav.cta') }}
        ctaSecondary={{ href: localizePath('/guides/modules', lang), label: t('songRequests.ctaGuide') }}
    />
</Layout>
