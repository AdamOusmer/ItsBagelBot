import Layout from '../../layouts/Layout.astro';
import FeatureLanding from '../../components/landing/FeatureLanding.astro';
import { getLangFromUrl, useTranslations, dashLoginHref, localizePath, localeStaticPaths } from '../../i18n/ui';
import { songRows, songExampleLines, landingSchema } from '../../lib/landing';

export const getStaticPaths = localeStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const link = (path: string, label: string) => ({ href: localizePath(path, lang), label });
const table = {
    eyebrow: t('songRequests.tblEyebrow'),
    title: t('songRequests.tblTitle'),
    columns: [t('landing.colCommand'), t('landing.colAliases'), t('landing.colWho'), t('landing.colReply')],
    widths: ['15%', '21%', '17%', '47%'],
    monoColumns: [1],
    rowLines: 3,
    copyLabel: t('landing.copyCommand'),
    rows: songRows(lang, t),
    note: t('songRequests.tblNote'),
};
const updated = { text: t('songRequests.updated'), iso: '2026-10-13' };
const schema = landingSchema({
    site: Astro.site!,
    url: Astro.url,
    lang,
    name: t('songRequests.metaTitle'),
    crumb: t('songRequests.eyebrow'),
    homeLabel: t('compare.crumbHome'),
    description: t('songRequests.metaDesc'),
    modified: updated.iso,
    commands: table.rows,
});
---

<Layout title={t('songRequests.metaTitle')} description={t('songRequests.metaDesc')} aiDoc="https://ai.itsbagelbot.com/spotify/setup.md" extraSchema={schema}>
    <FeatureLanding
        eyebrow={t('songRequests.eyebrow')}
        title={t('songRequests.title')}
        lead={t('songRequests.lead')}
        howEyebrow={t('songRequests.howEyebrow')}
        howTitle={t('songRequests.howTitle')}
        steps={[
            { title: t('songRequests.step1Title'), desc: t('songRequests.step1Desc') },
            { title: t('songRequests.step2Title'), desc: t('songRequests.step2Desc') },
            { title: t('songRequests.step3Title'), desc: t('songRequests.step3Desc') },
        ]}
        listEyebrow={t('songRequests.listEyebrow')}
        listTitle={t('songRequests.listTitle')}
        listItems={[
            { name: t('songRequests.item1Name'), desc: t('songRequests.item1Desc') },
            { name: t('songRequests.item2Name'), desc: t('songRequests.item2Desc') },
            { name: t('songRequests.item3Name'), desc: t('songRequests.item3Desc') },
            { name: t('songRequests.item4Name'), desc: t('songRequests.item4Desc') },
            { name: t('songRequests.item5Name'), desc: t('songRequests.item5Desc') },
            { name: t('songRequests.item6Name'), desc: t('songRequests.item6Desc') },
        ]}
        listNote={t('songRequests.limitsNote')}
        faqEyebrow={t('songRequests.faqEyebrow')}
        faqTitle={t('songRequests.faqTitle')}
        faqItems={[
            { question: t('songRequests.faqQ1'), answer: t('songRequests.faqA1') },
            { question: t('songRequests.faqQ2'), answer: t('songRequests.faqA2') },
            { question: t('songRequests.faqQ3'), answer: t('songRequests.faqA3') },
            { question: t('songRequests.faqQ4'), answer: t('songRequests.faqA4') },
            { question: t('songRequests.faqQ5'), answer: t('songRequests.faqA5') },
            { question: t('songRequests.faqQ6'), answer: t('songRequests.faqA6') },
            { question: t('songRequests.faqQ7'), answer: t('songRequests.faqA7') },
            { question: t('songRequests.faqQ8'), answer: t('songRequests.faqA8') },
        ]}
        ctaTitle={t('songRequests.ctaTitle')}
        ctaPrimary={{ href: dashLoginHref(lang), label: t('nav.cta') }}
        ctaSecondary={{ href: localizePath('/guides/spotify-song-requests', lang), label: t('songRequests.ctaGuide') }}
        updated={updated}
        table={table}
        demo={{
            eyebrow: t('landing.exampleEyebrow'),
            title: t('songRequests.demoTitle'),
            caption: t('landing.exampleCaption'),
            lines: songExampleLines(lang),
        }}
        prereq={{ title: t('landing.prereqTitle'), items: [t('songRequests.prereq1'), t('songRequests.prereq2'), t('songRequests.prereq3')] }}
        related={{
            title: t('landing.relatedTitle'),
            links: [link('/guides/setup-errors', t('landing.relSetupErrors')), link('/import', t('landing.relImport')), link('/pricing', t('landing.relPricing')), link('/guides/modules', t('landing.relModules'))],
        }}
    />
</Layout>
