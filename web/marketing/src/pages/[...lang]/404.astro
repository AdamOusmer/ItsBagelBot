import Layout from '../../layouts/Layout.astro';
import ErrorScene from '@bagel/ui/astro/ErrorScene.astro';
import { getLangFromUrl, useTranslations, localeStaticPaths, localizePath } from '../../i18n/ui';

export const getStaticPaths = localeStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath('/', lang);
---

<Layout title={t('error.404.metaTitle')} description={t('error.404.metaDesc')} noindex>
    <ErrorScene
        status={404}
        eyebrow={t('error.404.eyebrow')}
        title={t('error.404.title')}
        description={t('error.404.desc')}
        aside={t('error.aside')}
    >
        <Fragment slot="actions">
            <a class="bb-error-scene__action bb-error-scene__action--primary" href={home}
                >{t('error.home')}</a
            >
            <button
                class="bb-error-scene__action bb-error-scene__action--quiet"
                type="button"
                data-error-back={home}>{t('error.back')}</button
            >
        </Fragment>
    </ErrorScene>
</Layout>

<script>
    import { mountErrorBack } from '../../script/error-back';
    mountErrorBack();
</script>
