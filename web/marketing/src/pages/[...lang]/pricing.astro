import Layout from '../../layouts/Layout.astro';
import PageHero from '@bagel/ui/astro/PageHero.astro';
import Tiers from '../../components/pricing/Tiers.astro';
import Faq from '../../components/pricing/Faq.astro';
import { getLangFromUrl, useTranslations, localeStaticPaths } from '../../i18n/ui';

export const getStaticPaths = localeStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('pricing.metaTitle')} description={t('pricing.metaDesc')}>
    <PageHero
        eyebrow={t('pricing.eyebrow')}
        title={t('pricing.title')}
        description={t('pricing.desc')}
    />
    <Tiers />
    <Faq />
</Layout>
