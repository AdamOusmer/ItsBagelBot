import Layout from '../../layouts/Layout.astro';
import PageHero from '@bagel/ui/astro/PageHero.astro';
import Switchboard from '../../components/contact/Switchboard.astro';
import { getLangFromUrl, useTranslations, localeStaticPaths } from '../../i18n/ui';

export const getStaticPaths = localeStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('contact.metaTitle')} description={t('contact.metaDesc')}>
    <PageHero
        eyebrow={t('contact.eyebrow')}
        title={t('contact.title')}
        description={t('contact.desc')}
    />
    <Switchboard />
</Layout>
