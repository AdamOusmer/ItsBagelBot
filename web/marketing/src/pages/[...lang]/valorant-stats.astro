import Layout from '../../layouts/Layout.astro';
import FeatureLanding from '../../components/landing/FeatureLanding.astro';
import ChatWindow from '../../components/guides/ChatWindow.astro';
import ValorantModule from '../../components/guides/screens/ValorantModule.astro';
import { getLangFromUrl, useTranslations, dashLoginHref, localizePath, localeStaticPaths } from '../../i18n/ui';
import { valorantConsoleText } from '../../i18n/valorant-console';
import { valorantRows, valorantExampleLines, landingSchema, GAMES } from '../../lib/landing';

export const getStaticPaths = localeStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const chatLines = valorantExampleLines(lang);
const walkthroughChat = valorantExampleLines(lang, true);
const walkthroughChatLabel = walkthroughChat.map((line) => line.text).join(' / ');
const link = (path: string, label: string) => ({ href: localizePath(path, lang), label });
const table = {
    eyebrow: t('valorantStats.tblEyebrow'),
    title: t('valorantStats.tblTitle'),
    columns: [t('landing.colCommand'), t('landing.colAliases'), t('landing.colWho'), t('landing.colReply')],
    widths: ['19%', '21%', '13%', '47%'],
    monoColumns: [1],
    rowLines: 3,
    copyLabel: t('landing.copyCommand'),
    rows: valorantRows(lang, t),
    note: t('valorantStats.tblNote'),
};
const steps = [
    {
        title: t('valorantStats.step1Title'),
        desc: t('valorantStats.step1Desc'),
        visual: 'riot-sign-in',
    },
    {
        title: t('valorantStats.step2Title'),
        desc: t('valorantStats.step2Desc'),
        visual: 'riot-linked',
    },
    {
        title: t('valorantStats.step3Title'),
        desc: t('valorantStats.step3Desc'),
        visual: 'valorant-chat',
    },
];
const updated = { text: t('valorantStats.updated'), iso: '2026-11-19' };
const schema = landingSchema({
    site: Astro.site!,
    url: Astro.url,
    lang,
    name: t('valorantStats.metaTitle'),
    crumb: t('valorantStats.eyebrow'),
    homeLabel: t('compare.crumbHome'),
    description: t('valorantStats.metaDesc'),
    modified: updated.iso,
    commands: table.rows,
});
---

<Layout title={t('valorantStats.metaTitle')} description={t('valorantStats.metaDesc')} aiDoc="https://ai.itsbagelbot.com/features/valorant.md" extraSchema={schema}>
    <FeatureLanding
        eyebrow={t('valorantStats.eyebrow')}
        title={t('valorantStats.title')}
        lead={t('valorantStats.lead')}
        howEyebrow={t('valorantStats.howEyebrow')}
        howTitle={t('valorantStats.howTitle')}
        steps={steps}
        listEyebrow={t('valorantStats.listEyebrow')}
        listTitle={t('valorantStats.listTitle')}
        listItems={[
            { name: t('valorantStats.item1Name'), desc: t('valorantStats.item1Desc') },
            { name: t('valorantStats.item2Name'), desc: t('valorantStats.item2Desc') },
            { name: t('valorantStats.item3Name'), desc: t('valorantStats.item3Desc') },
            { name: t('valorantStats.item4Name'), desc: t('valorantStats.item4Desc') },
            { name: t('valorantStats.item5Name'), desc: t('valorantStats.item5Desc') },
            { name: t('valorantStats.item6Name'), desc: t('valorantStats.item6Desc') },
        ]}
        listNote={t('valorantStats.limitsNote')}
        faqEyebrow={t('valorantStats.faqEyebrow')}
        faqTitle={t('valorantStats.faqTitle')}
        faqItems={[
            { question: t('valorantStats.faqQ1'), answer: t('valorantStats.faqA1') },
            { question: t('valorantStats.faqQ2'), answer: t('valorantStats.faqA2') },
            { question: t('valorantStats.faqQ3'), answer: t('valorantStats.faqA3') },
            { question: t('valorantStats.faqQ4'), answer: t('valorantStats.faqA4') },
        ]}
        ctaTitle={t('valorantStats.ctaTitle')}
        ctaPrimary={{ href: dashLoginHref(lang), label: t('nav.cta') }}
        ctaSecondary={{ href: localizePath('/guides/modules', lang), label: t('valorantStats.ctaGuide') }}
        legal={t('valorantStats.legal')}
        updated={updated}
        table={table}
        demo={{
            eyebrow: t('landing.exampleEyebrow'),
            title: t('valorantStats.demoTitle'),
            caption: t('landing.exampleCaption'),
            lines: chatLines,
        }}
        prereq={{ title: t('landing.prereqTitle'), items: [t('valorantStats.prereq1'), t('valorantStats.prereq2')] }}
        related={{
            title: t('landing.relatedTitle'),
            links: [link('/guides/modules', t('landing.relModules')), link('/guides/data-sources', t('landing.relDataSources')), link('/guides/variables', t('landing.relVariables')), link('/command-builder', t('landing.relCommandBuilder')), ...Object.values(GAMES).map((game) => link(game.path, t(game.relKey)))],
        }}
    >
        <ValorantModule slot="riot-sign-in" lang={lang} description={t('valorantStats.consoleDescription')} />
        <ValorantModule slot="riot-linked" lang={lang} description={t('valorantStats.consoleDescription')} linked />
        <ChatWindow slot="valorant-chat" title="#frosty" label={walkthroughChatLabel} kind={valorantConsoleText(lang, 'modules.catChat')} lines={walkthroughChat} class="val-steps-chat" fitReplies />
    </FeatureLanding>
</Layout>

<style>
    .val-steps-chat {
        --chat-reply-height: 2lh;
    }
</style>
