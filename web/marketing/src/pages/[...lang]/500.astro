import Layout from '../../layouts/Layout.astro';
import ErrorScene from '@bagel/ui/astro/ErrorScene.astro';
import { getLangFromUrl, useTranslations, localeStaticPaths, localizePath } from '../../i18n/ui';

export const getStaticPaths = localeStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath('/', lang);
---

<Layout title={t('error.500.metaTitle')} description={t('error.500.metaDesc')} noindex>
    <ErrorScene
        status={500}
        eyebrow={t('error.500.eyebrow')}
        title={t('error.500.title')}
        description={t('error.500.desc')}
        aside={t('error.aside')}
        primary={{ label: t('error.500.action'), href: home }}
        secondary={{ label: t('error.back'), 'data-error-back': home }}
    />
</Layout>

<script>
    import { mountErrorBack } from '../../script/error-back';
    mountErrorBack();
</script>
