import Layout from '../../../layouts/Layout.astro';
import PageHero from '@bagel/ui/astro/PageHero.astro';
import Button from '@bagel/ui/astro/Button.astro';
import Card from '@bagel/ui/astro/Card.astro';
import GuideCard from '../../../components/guides/GuideCard.astro';
import TextLink from '@bagel/ui/astro/TextLink.astro';
import Text from '@bagel/ui/astro/Text.astro';
import Heading from '@bagel/ui/astro/Heading.astro';
import Code from '@bagel/ui/astro/Code.astro';
import Section from '@bagel/ui/astro/Section.astro';
import { getLangFromUrl, localeStaticPaths, localizePath, useTranslations } from '../../../i18n/ui';
import { getGuide, getHub, guideIndex, guidePath, guideSlugs } from '../../../lib/guides/registry';

export const getStaticPaths = localeStaticPaths;

const lang = getLangFromUrl(Astro.url);
const hub = getHub(lang);
const t = useTranslations(lang);
const guides = guideSlugs.map((slug) => ({
    index: guideIndex(slug),
    href: guidePath(slug, lang),
    ...getGuide(slug, lang).meta.card,
}));
const [first, ...rest] = guides;
---

<Layout title={hub.meta.title} description={hub.meta.description} ogType="article">
    <PageHero eyebrow={hub.meta.eyebrow} title={hub.meta.heading} description={hub.meta.lead} />

    <Section size="flush" class="ghub">
        <Card atmo hover as="a" href={hub.tool.href} label={hub.tool.eyebrow} class="ghub__tool" data-cursor="quiet" data-reveal style="--reveal-i: 1">
            <span class="ghub__tool-demo" slot="band" aria-hidden="true">
                <span class="ghub__tool-line"><span data-fit="block" set:html={hub.tool.demoIn}></span></span>
                <span class="ghub__tool-line ghub__tool-line--out"><span data-fit="block" set:html={hub.tool.demoOut}></span></span>
            </span>
            <span class="ghub__tool-body">
                <span class="ghub__tool-copy">
                    <Heading level={3} variant="card" as="span" class="ghub__tool-name"><span data-fit>{hub.tool.name}</span></Heading>
                    <Text as="span" tone="muted-light" class="ghub__tool-desc"><span data-fit="block">{hub.tool.description}</span></Text>
                </span>
                <Button as="span" class="ghub__tool-btn" data-cursor><span data-fit>{hub.tool.cta}</span></Button>
            </span>
        </Card>

        <Card atmo hover as="a" href={localizePath('/guides/variables', lang)} label={t('guide.variablesEyebrow')} class="ghub__variables" data-cursor="quiet" data-reveal style="--reveal-i: 2">
            <span class="ghub__variables-band" slot="band" aria-hidden="true">
                <Code tone="success">{'{user}'}</Code><Code tone="success">{'{counter:name}'}</Code><Code tone="success">{'{random}'}</Code><Code tone="success">{'{...}'}</Code>
            </span>
            <span class="ghub__variables-body">
                <span class="ghub__variables-copy">
                    <Heading level={4} as="span" class="ghub__variables-name"><span data-fit>{t('guide.variablesTitle')}</span></Heading>
                    <Text as="span" tone="muted-light" class="ghub__variables-desc"><span data-fit="block">{t('guide.variablesDescription')}</span></Text>
                </span>
                <Button as="span" variant="secondary" class="ghub__variables-btn" data-cursor><span data-fit>{t('guide.variablesCta')}</span></Button>
            </span>
        </Card>

        <div class="ghub__start">
            <GuideCard {...first} cta={hub.readCta} wide revealIndex={2} />
        </div>

        <div class="ghub__grid">
            {rest.map((guide, i) => (
                <GuideCard {...guide} cta={hub.readCta} revealIndex={Math.min(i + 3, 6)} />
            ))}
        </div>

        <div class="ghub__help" data-reveal style="--reveal-i: 6">
            <Text tone="muted" class="ghub__help-prompt"><span data-fit>{hub.help.prompt}</span></Text>
            <div class="ghub__help-links">
                {hub.help.links.map((link) => (
                    <TextLink href={link.href} label={link.label} external={link.external} fit />
                ))}
            </div>
        </div>
    </Section>
</Layout>

<style>
    .ghub {
        width: min(var(--bb-content-max), calc(100% - 48px));
        margin-inline: auto;
        padding-bottom: 110px;
    }

    .ghub__tool {
        --card-band-h: 128px;
        margin-bottom: 40px;
    }

    .ghub__tool-body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--bb-space-4) 40px;
    }

    .ghub__tool-copy { display: block; min-width: 0; }

    .ghub__tool-name {
        display: block;
        margin-bottom: var(--bb-space-2);
    }

    .ghub__tool-desc {
        display: block;
        max-width: 60ch;
        height: calc(3 * 1lh);
    }

    .ghub__tool-btn { --btn-w: 13rem; --btn-justify: safe center; }

    .ghub__tool-demo {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
        height: 100%;
        padding-right: 140px;
        font-family: var(--bb-font-mono);
        font-size: var(--bb-text-sm);
        line-height: 1.6;
    }

    .ghub__tool-line {
        display: flex;
        flex-direction: column;
        justify-content: safe center;
        height: calc(2 * 1lh);
        color: rgba(var(--bb-white-rgb), 0.85);
    }

    .ghub__tool-line :global(i) {
        font-style: normal;
        color: var(--bb-green-glow);
        background: rgba(var(--bb-green-glow-rgb), 0.09);
        border-radius: var(--bb-radius-xs);
        padding: 1px var(--bb-space-1);
    }

    .ghub__tool-line--out {
        position: relative;
        height: calc(2 * 1lh + 10px);
        padding-top: 10px;
        color: var(--bb-green-glow);
    }

    .ghub__tool-line--out::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 48px;
        height: 1px;
        background: var(--bb-tan);
        opacity: 0.5;
    }

    .ghub__tool:focus-visible {
        outline: 2px solid var(--bb-green-glow);
        outline-offset: 3px;
    }

    .ghub__variables { --card-band-h: 78px; margin-bottom: 40px; }
    .ghub__variables-band { display: flex; align-items: center; flex-wrap: wrap; gap: 9px; height: 100%; padding-right: 48px; font-size: var(--bb-text-sm); }
    .ghub__variables-body { display: flex; align-items: center; justify-content: space-between; gap: var(--bb-space-5); }
    .ghub__variables-copy { display: block; flex: 1 1 0; min-width: 0; }
    .ghub__variables-name { display: block; margin-bottom: 6px; }
    .ghub__variables-desc { display: block; max-width: 62ch; height: calc(2 * 1lh); }
    .ghub__variables-btn { --btn-w: 18rem; --btn-justify: safe center; flex: none; }

    .ghub__start {
        --card-band-h: 92px;
        margin-bottom: 20px;
    }

    .ghub__grid {
        --card-band-h: 108px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .ghub__help {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 14px;
        margin-top: 44px;
        padding-top: 28px;
        border-top: 1px solid var(--bb-border);
    }

    .ghub__help-prompt { flex: 1 1 100%; min-width: 0; }

    .ghub__help-links {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(0, 1fr);
        gap: 20px;
        width: min(100%, 460px);
        margin-left: auto;
    }

    @media (max-width: 860px) {
        .ghub__grid { grid-template-columns: 1fr; }
        .ghub__tool-body { grid-template-columns: 1fr; }
        .ghub__tool-demo { padding-right: 0; }
        .ghub__variables-body { align-items: stretch; flex-direction: column; }
        .ghub__variables-copy { flex: none; }
        .ghub__tool-desc { height: calc(5 * 1lh); }
        .ghub__variables-desc { height: calc(4 * 1lh); }
    }

    @media (max-width: 760px) {
        .ghub { width: calc(100% - 32px); }
    }

    @media (prefers-reduced-motion: reduce) {
        .ghub__tool-btn { transition: none; }
    }
</style>
