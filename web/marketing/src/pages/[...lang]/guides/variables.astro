import Layout from '../../../layouts/Layout.astro';
import VariablesReference from '../../../components/guides/variables/VariablesReference.astro';
import { getLangFromUrl, localeStaticPaths, useTranslations } from '../../../i18n/ui';
import { variableReferenceData } from '../../../lib/variables';

export const getStaticPaths = localeStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const catalog = variableReferenceData(lang).filter((entry) => entry.surfaceIds.includes('custom'));

const meta = { title: t('guides.variables.metaTitle'), description: t('guides.variables.metaDesc') };

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const termSchema: Record<string, unknown>[] = [
    {
        '@type': 'DefinedTermSet',
        '@id': `${pageUrl}#terms`,
        name: meta.title,
        description: meta.description,
        inLanguage: lang,
        url: pageUrl,
        hasDefinedTerm: catalog.map((entry) => ({
            '@type': 'DefinedTerm',
            '@id': `${pageUrl}#${entry.id}`,
            name: entry.name,
            description: entry.description || entry.hint,
            termCode: entry.syntax,
            url: `${pageUrl}#${entry.id}`,
            inDefinedTermSet: `${pageUrl}#terms`,
        })),
    },
];
---

<Layout title={meta.title} description={meta.description} ogType="article" extraSchema={termSchema}>
    <VariablesReference catalog={catalog} lang={lang} />
</Layout>
