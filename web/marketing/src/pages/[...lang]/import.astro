import { dashboardHref } from '@bagel/kit/site-links';

import Layout from '../../layouts/Layout.astro';
import FeatureLanding from '../../components/landing/FeatureLanding.astro';
import { getLangFromUrl, useTranslations, defaultLang, localeStaticPaths } from '../../i18n/ui';

export const getStaticPaths = localeStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const importHref = dashboardHref('/settings/import', lang === defaultLang ? '' : `?lang=${lang}`);
---

<Layout title={t('importer.metaTitle')} description={t('importer.metaDesc')}>
    <FeatureLanding
        eyebrow={t('importer.eyebrow')}
        title={t('importer.title')}
        lead={t('importer.lead')}
        howEyebrow={t('importer.howEyebrow')}
        howTitle={t('importer.howTitle')}
        steps={[
            { title: t('importer.step1Title'), desc: t('importer.step1Desc') },
            { title: t('importer.step2Title'), desc: t('importer.step2Desc') },
            { title: t('importer.step3Title'), desc: t('importer.step3Desc') },
        ]}
        listEyebrow={t('importer.srcEyebrow')}
        listTitle={t('importer.srcTitle')}
        listItems={[
            { name: t('importer.src1Name'), desc: t('importer.src1Desc') },
            { name: t('importer.src2Name'), desc: t('importer.src2Desc') },
            { name: t('importer.src3Name'), desc: t('importer.src3Desc') },
            { name: t('importer.src4Name'), desc: t('importer.src4Desc') },
        ]}
        listNote={t('importer.limitsNote')}
        faqEyebrow={t('importer.faqEyebrow')}
        faqTitle={t('importer.faqTitle')}
        faqItems={[
            { question: t('importer.faqQ1'), answer: t('importer.faqA1') },
            { question: t('importer.faqQ2'), answer: t('importer.faqA2') },
            { question: t('importer.faqQ3'), answer: t('importer.faqA3') },
            { question: t('importer.faqQ4'), answer: t('importer.faqA4') },
        ]}
        ctaTitle={t('importer.ctaTitle')}
        ctaPrimary={{ href: importHref, label: t('importer.ctaStart') }}
        ctaSecondary={{ href: '/vs/nightbot/', label: t('importer.ctaCompare') }}
    />
</Layout>
