import Layout from '../../layouts/Layout.astro';
import FeatureLanding from '../../components/landing/FeatureLanding.astro';
import { getLangFromUrl, useTranslations, dashLoginHref, localizePath, localeStaticPaths } from '../../i18n/ui';
import { goveeRows, goveeExampleLines, landingSchema } from '../../lib/landing';

export const getStaticPaths = localeStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const link = (path: string, label: string) => ({ href: localizePath(path, lang), label });
const table = {
    eyebrow: t('govee.tblEyebrow'),
    title: t('govee.tblTitle'),
    columns: [t('govee.colTyped'), t('govee.colKind'), t('landing.colReply')],
    widths: ['22%', '24%', '54%'],
    rowLines: 2,
    copyLabel: t('landing.copyCommand'),
    rows: goveeRows(lang, t),
    note: t('govee.tblNote'),
};
const updated = { text: t('govee.updated'), iso: '2026-10-13' };
const schema = landingSchema({
    site: Astro.site!,
    url: Astro.url,
    lang,
    name: t('govee.metaTitle'),
    crumb: t('govee.eyebrow'),
    homeLabel: t('compare.crumbHome'),
    description: t('govee.metaDesc'),
    modified: updated.iso,
    commands: table.rows,
});
---

<Layout title={t('govee.metaTitle')} description={t('govee.metaDesc')} aiDoc="https://ai.itsbagelbot.com/govee/setup.md" extraSchema={schema}>
    <FeatureLanding
        eyebrow={t('govee.eyebrow')}
        title={t('govee.title')}
        lead={t('govee.lead')}
        howEyebrow={t('govee.howEyebrow')}
        howTitle={t('govee.howTitle')}
        steps={[
            { title: t('govee.step1Title'), desc: t('govee.step1Desc') },
            { title: t('govee.step2Title'), desc: t('govee.step2Desc') },
            { title: t('govee.step3Title'), desc: t('govee.step3Desc') },
        ]}
        listEyebrow={t('govee.listEyebrow')}
        listTitle={t('govee.listTitle')}
        listItems={[
            { name: t('govee.item1Name'), desc: t('govee.item1Desc') },
            { name: t('govee.item2Name'), desc: t('govee.item2Desc') },
            { name: t('govee.item3Name'), desc: t('govee.item3Desc') },
            { name: t('govee.item4Name'), desc: t('govee.item4Desc') },
            { name: t('govee.item5Name'), desc: t('govee.item5Desc') },
        ]}
        listNote={t('govee.listNote')}
        faqEyebrow={t('govee.faqEyebrow')}
        faqTitle={t('govee.faqTitle')}
        faqItems={[
            { question: t('govee.faqQ1'), answer: t('govee.faqA1') },
            { question: t('govee.faqQ2'), answer: t('govee.faqA2') },
            { question: t('govee.faqQ3'), answer: t('govee.faqA3') },
            { question: t('govee.faqQ4'), answer: t('govee.faqA4') },
            { question: t('govee.faqQ5'), answer: t('govee.faqA5') },
        ]}
        ctaTitle={t('govee.ctaTitle')}
        ctaPrimary={{ href: dashLoginHref(lang), label: t('nav.cta') }}
        ctaSecondary={{ href: localizePath('/guides/govee-lights', lang), label: t('govee.ctaGuide') }}
        updated={updated}
        table={table}
        demo={{
            eyebrow: t('landing.exampleEyebrow'),
            title: t('govee.demoTitle'),
            caption: t('landing.exampleCaption'),
            lines: goveeExampleLines(lang, t),
        }}
        prereq={{ title: t('landing.prereqTitle'), items: [t('govee.prereq1'), t('govee.prereq2'), t('govee.prereq3')] }}
        related={{
            title: t('landing.relatedTitle'),
            links: [link('/guides/setup-errors', t('landing.relSetupErrors')), link('/song-requests', t('landing.relSongRequests')), link('/guides/modules', t('landing.relModules')), link('/pricing', t('landing.relPricing')), link('/vs', t('landing.relCompare'))],
        }}
    />
</Layout>
