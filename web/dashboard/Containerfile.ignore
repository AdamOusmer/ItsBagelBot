# Whitelist for the console-dashboard build context (the repository root). The last matching pattern wins.
*
!ui
!web/package.json
!web/bun.lock
!web/bunfig.toml
!web/tsconfig.base.json
!web/sorted-readdir.mjs
!web/serve-node.js
!web/kit
!web/dashboard

# Other members contribute only their manifest: --frozen-lockfile fails if a bun.lock member has no package.json.
!web/admin/package.json
!web/marketing/package.json
!web/docs/package.json

**/node_modules
**/dist
**/build
**/.svelte-kit
**/.astro
**/test-results
**/*.log
