# Dashboard SSR — separate deploy from admin. Build with bun, run on distroless
# Node (adapter-node output). Native per-node build (ARM on node1, Intel on
# node2); no cross-arch emulation.
#
# BUILD CONTEXT IS THE REPOSITORY ROOT, not web/. It has to be: the design
# library @bagel/ui is a standalone package at the root (its own lockfile, its
# own CI, extractable to its own repo), the console bundles it, and nothing
# above the context line can be COPYed. A root context would otherwise mean
# sending the whole Go tree to the daemon, so each console image carries its own
# whitelist ignorefile beside this file — web/dashboard/Containerfile.ignore,
# passed as `buildah bud --ignorefile` (podman/buildah both accept it; the flag
# is what lets two images share one context with different contents).
#
# Build it by hand the same way CI does, or the context is wrong:
#   podman build -f web/dashboard/Containerfile \
#     --ignorefile web/dashboard/Containerfile.ignore -t cd-test .
FROM docker.io/oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895 AS build
WORKDIR /src
# Pin SvelteKit's version metadata to the commit SHA. sorted-readdir.mjs also
# makes route-node assignment deterministic across the native ARM/Intel builds.
ARG BUILD_VERSION=dev
ENV BUILD_VERSION=$BUILD_VERSION
# The design library first, with its OWN lockfile. --production leaves just its
# runtime dependency (lenis): its devDependencies are svelte, astro and the
# compilers its parity test drives, none of which this image has any use for.
# web/'s install re-runs this same command through a postinstall hook, so this
# RUN is really a cache boundary — ui changes rarely, and putting it above the
# web layer keeps the workspace install cached when only an app changes.
COPY ui ui
RUN cd ui && bun install --frozen-lockfile --production
WORKDIR /src/web
# Workspace manifests first for cached installs. bunfig.toml MUST be present for
# the install so the hoisted linker applies (flat node_modules the image can ship).
COPY web/package.json web/bun.lock web/bunfig.toml ./
COPY web/tsconfig.base.json tsconfig.base.json
COPY web/sorted-readdir.mjs sorted-readdir.mjs
COPY web/kit/package.json kit/package.json
COPY web/dashboard/package.json dashboard/package.json
COPY web/admin/package.json admin/package.json
COPY web/marketing/package.json marketing/package.json
COPY web/docs/package.json docs/package.json
# The install skips marketing and docs. They are workspace members (one lockfile
# for the whole web/ tree), but astro, sharp and mermaid are build-time deps of
# two static sites that this image never runs, and the hoisted linker puts every
# workspace dep in ONE flat node_modules that the runtime stage copies wholesale
# -- so without the filter the SSR image carries the entire static-site
# toolchain. Their package.json files are still COPYed above: --frozen-lockfile
# re-resolves the whole workspace graph and fails with "lockfile had changes,
# but lockfile is frozen" if a member named in bun.lock has no manifest on disk.
# Gate: the image must not contain node_modules/astro.
#
# This install's postinstall hook is also what puts @bagel/ui on the resolver's
# path (node_modules/@bagel/ui -> ../../../ui), which is why ui is COPYed above
# it rather than beside the app sources.
RUN bun install --frozen-lockfile --filter '!marketing' --filter '!docs'
COPY web/kit kit
COPY web/dashboard dashboard
RUN cd dashboard && bun run build && bun install --production --frozen-lockfile --filter '!marketing' --filter '!docs'

FROM gcr.io/distroless/nodejs22-debian12@sha256:8a3e96fe3345b5d83ecec2066e7c498139a02a6d1214e4f6c39f9ce359f3f5bc AS run
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
# adapter-node bundle + external production deps. @bagel/ui needs no entry of
# its own: it ships source, vite.config.ts lists it under ssr.noExternal, so the
# adapter bundles it into build/ the same way it bundles @bagel/kit.
COPY --from=build /src/web/dashboard/build ./build
COPY --from=build /src/web/node_modules ./node_modules
COPY web/serve-node.js ./serve-node.js
EXPOSE 3000
# Preload the New Relic APM agent (ESM --import) before the SvelteKit server.
CMD ["--import", "newrelic", "serve-node.js"]
