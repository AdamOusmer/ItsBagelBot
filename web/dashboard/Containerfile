# Build context is the repository root; build with this image's ignorefile, as CI does:
#   podman build -f web/dashboard/Containerfile \
#     --ignorefile web/dashboard/Containerfile.ignore -t cd-test .
FROM docker.io/oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS build
WORKDIR /src
ARG BUILD_VERSION=dev
ENV BUILD_VERSION=$BUILD_VERSION
COPY ui ui
RUN cd ui && bun install --frozen-lockfile --production
WORKDIR /src/web
# bunfig.toml must be present for the install so the hoisted linker applies.
COPY web/package.json web/bun.lock web/bunfig.toml ./
COPY web/patches patches
COPY web/tsconfig.base.json tsconfig.base.json
COPY web/sorted-readdir.mjs sorted-readdir.mjs
COPY web/kit/package.json kit/package.json
COPY web/dashboard/package.json dashboard/package.json
COPY web/admin/package.json admin/package.json
COPY web/marketing/package.json marketing/package.json
COPY web/docs/package.json docs/package.json
# Skip the static sites' toolchain. Their manifests are still copied: --frozen-lockfile fails without every member's package.json.
RUN bun install --frozen-lockfile --filter '!marketing' --filter '!docs'
COPY web/kit kit
COPY locales /src/locales
COPY web/dashboard dashboard
RUN cd dashboard && bun run build && find build -name '*.map' -delete
# Runtime externals: newrelic and pino (vite ssr.external), sirv (serve-node.js), sql.js (createRequire). A missing one fails only the route that loads it.
RUN bun kit/scripts/runtime-node-modules.ts node_modules /runtime/node_modules newrelic pino sirv sql.js
# Distroless bun aborts on dlopen of newrelic's Node/V8 addons (502 on first request), so strip them here; the runtime stage has no shell.
RUN bun kit/scripts/strip-newrelic-node-addons.ts /runtime/node_modules

FROM docker.io/oven/bun:1.4.4-distroless@sha256:153a951ae40106e125898103e6e990ee0f38e6aee7f561029e26cf9fbed23470 AS run
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=build /src/web/dashboard/build ./build
COPY --from=build /runtime/node_modules ./node_modules
COPY web/serve-node.js ./serve-node.js
EXPOSE 3000
CMD ["--import", "newrelic", "serve-node.js"]
