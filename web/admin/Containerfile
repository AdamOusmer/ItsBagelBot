# Build context is the repository root; build with this image's ignorefile, as CI does:
#   podman build -f web/admin/Containerfile \
#     --ignorefile web/admin/Containerfile.ignore -t ca-test .
FROM docker.io/oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895 AS build
WORKDIR /src
ARG BUILD_VERSION=dev
ENV BUILD_VERSION=$BUILD_VERSION
COPY ui ui
RUN cd ui && bun install --frozen-lockfile --production
WORKDIR /src/web
# bunfig.toml must be present for the install so the hoisted linker applies.
COPY web/package.json web/bun.lock web/bunfig.toml ./
COPY web/tsconfig.base.json tsconfig.base.json
COPY web/sorted-readdir.mjs sorted-readdir.mjs
COPY web/kit/package.json kit/package.json
COPY web/dashboard/package.json dashboard/package.json
COPY web/admin/package.json admin/package.json
COPY web/marketing/package.json marketing/package.json
COPY web/docs/package.json docs/package.json
# Skip the static sites' toolchain. Their manifests are still copied: --frozen-lockfile fails without every member's package.json.
RUN bun install --frozen-lockfile --filter '!marketing' --filter '!docs'
COPY web/kit kit
COPY web/admin admin
RUN cd admin && bun run build && bun install --production --omit=optional --frozen-lockfile --filter '!marketing' --filter '!docs'
# Distroless bun aborts on dlopen of newrelic's Node/V8 addons, so strip them here; the runtime stage has no shell.
RUN bun kit/scripts/strip-newrelic-node-addons.ts node_modules

FROM docker.io/oven/bun:1.4.2-distroless@sha256:1a0c31c7c5f9d193aedf60fe1cebdeb76ac8f6e29f24be8dd8cbd6df72df26ec AS run
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=build /src/web/admin/build ./build
COPY --from=build /src/web/node_modules ./node_modules
COPY web/serve-node.js ./serve-node.js
EXPOSE 3000
CMD ["--import", "newrelic", "serve-node.js"]
