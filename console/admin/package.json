{
  "name": "admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun run verify:demo-gated && bun ../shared/scripts/check-i18n.mjs && vite build && bun run verify:production-clean",
    "verify:demo-gated": "bun ../shared/scripts/assert-demo-gated.mjs admin",
    "verify:production-clean": "bun scripts/assert-production-clean.ts",
    "preview": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@bagel/shared": "workspace:*",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "nanoid": "^6.0.1",
    "newrelic": "^12.11.0",
    "pino": "^9"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.5",
    "terser": "^5.48.0"
  }
}
