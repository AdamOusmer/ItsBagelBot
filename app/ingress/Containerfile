# Twitch Ingress (Elixir) - build with podman or docker:
#   podman build -t itsbagelbot/twitch-ingress -f Containerfile .
# OTP 27 provides the native `:json` module used on the ingress firehose.
FROM docker.io/library/elixir:1.20-otp-27@sha256:48c22926b2828e64fc2f9d9633b3c0be5d90ba224bdd456eef82a8a08730e46d AS build

ENV MIX_ENV=prod
WORKDIR /src

RUN mix local.hex --force && mix local.rebar --force

COPY mix.exs mix.lock* ./
RUN mix deps.get --only prod

COPY config config
RUN mix deps.compile

COPY lib lib
RUN mix compile && mix release

# ---------------------------------------------------------------------------
# Must match the builder's base distro: the release links against its glibc.
FROM docker.io/library/debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd

RUN apt-get update \
 && apt-get install -y --no-install-recommends libssl3 libncurses6 ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --home /app --shell /usr/sbin/nologin ingress

COPY --from=build --chown=ingress:ingress /src/_build/prod/rel/ingress /app

USER ingress
WORKDIR /app

# BEAM core capping happens at runtime: the deployment sets ERL_FLAGS
# (e.g. "+S 2:2 +sbwt short") to match its k8s CPU limit, because the VM
# sizes its schedulers from the host's logical CPUs, not the cgroup quota.
ENV LANG=C.UTF-8
ENTRYPOINT ["/app/bin/ingress"]
CMD ["start"]
