FROM docker.io/library/elixir:1.20-otp-28@sha256:d974bbda306220023bb684d895f846b0774f5ef0536274c5a6794a02b9312bc9 AS build

ENV MIX_ENV=prod
# Torque picks its NIF by the build host's CPU; pin the AVX2 build the EPYC nodes run.
ENV TORQUE_CPU_VARIANT=v3
WORKDIR /src/app/twitch/ingress

RUN mix local.hex --force && mix local.rebar --force

COPY app/twitch/ingress/mix.exs app/twitch/ingress/mix.lock ./
COPY pkg/elixir/cowboy /src/pkg/elixir/cowboy
COPY pkg/elixir/nats /src/pkg/elixir/nats
COPY pkg/elixir/startup /src/pkg/elixir/startup
COPY pkg/elixir/new_relic /src/pkg/elixir/new_relic
COPY pkg/elixir/valkey /src/pkg/elixir/valkey
COPY pkg/elixir/sift /src/pkg/elixir/sift
COPY pkg/elixir/websocket /src/pkg/elixir/websocket
RUN mix deps.get --only prod

COPY app/twitch/ingress/config config
# GitHub release downloads (Torque's NIF) return 504s for minutes at a time.
RUN mix deps.compile || (sleep 30 && mix deps.compile) || (sleep 120 && mix deps.compile)

COPY app/twitch/ingress/lib lib
RUN mix compile && mix release

# Must match the builder's base distro: the release links against its glibc.
FROM docker.io/library/debian:trixie-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4

RUN apt-get update \
 && apt-get install -y --no-install-recommends libssl3 libncurses6 ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --home /app --shell /usr/sbin/nologin ingress

COPY --from=build --chown=ingress:ingress /src/app/twitch/ingress/_build/prod/rel/ingress /app

USER ingress
WORKDIR /app

ENV LANG=C.UTF-8
ENTRYPOINT ["/app/bin/ingress"]
CMD ["start"]
