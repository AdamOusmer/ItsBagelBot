# commands (Go, root module) - build from the REPO ROOT:
#   podman build -t itsbagelbot/commands -f app/commands/Containerfile .
FROM docker.io/library/golang:1.26.5-bookworm@sha256:6c5605ab3a9a9fb3c4eafe5b3d63cdbf3881caf113262b67862547b54a9db599 AS build

WORKDIR /src
# github.com/AdamOusmer/recipes is private: skip the public proxy/sumdb for it
# and resolve over SSH instead. --mount=type=ssh forwards the runner's
# ssh-agent socket (buildah bud --ssh) into just this RUN; ssh-keyscan pins
# github.com's host key so the fetch doesn't block on interactive host
# verification.
ENV GOPRIVATE=github.com/AdamOusmer/recipes
RUN mkdir -p /etc/ssh && ssh-keyscan -H github.com >> /etc/ssh/ssh_known_hosts \
 && git config --global url."git@github.com:".insteadOf "https://github.com/"
COPY go.mod go.sum ./
RUN --mount=type=ssh go mod download

COPY internal/domain internal/domain
COPY internal/moderation internal/moderation
COPY internal/utils internal/utils
COPY pkg pkg
COPY app/commands app/commands
RUN go run -mod=mod entgo.io/ent/cmd/ent generate --feature sql/upsert ./app/commands/ent/schema \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /commands ./app/commands

# ---------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot@sha256:f5b485ea962d9bd1186b2f6b3a061191539b905b82ec395de78cbfae51f20e35

COPY --from=build /commands /commands

USER nonroot
ENTRYPOINT ["/commands"]
