# modules (Go, root module) - build from the REPO ROOT:
#   podman build -t itsbagelbot/modules -f app/modules/Containerfile .
FROM docker.io/library/golang:1.26.5-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY internal/domain internal/domain
COPY internal/moderation internal/moderation
COPY internal/utils internal/utils
COPY pkg pkg
COPY app/modules app/modules
RUN go run -mod=mod entgo.io/ent/cmd/ent generate --feature sql/upsert ./app/modules/ent/schema \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /modules ./app/modules

# ---------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot@sha256:f5b485ea962d9bd1186b2f6b3a061191539b905b82ec395de78cbfae51f20e35

COPY --from=build /modules /modules

USER nonroot
ENTRYPOINT ["/modules"]
