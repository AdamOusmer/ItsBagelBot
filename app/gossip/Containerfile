# gossip (Go, root module) - build from the REPO ROOT:
#   podman build -t itsbagelbot/gossip -f app/gossip/Containerfile .
FROM docker.io/library/golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY internal/domain internal/domain
COPY internal/projection internal/projection
COPY internal/utils internal/utils
COPY pkg pkg
COPY app/gossip app/gossip
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /gossip ./app/gossip

# ---------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot@sha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a

COPY --from=build /gossip /gossip

USER nonroot
ENTRYPOINT ["/gossip"]
