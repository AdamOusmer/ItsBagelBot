FROM docker.io/library/golang:1.27.1-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN for i in 1 2 3 4 5; do go mod download && exit 0; echo "go mod download failed (attempt $i/5), retrying..." >&2; sleep $((i * 3)); done; exit 1

COPY internal/domain internal/domain
COPY pkg pkg
COPY app/deployer app/deployer
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /deployer ./app/deployer

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

COPY --from=build /deployer /deployer

USER nonroot
ENTRYPOINT ["/deployer"]
