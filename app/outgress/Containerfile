# outgress (Go, root module) - build from the REPO ROOT:
#   podman build -t itsbagelbot/outgress -f app/outgress/Containerfile .
FROM docker.io/library/golang:1.26.5-bookworm@sha256:6c5605ab3a9a9fb3c4eafe5b3d63cdbf3881caf113262b67862547b54a9db599 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY internal/domain internal/domain
COPY internal/utils internal/utils
COPY pkg pkg
COPY app/outgress app/outgress
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /outgress ./app/outgress

# ---------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot@sha256:f5b485ea962d9bd1186b2f6b3a061191539b905b82ec395de78cbfae51f20e35

COPY --from=build /outgress /outgress

USER nonroot
ENTRYPOINT ["/outgress"]
