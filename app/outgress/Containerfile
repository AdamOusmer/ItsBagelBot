# outgress (Go, root module) - build from the REPO ROOT:
#   podman build -t itsbagelbot/outgress -f app/outgress/Containerfile .
FROM docker.io/library/golang:1.27.0-bookworm@sha256:484ef6066fa69acb059fdfeda7ba2b8f7391f2ef6abc6f9b8411e669ebd56466 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY internal/domain internal/domain
COPY internal/utils internal/utils
COPY pkg pkg
COPY app/outgress app/outgress
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /outgress ./app/outgress

# ---------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

COPY --from=build /outgress /outgress

USER nonroot
ENTRYPOINT ["/outgress"]
