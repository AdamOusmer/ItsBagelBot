FROM docker.io/library/elixir:1.20-otp-28@sha256:9deb9fe8bf7c8cfa02bd3b7b6b1932fbb9c313151eb1e76eba112fdde7628337 AS build

ENV MIX_ENV=prod
WORKDIR /src/app/controls/gateway

RUN mix local.hex --force && mix local.rebar --force

COPY app/controls/gateway/mix.exs app/controls/gateway/mix.lock ./
COPY pkg/elixir/cowboy /src/pkg/elixir/cowboy
COPY pkg/elixir/nats /src/pkg/elixir/nats
COPY pkg/elixir/new_relic /src/pkg/elixir/new_relic
COPY pkg/elixir/startup /src/pkg/elixir/startup
COPY pkg/elixir/cache /src/pkg/elixir/cache
RUN mix deps.get --only prod

COPY app/controls/gateway/config config
RUN mix deps.compile

COPY app/controls/gateway/priv priv
COPY app/controls/gateway/lib lib
RUN mix compile && mix release

# Must match the builder's base distro: the release links against its glibc.
FROM docker.io/library/debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends libssl3 libncurses6 ca-certificates zlib1g \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --home /app --shell /usr/sbin/nologin controls-gateway

COPY --from=build --chown=controls-gateway:controls-gateway /src/app/controls/gateway/_build/prod/rel/controls_gateway /app

USER controls-gateway
WORKDIR /app

ENV LANG=C.UTF-8
# No BEAM cluster for this service: route across pods through core NATS instead.
ENV RELEASE_DISTRIBUTION=none
ENTRYPOINT ["/app/bin/controls_gateway"]
CMD ["start"]
