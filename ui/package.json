{
  "name": "@bagel/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles/*": "./styles/*",
    "./fonts/*": "./fonts/*",
    "./lib/*": "./lib/*.ts",
    "./svelte/toast": "./svelte/toast.svelte.ts",
    "./svelte/inspector": "./svelte/inspector.svelte.ts",
    "./svelte/discard-guard": "./svelte/discard-guard.svelte.ts",
    "./svelte/actions": "./svelte/actions.ts",
    "./svelte/*": "./svelte/*",
    "./astro/*": "./astro/*"
  },
  "scripts": {
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json && bun scripts/assert-framework-free.mjs",
    "test": "bun test && bun scripts/size.ts"
  },
  "dependencies": {
    "lenis": "^1.3.23"
  },
  "peerDependencies": {
    "astro": "^7.0.6",
    "svelte": "^5.56.4"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@iconify-json/lucide": "1.2.129",
    "@iconify-json/simple-icons": "1.2.94",
    "@types/bun": "^1.4.0",
    "astro": "^7.0.6",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3"
  }
}
