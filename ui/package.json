{
  "name": "@bagel/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles/*.css": "./styles/*.css",
    "./fonts/*.woff2": "./fonts/*.woff2",
    "./lib/clipboard": "./lib/clipboard.ts",
    "./lib/count-up": "./lib/count-up.ts",
    "./lib/csv": "./lib/csv.ts",
    "./lib/decode": "./lib/decode.ts",
    "./lib/hotkeys": "./lib/hotkeys.ts",
    "./lib/icons": "./lib/icons.ts",
    "./lib/inspector-machine": "./lib/inspector-machine.ts",
    "./lib/lenis": "./lib/lenis.ts",
    "./lib/light-field": "./lib/light-field.ts",
    "./lib/line-series": "./lib/line-series.ts",
    "./lib/live-poll": "./lib/live-poll.ts",
    "./lib/motion-gate": "./lib/motion-gate.ts",
    "./lib/motion-query": "./lib/motion-query.ts",
    "./lib/nav-types": "./lib/nav-types.ts",
    "./lib/overlay-stack": "./lib/overlay-stack.ts",
    "./lib/raf-loop": "./lib/raf-loop.ts",
    "./lib/reveal": "./lib/reveal.ts",
    "./lib/scroll-spy": "./lib/scroll-spy.ts",
    "./lib/select": "./lib/select.ts",
    "./lib/text-fit": "./lib/text-fit.ts",
    "./lib/tilt": "./lib/tilt.ts",
    "./lib/tween": "./lib/tween.ts",
    "./svelte": "./svelte/index.ts",
    "./astro": "./astro/index.ts",
    "./svelte/*.svelte": "./svelte/*.svelte",
    "./astro/*.astro": "./astro/*.astro",
    "./svelte/actions": "./svelte/actions.ts",
    "./svelte/discard-guard": "./svelte/discard-guard.svelte.ts",
    "./svelte/forms": "./svelte/forms.ts",
    "./svelte/i18n": "./svelte/i18n.ts",
    "./svelte/inspector": "./svelte/inspector.svelte.ts",
    "./svelte/toast": "./svelte/toast.svelte.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json && bun scripts/assert-framework-free.mjs && bun scripts/assert-tokens.mjs && bun scripts/assert-own-css.mjs && bun scripts/assert-layer-order.mjs && bun scripts/assert-compositor-motion.mjs && bun scripts/assert-control-names.mjs && bun scripts/gen-locales.mjs --check && bun scripts/gen-catalog.mjs --check",
    "test": "bun test && bun scripts/size.ts"
  },
  "dependencies": {
    "lenis": "^1.3.23"
  },
  "peerDependencies": {
    "astro": "^7.0.6",
    "svelte": "^5.56.4"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@iconify-json/circle-flags": "1.2.12",
    "@iconify-json/lucide": "1.2.139",
    "@iconify-json/simple-icons": "1.2.98",
    "@types/bun": "1.4.2",
    "astro": "^7.0.6",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3"
  }
}
