import type { HTMLAttributes } from 'astro/types';
import '../styles/elements/typography.css';

interface Props extends Omit<HTMLAttributes<'div'>, 'level' | 'variant' | 'uppercase' | 'as' | 'class'> {
    level?: 1 | 2 | 3 | 4 | 5 | 6;
    variant?: 'display' | 'section' | 'card' | 'title' | 'eyebrow' | 'label';
    uppercase?: boolean;
    as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p' | 'div' | 'span';
    class?: string;
}

const { level = 2, variant, uppercase = false, as: tag, class: className = '', ...rest } = Astro.props;
const Tag = tag ?? `h${level}`;
const classes = [
    'bb-h',
    `bb-h--l${level}`,
    variant ? `bb-h--${variant}` : null,
    uppercase ? 'bb-h--upper' : null,
    className,
]
    .filter(Boolean)
    .join(' ');
---

<Tag class={classes} {...rest}><slot /></Tag>
