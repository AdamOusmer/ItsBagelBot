import '../styles/elements/typography.css';

interface Props {
    level?: 1 | 2 | 3 | 4 | 5 | 6;
    variant?: 'display' | 'section' | 'card' | 'eyebrow';
    as?: string;
    class?: string;
}

const { level = 2, variant, as: tag, class: className = '', ...rest } = Astro.props;
const Tag = tag ?? `h${level}`;
const classes = ['bb-h', `bb-h--l${level}`, variant ? `bb-h--${variant}` : null, className]
    .filter(Boolean)
    .join(' ');
---

<Tag class={classes} {...rest}><slot /></Tag>
