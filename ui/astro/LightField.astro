// Astro adapter for the drifting mote field. Emits the same host as
// ui/svelte/LightField.svelte; the physics are in @bagel/ui/lib/light-field.
//
// One hoisted script serves every instance on the page (Astro dedupes it), so
// the hosts are found by scanning for the contract attribute rather than by
// each instance carrying its own inline setup.
import '../styles/elements/light-field.css';

interface Props {
    /** Extra classes, e.g. the `bb-light-field--bleed` full-bleed modifier. */
    class?: string;
    /** Share of gold (vs green) motes, 0..1. */
    warmth?: number;
}

const { class: className = '', warmth = 0.7 } = Astro.props;
const classes = ['bb-light-field', className].filter(Boolean).join(' ');
---

<div class={classes} data-field data-warmth={warmth} aria-hidden="true"></div>

<script>
    // Not bindOnce: a field owns running animations and two observers,
    // so it needs a real teardown before the ClientRouter throws the old
    // document away, and bindOnce deliberately has no unbind.
    import { field } from '../lib/light-field';

    const running = new Set<() => void>();

    function setupField(host: HTMLElement): void {
        if (host.dataset.fieldReady === 'true') return;

        const stop = field(host, { warmth: parseFloat(host.dataset.warmth ?? '') || 0.7 });
        if (!stop) return;
        host.dataset.fieldReady = 'true';

        const cleanup = () => {
            stop();
            host.removeAttribute('data-field-ready');
            running.delete(cleanup);
        };
        running.add(cleanup);
    }

    function setup(): void {
        document.querySelectorAll<HTMLElement>('[data-field]').forEach(setupField);
    }

    function teardown(): void {
        running.forEach((cleanup) => cleanup());
    }

    setup();
    document.addEventListener('astro:page-load', setup);
    document.addEventListener('astro:before-swap', teardown);
    window.addEventListener('pagehide', teardown);
</script>
