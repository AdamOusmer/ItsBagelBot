import '../styles/elements/light-field.css';

interface Props {
    class?: string;
    warmth?: number;
}

const { class: className = '', warmth = 0.7 } = Astro.props;
const classes = ['bb-light-field', className].filter(Boolean).join(' ');
---

<div class={classes} aria-hidden="true"></div><script type="application/json" is:inline set:html={JSON.stringify({ warmth })}></script>

<script>
    import { field } from '../lib/light-field';

    const running = new Set<() => void>();
    const ready = new WeakSet<HTMLElement>();

    function setupField(payload: Element): void {
        const host = payload.previousElementSibling;
        if (!(host instanceof HTMLElement) || ready.has(host)) return;

        const stop = field(host, { warmth: JSON.parse(payload.textContent ?? '{}').warmth || 0.7 });
        if (!stop) return;
        ready.add(host);

        const cleanup = () => {
            stop();
            ready.delete(host);
            running.delete(cleanup);
        };
        running.add(cleanup);
    }

    function setup(): void {
        document.querySelectorAll('.bb-light-field + script[type="application/json"]').forEach(setupField);
    }

    function teardown(): void {
        running.forEach((cleanup) => cleanup());
    }

    setup();
    document.addEventListener('astro:page-load', setup);
    document.addEventListener('astro:before-swap', teardown);
    window.addEventListener('pagehide', teardown);
</script>
