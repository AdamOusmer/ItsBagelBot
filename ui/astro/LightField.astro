import '../styles/elements/light-field.css';

interface Props {
    class?: string;
    warmth?: number;
}

const { class: className = '', warmth = 0.7 } = Astro.props;
const classes = ['bb-light-field', className].filter(Boolean).join(' ');
---

<canvas class={classes} data-field data-warmth={warmth} aria-hidden="true"></canvas>

<script>
    import { field } from '../lib/light-field';

    const running = new Set<() => void>();

    function setupField(canvas: HTMLCanvasElement): void {
        if (canvas.dataset.fieldReady === 'true') return;

        const stop = field(canvas, { warmth: parseFloat(canvas.dataset.warmth ?? '') || 0.7 });
        if (!stop) return;
        canvas.dataset.fieldReady = 'true';

        const cleanup = () => {
            stop();
            canvas.removeAttribute('data-field-ready');
            canvas.width = 0;
            canvas.height = 0;
            running.delete(cleanup);
        };
        running.add(cleanup);
    }

    function setup(): void {
        document.querySelectorAll<HTMLCanvasElement>('canvas[data-field]').forEach(setupField);
    }

    function teardown(): void {
        running.forEach((cleanup) => cleanup());
    }

    setup();
    document.addEventListener('astro:page-load', setup);
    document.addEventListener('astro:before-swap', teardown);
    window.addEventListener('pagehide', teardown);
</script>
