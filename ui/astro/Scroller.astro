import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/page.css';

interface Props extends Omit<HTMLAttributes<'div'>, 'maxHeight' | 'fill' | 'padding' | 'class'> {
    maxHeight?: string;
    fill?: boolean;
    padding?: string;
    class?: string;
}

const { maxHeight, fill = false, padding, class: className = '', ...rest } = Astro.props;
const classes = ['bb-scroller', fill ? 'bb-scroller--fill' : null, 'bb-scroll', className]
    .filter(Boolean)
    .join(' ');
const style =
    [maxHeight && `max-height:${maxHeight}`, padding && `padding:${padding}`]
        .filter(Boolean)
        .join(';') || undefined;
---

<div class={classes} style={style} {...rest}><slot /></div>
