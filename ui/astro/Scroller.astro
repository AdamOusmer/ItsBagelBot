// Astro twin of ../svelte/Scroller.svelte: a scroll region wearing the thin
// tan scrollbar instead of the browser's default chrome bar.
//
// Extra attributes (role, aria-*, data-*) pass straight through to the
// scrolling element. Nothing is needed for the smooth scroller: its
// nested-scroll gate (lib/nested-scroll.ts) reads this pane's overflow and
// position on every wheel and yields while the pane can move. Do NOT add
// `data-lenis-prevent` here; it is for overlays that must never chain the
// wheel to the page. `...rest` lands on the scrolling div rather than a
// wrapper so such a one-off still hits the element that actually scrolls.
import '../styles/elements/shell.css';

interface Props {
    /** Height cap before scrolling starts (e.g. '208px'). Omit to grow. */
    maxHeight?: string;
    /** Fill a flex parent and scroll the overflow. */
    fill?: boolean;
    /** Inner padding, kept inside the scroll region so the bar hugs the edge. */
    padding?: string;
    class?: string;
    [key: string]: unknown;
}

const { maxHeight, fill = false, padding, class: className = '', ...rest } = Astro.props;
const classes = ['bb-scroller', fill ? 'bb-scroller--fill' : null, 'bb-scroll', className]
    .filter(Boolean)
    .join(' ');
const style =
    [maxHeight && `max-height:${maxHeight}`, padding && `padding:${padding}`]
        .filter(Boolean)
        .join(';') || undefined;
---

<div class={classes} style={style} {...rest}><slot /></div>
