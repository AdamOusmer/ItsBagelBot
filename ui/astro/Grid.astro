import type { HTMLAttributes } from 'astro/types';
import '../styles/elements/layout.css';

interface Props extends Omit<HTMLAttributes<'div'>, 'cols' | 'gap' | 'min' | 'stackAt' | 'as' | 'class'> {
    cols?: 1 | 2 | 3 | 4 | 5 | 6;
    gap?: 1 | 2 | 3 | 4 | 5 | 6;
    min?: string;
    stackAt?: 'sm' | 'md';
    as?: 'div' | 'ul' | 'ol' | 'section';
    class?: string;
}

const { cols = 1, gap = 4, min, stackAt = 'sm', as: Tag = 'div', class: className = '', ...rest } = Astro.props;
const classes = [
    'bb-grid',
    min ? 'bb-grid--auto' : `bb-grid--${cols}`,
    `bb-grid--gap-${gap}`,
    stackAt === 'md' ? 'bb-grid--stack-md' : null,
    className,
]
    .filter(Boolean)
    .join(' ');
---

<Tag class={classes} style={min ? `--grid-min: ${min};` : undefined} {...rest}><slot /></Tag>
