import '../styles/elements/typography.css';

interface Props {
    focusable?: boolean;
    as?: 'span' | 'div' | 'p' | 'a';
    class?: string;
}

const { focusable = false, as: Tag = 'span', class: className = '', ...rest } = Astro.props;
const classes = ['bb-sr-only', focusable ? 'bb-sr-only--focusable' : null, className]
    .filter(Boolean)
    .join(' ');
---

<Tag class={classes} {...rest}><slot /></Tag>
