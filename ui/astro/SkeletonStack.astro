import '../styles/elements/skeleton.css';
import Skeleton from './Skeleton.astro';

interface Props {
    rows: number;
    height: string;
    columns?: 1 | 2;
}

const { rows, height, columns = 1 } = Astro.props;
---

<div class={columns === 2 ? 'bb-skel-stack bb-skel-stack--grid' : 'bb-skel-stack'} aria-hidden="true">{Array.from({ length: rows }, () => (<Skeleton variant="block" height={height} />))}</div>
