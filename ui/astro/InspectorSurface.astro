import { uiI18n } from './i18n';

import '../styles/elements/card.css';
import '../styles/elements/surface.css';
import Icon from './Icon.astro';

interface Props {
    open?: boolean;
    title: string;
    controls?: string;
    closeLabel?: string;
    class?: string;
    [key: string]: unknown;
}

const { t } = uiI18n(Astro);
const { open = true, title, controls, closeLabel = t('action.close'), class: className = '', ...rest } = Astro.props;
const idle = !open && Astro.slots.has('idle');
const classes = ['bb-surface', 'bb-card', 'bb-surface--docked', idle ? 'bb-surface--idle' : null, className]
    .filter(Boolean)
    .join(' ');
---

<aside class={classes} aria-label={title} {...rest}><div class="bb-surface__head"><span class="bb-surface__tag bb-tag bb-tag--bare">{title}</span><button class="bb-surface__close" type="button" aria-label={closeLabel}><Icon name="x" size={14} /></button></div><div class="bb-surface__body" id={controls}>{idle ? (<div class="bb-surface__idle"><slot name="idle" /></div>) : <slot />}</div></aside>
