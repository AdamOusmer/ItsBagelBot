import '../styles/elements/cursor.css';
---

<div class="bb-cursor" aria-hidden="true"></div>
<div class="bb-cursor-ring" aria-hidden="true"></div>

<script>
    import { mountCursor } from '../lib/cursor-engine';
    import { prefersReducedMotion, reduceMotion } from '../lib/motion-query';

    let dispose: (() => void) | null = null;

    function unmount(): void {
        dispose?.();
        dispose = null;
    }

    function mount(): void {
        if (dispose || prefersReducedMotion()) return;
        const dot = document.querySelector<HTMLElement>('.bb-cursor');
        const ring = document.querySelector<HTMLElement>('.bb-cursor-ring');
        if (!dot || !ring || dot.dataset.ready === '1') return;
        dot.dataset.ready = '1';
        dispose = mountCursor({ dot, ring });
    }

    mount();
    document.addEventListener('astro:page-load', mount);
    document.addEventListener('astro:before-swap', unmount);
    window.addEventListener('pagehide', unmount);
    reduceMotion.addEventListener('change', () => (prefersReducedMotion() ? unmount() : mount()));
</script>
