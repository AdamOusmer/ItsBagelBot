import '../styles/elements/layout.css';

interface Props {
    size?: 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8;
    grow?: boolean;
    class?: string;
}

const { size = 4, grow = false, class: className = '', ...rest } = Astro.props;
const classes = ['bb-spacer', grow ? 'bb-spacer--grow' : `bb-spacer--${size}`, className]
    .filter(Boolean)
    .join(' ');
---

<span class={classes} aria-hidden="true" {...rest} />
