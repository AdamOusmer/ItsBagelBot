import '../styles/elements/layout.css';

interface Props {
    size?: 'default' | 'sm' | 'lg' | 'flush';
    anchor?: boolean;
    reveal?: boolean;
    as?: string;
    class?: string;
}

const {
    size = 'default',
    anchor = false,
    reveal = false,
    as: Tag = 'section',
    class: className = '',
    ...rest
} = Astro.props;
const classes = [
    'bb-section',
    size === 'default' ? null : `bb-section--${size}`,
    anchor ? 'bb-section--anchor' : null,
    className,
]
    .filter(Boolean)
    .join(' ');
---

<Tag class={classes} data-reveal={reveal ? '' : undefined} {...rest}><slot /></Tag>
