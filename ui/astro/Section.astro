import type { HTMLAttributes } from 'astro/types';
import '../styles/elements/layout.css';

interface Props extends Omit<HTMLAttributes<'div'>, 'size' | 'anchor' | 'reveal' | 'as' | 'class'> {
    size?: 'default' | 'sm' | 'lg' | 'flush' | 'page';
    anchor?: boolean;
    reveal?: boolean;
    as?: 'section' | 'article' | 'div' | 'ul' | 'ol' | 'li' | 'header' | 'footer' | 'aside' | 'main';
    class?: string;
}

const {
    size = 'default',
    anchor = false,
    reveal = false,
    as: Tag = 'section',
    class: className = '',
    ...rest
} = Astro.props;
const classes = [
    'bb-section',
    size === 'default' ? null : `bb-section--${size}`,
    anchor ? 'bb-section--anchor' : null,
    className,
]
    .filter(Boolean)
    .join(' ');
---

<Tag class={classes} data-reveal={reveal ? '' : undefined} {...rest}><slot /></Tag>
