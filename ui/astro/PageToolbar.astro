import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/shell.css';

interface Props extends Omit<HTMLAttributes<'div'>, 'class'> {
    class?: string;
}

const { class: className = '', ...rest } = Astro.props;
const classes = ['bb-toolbar', className].filter(Boolean).join(' ');
---

<div class={classes} {...rest}><slot name="leading" /><div class="bb-toolbar__grow"></div><slot name="trailing" /></div>
