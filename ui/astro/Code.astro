// Astro twin of ../svelte/Code.svelte. `block` emits the <pre><code> pair
// rather than a <code> with white-space:pre; the reason is recorded there.
import '../styles/elements/typography.css';

interface Props {
    /** Renders inside a <pre>, for multi-line code. */
    block?: boolean;
    class?: string;
}

const { block = false, class: className = '', ...rest } = Astro.props;
const classes = ['bb-code', className].filter(Boolean).join(' ');
---

{block ? (<pre class="bb-code-block" {...rest}><code class={classes}><slot /></code></pre>) : (<code class={classes} {...rest}><slot /></code>)}
