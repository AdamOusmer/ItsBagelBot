import '../styles/elements/typography.css';

interface Props {
    block?: boolean;
    tone?: 'danger';
    class?: string;
}

const { block = false, tone, class: className = '', ...rest } = Astro.props;
const classes = ['bb-code', tone && `bb-code--${tone}`, className].filter(Boolean).join(' ');
---

{block ? (<pre class="bb-code-block" {...rest}><code class={classes}><slot /></code></pre>) : (<code class={classes} {...rest}><slot /></code>)}
