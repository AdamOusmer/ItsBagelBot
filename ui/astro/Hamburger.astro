import type { HTMLAttributes } from 'astro/types';

import { uiI18n } from './i18n';

import '../styles/elements/nav.css';

interface Props extends Omit<HTMLAttributes<'button'>, 'label' | 'closeLabel' | 'controls' | 'class'> {
  label?: string;
  closeLabel?: string;
  controls?: string;
  class?: string;
}

const { t } = uiI18n(Astro);
const {
  label = t('nav.menuOpen'),
  closeLabel = t('nav.menuClose'),
  controls = 'bb-mobile-menu',
  class: className = '',
  ...rest
} = Astro.props;

const classes = ['bb-hamburger', className || null].filter(Boolean).join(' ');
---

<button
  class={classes}
  type="button"
  data-menu-toggle
  aria-label={label}
  aria-expanded="false"
  aria-controls={controls}
  data-label-close={closeLabel}
  {...rest}
><span class="bb-hamburger__bar"></span><span class="bb-hamburger__bar"></span><span class="bb-hamburger__bar"></span></button>
