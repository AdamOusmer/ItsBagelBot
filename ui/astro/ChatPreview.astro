import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/chat-preview.css';
import StatusDot from './StatusDot.astro';

interface Props extends Omit<HTMLAttributes<'div'>, 'title' | 'class'> {
  title: string;
  label?: string;
  kind?: string;
  note?: string;
  class?: string;
}

const { title, label, kind, note, class: className = '', ...rest } = Astro.props;
---

<div class={`bb-chat ${className}`.trim()} role={label ? 'img' : 'group'} aria-label={label} {...rest}>
  <div class="bb-chat__bar">
    <StatusDot tone="success" />
    <span class="bb-chat__title"><slot name="heading">{title}</slot></span>
    {kind && <b class="bb-chat__kind">{kind}</b>}
  </div>
  <div class="bb-chat__feed"><slot /></div>
  {note && <i class="gs-mark" data-note={note}></i>}
</div>
