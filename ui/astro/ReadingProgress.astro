// Astro adapter for the `.bb-reading-progress` contract
// (../styles/elements/reading-progress.css). Svelte twin:
// ../svelte/ReadingProgress.svelte.
//
// The 2px gradient bar at the top of the viewport showing how far down the page
// the reader is. Mounted once in a site's layout, so every page gets it.
//
// One hoisted script serves the page (Astro dedupes it) and finds the fill by
// its contract attribute rather than each instance carrying inline setup —
// same shape as ../astro/LightField.astro, and for the same reason: the engine
// owns a scroll listener and a frame subscription, so it needs a real teardown
// before the ClientRouter throws the old document away.
import '../styles/elements/reading-progress.css';

interface Props {
    class?: string;
}

const { class: className = '', ...rest } = Astro.props;
const classes = ['bb-reading-progress', className].filter(Boolean).join(' ');
---

<div class={classes} aria-hidden="true" {...rest}><span class="bb-reading-progress__fill" data-reading-progress></span></div>

<script>
    import { mountReadingProgress } from '../lib/reading-progress';

    let dispose: (() => void) | null = null;

    function teardown(): void {
        dispose?.();
        dispose = null;
    }

    function setup(): void {
        teardown();
        const fill = document.querySelector<HTMLElement>('[data-reading-progress]');
        if (fill) dispose = mountReadingProgress(fill);
    }

    setup();
    document.addEventListener('astro:page-load', setup);
    document.addEventListener('astro:before-swap', teardown);
    window.addEventListener('pagehide', teardown);
</script>
