import '../styles/elements/reading-progress.css';

interface Props {
    class?: string;
}

const { class: className = '', ...rest } = Astro.props;
const classes = ['bb-reading-progress', className].filter(Boolean).join(' ');
---

<div class={classes} aria-hidden="true" {...rest}><span class="bb-reading-progress__fill" data-reading-progress></span></div>

<script>
    import { mountReadingProgress } from '../lib/reading-progress';

    let dispose: (() => void) | null = null;

    function teardown(): void {
        dispose?.();
        dispose = null;
    }

    function setup(): void {
        teardown();
        const fill = document.querySelector<HTMLElement>('[data-reading-progress]');
        if (fill) dispose = mountReadingProgress(fill);
    }

    setup();
    document.addEventListener('astro:page-load', setup);
    document.addEventListener('astro:before-swap', teardown);
    window.addEventListener('pagehide', teardown);
</script>
