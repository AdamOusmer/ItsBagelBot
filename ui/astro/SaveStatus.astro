import { uiI18n } from './i18n';

import '../styles/elements/tag.css';
import '../styles/elements/mark.css';

interface Props {
    state?: 'idle' | 'saving' | 'saved' | 'live' | 'error';
    compact?: boolean;
    savingLabel?: string;
    savedLabel?: string;
    liveLabel?: string;
    errorLabel?: string;
    class?: string;
}

const { t } = uiI18n(Astro);
const {
    state = 'idle',
    compact = false,
    savingLabel = t('status.saving'),
    savedLabel = t('status.saved'),
    liveLabel = t('status.live'),
    errorLabel = t('status.failed'),
    class: className = '',
    ...rest
} = Astro.props;

const TONE: Record<string, string> = {
    idle: '',
    saving: 'bb-tag--quiet',
    saved: 'bb-tag--alpha',
    live: 'bb-tag--live',
    error: 'bb-tag--danger',
};
const MARK: Record<string, string> = {
    idle: '',
    saving: 'bb-mark--dash',
    saved: '',
    live: '',
    error: 'bb-mark--hollow',
};
const LABELS: Record<string, string> = {
    idle: '',
    saving: savingLabel,
    saved: savedLabel,
    live: liveLabel,
    error: errorLabel,
};

const classes = ['bb-tag', TONE[state], className].filter(Boolean).join(' ');
const markClasses = ['bb-mark', MARK[state]].filter(Boolean).join(' ');
---

{state !== 'idle' && (<span class={classes} role="status" {...rest}><i class={markClasses} aria-hidden="true"></i>{!compact && LABELS[state]}{state === 'saving' && <i class="bb-sweep bb-sweep--tan" aria-hidden="true"></i>}{state === 'live' && <i class="bb-sweep" aria-hidden="true"></i>}</span>)}
