const { on = false, type = 'button', tone, class: cls = '', ...rest } = Astro.props;
const className = `bb-chip${tone ? ` bb-chip--${tone}` : ''}${cls ? ` ${cls}` : ''}`;
---

<button type={type} class={className} data-on={on ? '' : undefined} {...rest}><slot /></button>
