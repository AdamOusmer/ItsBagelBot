import '../styles/tags.css';
import '../styles/elements/chip.css';

import '../styles/tags.css';
import '../styles/elements/chip.css';

interface Props {
    on?: boolean;
    type?: 'button' | 'submit' | 'reset';
    tone?: 'muted' | 'danger' | 'eyebrow' | 'free' | 'paid' | 'vip' | 'banned' | 'inactive';
    as?: 'button' | 'span';
    class?: string;
    [key: string]: unknown;
}

const { on = false, type = 'button', tone, as: Tag = 'button', class: cls = '', ...rest } = Astro.props;
const className = `bb-chip${tone ? ` bb-chip--${tone}` : ''}${cls ? ` ${cls}` : ''}`;
---

<Tag type={Tag === 'button' ? type : undefined} class={className} data-on={on ? '' : undefined} {...rest}><slot /></Tag>
