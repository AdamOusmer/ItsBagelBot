import type { HTMLAttributes } from 'astro/types';

import '../styles/orbs.css';
import '../styles/elements/error-scene.css';
import { perchSplit } from '../lib/error-scene';
import LightField from './LightField.astro';

type ErrorSceneAction = {
    label: string;
    href?: string;
    [attribute: string]: unknown;
};

interface Props extends Omit<HTMLAttributes<'main'>, 'status' | 'eyebrow' | 'title' | 'description' | 'aside' | 'class' | 'labelledBy' | 'primary' | 'secondary'> {
    status?: number | string;
    eyebrow: string;
    title: string;
    description: string;
    aside?: string;
    class?: string;
    labelledBy?: string;
    primary?: ErrorSceneAction;
    secondary?: ErrorSceneAction;
}

const {
    status,
    eyebrow,
    title,
    description,
    aside,
    class: className = '',
    labelledBy = 'bb-error-title',
    primary,
    secondary,
    ...rest
} = Astro.props;

const classes = ['bb-error-scene', className].filter(Boolean).join(' ');
const controls = [
    primary && { action: primary, tone: 'primary' },
    secondary && { action: secondary, tone: 'quiet' },
].filter((control): control is { action: ErrorSceneAction; tone: string } => Boolean(control));
const hasActions = controls.length > 0 || Astro.slots.has('actions');
const hasMascot = Astro.slots.has('mascot');
const { before, digit, after } = perchSplit(status ?? '');
---

<main class={classes} aria-labelledby={labelledBy} {...rest}><LightField class="bb-light-field--bleed" /><div class="bb-error-scene__orbs" aria-hidden="true"><span class="bb-orb bb-orb--halo bb-orb--green bb-error-scene__orb"><i class="bb-orb__pulse"></i></span><span class="bb-orb bb-orb--halo bb-orb--tan bb-error-scene__orb bb-error-scene__orb--two"><i class="bb-orb__pulse"></i></span></div><div class="bb-error-scene__content">{status !== undefined ? (<><p class="bb-error-scene__eyebrow"><span>{status}</span> · {eyebrow}</p><p class="bb-error-scene__code" aria-hidden="true">{before}<span class="bb-error-scene__perch">{digit}{hasMascot && (<span class="bb-error-scene__mascot"><slot name="mascot" /></span>)}</span>{after}</p></>) : (<>{Astro.slots.has('mark') && (<div class="bb-error-scene__mark" aria-hidden="true"><slot name="mark" /></div>)}<p class="bb-error-scene__eyebrow">{eyebrow}</p></>)}<h1 class="bb-error-scene__title" id={labelledBy}>{title}</h1><p class="bb-error-scene__desc">{description}</p>{hasActions && (<div class="bb-error-scene__actions">{controls.map(({ action: { label, href, ...attributes }, tone }) => href ? (<a class={`bb-error-scene__action bb-error-scene__action--${tone}`} href={href} {...attributes}>{label}</a>) : (<button class={`bb-error-scene__action bb-error-scene__action--${tone}`} type="button" {...attributes}>{label}</button>))}<slot name="actions" /></div>)}{aside && (<p class="bb-error-scene__aside">{aside}</p>)}<slot /></div></main>
