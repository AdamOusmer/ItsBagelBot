import '../styles/elements/error-scene.css';
import LightField from './LightField.astro';

interface Props {
    status: number | string;
    eyebrow: string;
    title: string;
    description: string;
    aside?: string;
    class?: string;
    labelledBy?: string;
    [key: string]: unknown;
}

const {
    status,
    eyebrow,
    title,
    description,
    aside,
    class: className = '',
    labelledBy = 'bb-error-title',
    ...rest
} = Astro.props;

const classes = ['bb-error-scene', className].filter(Boolean).join(' ');
const hasActions = Astro.slots.has('actions');
---

<main class={classes} aria-labelledby={labelledBy} {...rest}><LightField /><div class="bb-error-scene__glow" aria-hidden="true"></div><div class="bb-error-scene__orbits" aria-hidden="true"><span class="bb-error-scene__orbit"></span><span class="bb-error-scene__orbit bb-error-scene__orbit--two"></span></div><div class="bb-error-scene__content"><p class="bb-error-scene__eyebrow"><span>{status}</span> · {eyebrow}</p><!-- The code is aria-hidden: it is an outline treatment
     (-webkit-text-stroke over transparent text) and it is already announced,
     as a number rather than as decoration, in the eyebrow. --><p class="bb-error-scene__code" aria-hidden="true">{status}</p><h1 class="bb-error-scene__title" id={labelledBy}>{title}</h1><p class="bb-error-scene__desc">{description}</p>{hasActions && (<div class="bb-error-scene__actions"><slot name="actions" /></div>)}{aside && (<p class="bb-error-scene__aside">{aside}</p>)}</div></main>
