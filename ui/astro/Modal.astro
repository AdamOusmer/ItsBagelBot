import '../styles/elements/modal.css';

interface Props {
    open?: boolean;
    title?: string;
    ariaLabel?: string;
    closeLabel?: string;
    titleId?: string;
    variant?: 'dialog' | 'viewer';
    toolbarLabel?: string;
    class?: string;
    [key: string]: unknown;
}

const {
    open = true,
    title,
    ariaLabel,
    closeLabel = 'Close',
    titleId = 'bb-modal-title',
    variant = 'dialog',
    toolbarLabel,
    class: className = '',
    ...rest
} = Astro.props;
const viewer = variant === 'viewer';
const classes = ['bb-modal', viewer ? 'bb-modal--viewer' : null, className].filter(Boolean).join(' ');
const hasToolbar = Astro.slots.has('toolbar');
const hasHint = Astro.slots.has('hint');
---

<div class={classes} data-overlay style="z-index: 200" hidden={!open} {...rest}><button class="bb-modal__backdrop" type="button" aria-label={closeLabel} data-cursor="quiet"></button><div class="bb-modal__card" role="dialog" aria-modal="true" tabindex="-1" aria-labelledby={title ? titleId : undefined} aria-label={title ? undefined : ariaLabel} data-lenis-prevent>{title && <h3 class="bb-modal__title" id={titleId}>{title}</h3>}{viewer ? (<Fragment><div class="bb-modal__stage"><slot /></div>{hasToolbar && (<div class="bb-modal__toolbar" role="toolbar" aria-label={toolbarLabel}><slot name="toolbar" /></div>)}{hasHint && (<div class="bb-modal__hint" aria-hidden="true"><slot name="hint" /></div>)}</Fragment>) : <slot />}</div></div>
