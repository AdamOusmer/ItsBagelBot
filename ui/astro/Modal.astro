import type { HTMLAttributes } from 'astro/types';
import { uiI18n } from './i18n';

import '../styles/elements/modal.css';

type Named = { title: string; label?: string } | { title?: undefined; label: string };
interface Base extends Omit<HTMLAttributes<'div'>, 'open' | 'title' | 'label' | 'closeLabel' | 'titleId' | 'variant' | 'role' | 'toolbarLabel' | 'class'> {
    open?: boolean;
    closeLabel?: string;
    titleId?: string;
    variant?: 'dialog' | 'viewer';
    role?: 'dialog' | 'alertdialog';
    describedBy?: string;
    headingLevel?: 1 | 2 | 3 | 4 | 5 | 6;
    toolbarLabel?: string;
    class?: string;
}
type Props = Base & Named;

const { t } = uiI18n(Astro);
const {
    open = true,
    title,
    label,
    closeLabel = t('action.close'),
    titleId = 'bb-modal-title',
    variant = 'dialog',
    role = 'dialog',
    describedBy,
    headingLevel = 3,
    toolbarLabel,
    class: className = '',
    ...rest
} = Astro.props;
const viewer = variant === 'viewer';
const classes = ['bb-modal', viewer ? 'bb-modal--viewer' : null, className].filter(Boolean).join(' ');
const hasToolbar = Astro.slots.has('toolbar');
const hasHint = Astro.slots.has('hint');
const Heading = `h${headingLevel}`;
---

<div class={classes} data-overlay style="z-index: 200" hidden={!open} {...rest}><button class="bb-modal__backdrop" type="button" aria-label={closeLabel} data-cursor="quiet"></button><div class="bb-modal__card" role={role} aria-modal="true" tabindex="-1" aria-describedby={describedBy} aria-labelledby={title ? titleId : undefined} aria-label={title ? undefined : label} data-lenis-prevent>{title && <Heading class="bb-modal__title" id={titleId}>{title}</Heading>}{viewer ? (<Fragment><div class="bb-modal__stage"><slot /></div>{hasToolbar && (<div class="bb-modal__toolbar" role="toolbar" aria-label={toolbarLabel}><slot name="toolbar" /></div>)}{hasHint && (<div class="bb-modal__hint" aria-hidden="true"><slot name="hint" /></div>)}</Fragment>) : <slot />}</div></div>
