import '../styles/elements/shell.css';
import Topbar from './Topbar.astro';
import Dock from './Dock.astro';
import Rail from './Rail.astro';
import type { UiBrand, UiCrumb, UiNavGroup, UiNavLink } from '../lib/nav-types';

interface Props {
  brand: UiBrand;
  crumbs?: UiCrumb[];
  groups?: UiNavGroup[];
  dockItems?: UiNavLink[];
  rail?: boolean;
  offset?: boolean;
  skipLabel: string;
  crumbAriaLabel?: string;
  dockAriaLabel?: string;
  railAriaLabel?: string;
  clock?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  brand,
  crumbs = [],
  groups = [],
  dockItems = [],
  rail = false,
  offset = false,
  skipLabel,
  crumbAriaLabel,
  dockAriaLabel,
  railAriaLabel,
  clock = true,
  class: className = '',
  ...rest
} = Astro.props;

const classes = ['bb-shell', offset ? 'bb-shell--offset' : null, rail ? 'bb-shell--railed' : null, className]
  .filter(Boolean)
  .join(' ');

const items = dockItems.length ? dockItems : groups.flatMap((group) => group.items);
---

<a class="bb-shell__skip" href="#main-content">{skipLabel}</a><slot name="banner" /><div class={classes} {...rest}>{rail && (<Rail brand={brand} groups={groups} ariaLabel={railAriaLabel}><Fragment slot="foot"><slot name="railFoot" /></Fragment></Rail>)}<div class="bb-shell__stage"><Topbar brand={brand} crumbs={crumbs} crumbAriaLabel={crumbAriaLabel} clock={clock} railed={rail}><Fragment slot="account"><slot name="account" /></Fragment><Fragment slot="actions"><slot name="topActions" /></Fragment></Topbar><main class="bb-shell__main" id="main-content" tabindex="-1"><div class="bb-shell__canvas"><slot /></div></main></div><div class="bb-shell__dock-slot"><Dock items={items} groups={groups} ariaLabel={dockAriaLabel} /></div></div>
