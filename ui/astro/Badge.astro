import '../styles/elements/tag.css';
import '../styles/elements/mark.css';
import '../styles/elements/badge.css';
const { tone, shape = 'tag', mark, sweep = false, dashed = false, literal = false, status = false, class: className = '', ...rest } = Astro.props;
const cls = [
    'bb-tag bb-badge',
    shape === 'pill' ? 'bb-badge--pill' : null,
    tone ? `bb-tag--${tone}` : null,
    dashed ? 'bb-badge--dashed' : null,
    literal ? 'bb-tag--literal' : null,
    className,
]
    .filter(Boolean)
    .join(' ');
---

<span class={cls} role={status ? 'status' : undefined} {...rest}>{mark && <i class={`bb-mark${mark === 'solid' ? '' : ` bb-mark--${mark}`}`} aria-hidden="true"></i>}<slot />{sweep && <i class="bb-sweep" aria-hidden="true"></i>}</span>
