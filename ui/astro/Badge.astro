import '../styles/tags.css';
import '../styles/elements/badge.css';
const { tone, shape = 'tag', mark, sweep = false, dashed = false, status = false, class: className = '', ...rest } = Astro.props;
const cls = `bb-tag bb-badge${shape === 'pill' ? ' bb-badge--pill' : ''}${tone ? ` bb-tag--${tone}` : ''}${dashed ? ' bb-badge--dashed' : ''}${className ? ` ${className}` : ''}`;
---

<span class={cls} role={status ? 'status' : undefined} {...rest}>{mark && <i class={`bb-mark${mark === 'solid' ? '' : ` bb-mark--${mark}`}`} aria-hidden="true"></i>}<slot />{sweep && <i class="bb-sweep" aria-hidden="true"></i>}</span>
