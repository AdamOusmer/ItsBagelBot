//
// Astro twin of ../svelte/EmptyState.svelte. The CTA row renders only when the
// caller fills the default slot, matching the Svelte adapter's `children`
// guard: an empty .bb-empty__cta would still add its 16px top margin.
const { title, body, ...rest } = Astro.props;
const hasCta = Astro.slots.has('default');
---

<div class="bb-empty" {...rest}>
  <p class="bb-empty__title">{title}</p>
  {body && <p class="bb-empty__body">{body}</p>}
  {hasCta && <div class="bb-empty__cta"><slot /></div>}
</div>
