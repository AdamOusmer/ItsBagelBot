import type { HTMLAttributes } from 'astro/types';
import '../styles/elements/empty-state.css';
interface Props extends Omit<HTMLAttributes<'div'>, 'title' | 'body' | 'class'> {
    title: string;
    body?: string;
    class?: string;
}

const { title, body, class: className, ...rest } = Astro.props;
const hasCta = Astro.slots.has('default');
---

<div class:list={['bb-empty', className]} {...rest}>
  <p class="bb-empty__title">{title}</p>
  {body && <p class="bb-empty__body">{body}</p>}
  {hasCta && <div class="bb-empty__cta"><slot /></div>}
</div>
