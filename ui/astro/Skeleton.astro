import '../styles/elements/skeleton.css';

interface Props {
    variant?: 'text' | 'pill' | 'block';
    width?: string;
    height?: string;
    lines?: number;
}

const { variant = 'text', width, height, lines = 1 } = Astro.props;

const size = (w?: string, h?: string) =>
    `${w ? `--skel-w:${w};` : ''}${h ? `--skel-h:${h};` : ''}` || undefined;
---

{variant === 'text' && lines > 1 ? (<span class="bb-skel-lines" style={size(width ?? '100%')}>{Array.from({ length: lines }, (_, i) => (<span class="bb-skel bb-skel--text" style={size(i === lines - 1 ? '60%' : '100%')}></span>))}</span>) : (<span class={`bb-skel bb-skel--${variant}`} style={size(width, height)}></span>)}
