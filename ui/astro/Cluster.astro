import type { HTMLAttributes } from 'astro/types';
import '../styles/elements/layout.css';

interface Props extends Omit<HTMLAttributes<'div'>, 'gap' | 'justify' | 'align' | 'nowrap' | 'as' | 'class'> {
    gap?: 1 | 2 | 3 | 4 | 5 | 6;
    justify?: 'start' | 'center' | 'end' | 'between';
    align?: 'baseline' | 'stretch';
    nowrap?: boolean;
    as?: 'div' | 'span' | 'ul' | 'ol' | 'li' | 'nav' | 'header' | 'footer' | 'section' | 'form';
    class?: string;
}

const {
    gap = 2,
    justify,
    align,
    nowrap = false,
    as: Tag = 'div',
    class: className = '',
    ...rest
} = Astro.props;
const classes = [
    'bb-cluster',
    `bb-cluster--${gap}`,
    justify ? `bb-cluster--${justify}` : null,
    align ? `bb-cluster--${align}` : null,
    nowrap ? 'bb-cluster--nowrap' : null,
    className,
]
    .filter(Boolean)
    .join(' ');
---

<Tag class={classes} {...rest}><slot /></Tag>
