import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/field.css';
import '../styles/elements/input.css';

interface Props extends Omit<HTMLAttributes<'input'>, 'value' | 'type' | 'invalid' | 'fill' | 'mono' | 'class'> {
    value?: string | number | null;
    type?: 'text' | 'email' | 'url' | 'tel' | 'number' | 'password' | 'search' | 'date' | 'datetime-local' | 'month' | 'time' | 'week' | 'color';
    invalid?: boolean;
    fill?: boolean;
    mono?: boolean;
    align?: 'start' | 'end';
    class?: string;
}

const {
    value = '',
    type = 'text',
    invalid = false,
    fill = false,
    mono = false,
    align = 'start',
    class: className = '',
    ...rest
} = Astro.props;
const classes = [
    'bb-input',
    type === 'color' ? 'bb-input--color' : null,
    fill ? 'bb-input--fill' : null,
    mono ? 'bb-input--mono' : null,
    align === 'end' ? 'bb-input--end' : null,
    className,
]
    .filter(Boolean)
    .join(' ');
---

<span class={classes} data-invalid={invalid ? '' : undefined}><slot name="icon" /><input type={type} value={value} {...rest} /><slot name="trail" /></span>
