import type { HTMLAttributes } from 'astro/types';
import { uiI18n } from './i18n';

import '../styles/elements/tabs.css';

interface Props extends Omit<HTMLAttributes<'div'>, 'options' | 'value' | 'label' | 'class'> {
    options: readonly (string | { value: string; label: string; count?: number | string; attrs?: Record<string, string> })[];
    value?: string;
    label?: string;
    class?: string;
}

const { t } = uiI18n(Astro);
const { options, value = '', label = t('choice.filter'), class: className = '', ...rest } = Astro.props;
const items = options.map((opt) => (typeof opt === 'string' ? { value: opt, label: opt, count: undefined, attrs: undefined } : opt));
const tabStop = items.some((opt) => opt.value === value) ? value : items[0]?.value;
const classes = ['bb-tabs bb-tabs--wrap', className].filter(Boolean).join(' ');
---

<div class={classes} role="radiogroup" aria-label={label} {...rest}>{items.map((opt) => (<button type="button" class={`bb-tab ${value === opt.value ? 'is-active' : ''}`} role="radio" aria-checked={value === opt.value} tabindex={tabStop === opt.value ? 0 : -1} value={opt.value} {...opt.attrs}><span data-fit>{opt.label}</span>{opt.count !== undefined && <span class="bb-tab__count">{opt.count}</span>}</button>))}</div>

<script>
    import { rovingTarget } from '../lib/roving-focus';

    const RADIO = 'button[role="radio"]';
    const RADIOS = { selector: RADIO, orientation: 'both', wrap: true } as const;

    function select(buttons: HTMLButtonElement[], chosen: HTMLButtonElement) {
        for (const button of buttons) {
            const on = button === chosen;
            button.setAttribute('aria-checked', String(on));
            button.classList.toggle('is-active', on);
            button.tabIndex = on ? 0 : -1;
        }
    }

    function radios(group: HTMLElement): HTMLButtonElement[] {
        return Array.from(group.querySelectorAll<HTMLButtonElement>(RADIO));
    }

    function onClick(event: MouseEvent) {
        const group = event.currentTarget as HTMLElement;
        const chosen = (event.target as Element).closest<HTMLButtonElement>(RADIO);
        if (chosen) select(radios(group), chosen);
    }

    function onKeydown(event: KeyboardEvent) {
        const next = rovingTarget(event.currentTarget as HTMLElement, event, RADIOS);
        if (!next) return;
        event.preventDefault();
        next.focus();
        next.click();
    }

    function bindSegmented() {
        document.querySelectorAll<HTMLElement>('.bb-tabs[role="radiogroup"]:not([data-bb-segmented])').forEach((group) => {
            if (radios(group).length === 0) return;
            group.dataset.bbSegmented = '';
            group.addEventListener('click', onClick);
            group.addEventListener('keydown', onKeydown);
        });
    }

    bindSegmented();
    document.addEventListener('astro:page-load', bindSegmented);
</script>
