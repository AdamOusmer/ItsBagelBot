import '../styles/tags.css';

interface Props {
    options: readonly string[];
    value?: string;
    label?: string;
}

const { options, value = '', label = 'Filter' } = Astro.props;
---

<div class="bb-tabs bb-tabs--wrap" role="radiogroup" aria-label={label}>{options.map((opt) => (<button type="button" class={`bb-tab ${value === opt ? 'is-active' : ''}`} role="radio" aria-checked={value === opt}>{opt}</button>))}</div>
