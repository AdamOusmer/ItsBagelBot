import CardAtmosphere from './CardAtmosphere.astro';
import '../styles/elements/card.css';

interface Props {
    as?: string;
    href?: string;
    atmo?: boolean;
    sheen?: boolean;
    stat?: boolean;
    glass?: boolean;
    hover?: boolean;
    flush?: boolean;
    dashed?: boolean;
    tone?: 'accent' | 'danger';
    label?: string;
    class?: string;
    [key: string]: unknown;
}

const {
    as = 'div',
    href,
    atmo = false,
    sheen = false,
    stat = false,
    glass = false,
    hover = false,
    flush = false,
    dashed = false,
    tone,
    label = '',
    class: cls = '',
    ...rest
} = Astro.props;

const Tag = as;
const banded = Astro.slots.has('band');

const classes = [
    'bb-card',
    banded && 'bb-card--band',
    stat && 'bb-card--stat',
    sheen && 'bb-card--sheen',
    glass && 'bb-card--glass',
    flush && 'bb-card--flush',
    dashed && 'bb-card--dashed',
    tone && `bb-card--${tone}`,
    cls,
]
    .filter(Boolean)
    .join(' ');
---

<Tag
    class={classes}
    href={href}
    data-card=""
    data-atmo={atmo ? '' : undefined}
    data-hover={hover ? '' : undefined}
    {...rest}
>
    {banded ? (
        <Fragment>
            <span class="bb-card__band">
                {atmo && <CardAtmosphere />}
                {label && <span class="bb-card__label">{label}</span>}
                <span class="bb-card__band-inner"><slot name="band" /></span>
            </span>
            <span class="bb-card__body"><slot /></span>
        </Fragment>
    ) : (
        <Fragment>
            {atmo && <CardAtmosphere />}
            {label && <span class="bb-card__label">{label}</span>}
            <slot /></Fragment>
    )}</Tag>
