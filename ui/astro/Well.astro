import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/well.css';

interface Props extends Omit<HTMLAttributes<'div'>, 'container' | 'as' | 'class'> {
    container?: boolean;
    as?: 'div' | 'span' | 'section' | 'ul' | 'ol' | 'p';
    class?: string;
}

const { container = false, as: Tag = 'div', class: className = '', ...rest } = Astro.props;
const classes = ['bb-well', container ? 'bb-well--container' : null, className].filter(Boolean).join(' ');
---

<Tag class={classes} {...rest}><slot /></Tag>
