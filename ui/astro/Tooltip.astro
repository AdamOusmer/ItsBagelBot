import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/tooltip.css';

interface Props extends Omit<HTMLAttributes<'span'>, 'text' | 'placement' | 'id' | 'class'> {
    text: string;
    placement?: 'top' | 'bottom';
    id?: string;
    class?: string;
}

const { text, placement = 'top', id, class: className = '', ...rest } = Astro.props;
const classes = ['bb-tooltip', placement === 'bottom' ? 'bb-tooltip--bottom' : null, className]
    .filter(Boolean)
    .join(' ');
---

<span class={classes} {...rest}><slot /><span class="bb-tooltip__bubble" id={id} role={id ? 'tooltip' : undefined} aria-hidden={id ? undefined : 'true'}>{text}</span></span>

<script>
    import { wireTooltip } from '../lib/tooltip';

    document.querySelectorAll<HTMLElement>('.bb-tooltip').forEach((root, index) => {
        const bubble = root.querySelector<HTMLElement>(':scope > .bb-tooltip__bubble');
        if (!bubble) return;
        if (!bubble.id) {
            bubble.id = `bb-tooltip-a${index}`;
            bubble.setAttribute('role', 'tooltip');
            bubble.removeAttribute('aria-hidden');
        }
        wireTooltip(root, bubble);
    });
</script>
