// Astro twin of ../svelte/Label.svelte. For a control that is not inside a
// `Field`; the reason is recorded there.
import '../styles/elements/typography.css';

interface Props {
    /** The id of the control this labels. Emitted as `for`. */
    htmlFor?: string;
    class?: string;
}

const { htmlFor, class: className = '', ...rest } = Astro.props;
const classes = ['bb-label', className].filter(Boolean).join(' ');
---

<label class={classes} for={htmlFor} {...rest}><slot /></label>
