import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/typography.css';

interface Props extends Omit<HTMLAttributes<'label'>, 'htmlFor' | 'mono' | 'as' | 'class'> {
    htmlFor?: string;
    mono?: boolean;
    as?: 'label' | 'span' | 'legend';
    class?: string;
}

const { htmlFor, mono = false, as: Tag = 'label', class: className = '', ...rest } = Astro.props;
const classes = ['bb-label', mono ? 'bb-label--mono' : null, className].filter(Boolean).join(' ');
---

<Tag class={classes} for={Tag === 'label' ? htmlFor : undefined} {...rest}><slot /></Tag>
