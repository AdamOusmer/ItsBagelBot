const { label, tag, hint, error, hintId, errorId, for: htmlFor, ...rest } = Astro.props;
---

<label class="bb-field" for={htmlFor} data-invalid={error ? '' : undefined} {...rest}>
  <span class="bb-field__label">{label}{tag && <small class="bb-tag bb-tag--quiet bb-field__tag">{tag}</small>}</span>
  <slot />
  {hint && <small class="bb-field__hint" id={hintId}>{hint}</small>}
  {error && <small class="bb-field__error" role="alert" id={errorId}>{error}</small>}
</label>
