import '../styles/elements/typography.css';
import type { TextTone } from '../lib/tone';

interface Props {
    size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
    tone?: TextTone;
    mono?: boolean;
    truncate?: boolean;
    as?: 'p' | 'span' | 'small' | 'div' | 'li' | 'dd' | 'dt';
    class?: string;
}

const {
    size = 'md',
    tone = 'default',
    mono = false,
    truncate = false,
    as: Tag = 'p',
    class: className = '',
    ...rest
} = Astro.props;
const classes = [
    'bb-text',
    `bb-text--${size}`,
    tone === 'default' ? null : `bb-text--${tone}`,
    mono ? 'bb-text--mono' : null,
    truncate ? 'bb-text--truncate' : null,
    className,
]
    .filter(Boolean)
    .join(' ');
---

<Tag class={classes} {...rest}><slot /></Tag>
