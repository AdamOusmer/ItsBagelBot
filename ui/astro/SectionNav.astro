// Astro twin of ../svelte/SectionNav.svelte: in-page section navigation on the
// shared `.bb-tabs` rail. Real anchors, never ARIA tabs — each one points at a
// section of this page, so the native semantics (open in a new tab,
// right-click, the "link" role) are kept and nothing reimplements roving focus.
//
// Which one is lit comes from the hash at runtime, via ../lib/hash-active.ts.
// This adapter emits none of them as active, which is correct and not a
// compromise: a server (or a static build) never receives the fragment. A
// static page that wants the engine calls `mountHashActive` on the nav in its
// own script; the Svelte twin does it in an effect.
import '../styles/elements/shell.css';
import '../styles/tags.css';

interface Props {
    label: string;
    items: { href: string; label: string; count?: number }[];
    class?: string;
    [key: string]: unknown;
}

const { label, items, class: className = '', ...rest } = Astro.props;
const classes = ['bb-section-nav', 'bb-tabs', className].filter(Boolean).join(' ');
---

<div class="bb-section-nav-host"><nav class={classes} aria-label={label} {...rest}>{items.map((item) => (<a class="bb-tab" href={item.href}>{item.label}{item.count != null && (<span class="bb-section-nav__count">{item.count}</span>)}</a>))}</nav></div>
