import '../styles/elements/typography.css';

interface Props {
    tone?: 'default' | 'go';
    as?: 'span' | 'p' | 'div';
    class?: string;
}

const { tone = 'default', as: Tag = 'span', class: className = '', ...rest } = Astro.props;
const classes = ['bb-eyebrow', tone === 'default' ? null : `bb-eyebrow--${tone}`, className].filter(Boolean).join(' ');
---

<Tag class={classes} {...rest}><slot /></Tag>
