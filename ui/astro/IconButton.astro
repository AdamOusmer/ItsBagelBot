import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/button.css';
import '../styles/elements/tooltip.css';

interface Props extends Omit<HTMLAttributes<'button'>, 'label' | 'tooltip' | 'size' | 'type' | 'disabled' | 'class'> {
    label: string;
    tooltip?: boolean;
    size?: 'md' | 'sm';
    danger?: boolean;
    type?: 'button' | 'submit' | 'reset';
    disabled?: boolean;
    class?: string;
}

const {
    label,
    tooltip = false,
    size = 'md',
    danger = false,
    type = 'button',
    disabled = false,
    class: className = '',
    ...rest
} = Astro.props;
const classes = [
    'bb-btn',
    'bb-btn--icon',
    size === 'sm' ? 'bb-btn--sm' : null,
    danger ? 'bb-btn--danger-hover' : null,
    className,
]
    .filter(Boolean)
    .join(' ');
---

{tooltip ? (<span class="bb-tooltip"><button class={classes} type={type} disabled={disabled} aria-label={label} data-mark="" {...rest}><span class="bb-btn__content"><slot /></span></button><span class="bb-tooltip__bubble" aria-hidden="true">{label}</span></span>) : (<button class={classes} type={type} disabled={disabled} aria-label={label} data-mark="" {...rest}><span class="bb-btn__content"><slot /></span></button>)}
