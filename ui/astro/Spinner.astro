import '../styles/elements/spinner.css';

interface Props {
    size?: 'sm' | 'md';
    class?: string;
    [key: string]: unknown;
}

const { size = 'sm', class: className = '', ...rest } = Astro.props;
const classes = ['bb-spinner', size === 'md' ? 'bb-spinner--md' : null, className || null].filter(Boolean).join(' ');
---

<span class={classes} aria-hidden="true" {...rest}></span>
