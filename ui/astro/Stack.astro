// Astro twin of ../svelte/Stack.svelte. `gap` is a step on the spacing ramp
// and not a CSS length; the reason is recorded there.
import '../styles/elements/layout.css';

interface Props {
    /** Step on the --bb-space ramp, not a length. */
    gap?: 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8;
    align?: 'start' | 'center' | 'end';
    as?: string;
    class?: string;
}

const { gap = 4, align, as: Tag = 'div', class: className = '', ...rest } = Astro.props;
const classes = ['bb-stack', `bb-stack--${gap}`, align ? `bb-stack--${align}` : null, className]
    .filter(Boolean)
    .join(' ');
---

<Tag class={classes} {...rest}><slot /></Tag>
