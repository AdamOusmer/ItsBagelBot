import '../styles/elements/button.css';
import '../styles/elements/nav-link.css';

interface Props {
  href?: string;
  label?: string;
  current?: boolean;
  variant?: 'rail' | 'cta';
  external?: boolean;
  block?: boolean;
  disabled?: boolean;
  hint?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  label = '',
  current = false,
  variant = 'rail',
  external = false,
  block = false,
  disabled = false,
  hint,
  class: className = '',
  ...rest
} = Astro.props;

const classes = [
  'bb-nav-link',
  variant === 'cta' ? 'bb-nav-link--cta' : null,
  block ? 'bb-nav-link--block' : null,
  variant === 'cta' ? 'bb-btn bb-btn--go-solid' : null,
  className || null,
]
  .filter(Boolean)
  .join(' ');
---

{disabled ? (
  <span class={classes} aria-disabled="true" {...rest}><slot name="icon" /><span class="bb-nav-link__label"><slot>{label}</slot></span><slot name="trail" />{hint && <span class="bb-nav-link__hint">{hint}</span>}</span>
) : (
  <a
    class={classes}
    href={href}
    aria-current={current ? 'page' : undefined}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    {...rest}
  ><slot name="icon" /><span class="bb-nav-link__label"><slot>{label}</slot></span><slot name="trail" /></a>
)}
