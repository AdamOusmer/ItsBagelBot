// Astro adapter for `.bb-social-rail`. Its Svelte twin is
// ../svelte/SocialRail.svelte and ../test/parity.test.ts diffs the two.
//
// The glyphs are inlined by ./Icon.astro at build, so the site's strict
// img-src CSP never sees an external asset and the brand bodies inherit the
// rail's tan tint.
import '../styles/elements/nav.css';
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

interface Props {
  items: { label: string; href: string; icon: IconName }[];
  ariaLabel: string;
  /** Glyph edge. 17px is the measured size of the corner stack. */
  size?: number;
  class?: string;
  [key: string]: unknown;
}

const { items, ariaLabel, size = 17, class: className = '', ...rest } = Astro.props;

const classes = ['bb-social-rail', className || null].filter(Boolean).join(' ');
---

<aside class={classes} aria-label={ariaLabel} {...rest}>{items.map((item) => (
  <a
    class="bb-social-rail__item"
    href={item.href}
    aria-label={item.label}
    title={item.label}
    target="_blank"
    rel="noopener noreferrer"
  ><Icon name={item.icon} size={size} /></a>
))}</aside>
