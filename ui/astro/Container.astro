import type { HTMLAttributes } from 'astro/types';
import '../styles/elements/layout.css';

interface Props extends Omit<HTMLAttributes<'div'>, 'width' | 'flush' | 'as' | 'class'> {
    width?: 'default' | 'narrow' | 'text';
    flush?: boolean;
    as?: 'div' | 'section' | 'article' | 'aside' | 'header' | 'footer' | 'main' | 'nav' | 'ul' | 'ol' | 'li' | 'form';
    class?: string;
}

const { width = 'default', flush = false, as: Tag = 'div', class: className = '', ...rest } =
    Astro.props;
const classes = [
    'bb-container',
    width === 'default' ? null : `bb-container--${width}`,
    flush ? 'bb-container--flush' : null,
    className,
]
    .filter(Boolean)
    .join(' ');
---

<Tag class={classes} {...rest}><slot /></Tag>
