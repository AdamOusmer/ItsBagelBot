import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/field.css';
import '../styles/elements/input.css';

interface Props extends Omit<HTMLAttributes<'textarea'>, 'value' | 'rows' | 'invalid' | 'fill' | 'mono' | 'class'> {
    value?: string;
    rows?: number;
    invalid?: boolean;
    fill?: boolean;
    mono?: boolean;
    class?: string;
}

const {
    value = '',
    rows = 3,
    invalid = false,
    fill = false,
    mono = false,
    class: className = '',
    ...rest
} = Astro.props;
const classes = ['bb-input', 'bb-input--area', fill ? 'bb-input--fill' : null, mono ? 'bb-input--mono' : null, className]
    .filter(Boolean)
    .join(' ');
---

<span class={classes} data-invalid={invalid ? '' : undefined}><textarea rows={rows} {...rest}>{value}</textarea></span>
