import '../styles/elements/management-row.css';

interface Props {
    selected?: boolean;
    expanded?: boolean;
    controls?: string;
    disabled?: boolean;
    accent?: boolean;
    class?: string;
}

const {
    selected = false,
    expanded = false,
    controls,
    disabled = false,
    accent = false,
    class: className = '',
    ...rest
} = Astro.props;

const classes = [
    'bb-row',
    'row-shell',
    accent ? 'bb-row--accent' : null,
    selected ? 'is-selected' : null,
    disabled ? 'is-off' : null,
    className || null,
]
    .filter(Boolean)
    .join(' ');
const hasActions = Astro.slots.has('actions');
---

<div class={classes} {...rest}><button class="bb-row__primary" type="button" data-cursor="quiet" aria-expanded={expanded} aria-controls={controls} aria-current={selected ? 'true' : undefined}><slot /></button>{hasActions && <div class="bb-row__actions"><slot name="actions" /></div>}</div>
