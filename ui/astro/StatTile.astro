import type { HTMLAttributes } from 'astro/types';
import type { StatTone } from '../lib/tone';
import '../styles/elements/stat-tile.css';

interface Props extends Omit<HTMLAttributes<'div'>, 'label' | 'value' | 'unit' | 'delta' | 'flat' | 'static' | 'inline' | 'text' | 'tone' | 'class'> {
    label: string;
    value: string;
    unit?: string;
    delta?: string;
    flat?: boolean;
    static?: boolean;
    inline?: boolean;
    text?: boolean;
    tone?: StatTone;
    class?: string;
}

const {
    label,
    value,
    unit = '',
    delta,
    flat = false,
    static: isStatic = false,
    inline = false,
    text = false,
    tone,
    class: className = '',
    ...rest
} = Astro.props;
const classes = [
    'bb-stat',
    isStatic ? 'bb-stat--static' : null,
    inline ? 'bb-stat--inline' : null,
    text ? 'bb-stat--text' : null,
    tone ? `bb-stat--${tone}` : null,
    className || null,
]
    .filter(Boolean)
    .join(' ');
---

<div class={classes} {...rest}>
  <div class="bb-stat__head">
    <span class="bb-stat__label">{label}</span>
    <slot name="trailing" />
  </div>
  <div class="bb-stat__value"><span>{value}</span>{unit && <small>{unit}</small>}</div>
  {delta !== undefined && <div class:list={['bb-stat__delta', flat && 'bb-stat__delta--flat']}>{delta}</div>}
</div>
