import type { HTMLAttributes } from 'astro/types';

import '../styles/tags.css';

interface Props extends Omit<HTMLAttributes<'i'>, 'variant' | 'size' | 'style' | 'class'> {
    variant?: 'solid' | 'hollow' | 'dash' | 'up' | 'plus';
    size?: string;
    style?: string;
    class?: string;
}

const { variant = 'solid', size, style, class: className = '', ...rest } = Astro.props;
const classes = ['bb-mark', variant === 'solid' ? null : `bb-mark--${variant}`, className].filter(Boolean).join(' ');
const styles = [size && `--mark-size: ${size};`, style].filter(Boolean).join(' ') || undefined;
---

<i class={classes} style={styles} aria-hidden="true" {...rest}></i>
