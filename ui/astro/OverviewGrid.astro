import '../styles/elements/overview-grid.css';

interface Props {
    class?: string;
}

const { class: className = '', ...rest } = Astro.props;
const classes = ['bb-ov-row', className].filter(Boolean).join(' ');
---

<div class={classes} {...rest}><div class="bb-ov-row__main"><slot name="main" /></div><div class="bb-ov-row__side"><slot name="side" /></div></div>
