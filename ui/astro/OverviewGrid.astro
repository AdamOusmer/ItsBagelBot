// Astro adapter for the `.bb-ov-row` contract
// (../styles/elements/overview-grid.css). Svelte twin:
// ../svelte/OverviewGrid.svelte.
//
// Two named slots rather than a default one: the element's whole job is the
// two-column relationship, and a default slot would let a caller drop three
// children into it and get a broken grid with no error.
import '../styles/elements/overview-grid.css';

interface Props {
    class?: string;
}

const { class: className = '', ...rest } = Astro.props;
const classes = ['bb-ov-row', className].filter(Boolean).join(' ');
---

<div class={classes} {...rest}><div class="bb-ov-row__main"><slot name="main" /></div><div class="bb-ov-row__side"><slot name="side" /></div></div>
