import type { HTMLAttributes } from 'astro/types';
import '../styles/elements/card.css';
import '../styles/elements/deck-list.css';

interface Props extends Omit<HTMLAttributes<'div'>, 'as' | 'class'> {
    as?: 'div' | 'ul' | 'ol' | 'section';
    class?: string;
}

const { as = 'div', class: className = '', ...rest } = Astro.props;
const Tag = as;
const classes = ['bb-card', 'bb-deck-list', className].filter(Boolean).join(' ');
---

<Tag class={classes} {...rest}><slot /></Tag>
