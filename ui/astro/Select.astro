import type { HTMLAttributes } from 'astro/types';
import { uiI18n } from './i18n';

// Native no-JavaScript form fallback, enhanced into the shared custom picker.
import '../styles/elements/field.css';
import '../styles/elements/input.css';
import '../styles/elements/select.css';
import '../styles/elements/search-input.css';
import '../styles/elements/picker-panel.css';
import type { SelectOption } from '../lib/select';

interface Props extends Omit<HTMLAttributes<'select'>, 'value' | 'options' | 'invalid' | 'fill' | 'searchable' | 'label' | 'placeholder' | 'searchPlaceholder' | 'searchClearLabel' | 'emptyLabel' | 'class'> {
    value?: string;
    options?: readonly SelectOption[];
    invalid?: boolean;
    /** Take the container's width instead of the 240px default. */
    fill?: boolean;
    searchable?: boolean;
    label?: string;
    placeholder?: string;
    searchPlaceholder?: string;
    searchClearLabel?: string;
    emptyLabel?: string;
    class?: string;
}

const { t } = uiI18n(Astro);
const {
    value, options, invalid = false, fill = false, searchable = false,
    label = t('select.label'), placeholder = t('select.placeholder'), searchPlaceholder = t('search.placeholder'),
    searchClearLabel = t('search.clear'), emptyLabel = t('search.empty'), class: className = '', ...rest
} = Astro.props;
const classes = ['bb-input', 'bb-input--select', fill ? 'bb-input--fill' : null, invalid ? 'bb-input--invalid' : null, className]
    .filter(Boolean)
    .join(' ');
const meta = Object.fromEntries(
    (options ?? [])
        .filter((option) => option.description || option.group || option.searchText || option.triggerLabel)
        .map((option) => [option.value, { description: option.description, group: option.group, searchText: option.searchText, triggerLabel: option.triggerLabel }]),
);
const config = JSON.stringify({ value, searchable, label, placeholder, searchPlaceholder, searchClearLabel, emptyLabel, meta }).replace(/</g, '\\u003c');
---

<span class:list={['bb-select', fill && 'bb-select--fill']}>
    <span class={classes}>
        <select {...rest}>
            {options && value !== undefined && !options.some((option) => option.value === value) && (
                <option value="" selected disabled hidden>{placeholder}</option>
            )}
            {options ? options.map((option) => (
                <option value={option.value} selected={value === option.value} disabled={option.disabled}>{option.label}</option>
            )) : <slot />}
        </select>
        <svg class="bb-input__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
    </span>
    <script type="application/json" is:inline set:html={config}></script>
</span>

<script>
    import { enhanceAstroSelect } from '../lib/astro-select';

    function enhanceSelects() {
        document.querySelectorAll<HTMLElement>('.bb-select:has(> script[type="application/json"])').forEach(enhanceAstroSelect);
    }

    enhanceSelects();
    document.addEventListener('astro:page-load', enhanceSelects);
</script>
