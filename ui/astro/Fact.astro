import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/fact-list.css';

interface Props extends Omit<HTMLAttributes<'div'>, 'term' | 'tone' | 'mono' | 'wide' | 'truncate' | 'fit' | 'class'> {
    term: string;
    tone?: 'danger';
    mono?: boolean;
    wide?: boolean;
    truncate?: boolean;
    fit?: boolean;
    class?: string;
}

const { term, tone, mono = false, wide = false, truncate = false, fit = false, class: className = '', ...rest } = Astro.props;

const classes = [
    'bb-fact',
    tone ? `bb-fact--${tone}` : null,
    mono ? 'bb-fact--mono' : null,
    wide ? 'bb-fact--wide' : null,
    truncate ? 'bb-fact--truncate' : null,
    className || null,
]
    .filter(Boolean)
    .join(' ');
---

<div class={classes} {...rest}>{fit ? (<Fragment><dt class="bb-fact__term"><bb-fit>{term}</bb-fit></dt><dd class="bb-fact__value"><bb-fit mode="block"><slot /></bb-fit></dd></Fragment>) : (<Fragment><dt class="bb-fact__term">{term}</dt><dd class="bb-fact__value"><slot /></dd></Fragment>)}</div>
