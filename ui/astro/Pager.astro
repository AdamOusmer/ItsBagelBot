import '../styles/elements/pager.css';
import ButtonLink from './ButtonLink.astro';

interface Props {
    label: string;
    prevHref: string;
    nextHref: string;
    hasPrev?: boolean;
    hasNext?: boolean;
    prevLabel?: string;
    nextLabel?: string;
    class?: string;
    [key: string]: unknown;
}

const {
    label,
    prevHref,
    nextHref,
    hasPrev = true,
    hasNext = true,
    prevLabel = 'Previous',
    nextLabel = 'Next',
    class: className = '',
    ...rest
} = Astro.props;

const classes = ['bb-pager', className || null].filter(Boolean).join(' ');
---

<div class={classes} {...rest}><ButtonLink variant="ghost" href={prevHref} disabled={!hasPrev}>{prevLabel}</ButtonLink><span class="bb-pager__label">{label}</span><ButtonLink variant="ghost" href={nextHref} disabled={!hasNext}>{nextLabel}</ButtonLink></div>
