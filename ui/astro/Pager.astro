import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/pager.css';
import { uiI18n } from './i18n';
import ButtonLink from './ButtonLink.astro';

interface Props extends Omit<HTMLAttributes<'nav'>, 'label' | 'prevHref' | 'nextHref' | 'hasPrev' | 'hasNext' | 'prevLabel' | 'nextLabel' | 'navLabel' | 'class'> {
    label: string;
    prevHref: string;
    nextHref: string;
    hasPrev?: boolean;
    hasNext?: boolean;
    prevLabel?: string;
    nextLabel?: string;
    navLabel?: string;
    class?: string;
}

const { t } = uiI18n(Astro);
const {
    label,
    prevHref,
    nextHref,
    hasPrev = true,
    hasNext = true,
    prevLabel = t('nav.previous'),
    nextLabel = t('nav.next'),
    navLabel = t('nav.pagination'),
    class: className = '',
    ...rest
} = Astro.props;

const classes = ['bb-pager', className || null].filter(Boolean).join(' ');
---

<nav class={classes} aria-label={navLabel} {...rest}><ButtonLink variant="ghost" href={prevHref} disabled={!hasPrev}>{prevLabel}</ButtonLink><span class="bb-pager__label" aria-current="page">{label}</span><ButtonLink variant="ghost" href={nextHref} disabled={!hasNext}>{nextLabel}</ButtonLink></nav>
