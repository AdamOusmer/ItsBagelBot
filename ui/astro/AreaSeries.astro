// Astro twin of ../svelte/AreaSeries.svelte, for the `.bb-area` contract.
//
// The geometry is NOT reimplemented here: both adapters call
// ../lib/area-series.ts, which is the whole reason this twin could be written
// at all. The Svelte file used to say a second implementation in another
// language was the drift this package exists to delete, and it was right —
// so there is still only one.
//
// `uid` is REQUIRED here where the Svelte twin defaults it to $props.id().
// Astro has no per-instance id generator that is stable across a render, and
// a random one would make this element's markup non-deterministic, which
// would put a moving value in a golden file. Making the caller name it also
// makes the collision it prevents (two charts, one <defs> entry) visible at
// the call site.
import '../styles/elements/area-series.css';
import {
    areaGeometry,
    AREA_W,
    AREA_H,
    AREA_PLOT_BOTTOM,
    AREA_TICK_TOP,
    AREA_TICK_BOTTOM,
} from '../lib/area-series';

interface Props {
    /** One point per bucket, oldest first. Fewer than two draws nothing. */
    values: readonly number[];
    /** Indices into `values` to mark in the gutter below the plot. */
    ticks?: readonly number[];
    ariaLabel: string;
    /** Rendered height in CSS pixels; the viewBox is fixed, so this scales it. */
    height?: number;
    /** Suffix for the gradient id. Required: see the note above. */
    uid: string;
    class?: string;
    [key: string]: unknown;
}

const { values, ticks = [], ariaLabel, height = 178, uid, class: className = '', ...rest } =
    Astro.props;
const gradientId = `bb-area-fill-${uid}`;
const geo = areaGeometry(values, ticks);
const classes = ['bb-area', className].filter(Boolean).join(' ');
---

<svg class={classes} style={`height: ${height}px`} viewBox={`0 0 ${AREA_W} ${AREA_H}`} preserveAspectRatio="none" role="img" aria-label={ariaLabel} {...rest}><defs><linearGradient id={gradientId} x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--bb-green-glow)" stop-opacity="0.3" /><stop offset="100%" stop-color="var(--bb-green-glow)" stop-opacity="0.02" /></linearGradient></defs><line x1="0" y1="44" x2={AREA_W} y2="44" class="bb-area__grid" /><line x1="0" y1="94" x2={AREA_W} y2="94" class="bb-area__grid" /><line x1="0" y1={AREA_PLOT_BOTTOM} x2={AREA_W} y2={AREA_PLOT_BOTTOM} class="bb-area__grid bb-area__grid--base" /><path d={geo.fill} fill={`url(#${gradientId})`} /><path d={geo.line} class="bb-area__line" /><g class="bb-area__ticks">{geo.marks.map((tx) => (<line x1={tx} y1={AREA_TICK_TOP} x2={tx} y2={AREA_TICK_BOTTOM} />))}</g>{geo.last && (<circle cx={geo.last.x} cy={geo.last.y} r="3.5" class="bb-area__dot" />)}</svg>
