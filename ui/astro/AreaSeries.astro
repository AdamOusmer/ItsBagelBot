import '../styles/elements/area-series.css';
import {
    areaGeometry,
    AREA_W,
    AREA_H,
    AREA_PLOT_BOTTOM,
    AREA_TICK_TOP,
    AREA_TICK_BOTTOM,
} from '../lib/area-series';

interface Props {
    values: readonly number[];
    ticks?: readonly number[];
    ariaLabel: string;
    height?: number;
    uid: string;
    class?: string;
    [key: string]: unknown;
}

const { values, ticks = [], ariaLabel, height = 178, uid, class: className = '', ...rest } =
    Astro.props;
const gradientId = `bb-area-fill-${uid}`;
const geo = areaGeometry(values, ticks);
const classes = ['bb-area', className].filter(Boolean).join(' ');
---

<svg class={classes} style={`height: ${height}px`} viewBox={`0 0 ${AREA_W} ${AREA_H}`} preserveAspectRatio="none" role="img" aria-label={ariaLabel} {...rest}><defs><linearGradient id={gradientId} x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--bb-green-glow)" stop-opacity="0.3" /><stop offset="100%" stop-color="var(--bb-green-glow)" stop-opacity="0.02" /></linearGradient></defs><line x1="0" y1="44" x2={AREA_W} y2="44" class="bb-area__grid" /><line x1="0" y1="94" x2={AREA_W} y2="94" class="bb-area__grid" /><line x1="0" y1={AREA_PLOT_BOTTOM} x2={AREA_W} y2={AREA_PLOT_BOTTOM} class="bb-area__grid bb-area__grid--base" /><path d={geo.fill} fill={`url(#${gradientId})`} /><path d={geo.line} class="bb-area__line" /><g class="bb-area__ticks">{geo.marks.map((tx) => (<line x1={tx} y1={AREA_TICK_TOP} x2={tx} y2={AREA_TICK_BOTTOM} />))}</g>{geo.last && (<circle cx={geo.last.x} cy={geo.last.y} r="3.5" class="bb-area__dot" />)}</svg>
