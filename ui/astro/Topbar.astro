import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/shell.css';
import { uiI18n } from './i18n';
import Brand from './Brand.astro';
import Button from './Button.astro';
import ButtonLink from './ButtonLink.astro';
import { bolota } from '@luzir/bolota';
import { topbarClasses, topbarCrumbs } from '../lib/topbar-context';
import type { UiBrand, UiCrumb, UiTopbarContext } from '../lib/nav-types';

interface Props extends Omit<HTMLAttributes<'header'>, 'brand' | 'crumbs' | 'crumbLabel' | 'clock' | 'clockText' | 'railed' | 'context' | 'class'> {
  brand: UiBrand;
  crumbs?: UiCrumb[];
  crumbLabel?: string;
  clock?: boolean;
  clockText?: string;
  railed?: boolean;
  showBrand?: boolean;
  context?: UiTopbarContext;
  class?: string;
}

const { t } = uiI18n(Astro);
const {
  brand,
  crumbs = [],
  crumbLabel = t('nav.breadcrumb'),
  clock = true,
  clockText = '',
  railed = false,
  showBrand = true,
  context,
  class: className = '',
  ...rest
} = Astro.props;

const classes = topbarClasses({ showBrand, context, className });
const shownCrumbs = topbarCrumbs(crumbs, context);
const avatar = context?.subject ? bolota(context.subject, { size: 36, background: false, title: context.subject }) : '';
const hasAccount = Astro.slots.has('account');
---

<header class={classes} {...rest}>{showBrand && <Brand title={brand.title} sub={brand.sub} href={brand.href} logoSrc={brand.logoSrc} logoAlt={brand.logoAlt} size="sm" logoShape={brand.logoShape} style="--bb-cursor: quiet" />}{context && <span class="bb-topbar-ctx__title" aria-hidden="true">{context.title}</span>}{context && (<div class="bb-topbar-ctx" role="status" aria-label={context.statusText} title={context.scopesTitle}>{context.subject && (<span class="bb-topbar-ctx__avatar" aria-hidden="true"><Fragment set:html={avatar} /></span><span class="bb-topbar-ctx__text">{context.subjectPre && (<span class="bb-topbar-ctx__affix">{context.subjectPre}</span>)}<strong>{context.subject}</strong>{context.subjectPost && (<span class="bb-topbar-ctx__affix">{context.subjectPost}</span>)}</span>)}</div>)}{shownCrumbs.length > 0 && <nav class="bb-topbar__crumb" aria-label={crumbLabel}><ol>{shownCrumbs.map((crumb, i) => (
  <li class={i === shownCrumbs.length - 1 ? 'is-current' : undefined}>{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}</li>
))}</ol></nav>}<div class="bb-topbar__grow"></div>{clock && <span class="bb-topbar__clock" aria-hidden="true">{clockText}</span>}{hasAccount && <div class:list={['bb-topbar__account', railed && 'bb-topbar__account--railed']}><slot name="account" /></div>}<slot name="actions" />{context && context.actions.length > 0 && (<div class="bb-topbar-ctx__actions">{context.actions.map((item) => item.formAction ? (<form method="POST" action={item.formAction} class={item.subtle ? 'bb-topbar-ctx__subtle' : undefined}><Button type="submit" variant="secondary" size="sm"><span class="bb-topbar-ctx__label">{item.label}</span>{item.compactLabel && (<span class="bb-topbar-ctx__compact">{item.compactLabel}</span>)}</Button></form>) : (<ButtonLink href={item.href ?? '/'} variant="secondary" size="sm" class={item.subtle ? 'bb-topbar-ctx__subtle' : undefined}><span class="bb-topbar-ctx__label">{item.label}</span>{item.compactLabel && (<span class="bb-topbar-ctx__compact">{item.compactLabel}</span>)}</ButtonLink>))}</div>)}</header>
