import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/shell.css';
import { uiI18n } from './i18n';
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { contextActionClass, topbarClasses, topbarCrumbs, visibleScopes } from '../lib/topbar-context';
import type { UiBrand, UiCrumb, UiTopbarContext } from '../lib/nav-types';

interface Props extends Omit<HTMLAttributes<'header'>, 'brand' | 'crumbs' | 'crumbLabel' | 'clock' | 'clockText' | 'railed' | 'context' | 'class'> {
  brand: UiBrand;
  crumbs?: UiCrumb[];
  crumbLabel?: string;
  clock?: boolean;
  clockText?: string;
  railed?: boolean;
  showBrand?: boolean;
  context?: UiTopbarContext;
  class?: string;
}

const { t } = uiI18n(Astro);
const {
  brand,
  crumbs = [],
  crumbLabel = t('nav.breadcrumb'),
  clock = true,
  clockText = '',
  railed = false,
  showBrand = true,
  context,
  class: className = '',
  ...rest
} = Astro.props;

const classes = topbarClasses({ showBrand, context, className });
const shownCrumbs = topbarCrumbs(crumbs, context);
const scopes = visibleScopes(context?.scopes);
const hasAccount = Astro.slots.has('account');
---

<header class={classes} {...rest}>{showBrand && <Brand title={brand.title} sub={brand.sub} href={brand.href} logoSrc={brand.logoSrc} logoAlt={brand.logoAlt} size="sm" logoShape={brand.logoShape} style="--bb-cursor: quiet" />}{context && (<div class="bb-topbar-ctx" role="status" aria-label={context.statusText}>{context.badges.map((badge) => (<span class={`bb-topbar-ctx__badge bb-topbar-ctx__badge--${badge.tone}`}><Icon name={badge.icon} size={13} strokeWidth={2} /><span>{badge.label}</span></span>))}{context.subject && (<span class="bb-topbar-ctx__subject">{context.avatar && (<span class={`bb-topbar-ctx__avatar bb-topbar-ctx__avatar--${context.tone}`} aria-hidden="true">{context.avatar}</span>)}<span class="bb-topbar-ctx__text">{context.subjectPre && (<span class="bb-topbar-ctx__affix">{context.subjectPre}</span>)}<strong>{context.subject}</strong>{context.subjectPost && (<span class="bb-topbar-ctx__affix">{context.subjectPost}</span>)}</span></span>)}{scopes.visible.length > 0 && (<span class="bb-topbar-ctx__scopes" title={context.scopesTitle}>{scopes.visible.map((scope) => (<span class="bb-topbar-ctx__scope">{scope}</span>))}{scopes.overflow > 0 && (<span class="bb-topbar-ctx__scope">+{scopes.overflow}</span>)}</span>)}</div>)}{context && shownCrumbs.length > 0 && <span class="bb-topbar-ctx__sep" aria-hidden="true"></span>}{shownCrumbs.length > 0 && <nav class="bb-topbar__crumb" aria-label={crumbLabel}><ol>{shownCrumbs.map((crumb, i) => (
  <li class={i === shownCrumbs.length - 1 ? 'is-current' : undefined}>{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}</li>
))}</ol></nav>}<div class="bb-topbar__grow"></div>{clock && <span class="bb-topbar__clock" aria-hidden="true">{clockText}</span>}{hasAccount && <div class:list={['bb-topbar__account', railed && 'bb-topbar__account--railed']}><slot name="account" /></div>}<slot name="actions" />{context && context.actions.length > 0 && (<div class="bb-topbar-ctx__actions">{context.actions.map((item) => item.formAction ? (<form method="POST" action={item.formAction}><button type="submit" class={contextActionClass(item, context.tone)}><Icon name="logOut" size={13} strokeWidth={2} /><span class="bb-topbar-ctx__label">{item.label}</span>{item.compactLabel && (<span class="bb-topbar-ctx__compact">{item.compactLabel}</span>)}</button></form>) : (<a class={contextActionClass(item, context.tone)} href={item.href ?? '/'}><Icon name="logOut" size={13} strokeWidth={2} /><span class="bb-topbar-ctx__label">{item.label}</span>{item.compactLabel && (<span class="bb-topbar-ctx__compact">{item.compactLabel}</span>)}</a>))}</div>)}</header>
