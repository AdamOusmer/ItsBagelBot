import '../styles/elements/shell.css';
import Brand from './Brand.astro';
import type { UiBrand, UiCrumb } from '../lib/nav-types';

interface Props {
  brand: UiBrand;
  crumbs?: UiCrumb[];
  crumbAriaLabel?: string;
  clock?: boolean;
  clockText?: string;
  railed?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  brand,
  crumbs = [],
  crumbAriaLabel,
  clock = true,
  clockText = '',
  railed = false,
  class: className = '',
  ...rest
} = Astro.props;

const classes = ['bb-topbar', className || null].filter(Boolean).join(' ');
const hasAccount = Astro.slots.has('account');
---

<header class={classes} {...rest}><Brand title={brand.title} sub={brand.sub} href={brand.href} logoSrc={brand.logoSrc} logoAlt={brand.logoAlt} size="sm" premium={brand.premium} />{crumbs.length > 0 && <nav class="bb-topbar__crumb" aria-label={crumbAriaLabel}><ol>{crumbs.map((crumb, i) => (
  <li data-here={i === crumbs.length - 1 ? '' : undefined}>{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}</li>
))}</ol></nav>}<div class="bb-topbar__grow"></div>{clock && <span class="bb-topbar__clock" aria-hidden="true" data-clock>{clockText}</span>}{hasAccount && <div class="bb-topbar__account" data-railed={railed ? '' : undefined}><slot name="account" /></div>}<slot name="actions" /></header>
