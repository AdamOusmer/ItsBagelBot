import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/shell.css';

interface Props extends Omit<HTMLAttributes<'div'>, 'eyebrow' | 'title' | 'description' | 'compact' | 'class'> {
  eyebrow?: string;
  title?: string;
  description?: string;
  compact?: boolean;
  class?: string;
}

const { eyebrow, title, description, compact = false, class: className = '', ...rest } = Astro.props;

const trailed = Astro.slots.has('trailing');

const classes = [
  'bb-page-head',
  trailed ? 'bb-page-head--trailed' : null,
  compact ? 'bb-page-head--compact' : null,
  className || null,
]
  .filter(Boolean)
  .join(' ');
---

<div class={classes} {...rest}><div class="bb-page-head__main">{eyebrow && <span class="bb-page-head__eyebrow">{eyebrow}</span>}<h1 tabindex="-1"><slot>{title}</slot></h1>{description && <p class="bb-page-head__description">{description}</p>}</div>{trailed && <div class="bb-page-head__trail"><slot name="trailing" /></div>}</div>
