// Astro adapter for `.bb-page-head`. Its Svelte twin is
// ../svelte/PageHead.svelte and ../test/parity.test.ts diffs the two.
//
// Exists for the static surfaces: the guide screens draw a console page head
// in HTML, and until now they drew it with their own `.df-title` rules, which
// is how the guide screenshots came to describe a page that had moved on.
import '../styles/elements/shell.css';

interface Props {
  eyebrow?: string;
  /** The heading. The default slot wins when both are given. */
  title?: string;
  description?: string;
  class?: string;
  [key: string]: unknown;
}

const { eyebrow, title, description, class: className = '', ...rest } = Astro.props;

// Astro cannot ask whether a named slot was filled without rendering it, so
// the trailed modifier is driven by the slot's presence check, which is the
// one API difference between the two adapters and is invisible in the output.
const trailed = Astro.slots.has('trail');

const classes = [
  'bb-page-head',
  trailed ? 'bb-page-head--trailed' : null,
  className || null,
]
  .filter(Boolean)
  .join(' ');
---

<div class={classes} {...rest}><div class="bb-page-head__main">{eyebrow && <span class="bb-page-head__eyebrow">{eyebrow}</span>}<h1 tabindex="-1"><slot>{title}</slot></h1>{description && <p class="bb-page-head__description">{description}</p>}</div>{trailed && <div class="bb-page-head__trail"><slot name="trail" /></div>}</div>
