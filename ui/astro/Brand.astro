import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/brand-mark.css';

interface Props extends Omit<HTMLAttributes<'div'>, 'title' | 'sub' | 'href' | 'logoSrc' | 'logoAlt' | 'size' | 'logoShape' | 'fit' | 'class'> {
  title: string;
  sub?: string;
  href?: string;
  logoSrc?: string;
  logoAlt?: string;
  size?: 'sm' | 'md' | 'lg';
  logoShape?: 'square' | 'circle';
  fit?: boolean;
  class?: string;
}

const {
  title,
  sub,
  href,
  logoSrc,
  logoAlt = '',
  size = 'md',
  logoShape = 'square',
  fit = false,
  class: className = '',
  ...rest
} = Astro.props;

const classes = ['bb-brand', `bb-brand--${size}`, className || null]
  .filter(Boolean)
  .join(' ');

const px = size === 'sm' ? 26 : size === 'lg' ? 55 : 30;
---

{href ? (
  <a class={classes} href={href} data-logo={logoShape === 'circle' ? 'circle' : undefined} {...rest}>{logoSrc && <span class="bb-brand__logo"><img src={logoSrc} alt={logoAlt} width={px} height={px} /></span>}<span class="bb-brand__id"><span class="bb-brand__name">{title}</span>{sub && <span class="bb-brand__sub" data-fit={fit ? '' : undefined}>{sub}</span>}</span></a>
) : (
  <div class={classes} data-logo={logoShape === 'circle' ? 'circle' : undefined} {...rest}>{logoSrc && <span class="bb-brand__logo"><img src={logoSrc} alt={logoAlt} width={px} height={px} /></span>}<span class="bb-brand__id"><span class="bb-brand__name">{title}</span>{sub && <span class="bb-brand__sub" data-fit={fit ? '' : undefined}>{sub}</span>}</span></div>
)}
