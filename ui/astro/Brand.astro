import '../styles/elements/brand-mark.css';

interface Props {
  title: string;
  sub?: string;
  href?: string;
  logoSrc?: string;
  logoAlt?: string;
  size?: 'sm' | 'md' | 'lg';
  premium?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  title,
  sub,
  href,
  logoSrc,
  logoAlt = '',
  size = 'md',
  premium = false,
  class: className = '',
  ...rest
} = Astro.props;

const classes = ['bb-brand', `bb-brand--${size}`, className || null]
  .filter(Boolean)
  .join(' ');

const px = size === 'sm' ? 26 : size === 'lg' ? 55 : 30;
---

{href ? (
  <a class={classes} href={href} data-premium={premium ? '' : undefined} {...rest}>{logoSrc && <span class="bb-brand__logo"><img src={logoSrc} alt={logoAlt} width={px} height={px} /></span>}<span class="bb-brand__id"><span class="bb-brand__name">{title}</span>{sub && <span class="bb-brand__sub">{sub}</span>}</span></a>
) : (
  <div class={classes} data-premium={premium ? '' : undefined} {...rest}>{logoSrc && <span class="bb-brand__logo"><img src={logoSrc} alt={logoAlt} width={px} height={px} /></span>}<span class="bb-brand__id"><span class="bb-brand__name">{title}</span>{sub && <span class="bb-brand__sub">{sub}</span>}</span></div>
)}
