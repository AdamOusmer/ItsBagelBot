import '../styles/elements/card.css';

interface Props {
    title: string;
    headingLevel?: 1 | 2 | 3 | 4 | 5 | 6;
}

const { title, headingLevel = 3 } = Astro.props;
const HeadingTag = `h${headingLevel}`;
---

<div class="bb-card-head">
    <HeadingTag class="bb-card-head__title">{title}</HeadingTag>
    <slot name="actions" />
</div>
