import '../styles/elements/icon.css';
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  fill?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  name,
  size = 16,
  strokeWidth = 1.6,
  fill = 'none',
  class: className = '',
  ...rest
} = Astro.props;

const classes = ['bb-icon', className || null].filter(Boolean).join(' ');
---

<svg
  class={classes}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={fill}
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...rest}
  set:html={icons[name]}
/>
