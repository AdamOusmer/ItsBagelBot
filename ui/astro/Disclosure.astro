import '../styles/elements/disclosure.css';

interface Props {
    summary: string;
    open?: boolean;
    index?: string;
    size?: 'md' | 'sm';
    class?: string;
    [key: string]: unknown;
}

const { summary, open = false, index, size = 'md', class: className = '', ...rest } = Astro.props;

const classes = [
    'bb-disclosure',
    size === 'sm' ? 'bb-disclosure--sm' : null,
    index ? 'bb-disclosure--indexed' : null,
    className || null,
]
    .filter(Boolean)
    .join(' ');
---

<details class={classes} open={open} {...rest}><summary class="bb-disclosure__summary">{index && <span class="bb-disclosure__index" aria-hidden="true">{index}</span>}<span class="bb-disclosure__label">{summary}</span><span class="bb-disclosure__icon" aria-hidden="true"></span></summary><div class="bb-disclosure__body"><div class="bb-disclosure__content"><slot /></div></div></details>
