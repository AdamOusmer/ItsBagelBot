import type { HTMLAttributes } from 'astro/types';

import Button from './Button.astro';

interface Props extends Omit<HTMLAttributes<'a'>, 'href' | 'variant' | 'solid' | 'block' | 'size' | 'done' | 'class'> {
    href: string;
    variant?: 'primary' | 'secondary' | 'ghost' | 'green' | 'destructive' | 'icon' | 'tan' | 'quiet' | 'go' | 'add' | 'brand';
    solid?: boolean;
    block?: boolean;
    size?: 'md' | 'sm';
    done?: boolean;
    disabled?: boolean;
    class?: string;
}

const props = Astro.props;
---

<Button {...props}><slot /></Button>
