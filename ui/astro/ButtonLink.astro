import type { HTMLAttributes } from 'astro/types';
import { buttonClass, hasMark, type ButtonSize, type ButtonTone, type ButtonVariant } from '../lib/button';
import '../styles/elements/button.css';

interface Props extends Omit<HTMLAttributes<'a'>, 'href' | 'class'> {
    href: string;
    variant?: ButtonVariant;
    tone?: ButtonTone;
    size?: ButtonSize;
    block?: boolean;
    done?: boolean;
    disabled?: boolean;
    class?: string;
}

const { href, variant = 'primary', tone = 'neutral', size = 'md', block = false, done = false, disabled = false, class: className, ...rest } = Astro.props;
const classes = [buttonClass({ variant, tone, size, block, done }), className].filter(Boolean).join(' ');
const link = disabled ? { role: 'link', 'aria-disabled': 'true' } : { href };
---

<a class={classes} {...link} data-mark="" {...rest}>
    {hasMark(variant) && <i class="bb-btn__mark" aria-hidden="true" />}
    <span class="bb-btn__content"><slot /></span>
</a>
