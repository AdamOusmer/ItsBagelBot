import '../styles/elements/text-link.css';

interface Props {
    href: string;
    label: string;
    active?: boolean;
    external?: boolean;
    size?: string;
    class?: string;
}

const {
    href,
    label,
    active = false,
    external = false,
    size,
    class: className = '',
    ...rest
} = Astro.props;
const glyphs = Array.from(label);
const classes = ['bb-text-link', className, active ? 'is-active' : null]
    .filter(Boolean)
    .join(' ');
---

<a class={classes} href={href} aria-label={label} aria-current={active ? 'page' : undefined} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} style={size ? `--text-link-size: ${size};` : undefined} {...rest}><span class="bb-text-link__mask" aria-hidden="true"><span class="bb-text-link__row bb-text-link__row--rest">{glyphs.map((glyph, index) => (<span class="bb-text-link__glyph" style={`--gi: ${index};`}>{glyph}</span>))}</span><span class="bb-text-link__row bb-text-link__row--over">{glyphs.map((glyph, index) => (<span class="bb-text-link__glyph" style={`--gi: ${index};`}>{glyph}</span>))}</span></span></a>
