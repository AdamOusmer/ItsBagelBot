import type { HTMLAttributes } from 'astro/types';

import '../styles/elements/table.css';

interface Props extends Omit<HTMLAttributes<'table'>, 'label' | 'zebra' | 'compact' | 'class'> {
    label: string;
    zebra?: boolean;
    compact?: boolean;
    roomy?: boolean;
    minWidth?: string;
    class?: string;
}

const { label, zebra = false, compact = false, roomy = false, minWidth, class: className = '', ...rest } = Astro.props;
const classes = [
    'bb-tbl',
    zebra ? 'bb-tbl--zebra' : null,
    compact ? 'bb-tbl--compact' : null,
    roomy ? 'bb-tbl--roomy' : null,
    className,
]
    .filter(Boolean)
    .join(' ');
---

<div class="bb-tbl-wrap" role="region" aria-label={label} tabindex="0"><table class={classes} style={minWidth ? `--tbl-min-w: ${minWidth};` : undefined} {...rest}><slot /></table></div>
