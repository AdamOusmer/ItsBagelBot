import '../styles/elements/editor-footer.css';
import Button from './Button.astro';

interface Props {
    status?: 'idle' | 'saving' | 'saved' | 'error' | 'conflict';
    dirty?: boolean;
    canSave?: boolean;
    saveLabel?: string;
    cancelLabel?: string;
    savingLabel?: string;
    savedLabel?: string;
    errorLabel?: string;
    dirtyLabel?: string;
    class?: string;
}

const {
    status = 'idle',
    dirty = false,
    canSave = true,
    saveLabel = 'Save',
    cancelLabel = 'Cancel',
    savingLabel = 'Saving…',
    savedLabel = 'Saved',
    errorLabel = 'Could not save',
    dirtyLabel = 'Unsaved changes',
    class: className = '',
    ...rest
} = Astro.props;

const classes = ['bb-editor-foot', className].filter(Boolean).join(' ');

const state =
    status === 'saving'
        ? { mod: 'saving', label: savingLabel }
        : status === 'error' || status === 'conflict'
          ? { mod: 'error', label: errorLabel }
          : status === 'saved'
            ? { mod: 'saved', label: savedLabel }
            : dirty
              ? { mod: 'dirty', label: dirtyLabel }
              : null;
---

<div class={classes} {...rest}><span class="bb-editor-foot__status" role="status" aria-live="polite">{state && <span class={`bb-editor-foot__s bb-editor-foot__s--${state.mod}`}>{state.label}</span>}</span><span class="bb-editor-foot__acts"><Button variant="ghost">{cancelLabel}</Button><Button type="submit" disabled={!canSave || status === 'saving'}>{status === 'saving' ? savingLabel : saveLabel}</Button></span></div>
