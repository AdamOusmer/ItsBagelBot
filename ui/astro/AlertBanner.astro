import '../styles/elements/alert.css';

interface Props {
    variant?: 'danger' | 'warn' | 'impersonation';
    role?: 'alert' | 'status';
    class?: string;
}

const { variant = 'danger', role = 'alert', class: className = '', ...rest } = Astro.props;
const classes = ['bb-alert', `bb-alert--${variant}`, className].filter(Boolean).join(' ');
---

<div class={classes} role={role} {...rest}><span class="bb-alert__msg"><slot /></span><slot name="action" /></div>
