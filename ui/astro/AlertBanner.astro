import '../styles/elements/alert.css';
import type { HTMLAttributes } from 'astro/types';
import { alertClass, type AlertAction, type AlertLook } from '../lib/alert';

interface Props extends Omit<HTMLAttributes<'div'>, 'role'>, AlertLook {
    role?: 'alert' | 'status' | 'note';
    action?: AlertAction;
}

const { tone, variant, placement, row, flush, stack, role = 'alert', action, class: className, ...rest } = Astro.props;
---

<div class:list={[alertClass({ tone, variant, placement, row, flush, stack }), className]} role={role} {...rest}><span class="bb-alert__msg"><slot /></span><slot name="actions" />{action && 'formAction' in action ? (<form method="POST" action={action.formAction}><button type="submit" class="bb-alert__action">{action.label}</button></form>) : action && (<a class="bb-alert__action" href={action.href}>{action.label}</a>)}</div>
