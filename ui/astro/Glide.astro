import '../styles/elements/glide.css';

interface Props {
    shown?: boolean;
    class?: string;
}

const { shown = false, class: className = '', ...rest } = Astro.props;
const classes = ['bb-glide', className].filter(Boolean).join(' ');
---

<span class={classes} aria-hidden="true" data-shown={shown ? '' : undefined} {...rest} />
