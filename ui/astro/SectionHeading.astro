import '../styles/elements/section-heading.css';

interface Props {
    eyebrow?: string;
    title: string;
    align?: 'center' | 'left';
    class?: string;
}

const { eyebrow, title, align = 'center', class: className = '', ...rest } = Astro.props;
const hasBadge = Astro.slots.has('badge');
const classes = ['bb-section-heading', `bb-section-heading--${align}`, className]
    .filter(Boolean)
    .join(' ');
---

<div class={classes} {...rest}>{(eyebrow || hasBadge) && (<div class="bb-section-heading__meta" data-reveal>{eyebrow && <span class="bb-section-heading__eyebrow">{eyebrow}</span>}<slot name="badge" /></div>)}<h2 class="bb-section-heading__title" data-reveal style="--reveal-i: 1">{title}</h2></div>
