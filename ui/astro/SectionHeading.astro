import '../styles/elements/section-heading.css';

interface Props {
    eyebrow?: string;
    title: string;
    headingLevel?: 1 | 2 | 3 | 4 | 5 | 6;
    align?: 'center' | 'left';
    class?: string;
}

const { eyebrow, title, headingLevel = 2, align = 'center', class: className = '', ...rest } = Astro.props;
const HeadingTag = `h${headingLevel}`;
const hasBadge = Astro.slots.has('badge');
const classes = ['bb-section-heading', `bb-section-heading--${align}`, className]
    .filter(Boolean)
    .join(' ');
---

<div class={classes} {...rest}>{(eyebrow || hasBadge) && (<div class="bb-section-heading__meta" data-reveal>{eyebrow && <span class="bb-section-heading__eyebrow"><span data-fit>{eyebrow}</span></span>}<slot name="badge" /></div>)}<HeadingTag class="bb-section-heading__title" data-reveal="" style="--reveal-i: 1"><span data-fit="block">{title}</span></HeadingTag></div>
