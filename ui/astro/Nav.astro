import type { HTMLAttributes } from 'astro/types';
import { uiI18n } from './i18n';

import '../styles/elements/nav.css';
import Brand from './Brand.astro';
import NavLink from './NavLink.astro';
import Hamburger from './Hamburger.astro';
import MobileMenu from './MobileMenu.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { UiBrand, UiLocaleOption, UiNavLink } from '../lib/nav-types';

interface Props extends Omit<HTMLAttributes<'nav'>, 'brand' | 'links' | 'cta' | 'locales' | 'localeLabel' | 'label' | 'menuLabels' | 'menuMeta' | 'menuId' | 'variant' | 'menu' | 'class'> {
  brand: UiBrand;
  links: UiNavLink[];
  cta?: UiNavLink;
  locales?: UiLocaleOption[];
  localeLabel?: string;
  label?: string;
  menuLabels?: { open?: string; close?: string; panel?: string };
  menuMeta?: string;
  menuId?: string;
  variant?: 'pill' | 'bar';
  menu?: boolean;
  class?: string;
}

const { t } = uiI18n(Astro);
const {
  brand,
  links,
  cta,
  locales,
  localeLabel = t('nav.language'),
  label = t('nav.main'),
  menuLabels = {},
  menuMeta,
  menuId = 'bb-mobile-menu',
  variant = 'pill',
  menu = true,
  class: className = '',
  ...rest
} = Astro.props;

const classes = ['bb-nav', className || null].filter(Boolean).join(' ');
const menuOpen = menuLabels.open ?? t('nav.menuOpen');
const menuClose = menuLabels.close ?? t('nav.menuClose');
const menuPanel = menuLabels.panel ?? t('nav.menu');
---

<nav class={classes} aria-label={label} data-variant={variant} {...rest}><div class="bb-nav__inner"><Brand class="bb-nav__brand" title={brand.title} sub={brand.sub} href={brand.href} logoSrc={brand.logoSrc} logoAlt={brand.logoAlt} size="sm" logoShape={brand.logoShape} data-home-logo /><ul class="bb-nav__links">{links.map((link) => (
  <li><NavLink href={link.href} label={link.label} current={link.current} external={link.external} data-astro-prefetch={link.current || link.external ? undefined : 'hover'} /></li>
))}</ul><div class="bb-nav__actions">{locales && locales.length > 0 && <LanguageSwitcher options={locales} label={localeLabel} menuId={`${menuId}-lang`} />}{cta && <NavLink class="bb-nav__cta" variant="cta" href={cta.href} label={cta.label} external={cta.external} />}<slot name="actions" /></div>{menu && <Hamburger label={menuOpen} closeLabel={menuClose} controls={menuId} />}</div></nav>{menu && <MobileMenu links={links} cta={cta} id={menuId} panelLabel={menuPanel} meta={menuMeta}><slot name="mobileFooter" slot="footer" /></MobileMenu>}

<script>
  import { mountTopDownMenu, mountHomeLogo } from '../lib/nav-menu';
  import { mountNavFit, navFitElements } from '../lib/nav-fit';

  let disposers: (() => void)[] = [];

  function unmount(): void {
    for (const dispose of disposers) dispose();
    disposers = [];
  }

  function mountMenu(): void {
    const toggle = document.querySelector<HTMLElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    const curvePath = document.querySelector<SVGPathElement>('[data-menu-curve-path]');
    if (!toggle || !menu || !curvePath || toggle.dataset.ready === '1') return;
    toggle.dataset.ready = '1';

    const open = toggle.getAttribute('aria-label') ?? '';
    const close = toggle.dataset.labelClose ?? open;
    disposers.push(mountTopDownMenu({ toggle, menu, curvePath }, { labels: { open, close } }));
  }

  function mountLogo(): void {
    const logo = document.querySelector<HTMLAnchorElement>('[data-home-logo]');
    if (!logo || logo.dataset.ready === '1') return;
    logo.dataset.ready = '1';
    disposers.push(mountHomeLogo(logo));
  }

  function mountFit(): void {
    const bar = document.querySelector<HTMLElement>('.bb-nav');
    if (!bar || bar.dataset.fitReady === '1') return;
    const elements = navFitElements(bar);
    if (!elements) return;
    bar.dataset.fitReady = '1';
    disposers.push(mountNavFit(elements));
  }

  function mount(): void {
    mountMenu();
    mountLogo();
    mountFit();
  }

  function carryFit(event: Event): void {
    const collapsed = document.querySelector<HTMLElement>('.bb-nav')?.dataset.navCollapsed;
    const next = (event as Event & { newDocument?: Document }).newDocument?.querySelector<HTMLElement>('.bb-nav');
    if (collapsed && next) next.dataset.navCollapsed = collapsed;
    unmount();
  }

  function release(): void {
    unmount();
    for (const el of document.querySelectorAll<HTMLElement>('[data-menu-toggle], [data-home-logo], .bb-nav')) {
      delete el.dataset.ready;
      delete el.dataset.fitReady;
    }
  }

  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', carryFit);
  window.addEventListener('pagehide', release);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) mount();
  });
</script>
