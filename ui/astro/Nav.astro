import '../styles/elements/nav.css';
import Brand from './Brand.astro';
import NavLink from './NavLink.astro';
import Hamburger from './Hamburger.astro';
import MobileMenu from './MobileMenu.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { UiBrand, UiLocaleOption, UiNavLink } from '../lib/nav-types';

interface Props {
  brand: UiBrand;
  links: UiNavLink[];
  cta?: UiNavLink;
  locales?: UiLocaleOption[];
  localeLabel?: string;
  ariaLabel: string;
  menuLabels: { open: string; close: string; panel: string };
  menuMeta?: string;
  menuId?: string;
  variant?: 'pill' | 'bar';
  menu?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  brand,
  links,
  cta,
  locales,
  localeLabel = 'Language',
  ariaLabel,
  menuLabels,
  menuMeta,
  menuId = 'bb-mobile-menu',
  variant = 'pill',
  menu = true,
  class: className = '',
  ...rest
} = Astro.props;

const classes = ['bb-nav', className || null].filter(Boolean).join(' ');
---

<nav class={classes} aria-label={ariaLabel} data-variant={variant} {...rest}><div class="bb-nav__inner"><Brand class="bb-nav__brand" title={brand.title} sub={brand.sub} href={brand.href} logoSrc={brand.logoSrc} logoAlt={brand.logoAlt} size="sm" premium={brand.premium} data-home-logo /><ul class="bb-nav__links">{links.map((link) => (
  <li><NavLink href={link.href} label={link.label} current={link.active} external={link.external} /></li>
))}</ul><div class="bb-nav__actions">{locales && locales.length > 0 && <LanguageSwitcher options={locales} ariaLabel={localeLabel} />}{cta && <NavLink class="bb-nav__cta" variant="cta" href={cta.href} label={cta.label} external={cta.external} />}<slot name="actions" /></div>{menu && <Hamburger label={menuLabels.open} closeLabel={menuLabels.close} controls={menuId} />}</div></nav>{menu && <MobileMenu links={links} cta={cta} id={menuId} panelLabel={menuLabels.panel} meta={menuMeta}><slot name="mobileFooter" slot="footer" /></MobileMenu>}

<script>
  import { mountTopDownMenu, mountHomeLogo } from '../lib/nav-menu';

  let disposers: (() => void)[] = [];

  function unmount(): void {
    for (const dispose of disposers) dispose();
    disposers = [];
  }

  function mountMenu(): void {
    const toggle = document.querySelector<HTMLElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    const curvePath = document.querySelector<SVGPathElement>('[data-menu-curve-path]');
    if (!toggle || !menu || !curvePath || toggle.dataset.ready === '1') return;
    toggle.dataset.ready = '1';

    const open = toggle.getAttribute('aria-label') ?? '';
    const close = toggle.dataset.labelClose ?? open;
    disposers.push(mountTopDownMenu({ toggle, menu, curvePath }, { labels: { open, close } }));
  }

  function mountLogo(): void {
    const logo = document.querySelector<HTMLAnchorElement>('[data-home-logo]');
    if (!logo || logo.dataset.ready === '1') return;
    logo.dataset.ready = '1';
    disposers.push(mountHomeLogo(logo));
  }

  function mount(): void {
    mountMenu();
    mountLogo();
  }

  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);
  window.addEventListener('pagehide', unmount);
</script>
