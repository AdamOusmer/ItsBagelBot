import '../styles/elements/skip-link.css';

interface Props {
    href: string;
    label: string;
    class?: string;
    [key: string]: unknown;
}

const { href, label, class: className = '', ...rest } = Astro.props;
const classes = ['bb-skip-link', className].filter(Boolean).join(' ');
---

<a class={classes} href={href} {...rest}>{label}</a>
