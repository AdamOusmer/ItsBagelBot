import '../../../styles/layers.css';
import '../../../styles/brand.css';
import '../../../styles/semantic.css';
import '../../../styles/fonts.css';
import '../../../styles/base.css';
import '../../../styles/elements/typography.css';
import { SECTIONS } from '../sections';

interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · @bagel/ui</title>
  </head>
  <body>
    <div class="sc">
      <aside class="sc-side">
        <a class="sc-brand" href="/">@bagel/ui</a>
        {SECTIONS.map((group) => (
          <nav class="sc-group" aria-label={group.title}>
            <p class="sc-group__title">{group.title}</p>
            {group.links.map((link) => (
              <a class="sc-link" href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>
            ))}
          </nav>
        ))}
      </aside>
      <main class="sc-main">
        <header class="sc-head">
          <h1>{title}</h1>
          {lead && <p>{lead}</p>}
        </header>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  @layer bb.app {
    body {
      margin: 0;
      background: var(--bb-bg-0);
      color: var(--bb-white);
      font-family: var(--bb-font-body);
    }

    .sc {
      display: grid;
      grid-template-columns: 220px minmax(0, 1fr);
      min-height: 100vh;
    }

    .sc-side {
      position: sticky;
      top: 0;
      align-self: start;
      display: flex;
      flex-direction: column;
      gap: 24px;
      height: 100vh;
      padding: 24px 16px;
      box-sizing: border-box;
      background: var(--bb-elev-1);
    }

    .sc-brand {
      color: var(--bb-white);
      font-family: var(--bb-font-display);
      font-weight: 700;
      font-size: 16px;
      text-decoration: none;
      padding: 0 8px;
    }

    .sc-group {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .sc-group__title {
      margin: 0 0 6px;
      padding: 0 8px;
      color: var(--bb-muted);
      font-size: 11.5px;
      font-weight: 500;
    }

    .sc-link {
      padding: 7px 8px;
      border-radius: var(--bb-radius-sm);
      color: var(--bb-muted-light);
      font-size: 14px;
      text-decoration: none;
    }

    .sc-link:hover { background: var(--bb-elev-2); color: var(--bb-white); }
    .sc-link[aria-current='page'] { background: var(--bb-elev-2); color: var(--bb-white); }

    .sc-main {
      display: flex;
      flex-direction: column;
      gap: 32px;
      padding: 40px 40px 80px;
      min-width: 0;
    }

    .sc-head { display: flex; flex-direction: column; gap: 6px; }
    .sc-head h1 { margin: 0; font-family: var(--bb-font-display); font-size: 28px; }
    .sc-head p { margin: 0; color: var(--bb-muted); font-size: 14px; max-width: 64ch; }

    .sc-block {
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: 24px;
      border-radius: var(--bb-radius-md);
      background: var(--bb-card-bg);
    }

    .sc-block > h2 { margin: 0; font-size: 15px; font-weight: 700; }
    .sc-block > p { margin: 0; color: var(--bb-muted); font-size: 13px; }

    .sc-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
    }

    .sc-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }

    @media (max-width: 760px) {
      .sc { grid-template-columns: 1fr; }
      .sc-side { position: static; height: auto; flex-direction: row; flex-wrap: wrap; }
      .sc-main { padding: 24px 16px 64px; }
    }
  }
</style>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target.closest<HTMLElement>('.bb-switch:not(:disabled)') : null;
    if (!target) return;
    const on = target.getAttribute('aria-checked') !== 'true';
    target.setAttribute('aria-checked', String(on));
    target.dataset.state = on ? 'on' : 'off';
  });
</script>
